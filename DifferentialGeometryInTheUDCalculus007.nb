   3.976812053446871*^9},ExpressionUUID->"f806e89b-9317-4637-91f6-\
bd161a249e88"],

Cell[TextData[{
 "The Metric: An operator that automates isomorphisms from raising and \
lowering indices, capable, for instance, of showing, that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["A", "\[Mu]"], 
     SubscriptBox["B", "\[Mu]"]}], "=", 
    RowBox[{
     SubscriptBox["A", "\[Mu]"], 
     SuperscriptBox["B", "\[Mu]"]}]}], TraditionalForm]],ExpressionUUID->
  "178cb7b9-cb8f-4321-a65b-ab308d5427a3"],
 " if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "\[Mu]"], "=", 
    RowBox[{
     SubscriptBox["g", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], 
     SuperscriptBox["A", "\[Nu]"]}]}], TraditionalForm]],ExpressionUUID->
  "4cfc04d5-7551-48c7-937a-21e8c67c650d"]
}], "Item",
 CellChangeTimes->{
