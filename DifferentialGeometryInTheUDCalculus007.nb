Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", \
"\"\<\\n================================================================\>\"",
    "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Style", "[", 
    RowBox[{"\"\<VISUAL SHOWCASE: FORMAL DIFFERENTIAL GEOMETRY\>\"", ",", 
     "Bold", ",", "16"}], "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", \
"\"\<================================================================\\n\>\"",
     "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "1."}]}], " ", "THE", " ", "ZOO", " ", "OF", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"TENSORS", "--"}], "--"}], "--"}], "--"}], "--"}],
                     "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], 
                "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], 
         "--"}], "--"}], "--"}], "--"}]}], "-"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Style", "[", 
    RowBox[{"\"\<1. The Tensor Zoo (Standard Objects)\>\"", ",", "Bold", ",", 
     "14"}], "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<These objects carry valence metadata hidden inside \
their structure.\>\"", "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tensorZoo", "=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Object Name\>\"", ",", "\"\<Wolfram Input\>\"", 
        ",", "\"\<Textbook Output\>\""}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"\"\<Contravariant Vector\>\"", 
        ",", "\"\<x[\[ScriptCapitalU][\[Mu]]]\>\"", ",", 
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"\"\<Covariant Covector\>\"", 
        ",", "\"\<p[\[ScriptCapitalD][\[Nu]]]\>\"", ",", 
        RowBox[{"p", "[", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "]"}]}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"\"\<Mixed Tensor\>\"", 
        ",", "\"\<T[\[ScriptCapitalU][\[Mu]], \[ScriptCapitalD][\[Nu]]]\>\"", 
        ",", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], ",", 
          RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}]}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"\"\<The Metric\>\"", 
        ",", "\"\<g[\[ScriptCapitalD][\[Mu]], \[ScriptCapitalD][\[Nu]]]\>\"", 
        ",", 
        RowBox[{"g", "[", 
         RowBox[{
          RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
          RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}]}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"\"\<Inverse Metric\>\"", 
        ",", "\"\<g[\[ScriptCapitalU][\[Mu]], \[ScriptCapitalU][\[Nu]]]\>\"", 
        ",", 
        RowBox[{"g", "[", 
