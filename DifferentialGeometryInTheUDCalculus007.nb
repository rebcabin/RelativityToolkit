Cell[TextData[{
 "The code is presented in reverse of the best order for human reading, \
because we need to evaluate the implementation before we can show what it can \
do (",
 StyleBox["def before ref",
  FontSlant->"Italic"],
 ", the standard dilemma of ",
 StyleBox["Literate Programming",
  FontSlant->"Italic"],
 ", which we can\[CloseCurlyQuote]t practice)",
 ". "
}], "Text",
 CellChangeTimes->{{3.9769717848707523`*^9, 3.9769720193590717`*^9}, {
  3.977100974850956*^9, 
  3.9771010251698*^9}},ExpressionUUID->"1bd5c215-36d3-4aef-bb31-ade2a03eb290"],

