Cell[CellGroupData[{
Cell["Formal Differential Geometry in the \[ScriptCapitalU]\[ScriptCapitalD] \
Calculus: Part 1", "Title",
 CellChangeTimes->{{3.9763069637825336`*^9, 3.976306985904839*^9}, {
  3.9765251498191147`*^9, 3.976525154404059*^9}, {3.976548519242888*^9, 
