       RowBox[{"instead", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expandRule", "=", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "idx_", "]"}], "]"}], ":>", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"fresh", "=", 
          RowBox[{"Unique", "[", "\"\<\[Alpha]\>\"", "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"g", "[", 
          RowBox[{
           RowBox[{"\[ScriptCapitalD]", "[", "idx", "]"}], ",", 
           RowBox[{"\[ScriptCapitalD]", "[", "fresh", "]"}]}], "]"}], "*", 
         RowBox[{"Hold", "[", 
          RowBox[{"A", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "fresh", "]"}], "]"}], "]"}]}]}],
        "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"solve", " ", "contraction", " ", "\"\<race\>\""}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Step", " ", 
     RowBox[{"A", ":", 
      RowBox[{"Expand", " ", "and", " ", "Freeze", " ", "A"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"termExpanded", "=", 
     RowBox[{"termDown", "/.", " ", "expandRule"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Step", " ", 
     RowBox[{"B", ":", 
      RowBox[{"Apply", " ", "Metric", " ", "Rules", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Metric", " ", "can", " ", "only", " ", "see", " ", "B"}], ",", 
         RowBox[{"not", " ", "A"}]}], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"termReduced", "=", 
     RowBox[{"termExpanded", "/.", " ", "metricRules"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Step", " ", 
     RowBox[{"C", ":", 
      RowBox[{"Unfreeze", " ", "A"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"termFinal", "=", 
     RowBox[{"ReleaseHold", "[", "termReduced", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Step", " ", 
     RowBox[{"D", ":", "Compare"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertEqual", "[", 
     RowBox[{
     "termFinal", ",", "termUp", 
      ",", "\"\<Metric Equivalence (A_v B^v reduces to A^u B_u)\>\""}], "]"}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
