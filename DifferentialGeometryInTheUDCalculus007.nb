   3.977100741874609*^9, 
   3.977100816075472*^9}},ExpressionUUID->"2834b5d7-afd0-4067-8c5b-\
879581e0ddeb"],

Cell["\<\
Grammar: \[ScriptCapitalU]\[ScriptCapitalD] knows that adding a vector to a \
covector is physically meaningless and will stop with a valence check.\
\>", "Item",
 CellChangeTimes->{
  3.976805343965353*^9, {3.976807171258144*^9, 3.976807218345378*^9}, {
   3.976807258054213*^9, 3.976807372892746*^9}, {3.9768074213746433`*^9, 
