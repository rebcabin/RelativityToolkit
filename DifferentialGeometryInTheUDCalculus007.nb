   3.976812050879884*^9},ExpressionUUID->"cd9165ac-ec33-4030-a371-\
a29844f3d2e5"],

Cell[TextData[{
 "Canonicalization: An algebra engine that recognizes, for instance, that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Mu]"], 
    SubscriptBox["B", "\[Mu]"]}], TraditionalForm]],ExpressionUUID->
  "b08fd7d9-1325-4e66-9f34-4a587c9058b0"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Nu]"], 
    SubscriptBox["B", "\[Nu]"]}], TraditionalForm]],ExpressionUUID->
  "5bce9195-340a-49e3-8e67-6d37a6b823e5"],
 ", etc. are the same objects"
}], "Item",
 CellChangeTimes->{
  3.976805343965353*^9, {3.976807171258144*^9, 3.976807218345378*^9}, {
   3.976807258054213*^9, 3.976807372892746*^9}, {3.9768074213746433`*^9, 
   3.9768076068674717`*^9}, {3.976807777446004*^9, 3.9768078346242523`*^9}, {
