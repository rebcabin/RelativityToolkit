       RowBox[{"t1", ",", "t2", ",", "res", ",", "dummies", ",", "unique"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"t1", "=", 
        RowBox[{"A", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", 
          RowBox[{"Superscript", "[", 
           RowBox[{"\"\<a\>\"", ",", "\"\<\[Prime]\>\""}], "]"}], "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"t2", "=", 
        RowBox[{"B", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", 
          RowBox[{"Superscript", "[", 
           RowBox[{"\"\<b\>\"", ",", "\"\<\[Prime]\>\""}], "]"}], "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"res", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"t1", "*", "t2"}], ")"}], "/.", " ", 
         "robustTransformRules"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Find", " ", "ANY", " ", "Symbol", " ", "inside", " ", "U", " ", 
          "or", " ", 
          RowBox[{"D", ".", " ", "Since"}], " ", "input", " ", "was", " ", 
          "Superscript"}], ",", " ", 
         RowBox[{"these", " ", "MUST", " ", "be", " ", "generated", " ", 
          RowBox[{"indices", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"dummies", "=", 
        RowBox[{"Cases", "[", 
         RowBox[{"res", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[ScriptCapitalU]", "|", "\[ScriptCapitalD]"}], ")"}], "[",
             "i_Symbol", "]"}], ":>", "i"}], ",", "Infinity"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"unique", "=", 
        RowBox[{"DeleteDuplicates", "[", "dummies", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Expect", " ", "exactly", " ", "2", " ", "distinct", " ", "indices", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"one", " ", "for", " ", "A"}], ",", " ", 
           RowBox[{"one", " ", "for", " ", "B"}]}], ")"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "unique", "]"}], "==", "2"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"PassCount", "++"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<[PASS] Alpha-Conversion (Generated distinct indices: \
\>\"", ",", "unique", ",", "\"\<)\>\""}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"FailCount", "++"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<[FAIL] Alpha-Conversion (Collision detected: \>\"", ",",
             "unique", ",", "\"\<)\>\""}], "]"}]}]}], "]"}], ";"}]}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"METRIC", " ", "EQUIVALENCE", " ", "TEST", " ", 
     RowBox[{"(", 
      RowBox[{"The", " ", "Physicality", " ", "Check"}], ")"}]}], 
    "                          ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n--- METRIC EQUIVALENCE (A^u B_u == A_v B^v) ---\>\"",
      "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "Define", " ", "the", " ", "two", " ", "forms"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"termUp", "=", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], 
      RowBox[{"B", "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], "]"}]}]}], ";"}], 
   " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"A", "^", "u"}], " ", "B_u"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"termDown", "=", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "]"}], 
      RowBox[{"B", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}]}], ";"}], 
   " ", 
   RowBox[{"(*", 
    RowBox[{"A_v", " ", 
     RowBox[{"B", "^", "v"}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Verify", " ", "they", " ", "are", " ", "STRUCTURALLY", " ", 
     "distinct"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"CanonicalizeIndices", "[", "termUp", "]"}], "=!=", 
       RowBox[{"CanonicalizeIndices", "[", "termDown", "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"PassCount", "++"}], ";", "\[IndentingNewLine]", 
       RowBox[{
       "Print", 
        "[", "\"\<[PASS] Structural Distinction (A^u B_u != A_v B^v \
initially)\>\"", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"FailCount", "++"}], ";", "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", "\"\<[FAIL] Structural Distinction failed\>\"", 
        "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Verify", " ", "they", " ", "are", " ", "PHYSICALLY", " ", 
     "equivalent"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"PROOF", " ", 
       RowBox[{"STRATEGY", ":", "\[IndentingNewLine]", " ", 
        RowBox[{"1.", " ", "Expand", " ", "A_v"}]}]}], "->", 
      RowBox[{
       RowBox[{"g_va", " ", 
        RowBox[{
         RowBox[{"A", "^", "a"}], ".", " ", "\[IndentingNewLine]", "2."}], " ", 
        RowBox[{"Hold", "[", "]"}], " ", 
        RowBox[{"A", "^", "a"}], " ", "so", " ", "the", " ", "metric", " ", 
        RowBox[{"doesn", "'"}], "t", " ", "immediately", " ", "re"}], "-", 
       RowBox[{"lower", " ", 
        RowBox[{"it", ".", " ", "\[IndentingNewLine]", "3"}]}]}]}], ",", " ", 
     
     RowBox[{
     "forcing", " ", "forces", " ", "the", " ", "metric", " ", "to", " ", 
      "lower", " ", "B", " ", 
      RowBox[{"instead", "."}]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expandRule", "=", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "idx_", "]"}], "]"}], ":>", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"fresh", "=", 
          RowBox[{"Unique", "[", "\"\<\[Alpha]\>\"", "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"g", "[", 
          RowBox[{
           RowBox[{"\[ScriptCapitalD]", "[", "idx", "]"}], ",", 
           RowBox[{"\[ScriptCapitalD]", "[", "fresh", "]"}]}], "]"}], "*", 
         RowBox[{"Hold", "[", 
          RowBox[{"A", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "fresh", "]"}], "]"}], "]"}]}]}],
        "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"solve", " ", "contraction", " ", "\"\<race\>\""}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Step", " ", 
     RowBox[{"A", ":", 
      RowBox[{"Expand", " ", "and", " ", "Freeze", " ", "A"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"termExpanded", "=", 
     RowBox[{"termDown", "/.", " ", "expandRule"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Step", " ", 
     RowBox[{"B", ":", 
      RowBox[{"Apply", " ", "Metric", " ", "Rules", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Metric", " ", "can", " ", "only", " ", "see", " ", "B"}], ",", 
         RowBox[{"not", " ", "A"}]}], ")"}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"termReduced", "=", 
     RowBox[{"termExpanded", "/.", " ", "metricRules"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Step", " ", 
     RowBox[{"C", ":", 
      RowBox[{"Unfreeze", " ", "A"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"termFinal", "=", 
     RowBox[{"ReleaseHold", "[", "termReduced", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Step", " ", 
     RowBox[{"D", ":", "Compare"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"AssertEqual", "[", 
     RowBox[{
     "termFinal", ",", "termUp", 
      ",", "\"\<Metric Equivalence (A_v B^v reduces to A^u B_u)\>\""}], "]"}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
