     StyleBox["\<\"Action\"\>",
      StripOnInput->False,
      FontFamily->"Helvetica",
      FontSize->12,
      FontWeight->Bold]},
    {"\<\"1. Start\"\>", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", 
        SubscriptBox["", "\[Nu]"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"B", 
        SuperscriptBox["", "\[Nu]"]}], ")"}]}], "\<\"Input: A_v B^v\"\>"},
    {"\<\"2. Definition\"\>", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", 
        SuperscriptBox["", "\[Alpha]"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"B", 
        SuperscriptBox["", "\[Nu]"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"g", 
        SubscriptBox["", "\[Nu]"], 
        SubscriptBox["", "\[Alpha]"]}], 
       ")"}]}], "\<\"Expand covector: A_v \\\\[rightarrow] g_va A^a\"\>"},
    {"\<\"3. Commute\"\>", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", 
        SuperscriptBox["", "\[Alpha]"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"B", 
        SuperscriptBox["", "\[Nu]"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"g", 
        SubscriptBox["", "\[Nu]"], 
        SubscriptBox["", "\[Alpha]"]}], 
       ")"}]}], "\<\"Group metric with B: A^a (g_va B^v)\"\>"},
    {"\<\"4. Contract\"\>", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", 
        SubscriptBox["", "\[Nu]"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"B", 
        SuperscriptBox["", "\[Nu]"]}], 
       ")"}]}], "\<\"Lower index on B: A^a B_a\"\>"}
   },
