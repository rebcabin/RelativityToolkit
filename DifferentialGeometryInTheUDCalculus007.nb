   3.976834459521805*^9, 
   3.9768344623370237`*^9}},ExpressionUUID->"7a1114db-6540-4b27-9ac8-\
f6aa69c7bd79"],

Cell["\<\
This work builds upon my previous notebooks on special and general \
relativity, where \[ScriptCapitalU]\[ScriptCapitalD] \
(\[OpenCurlyDoubleQuote]Up/Down\[CloseCurlyDoubleQuote]) notation was first \
introduced to disambiguate covariant and contravariant indices.\
\>", "Text",
 CellChangeTimes->{
  3.976805343965353*^9, {3.976807171258144*^9, 3.976807218345378*^9}, {
   3.976807258054213*^9, 3.976807372892746*^9}, {3.9768074213746433`*^9, 
   3.9768076068674717`*^9}, {3.976807777446004*^9, 3.9768078346242523`*^9}, {
   3.9768078710978737`*^9, 3.976808012037896*^9}, {3.976808060432528*^9, 
   3.976808289126133*^9}, {3.9768344209622917`*^9, 3.976834455887733*^9}, {
   3.976836414235784*^9, 
   3.976836436533702*^9}},ExpressionUUID->"6c093cfe-867f-4442-bc9a-\
aafb8dc7a719"],

Cell[CellGroupData[{

Cell["Deployment", "Subsubsection",
 CellChangeTimes->{
  3.976805343965353*^9, {3.976807171258144*^9, 3.976807218345378*^9}, {
   3.976807258054213*^9, 3.976807372892746*^9}, {3.9768074213746433`*^9, 
   3.9768076068674717`*^9}, {3.976807777446004*^9, 3.9768078346242523`*^9}, {
   3.9768078710978737`*^9, 3.976808012037896*^9}, {3.976808060432528*^9, 
   3.976808298146921*^9}, {3.976831814458446*^9, 
   3.976831818664319*^9}},ExpressionUUID->"1d8e7413-9232-41e1-be9e-\
2ae8777c2446"],

Cell["\<\
To ensure this notebook is self-contained and reproducible, the entire source \
code for \[ScriptCapitalU]\[ScriptCapitalD]\[CloseCurlyQuote]s relativity \
toolkit, with its unit tests and regression tests, is included inline here. \
In future installments, as the codebase grows, we will transition to \
open-source distribution hosted on GitHub or the Wolfram Cloud.\
\>", "Text",
 CellChangeTimes->{
  3.976805343965353*^9, {3.976807171258144*^9, 3.976807218345378*^9}, {
   3.976807258054213*^9, 3.976807372892746*^9}, {3.9768074213746433`*^9, 
