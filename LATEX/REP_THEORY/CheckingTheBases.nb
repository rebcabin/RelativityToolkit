Cell[CellGroupData[{

Cell[TextData[{
 "Prove ",
 Cell[BoxData[
  FormBox[
   RowBox[{"J", "\[LongLeftRightArrow]", "T"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "878a0c67-064e-48cf-b2de-0d12acce0523"],
 " Isomorphism "
}], "Subsubsection",
 CellChangeTimes->{{3.982881074743064*^9, 3.9828811043726377`*^9}, {
  3.982922631534801*^9, 
  3.982922659691125*^9}},ExpressionUUID->"055e3325-7425-4f6e-87a5-\
150928de4fbc"],

Cell[TextData[{
 "The map ",
 StyleBox["JtoT", "Input"],
 " preserves the Lie bracket.\nLet X and Y be arbitrary elements in the J\
\[NoBreak]-\[NoBreak]span.\nIf equivalent, ",
 StyleBox["JtoT([X, Y])", "Input"],
 " must equal ",
 StyleBox["[JtoT(X),JtoT(Y)]", "Input"],
 ".\nDitto TtoJ."
}], "Text",
 CellChangeTimes->{{3.982881074743064*^9, 3.9828811243140097`*^9}, {
  3.9828811932538557`*^9, 3.982881196265588*^9}, {3.9829226664560623`*^9, 
  3.982922675196835*^9}, {3.98292270563875*^9, 3.982922721340384*^9}, {
  3.982923070884584*^9, 
  3.982923134492877*^9}},ExpressionUUID->"7e0f4814-5d0a-462c-a161-\
e404d1fe862c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "X", ",", "Y", ",", "x1", ",", "x2", ",", "x3", ",", "y1", ",", "y2", ",", 
    "y3", ",", "proveIsomorphism", ",", "commM"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"commM", "[", 
    RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"A", ".", "B"}], "-", 
    RowBox[{"B", ".", "A"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"X", "[", "M_", "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}], "*", "M"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Y", "[", "M_", "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y1", ",", "y2", ",", "y3"}], "}"}], "*", "M"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"proveIsomorphism", "[", 
    RowBox[{"TO_", ",", "X_", ",", "Y_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"TO", "[", 
      RowBox[{"commM", "[", 
       RowBox[{"X", ",", "Y"}], "]"}], "]"}], "==", 
     RowBox[{"commM", "[", 
      RowBox[{
       RowBox[{"TO", "[", "X", "]"}], ",", 
       RowBox[{"TO", "[", "Y", "]"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"proveIsomorphism", "[", 
  RowBox[{"JtoT", ",", 
   RowBox[{"X", "[", "J", "]"}], ",", 
   RowBox[{"Y", "[", "J", "]"}]}], "]"}], "\n", 
 RowBox[{"proveIsomorphism", "[", 
  RowBox[{"TtoJ", ",", 
   RowBox[{"X", "[", "T", "]"}], ",", 
   RowBox[{"Y", "[", "T", "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.982881074743064*^9, 3.9828810933880577`*^9}, {
  3.982881129425324*^9, 3.982881239034292*^9}, {3.98288127239357*^9, 
  3.9828813079709673`*^9}, {3.982922729190296*^9, 3.982922734565143*^9}, {
  3.9829227688835897`*^9, 
  3.98292306115405*^9}},ExpressionUUID->"4f89967a-153a-4312-9482-\
b4a46db7996a"]
}, Open  ]]
}, Open  ]],

