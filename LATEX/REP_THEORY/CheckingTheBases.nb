Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"comm", ",", "commTest", ",", "triples"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"comm", "[", "M_", "]"}], "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"M", "[", 
      RowBox[{"[", "i", "]"}], "]"}], ".", 
     RowBox[{"M", "[", 
      RowBox[{"[", "j", "]"}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"M", "[", 
      RowBox[{"[", "j", "]"}], "]"}], ".", 
     RowBox[{"M", "[", 
      RowBox[{"[", "i", "]"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"commTest", "[", "M_", "]"}], "[", 
    RowBox[{"i_", ",", "j_", ",", "k_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"comm", "[", "M", "]"}], "[", 
