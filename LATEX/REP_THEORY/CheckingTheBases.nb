Cell[CellGroupData[{

Cell[TextData[{
 "Prove ",
 Cell[BoxData[
  FormBox[
   RowBox[{"J", "\[LongLeftRightArrow]", "T"}], TraditionalForm]],
  ExpressionUUID->"878a0c67-064e-48cf-b2de-0d12acce0523"],
 " Isomorphism "
}], "Section",
 CellChangeTimes->{{3.982881074743064*^9, 3.9828811043726377`*^9}, {
  3.982922631534801*^9, 
  3.982922659691125*^9}},ExpressionUUID->"055e3325-7425-4f6e-87a5-\
150928de4fbc"],

Cell[TextData[{
 "In addition to round-trip identity, we must show that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"J", "\[LongLeftRightArrow]", "T"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "25333bd1-b113-40cc-93c1-002e9cb29187"],
 " maps preserve the Lie bracket."
}], "Text",
 CellChangeTimes->{{3.982881074743064*^9, 3.9828811243140097`*^9}, {
  3.9828811932538557`*^9, 3.982881196265588*^9}, {3.9829226664560623`*^9, 
  3.982922675196835*^9}, {3.98292270563875*^9, 3.982922721340384*^9}, {
  3.982923070884584*^9, 3.982923134492877*^9}, {3.983004041926342*^9, 
  3.983004087601804*^9}, {3.983007304160005*^9, 
  3.983007394653763*^9}},ExpressionUUID->"7e0f4814-5d0a-462c-a161-\
e404d1fe862c"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]],ExpressionUUID->
  "a9476e8b-33c4-4ab2-8d94-315b1f688af7"],
 " and ",
 Cell[BoxData[
  FormBox["Y", TraditionalForm]],ExpressionUUID->
  "79307bb4-e326-4cf3-9d0a-ea66c4bfa657"],
 " be arbitrary elements in the ",
 Cell[BoxData[
  FormBox["J", TraditionalForm]],ExpressionUUID->
  "a9290471-1f8f-4c90-9fec-0e7b95fb496e"],
 "\[NoBreak]-\[NoBreak]span or the ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],ExpressionUUID->
  "698a5c94-0648-4b5f-abfc-4430eff8bd3b"],
 "\[NoBreak]-\[NoBreak]span."
}], "Text",
 CellChangeTimes->{{3.982881074743064*^9, 3.9828811243140097`*^9}, {
  3.9828811932538557`*^9, 3.982881196265588*^9}, {3.9829226664560623`*^9, 
  3.982922675196835*^9}, {3.98292270563875*^9, 3.982922721340384*^9}, {
  3.982923070884584*^9, 3.982923134492877*^9}, {3.983004041926342*^9, 
  3.983004087601804*^9}, {3.983007304160005*^9, 
  3.983007395836751*^9}},ExpressionUUID->"9c0a422b-b3f3-435d-aa53-\
9282658cb769"],

Cell[TextData[{
 StyleBox["JtoT", "Input"],
 " preserves the Lie Bracket iff ",
 StyleBox["JtoT([X, Y])", "Input"],
 " equals ",
 StyleBox["[JtoT(X),JtoT(Y)]", "Input"],
 ". Ditto ",
 StyleBox["TtoJ", "Input"],
 "."
}], "Text",
 CellChangeTimes->{{3.982881074743064*^9, 3.9828811243140097`*^9}, {
  3.9828811932538557`*^9, 3.982881196265588*^9}, {3.9829226664560623`*^9, 
  3.982922675196835*^9}, {3.98292270563875*^9, 3.982922721340384*^9}, {
  3.982923070884584*^9, 3.982923134492877*^9}, {3.983004041926342*^9, 
  3.983004087601804*^9}, {3.983007304160005*^9, 3.983007400849123*^9}, {
  3.983007642151194*^9, 
  3.983007670042687*^9}},ExpressionUUID->"db1cc6e4-6ebb-4130-bd29-\
fbf893296460"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "X", ",", "Y", ",", "x1", ",", "x2", ",", "x3", ",", "y1", ",", "y2", ",", 
    "y3", ",", "TJisomorphism", ",", "commM"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"commM", "[", 
    RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"A", ".", "B"}], "-", 
    RowBox[{"B", ".", "A"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"X", "[", "M_", "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}], "*", "M"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Y", "[", "M_", "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y1", ",", "y2", ",", "y3"}], "}"}], "*", "M"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"TJisomorphism", "[", 
    RowBox[{"TO_", ",", "X_", ",", "Y_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"TO", "[", 
      RowBox[{"commM", "[", 
       RowBox[{"X", ",", "Y"}], "]"}], "]"}], "==", 
     RowBox[{"commM", "[", 
      RowBox[{
       RowBox[{"TO", "[", "X", "]"}], ",", 
       RowBox[{"TO", "[", "Y", "]"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"proof", "@", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     StyleBox[
      RowBox[{"TJisomorphism", "[", 
       RowBox[{"JtoT", ",", 
        RowBox[{"X", "[", "J", "]"}], ",", 
        RowBox[{"Y", "[", "J", "]"}]}], "]"}],
      FontColor->RGBColor[0.14, 0.8, 0.14]], "&&", "\[IndentingNewLine]", 
     StyleBox[
      RowBox[{"TJisomorphism", "[", 
       RowBox[{"TtoJ", ",", 
        RowBox[{"X", "[", "T", "]"}], ",", 
        RowBox[{"Y", "[", "T", "]"}]}], "]"}],
      FontColor->RGBColor[0.14, 0.8, 0.14]]}], ")"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.982881074743064*^9, 3.9828810933880577`*^9}, {
  3.982881129425324*^9, 3.982881239034292*^9}, {3.98288127239357*^9, 
  3.9828813079709673`*^9}, {3.982922729190296*^9, 3.982922734565143*^9}, {
