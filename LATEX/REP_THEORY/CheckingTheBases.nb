  3.9829226274139357`*^9}},ExpressionUUID->"6e8972ee-e8af-4283-aadd-\
354e1d19572b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "testCoeffs", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"testCoeffs", "=", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"testJ", "=", 
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"testCoeffs", "*", "J"}], "]"}], ",", "\"\<testJ\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"testT", "=", 
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"testCoeffs", "*", "T"}], "]"}], ",", "\"\<testT\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "proveTJRoundTrip", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"proveTJRoundTrip", "[", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Expand", "[", 
      RowBox[{"JtoT", "[", 
       RowBox[{"TtoJ", "[", "testT", "]"}], "]"}], "]"}], "==", "testT"}], "&&",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Expand", "[", 
      RowBox[{"TtoJ", "[", 
       RowBox[{"JtoT", "[", "testJ", "]"}], "]"}], "]"}], "==", "testJ"}]}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{"proveTJRoundTrip", "[", "]"}]}], "Input",
 CellChangeTimes->{{3.9828705864896097`*^9, 3.98287067364072*^9}, 
