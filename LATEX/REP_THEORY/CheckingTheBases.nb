Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\[CurlyEpsilon]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CurlyEpsilon]", "=", 
   RowBox[{"LeviCivitaTensor", "[", "3", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "proveCyclicity", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"proveCyclicity", "[", "M_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"And", "@@", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"comm", "[", "J", "]"}], "[", 
         RowBox[{"i", ",", "j"}], "]"}], "==", "\[IndentingNewLine]", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"J", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "*", 
           RowBox[{"\[CurlyEpsilon]", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"proveCyclicity", "[", "J", "]"}]}], "Input",
 CellChangeTimes->{{3.982921239576543*^9, 3.982921293646531*^9}, {
