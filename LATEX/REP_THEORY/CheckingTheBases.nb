Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"comm", ",", "commTest", ",", "triples"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"comm", "[", "M_", "]"}], "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"M", "[", 
      RowBox[{"[", "i", "]"}], "]"}], ".", 
     RowBox[{"M", "[", 
      RowBox[{"[", "j", "]"}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"M", "[", 
      RowBox[{"[", "j", "]"}], "]"}], ".", 
     RowBox[{"M", "[", 
      RowBox[{"[", "i", "]"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"commTest", "[", "M_", "]"}], "[", 
    RowBox[{"i_", ",", "j_", ",", "k_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"comm", "[", "M", "]"}], "[", 
     RowBox[{"i", ",", "j"}], "]"}], "==", 
    RowBox[{"M", "[", 
     RowBox[{"[", "k", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"triples", "=", 
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"NestList", "[", 
      RowBox[{"RotateLeft", ",", 
       RowBox[{"Range", "[", "3", "]"}], ",", "2"}], "]"}], 
     ",", "\"\<index triples :\>\""}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"And", "@@", 
  RowBox[{
   RowBox[{"commTest", "[", "J", "]"}], "@@@", "triples"}]}]}], "Input",
