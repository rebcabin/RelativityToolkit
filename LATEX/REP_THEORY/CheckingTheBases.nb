   3.983007039305171*^9}},ExpressionUUID->"363c29a6-6447-4f1f-bc72-\
51ac929d5246"],

Cell[TextData[{
 "Every element ",
 Cell[BoxData[
  FormBox[
   RowBox[{"X", "\[Element]", "\[GothicG]"}], TraditionalForm]],
  ExpressionUUID->"13374a95-1b91-4de1-8ea8-01a7a7938407"],
 " defines a linear map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["ad", "X"], "(", "Z", ")"}], "=", " ", 
    RowBox[{"[", 
     RowBox[{"X", ",", "Z"}], "]"}]}], TraditionalForm]],ExpressionUUID->
  "72909316-8cb2-4eb8-9f9b-0fe2f30db8b5"],
 ". The ",
 StyleBox["Killing form",
  FontWeight->"Bold"],
 " is the trace of such maps:"
}], "Text",
 CellChangeTimes->{{3.982923720576329*^9, 3.982923852768676*^9}, {
  3.983003557988961*^9, 3.9830035829192657`*^9}, {3.983007056653413*^9, 
  3.9830070662065077`*^9}, {3.98300710055445*^9, 
  3.98300710067988*^9}},ExpressionUUID->"42adb832-ccac-4598-bbc7-\
0c5c9ee08f83"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"B", 
    RowBox[{"(", 
     RowBox[{"X", ",", "Y"}], ")"}]}], "=", 
   RowBox[{"Tr", "[", 
    RowBox[{
     SubscriptBox["ad", "X"], "\[SmallCircle]", 
     SubscriptBox["ad", "Y"]}], "]"}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.982923859043405*^9, 
  3.982923970519051*^9}},ExpressionUUID->"d60cae3d-b734-45b3-aed1-\
420776ab30b1"],

Cell["\<\
Intrinsic geometry of a Lie algebra \[GothicG] comes from its Killing form. \
For simple Lie Algebras like \[GothicS]\[GothicO](3) and \
\[GothicS]\[GothicU](2), Schur\[CloseCurlyQuote]s Lemma implies that any \
invariant, symmetric, bilinear form is proportional to the Killing form, so \
the following trace formulas are proportional to the Killing forms.\
\>", "Text",
 CellChangeTimes->{{3.982924081465349*^9, 3.982924178250703*^9}, {
  3.983007081626343*^9, 
  3.983007094745018*^9}},ExpressionUUID->"9adbe235-7b75-457b-b804-\
72902e14e907"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"Tr", "[", 
     RowBox[{
      SubscriptBox["J", "i"], "\[CenterDot]", 
      SubscriptBox["J", "j"]}], "]"}], "=", 
    RowBox[{
     RowBox[{"-", "2"}], 
     SubscriptBox["\[Delta]", 
      RowBox[{"i", "\[VeryThinSpace]", "j"}]]}]}], " ", ",", "    ", 
   RowBox[{
    RowBox[{"Tr", "[", 
     RowBox[{
      SubscriptBox["T", "i"], "\[CenterDot]", 
      SubscriptBox["T", "j"]}], "]"}], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     SubscriptBox["\[Delta]", 
      RowBox[{"i", "\[VeryThinSpace]", "j"}]]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.982869854167696*^9, 3.982869962582293*^9}, {
  3.982870511543262*^9, 3.9828705736720257`*^9}, {3.9829240247383432`*^9, 
