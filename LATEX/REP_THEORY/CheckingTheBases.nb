Cell[CellGroupData[{

Cell["Map the T-basis to the J-basis", "Subsubsection",
 CellChangeTimes->{{3.982825948301203*^9, 
  3.982825957096223*^9}},ExpressionUUID->"ab00759b-7b8d-436a-9299-\
40718f094115"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Pi]Map", "[", "TMat_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"I", " ", 
