Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"Description\"\>",
      StripOnInput->False,
      FontSize->16,
      FontWeight->Bold], 
     StyleBox["\<\"Rendered Output\"\>",
      StripOnInput->False,
      FontSize->16,
      FontWeight->Bold]},
    {
     StyleBox["\<\"Generic Mixed Partial\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], "f"}], 
       RowBox[{
        RowBox[{"\[PartialD]", "x"}], 
        RowBox[{"\[PartialD]", "y"}]}]],
      DisplayForm]},
    {
     StyleBox["\<\"Coordinate Hessian (The 'Garbage Term')\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      FractionBox[
       RowBox[{
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], "x"}], 
        SuperscriptBox["", 
         SuperscriptBox["\[Alpha]", "\[Prime]",
          MultilineFunction->None]]}], 
       RowBox[{
        RowBox[{"\[PartialD]", "x"}], 
        SuperscriptBox["", "\[Alpha]"], 
        RowBox[{"\[PartialD]", "x"}], 
        SuperscriptBox["", "\[Beta]"]}]],
      DisplayForm]},
    {
     StyleBox["\<\"Nested in an Equation\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      RowBox[{"lhs", "\[Equal]", 
       FractionBox[
        RowBox[{
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], "A"}], 
         SuperscriptBox["", "\[Mu]"]}], 
        RowBox[{
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "\[Lambda]"], 
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "\[Nu]"]}]]}],
      DisplayForm]},
    {
     StyleBox["\<\"Multiplied by Jacobian\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], "x"}], 
         SuperscriptBox["", 
          SuperscriptBox["\[Alpha]", "\[Prime]",
           MultilineFunction->None]]}], 
        RowBox[{
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "\[Alpha]"], 
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "\[Beta]"]}]], " ", 
       FractionBox[
        RowBox[{
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "\[Beta]"]}], 
        RowBox[{
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", 
          SuperscriptBox["\[Beta]", "\[Prime]",
           MultilineFunction->None]]}]]}],
      DisplayForm]},
    {
     StyleBox["\<\"Comma Notation\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      SubscriptBox[
       RowBox[{"A", 
        SuperscriptBox["", "\[Mu]"]}], 
       RowBox[{",", "\[Nu]"}]],
      DisplayForm]},
    {
     StyleBox["\<\"Covariant Derivative (Abstract)\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      TagBox[
       SubscriptBox[
        RowBox[{"A", 
         SuperscriptBox["", "\[Mu]"]}], 
        RowBox[{";", "\[Nu]"}]],
       HoldForm],
      DisplayForm]},
    {
     StyleBox["\<\"Covariant Derivative (Expanded)\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      TagBox[
       RowBox[{
        SubscriptBox[
         RowBox[{"A", 
          SuperscriptBox["", "\[Mu]"]}], 
         RowBox[{",", "\[Nu]"}]], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"A", 
           SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{"\[Nu]", "\[Lambda]"}], "\[Mu]"]}]}],
       HoldForm],
      DisplayForm]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{2}}, "Rows" -> {{2}}}],
  "Grid"]], "Output",
 CellChangeTimes->{3.977098772061191*^9},
 CellLabel->"Out[1]=",ExpressionUUID->"4ef29e46-5e00-4507-9eeb-8b7866cf6f2a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Covariant Derivative", "Section",
 CellChangeTimes->{{3.976976704581627*^9, 
  3.976976708832714*^9}},ExpressionUUID->"2de3c925-4bd0-4c7c-b240-\
31a502b1501e"],

Cell[TextData[{
 "Consider a curve with coordinate functions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Alpha]"], "(", "\[Lambda]", ")"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "25eddf97-a413-4337-b8ad-4295217c28a2"],
 " along the curve, tangent (contravariant) vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["u", "\[Alpha]"], "\[Congruent]", 
    RowBox[{"d", "\[VeryThinSpace]", 
     RowBox[{
      SuperscriptBox["x", "\[Alpha]"], "/", "d"}], "\[VeryThinSpace]", 
     "\[Lambda]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a614fd3d-5239-41e1-9a9d-d1b8a478337d"],
 ". Also consider a (contravariant) vector field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Alpha]"], "(", 
    RowBox[{
     SuperscriptBox["x", "\[Beta]"], "(", "\[Lambda]", ")"}], ")"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "14a50700-31d5-4a71-b872-f8a2fcac5615"],
 " defined in neighborhoods around every point ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Alpha]"], "(", "\[Lambda]", ")"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b9cebccf-ee14-41b2-a9fb-4466ffc63d88"],
 " along the curve. We\[CloseCurlyQuote]d like a \
\[OpenCurlyDoubleQuote]derivative\[CloseCurlyDoubleQuote] of the vector \
field, schematically (leaving off the parameter dependence)"
}], "Text",
 CellChangeTimes->{{3.977003584330347*^9, 3.977003894123189*^9}, {
  3.97700393339956*^9, 3.977003933603921*^9}, {3.97700419429191*^9, 
  3.977004203125691*^9}, {3.977038071780509*^9, 
  3.9770380863791122`*^9}},ExpressionUUID->"f30c4eea-54b7-48a9-86d8-\
0ee2004bdfff"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], "\[TildeFullEqual]", 
   FractionBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["A", "\[Alpha]"], "(", 
      RowBox[{
       SuperscriptBox["x", "\[Beta]"], "+", 
       RowBox[{"d", "\[VeryThinSpace]", 
        SuperscriptBox["x", "\[Beta]"]}]}], ")"}], "-", 
     RowBox[{
      SuperscriptBox["A", "\[Alpha]"], "(", 
      SuperscriptBox["x", "\[Beta]"], ")"}]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
  3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
  3.977038167010255*^9}},
 CellTags->
  "NAIVE DERIVATIVE",ExpressionUUID->"3e7185b2-be53-4220-8811-709ca7e96e9e"],

Cell[TextData[{
 "Seems a reasonable thing to ask: \[OpenCurlyDoubleQuote]How much does \
component \[Alpha] of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "36d19af6-deaa-40f7-bc14-9200e072bb19"],
 " change when I change coordinate \[Beta] a little?\[CloseCurlyDoubleQuote] \
However, the derivative cannot be cogently defined this way because we cannot \
subtract vectors at different points, not even infinitesimally different \
points. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Alpha]"], "(", 
    RowBox[{
     SuperscriptBox["x", "\[Beta]"], "+", 
     RowBox[{"d", "\[VeryThinSpace]", 
      SuperscriptBox["x", "\[Beta]"]}]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "bc3b0f48-fa92-493b-9e9d-1a4a55f319f2"],
 " doesn\[CloseCurlyQuote]t point in the same direction as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Alpha]"], "(", 
    SuperscriptBox["x", "\[Beta]"], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "249a1cde-bf33-4176-8766-580efd21b2c2"],
 "! The vectors are in different tangent spaces. Subtracting them, \
numerically, will scramble information from other directions because the \
underlying manifold curves away. "
}], "Text",
 CellChangeTimes->{{3.9770040526557817`*^9, 3.9770040885876007`*^9}, {
   3.977004137896049*^9, 3.977004145931327*^9}, {3.977004214858284*^9, 
   3.977004294138308*^9}, {3.977004332057253*^9, 3.977004333463525*^9}, {
   3.9770043811140347`*^9, 3.977004453579987*^9}, {3.977007247223049*^9, 
   3.9770072547584133`*^9}, {3.977038173587933*^9, 3.977038497226171*^9}, {
   3.977038540931356*^9, 3.977038579669528*^9}, {3.977038804232141*^9, 
   3.97703884675251*^9}, {3.9770389951471367`*^9, 3.977039023921427*^9}, 
   3.977039241349597*^9, {3.977039455610796*^9, 
   3.977039487120262*^9}},ExpressionUUID->"a239f143-eb86-4585-91e4-\
d5fe602fcb92"],

Cell[TextData[{
 "To answer this conundrum, we need backwards ",
 StyleBox["parallel transport",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", to move the vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Alpha]"], "(", 
    RowBox[{
     SuperscriptBox["x", "\[Beta]"], "+", 
     RowBox[{"d", "\[VeryThinSpace]", 
      SuperscriptBox["x", "\[Beta]"]}]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}},ExpressionUUID->
  "954043c7-1de4-4d21-899a-eb0453ee02f7"],
 " smoothly and with a ",
 StyleBox["provable minimum",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of \[OpenCurlyDoubleQuote]bending\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]twisting\[CloseCurlyDoubleQuote], back from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Beta]"], "+", 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]}], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}},ExpressionUUID->
  "138f83e9-acfc-4786-be80-9dc3019c8501"],
 " to the point ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Beta]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ca25019d-7152-4bf1-9a0a-380875f5301f"],
 " so we can measure the components of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Alpha]"], "(", 
    RowBox[{
     SuperscriptBox["x", "\[Beta]"], "+", 
     RowBox[{"d", "\[VeryThinSpace]", 
      SuperscriptBox["x", "\[Beta]"]}]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}},ExpressionUUID->
  "46b2224c-75e4-408d-bdb8-08a547aa5257"],
 " on the coordinate axes (basis vectors) at point ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Beta]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ca6466ff-fce0-4260-b3c8-736acff0f49c"],
 " and then subtract the numbers. "
}], "Text",
 CellChangeTimes->{{3.9770040526557817`*^9, 3.9770040885876007`*^9}, {
  3.977004137896049*^9, 3.977004145931327*^9}, {3.977004214858284*^9, 
  3.977004294138308*^9}, {3.977004332057253*^9, 3.977004333463525*^9}, {
  3.9770043811140347`*^9, 3.977004453579987*^9}, {3.977007247223049*^9, 
  3.9770072547584133`*^9}, {3.977038173587933*^9, 3.9770382226080093`*^9}, {
  3.977038589248727*^9, 3.977038632705469*^9}, {3.977039144347281*^9, 
  3.9770392038997087`*^9}, {3.977039626915082*^9, 3.9770397003204203`*^9}, {
  3.977039952082591*^9, 3.977039953245672*^9}, {3.9770400219426003`*^9, 
  3.9770400238143177`*^9}, {3.977040825192885*^9, 
  3.97704084832859*^9}},ExpressionUUID->"e975218c-da2a-4de9-b5ea-\
cae10438cf1a"],

Cell[TextData[{
 "Now, even if we could subtract the vectors, how is that difference going to \
survive a coordinate transformation? How can I find out, when I change \
coordinates from ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a6471b6e-54f3-4215-bcf4-b886803e3666"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "435b2eb2-cc59-413d-ac74-75aaddabfe42"],
 ", how much component ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3995f2d1-9ad1-4b7e-b9e6-c7f85859dbfc"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "598c03d7-c530-4062-940a-7e72659ae730"],
 "changes when I change coordinate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "809037a4-1f27-436e-8a7c-03a03746f5eb"],
 "? What\[CloseCurlyQuote]s the value of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", 
      RowBox[{"\[Alpha]", " ", "'"}]]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", 
      RowBox[{"\[Beta]", " ", "'"}]]}]], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "006d5211-41a9-47b9-b84c-db4a993c2c38"],
 " when all I know is ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "ad0cdaaa-3de0-423c-9c74-73a2f053dc22"],
 "? As always, we insist that the ",
 StyleBox["intrinsic ",
  FontSlant->"Italic"],
 "geometry and physics not depend on choice of coordinates. But what does ",
 StyleBox["intrinsic",
  FontSlant->"Italic"],
 " mean when all we have are numerical components whose values depend on \
choice of coordinates?"
}], "Text",
 CellChangeTimes->{{3.9770040526557817`*^9, 3.9770040885876007`*^9}, {
  3.977004137896049*^9, 3.977004145931327*^9}, {3.977004214858284*^9, 
  3.977004294138308*^9}, {3.977004332057253*^9, 3.977004333463525*^9}, {
  3.9770043811140347`*^9, 3.977004453579987*^9}, {3.977007247223049*^9, 
  3.9770072547584133`*^9}, {3.977038173587933*^9, 3.977038497226171*^9}, {
  3.977038540931356*^9, 3.977038558382607*^9}, {3.9770386442395363`*^9, 
  3.977038745129084*^9}, {3.977039055494041*^9, 3.977039136565977*^9}, {
  3.977039505207293*^9, 3.9770396040583878`*^9}, {3.977039995456196*^9, 
  3.977039996382832*^9}},ExpressionUUID->"5e16f76b-3674-4a09-b04e-\
c36a63426924"],

Cell[TextData[{
 "To answer this conundrum, ",
 StyleBox["intrinsic",
  FontSlant->"Italic"],
 " is exactly what we mean by ",
 StyleBox["tensorial",
  FontSlant->"Italic"],
 ". Our desired, derivative-like quantities ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "5b1991d2-15d1-4220-85bf-ec11b979dd38"],
 " must transform like a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "480fe5fc-cace-4565-8fba-672aaa6601fc"],
 " tensor as we change the basis vectors at point \[Beta]. The components of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "d9667a78-36d4-4259-a2ac-e93a4343b61c"],
 " must change with coordinate frames in exactly the way any other geometric \
or physical quantity with two indices, one up and one down, would change, so \
that projections on basis vectors, or any other vectors, measure geometric \
and physical properties, not properties of the coordinate systems \
themselves."
}], "Text",
 CellChangeTimes->{{3.9770040526557817`*^9, 3.9770040885876007`*^9}, {
  3.977004137896049*^9, 3.977004145931327*^9}, {3.977004214858284*^9, 
  3.977004294138308*^9}, {3.977004332057253*^9, 3.977004333463525*^9}, {
  3.9770043811140347`*^9, 3.977004453579987*^9}, {3.977007247223049*^9, 
  3.9770072547584133`*^9}, {3.977038173587933*^9, 3.9770382226080093`*^9}, {
  3.977038589248727*^9, 3.977038632705469*^9}, {3.977039144347281*^9, 
  3.9770391878980713`*^9}, {3.977039219320077*^9, 3.977039335691654*^9}, {
  3.977039726634755*^9, 3.9770398631459713`*^9}, {3.9770408810411873`*^9, 
  3.9770409177565737`*^9}, {3.977040985697022*^9, 
  3.9770410320985518`*^9}},ExpressionUUID->"0302b9c0-b730-4187-bdbe-\
4c9b469958ec"],

Cell["\<\
It turns out that simply demanding that our new derivative be tensorial and \
linear suffices to solve the problem. \
\>", "Text",
 CellChangeTimes->{{3.977004335524499*^9, 3.9770043704738903`*^9}, {
   3.977004459862672*^9, 3.977004462955502*^9}, {3.977004607950364*^9, 
   3.977004657450521*^9}, {3.9770051541433764`*^9, 3.977005223612775*^9}, {
   3.97700531611539*^9, 3.9770055667106743`*^9}, {3.9770056293925962`*^9, 
   3.977005692088046*^9}, {3.9770057691765127`*^9, 3.977005809766267*^9}, {
   3.9770058466687117`*^9, 3.977005916940502*^9}, {3.9770060689174433`*^9, 
   3.977006082939225*^9}, {3.977007267875451*^9, 3.977007287649378*^9}, {
   3.977007606552973*^9, 3.977007804922398*^9}, 3.9770096096309032`*^9, {
   3.977039890629109*^9, 3.977039895746916*^9}, {3.9770411661340227`*^9, 
