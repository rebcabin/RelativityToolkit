   3.9770629808685913`*^9},ExpressionUUID->"e26e79c9-9ac9-48a7-b95c-\
b285adfafc8f"],

Cell[TextData[{
 "\[SZ]First, let\[CloseCurlyQuote]s check that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", "\[VeryThinSpace]", "\[Beta]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9b31dd55-db39-4b90-94c6-18be7ffee3a8"],
 " is not tensorial. Let\[CloseCurlyQuote]s transform ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "03e80078-2f83-4c30-99cf-0eb1397fb396"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "195b1cd5-22b9-4f10-b935-e38bd83424ac"],
 ": "
}], "Text",
 CellChangeTimes->{{3.977004335524499*^9, 3.9770043704738903`*^9}, {
   3.977004459862672*^9, 3.977004462955502*^9}, {3.977004607950364*^9, 
   3.977004657450521*^9}, {3.9770051541433764`*^9, 3.977005223612775*^9}, {
   3.97700531611539*^9, 3.9770055667106743`*^9}, {3.9770056293925962`*^9, 
   3.977005692088046*^9}, {3.9770057691765127`*^9, 3.977005809766267*^9}, {
   3.9770058466687117`*^9, 3.977005916940502*^9}, {3.9770060689174433`*^9, 
   3.977006082939225*^9}, {3.977007267875451*^9, 3.977007287649378*^9}, {
   3.977007606552973*^9, 3.977007804922398*^9}, 3.9770096096309032`*^9, {
   3.977039890629109*^9, 3.977039895746916*^9}, {3.9770411661340227`*^9, 
   3.977041194191555*^9}, {3.977041249443462*^9, 3.977041264803671*^9}, 
   3.9770412970304193`*^9, 
   3.9770629871072083`*^9},ExpressionUUID->"a9464779-ae86-457d-8be6-\
ba15324599a7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["A", 
    RowBox[{"\[Alpha]", "'"}]], "\[Congruent]", 
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Alpha]", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Alpha]"]}]], 
    SuperscriptBox["A", "\[Alpha]"]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977008276090537*^9, 3.977008414049974*^9}, {
  3.977041280713253*^9, 
  3.977041288005127*^9}},ExpressionUUID->"1398b8b5-d066-42af-afd4-\
159a79ce9548"],

Cell["\<\
Now calculate its partial derivatives with respect to the primed frame:\
\>", "Text",
 CellChangeTimes->{{3.977009690387065*^9, 3.977009710899132*^9}, {
  3.977041301946884*^9, 
  3.9770413251682167`*^9}},ExpressionUUID->"6486085b-2402-492d-a175-\
3585b6949957"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], 
    RowBox[{",", 
     RowBox[{"\[Beta]", " ", "'"}]}]], "\[Congruent]", 
   RowBox[{
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{"\[Alpha]", "'"}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "\[Alpha]"]}]], 
      SuperscriptBox["A", "\[Alpha]"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977008276090537*^9, 3.977008414049974*^9}, {
  3.977060850916094*^9, 
  3.977060862323194*^9}},ExpressionUUID->"a4fe1c7f-d7b3-412a-8c44-\
20df7796f258"],

Cell[TextData[{
 StyleBox["This notation is different from Lovelock & Rund, who write",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "_"], "\[Alpha]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9503deda-ff8f-471d-94d0-5233c72da24b"],
 " ",
 StyleBox["for the transformation functions, with Greek indices that have no \
primes. However, we will not be confused: ",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"\[Alpha]", "'"}]], TraditionalForm]],ExpressionUUID->
  "02199e11-78af-4160-8fe2-318f60454a72"],
 " ",
 StyleBox["is short for",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", 
     RowBox[{"\[Alpha]", "'"}]], "(", 
    SuperscriptBox["x", "\[Beta]"], ")"}], TraditionalForm]],ExpressionUUID->
  "24d1c814-4c71-451c-871e-b31ce3d391e4"],
 ", ",
 StyleBox["four functions of four arguments each, expressing new coordinates \
in terms of old. The prime isn\[CloseCurlyQuote]t really on the index, but on \
the pair of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,
  FontSlant->"Italic",ExpressionUUID->
  "ca397c36-0541-4fee-83a0-d464f38c3db0"],
 StyleBox[" and the index. We write it on the index only for ease of \
typesetting. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977004335524499*^9, 3.9770043704738903`*^9}, {
  3.977004459862672*^9, 3.977004462955502*^9}, {3.977004607950364*^9, 
  3.977004657450521*^9}, {3.9770051541433764`*^9, 3.977005223612775*^9}, {
  3.97700531611539*^9, 3.9770055667106743`*^9}, {3.9770056293925962`*^9, 
  3.977005692088046*^9}, {3.9770057691765127`*^9, 3.977005809766267*^9}, {
  3.9770058466687117`*^9, 3.977005916940502*^9}, {3.9770060689174433`*^9, 
  3.977006082939225*^9}, {3.977007267875451*^9, 3.977007287649378*^9}, {
  3.977007606552973*^9, 3.977007804922398*^9}, {3.977065238980687*^9, 
  3.9770652412681017`*^9}},ExpressionUUID->"620cbe4c-e2ba-4552-9c34-\
9b50a700b51f"],

Cell["Let the \[ScriptCapitalU]\[ScriptCapitalD] engine to do this bit of \
calculus:", "Text",
 CellChangeTimes->{{3.977041334909045*^9, 3.977041357964467*^9}, {
   3.9770413927139*^9, 3.977041393667335*^9}, 
   3.9770652572467546`*^9},ExpressionUUID->"b2d77625-7405-4742-b8f5-\
13c59f7aa6d6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"ap", ",", "bp", ",", "mu"}], "]"}], ";"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "1"}], ":", 
    RowBox[{"Define", " ", "the", " ", "Input"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Partial", " ", "derivative", " ", "of", " ", "the", " ", "Transformed", " ",
     "Vector", " ", 
    RowBox[{"A", "'"}], " ", 
    RowBox[{"w", ".", "r", ".", "t"}], " ", 
    RowBox[{"x", "'"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Input", ":", 
    RowBox[{"d", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", "^", 
        RowBox[{"a", "'"}]}], ")"}], "/", "d"}], 
     RowBox[{"(", 
      RowBox[{"x", "^", 
       RowBox[{"b", "'"}]}], ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"inputTerm", "=", 
    RowBox[{"Echo", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Partials", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Expand", " ", 
         RowBox[{"A", "^", 
          RowBox[{"a", "'"}]}], " ", "into", " ", "J", "*", 
         RowBox[{"A", "^", "mu"}], " ", "immediately", " ", "via", " ", 
         "existing", " ", "rule"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "ap", "]"}], "]"}], "/.", " ", 
         "robustTransformRules"}], ",", 
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "\"\<1. Input \
\!\(\*SubscriptBox[\(\[PartialD]\), \
\(\[Beta]'\)]\)(\!\(\*SuperscriptBox[\(A\), \(\[Alpha]'\)]\)):\>\""}], 
     "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "2"}], ":", 
    RowBox[{"Mechanical", " ", "Expansion"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Apply", " ", "Leibniz", " ", "and", " ", "Chain", " ", "Rule", " ", 
    "repeatedly", " ", "until", " ", "stable"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"expandedTerm", "=", 
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"ExpandDerivatives", "[", "inputTerm", "]"}], ",", 
      "\[IndentingNewLine]", "\"\<2. Mechanically Expanded Derivative:\>\""}],
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "3"}], ":", "Formatting"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Map", " ", "internal", " ", "unique", " ", "dummies", " ", "to", " ", 
    "readable", " ", "Greek"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"prettyResult", "=", 
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"expandedTerm", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ap", "->", 
          RowBox[{"\[Alpha]", "'"}]}], ",", 
         RowBox[{"bp", "->", 
          RowBox[{"\[Beta]", "'"}]}], ",", 
         RowBox[{"mu", "->", "\[Mu]"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", "\"\<3. Peek at unique dummy indices\>\""}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"brokenPartial", "=", 
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"TensorForm", "[", "prettyResult", "]"}], ",", 
     "\[IndentingNewLine]", "\"\<4. Expanded \!\(\*SubscriptBox[\(\[PartialD]\
\), \(\[Beta]'\)]\)(\!\(\*SuperscriptBox[\(A\), \(\[Alpha]'\)]\)) in Readable \
Greek\>\""}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.977008741929626*^9, 3.977008820235695*^9}, 
   3.977008885372672*^9, {3.9770094423020697`*^9, 3.9770094577204313`*^9}, {
   3.977009737355989*^9, 3.977009833411221*^9}, {3.9770098725691023`*^9, 
   3.977009904582294*^9}, {3.977009936258263*^9, 3.977009980150612*^9}, {
   3.9770414147097273`*^9, 3.977041424849421*^9}, {3.9770532950091743`*^9, 
   3.977053301338974*^9}, {3.977065288356881*^9, 3.977065415628669*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"f2ecf498-1b10-4db8-9555-6f43d404622a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  TagBox["\<\"1. Input \\!\\(\\*SubscriptBox[\\(\[PartialD]\\), \
\\(\[Beta]'\\)]\\)(\\!\\(\\*SuperscriptBox[\\(A\\), \\(\[Alpha]'\\)]\\)):\"\>",
   "EchoLabel"], "  ", 
  SubscriptBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"A", 
      SuperscriptBox["", "\[Mu]18"]}], ")"}], " ", 
    FractionBox[
     RowBox[{
      RowBox[{"\[PartialD]", "x"}], 
      SuperscriptBox["", "ap"]}], 
     RowBox[{
      RowBox[{"\[PartialD]", "x"}], 
      SuperscriptBox["", "\[Mu]18"]}]]}], 
   RowBox[{",", "bp"}]]}]], "Echo",
 CellChangeTimes->{
  3.9770988062513313`*^9},ExpressionUUID->"3582eaf7-2db6-4d91-8c16-\
74d6d5372be1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   TagBox["\<\"2. Mechanically Expanded Derivative:\"\>",
    "EchoLabel"], "  ", 
   RowBox[{"(", 
    RowBox[{"A", 
     SuperscriptBox["", "\[Mu]18"]}], ")"}], " ", 
   FractionBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["\[PartialD]", "2"], "x"}], 
     SuperscriptBox["", "ap"]}], 
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "bp"], 
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "\[Mu]18"]}]]}], "+", 
  RowBox[{
   RowBox[{"(", 
    SubscriptBox[
     RowBox[{"A", 
      SuperscriptBox["", "\[Mu]18"]}], 
     RowBox[{",", "bp"}]], ")"}], " ", 
   FractionBox[
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "ap"]}], 
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "\[Mu]18"]}]]}]}]], "Echo",
 CellChangeTimes->{
  3.977098806272428*^9},ExpressionUUID->"49c423cb-12ad-49ba-8241-\
6cafae727a49"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   TagBox["\<\"3. Peek at unique dummy indices\"\>",
    "EchoLabel"], "  ", 
   RowBox[{"(", 
    RowBox[{"A", 
     SuperscriptBox["", "\[Mu]18"]}], ")"}], " ", 
   FractionBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["\[PartialD]", "2"], "x"}], 
     SuperscriptBox["", 
      SuperscriptBox["\[Alpha]", "\[Prime]",
       MultilineFunction->None]]}], 
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", 
      SuperscriptBox["\[Beta]", "\[Prime]",
       MultilineFunction->None]], 
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "\[Mu]18"]}]]}], "+", 
  RowBox[{
   RowBox[{"(", 
    SubscriptBox[
     RowBox[{"A", 
      SuperscriptBox["", "\[Mu]18"]}], 
     RowBox[{",", 
      SuperscriptBox["\[Beta]", "\[Prime]",
       MultilineFunction->None]}]], ")"}], " ", 
   FractionBox[
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", 
      SuperscriptBox["\[Alpha]", "\[Prime]",
       MultilineFunction->None]]}], 
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "\[Mu]18"]}]]}]}]], "Echo",
 CellChangeTimes->{
  3.977098806278962*^9},ExpressionUUID->"42f5b916-76c5-4123-a1c5-\
68d8b70db63c"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"4. Expanded \\!\\(\\*SubscriptBox[\\(\[PartialD]\\), \
\\(\[Beta]'\\)]\\)(\\!\\(\\*SuperscriptBox[\\(A\\), \\(\[Alpha]'\\)]\\)) in \
Readable Greek\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"A", 
       SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
     FractionBox[
      RowBox[{
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], "x"}], 
       SuperscriptBox["", 
        SuperscriptBox["\[Alpha]", "\[Prime]",
         MultilineFunction->None]]}], 
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", 
