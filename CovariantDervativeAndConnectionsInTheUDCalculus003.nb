   HoldForm]}]], "Echo",
 CellChangeTimes->{
  3.977098806295271*^9},ExpressionUUID->"4de700d9-90f5-474b-875e-\
3610bb137103"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The partial derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", " ", "\[Beta]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3070d98c-a02c-4a3e-b79e-370c4cf461fd"],
 " is not tensorial, else it would transform like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Alpha]", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Alpha]"]}]], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    SubscriptBox[
     SuperscriptBox["A", "\[Alpha]"], 
     RowBox[{",", " ", "\[Beta]", " "}]]}], TraditionalForm]],
  CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
   3.9770114425225677`*^9, 3.977011477474715*^9}},ExpressionUUID->
  "5b3691bd-bb3b-4a1b-9920-7dbf35fabe22"],
 ". However, when we differentiate ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Alpha]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3191fc55-4493-4ca3-b4b1-3d83e575b428"],
 "\[CloseCurlyQuote]s transform, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"\[Alpha]", "'"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f2856a66-242a-4ec0-8e28-248b06daee09"],
 ", in the new coordinate system ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"\[Beta]", " ", "'"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bd0cb467-3319-4ab7-be62-2fbed0326646"],
 ":"
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
  3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
  3.977011051138826*^9}, {3.977011515235486*^9, 3.977011570673971*^9}, {
  3.9770414603757057`*^9, 3.977041538097261*^9}, {3.977053320309387*^9, 
  3.977053356535059*^9}, {3.9770538109602013`*^9, 
  3.9770538155186*^9}},ExpressionUUID->"06a7d4c4-a2c0-479b-8a69-6ab4468c4c67"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{" ", 
         RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["A", 
        RowBox[{"\[Alpha]", " ", "'"}]], "=", 
       RowBox[{
        SuperscriptBox["A", "\[Mu]"], 
        FractionBox[
         RowBox[{"\[PartialD]", 
          SuperscriptBox["x", 
           RowBox[{" ", 
            RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["x", 
           RowBox[{" ", "\[Mu]"}]]}]]}]}], ")"}]}], "\[Congruent]", 
    SubscriptBox[
     SuperscriptBox["A", 
      RowBox[{"\[Alpha]", "'"}]], 
     RowBox[{",", 
      RowBox[{"\[Beta]", " ", "'"}]}]]}], "=", 
   RowBox[{
    RowBox[{"(", 
     SuperscriptBox["A", "\[Mu]19"], ")"}], " ", 
    SubscriptBox[
     FractionBox[
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", "ap"]}], 
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", "\[Mu]19"]}]], 
     RowBox[{",", "bp"}]]}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977053825090283*^9, 3.9770539820693007`*^9}, {
  3.977054016679175*^9, 3.977054049741235*^9}, {3.977054102978526*^9, 
  3.977054109922058*^9}},ExpressionUUID->"c5d11daf-857b-4d39-9ac6-\
57636f2c0a9e"],

Cell[TextData[{
 "we don\[CloseCurlyQuote]t get the transform  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "\[Alpha]"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", " ", "'"}]]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{" ", 
         RowBox[{"\[Beta]", " ", "'"}]}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{" ", "\[Beta]"}]]}]], 
     SubscriptBox[
      SuperscriptBox["A", 
       RowBox[{"\[Alpha]", " ", "'"}]], 
      RowBox[{",", " ", 
       RowBox[{"\[Beta]", " ", "'"}]}]]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
   3.9770114425225677`*^9, 3.977011477474715*^9}},ExpressionUUID->
  "6a465448-e981-439b-b64a-655ba41e5065"],
 " of the derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b4ca2611-eb27-47a3-a7cb-2f9b846875a1"],
 ", but two terms that are difficult to interpret. "
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
   3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
   3.977011051138826*^9}, {3.977011515235486*^9, 3.977011570673971*^9}, {
   3.9770414603757057`*^9, 3.977041538097261*^9}, {3.977053320309387*^9, 
   3.977053356535059*^9}, {3.9770592584261723`*^9, 3.977059369274659*^9}, 
   3.9770594025116243`*^9, {3.9770666475906487`*^9, 
   3.977066648961801*^9}},ExpressionUUID->"8f1ec892-b6d9-4a76-8149-\
21b4735ad9e8"],

Cell[TextData[{
 "Both terms, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["A", "\[Lambda]"], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], 
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", "'"}]]}], 
      RowBox[{
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{"\[Beta]", " ", "'"}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "\[Lambda]"]}]}]]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "75ccce2a-8699-411e-a533-baa9caccd6cb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["A", "\[Lambda]"], 
      RowBox[{",", " ", 
       RowBox[{"\[Beta]", " ", "'"}]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", "'"}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "\[Lambda]"]}]]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3e0521c4-0fdf-4f2e-9311-3e6e5347eff7"],
 " have factors, ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     SuperscriptBox["x", 
      RowBox[{"\[Alpha]", "'"}]]}], 
    RowBox[{
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Beta]", " ", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Lambda]"]}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "adad717a-7a29-4596-86c0-e48fcdaa64f3"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Lambda]"], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], TraditionalForm]],ExpressionUUID->
  "43450047-a74f-43fd-94a7-765e5cea86e8"],
 ", that are calculated in both coordinate systems, and \
that\[CloseCurlyQuote]s disturbing. We can extract one factor of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{" ", "\[Beta]"}]]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{" ", 
       RowBox[{"\[Beta]", " ", "'"}]}]]}]], TraditionalForm]],ExpressionUUID->
  "f7e8d4b6-9256-44aa-8d86-785359c057d7"],
 ", but that\[CloseCurlyQuote]s it. Rewrite the last line ",
 Cell[BoxData["\"\<Expanded \!\(\*SubscriptBox[\(\[PartialD]\), \(\[Beta]'\)]\
\)(\!\(\*SuperscriptBox[\(A\), \(\[Alpha]'\)]\))...\>\""],
  CellChangeTimes->{3.9770654174452257`*^9},ExpressionUUID->
  "101f671b-f705-42da-865b-8fe2980f4323"],
 " from above as follows:"
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
  3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
  3.977011051138826*^9}, {3.977011515235486*^9, 3.977011570673971*^9}, {
  3.9770414603757057`*^9, 3.977041538097261*^9}, {3.977053320309387*^9, 
  3.977053356535059*^9}, {3.9770592584261723`*^9, 3.977059369274659*^9}, {
  3.9770594205474043`*^9, 3.977059425344063*^9}, {3.9770655434250927`*^9, 
  3.977065571669265*^9}, {3.9770659566282063`*^9, 3.9770659782154293`*^9}, {
  3.9770666890912848`*^9, 
  3.977066749670599*^9}},ExpressionUUID->"216108f1-fe2e-400a-a1e0-\
31ea1a07077c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", " ", "'"}]], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["A", 
       RowBox[{" ", "\[Lambda]"}]], "(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], 
        SuperscriptBox["x", 
         RowBox[{" ", 
          RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
       RowBox[{
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Beta]", " ", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]}]], ")"}], "+", 
     RowBox[{
      RowBox[{"(", 
       SubscriptBox[
        SuperscriptBox["A", 
         RowBox[{" ", "\[Lambda]"}]], 
        RowBox[{",", " ", 
         RowBox[{"\[Beta]", " ", "'"}]}]], ")"}], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", 
          RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", "\[Lambda]"}]]}]]}]}], "=", "\[LineSeparator]", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["A", 
        RowBox[{" ", "\[Lambda]"}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Beta]"}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
       RowBox[{"(", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], 
          SuperscriptBox["x", 
           RowBox[{" ", 
            RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
         RowBox[{
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Beta]"}]]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Lambda]"}]]}]}]], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          SuperscriptBox["A", 
           RowBox[{" ", "\[Lambda]"}]], 
          RowBox[{",", " ", "\[Beta]", " "}]], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Beta]"}]]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", 
             RowBox[{"\[Beta]", " ", "'"}]}]]}]]}], ")"}], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]]}]}], "=", "\[LineSeparator]", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", "\[Beta]"}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", 
          RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["A", 
          RowBox[{" ", "\[Lambda]"}]], 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[PartialD]", "2"], 
           SuperscriptBox["x", 
            RowBox[{" ", 
             RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
          RowBox[{
           RowBox[{"\[PartialD]", 
            SuperscriptBox["x", 
             RowBox[{" ", "\[Beta]"}]]}], 
           RowBox[{"\[PartialD]", 
            SuperscriptBox["x", 
             RowBox[{" ", "\[Lambda]"}]]}]}]]}], "+", 
        RowBox[{
         SubscriptBox[
          SuperscriptBox["A", 
           RowBox[{" ", "\[Lambda]"}]], 
          RowBox[{",", " ", "\[Beta]", " "}]], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Alpha]"}]]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Lambda]"}]]}]]}]}], ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977053379479414*^9, 3.97705375883645*^9}, {
  3.9770594797492647`*^9, 3.977059513634585*^9}, {3.9770600785843143`*^9, 
  3.977060105446658*^9}, {3.977060142965212*^9, 3.9770601668754187`*^9}, {
  3.977060241161337*^9, 3.97706024837414*^9}, {3.9770655886816063`*^9, 
  3.977065613258123*^9}, {3.977065745169601*^9, 3.977065785382228*^9}, {
  3.977066767336562*^9, 
  3.977066812952137*^9}},ExpressionUUID->"68824569-07ee-4dde-aba3-\
054006e8fab6"],

Cell[TextData[{
 "T",
 "he quantity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["A", 
       RowBox[{" ", "\[Lambda]"}]], 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], 
        SuperscriptBox["x", 
         RowBox[{" ", 
          RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
       RowBox[{
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Beta]"}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]}]]}], "+", 
     RowBox[{
      SubscriptBox[
       SuperscriptBox["A", 
        RowBox[{" ", "\[Lambda]"}]], 
       RowBox[{",", " ", "\[Beta]", " "}]], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", "\[Alpha]"}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", "\[Lambda]"}]]}]]}]}], ")"}], TraditionalForm]],
  ExpressionUUID->"9aa93cc7-3892-41a9-ba6c-bd51f8fb66ca"],
 " is not tensorial either. ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     SuperscriptBox["x", 
      RowBox[{" ", 
       RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
    RowBox[{
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Lambda]"}]]}]}]], TraditionalForm]],ExpressionUUID->
  "57648b80-f7ab-4510-82c5-c78b42b9bae4"],
 " is the Hessian of the coordinate transformation and is not a an intrinsic \
geometrical object. It doesn\[CloseCurlyQuote]t live in either tangent space. \
It can\[CloseCurlyQuote]t itself be transformed. It depends entirely on a \
particular choice of two coordinate systems. It\[CloseCurlyQuote]s of no help."
}], "Text",
 CellChangeTimes->{{3.9770595997808647`*^9, 3.977059649976912*^9}, {
  3.977060262908671*^9, 3.977060269336875*^9}, {3.977065629016151*^9, 
  3.9770656653095827`*^9}, {3.977065732646055*^9, 3.977065734676793*^9}, {
  3.977065803951926*^9, 3.9770659401694393`*^9}, {3.977066838368587*^9, 
  3.977066845133431*^9}},ExpressionUUID->"ebe8ffac-67c3-483f-adef-\
8fd6a04619f1"],

Cell[TextData[{
 "There\[CloseCurlyQuote]s a way out. Write an additive correction to the \
partial derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", " ", "\[Beta]", " "}]], TraditionalForm]],ExpressionUUID->
  "4538a6d3-9eb4-43d0-90e7-3db2329578b6"],
 ". Demand the correction be linear in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Alpha]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "de4487a5-b9aa-4306-b988-17626f8719d7"],
 " such that the derivative plus the correction transforms tensorially. \
Calling this \[OpenCurlyDoubleQuote]corrected derivative\
\[CloseCurlyDoubleQuote] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]", " "}]], TraditionalForm]],ExpressionUUID->
  "913dd4b6-f1c0-4800-a31c-a34290168771"],
 ", with a semicolon instead of a comma, define"
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
   3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
   3.977010967374028*^9}, {3.977011058197987*^9, 3.9770111504156837`*^9}, {
   3.977011577000286*^9, 3.977011599925207*^9}, {3.9770415661310177`*^9, 
   3.9770416017082853`*^9}, 3.977065836365576*^9, {3.977066857271544*^9, 
   3.977066886804606*^9}},ExpressionUUID->"63150d01-ceda-4f22-803b-\
1a97f3847230"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]", " "}]], "\[Congruent]", 
   RowBox[{
    SubscriptBox[
     SuperscriptBox["A", "\[Alpha]"], 
     RowBox[{",", " ", "\[Beta]"}]], "+", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["\[CapitalGamma]", "\[Alpha]"], 
      RowBox[{"\[Mu]", " ", "\[Beta]"}]], 
     SuperscriptBox["A", "\[Mu]"]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977010636055129*^9, 3.977010643913973*^9}, {
  3.9770111624798183`*^9, 
  3.977011270616735*^9}},ExpressionUUID->"f9347413-dcec-4b5a-b910-\
1ddd35a13a6e"],

Cell["such that it may transform as follows:", "Text",
 CellChangeTimes->{{3.9770112779099293`*^9, 3.977011307443584*^9}, {
  3.9770416099832573`*^9, 3.97704163759873*^9}, {3.97704167848347*^9, 
  3.977041680128821*^9}},ExpressionUUID->"e22434f5-50f6-4a8b-9f8c-\
d3508d56c6ca"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], 
    RowBox[{";", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Alpha]", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Alpha]"]}]], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    SubscriptBox[
     SuperscriptBox["A", "\[Alpha]"], 
     RowBox[{";", " ", "\[Beta]", " "}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
  3.9770114425225677`*^9, 
  3.977011477474715*^9}},ExpressionUUID->"6b548b6d-3f69-4925-8eed-\
d69868613da1"],

Cell[TextData[{
 "then solve for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", "\[Alpha]"], 
    RowBox[{"\[Mu]", " ", "\[Beta]"}]], TraditionalForm]],
  CellChangeTimes->{{3.977010636055129*^9, 3.977010643913973*^9}, {
   3.9770111624798183`*^9, 3.977011270616735*^9}},ExpressionUUID->
  "4e477fc5-24b9-428e-887c-7fe3373db24c"],
 "."
}], "Text",
 CellChangeTimes->{{3.9770416266716547`*^9, 
  3.977041647098284*^9}},ExpressionUUID->"8d4d9e22-f3be-4906-b992-\
4ae23379e624"],

Cell[TextData[{
 StyleBox["TODO: Why must the correction ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["\[CapitalGamma]", "\[Alpha]"], 
     RowBox[{"\[Mu]", " ", "\[Beta]"}]], 
    SuperscriptBox["A", "\[Mu]"]}], TraditionalForm]],
  CellChangeTimes->{{3.977010636055129*^9, 3.977010643913973*^9}, {
   3.9770111624798183`*^9, 3.977011270616735*^9}},ExpressionUUID->
  "b2873953-53d3-4443-928a-b10024fa49e2"],
 StyleBox[" be linear in ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "37c96623-a5ed-4e06-9ed5-d665f61130c5"],
 "?"
}], "Item",
 CellChangeTimes->{{3.977011617039833*^9, 3.977011636431033*^9}, {
  3.977042016238361*^9, 
  3.977042024601349*^9}},ExpressionUUID->"5a9eb602-93d2-434f-87e1-\
04e0949c271c"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["SPOILER: We want our new derivative ",
  FontSlant->"Italic"],
 "\[Del]",
 StyleBox[" (the semicolon) to behave like an ordinary derivative. That means \
it must satisfy two properties:",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.977012306806328*^9}, {
  3.977012633337566*^9, 3.977012649604801*^9}, {3.977012908231069*^9, 
  3.977012952354192*^9}},ExpressionUUID->"76428ab0-8541-45b0-8c78-\
82faffcebf92"],

Cell[TextData[{
 StyleBox["Linearity:",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Mu]"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["A", "\[Nu]"], "+", 
       SuperscriptBox["B", "\[Nu]"]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", "\[Mu]"], 
      SuperscriptBox["A", "\[Nu]"]}], "+", 
     RowBox[{
      SubscriptBox["\[Del]", "\[Mu]"], 
      SuperscriptBox["B", "\[Nu]"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b512c16b-8097-4bc8-9abc-c0dd89a4bcfe"]
}], "Subitem",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770123871945553`*^9}, {
  3.977012726040819*^9, 
  3.977012726973077*^9}},ExpressionUUID->"ecaa396f-685e-4f68-a913-\
268a0ce9b653"],

Cell[TextData[{
 StyleBox["Leibniz Rule:",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Mu]"], 
     RowBox[{"(", 
      RowBox[{"f", "\[VeryThinSpace]", 
       SuperscriptBox["A", "\[Nu]"]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["A", "\[Nu]"], 
      SubscriptBox["f", 
       RowBox[{",", " ", "\[Mu]"}]]}], "+", 
     RowBox[{"f", 
      RowBox[{
       SubscriptBox["\[Del]", "\[Mu]"], 
       SuperscriptBox["A", "\[Nu]"]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6d47b40f-b4c9-48f8-8b61-4048ad49f41d"]
}], "Subitem",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770124711684523`*^9}, {
  3.9770125446957417`*^9, 3.977012552474452*^9}, {3.977012729129239*^9, 
  3.977012729966456*^9}},ExpressionUUID->"304ef2c6-a37a-4caf-93e1-\
eb14e20e48c6"],

Cell[TextData[{
 StyleBox["If we assume the general form of derivative plus a correction,",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Mu]"], 
     SuperscriptBox["A", "\[Nu]"]}], "=", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["A", "\[Nu]"], 
      RowBox[{",", " ", "\[Mu]"}]], "+", 
     RowBox[{"C", "(", 
      RowBox[{"A", ",", 
       RowBox[{"\[PartialD]", "A"}], ",", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], "A"}], "..."}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"1f0b000a-fc4d-4023-a7d8-63cd275c45c7"],
 StyleBox[", then:",
  FontSlant->"Italic"]
}], "ItemParagraph",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770125300520372`*^9}, {
