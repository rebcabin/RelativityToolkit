 CellLabel->"In[62]:=",ExpressionUUID->"f67e30e5-0491-4381-b119-1f1c37c2ea6a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Unitarity", "Subsubsection",
 CellChangeTimes->{{3.9806140198739233`*^9, 3.9806140273250313`*^9}, {
   3.980614342336604*^9, 3.98061434947884*^9}, {3.980772760815064*^9, 
   3.9807728260195312`*^9}, 3.981020654476453*^9, {3.9810393872706633`*^9, 
   3.981039414616181*^9}, {3.981039491237033*^9, 3.9810395227815733`*^9}, {
   3.9810645758358583`*^9, 3.9810645826493483`*^9}, {3.9810647128482523`*^9, 
   3.981064718576626*^9}},ExpressionUUID->"6e0b5194-64ab-44c0-93d6-\
5544fbeb676c"],

Cell[TextData[{
 "The following expresses Unitarity: the fact that ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b2d9e005-767d-43ab-b8eb-6da403c0f47b"],
 " times its conjugate transpose ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Q", "\[Dagger]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8f076748-d2a4-451b-9b4c-4dfa84d99772"],
 " is the identity matrix. A unitary matrix is analogous to an orthogonal \
matrix."
}], "Text",
 CellChangeTimes->{{3.981041758405097*^9, 3.9810418353127117`*^9}, {
  3.981045327707666*^9, 3.98104532921105*^9}, {3.981064587495688*^9, 
  3.98106459578202*^9}, {3.981064723756071*^9, 3.981064730013278*^9}, {
  3.981064889214938*^9, 
  3.981064906431072*^9}},ExpressionUUID->"370ea423-acae-4519-8b22-\
a2705b599336"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Q", "[", "\[Theta]", "]"}], ".", 
          RowBox[{"QDag", "[", "\[Theta]", "]"}]}], "//", "FullSimplify"}], 
        ")"}], "/.", "su2Constraint"}], ")"}], "//", "MatrixForm"}], ",", 
    " ", "\"\<Q is unitary: Q.\!\(\*SuperscriptBox[\(Q\), \(\[Dagger]\)]\) == \
id :\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9806140198739233`*^9, 3.9806140273250313`*^9}, {
   3.980614342336604*^9, 3.98061434947884*^9}, {3.980772760815064*^9, 
   3.9807728260195312`*^9}, 3.981020654476453*^9, {3.9810393872706633`*^9, 
   3.981039414616181*^9}, {3.9810414254700823`*^9, 3.981041439010131*^9}, {
   3.98104160370763*^9, 3.981041613375214*^9}, {3.981041842965596*^9, 
   3.981041985625107*^9}, {3.981042040588972*^9, 3.981042043928047*^9}, {
   3.9810421217011337`*^9, 3.981042252094369*^9}, {3.981042312944169*^9, 
   3.9810423205888166`*^9}, {3.981042515006971*^9, 3.981042529885964*^9}, {
   3.98104342984662*^9, 3.981043450597972*^9}, {3.981043510221386*^9, 
   3.981043560253706*^9}, {3.981043749858933*^9, 3.98104375746434*^9}, 
   3.9810453507064247`*^9, {3.9810647396130857`*^9, 3.98106475799227*^9}, {
   3.9810670160590353`*^9, 3.9810670454578447`*^9}, 3.981070237104968*^9, 
   3.981070500814212*^9, 3.981070555712188*^9, 3.9810705969378757`*^9, 
   3.981116790764481*^9},
 CellLabel->"In[64]:=",ExpressionUUID->"23f93591-524d-4513-8741-67f0b6b1a199"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Q is unitary: Q.\\!\\(\\*SuperscriptBox[\\(Q\\), \
