Cell[TextData[{
 StyleBox["By studying",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "3a92434b-8e54-4e07-8c61-7136cf322ad5"],
 StyleBox[" here in an intuitive setting of classical mechanics, we are \
better equipped for later transition to quantum physics. Instead of studying \
two abstractions at once\[LongDash]",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "ed840e67-4e1e-4d39-b70c-450227b11716"],
 StyleBox[" and spinors\[LongDash]we will have only spinors to study. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.981040819375476*^9, 3.9810409128740177`*^9}, {
  3.981041011477706*^9, 3.981041018432872*^9}, {3.981041401241703*^9, 
  3.9810414074333344`*^9}, {3.98104171546249*^9, 3.981041744206963*^9}, {
  3.9810440807170467`*^9, 3.981044172169879*^9}, {3.981044372758819*^9, 
  3.981044375413375*^9}, {3.981064663617475*^9, 3.981064665264268*^9}, {
  3.9810706748697367`*^9, 3.981070684878982*^9}, {3.981116346187948*^9, 
  3.981116639415704*^9}, {3.9812135475653057`*^9, 3.9812135600094*^9}, {
  3.98121360301814*^9, 3.981213609601499*^9}, {3.981244966955203*^9, 
  3.981245054231269*^9}, {3.9812450861013403`*^9, 3.981245108770018*^9}, {
  3.981246425476857*^9, 3.981246703641313*^9}, {3.981246822880254*^9, 
  3.981246835048118*^9}, {3.9812946754426613`*^9, 3.9812946808976192`*^9}, {
  3.981297553637143*^9, 
  3.981297560383252*^9}},ExpressionUUID->"6a9c707c-cbe8-4888-b99b-\
0a5c69ce5396"],

Cell[TextData[{
 StyleBox["A Lie Group is a group (set of elements closed under associative, \
non-commutative, abstract multiplication with inverse and identity). A Lie \
Group is also a manifold, so enjoys parameterization by continuous, \
differentiable coordinate charts. ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "56edd268-2b1c-4bf4-9439-5f443bf5b21d"],
 StyleBox[" is also a Lie Group, but, as we have seen, it cannot be covered \
by a single, non-singular chart of, say, Euler angles, a fact manifested \
physically by gimbal lock.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.981293512311339*^9, 3.98129363548799*^9}, {
  3.981293947930201*^9, 3.981294001790509*^9}, {3.9812953964816628`*^9, 
  3.981295419577673*^9}, {3.981295465129278*^9, 
  3.981295484084504*^9}},ExpressionUUID->"60edc753-cce7-4b02-b067-\
2fb345665bb7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Quaternions as a Chart for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "26f90aa4-f909-42bf-a13e-e8ced44a37a4"]
}], "Subsubsection",
 CellChangeTimes->{{3.981293416847962*^9, 3.981293422435145*^9}, {
  3.981294089438717*^9, 
  3.981294105377323*^9}},ExpressionUUID->"cc1acf28-f63a-424e-a4d1-\
663d21ec1b17"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c8568257-fdf4-4078-bd57-c996456c1002"],
 " operators are faithfully represented by polynomials in the Pauli matrices \
plus the identity matrix, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[DoubleStruckCapitalI]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f983dabd-4359-468d-83bd-a99e4bce06bf"],
 ". The four real-valued coefficients, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["q", "0"], ",", 
      SubscriptBox["q", "1"], ",", 
      SubscriptBox["q", "2"], ",", 
      SubscriptBox["q", "3"]}], ")"}], "\[Element]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "4"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "54b4b77d-c98f-46d2-aec7-cf618e8c0718"],
 ", of the polynomial are components of a unit ",
 StyleBox["quaternion",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQA2IQ/Yw5Z5r1yreOX75LLwLRcZ7560C02C3f9SCaY4/6
fRD94O5bML3jTB6bDZAunM/GBaJ5Ponp2QLpZfmtliDa3mNGEIiOs3oLpqMP
fbZyB9KPSjSswfSVaC0vID1fYY42iF7D7FaeAKSLfN/OBtF/xIre9gNpRl+G
9yB61pSELyC62t74K4hmm3jPZT6Q7ks77g+i9ewOB4Pov4tnhIHoLCf93yC6
SneD7AIg/dr8Yj2IFrV6AKYD6ndd3wakNxzjugmi95U8fAyit1VaPQXRKcaT
LLYD6Sjp25Yg+mq7gjuIDlnW5gWiz1zh8gfRPMedQ0H07C/CcSBaP1AuCUT3
FE8sBdE1RyyrQDQAI8O9Pg==
  "],ExpressionUUID->"65086b06-3452-4f82-8b09-b40e57195630"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["q", "0"], 
     SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], " ", "-", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["q", "1"], 
        SubscriptBox["\[Sigma]", "1"]}], " ", "+", " ", 
       RowBox[{
        SubscriptBox["q", "2"], 
        SubscriptBox["\[Sigma]", "2"]}], " ", "+", " ", 
       RowBox[{
        SubscriptBox["q", "3"], 
        SubscriptBox["\[Sigma]", "3"]}]}], ")"}]}]}], ",", " ", 
   RowBox[{"where", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        SubscriptBox["q", "0"], "2"], "+", 
       SuperscriptBox[
        SubscriptBox["q", "1"], "2"], "+", 
       SuperscriptBox[
        SubscriptBox["q", "2"], "2"], "+", 
       SuperscriptBox[
        SubscriptBox["q", "3"], "2"]}], "=", "1"}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9812143678991413`*^9, 3.981214452066915*^9}, {
   3.981245144582741*^9, 3.981245153027391*^9}, {3.981245306713119*^9, 
   3.981245383388976*^9}, 
   3.981298924477916*^9},ExpressionUUID->"79ea6e43-6b27-4585-adc4-\
9da169f7e5d6"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "015ab333-8596-4803-8179-aee974029142"],
 " is called the ",
 StyleBox["real part",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of the quaternion and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["q", "1"], 
       SubscriptBox["\[Sigma]", "1"]}], " ", "+", " ", 
      RowBox[{
       SubscriptBox["q", "2"], 
       SubscriptBox["\[Sigma]", "2"]}], " ", "+", " ", 
      RowBox[{
       SubscriptBox["q", "3"], 
       SubscriptBox["\[Sigma]", "3"]}]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "76122ab2-548b-416b-b2b9-e36fa2855d97"],
 " is called the ",
 StyleBox["imaginary part",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " or the ",
 StyleBox["vector part",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.981298339559561*^9, 3.9812983998452168`*^9}, {
  3.9812988978864517`*^9, 3.9812989094390097`*^9}, {3.981298953900622*^9, 
  3.9812989646257257`*^9}},ExpressionUUID->"2ba4e036-564f-46bd-95aa-\
29b717855e16"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SubscriptBox["q", "1"], 
      SubscriptBox["\[Sigma]", "1"]}], " ", "+", " ", 
     RowBox[{
      SubscriptBox["q", "2"], 
      SubscriptBox["\[Sigma]", "2"]}], " ", "+", " ", 
     RowBox[{
      SubscriptBox["q", "3"], 
      SubscriptBox["\[Sigma]", "3"]}]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9d8d4663-e3c0-4334-ae0d-0762385fe8e4"],
 StyleBox[" alone is a 3\[NoBreak]-\[NoBreak]vector representation in ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f2d70cfa-407e-4b20-9dd6-b3452a670e47"],
 StyleBox[". To align with the classical definition of a quaternion, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "=", 
    RowBox[{
     SubscriptBox["q", "0"], "+", 
     RowBox[{
      SubscriptBox["q", "1"], "\[DoubleStruckI]"}], "+", 
     RowBox[{
      SubscriptBox["q", "2"], "\[DoubleStruckJ]"}], "+", 
     RowBox[{
      SubscriptBox["q", "3"], "\[DoubleStruckK]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eeb4af84-15ff-4617-9c8a-583c440d4fa7"],
 ", ",
 StyleBox["where Hamilton\[CloseCurlyQuote]s imaginary units ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
    "\[DoubleStruckI]", ",", "\[DoubleStruckJ]", ",", "\[DoubleStruckK]"}], 
    ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c3f3f994-117b-47ff-a43e-697dad4650ea"],
 StyleBox[" each square to ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7f2047b8-8733-4b20-a334-ba1013421231"],
 StyleBox[", we must multiply the linear Pauli matrices by ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "\[ImaginaryI]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1e36754a-042f-44b1-9d51-3cb3eed7c425"],
 StyleBox[". Algebraically, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["\[ImaginaryI]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "08b64441-3a06-4ddb-83e6-cde5ba5e7c5a"],
 StyleBox[" would do just as well, but both quantum physics and the \
right-hand rule demand the minus sign. (TODO: explain).",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.981299008509996*^9, 3.9812990547856197`*^9}, {
  3.981299084944512*^9, 3.98129929791954*^9}, {3.9812998234675617`*^9, 
  3.981299884658512*^9}},ExpressionUUID->"125985f8-9a51-4b20-8e05-\
93d9197b69f2"],

Cell[TextData[{
 StyleBox["\[OpenCurlyDoubleQuote]Faithfully\[CloseCurlyDoubleQuote] means \
that the entire Lie Group",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "13dc2305-1f94-4e8b-bea7-ee66ee086752"],
 " ",
 StyleBox["can be smoothly covered by the unit quaternions as a coordinate \
chart with no singularities.",
  FontSlant->"Italic"],
 " ",
 StyleBox["Any abstract \[OpenCurlyDoubleQuote]point\[CloseCurlyDoubleQuote] \
in the manifold",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "920caaa8-7811-494f-a3b0-9c6c58ad4e45"],
 StyleBox[" is uniquely specified by a unit quaternion and vice versa. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGCQAGIQ/Yw5Z5r1yreOX75LLwLRcZ7560C02C3f9SCaY4/6
fRD94O5bML3jTB6bDZAunM/GBaJ5Ponp2QLpZfmtliDa3mNGEIiOs3oLpqMP
fbZyB9KPSjSswfSVaC0vID1fYY42iF7D7FaeAKSLfN/OBtF/xIre9gNpRl+G
9yB61pSELyC62t74K4hmm3jPZT6Q7ks77g+i9ewOB4Pov4tnhIHoLCf93yC6
SneD7AIg/dr8Yj2IFrV6AKYD6ndd3wakNxzjugmi95U8fAyit1VaPQXRKcaT
LLYD6Sjp25Yg+mq7gjuIDlnW5gWiz1zh8gfRPMedQ0H07C/CcSD6mq4+mPYw
nJ0Fok9IVOSDaJZ932pBtLrhtjoQXTd9648dQNrhkt4vEA0A/+LQFA==
  "],ExpressionUUID->"302c2c08-e22f-4511-b81b-2ea89d4544c6"],

Cell[TextData[{
 StyleBox["We identify elements of the Lie Group Q with their coordinate \
representations, writing Q for either.",
  FontSlant->"Italic"],
 " "
}], "Item",
 CellChangeTimes->{{3.981040819375476*^9, 3.9810409128740177`*^9}, {
  3.981041011477706*^9, 3.981041018432872*^9}, {3.981041401241703*^9, 
  3.9810414074333344`*^9}, {3.98104171546249*^9, 3.981041744206963*^9}, {
  3.9810440807170467`*^9, 3.981044172169879*^9}, {3.981044372758819*^9, 
  3.981044375413375*^9}, {3.981064663617475*^9, 3.981064665264268*^9}, {
  3.9810706748697367`*^9, 3.981070684878982*^9}, {3.981116346187948*^9, 
  3.981116639415704*^9}, {3.9812135475653057`*^9, 3.9812135481444387`*^9}, {
  3.981214921961103*^9, 3.9812149285243692`*^9}, {3.981217993556028*^9, 
  3.9812180923788223`*^9}, {3.981243851322598*^9, 3.9812438629840317`*^9}, {
  3.981244722746254*^9, 3.981244727438179*^9}, {3.981245512277483*^9, 
  3.981245541295841*^9}, {3.98129328480437*^9, 3.9812933359926167`*^9}, {
  3.981293468000684*^9, 3.981293478073906*^9}, {3.981294262535523*^9, 
  3.981294303457511*^9}},ExpressionUUID->"f4942b9f-4c24-463f-ac5c-\
742e48c8e650"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Twist Vectors", "Subsubsection",
 CellChangeTimes->{{3.981295517550191*^9, 
  3.981295521061105*^9}},ExpressionUUID->"213c9a40-f660-4301-9be2-\
682bb1cf715f"],

Cell[TextData[{
 "The real part, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "0"], TraditionalForm]],ExpressionUUID->
  "5ed04a81-b697-4976-af34-46f3c7884f8d"],
 ", of the quaternion ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "02b77374-ddf8-43d2-b90a-ccdb7c6cd6fa"],
 " multiplies the identity matrix. The imaginary part is constructed from a \
real 3\[NoBreak]-\[NoBreak]vector, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["q", "\[RightVector]"], "\[Congruent]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["q", "1"], ",", 
      SubscriptBox["q", "2"], ",", 
      SubscriptBox["q", "3"]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "101938a3-4260-47aa-be8f-fd91c1b7ef6c"],
 ", that points along the \[OpenCurlyDoubleQuote]twist axis.\
\[CloseCurlyDoubleQuote] As we shall see immediately below, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ac2df9d3-8da7-4ea6-a0f3-912c14e29850"],
 " is the cosine of half the twist angle, and the imaginary part is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "\[ImaginaryI]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5e699b59-5653-4e6f-8810-d1144f3da01e"],
 " times the sine of half the twist angle times the normalized ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1639fd2c-46b2-4691-94d3-a6689a4c53c9"],
 ", represented in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "352bdb89-a9c1-4ce0-b926-6b0da39a3bbe"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     OverscriptBox["q", "\[RightVector]"], " ", "\[FilledSmallCircle]", " ", 
     RowBox[{
      OverscriptBox["\[Sigma]", "\[RightVector]"], "/", 
      RowBox[{"\[LeftBracketingBar]", 
       OverscriptBox["q", "\[RightVector]"], "\[RightBracketingBar]"}]}]}], 
    ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c1f8a94f-efeb-4b33-93e5-14addfbf80da"],
 ". Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["cos", "2"], "+", 
     SuperscriptBox["sin", "2"]}], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "924207fd-fcde-42d7-94db-4829202702a5"],
 ", the entire quaternion is of unit magnitude even when ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dd53020c-dca4-46be-980f-9a8d83d105fe"],
 " is not. In fact, if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["q", "\[RightVector]"], "\[RightBracketingBar]"}], "=", 
    "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d14cff2e-72e8-4fba-a4dc-36d643f34e25"],
 ", there is no twist vector, no rotation, and the entire quaternion is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["q", "0"], "=", "1"}], ")"}], 
    SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "824cc21c-3fec-41e3-9ef9-243a0236c258"],
 "."
}], "Text",
 CellChangeTimes->CompressedData["
1:eJwdxUsow3EAB/Ax1tIOLlYsj3nNI884bGMb8n7EEoc/S2JF8vfKotQOU1PT
pMhj/MurFlGSPdgBSUkrhSIMZQf1d0AcrPh9/4dPH2k7re0M5vF40QT283tm
lXa26OtHsoJ1lfQ2Ft/V7mDhocyHnx5YbudFr6CA3M8IwrDoQ5xZSN6gx+VY
XTGnxToFy00dfyrKyS9DKUruKyqtiszE2dLxFr/M0EYeqGUXcUA8wFrJKsbE
TR2p5qfIK2fhC/j3PCdymlwfa0nCLm23a5mcPeZz4/rn5mSGPBX6zp34LJzA
ZoPdgvWe+ft9sunk7wUvhBo/cV/r8RcOSrhscpCl/ggKr4nijfhAK+cW668C
TrL32hziIu8OZsiwVZaXhW88Hfm4ZmlEjr+L3Wq8aZZo8F5paiVel05y2/qt
dTjXe9uAR1+VMW7yW8l+PhY6HjQ4is6txpqQ1UY846BbcNqpogs/nrcO43/X
nfpz
  "],ExpressionUUID->"caaa38a0-d129-4f72-9139-984b511dcd9b"],

Cell[TextData[{
 StyleBox["The same process of constructing a Hermitian, traceless matrix \
from a 3\[NoBreak]-\[NoBreak]vector obtains for ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "488b387c-a193-484d-8fb9-e7f04340b233"],
 StyleBox[" as for any other element of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "405816d8-641a-4b66-a6cb-3d2de2dafea7"],
 ". ",
 StyleBox["Therefore, the imaginary part of a quaternion is ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "\[ImaginaryI]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c060a3fd-af9f-4d05-93bb-0eb4dc90aa6a"],
 StyleBox[" times an element of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fee0bad9-c823-4a59-bfe4-ba3591723d9c"],
 ". ",
 StyleBox["However, these elements of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f53fd422-cfd1-484d-83c6-0d735109fa18"],
 StyleBox[" are not subjects of rotation, but rather specify the twist \
vector, about which the rotation of some other 3\[NoBreak]-\[NoBreak]vector \
element of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f16afa87-56f8-450f-8f2f-fcc63b6b1054"],
 StyleBox[" occurs. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.981294743782628*^9, 3.981294997933853*^9}, {
  3.981295139460204*^9, 3.9812952911942873`*^9}, {3.981295544748493*^9, 
  3.981295547192836*^9}, {3.9812977129169292`*^9, 3.981297749437538*^9}, {
  3.981300149791731*^9, 3.981300180908085*^9}, {3.9813003400083027`*^9, 
  3.981300353710823*^9}, {3.981300489149001*^9, 3.981300514828511*^9}, {
  3.981300674581958*^9, 
  3.9813006889829817`*^9}},ExpressionUUID->"92b39842-8574-4179-8dfc-\
321430f9656d"],

Cell[TextData[{
 "EMPHASIS: we pick another element of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0276efee-fca5-4d7b-8a93-3618e0ea18af"],
 ", not the vector we are rotating, but the twist vector about which we \
rotate, for building the imaginary part of ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "de2481bc-b253-49a0-adff-61341151e1b4"],
 "."
}], "Text",
 CellChangeTimes->{{3.9812475077797203`*^9, 3.981247531613763*^9}, {
  3.981247593671958*^9, 3.981247630977949*^9}, {3.981295026269062*^9, 
  3.981295029246193*^9}, {3.981295575843905*^9, 3.981295585617784*^9}, {
  3.9813007112382307`*^9, 
  3.981300713873247*^9}},ExpressionUUID->"4798e9ee-8bfc-49d5-811b-\
e3b40741434e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Exponential Map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], "\[LongRightArrow]", 
     "S"}], "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "81917f92-fe68-4804-b4a7-bb93357a9abd"]
}], "Subsubsection",
 CellChangeTimes->{{3.9812950848699427`*^9, 
  3.981295118918874*^9}},ExpressionUUID->"a57c1f7a-b594-4b04-a416-\
8750d3709a2f"],

Cell[TextData[{
 "In mechanics, classical or quantum, we usually specify an angle of rotation \
by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", " ", "\[Omega]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ff2f405f-8079-4d19-ba02-66ca74fdd11e"],
 ", a coordinate time multiplied by an angular velocity \[Omega]."
}], "Text",
 CellChangeTimes->{{3.981295606679921*^9, 3.981295657404581*^9}, {
  3.981297764510063*^9, 
  3.98129776996891*^9}},ExpressionUUID->"e2f9cc43-6cfd-4675-b299-\
757bb8afc160"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Omega]", "=", 
         RowBox[{"t", 
          RowBox[{"{", 
           RowBox[{
            SubscriptBox["\[Omega]", "1"], ",", 
            SubscriptBox["\[Omega]", "2"], ",", 
            SubscriptBox["\[Omega]", "3"]}], "}"}]}]}], "}"}], ",", 
       RowBox[{"\[Omega]", ".", "\[Sigma]Vec"}]}], "]"}], "//", 
     "MatrixForm"}], 
    ",", "\"\<twist 3-vector \
\!\(\*Cell[\"r\",ExpressionUUID->\"8e2e78f4-3ddb-44c0-81a1-fd22b51a01ab\"]\) \
in \[GothicS]\[GothicU](2) :\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9812146102702627`*^9, 3.9812146789147367`*^9}, {
  3.981247554020776*^9, 3.981247584527129*^9}, {3.98124763730602*^9, 
  3.9812477124888573`*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"0be4de33-8361-43fc-904e-646d7975c08d"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"twist 3-vector \\!\\(\\*Cell[\\\"r\\\"]\\) in \[GothicS]\
\[GothicU](2) :\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       RowBox[{"t", " ", 
        SubscriptBox["\[Omega]", "3"]}], 
       RowBox[{
        RowBox[{"t", " ", 
         SubscriptBox["\[Omega]", "1"]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", "t", " ", 
         SubscriptBox["\[Omega]", "2"]}]}]},
      {
       RowBox[{
        RowBox[{"t", " ", 
         SubscriptBox["\[Omega]", "1"]}], "+", 
        RowBox[{"\[ImaginaryI]", " ", "t", " ", 
         SubscriptBox["\[Omega]", "2"]}]}], 
       RowBox[{
        RowBox[{"-", "t"}], " ", 
        SubscriptBox["\[Omega]", "3"]}]}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}], "\[NoBreak]", ")"}],
   Function[BoxForm`e$, 
    MatrixForm[BoxForm`e$]]]}]], "Echo",
 CellChangeTimes->{
  3.9813031707484293`*^9},ExpressionUUID->"e46e3d4f-eae3-411a-8f9f-\
23861ac1b77e"]
}, Open  ]],

Cell[TextData[{
 "We map this twist vector (in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ec997283-7b55-4da2-a0ef-f8bc2163ceee"],
 ") into a quaternion (in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fdfeb172-8bf1-4325-8080-0972d28f1101"],
 ") via a matrix exponential of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "\[ImaginaryI]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cf12ab54-494e-41fc-8382-f5de922c229d"],
 " times the twist vector:"
}], "Text",
 CellChangeTimes->{{3.98129780268321*^9, 3.981297854434805*^9}, {
  3.9812979318238993`*^9, 
  3.981297944447939*^9}},ExpressionUUID->"abb5ffa5-76ae-4b48-97bf-\
df880a199d8d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Q", "(", "t", ")"}], "=", 
     RowBox[{
      SuperscriptBox["e", 
       RowBox[{
        RowBox[{"-", "i"}], " ", 
        FractionBox[
         RowBox[{"\[Omega]", " ", "t"}], "2"], " ", 
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           OverscriptBox["\[Omega]", "\[RightVector]"], 
           "\[FilledSmallCircle]", 
           OverscriptBox["\[Sigma]", "\[RightVector]"]}], "\[Omega]"], 
         ")"}]}]], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"cos", "(", 
         FractionBox[
          RowBox[{"\[Omega]", " ", "t"}], "2"], ")"}], 
        SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], "  ", "-", "  ", 
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"sin", "(", 
         FractionBox[
          RowBox[{"\[Omega]", " ", "t"}], "2"], ")"}], 
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           OverscriptBox["\[Omega]", "\[RightVector]"], 
           "\[FilledSmallCircle]", 
           OverscriptBox["\[Sigma]", "\[RightVector]"]}], "\[Omega]"], 
         ")"}]}]}]}]}], "\[LineSeparator]", 
    RowBox[{"=", 
     RowBox[{
      RowBox[{
       RowBox[{"cos", "(", 
        FractionBox[
         RowBox[{"\[Omega]", " ", "t"}], "2"], ")"}], 
       SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], "  ", "-", "  ", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"sin", "(", 
        FractionBox[
         RowBox[{"\[Omega]", " ", "t"}], "2"], ")"}], 
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "\[Omega]"], 
         FormBox[
          RowBox[{"(", "\[NoBreak]", GridBox[{
             {
              SubscriptBox["\[Omega]", "3"], 
              RowBox[{
               SubscriptBox["\[Omega]", "1"], "-", 
               RowBox[{"\[ImaginaryI]", " ", 
                SubscriptBox["\[Omega]", "2"]}]}]},
             {
              RowBox[{
               SubscriptBox["\[Omega]", "1"], "+", 
               RowBox[{"\[ImaginaryI]", " ", 
                SubscriptBox["\[Omega]", "2"]}]}], 
              RowBox[{"-", 
               SubscriptBox["\[Omega]", "3"]}]}
            },
            
            GridBoxAlignment->{
             "Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
            GridBoxSpacings->{"Columns" -> {
                Offset[0.27999999999999997`], {
                 Offset[0.7]}, 
                Offset[0.27999999999999997`]}, "Rows" -> {
                Offset[0.2], {
                 Offset[0.4]}, 
                Offset[0.2]}}], "\[NoBreak]"}],
          TraditionalForm]}], ")"}]}]}]}]}], ")"}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.981213580371439*^9, 3.9812139355618353`*^9}, {
  3.981214872101968*^9, 3.981214901200376*^9}, {3.98124523999442*^9, 
  3.981245253924609*^9}, {3.981245411248929*^9, 3.9812454390854073`*^9}, {
  3.981245659948629*^9, 3.981245662030323*^9}, {3.9812469646773643`*^9, 
  3.9812469718609324`*^9}},ExpressionUUID->"0c7da215-2653-4d0d-abd2-\
4dc65de0dcea"],

Cell["\<\
Here is a proof, in Wolfram, that the MatrixExp equals the longhand form, \
called the Euler-Rodrigues formula:\
\>", "Text",
 CellChangeTimes->{{3.9812978740026207`*^9, 3.98129790728375*^9}, {
  3.981300942180106*^9, 3.981300942586491*^9}, {3.981300976586059*^9, 
  3.981300999376853*^9}},ExpressionUUID->"6ab07aff-6455-4f7a-9ac5-\
808dfc96abc8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "\[Omega]", "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"lieGroupElement", "=", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Omega]Vec", "=", 
            RowBox[{"{", 
             RowBox[{"\[Omega]1", ",", "\[Omega]2", ",", "\[Omega]3"}], 
             "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"Cos", "[", 
              FractionBox[
               RowBox[{"\[Omega]", " ", "t"}], "2"], "]"}], "id"}], "-", 
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"Sin", "[", 
              FractionBox[
               RowBox[{"\[Omega]", " ", "t"}], "2"], "]"}], 
             RowBox[{"(", 
              RowBox[{
               FractionBox["\[Omega]Vec", "\[Omega]"], ".", "\[Sigma]Vec"}], 
              ")"}]}]}], "\[IndentingNewLine]", "]"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"expOfLieAlgebraElement", "=", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Omega]Vec", "=", 
            RowBox[{"{", 
             RowBox[{"\[Omega]1", ",", "\[Omega]2", ",", "\[Omega]3"}], 
             "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"FullSimplify", "[", 
           RowBox[{"ReplaceAll", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"MatrixExp", "[", 
              RowBox[{
               RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", 
               RowBox[{"(", 
                FractionBox[
                 RowBox[{"\[Omega]Vec", ".", "\[Sigma]Vec"}], "2"], ")"}]}], 
              "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                SuperscriptBox["\[Omega]1", "2"], "+", 
                SuperscriptBox["\[Omega]2", "2"], "+", 
                SuperscriptBox["\[Omega]3", "2"]}], "->", 
               SuperscriptBox["\[Omega]", "2"]}], "}"}]}], "]"}], "]"}]}], 
         "]"}]}]}], "}"}], ",", "\n", 
     RowBox[{"proof", "[", 
      RowBox[{"lieGroupElement", "===", "expOfLieAlgebraElement"}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9812083537260036`*^9, 3.981208376137467*^9}, {
  3.981208413676469*^9, 3.98120845971517*^9}, {3.9812085430518017`*^9, 
