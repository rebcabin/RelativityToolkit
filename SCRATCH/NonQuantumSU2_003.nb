Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ImQ", "=", 
     RowBox[{"{", 
      RowBox[{"\[ImaginaryI]", ",", "0", ",", "0"}], "}"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"counterexample", "=", 
     RowBox[{"ImQ", ".", "\[Sigma]Vec"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", ",", "cct"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"c", "=", "counterexample"}], ")"}], "//", "MatrixForm"}], 
        ",", "\"\<Im(Q).\[Sigma] :\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"cct", "=", 
           RowBox[{"counterexample", "\[ConjugateTranspose]"}]}], ")"}], "//",
          "MatrixForm"}], 
        ",", "\"\<(Im(Q).\[Sigma])\[ConjugateTranspose] :\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"proof", "[", 
       RowBox[{"c", "===", 
        RowBox[{"-", "cct"}]}], "]"}], ";"}]}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"definition", " ", "of", " ", "anti"}], "-", "Hermitian"}], 
     "*)"}], "\[IndentingNewLine]", "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.981296516008277*^9, 3.9812965864799223`*^9}, {
  3.9812966512553473`*^9, 3.981296732879119*^9}, {3.9812968908977137`*^9, 
