Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "coords3", ",", "vels3", ",", "accels3", ",", "v3", ",", "a3", ",", 
    "\[CapitalGamma]3", ",", "I3", ",", "I1", ",", "cz", ",", "m", ",", "V"}],
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords3", "=", 
   RowBox[{"{", 
    RowBox[{"\[Delta]", ",", "\[Eta]", ",", "\[Psi]"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"metric3", "=", 
   RowBox[{"(", GridBox[{
      {"I1", "0", "0"},
      {"0", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"I1", " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Delta]", "]"}], "2"]}], "+", 
         RowBox[{"I3", " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Delta]", "]"}], "2"]}]}], ")"}], 
       RowBox[{"I3", " ", 
        RowBox[{"Sin", "[", "\[Delta]", "]"}]}]},
      {"0", 
       RowBox[{"I3", " ", 
        RowBox[{"Sin", "[", "\[Delta]", "]"}]}], "I3"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g3", "=", 
   RowBox[{"MakeIndexer", "[", 
    RowBox[{"metric3", ",", "coords3"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ig3", "=", 
    RowBox[{"MakeIndexer", "[", 
     RowBox[{
      RowBox[{"Inverse", "@", "metric3"}], ",", "coords3"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"vels3", "=", 
   RowBox[{
