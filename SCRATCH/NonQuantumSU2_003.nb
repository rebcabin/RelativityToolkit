Cell[TextData[{
 "The animation is much more convincing. We have changed the cyan circle and \
red dot to track the plane and location of the center of mass because the \
angle \[Eta] will become meaningless as we go to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e4e229db-b448-4df6-af68-ffe92bd46173"],
 ". We have also chosen initial conditions to produce an extreme amount of \
nutation, stressing the solution."
}], "Text",
 CellChangeTimes->{{3.980772228419236*^9, 3.980772273231481*^9}, {
  3.980772330087636*^9, 
  3.980772412224367*^9}},ExpressionUUID->"f93809d9-7e6b-41ba-a514-\
02fc34c71a66"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
