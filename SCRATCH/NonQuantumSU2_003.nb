Cell[CellGroupData[{

Cell[TextData[{
 "Elements of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "236e5cb4-4336-48ba-a863-606eee2ba65e"],
 " are Hermitian and Traceless"
}], "Subsubsection",
 CellChangeTimes->{{3.981043253724121*^9, 3.981043282915587*^9}, {
  3.98106446501652*^9, 3.981064468033197*^9}, {3.981295728942463*^9, 
  3.981295754781122*^9}},ExpressionUUID->"d5f3dcd3-bafe-4c56-9d32-\
f51492e301d4"],

Cell["\<\
Pauli matrices are Hermitian and traceless: each is equal to its conjugate \
transpose. \[OpenCurlyDoubleQuote]Hermitian\[CloseCurlyDoubleQuote] is the \
analogue of \[OpenCurlyDoubleQuote]symmetric\[CloseCurlyDoubleQuote] amongst \
real matrices. \
\>", "Text",
 CellChangeTimes->{{3.981043993161935*^9, 3.981044040964336*^9}, {
  3.981064479120384*^9, 3.981064481754177*^9}, {3.9810706500504208`*^9, 
  3.9810706580847073`*^9}, {3.981116320775547*^9, 3.981116323739871*^9}, {
  3.981220112540186*^9, 3.9812201237763977`*^9}, {3.9812925289492817`*^9, 
  3.981292554924773*^9}},ExpressionUUID->"07d2933f-6f90-4857-8f4b-\
4380756db87d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"proof", "@", 
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"pauliMatrices", "===", 
      RowBox[{"(", 
       RowBox[{"ConjugateTranspose", "/@", "pauliMatrices"}], ")"}]}], 
     ",", "\"\<Pauli matrices are Hermitian :\>\""}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.9810432898036327`*^9, 3.981043311101338*^9}, {
  3.981064623637311*^9, 3.981064645155281*^9}, {3.98110162930031*^9, 
