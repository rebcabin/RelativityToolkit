Cell[TextData[{
 "The Pauli matrices are Hermitian. a basis for the ",
 StyleBox["Lie Algebra",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ea9be96a-bd55-43e3-81c6-c10ec565fa87"],
 ", a vector space tangent to the origin of the ",
 StyleBox["Lie Group",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "87fd83d0-1333-41dc-8377-6eaf7b130a8c"],
 "."
}], "Text",
 CellChangeTimes->{{3.981212919712832*^9, 3.981212938345106*^9}, {
  3.981213378090358*^9, 3.981213393668622*^9}, {3.981220128115487*^9, 
