Cell[TextData[{
 "Spot the X component, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", " ", "cos\[Theta]"}], "-", 
    RowBox[{"y", " ", "sin\[Theta]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "75a2d008-d549-46a9-ac6e-67c85e7bd24f"],
 ", of the new vector as the real part of the ",
 StyleBox["\[LeftDoubleBracket]1,2", "Input"],
 "\[RightDoubleBracket] or the ",
 StyleBox["\[LeftDoubleBracket]2,1\[RightDoubleBracket]", "Input"],
 " component, and compare it with the intuited or memorized result from \
school math to see that the new vector is, indeed, rotated by \[Theta] \
counterclockwise."
}], "Text",
 CellChangeTimes->{{3.981217681205143*^9, 3.9812177029618263`*^9}, {
  3.9812181378513937`*^9, 
  3.9812183079327717`*^9}},ExpressionUUID->"214cc03d-b1c3-412e-ab34-\
c539da36bc06"]
}, Open  ]],

