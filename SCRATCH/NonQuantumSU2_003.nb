                    RowBox[{"renderPos", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"epsilon", "+", "h"}], ")"}], " ", "e3"}]}]}], 
                    "]"}]}], "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"ImageSize", "->", "Large"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{"Axes", "->", "True"}], ",", "\[IndentingNewLine]", 
                  
                  RowBox[{"AxesLabel", "->", 
