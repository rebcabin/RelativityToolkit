  "],ExpressionUUID->"0d314335-4d41-4572-b619-6482b11dfb32"],

Cell[TextData[{
 StyleBox["By studying",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "4dddc854-144c-4265-b079-eabed6f10f37"],
 StyleBox[" here in an intuitive setting of classical mechanics, we are \
better equipped for later transition to quantum physics. Instead of studying \
two abstractions at once\[LongDash]",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "b793e247-e956-4a61-b801-eb4cbf90f557"],
 StyleBox[" and spinors\[LongDash]we will have only spinors to study. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.981040819375476*^9, 3.9810409128740177`*^9}, {
  3.981041011477706*^9, 3.981041018432872*^9}, {3.981041401241703*^9, 
  3.9810414074333344`*^9}, {3.98104171546249*^9, 3.981041744206963*^9}, {
  3.9810440807170467`*^9, 3.981044172169879*^9}, {3.981044372758819*^9, 
  3.981044375413375*^9}, {3.981064663617475*^9, 3.981064665264268*^9}, {
  3.9810706748697367`*^9, 3.981070684878982*^9}, {3.981116346187948*^9, 
  3.981116639415704*^9}, {3.9812135475653057`*^9, 3.9812135600094*^9}, {
  3.98121360301814*^9, 3.981213609601499*^9}, {3.981244966955203*^9, 
  3.981245054231269*^9}, {3.9812450861013403`*^9, 3.981245108770018*^9}, {
  3.981246425476857*^9, 3.981246703641313*^9}, {3.981246822880254*^9, 
  3.981246835048118*^9}, {3.9812946754426613`*^9, 3.9812946808976192`*^9}, {
  3.981297553637143*^9, 
  3.981297560383252*^9}},ExpressionUUID->"999eaa7a-1656-4295-ab0d-\
ae16cd05f671"],

Cell[TextData[{
 StyleBox["A Lie Group is a group\[LongDash]a set of elements closed under \
associative, non-commutative, abstract multiplication with inverse and \
identity. A Lie Group is also a manifold, so enjoys parameterization by \
continuous, differentiable coordinate charts. ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6e92b1d1-9cbc-40fc-9dcb-bda59c165f1c"],
 " ",
 StyleBox["is also a Lie Group, but, as we have seen, it cannot be covered by \
a single, non-singular chart, a fact manifested physically by gimbal lock.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.981293512311339*^9, 3.98129363548799*^9}, {
  3.981293947930201*^9, 3.981294001790509*^9}, {3.9812953964816628`*^9, 
  3.981295419577673*^9}, {3.981295465129278*^9, 3.981295484084504*^9}, {
  3.981305792991992*^9, 
  3.981305871527793*^9}},ExpressionUUID->"dfa89e8d-46c6-46f5-9138-\
f5a84c27c76c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"42dbc42a-40e9-4807-bece-d99e6bdc1288"]], \
"Subsection",
 CellChangeTimes->{
  3.981301684485655*^9},ExpressionUUID->"77720b24-0566-4da8-ad85-\
7422dd97c99b"],

Cell[TextData[{
 "The Lie Algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d7ba8a6c-4704-481e-bc5f-9b6547b88d27"],
 " is the set of all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bf6fbea9-9f9a-44bc-878d-f0516459c962"],
 " complex, traceless, anti-Hermitian matrices. ",
 StyleBox["Anti-Hermitian",
  FontSlant->"Italic"],
 " means that a matrix equals the negative of its complex-conjugate \
transpose: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", "\[ConjugateTranspose]"}], "=", 
    RowBox[{"-", "A"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2dd9a0e3-d960-4ef6-86b5-44fbddc3c42d"],
 ". Traceless means that the sum of its diagonal elements vanishes. "
}], "Text",
 CellChangeTimes->{{3.981301704785162*^9, 
  3.981301896282843*^9}},ExpressionUUID->"254bf1a8-c9f3-4a6a-9ebf-\
525f7ebae7f9"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a6ed6de7-7af4-4852-97ac-d42ae21c4aab"],
 " is the tangent space at the identity of the group ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c0ec27f1-394f-47f8-9741-ada0360711f0"],
 ". Unitarity of elements of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eb7e7e58-8645-4b8e-8cbd-5b7a506c8514"],
 " implies that tangent \
\[OpenCurlyDoubleQuote]vectors\[CloseCurlyDoubleQuote] in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d0e379f1-5cb1-4b94-a1fe-58d73d1e8072"],
 " are anti-Hermitian, and unit determinants for members of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5cc690ef-c0df-4d4b-8866-d173b087ffa7"],
 " implies that elements of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40dd7f27-bb32-4df9-a336-730e01afb7b4"],
 " are traceless."
}], "Text",
 CellChangeTimes->{{3.981305938824493*^9, 
  3.981306133071661*^9}},ExpressionUUID->"a98ea16e-ab0f-4b23-8368-\
c67e817848a2"]
}, Open  ]],

