Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "rig", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"l", "=", "1.2"}], ",", 
      RowBox[{"mass", "=", "1.0"}], ",", 
      RowBox[{"d", "=", "2.4"}], ",", 
      RowBox[{"r", "=", "0.02"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"baton", "=", 
       RowBox[{"Cylinder", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", 
             RowBox[{"-", "l"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", 
             RowBox[{"+", "l"}]}], "}"}]}], "}"}], ",", "r"}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"batonCenterBodyFrame", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "l"}], "}"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"rig", "[", "\"\<graphics primitives\>\"", "]"}], "=", 
      "baton"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rig", "[", "\"\<moment of inertia\>\"", "]"}], "=", 
      "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Ib", "=", 
          RowBox[{"mass", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"MomentOfInertia", "[", "baton", "]"}], "/", 
             RowBox[{"Volume", "[", "baton", "]"}]}], ")"}]}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"Ibi", "=", 
          RowBox[{"Inverse", "@", "Ib"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"Ib", ",", "Ibi"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rig", "[", "\"\<cb\>\"", "]"}], ":=", "batonCenterBodyFrame"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rig", "[", "\"\<half length\>\"", "]"}], ":=", "l"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rig", "[", "\"\<mass\>\"", "]"}], ":=", "mass"}], ";"}]}], 
   "]"}], ";"}], "\n", 
 RowBox[{
