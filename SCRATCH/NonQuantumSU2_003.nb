Cell[CellGroupData[{

Cell[TextData[{
 "Angular Velocity Matrix ",
 Cell[BoxData[
  FormBox["\[Omega]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c3277ac7-c485-44e7-be7d-fb5fd591b39f"]
}], "Subsection",
 CellChangeTimes->{{3.980614087957796*^9, 3.980614092568768*^9}, {
  3.98077280494897*^9, 3.9807728069273243`*^9}, {3.98077287139086*^9, 
  3.980773043337658*^9}, {3.9810206904555473`*^9, 3.981020748741226*^9}, {
  3.981040430010886*^9, 3.98104044006492*^9}, {3.9810405888437366`*^9, 
  3.981040592548411*^9}},ExpressionUUID->"ff7604f2-ee14-4e6f-bbd5-\
d8ffe04be9f5"],

Cell["\<\
To derive the angular-velocity matrix, \[Omega], first differentiate the \
Unitarity equation of the element:\
\>", "Text",
 CellChangeTimes->{{3.98104167207452*^9, 3.98104169356518*^9}, {
  3.9810453911535387`*^9, 3.981045408446251*^9}, {3.981064805135757*^9, 
  3.9810648211931477`*^9}, {3.981140123157926*^9, 
  3.98114013221982*^9}},ExpressionUUID->"b713b79c-3e97-46a1-995f-\
a7fb957b997f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["\[DifferentialD]", 
     RowBox[{"\[DifferentialD]", "t"}]], 
    RowBox[{"(", 
     RowBox[{"Q", ".", 
      RowBox[{"Q", "\[ConjugateTranspose]"}]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       OverscriptBox["Q", "\[FilledSmallCircle]"], ".", 
       RowBox[{"Q", "\[ConjugateTranspose]"}]}], "+", 
      RowBox[{"Q", ".", 
       RowBox[{
        OverscriptBox["Q", "\[FilledSmallCircle]"], 
        "\[ConjugateTranspose]"}]}]}], ")"}], "=", 
    RowBox[{
     RowBox[{
      FractionBox["\[DifferentialD]", 
       RowBox[{"\[DifferentialD]", "t"}]], "id"}], "=", "0"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.981045422805397*^9, 3.9810454999317913`*^9}, {
  3.981064359910308*^9, 3.981064362560686*^9}, {3.981064832568413*^9, 
  3.981064836645761*^9}, {3.981070755981029*^9, 
  3.981070755982582*^9}},ExpressionUUID->"a2e02e60-3c1f-47f9-b7b8-\
b66882fa3219"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["Q", "\[FilledSmallCircle]"], ".", 
    RowBox[{"Q", "\[ConjugateTranspose]"}]}], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Q", ".", 
      RowBox[{
       OverscriptBox["Q", "\[FilledSmallCircle]"], 
       "\[ConjugateTranspose]"}]}]}], "=", 
    RowBox[{"-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        OverscriptBox["Q", "\[FilledSmallCircle]"], ".", 
        RowBox[{"Q", "\[ConjugateTranspose]"}]}], ")"}], 
      "\[ConjugateTranspose]"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9810649347446337`*^9, 3.98106500951861*^9}, {
  3.9810707645716953`*^9, 
  3.981070764572509*^9}},ExpressionUUID->"087b9eaf-d271-4436-a459-\
5410bc3ad6fa"],

Cell[TextData[{
 "Therefore, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["Q", "\[FilledSmallCircle]"], ".", 
    RowBox[{"Q", "\[ConjugateTranspose]"}]}], TraditionalForm]], 
  "DisplayFormulaNumbered",
  CellChangeTimes->{{3.9810649347446337`*^9, 3.98106500951861*^9}, {
   3.9810707645716953`*^9, 3.981070764572509*^9}},ExpressionUUID->
  "45c393b9-6146-4455-9bc7-bbb771016a57"],
 " is anti-Hermitian (or skew-Hermitian), and is an element of the Lie \
Algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicO]", 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "66560f92-20e2-41dd-b4a3-d252cb199b60"],
 ", the tangent space of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "7f835b02-e638-4aa2-ac6b-1bee43b56886"],
 " at its origin ",
 StyleBox["(TODO: Explain)",
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27],
  Background->RGBColor[1, 0.75, 0]],
 ".  Angular velocity must be Hermitian, so we multiply ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["Q", "\[FilledSmallCircle]"], ".", 
    RowBox[{"Q", "\[ConjugateTranspose]"}]}], TraditionalForm]], 
  "DisplayFormulaNumbered",
  CellChangeTimes->{{3.9810649347446337`*^9, 3.98106500951861*^9}, {
   3.9810707645716953`*^9, 3.981070764572509*^9}},ExpressionUUID->
  "7502bd93-8337-41b6-8c79-77a0db0dd80b"],
 " by \[ImaginaryI]. But we\[CloseCurlyQuote]re not done, yet."
}], "Text",
 CellChangeTimes->{{3.981070805435979*^9, 3.981070929461068*^9}, {
  3.981070984413526*^9, 3.981071021050077*^9}, {3.9810728070962*^9, 
  3.981072812571866*^9}, {3.981131052326277*^9, 3.9811310645612507`*^9}, {
  3.9811312534703836`*^9, 
  3.981131255452745*^9}},ExpressionUUID->"a1bb55e0-ac9c-444f-9021-\
ac41ed5fc931"],

Cell[CellGroupData[{

Cell["Half Angle and Double Cover", "Subsubsection",
 CellChangeTimes->{{3.981071141969226*^9, 3.981071144947425*^9}, {
  3.981071234112644*^9, 
  3.981071237783826*^9}},ExpressionUUID->"569a34ba-72d4-431b-bbd9-\
ae3d12ccc1b7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "6969b1d3-0248-4d7b-bf2b-e5914bc07eb8"],
 " is a double cover of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "36a84295-99b0-40c8-b839-a63987bb0846"],
 ". That means that two elements of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "046ae70e-96ce-4a91-bb08-9d8c0aa4560c"],
 " correspond to a single element of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "b15fc9d6-66b2-4eff-b313-970a1461ed19"],
 ". Which two? A rotation of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Theta]", "=", 
    RowBox[{
     SubscriptBox["\[Omega]", "3"], " ", "t"}]}], TraditionalForm]],
  ExpressionUUID->"180e5c62-a85a-4bb9-887b-c7fbc5e0868b"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "eba1cd16-3353-47ef-a270-89152e67134a"],
 " around the Z axis corresponds to a rotation of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"\[Omega]", " "}], "3"], 
    RowBox[{"t", "/", "2"}]}], TraditionalForm]],ExpressionUUID->
  "aa4a2499-891f-4388-89b2-c0da4b3a9a3a"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "2b8df6bf-b031-4d50-a5e1-b1de63208745"],
 " by the following formula:"
}], "Text",
 CellChangeTimes->{{3.981071180117351*^9, 3.981071393952209*^9}, 
   3.981071502456662*^9, {3.981071790875745*^9, 3.9810717951238813`*^9}, {
   3.981072422604866*^9, 3.981072464436297*^9}, {3.981209147163138*^9, 
   3.981209157917309*^9}},ExpressionUUID->"924d51fa-d5c7-4d7b-a5f5-\
76be5761d5dc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Q", 
    RowBox[{"(", "t", ")"}]}], "=", 
   RowBox[{
    RowBox[{"cos", 
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SubscriptBox["\[Omega]", "3"], " ", "t"}], "2"], ")"}], 
     SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], "-", 
    RowBox[{"\[ImaginaryI]", " ", "sin", 
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SubscriptBox["\[Omega]", "3"], " ", "t"}], "2"], ")"}], 
     SubscriptBox["\[Sigma]", "3"]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.98107170159214*^9, 3.981071783202004*^9}, {
  3.981071819622246*^9, 3.981071819623542*^9}, {3.981209165309971*^9, 
  3.981209169828549*^9}},ExpressionUUID->"62a0f97c-694a-4f1b-b50c-\
4166fbf0abff"],

Cell[TextData[{
 "A rotation of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[Degree]"}], TraditionalForm]],ExpressionUUID->
  "efa74b4c-dd55-402e-9775-e491aefd934e"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", "O", 
    RowBox[{"(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "c4d6bd4c-b0a0-4cd0-a7ca-5f2e7910f785"],
 ", is the spinor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[DoubleStruckCapitalI]", "2"], TraditionalForm]],
  ExpressionUUID->"a5e0eb30-f62f-48b3-aa7c-cf2ed67a879b"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "934e1a44-fcf5-46d3-bc32-5dfbd2aefff8"],
 ", the identity matrix, as we would expect. However, a rotation of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"360", "\[Degree]"}], TraditionalForm]],ExpressionUUID->
  "e3b89218-dfeb-4453-875d-79ae8ed88b13"],
 ", which corresponds to the same element in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", "O", 
    RowBox[{"(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "782483c8-3018-4387-bba1-10eb1b5021f1"],
 ",  is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], TraditionalForm]],
  ExpressionUUID->"4e1d86c5-d83b-40d3-805e-ad7bcc74dcf1"],
 ", a spinor pointing in the opposite direction. The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"360", "\[Degree]"}], TraditionalForm]],ExpressionUUID->
  "ef53c611-6db8-40c9-8340-8965fef10328"],
 " rotation in real space has produced a direction flip in spinor space. An \
object attached to its surroundings must be rotated by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"720", "\[Degree]"}], TraditionalForm]],ExpressionUUID->
  "6dbc4544-969d-4146-b28c-6d6dd0e1b24a"],
 "\[LongDash]two full rotations around the same axis\[LongDash]to undo a \
twist in the attachment apparatus. Far from being merely abstract quantities, \
spinors describe \[OpenCurlyDoubleQuote]strapped down\[CloseCurlyDoubleQuote] \
rotations in ordinary 3\[NoBreak]-\[NoBreak]space and classical mechanics."
}], "Text",
 CellChangeTimes->{{3.9810718502358427`*^9, 3.981072243826683*^9}, {
  3.9810723876764183`*^9, 3.981072398234853*^9}, {3.981072470622192*^9, 
  3.981072573841116*^9}, {3.981072659401846*^9, 3.981072707733918*^9}, {
  3.981109776416844*^9, 3.981109805351583*^9}, {3.98120918389465*^9, 
  3.981209253891581*^9}},ExpressionUUID->"abbfe789-d04f-4831-a6c8-\
7bd4f24631f9"],

Cell["What about angular velocity?", "Text",
 CellChangeTimes->{{3.981072785337511*^9, 
  3.981072790675003*^9}},ExpressionUUID->"7202be1d-b1c6-40bd-a50d-\
69d9bf063ddb"],

Cell[CellGroupData[{

Cell[BoxData[
