Cell[CellGroupData[{

Cell[TextData[{
 "The Lie Group ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "7dec9b8e-e515-4e28-870e-e92ba0e07957"],
 " and its Lie Algebra, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "308a1a17-553e-4757-99ba-4288f08b4fe7"]
}], "Section",
 CellChangeTimes->{{3.980613962792136*^9, 3.9806139797711887`*^9}, {
  3.981292289570516*^9, 3.9812922905850687`*^9}, {3.981295680091197*^9, 
  3.9812957067939663`*^9}},ExpressionUUID->"858b821e-beed-4052-a1f7-\
3d37d8d6415f"],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{"S", "\[VeryThinSpace]", 
   RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"66724147-ec34-4d1e-93af-4bcf823e4e18"]], \
"Subsection",
 CellChangeTimes->{{3.981303193151819*^9, 
  3.981303197363866*^9}},ExpressionUUID->"0e870f51-0a43-4406-9b16-\
6b35ca166668"],

Cell[TextData[{
 "The Lie Group ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", "U", 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "54904203-5682-4300-a17a-cb4991e90ebf"],
 " is the group of all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],ExpressionUUID->
  "8a4255be-a3ec-4af3-b68d-81746f3cb098"],
 " complex, unitary matrices with a unit determinant. ",
 StyleBox["Unitary",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"A", "\[ConjugateTranspose]"}], "=", 
     SuperscriptBox["A", 
      RowBox[{"-", "1"}]]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5eb2f40d-c2c6-43fd-9cfe-d6344293541a"],
 " is analogous to ",
 StyleBox["Orthogonal",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"A", "\[Transpose]"}], "=", 
     SuperscriptBox["A", 
      RowBox[{"-", "1"}]]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aed32668-975a-491e-84eb-18980e6d390b"],
 " for real matrices. Thus, we view ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "c1887a2c-186d-468c-bd5a-1be79e5518e5"],
 " as a space of rotation operators. In classical mechanics\[LongDash]our \
current application area\[LongDash]the rotation operators, ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6269ffb8-d75f-4a4f-895d-85e72e796c17"],
 ", act on Hermitian representations, ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c38b64b2-d658-4c61-8cb7-4590a8d917fa"],
 ", of real 3\[NoBreak]-\[NoBreak]vectors via the ",
 StyleBox["adjoint action:",
  FontWeight->"Bold",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.9813032209087887`*^9, 3.981303246205957*^9}, {
   3.981303556041046*^9, 3.981303739410334*^9}, {3.981303788582028*^9, 
   3.9813038957755327`*^9}, {3.981304483775255*^9, 3.981304495236456*^9}, {
   3.9813054277416067`*^9, 3.9813055061136312`*^9}, 
   3.981305643113809*^9},ExpressionUUID->"82d047db-5cce-4686-9537-\
0e895ae502a1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"v", "'"}], "=", 
    RowBox[{"Q", ".", "v", ".", 
     RowBox[{"Q", "\[ConjugateTranspose]"}]}]}], ",", " ", 
   RowBox[{"v", "\[Element]", 
    RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}]}], ",", " ", 
   RowBox[{"Q", "\[Element]", 
    RowBox[{"S", "\[VeryThinSpace]", 
     RowBox[{"U", "(", "2", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.981292824711832*^9, 3.98129287450858*^9}, {
  3.9812938350785913`*^9, 
  3.981293863957155*^9}},ExpressionUUID->"96cdae30-a470-4ade-ac66-\
6a403d157d02"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fa64c0a2-9c5e-4e02-ac3f-6fe1ab50fc32"],
 " is expanded in the Pauli basis (see below) and ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "29e3b57d-90c7-42ac-a04c-7b2ff9420a30"],
 "\[NoBreak]-\[NoBreak]dagger, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "\[ConjugateTranspose]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "44e51a39-d061-42c9-9eec-ca3220474c46"],
 ", is the complex-conjugate transpose, available in Wolfram via the \
keystrokes ",
 StyleBox["\[EscapeKey]ct\[EscapeKey]", "Input"],
 "."
}], "Text",
 CellChangeTimes->{{3.9812928821521482`*^9, 3.981292941672627*^9}, {
   3.9813039105259867`*^9, 3.981303913596085*^9}, {3.9813045099598083`*^9, 
   3.98130453293622*^9}, 3.981305573481462*^9, {3.981305660073266*^9, 
   3.9813057587703342`*^9}},ExpressionUUID->"8a5236fc-5036-4667-9751-\
fef77a707258"],

Cell[TextData[{
 "In quantum physics\[LongDash]topics for upcoming notebooks\[LongDash]the \
same ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSlant->"Plain",ExpressionUUID->"d09b649e-4d21-40fd-adc0-bc6ef8d0afa8"],
 " operators act on ",
 StyleBox["spinors",
  FontSlant->"Italic"],
 " by ",
 StyleBox["direct action",
  FontSlant->"Italic"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      RowBox[{"\[Xi]", "'"}]},
     "Ket"], "=", 
    RowBox[{"Q", " ", 
     TemplateBox[{"\[Xi]"},
      "Ket"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSlant->"Plain",ExpressionUUID->"d4e859f1-81cb-43a4-8396-8a0626345427"],
 ". "
}], "Text",
