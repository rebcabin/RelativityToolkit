Cell[CellGroupData[{

Cell[TextData[{
 "3\[NoBreak]-\[NoBreak]Vectors: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[DoubleStruckCapitalR]", "3"], "\[LongLeftRightArrow]", 
    " ", 
    RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "78e98566-9464-4ee5-8b51-c76a0ef97c0c"]
}], "Subsubsection",
 CellChangeTimes->{{3.981292580739543*^9, 3.981292607460629*^9}, {
  3.981292754450811*^9, 3.981292758468008*^9}, {3.9812937140464697`*^9, 
  3.9812937272272167`*^9}, {3.981295345932763*^9, 
  3.981295355641934*^9}},ExpressionUUID->"d8f059a4-6d0d-46f0-9b6d-\
8e2ead02f7f3"],

Cell[TextData[{
 "Any linear combination of Pauli matrices ",
 StyleBox["with real coefficients",
  FontSlant->"Italic"],
 " is also Hermitian and traceless. Therefore, any real \
3\[NoBreak]-\[NoBreak]vector, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x", ",", "y", ",", "z"}], ")"}], "\[Element]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "3"]}], TraditionalForm]],
  ExpressionUUID->"3ae6e1e2-11ed-484d-8889-eb5c5b4771a3"],
 ", can be represented as a Hermitian, traceless element of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  ExpressionUUID->"0fc5b9ff-1899-46f1-a12a-bb8798613dcd"],
 ", and vice versa, as follows:"
}], "Text",
 CellChangeTimes->{{3.981295774153098*^9, 3.981295800068363*^9}, {
  3.9812958326879997`*^9, 3.981295859641725*^9}, {3.981295926939775*^9, 
  3.9812959422294273`*^9}, {3.9812973271201563`*^9, 
  3.981297346336961*^9}},ExpressionUUID->"50452529-f5f4-457b-be83-\
a72215a99891"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"v", "=", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "}"}], ",", 
       RowBox[{"v", ".", "\[Sigma]Vec"}]}], "]"}], "//", "MatrixForm"}], 
    ",", "\"\<arbitrary 3-vector \
\!\(\*Cell[\"v\",ExpressionUUID->\"bdc0ccba-8e1f-4dbc-96ee-ee5bdbe2e048\"]\) \
as a Hermitian, traceless matrix :\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9812146102702627`*^9, 3.9812146789147367`*^9}, {
  3.981292458755094*^9, 3.981292492399829*^9}, {3.98129273224431*^9, 
  3.9812927497167377`*^9}, {3.981303940982462*^9, 3.9813039492161837`*^9}},
 CellLabel->
  "In[114]:=",ExpressionUUID->"9bb58f40-b09b-41a0-a9a4-de528c96d872"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"arbitrary 3-vector \\!\\(\\*Cell[\\\"v\\\"]\\) as a Hermitian, \
traceless matrix :\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"z", 
       RowBox[{"x", "-", 
        RowBox[{"\[ImaginaryI]", " ", "y"}]}]},
      {
       RowBox[{"x", "+", 
        RowBox[{"\[ImaginaryI]", " ", "y"}]}], 
       RowBox[{"-", "z"}]}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}], "\[NoBreak]", ")"}],
   Function[BoxForm`e$, 
    MatrixForm[BoxForm`e$]]]}]], "Echo",
 CellChangeTimes->{
  3.98130394999459*^9},ExpressionUUID->"ef42b830-afb0-42af-8b0a-56c248b95819"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["The coefficients cannot, in general, be complex. For example, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ImaginaryI]", " ", 
    SubscriptBox["\[Sigma]", "1"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "de701288-9215-44cf-8ed2-7be050df46dd"],
 StyleBox[" ",
  FontSlant->"Italic"],
 "is anti-Hermitian, i.e., equal to the negative of its conjugate transpose:"
}], "Item",
 CellChangeTimes->{{3.981295975126667*^9, 3.981295995358852*^9}, {
  3.981296274508029*^9, 3.981296276242737*^9}, {3.981296956563532*^9, 
