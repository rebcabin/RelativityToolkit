        RowBox[{"q2", "[", "t", "]"}]}], 
       RowBox[{
        RowBox[{"q0", "[", "t", "]"}], "+", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"q3", "[", "t", "]"}]}]}]}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}], "\[NoBreak]", ")"}],
   Function[BoxForm`e$, 
    MatrixForm[BoxForm`e$]]]}]], "Echo",
 CellChangeTimes->{
  3.981303171044223*^9},ExpressionUUID->"ca1a3e80-5fe5-4f8b-b6c7-\
