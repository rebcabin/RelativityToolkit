Cell["\<\
Because the Pauli matrices are Hermitian (self-adjoint) , we have the \
following identities:\
\>", "Text",
 CellChangeTimes->{{3.981042548872233*^9, 3.981042588977428*^9}, {
  3.981043235809451*^9, 3.981043238727512*^9}, {3.9810647658331347`*^9, 
  3.981064783175351*^9}},ExpressionUUID->"6981cdce-ce4a-4604-8ecc-\
0633ba84d588"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"proof", "[", 
   RowBox[{
    RowBox[{"QDag", "[", "\[Theta]", "]"}], "===", "\[IndentingNewLine]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"q0", "[", "\[Theta]", "]"}], "id"}], "+", 
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{
         RowBox[{"qIm", "[", "\[Theta]", "]"}], ".", 
         RowBox[{"(", 
          RowBox[{"ConjugateTranspose", "/@", "pauliMatrices"}], ")"}]}]}]}], 
      "//", "FullSimplify"}], ")"}], "===", "\[IndentingNewLine]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"q0", "[", "\[Theta]", "]"}], "id"}], "+", 
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{
         RowBox[{"qIm", "[", "\[Theta]", "]"}], ".", "pauliMatrices"}]}]}], "//",
       "FullSimplify"}], ")"}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.981042593470652*^9, 3.9810426489962397`*^9}, {
   3.981043163573554*^9, 3.981043227010315*^9}, {3.981043328221674*^9, 
   3.981043388893154*^9}, 3.981043801686615*^9, {3.981043843468605*^9, 
   3.9810439467485447`*^9}, {3.981067054551244*^9, 3.9810670659332438`*^9}, {
   3.981101597829097*^9, 3.981101603540371*^9}, 3.98110648466285*^9},
 CellLabel->"In[65]:=",ExpressionUUID->"12900c1a-e514-421d-b088-892d1ed5729b"],

