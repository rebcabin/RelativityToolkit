Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "\[Sigma]", ",", "\[Sigma]Vec", ",", "\[Sigma]Plus", ",", "id", ",", 
    "pauliMatrices"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]Vec", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", "3"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]Plus", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", "4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"id", "=", 
   RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]Vec", "[", 
    RowBox[{"[", "1", "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{"\[Sigma]", "[", "1", "]"}], "=", 
    RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]Vec", "[", 
    RowBox[{"[", "2", "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{"\[Sigma]", "[", "2", "]"}], "=", 
    RowBox[{"PauliMatrix", "[", "2", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]Vec", "[", 
    RowBox[{"[", "3", "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{"\[Sigma]", "[", "3", "]"}], "=", 
    RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]Plus", "=", 
   RowBox[{"Prepend", "[", 
    RowBox[{"\[Sigma]Vec", ",", "id"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pauliMatrices", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"\[Sigma]", "[", "k", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"Range", "[", "3", "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"MatrixForm", "/@", "pauliMatrices"}], 
