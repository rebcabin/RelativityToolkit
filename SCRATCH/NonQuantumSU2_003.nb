Cell[TextData[{
 StyleBox["In quantum physics\[LongDash]topics for upcoming notebooks\
\[LongDash]the same",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1bce1427-769a-4d3e-9ecd-128020684a88"],
 " ",
 StyleBox["operators act on ",
  FontSlant->"Italic"],
 StyleBox["spinors",
  FontWeight->"Bold"],
 StyleBox[" by ",
  FontSlant->"Italic"],
 StyleBox["direct action",
  FontWeight->"Bold"],
 StyleBox[": ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
