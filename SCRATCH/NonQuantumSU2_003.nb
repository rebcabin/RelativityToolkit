Cell[CellGroupData[{

Cell["Conjugate Transpose", "Subsubsection",
 CellChangeTimes->{{3.981070214019638*^9, 
  3.9810702191708813`*^9}},ExpressionUUID->"90b09097-34c5-4d47-a987-\
c2bd584fce86"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "QDag", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"QDag", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Q", "[", "\[Theta]", "]"}], "\[ConjugateTranspose]"}], "//", 
     "ComplexExpand"}], ")"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9810412760653667`*^9, 3.981041289593161*^9}, {
  3.981070065636448*^9, 3.981070066130107*^9}, {3.981070240562377*^9, 
