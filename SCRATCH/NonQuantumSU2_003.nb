Cell[CellGroupData[{

Cell["Example", "Subsubsection",
 CellChangeTimes->{{3.9812144749386377`*^9, 
  3.9812144802657633`*^9}},ExpressionUUID->"4c4baaca-9c94-4f46-8896-\
5f7b04e2c4c2"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[Omega]", "\[RightVector]"], "=", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "\[Theta]"}], "}"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b79744d2-693c-42fe-bd65-1dc546cbcd9c"],
 " be a rotation of angle \[Theta] around the Z axis and let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0c918005-24b0-4aff-9c36-02dae9819a1a"],
 ". Then the following expression, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", ".", "r", ".", 
    RowBox[{"Q", "\[ConjugateTranspose]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ba499079-04cb-4981-9f2e-f2036d32acd6"],
 ", rotates the vector ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bef8356e-c294-42a8-bbee-a17caa945ac6"],
 " counterclockwise"
}], "Text",
 CellChangeTimes->{{3.981214713555958*^9, 3.981214820070723*^9}, {
  3.981217710420248*^9, 3.981217727223301*^9}, {3.98121779556915*^9, 
  3.9812178293984127`*^9}, {3.981218117393579*^9, 
  3.981218128818918*^9}},ExpressionUUID->"61263034-9555-4e22-9b66-\
a9ed264b8a3e"],

Cell[BoxData[
 FormBox[
  RowBox[{"Q", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"cos", 
      RowBox[{"(", 
       FractionBox["\[Theta]", "2"], ")"}], " ", 
      SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], " ", "-", "  ", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"sin", "(", 
       FractionBox["\[Theta]", "2"], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "\[Theta]"], 
        RowBox[{"(", GridBox[{
           {"\[Theta]", "0"},
           {"0", 
            RowBox[{"-", "\[Theta]"}]}
          }], ")"}]}], ")"}]}]}], " ", " ", " ", "=", "  ", 
    RowBox[{
     RowBox[{"cos", 
      RowBox[{"(", 
       FractionBox["\[Theta]", "2"], ")"}], " ", 
      SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], "  ", "-", "  ", 
     RowBox[{"\[ImaginaryI]", " ", "sin", 
      RowBox[{"(", 
       FractionBox["\[Theta]", "2"], ")"}], 
      SubscriptBox["\[Sigma]", "3"], " "}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9812148237963047`*^9, 3.9812148397628813`*^9}, {
  3.981214949053606*^9, 3.9812150072079287`*^9}, {3.981215071868788*^9, 
  3.9812150970569143`*^9}, {3.981217847569337*^9, 
  3.981217926685561*^9}},ExpressionUUID->"69e4890d-d126-4777-8292-\
2adc37a5c518"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Q", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", 
          FractionBox["\[Theta]", "2"], "]"}], "id"}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"Sin", "[", 
          FractionBox["\[Theta]", "2"], "]"}], 
         RowBox[{"\[Sigma]", "[", "3", "]"}]}]}]}], ",", 
      RowBox[{"r", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], ".", "\[Sigma]Vec"}]}]}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Q", ".", "r", ".", 
       RowBox[{"Q", "\[ConjugateTranspose]"}]}], "\[IndentingNewLine]", "//", 
      "Simplify"}], "//", "ComplexExpand"}]}], "]"}], "//", 
  "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.981215017127316*^9, 3.9812150624780273`*^9}, {
