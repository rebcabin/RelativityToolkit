  3.9799850327701817`*^9}},ExpressionUUID->"d5ff1776-f621-4e91-aa14-\
feac5f06b457"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "FormalSymbolQ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{
    RowBox[{"{", "FormalSymbolQ", "}"}], ",", "HoldAll"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FormalSymbolQ", "[", "s_", "]"}], ":=", 
   RowBox[{"\"\<Pure\>\"", "===", 
    RowBox[{"checkFormalIdentity", "[", "s", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.97983129262798*^9, 3.979831292629407*^9}, {
