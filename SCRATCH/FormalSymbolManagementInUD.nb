Cell[CellGroupData[{

Cell["Extended Formal Symbol Predicate", "Section",
 CellChangeTimes->{{3.979834927845302*^9, 
  3.97983494210434*^9}},ExpressionUUID->"97cb8253-6af2-40b1-8c61-\
cf96059fbc18"],

Cell[TextData[{
 "One must write ",
 StyleBox["FormalSymbolExtendedQ[Evaluate[x]]", "Input"],
 " to check the value of an expression x, even if that expression is just a \
symbol whose value is a constructed extended formal symbol. Many examples and \
tests below should make this clear."
}], "Text",
 CellChangeTimes->{{3.979834957921474*^9, 3.9798350069595547`*^9}, {
   3.979835303841235*^9, 3.9798353063541803`*^9}, {3.9798354418598337`*^9, 
   3.979835473805228*^9}, {3.979835748742161*^9, 3.979835758483131*^9}, {
   3.979846559847611*^9, 3.979846561161734*^9}, {3.979847786782716*^9, 
   3.979847826496071*^9}, {3.979906564952482*^9, 3.979906587669108*^9}, {
   3.979909775733593*^9, 3.97990979251554*^9}, {3.979985101622718*^9, 
   3.9799852323544064`*^9}, 
   3.980038084260037*^9},ExpressionUUID->"a9335b2c-5ab0-4447-8dcc-\
829465d5496f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "FormalSymbolExtendedQ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{
    RowBox[{"{", "FormalSymbolExtendedQ", "}"}], ",", "HoldAll"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FormalSymbolExtendedQ", "[", "s_", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"checkFormalIdentity", "[", "s", "]"}], 
     "===", "\"\<Extended\>\""}], "&&", 
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"Attributes", "[", "s", "]"}], ",", "Protected"}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.97983129262798*^9, 3.979831292629407*^9}, {
   3.979834058347336*^9, 3.979834062164982*^9}, {3.979834093625381*^9, 
   3.979834148050899*^9}, {3.979834244964264*^9, 3.9798343841097183`*^9}, {
   3.979834842063798*^9, 3.979834947692215*^9}, 3.9798477813525343`*^9, {
   3.979902006954969*^9, 3.979902016519998*^9}, {3.979902624040126*^9, 
   3.9799026597752323`*^9}, {3.9799064281535788`*^9, 3.979906433579461*^9}, {
   3.9799098347427473`*^9, 3.9799098353063087`*^9}, {3.979911024292821*^9, 
   3.979911046536448*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"170f2948-3462-4821-a2eb-adfacf2e2db2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Constructor for Extended Formal Symbols", "Section",
 CellChangeTimes->{{3.9798355989666853`*^9, 
  3.979835614160639*^9}},ExpressionUUID->"579ed213-b556-4487-b3e6-\
f1114523e372"],

Cell[TextData[{
 StyleBox["CreateExtendedFormal", "Input"],
 " creates a formal symbol, extended if there are non-formals after a leading \
formal, pure if there is only a single formal. I.e., it has no effect if \
given a pure formal. "
}], "Text",
 CellChangeTimes->{{3.9799852978965883`*^9, 3.9799853528141947`*^9}, {
  3.9800381374162693`*^9, 
  3.980038254697172*^9}},ExpressionUUID->"c33e86c4-ca41-4ef0-85eb-\
4a87cc44d3bb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "CreateExtendedFormal", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CreateExtendedFormal", "::", "invalidStructure"}], 
   "=", "\"\<The name '`1`' is invalid. Extended formals must start with \
exactly one formal character followed by non-formal characters.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "valid", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"valid", "[", "codes_", "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "codes", "]"}], ">", "0"}], "&&", 
       "\[IndentingNewLine]", 
       RowBox[{"formalCharCodeQ", "[", 
        RowBox[{"First", "[", "codes", "]"}], "]"}], "&&", 
       "\[IndentingNewLine]", 
       RowBox[{"!", 
        RowBox[{"AnyTrue", "[", 
         RowBox[{
          RowBox[{"Rest", "[", "codes", "]"}], ",", "formalCharCodeQ"}], 
         "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"CreateExtendedFormal", "[", "name_String", "]"}], ":=", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"valid", "[", 
         RowBox[{"ToCharacterCode", "[", "name", "]"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"s", "=", 
            RowBox[{"Symbol", "[", "name", "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Protect", "[", "s", "]"}], ";", "s"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"CreateExtendedFormal", "::", "invalidStructure"}], ",", 
            "name"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], ")"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"CreateExtendedFormal", "[", "sym_Symbol", "]"}], ":=", 
      "\[IndentingNewLine]", 
      RowBox[{"CreateExtendedFormal", "[", 
       RowBox[{"SymbolName", "[", "sym", "]"}], "]"}]}], ";"}]}], " ", "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.979831309843245*^9, 3.979831309844861*^9}, {
   3.9798324101787767`*^9, 3.97983241351702*^9}, {3.979833809880989*^9, 
   3.9798338246422453`*^9}, {3.979834393144713*^9, 3.979834497686458*^9}, 
   3.979847623037448*^9, {3.979849483680211*^9, 3.9798495296412363`*^9}, {
   3.9798496213767014`*^9, 3.979849644903208*^9}, {3.979849920947633*^9, 
   3.979849929144068*^9}, {3.979913178569553*^9, 3.979913181538827*^9}, 
   3.979913216584186*^9, {3.9799132668459873`*^9, 3.979913279226869*^9}, {
   3.979914401888062*^9, 3.9799144092267723`*^9}, {3.97991444132137*^9, 
   3.979914469232463*^9}, {3.979914511746018*^9, 3.979914756875458*^9}, {
   3.979914801924279*^9, 3.9799148381543703`*^9}, {3.979914978018551*^9, 
   3.979915233813293*^9}, {3.979915293594795*^9, 3.979915309885374*^9}, {
   3.9799153453672323`*^9, 3.979915372544112*^9}, {3.979915413910709*^9, 
   3.979915488326679*^9}, {3.979915521498885*^9, 3.9799155405204887`*^9}, {
   3.979915573994459*^9, 3.979915605370304*^9}, {3.979915655237997*^9, 
   3.979915667303711*^9}, {3.979915698073551*^9, 3.979915733771309*^9}, {
   3.979915775808319*^9, 3.979915948121965*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"fa292672-a799-4ba4-8c9c-820d1d20d560"]
}, Open  ]],

