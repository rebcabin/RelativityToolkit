Cell[TextData[{
 "Considering both ",
 StyleBox["Pure", "Input"],
 " (non-extended) and ",
 StyleBox["Extended", "Input"],
 " symbols, that makes 32 cases, plus a few corner cases. We don\
\[CloseCurlyQuote]t cover all the cases in the examples below, but we do \
point out some recommended usages and some delicate points."
}], "Text",
 CellChangeTimes->{{3.979918068522807*^9, 3.979918242148987*^9}, {
