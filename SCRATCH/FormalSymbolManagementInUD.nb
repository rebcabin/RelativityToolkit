  3.979861978341097*^9, 
  3.979861979650832*^9}},ExpressionUUID->"779d201b-029c-442d-b2cb-\
42e1e975e1ea"],

Cell[TextData[{
 "The visualization iterates through the integer ranges and queries ",
 StyleBox["formalCharCodeQ", "Input"],
 " for every number to decide whether it should be colored Green (Valid) or \
Red (Invalid)."
}], "Text",
 CellChangeTimes->{{3.9798359933313437`*^9, 3.9798360188792877`*^9}, {
   3.979846574114739*^9, 3.9798465782927217`*^9}, {3.979861363842334*^9, 
   3.979861369123272*^9}, {3.9798614203309317`*^9, 3.9798615319577427`*^9}, 
   3.979861978341097*^9, {3.979911350610853*^9, 3.9799113510471373`*^9}, 
   3.980033713862502*^9},ExpressionUUID->"7a3e503e-5d5f-4c46-8eca-\
a12accf986b3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "formalCharCodeQ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"formalCharCodeQ", "[", "code_Integer", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"63488", "<=", "code", "<=", "63556"}], ")"}], "||", 
     RowBox[{"(*", 
      RowBox[{"Latin", " ", "and", " ", "primary", " ", "math"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(", 
      RowBox[{"63558", "<=", "code", "<=", "63564"}], ")"}], "||", 
     RowBox[{"(*", 
      RowBox[{
      "Remaining", " ", "math", " ", "symbols", " ", "after", " ", "arrow"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(", 
      RowBox[{"63572", "<=", "code", "<=", "63596"}], ")"}], "||", 
     RowBox[{"(*", 
      RowBox[{"Lowercase", " ", "Greek"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(", 
      RowBox[{"63604", "<=", "code", "<=", "63605"}], ")"}], "||", 
     RowBox[{"(*", 
      RowBox[{"Mathematical", " ", "variants"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(", 
      RowBox[{"63608", "<=", "code", "<=", "63609"}], ")"}], "||", 
     RowBox[{"(*", 
      RowBox[{"Greek", " ", "variants"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(", 
      RowBox[{"63613", "<=", "code", "<=", "63622"}], ")"}], " ", "||", 
     RowBox[{"(", 
      RowBox[{"code", "===", "63626"}], ")"}], "||", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"Final", " ", "Greek", " ", "variants"}], " ", "&"}], " ", 
       "oddities"}], "*)"}], 
     RowBox[{"(", 
      RowBox[{"1024000", "<=", "code", "<=", "1024051"}], ")"}]}], ")"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "showCodes", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"showCodes", "[", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"codes", "=", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"63488", ",", "63626"}], "]"}], "~", "Join", "~", 
         RowBox[{"Range", "[", 
          RowBox[{"1024000", ",", "1024051"}], "]"}]}]}], ",", 
       RowBox[{"gcount", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"MapIndexed", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Column", "[", 
             RowBox[{
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Item", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"Symbol", "@", 
                    RowBox[{"FromCharacterCode", "@", "#1"}]}], ",", "20", ",",
                     "Bold"}], "]"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"Background", "->", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"formalCharCodeQ", "[", "#1", "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"gcount", "++"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Darker", "[", "StandardGreen", "]"}]}], ")"}], ",",
                     "\[IndentingNewLine]", 
                    RowBox[{"Darker", "[", "StandardRed", "]"}]}], "]"}]}]}], 
                 "]"}], ",", "\[IndentingNewLine]", 
                RowBox[{"Style", "[", 
                 RowBox[{"#1", ",", "6", ",", 
                  RowBox[{"GrayLevel", "[", "0.90", "]"}]}], "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"Style", "[", 
                 RowBox[{"gcount", ",", "10", ",", 
                  RowBox[{"GrayLevel", "[", "0.90", "]"}]}], "]"}]}], "}"}], ",",
               "\[IndentingNewLine]", 
              RowBox[{"Alignment", "->", "Center"}]}], "]"}], "&"}], ",", 
           "codes"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"UpTo", "[", "16", "]"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Frame", "->", "All"}], ",", 
       RowBox[{"ItemSize", "->", 
        RowBox[{"{", 
         RowBox[{"2.5", ",", "2.5"}], "}"}]}], ",", 
       RowBox[{"Background", "->", 
        RowBox[{"{", 
         RowBox[{"None", ",", "None", ",", 
          RowBox[{"{", "}"}]}], "}"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"showCodes", "[", "]"}]}], "Input",
 CellChangeTimes->{{3.97983129262798*^9, 3.979831292629407*^9}, {
   3.979834058347336*^9, 3.979834062164982*^9}, {3.979834093625381*^9, 
