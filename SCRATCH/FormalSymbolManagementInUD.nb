Cell[TextData[{
 "They live in a few ranges of character codes high in the Unicode sphere. ",
 StyleBox["showCodes", "Input"],
 ", below, generates a visual map of the character codes used by Wolfram for \
formal symbols. "
}], "Text",
 CellChangeTimes->{{3.980037801016927*^9, 
  3.9800378538386707`*^9}},ExpressionUUID->"5314c9a3-d1bf-4a23-8b53-\
adb960eff10b"],

Cell[TextData[{
 "Green Tiles: Valid, assigned formal symbols (e.g., ",
 StyleBox["\[FormalA]", "Input"],
 ", ",
 StyleBox["\[FormalAlpha]", "Input"],
 ")."
}], "Item",
 CellChangeTimes->{{3.9798359933313437`*^9, 3.9798360188792877`*^9}, {
  3.979846574114739*^9, 3.9798465782927217`*^9}, {3.979861363842334*^9, 
