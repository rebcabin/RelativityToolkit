Cell[CellGroupData[{

Cell["Check Formal Identity", "Section",
 CellChangeTimes->{{3.979834745961418*^9, 3.9798347492483883`*^9}, {
  3.98003790197438*^9, 
  3.980037906933531*^9}},ExpressionUUID->"0a05b8d9-3ab5-4604-9cc4-\
7924a04c3b27"],

Cell[TextData[{
 StyleBox["checkFormalIdentity", "Input"],
 " is a low-level, polymorphic interrogator of the structure of an input ",
 StyleBox["Symbol", "Input"],
 " or ",
 StyleBox["String", "Input"],
 ". It does not evaluate its input. It returns one of ",
 StyleBox["\[OpenCurlyDoubleQuote]Pure\[CloseCurlyDoubleQuote]", "Input"],
 ", ",
 StyleBox["\[OpenCurlyDoubleQuote]Extended\[CloseCurlyDoubleQuote]", 
  "Input"],
 ", or ",
 StyleBox["\[OpenCurlyDoubleQuote]Neither\[CloseCurlyDoubleQuote]", "Input"],
 ". It fails loudly (with ",
 StyleBox["$Failed", "Input"],
 ") on any other type of input."
}], "Text",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862124507115*^9}, {
  3.979862362746785*^9, 3.979862364373609*^9}, {3.979906974629003*^9, 
  3.9799069978092117`*^9}, {3.979907511770637*^9, 3.9799075299990807`*^9}, {
  3.979911076887458*^9, 3.979911209641465*^9}, {3.979911479765469*^9, 
  3.979911482810169*^9}},ExpressionUUID->"1d6373e2-4116-404f-97c4-\
57709c360e80"],

Cell[TextData[{
 StyleBox["checkFormalIdentity", "Input"],
 " has a two-layer defense against evaluation, critical when inspecting \
symbols that might have values assigned."
}], "Text",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862103097492*^9}, {
  3.979862153113353*^9, 3.979862184193384*^9}, {3.9799070055766497`*^9, 
  3.979907016592517*^9}, {3.979911382956222*^9, 3.97991139537812*^9}, {
  3.9800379413204412`*^9, 
  3.980037952006531*^9}},ExpressionUUID->"44ab201a-9522-48e7-8f83-\
39ac1e81e88f"],

Cell[TextData[{
 StyleBox["SetAttributes[..., HoldFirst]", "Input"],
 ": stops the argument ",
 StyleBox["s", "Input"],
 " from evaluating before it enters the function. Without this, calling the \
function on a variable ",
 StyleBox["x", "Input"],
 " would pass the value of ",
 StyleBox["x", "Input"],
 " instead of ",
 StyleBox["x", "Input"],
 "."
}], "ItemNumbered",
 CellChangeTimes->{{3.979862092080511*^9, 3.9798621043362722`*^9}, {
  3.979862186669518*^9, 3.97986223217249*^9}, {3.979907045353004*^9, 
  3.979907050861244*^9}},ExpressionUUID->"d89a3b4a-84d6-43ee-a0e5-\
e963dca22dea"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Unevaluated[...]", "Input"],
 ": Even inside a ",
 StyleBox["HoldFirst", "Input"],
 " function, passing ",
 StyleBox["s", "Input"],
 " to certain other functions can trigger evaluation. Wrapping occurrences of \
",
 StyleBox["s", "Input"],
 " in ",
 StyleBox["Unevaluated", "Input"],
 ", e.g., ",
 StyleBox["SymbolName[Unevaluated[s]]", "Input"],
 ", guarantees that the called function operates on a symbol itself, not its \
value. ",
 StyleBox["Unevaluated", "Input"],
 " has no effect on a ",
 StyleBox["String", "Input"],
 "."
}], "ItemNumbered",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862105935421*^9}, {
  3.9798622433201838`*^9, 3.979862331583283*^9}, {3.9799070574493923`*^9, 
  3.9799070967296677`*^9}, {3.9799849124963093`*^9, 3.9799849472876253`*^9}, {
  3.9800379762850523`*^9, 
  3.980038003361465*^9}},ExpressionUUID->"e0569b52-4b76-4003-8739-\
6ec6acef0019"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "checkFormalIdentity", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"checkFormalIdentity", ",", "HoldFirst"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"checkFormalIdentity", "[", 
    RowBox[{"s", ":", 
     RowBox[{"(", 
      RowBox[{"_Symbol", "|", "_String"}], ")"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", "codes"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"name", "=", 
       RowBox[{"Which", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "===", "Symbol"}], ",", 
         RowBox[{"SymbolName", "[", 
          RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
           "if", " ", "input", " ", "is", " ", "a", " ", "literal", " ", 
            "string"}], ",", " ", 
           RowBox[{"not", " ", "a", " ", "symbol"}]}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"StringQ", "[", 
          RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], ",", "s", ",", 
         "\[IndentingNewLine]", "True", ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"codes", "=", 
       RowBox[{"ToCharacterCode", "[", "name", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "codes", "]"}], "==", "1"}], "&&", 
          RowBox[{"formalCharCodeQ", "[", 
           RowBox[{"First", "[", "codes", "]"}], "]"}]}], ")"}], ",", 
        " ", "\"\<Pure\>\"", ",", "\[IndentingNewLine]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "codes", "]"}], ">", "0"}], "&&", 
          RowBox[{"formalCharCodeQ", "[", 
           RowBox[{"First", "[", "codes", "]"}], "]"}]}], ")"}], 
        ",", "\"\<Extended\>\"", ",", "\[IndentingNewLine]", "True", 
        ",", "\"\<Neither\>\""}], "\[IndentingNewLine]", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checkFormalIdentity", "[", "___", "]"}], ":=", "$Failed"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.97983129262798*^9, 3.979831292629407*^9}, {
   3.979834058347336*^9, 3.979834062164982*^9}, {3.979834093625381*^9, 
   3.979834148050899*^9}, {3.979834244964264*^9, 3.9798343841097183`*^9}, {
   3.979834842063798*^9, 3.97983486372563*^9}, 3.979862471211678*^9, {
   3.979901932552689*^9, 3.979901988586347*^9}, {3.979906867131504*^9, 
   3.979906881040251*^9}, 3.9799095536995487`*^9, {3.97991037778579*^9, 
   3.9799103910784683`*^9}, 3.979910543701062*^9, {3.9799106999337387`*^9, 
   3.979910701069354*^9}, 3.979910762777516*^9, {3.979910842233569*^9, 
   3.9799109632112494`*^9}, {3.9799112586248198`*^9, 3.979911281970804*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"1e710411-6e34-4cf2-9f56-89a8dd97fb8b"]
}, Open  ]],

