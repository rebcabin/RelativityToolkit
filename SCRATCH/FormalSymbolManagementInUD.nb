Cell[CellGroupData[{

Cell["Symbol Inspector", "Section",
 CellChangeTimes->{{3.979835875548971*^9, 
  3.97983587910151*^9}},ExpressionUUID->"ee176073-85ec-4039-84f8-\
c6e1e964d611"],

Cell[CellGroupData[{

Cell["Design & internal Logic", "Subsection",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860030986598*^9}, {
  3.9798600734064503`*^9, 
  3.9798600790301847`*^9}},ExpressionUUID->"bc40c5f5-acd6-4c41-9083-\
e08208808d67"],

Cell[CellGroupData[{

Cell["Purpose", "Subsubsection",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860032690536*^9}, {
  3.979860083969038*^9, 
  3.979860093989253*^9}},ExpressionUUID->"50269add-2851-43f3-8f5c-\
761a6e02dceb"],

Cell[TextData[{
 "For displaying and debugging formal symbols, including our extended formal \
symbols, ",
 StyleBox["SymbolInspector", "Input"],
 " exposes the internal properties of any symbol, indirecting when necessary \
when its input evaluates to the formal symbol we want, metaphorically \
treating the input as a ",
 StyleBox["pointer",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.979978289458118*^9, 3.979978512883638*^9}, {
  3.980038557169346*^9, 3.980038557578972*^9}, {3.980038592195528*^9, 
  3.980038605801536*^9}},ExpressionUUID->"d615a116-31ca-49d3-b099-\
d4db6c1f6652"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Usage", "Subsubsection",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860034501046*^9}, {
  3.9798601808566227`*^9, 
  3.979860192276836*^9}},ExpressionUUID->"e87d61e2-25b8-4870-a99a-\
5c50cb5cc853"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SymbolInspector", "[", "symbolLiteral", "]"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "or", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"SymbolInspector", "[", 
  RowBox[{"Evaluate", "[", "expressionWithValue", "]"}], "]"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.979860269148712*^9, 3.979860312364558*^9}, {
  3.979916315405303*^9, 3.979916316792787*^9}, {3.9799163618483143`*^9, 
  3.979916370026703*^9}, {3.9800386111647367`*^9, 
  3.9800386119271517`*^9}},ExpressionUUID->"02db1efa-7132-4956-b8cc-\
45421ffcab0b"],

Cell[TextData[{
 StyleBox["On a Literal: ", "Item"],
 StyleBox["SymbolInspector[x]", "Input"],
 StyleBox[" inspects ", "Item"],
 StyleBox["x", "Input"],
 StyleBox[".", "Item"]
}], "Item",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860035725148*^9}, {
   3.97986024275636*^9, 3.97986025009196*^9}, {3.9798603315039463`*^9, 
   3.979860381695609*^9}, 
   3.979916297696314*^9},ExpressionUUID->"1c8f0cfc-00d2-4344-9363-\
68258c537cb4"],

Cell[TextData[{
 StyleBox["On an Expression: e.g., ", "Item"],
 StyleBox["SymbolInspector[var]", "Input"],
 StyleBox[", evaluates the expression ", "Item"],
 StyleBox["var", "Input"],
 StyleBox[" first, then inspects the resulting value, which may be the value \
we want.", "Item"]
}], "Item",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860035725148*^9}, {
  3.97986024275636*^9, 3.97986025009196*^9}, {3.9798603315039463`*^9, 
  3.979860381695609*^9}, {3.979977629477436*^9, 3.979977646119022*^9}, {
  3.979977694991417*^9, 3.9799777089947357`*^9}, {3.979977746564989*^9, 
  3.979977756893717*^9}, {3.979977813407652*^9, 3.979977825366872*^9}, {
  3.980038626019939*^9, 
  3.980038627409636*^9}},ExpressionUUID->"0622cd91-32d1-4c3f-97cb-\
16380c58a458"]
}, Open  ]],

