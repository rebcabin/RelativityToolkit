Cell[CellGroupData[{

Cell["Mechanics", "Subsubsection",
 CellChangeTimes->{{3.979860017533279*^9, 3.97986003687854*^9}, {
  3.9798603897876663`*^9, 3.979860398795208*^9}, {3.9799786258004*^9, 
  3.979978630734541*^9}},ExpressionUUID->"b31943dd-584b-46bb-917f-\
514690352be0"],

Cell[TextData[{
 StyleBox["SymbolInspector", "Input"],
 " relies on three metaprogramming features:"
}], "Text",
 CellChangeTimes->{{3.979860017533279*^9, 3.97986003687854*^9}, {
   3.9798603897876663`*^9, 3.979860417035342*^9}, 3.979978646002995*^9, {
   3.979978702686989*^9, 
   3.9799787172051153`*^9}},ExpressionUUID->"2ff86b3f-72d8-4d03-a40f-\
4d4d5292a254"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["SetAttributes[..., HoldAll]", "Input"]], \
"ItemNumbered",
 CellChangeTimes->{{3.979860017533279*^9, 3.9798600414297037`*^9}, {
   3.979860420874848*^9, 3.979860673403614*^9}, 
   3.9798608525350857`*^9},ExpressionUUID->"7d90b732-016b-4109-a8f6-\
f070ca1efac7"],

Cell[TextData[{
 StyleBox["Problem",
  FontWeight->"Bold"],
 ": Normally, if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "5"}], TraditionalForm]],ExpressionUUID->
  "7c6d038a-d65b-4c59-9c38-3d42ba37d90e"],
 ", typing ",
 StyleBox["f[x]", "Input"],
 " evaluates to ",
 StyleBox["f[5]", "Input"],
 ": ",
 StyleBox["x", "Input"],
 " is evaluated before being \[OpenCurlyDoubleQuote]sent\
\[CloseCurlyDoubleQuote] into ",
 StyleBox["f", "Input"],
 ". "
}], "ItemParagraph",
 CellChangeTimes->{{3.979860017533279*^9, 3.9798600414297037`*^9}, {
   3.979860420874848*^9, 3.979860673403614*^9}, 3.9798609863533897`*^9, {
   3.979978663935966*^9, 
   3.979978673186104*^9}},ExpressionUUID->"b044aad6-26ce-4f49-97e6-\
8529141cdc9b"],

Cell[TextData[{
 StyleBox["Solution",
  FontWeight->"Bold"],
 ": ",
 StyleBox["HoldAll", "Input"],
 " prevents ",
 StyleBox["x", "Input"],
 " from evaluating, lettng the raw symbol ",
 StyleBox["x", "Input"],
 " through for deeper inspection."
}], "ItemParagraph",
 CellChangeTimes->{{3.979860017533279*^9, 3.9798600414297037`*^9}, {
   3.979860420874848*^9, 3.979860673403614*^9}, 3.979978681945063*^9, 
   3.980038684541888*^9},ExpressionUUID->"6f142f9d-8c7f-454b-b7cd-\
fca537c4d3f9"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["OwnValues", "Input"],
 " Introspection"
}], "ItemNumbered",
 CellChangeTimes->{{3.979860017533279*^9, 3.9798600454963627`*^9}, {
  3.979860652487898*^9, 
  3.9798608510129547`*^9}},ExpressionUUID->"7cb99037-6321-4469-94d0-\
e2571d1b7497"],

Cell[TextData[{
 StyleBox["Problem",
  FontWeight->"Bold"],
 ": In Mathematica, variables normally store definitions (if any) in ",
 StyleBox["OwnValues", "Input"],
 ", whereas functions (",
 StyleBox["f[x_]\[NonBreakingSpace]:=\[NonBreakingSpace]x", "Input"],
 ") store definitions in ",
 StyleBox["DownValues", "Input"],
 ". "
}], "ItemParagraph",
 CellChangeTimes->{{3.979860017533279*^9, 3.9798600454963627`*^9}, {
   3.979860652487898*^9, 3.979860823351594*^9}, {3.9798608889592943`*^9, 
   3.979860914386208*^9}, 3.979860984642659*^9, {3.980038700222991*^9, 
   3.980038780497346*^9}},ExpressionUUID->"27a6ab82-f03e-4104-ab0a-\
f25bfb4a8e64"],

Cell[TextData[{
 StyleBox["Solution",
  FontWeight->"Bold"],
 ": To detect whether ",
 StyleBox["x", "Input"],
 " is a pointer to another symbol, interrogate ",
 StyleBox["OwnValues[x]", "Input"],
 ". If we find a rule like ",
 StyleBox["{x\[NonBreakingSpace]:>\[NonBreakingSpace]y}", "Input"],
 ", we know ",
 StyleBox["x", "Input"],
 " is a pointer."
}], "ItemParagraph",
 CellChangeTimes->{{3.979860017533279*^9, 3.9798600454963627`*^9}, {
  3.979860652487898*^9, 3.979860823351594*^9}, {3.9798608889592943`*^9, 
  3.979860914386208*^9}, {3.9799787332483397`*^9, 
  3.97997876499008*^9}},ExpressionUUID->"11526999-ef68-4f50-8665-\
d470d7b06f3f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\[OpenCurlyDoubleQuote]Safe Peek\[CloseCurlyDoubleQuote] Pattern", \
"ItemNumbered",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860049115114*^9}, {
  3.9798608369781837`*^9, 
  3.979860848257024*^9}},ExpressionUUID->"d726c670-4f7f-4e70-b8eb-\
289aff36db6d"],

Cell[TextData[{
 "Code: ",
 StyleBox["ReleaseHold[Replace[Hold[s],\[NonBreakingSpace]sym_Symbol\
\[NonBreakingSpace]:>\[NonBreakingSpace]OwnValues[sym],\[NonBreakingSpace]{1}]\
]", "Input"]
}], "ItemParagraph",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860049115114*^9}, {
  3.9798608369781837`*^9, 3.97986084627289*^9}, {3.979860930098592*^9, 
  3.979860956902413*^9}, {3.980038807410306*^9, 
  3.98003881577841*^9}},ExpressionUUID->"6df36928-4053-472a-b4d3-\
a293663acb34"],

Cell[TextData[{
 "This specific idiom extracts a symbol\[CloseCurlyQuote]s ",
 StyleBox["OwnValue", "Input"],
 " without letting the symbol evaluate."
}], "ItemParagraph",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860049115114*^9}, {
  3.9798608369781837`*^9, 3.97986084627289*^9}, {3.979860930098592*^9, 
  3.979860972779063*^9}, {3.979978804714366*^9, 
  3.979978842870962*^9}},ExpressionUUID->"49e86dc7-0b5e-4f52-9cb0-\
22cdd30b6d5d"],

Cell[TextData[{
 StyleBox["Hold[s]", "Input"],
 " freezes the symbol."
}], "SubitemNumbered",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860049115114*^9}, {
  3.9798608369781837`*^9, 3.97986084627289*^9}, {3.979860930098592*^9, 
  3.9798609598528557`*^9}, {3.9798610034713573`*^9, 
  3.979861012463216*^9}},ExpressionUUID->"aa458837-fe2a-494a-8e6f-\
a39691e55493"],

Cell[TextData[{
 StyleBox["Replace", "Input"],
 " swaps the symbol for its ",
 StyleBox["OwnValues", "Input"],
 " rule list inside the hold."
}], "SubitemNumbered",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860049115114*^9}, {
  3.9798608369781837`*^9, 3.97986084627289*^9}, {3.979860930098592*^9, 
  3.979860960655725*^9}, {3.979861016523367*^9, 
  3.979861040376515*^9}},ExpressionUUID->"c3e4f7cc-505e-4551-93ca-\
b1507fb896fa"],

Cell[TextData[{
 StyleBox["ReleaseHold", "Input"],
 " lets us look at the rule list."
}], "SubitemNumbered",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860049115114*^9}, {
  3.9798608369781837`*^9, 3.97986084627289*^9}, {3.979860930098592*^9, 
  3.979860950589943*^9}, {3.979861045328641*^9, 
  3.979861053541428*^9}},ExpressionUUID->"1cd68e64-7711-42dd-b226-\
a2e74de571ca"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Learning", "Subsubsection",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860051726892*^9}, {
  3.979861063097209*^9, 3.97986106772685*^9}, {3.9800388368158493`*^9, 
  3.980038845735618*^9}},ExpressionUUID->"8849afc5-e657-434b-92d3-\
ec7b89943d45"],

Cell[TextData[{
 "Simply calling ",
 StyleBox["OwnValues[s]", "Input"],
 " inside a held function often evaluates ",
 StyleBox["s", "Input"],
 " too early. The idiom above was the only way we found to get the definition \
safely."
}], "Text",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860051726892*^9}, {
  3.979861063097209*^9, 3.97986112306455*^9}, {3.979978885297975*^9, 
  3.9799789036696043`*^9}},ExpressionUUID->"92e6f13f-93e2-499f-9931-\
47d18adabbd6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\[OpenCurlyDoubleQuote]Smart Pointer\[CloseCurlyDoubleQuote] Logic", \
"Subsubsection",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860061280345*^9}, {
  3.979861125838952*^9, 
  3.979861132236545*^9}},ExpressionUUID->"f70244d7-ae30-4c2d-8ba0-\
3b6cbb139d97"],

Cell[TextData[{
 "The distinctive feature of this tool is the ",
 StyleBox["isPointer", "Input"],
 " check."
}], "Text",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860061280345*^9}, {
  3.979861125838952*^9, 
  3.97986114727497*^9}},ExpressionUUID->"9af60af3-511d-49e9-a481-\
84e77ee68a97"],

Cell[TextData[{
 "Logic: ",
 StyleBox["MatchQ[eval,\[NonBreakingSpace]{(_\[NonBreakingSpace]:>\
\[NonBreakingSpace]_Symbol)}]", "Input"]
}], "Text",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860059311348*^9}, {
  3.979861152866125*^9, 3.9798611812755613`*^9}, {3.9800388565203123`*^9, 
  3.980038861652444*^9}},ExpressionUUID->"742d84b0-ffd6-4a9e-b790-\
3f4abbe48ff2"],

Cell["Behavior:", "Text",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860059311348*^9}, {
  3.979861152866125*^9, 
  3.979861188157975*^9}},ExpressionUUID->"baee57db-1706-4205-bf9a-\
a9745a7d5514"],

Cell[TextData[{
 "If ",
 StyleBox["x", "Input"],
 " is defined as ",
 StyleBox["x\[NonBreakingSpace]=\[NonBreakingSpace]y", "Input"],
 " where ",
 StyleBox["y", "Input"],
 " is a symbol, the Inspector detects this pattern."
}], "ItemNumbered",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860059311348*^9}, {
  3.979861152866125*^9, 3.979861159005665*^9}, {3.979861190827448*^9, 
  3.9798612151967087`*^9}, {3.980038865992766*^9, 
  3.9800388682295227`*^9}},ExpressionUUID->"06f19d90-e2fc-4c89-804f-\
ff61779918fe"],

Cell[CellGroupData[{

Cell[TextData[{
 "It \[OpenCurlyDoubleQuote]dereferences\[CloseCurlyDoubleQuote] the pointer, \
switching focus to ",
 StyleBox["y", "Input"],
 ", ensuring that inspecting a variable holding a formal symbol yields the \
properties of the formal symbol content, not the properties of the \
\[OpenCurlyDoubleQuote]pointer\[CloseCurlyDoubleQuote] variable (the \
container)."
}], "ItemNumbered",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860059311348*^9}, {
  3.979861152866125*^9, 3.979861160409718*^9}, {3.979861222185182*^9, 
  3.979861319786021*^9}, {3.9799789412791643`*^9, 
  3.9799789519493837`*^9}},ExpressionUUID->"9d9c6c23-2954-4a22-a51d-\
fdd26a040139"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "SymbolInspector", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"SymbolInspector", ",", "HoldAll"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SymbolInspector", "[", "s_Symbol", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ownVals", ",", "isPointer", ",", "heldSym"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "1.", " ", "Peek", " ", "inside", " ", "the", " ", "pointer", " ", 
       "safely"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ownVals", "=", 
       RowBox[{"OwnValues", "[", 
        RowBox[{"Unevaluated", "[", "s", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"isPointer", "=", 
       RowBox[{"MatchQ", "[", 
        RowBox[{"ownVals", ",", 
         RowBox[{"{", 
          RowBox[{"(", 
           RowBox[{"_", ":>", "_Symbol"}], ")"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"heldSym", "=", 
       RowBox[{"If", "[", 
        RowBox[{"isPointer", ",", "\[IndentingNewLine]", 
         RowBox[{"Hold", "[", 
          RowBox[{"Evaluate", "[", 
           RowBox[{"ownVals", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Hold", "[", "s", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"2.", " ", 
        RowBox[{"Use", " ", "'"}], 
        RowBox[{"With", "'"}], " ", 
        RowBox[{"to", " ", "'"}], "lock", " ", 
        RowBox[{"in", "'"}], " ", "the", " ", "symbol", " ", "we", " ", "are",
         " ", "actually", " ", "inspecting"}], "*)"}], "\[IndentingNewLine]", 
      
      RowBox[{"Replace", "[", 
       RowBox[{"heldSym", ",", 
        RowBox[{
         RowBox[{"Hold", "[", "sym_", "]"}], ":>", "\[IndentingNewLine]", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"name", "=", 
              RowBox[{"SymbolName", "[", 
               RowBox[{"Unevaluated", "[", "sym", "]"}], "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"attr", "=", 
              RowBox[{"Attributes", "[", 
               RowBox[{"Unevaluated", "[", "sym", "]"}], "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"ctx", "=", 
              RowBox[{"Context", "[", 
               RowBox[{"Unevaluated", "[", "sym", "]"}], "]"}]}]}], "}"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"Grid", "[", 
            RowBox[{
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<Property\>\"", ",", "\"\<Value\>\""}], "}"}], ",",
                "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"\"\<Literal Symbol\>\"", ",", 
                 RowBox[{"HoldForm", "[", "s", "]"}]}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"\"\<Own Value\>\"", ",", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"ownVals", "===", 
                    RowBox[{"{", "}"}]}], ",", "\"\<None (Undefined)\>\"", ",",
                    "s"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"\"\<Points To\>\"", ",", 
                 RowBox[{"If", "[", 
                  RowBox[{
                  "isPointer", ",", "sym", ",", "\"\<N/A (Literal)\>\""}], 
                  "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"\"\<Context\>\"", ",", "ctx"}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"\"\<Character Codes\>\"", ",", 
                 RowBox[{"ToCharacterCode", "[", "name", "]"}]}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"\"\<Classification\>\"", ",", 
                 RowBox[{"Which", "[", "\[IndentingNewLine]", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                    RowBox[{"don", "'"}], "t", " ", "forget", " ", "to", " ", 
                    
                    RowBox[{"Evaluate", "!"}]}], " ", "*)"}], 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"FormalSymbolQ", "[", 
                    RowBox[{"Unevaluated", "[", "sym", "]"}], "]"}], 
                   ",", "\"\<Pure System\>\"", ",", "\[IndentingNewLine]", 
                   RowBox[{"FormalSymbolExtendedQ", "[", 
                    RowBox[{"Unevaluated", "[", "sym", "]"}], "]"}], 
                   ",", "\"\<Extended\>\"", ",", "\[IndentingNewLine]", 
                   "True", ",", "\"\<User\>\""}], "]"}]}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"\"\<Attributes\>\"", ",", "attr"}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"\"\<Definition Type\>\"", ",", 
                 RowBox[{"Which", "[", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"ownVals", "=!=", 
                    RowBox[{"{", "}"}]}], ",", "\"\<OwnValue (Variable)\>\"", 
                   ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"DownValues", "[", 
                    RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "=!=", 
                    RowBox[{"{", "}"}]}], ",", "\"\<DownValue (Function)\>\"",
                    ",", "\[IndentingNewLine]", "True", 
                   ",", "\"\<No Definitions\>\""}], "]"}]}], "}"}]}], "}"}], ",",
              "\[IndentingNewLine]", 
             RowBox[{"Frame", "->", "All"}], ",", "\[IndentingNewLine]", 
             RowBox[{"Alignment", "->", "Left"}], ",", "\[IndentingNewLine]", 
             
             RowBox[{"Background", "->", 
              RowBox[{"{", 
               RowBox[{"None", ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"GrayLevel", "[", "0.3", "]"}], ",", "Black"}], 
                 "}"}]}], "}"}]}]}], "]"}]}], "]"}]}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SymbolInspector", "[", "___", "]"}], ":=", "$Failed"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.979832326470748*^9, 3.97983235532222*^9}, 
   3.9798325255269938`*^9, {3.979834539352584*^9, 3.9798346019967947`*^9}, {
   3.979846386748458*^9, 3.979846394623047*^9}, 3.979847659710123*^9, {
   3.979851383720356*^9, 3.97985141997698*^9}, {3.979916666575302*^9, 
   3.979916875464506*^9}, {3.979916908303286*^9, 3.979916916423299*^9}, {
   3.979916951208444*^9, 3.979916987585394*^9}, {3.979917068427816*^9, 
   3.9799171342171793`*^9}, {3.9799172543258247`*^9, 
   3.9799172596361732`*^9}, {3.9799175830606127`*^9, 3.979917624116292*^9}, {
   3.979918319524375*^9, 3.979918336457809*^9}, {3.9799185765400333`*^9, 
   3.9799185936542664`*^9}, {3.979918737620038*^9, 3.979918742464387*^9}, 
   3.979918774760708*^9, {3.9799188102103977`*^9, 3.979918817073344*^9}, {
   3.979918854742875*^9, 3.97991885554783*^9}, {3.979919197057856*^9, 
   3.979919197500108*^9}, {3.9799192296459093`*^9, 3.979919230176229*^9}, {
   3.979919282288006*^9, 3.97991937607752*^9}, {3.979919447971368*^9, 
   3.9799195712259693`*^9}, {3.979919608477872*^9, 3.979919653622184*^9}, {
   3.9799198768359013`*^9, 3.979919943056279*^9}, {3.9799232784620237`*^9, 
   3.9799232837584047`*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"275e4486-8c89-4557-a36b-bebcf71cc3fe"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

