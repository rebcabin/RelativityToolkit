Cell[TextData[{
 "DON\[CloseCurlyQuote]T DO THIS: A Module will let you have the illusion of \
assigning a value to a formal symbol, but the symbol won\[CloseCurlyQuote]t \
be any kind of formal. It\[CloseCurlyQuote]s a ",
 StyleBox["User", "Input"],
 " symbol rather than ",
 StyleBox["Pure Formal", "Input"],
 " or ",
 StyleBox["Extended", "Input"],
 ", the only alternatives to ",
 StyleBox["User", "Input"],
 ". The character codes are long because the symbols \
\[OpenCurlyDoubleQuote]real\[CloseCurlyDoubleQuote] name is \[FormalI] \
followed by some random-looking numbers (actually internal counters and \
dollar signs and what not)."
}], "Text",
 CellChangeTimes->{{3.979918506403833*^9, 3.9799185296603823`*^9}, {
  3.979918671523273*^9, 3.979918681381328*^9}, {3.979920069195222*^9, 
