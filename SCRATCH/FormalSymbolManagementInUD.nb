29b718c14a18"],

Cell["\<\
This has been added to the regression suite of the Relativity Toolkit.\
\>", "Text",
 CellChangeTimes->{{3.980038271624481*^9, 3.980038293638879*^9}, {
  3.980038350074872*^9, 
  3.98003835638418*^9}},ExpressionUUID->"0f859cb1-0feb-4062-9e02-\
6f4dd31c3eb0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "SETUP", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Protect", "[", "\[FormalI]123", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"protectedDummy", "=", 
     RowBox[{"CreateExtendedFormal", "[", "\"\<\[FormalJ]888\>\"", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CreateExtendedFormal", "[", "\[FormalI]999", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<--- (1) Identity & Built-in Protection ---\>\"", "]"}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "0"}], ":", " ", 
     RowBox[{"low", "-", 
      RowBox[{"level", " ", "checks"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertEqual", "[", 
     RowBox[{
      RowBox[{"checkFormalIdentity", "[", "\[FormalI]", "]"}], 
      ",", "\"\<Pure\>\"", ",", "\"\<0.1. input: formal symbol literal\>\""}],
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AssertEqual", "[", 
     RowBox[{
      RowBox[{"checkFormalIdentity", "[", "\"\<\[FormalI]\>\"", "]"}], 
      ",", "\"\<Pure\>\"", ",", "\"\<0.2. input: formal symbol string\>\""}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AssertEqual", "[", 
     RowBox[{
      RowBox[{"checkFormalIdentity", "[", "\[FormalJ]1234", "]"}], 
      ",", "\"\<Extended\>\"", 
      ",", "\"\<0.3. input: extended symbol literal\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AssertEqual", "[", 
     RowBox[{
      RowBox[{"checkFormalIdentity", "[", "\"\<\[FormalJ]2345\>\"", "]"}], 
      ",", "\"\<Extended\>\"", 
      ",", "\"\<0.4. input: extended symbol string\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AssertEqual", "[", 
     RowBox[{
      RowBox[{"checkFormalIdentity", "[", "foo", "]"}], ",", "\"\<Neither\>\"",
       ",", "\"\<0.5. non-formal symbol literal\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AssertEqual", "[", 
     RowBox[{
      RowBox[{"checkFormalIdentity", "[", "\"\<foo\>\"", "]"}], 
      ",", "\"\<Neither\>\"", ",", "\"\<0.6. non-formal string\>\""}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"AssertEqual", "[", 
     RowBox[{
      RowBox[{"checkFormalIdentity", "[", "\"\<\>\"", "]"}], 
      ",", "\"\<Neither\>\"", ",", "\"\<0.7. non-formal empty string\>\""}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AssertEqual", "[", 
     RowBox[{
      RowBox[{"checkFormalIdentity", "[", "]"}], ",", "$Failed", 
      ",", "\"\<0.8. empty string\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AssertEqual", "[", 
     RowBox[{
      RowBox[{"checkFormalIdentity", "[", "42", "]"}], ",", "$Failed", 
      ",", "\"\<0.9. integer\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "1"}], ":", " ", 
     RowBox[{"System", " ", "Protection"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"AssertProtected", "[", 
     RowBox[{
     "\[FormalI]", 
      ",", "\"\<1. Identity: Built-in \[FormalI] is Protected\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "2"}], ":", " ", 
     RowBox[{"Latin", " ", "Identification"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertTrue", "[", 
     RowBox[{
      RowBox[{"FormalSymbolQ", "[", "\[FormalI]", "]"}], 
      ",", "\"\<2. Identity: Latin Pure Formal recognized\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "3"}], ":", " ", 
     RowBox[{"Greek", " ", "Identification"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"AssertTrue", "[", 
     RowBox[{
      RowBox[{"FormalSymbolQ", "[", "\[FormalAlpha]", "]"}], 
      ",", "\"\<3. Identity: Greek Pure Formal recognized\>\""}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<--- (2) Pointer & Construction Logic ---\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "4"}], ":", " ", 
     RowBox[{"Pointer", " ", "Resolution", " ", 
      RowBox[{"(", 
       RowBox[{"MUST", " ", "EVALUATE", " ", "THE", " ", "POINTER"}], 
       ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertTrue", "[", 
     RowBox[{
      RowBox[{"FormalSymbolExtendedQ", "[", 
       RowBox[{"Evaluate", "@", "protectedDummy"}], "]"}], ",", 
      "\[IndentingNewLine]", "\"\<4. Pointer: Variable holding symbol \
recognized\>\""}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "5"}], ":", " ", 
     RowBox[{"Target", " ", "is", " ", "Protected"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"AssertProtected", "[", 
     RowBox[{
     "protectedDummy", 
      ",", "\"\<5. Pointer: Target symbol \[FormalJ]888 is Protected\>\""}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "6"}], ":", " ", 
     RowBox[{"Negative", " ", "Constructor", " ", "Check"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertMatchQ", "[", 
     RowBox[{
      RowBox[{"Quiet", "[", 
       RowBox[{"CreateExtendedFormal", "[", "\"\<\>\"", "]"}], "]"}], ",", 
      "$Failed", ",", 
      "\[IndentingNewLine]", "\"\<6. Constructor: Rejects empty string\>\""}],
      "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<--- (3) Structural Variety & Boundaries ---\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "7"}], ":", " ", 
     RowBox[{"Numbered", " ", "Dummies", " ", 
      RowBox[{"(", 
       RowBox[{"Protected", " ", "it", " ", "in", " ", "Setup"}], ")"}]}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertTrue", "[", 
     RowBox[{
      RowBox[{"FormalSymbolExtendedQ", "[", "\[FormalI]123", "]"}], 
      ",", "\"\<7. Structure: Numbered dummy recognized\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "8"}], ":", " ", 
     RowBox[{"Reject", " ", "Prefixed", " ", "Formal", " ", "Symbols"}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"AssertFalse", "[", 
     RowBox[{
      RowBox[{"FormalSymbolExtendedQ", "[", "Partial\[FormalX]", "]"}], 
      ",", "\"\<8. Structure: Prefixed symbol rejected\>\""}], "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "9"}], ":", " ", 
     RowBox[{
     "Pure", " ", "System", " ", "is", " ", "NOT", " ", "Extended"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertFalse", "[", 
     RowBox[{
      RowBox[{"FormalSymbolExtendedQ", "[", "\[FormalI]", "]"}], 
      ",", "\"\<9. Boundary: Pure is NOT Extended\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "10"}], ":", " ", 
     RowBox[{
     "Extended", " ", "is", " ", "NOT", " ", "Pure", " ", "System"}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"AssertFalse", "[", 
     RowBox[{
      RowBox[{"FormalSymbolQ", "[", "\[FormalI]123", "]"}], 
      ",", "\"\<10. Boundary: Extended is NOT Pure\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"AssertFalse", "[", 
     RowBox[{
      RowBox[{"FormalSymbolQ", "[", "foo", "]"}], ",", 
      " ", "\"\<10.a. Boundary: Ordinary Symbol is not Pure System \
formal\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertFalse", "[", 
     RowBox[{
      RowBox[{"FormalSymbolQ", "[", "\"\<foo\>\"", "]"}], ",", 
      " ", "\"\<10.b. Boundary: String is not Pure System formal \
symbol\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertFalse", "[", 
     RowBox[{
      RowBox[{"FormalSymbolQ", "[", "42", "]"}], ",", 
      " ", "\"\<10.c. Boundary: Number is not Pure System formal \
symbol\>\""}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertFalse", "[", 
     RowBox[{
      RowBox[{"FormalSymbolExtendedQ", "[", "foo", "]"}], ",", 
      " ", "\"\<10.d. Boundary: Ordinary Symbol is not Extended formal\>\""}],
      "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertFalse", "[", 
     RowBox[{
      RowBox[{"FormalSymbolExtendedQ", "[", "\"\<foo\>\"", "]"}], ",", 
      " ", "\"\<10.e. Boundary: String is not Extended formal symbol\>\""}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertFalse", "[", 
     RowBox[{
      RowBox[{"FormalSymbolExtendedQ", "[", "42", "]"}], ",", 
      " ", "\"\<10.f. Boundary: Number is not Extended formal symbol\>\""}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<--- (4) Scoping Integrity (The 'Hold' Check) ---\>\"", 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "=", "10"}], ",", 
        RowBox[{"\[FormalI]", "=", "5"}], ",", 
        RowBox[{"\[FormalI]123", "=", "7"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Case", " ", "11"}], ":", " ", 
        RowBox[{
         RowBox[{"System", " ", "Symbol", " ", "Value"}], "-", 
         "Shielding"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"AssertTrue", "[", 
        RowBox[{
         RowBox[{"FormalSymbolQ", "[", "\[FormalI]", "]"}], ",", 
         "\[IndentingNewLine]", "\"\<11. Scoping: Built-in identity persists \
despite value 5\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Case", " ", "12"}], ":", " ", 
         RowBox[{"Extended", " ", "Symbol", " ", 
          RowBox[{"(", 
           RowBox[{"non", "-", "System"}], ")"}], " ", "is", " ", "not", " ", 
          "protected"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"AssertFalse", "[", 
        RowBox[{
         RowBox[{"FormalSymbolExtendedQ", "[", "\[FormalI]123", "]"}], ",", 
         "\[IndentingNewLine]", "\"\<12a. Non-system symbol not protected, \
thus not extended.\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"Protect", "[", "\[FormalI]123", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AssertTrue", "[", 
        RowBox[{
         RowBox[{"FormalSymbolExtendedQ", "[", "\[FormalI]123", "]"}], ",", 
         "\[IndentingNewLine]", "\"\<12b. Scoping: Extended identity after \
explicit protection\>\""}], "]"}]}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<--- (5) Constructor Validation ---\>\"", "]"}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "13"}], ":", " ", 
     RowBox[{"Reject", " ", "double", " ", "formal", " ", "prefix", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"e", ".", "g", "."}], ",", 
        RowBox[{"\[FormalK]\[FormalJ]", "..."}]}], ")"}]}]}], "*)"}], 
   RowBox[{
    RowBox[{"AssertMatchQ", "[", 
     RowBox[{
      RowBox[{"Quiet", "[", 
       RowBox[{
       "CreateExtendedFormal", "[", "\"\<\[FormalK]\[FormalJ]888\>\"", "]"}], 
       "]"}], ",", "$Failed", 
      ",", "\"\<13. Safety: Reject double formal prefix\>\""}], "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "14"}], ":", " ", 
     RowBox[{
     "Reject", " ", "plain", " ", "string", " ", "without", " ", "any", " ", 
      "formal", " ", "symbol"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertMatchQ", "[", 
     RowBox[{
      RowBox[{"Quiet", "[", 
       RowBox[{"CreateExtendedFormal", "[", "\"\<plainVar\>\"", "]"}], "]"}], 
      ",", "$Failed", ",", "\"\<14. Safety: Reject plain string\>\""}], "]"}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "15"}], ":", " ", 
     RowBox[{
     "Accept", " ", "valid", " ", "single", " ", "formal", " ", "prefix"}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"AssertTrue", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Head", "[", 
        RowBox[{"CreateExtendedFormal", "[", "\"\<\[FormalK]888\>\"", "]"}], 
        "]"}], "===", "Symbol"}], 
      ",", "\"\<15. Structure: Accept single formal prefix\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<--- (6) Start-Character Enforcement ---\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "16"}], ":", " ", 
     RowBox[{
      RowBox[{"Reject", "'"}], 
      RowBox[{"Buried", "'"}], " ", "Formal", " ", "Symbol", " ", 
      RowBox[{"(", 
       RowBox[{"e", ".", "g", ".", "var\[FormalI]123"}], ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"AssertFalse", "[", 
     RowBox[{
      RowBox[{"FormalSymbolExtendedQ", "[", "\"\<var\[FormalI]123\>\"", "]"}],
       ",", "\"\<16. Strictness: Reject buried formal (ExtendedQ -> \
False)\>\""}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertFalse", "[", 
     RowBox[{
      RowBox[{"FormalSymbolQ", "[", "\"\<var\[FormalI]123\>\"", "]"}], ",", 
      "\[IndentingNewLine]", "\"\<17. Strictness: Reject buried formal (PureQ \
-> False)\>\""}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "18"}], ":", " ", 
     RowBox[{
      RowBox[{"Reject", " ", "'"}], 
      RowBox[{"Suffix", "'"}], " ", "Extended", " ", "Symbol", " ", 
      RowBox[{"(", 
       RowBox[{"e", ".", "g", ".", "x\[FormalI]"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertFalse", "[", 
     RowBox[{
      RowBox[{"FormalSymbolExtendedQ", "[", "\"\<x\[FormalI]\>\"", "]"}], 
      ",", "\"\<18. Strictness: Reject suffix formal (ExtendedQ -> \
False)\>\""}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "18"}], ":", " ", 
     RowBox[{
      RowBox[{"Reject", "'"}], 
      RowBox[{"Suffix", "'"}], " ", "Pure", " ", "Symbol", " ", 
      RowBox[{"(", 
       RowBox[{"e", ".", "g", ".", "x\[FormalI]"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertFalse", "[", 
     RowBox[{
      RowBox[{"FormalSymbolQ", "[", "\"\<x\[FormalI]\>\"", "]"}], ",", 
      "\[IndentingNewLine]", "\"\<19. Strictness: Reject suffix formal (PureQ \
-> False)\>\""}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<--- (6) Polymorphism ---\>\"", "]"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"True", ":", " ", 
     RowBox[{
     "The", " ", "string", " ", "\"\<\[FormalI]\>\"", " ", "describes", " ", 
      "a", " ", "valid", " ", "Pure", " ", 
      RowBox[{"symbol", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertTrue", "[", 
     RowBox[{
      RowBox[{"FormalSymbolQ", "[", "\"\<\[FormalI]\>\"", "]"}], ",", 
      "\[IndentingNewLine]", "\"\<20. Polymorphism: String \\\"\[FormalI]\\\" \
is a Pure symbol\>\""}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"True", ":", " ", 
     RowBox[{
     "The", " ", "string", " ", "\"\<\[FormalI]\>\"", " ", "describes", " ", 
      "a", " ", "valid", " ", "Extended", " ", 
      RowBox[{"symbol", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AssertTrue", "[", 
     RowBox[{
      RowBox[{"FormalSymbolExtendedQ", "[", "\"\<\[FormalI]999\>\"", "]"}], ",",
       "\[IndentingNewLine]", "\"\<21. Polymorphism: String \\\"\[FormalI]999\
\\\" is an Extended symbol\>\""}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<--- TEST SUITE COMPLETE: 100% COVERAGE ---\>\"", "]"}],
     ";"}]}]}]], "Input",
