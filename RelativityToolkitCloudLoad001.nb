       RowBox[{"(*", 
        RowBox[{
        "Append", " ", "a", " ", "random", " ", "timestamp", " ", "to", " ", 
         "force", " ", "a", " ", "fresh", " ", "download"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"freshURL", "=", 
        RowBox[{"url", "<>", "\"\<?t=\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"Round", "[", 
           RowBox[{"AbsoluteTime", "[", "]"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Fetching fresh build from: \>\"", ",", "freshURL"}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Get", "[", "freshURL", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "VERIFICATION", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nLoaded Version: \>\"", ",", "RelativityToolkitVersion"}],
      "]"}], ";"}]}]}]], "Input",
