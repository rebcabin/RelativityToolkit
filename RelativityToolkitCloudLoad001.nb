  RowBox[{"(*", 
   RowBox[{"CACHE", " ", "BUSTER", " ", "LOADER"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"url", ",", "freshURL"}], "}"}], ",", 
      RowBox[{
       RowBox[{
       "url", "=", \
"\"\<https://raw.githubusercontent.com/rebcabin/RelativityToolkit/main/\
