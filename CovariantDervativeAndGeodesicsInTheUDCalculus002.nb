Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"DERIVATION", ":", 
    RowBox[{
    "Transformation", " ", "of", " ", "Ordinary", " ", "Derivative"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Goal", ":", 
    RowBox[{
    "Exact", " ", "match", " ", "of", " ", "textbook", " ", "Equation", " ", 
     "1.7"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"ap", ",", "bp", ",", "mu", ",", "nu"}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", 
     RowBox[{"SETUP", ":", 
      RowBox[{"Start", " ", "with", " ", "LHS"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LHS", "=", 
     RowBox[{"Partials", "[", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "ap", "]"}], "]"}], ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", 
     RowBox[{"SUBSTITUTE", ":", 
      RowBox[{"Vector", " ", "Transformation"}]}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"A", "^", "ap"}], "->", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"dx", "^", "ap"}], "/", 
        RowBox[{"dx", "^", "mu"}]}], ")"}], "*", 
      RowBox[{"A", "^", "mu"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"step1", "=", 
     RowBox[{"LHS", "/.", " ", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "idx_", "]"}], "]"}], ":>", 
       RowBox[{
        RowBox[{"Partials", "[", 
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "idx", "]"}], "]"}], ",", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "mu", "]"}], "]"}]}], "]"}], "*", 
        RowBox[{"A", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "mu", "]"}], "]"}]}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", 
     RowBox[{"EXPAND", ":", 
      RowBox[{"Product", " ", "Rule", " ", 
       RowBox[{"(", "Leibniz", ")"}]}]}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"d", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Jac", "*", "vec"}], ")"}], "/", 
       RowBox[{"dx", "'"}]}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"dJac", "/", 
         RowBox[{"dx", "'"}]}], ")"}], "*", "vec"}], "+", 
      RowBox[{"Jac", "*", 
       RowBox[{"(", 
        RowBox[{"dVec", "/", 
         RowBox[{"dx", "'"}]}], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"step2", "=", 
     RowBox[{"step1", "/.", " ", 
      RowBox[{
       RowBox[{"Partials", "[", 
        RowBox[{
         RowBox[{"f_", "*", "g_"}], ",", "v_"}], "]"}], ":>", 
       RowBox[{
        RowBox[{
         RowBox[{"Partials", "[", 
          RowBox[{"f", ",", "v"}], "]"}], "*", "g"}], "+", 
        RowBox[{"f", "*", 
         RowBox[{"Partials", "[", 
          RowBox[{"g", ",", "v"}], "]"}]}]}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", 
     RowBox[{"TRANSFORM", ":", 
      RowBox[{
      "Chain", " ", "Rule", " ", "for", " ", "the", " ", "Operator"}]}]}], 
    "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"d", "/", 
      RowBox[{"dx", "^", "bp"}]}], "->", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"dx", "^", "nu"}], "/", 
        RowBox[{"dx", "^", "bp"}]}], ")"}], "*", 
      RowBox[{"d", "/", 
       RowBox[{"dx", "^", "nu"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"step3", "=", 
     RowBox[{"step2", "/.", " ", 
      RowBox[{
       RowBox[{"Partials", "[", 
        RowBox[{"expr_", ",", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], ":>", 
       RowBox[{
        RowBox[{"Partials", "[", 
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "nu", "]"}], "]"}], ",", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], "*", 
        RowBox[{"Partials", "[", 
         RowBox[{"expr", ",", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "nu", "]"}], "]"}]}], 
         "]"}]}]}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", 
     RowBox[{"FORMATTING", ":", "REMOVED"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"The", " ", "engine", " ", 
     RowBox[{"(", 
      RowBox[{"RelativityToolkit", ".", "wl"}], ")"}], " ", "now", " ", 
     "handles", " ", "the", " ", 
     RowBox[{"d", "^", "2"}], " ", "formatting", " ", 
     RowBox[{"automatically", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"We", " ", "do", " ", "NOT", " ", "define", " ", "MakeBoxes", " ", 
     RowBox[{"here", "."}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"6.", " ", "RENAME"}], "&"}], " ", "DISPLAY"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Map", " ", "internal", " ", "dummies", " ", 
     RowBox[{"(", 
      RowBox[{"mu", ",", "nu"}], ")"}], " ", "to", " ", "textbook", " ", 
     "Greek", " ", 
     RowBox[{"(", 
      RowBox[{"alpha", ",", "beta"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"finalResult", "=", 
     RowBox[{"step3", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"mu", "->", "\[Alpha]"}], ",", 
        RowBox[{"nu", "->", "\[Beta]"}], ",", 
        RowBox[{"ap", "->", 
         RowBox[{"\[Alpha]", "'"}]}], ",", 
        RowBox[{"bp", "->", 
         RowBox[{"\[Beta]", "'"}]}]}], "}"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"TensorForm", "[", "finalResult", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.976921619663954*^9, 3.9769216468649807`*^9}},
 CellLabel->
