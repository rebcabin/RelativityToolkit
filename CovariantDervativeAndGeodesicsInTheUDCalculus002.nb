Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"Description\"\>",
      StripOnInput->False,
      FontSize->16,
      FontWeight->Bold], 
     StyleBox["\<\"Rendered Output\"\>",
      StripOnInput->False,
      FontSize->16,
      FontWeight->Bold]},
    {
     StyleBox["\<\"Generic Mixed Partial\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], "f"}], 
       RowBox[{
        RowBox[{"\[PartialD]", "x"}], 
        RowBox[{"\[PartialD]", "y"}]}]],
      DisplayForm]},
    {
     StyleBox["\<\"Coordinate Hessian (The 'Garbage Term')\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      FractionBox[
       RowBox[{
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], "x"}], 
        SuperscriptBox["", 
         SuperscriptBox["\[Alpha]", "\[Prime]",
          MultilineFunction->None]]}], 
       RowBox[{
        RowBox[{"\[PartialD]", "x"}], 
        SuperscriptBox["", "\[Alpha]"], 
        RowBox[{"\[PartialD]", "x"}], 
        SuperscriptBox["", "\[Beta]"]}]],
      DisplayForm]},
    {
     StyleBox["\<\"Nested in an Equation\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      RowBox[{"lhs", "\[Equal]", 
       FractionBox[
        RowBox[{
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], "A"}], 
         SuperscriptBox["", "\[Mu]"]}], 
        RowBox[{
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "\[Lambda]"], 
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "\[Nu]"]}]]}],
      DisplayForm]},
    {
     StyleBox["\<\"Multiplied by Jacobian\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], "x"}], 
         SuperscriptBox["", 
          SuperscriptBox["\[Alpha]", "\[Prime]",
           MultilineFunction->None]]}], 
        RowBox[{
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "\[Alpha]"], 
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "\[Beta]"]}]], " ", 
       FractionBox[
        RowBox[{
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "\[Beta]"]}], 
        RowBox[{
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", 
          SuperscriptBox["\[Beta]", "\[Prime]",
           MultilineFunction->None]]}]]}],
      DisplayForm]},
    {
     StyleBox["\<\"Comma Notation\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      SubscriptBox[
       RowBox[{"A", 
        SuperscriptBox["", "\[Mu]"]}], 
       RowBox[{",", "\[Nu]"}]],
      DisplayForm]},
    {
     StyleBox["\<\"Covariant Derivative (Abstract)\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      TagBox[
       SubscriptBox[
        RowBox[{"A", 
         SuperscriptBox["", "\[Mu]"]}], 
        RowBox[{";", "\[Nu]"}]],
       HoldForm],
      DisplayForm]},
    {
     StyleBox["\<\"Covariant Derivative (Expanded)\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      TagBox[
       RowBox[{
        SubscriptBox[
         RowBox[{"A", 
          SuperscriptBox["", "\[Mu]"]}], 
         RowBox[{",", "\[Nu]"}]], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"A", 
           SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{"\[Nu]", "\[Lambda]"}], "\[Mu]"]}]}],
       HoldForm],
      DisplayForm]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{2}}, "Rows" -> {{2}}}],
  "Grid"]], "Output",
 CellChangeTimes->{{3.976977191676097*^9, 3.976977207619853*^9}, 
   3.976977682992437*^9, 3.97697799066644*^9, 3.977009305663382*^9, 
   3.977012183454937*^9, 3.977069179415427*^9, 3.977070507399332*^9, {
   3.977095570013785*^9, 3.977095587880248*^9}},
