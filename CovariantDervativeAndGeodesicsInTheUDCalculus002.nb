Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"Step\"\>",
      StripOnInput->False,
      FontFamily->"Helvetica",
      FontSize->12,
      FontWeight->Bold], 
     StyleBox["\<\"Expression\"\>",
      StripOnInput->False,
      FontFamily->"Helvetica",
      FontSize->12,
      FontWeight->Bold], 
     StyleBox["\<\"Input\"\>",
      StripOnInput->False,
      FontFamily->"Helvetica",
      FontSize->12,
      FontWeight->Bold]},
    {"\<\"1. Start\"\>", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", 
        SubscriptBox["", "\[Nu]"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"B", 
        SuperscriptBox["", "\[Nu]"]}], 
       ")"}]}], "\<\"Input: A[\[ScriptCapitalD][\[Nu]]]B[\[ScriptCapitalU][\
\[Nu]]]\"\>"},
    {"\<\"2. Definition\"\>", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", 
        SuperscriptBox["", "\[Alpha]"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"B", 
        SuperscriptBox["", "\[Nu]"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"g", 
        SubscriptBox["", "\[Nu]"], 
        SubscriptBox["", "\[Alpha]"]}], 
       ")"}]}], "\<\"(g[\[ScriptCapitalD][\[Nu]],\[ScriptCapitalD][\[Alpha]]] \
A[\[ScriptCapitalU][\[Alpha]]]) B[\[ScriptCapitalU][\[Nu]]]\"\>"},
    {"\<\"3. Commute?\"\>", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", 
        SuperscriptBox["", "\[Alpha]"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"B", 
        SuperscriptBox["", "\[Nu]"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"g", 
        SubscriptBox["", "\[Nu]"], 
        SubscriptBox["", "\[Alpha]"]}], 
       ")"}]}], "\<\"A[\[ScriptCapitalU][\[Alpha]]] \
(g[\[ScriptCapitalD][\[Nu]],\[ScriptCapitalD][\[Alpha]]] B[\[ScriptCapitalU][\
\[Nu]]])\"\>"},
    {"\<\"4. Contract\"\>", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", 
        SubscriptBox["", "\[Nu]"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"B", 
        SuperscriptBox["", "\[Nu]"]}], 
       ")"}]}], "\<\"step2Term/. metricRules\"\>"},
    {"\<\"5. Equality?\"\>", "True", "\<\"lhs:4 === rhs:1\"\>"}
   },
   AutoDelete->False,
