Cell[CellGroupData[{
Cell["Covariant Derivative and Geodesics in the \[ScriptCapitalU]\
\[ScriptCapitalD] Calculus", "Title",
 CellChangeTimes->{{3.976889187114873*^9, 
  3.9768892175197353`*^9}},ExpressionUUID->"e32a3f2a-fb9c-4256-a2ab-\
ff2d5896380e"],

Cell["Brian Beckman", "Author",
 CellChangeTimes->{{3.5011898003565187`*^9, 3.5011898164415183`*^9}, {
  3.970503905858189*^9, 3.970503938930399*^9}, {3.9705040303289137`*^9, 
  3.970504033015139*^9}},ExpressionUUID->"8531c00f-1b9c-4144-b1cc-\
d974e69c32ba"],

Cell["Jan 2026", "Author",
 CellChangeTimes->{{3.970503954212903*^9, 3.97050395891148*^9}, {
  3.972479129640115*^9, 3.9724791301125593`*^9}, {3.973546918457328*^9, 
  3.973546918968728*^9}, {3.9762809550919313`*^9, 
  3.976280957806756*^9}},ExpressionUUID->"90e60fd9-e338-4487-becf-\
