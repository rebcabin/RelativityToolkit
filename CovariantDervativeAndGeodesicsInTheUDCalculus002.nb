   RowBox[{
    RowBox[{"testProduct", " ", "=", " ", 
     RowBox[{"ExpandDerivatives", "[", 
      RowBox[{"Partials", "[", 
       RowBox[{
        RowBox[{"f", " ", "*", " ", "g"}], ",", " ", 
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"expectedProduct", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Partials", "[", 
        RowBox[{"f", ",", " ", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], "]"}], 
       " ", "*", " ", "g"}], " ", "+", " ", 
      RowBox[{"f", " ", "*", " ", 
       RowBox[{"Partials", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], 
        "]"}]}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"testProduct", " ", "===", " ", "expectedProduct"}], ",", "\n", 
      "   ", 
      RowBox[{
       RowBox[{"PassCount", "++"}], ";", "\n", "   ", 
       RowBox[{"Print", "[", "\"\<[PASS] Leibniz Product Rule\>\"", "]"}]}], ",",
       "\n", "   ", 
      RowBox[{
       RowBox[{"FailCount", "++"}], ";", "\n", "   ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<[FAIL] Leibniz Product Rule\\n   Found: \>\"", ",", " ", 
         "testProduct"}], "]"}]}]}], "\n", "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Test", " ", "18"}], ":", " ", 
     RowBox[{"Covariant", " ", "Derivative", " ", "Expansion"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Input", ":", " ", 
     RowBox[{"CD", "[", " ", 
      RowBox[{
       RowBox[{"A", "^", "u"}], ",", " ", 
       RowBox[{"x", "^", "v"}]}], " ", "]"}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Expected", ":", " ", 
     RowBox[{
      RowBox[{"Partial", "[", 
       RowBox[{
        RowBox[{"A", "^", "u"}], ",", " ", 
        RowBox[{"x", "^", "v"}]}], "]"}], " ", "+", " ", 
      RowBox[{"(", 
       RowBox[{"Something", " ", "containing", " ", "Gamma"}], ")"}]}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"testCD", " ", "=", " ", 
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", " ", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"LOGIC", ":", " ", 
     RowBox[{"It", " ", "must", " ", "be", " ", "a", " ", 
      RowBox[{"Sum", ".", " ", "One"}], " ", "part", " ", "is", " ", 
      RowBox[{"Partials", ".", " ", "The"}], " ", "other", " ", "part", " ", 
      "MUST", " ", "contain", " ", 
      RowBox[{"Gamma", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{"testCD", ",", " ", 
         RowBox[{"Plus", "[", 
          RowBox[{
           RowBox[{"Partials", "[", 
            RowBox[{"_", ",", " ", "_"}], "]"}], ",", " ", "_"}], "]"}]}], 
        "]"}], " ", "&&", " ", 
       RowBox[{"!", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"testCD", ",", " ", "\[CapitalGamma]"}], "]"}]}]}], ",", 
      "\n", "   ", 
      RowBox[{
       RowBox[{"PassCount", "++"}], ";", "\n", "   ", 
       RowBox[{
       "Print", 
        "[", "\"\<[PASS] CD Expansion Structure (Partial + Connection)\>\"", 
        "]"}]}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{"FailCount", "++"}], ";", "\n", "   ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<[FAIL] CD Expansion Structure\\n   Found: \>\"", ",", 
         " ", "testCD"}], "]"}]}]}], "\n", "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Test", " ", "Chain", " ", "Rule", " ", 
     RowBox[{"(", "Linearity", ")"}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Input", ":", " ", 
     RowBox[{"d", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"A", "+", "B"}], ")"}], "/", "dx"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"testLinearity", " ", "=", " ", 
     RowBox[{"ExpandDerivatives", "[", 
      RowBox[{"Partials", "[", 
       RowBox[{
        RowBox[{"A", " ", "+", " ", "B"}], ",", " ", 
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"MatchQ", "[", 
       RowBox[{"testLinearity", ",", " ", 
        RowBox[{"Plus", "[", 
         RowBox[{
          RowBox[{"Partials", "[", 
           RowBox[{"A", ",", " ", "_"}], "]"}], ",", " ", 
          RowBox[{"Partials", "[", 
           RowBox[{"B", ",", " ", "_"}], "]"}]}], "]"}]}], "]"}], ",", "\n", 
      "   ", 
      RowBox[{
       RowBox[{"PassCount", "++"}], ";", "\n", "   ", 
       RowBox[{
       "Print", "[", "\"\<[PASS] Differentiation Linearity\>\"", "]"}]}], ",",
       "\n", "   ", 
      RowBox[{
       RowBox[{"FailCount", "++"}], ";", "\n", "   ", 
       RowBox[{
       "Print", "[", "\"\<[FAIL] Differentiation Linearity\>\"", "]"}]}]}], 
     "\n", "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "==="}], "="}], " ", "*)"}], "\n", 
   RowBox[{
   "(*", " ", "SUMMARY", 
    "                                                                   ", 
    "*)"}], "\n", 
