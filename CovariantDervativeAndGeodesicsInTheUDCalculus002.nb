Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\"\<\!\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Alpha]'\)], \(; \(\
\[Beta]'\)\)]\)\>\"", "==", 
  RowBox[{"TensorForm", "[", 
   RowBox[{"CD", "[", 
    RowBox[{
     RowBox[{"A", "[", 
      RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]", "]"}], "]"}], ",", 
     RowBox[{"x", "[", 
      RowBox[{"\[ScriptCapitalU]", "[", "\[Beta]", "]"}], "]"}]}], "]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.977012219284894*^9, 3.9770122192876463`*^9}, {
  3.9770669668105087`*^9, 3.9770670394796457`*^9}, {3.977067089118279*^9, 
  3.977067122702623*^9}, {3.97706716721443*^9, 3.9770672238024797`*^9}},
 CellLabel->
  "In[145]:=",ExpressionUUID->"97b60638-dec3-4d8d-9a77-486a7477b318"],

Cell[BoxData[
 RowBox[{"\<\"\\!\\(\\*SubscriptBox[SuperscriptBox[\\(A\\), \\(\[Alpha]'\\)], \
\\(; \\(\[Beta]'\\)\\)]\\)\"\>", "\[Equal]", 
  TagBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"A", 
      SuperscriptBox["", "\[Alpha]"]}], 
     RowBox[{",", "\[Beta]"}]], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"A", 
       SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Beta]", "\[Lambda]"}], "\[Alpha]"]}]}],
   HoldForm]}]], "Output",
 CellChangeTimes->{
  3.977012223314126*^9, 3.977067040497463*^9, {3.977067098950494*^9, 
   3.977067126847596*^9}, 3.977067225801694*^9, 3.977069179464617*^9, 
   3.9770705074614277`*^9},
 CellLabel->
  "Out[145]=",ExpressionUUID->"e75c5f7b-9aad-467c-98c3-c66f7ed65a5d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"DERIVATION", ":", 
    RowBox[{
    "The", " ", "Transformation", " ", "Law", " ", "of", " ", "Gamma"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"ap", ",", "bp", ",", "mu", ",", "nu"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"0.", " ", "SPECIAL", " ", "RULES"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     SubscriptBox["A", 
      RowBox[{",", 
       RowBox[{"\[Beta]", "'"}]}]], "->", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "\[Mu]"]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{"\[Beta]", "'"}]]}]], 
      SubscriptBox["A", 
       RowBox[{",", "\[Mu]"}]]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Condition", "/;", 
     RowBox[{"!", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{"expr", ",", 
         RowBox[{"x", "[", "_", "]"}]}], "]"}], " ", "prevents", " ", 
       "expanding", " ", "a", " ", "Jacobian", " ", "itself", " ", 
       RowBox[{"(", 
        RowBox[{"dx", "/", 
         RowBox[{"dx", "'"}]}], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"manualChainRule", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Partials", "[", 
        RowBox[{"expr_", ",", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], "/;", 
       RowBox[{"!", 
        RowBox[{"MatchQ", "[", 
         RowBox[{"expr", ",", 
          RowBox[{"x", "[", "_", "]"}]}], "]"}]}]}], ":>", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"fresh", "=", 
          RowBox[{"Unique", "[", "\"\<\[Mu]\>\"", "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Partials", "[", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "fresh", "]"}], "]"}], ",", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], "*",
          "\[IndentingNewLine]", 
         RowBox[{"Partials", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "fresh", "]"}], "]"}]}], 
          "]"}]}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Combine", " ", "rules", " ", "from", " ", "the", " ", "engine", " ", 
     "and", " ", "here", " ", "into", " ", "a", " ", "single", " ", "flat", " ",
      "list"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allRules", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"{", 
       RowBox[{"differentiationRules", ",", "manualChainRule"}], "}"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "OBJECTIVE"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Target", "=", 
     RowBox[{"Jac", "*", "Jac", "*", 
      RowBox[{"CD", "[", "A_unprimed", "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"targetTensor", "=", 
     RowBox[{"Echo", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Partials", "[", 
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "ap", "]"}], "]"}], ",", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "mu", "]"}], "]"}]}], "]"}], "*",
         "\[IndentingNewLine]", 
        RowBox[{"Partials", "[", 
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "nu", "]"}], "]"}], ",", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], "*",
         "\[IndentingNewLine]", 
        RowBox[{"CD", "[", 
         RowBox[{
          RowBox[{"A", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "mu", "]"}], "]"}], ",", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "nu", "]"}], "]"}]}], "]"}]}], ",",
        "\[IndentingNewLine]", "\"\<Target Tensorial Transformation \
\!\(\*FractionBox[\(\[PartialD]\*SuperscriptBox[\(x\), \(\[Alpha]'\)]\), \(\
\[PartialD]\*SuperscriptBox[\(x\), \(\[Mu]\)]\)]\)\!\(\*FractionBox[\(\
\[PartialD]\*SuperscriptBox[\(x\), \(\[Nu]\)]\), \
\(\[PartialD]\*SuperscriptBox[\(x\), \
\(\[Beta]'\)]\)]\)(\!\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Mu]\)], \(, \
\(v\)\)]\) + \!\(\*SuperscriptBox[\(A\), \(\[Lambda]\)]\) \
\!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalGamma]\), \(\[Mu]\)], \(\[Nu]\
\[Lambda]\)]\))\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "REALITY"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", 
     RowBox[{"A", "'"}], " ", "and", " ", 
     RowBox[{"x", "'"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Aprimed", "=", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "ap", "]"}], "]"}], "/.", " ", 
      "robustTransformRules"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xprimed", "=", 
     RowBox[{"x", "[", 
      RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2", 
     RowBox[{"a", ".", "The"}], " ", "Definition", " ", 
     RowBox[{"(", 
      RowBox[{"Visual", " ", "Only"}], ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Echo", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"HoldForm", "[", 
        RowBox[{"CD", "[", 
         RowBox[{
          RowBox[{"A", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "ap", "]"}], "]"}], ",", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], 
        "]"}], "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ap", "->", 
          RowBox[{"\[Alpha]", "'"}]}], ",", 
         RowBox[{"bp", "->", 
          RowBox[{"\[Beta]", "'"}]}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", "\"\<2a. Definition (The Object we are \
expanding):\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2", 
     RowBox[{"b", ".", "The"}], " ", "Expansion"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "actual", " ", "value", " ", "using", " ", 
     "the", " ", "flattened", " ", "rules", " ", "list"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"realityExpanded", "=", 
     RowBox[{"Echo", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"CD", "[", 
         RowBox[{"Aprimed", ",", "xprimed"}], "]"}], "//.", "allRules"}], ",",
        "\[IndentingNewLine]", "\"\<2b. Reality (Expanded via Chain \
Rule):\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "THE", " ", "SOLUTION"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"GammaTerm_Primed", "=", 
     RowBox[{"Target", "-", 
      RowBox[{"(", 
       RowBox[{"Reality_without", "_Gamma", "_Prime"}], ")"}]}]}], "*)"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"brokenPartialOnly", "=", 
     RowBox[{"Echo", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Partials", "[", 
         RowBox[{"Aprimed", ",", "xprimed"}], "]"}], "//.", "allRules"}], ",",
        "\[IndentingNewLine]", "\"\<3a. The broken partial (no semicolon) \
\!\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Alpha]'\)], \(, \
\(\[Beta]'\)\)]\),\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gammaPrimeTimesVector", "=", 
     RowBox[{"Echo", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"targetTensor", "-", "brokenPartialOnly"}], ",", 
       "\[IndentingNewLine]", "\"\<3b. Residual (\!\(\*FractionBox[\(\
\[PartialD]\*SuperscriptBox[\(x\), \(\[Alpha]'\)]\), \
\(\[PartialD]\*SuperscriptBox[\(x\), \(\[Mu]\)]\)]\)\!\(\*FractionBox[\(\
\[PartialD]\*SuperscriptBox[\(x\), \(\[Nu]\)]\), \
\(\[PartialD]\*SuperscriptBox[\(x\), \
\(\[Beta]'\)]\)]\)(\!\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Mu]\)], \(, \
\(v\)\)]\) + \!\(\*SuperscriptBox[\(A\), \(\[Lambda]\)]\) \
\!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalGamma]\), \(\[Mu]\)], \(\[Nu]\
\[Lambda]\)]\))) - \!\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Alpha]'\)], \
\(, \(\[Beta]'\)\)]\)\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "FORMATTING", " ", 
     RowBox[{"(", 
      RowBox[{"Lovelock", " ", "Style"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "We", " ", "Collect", " ", "terms", " ", "by", " ", "A", " ", "to", " ", 
     "isolate", " ", "the", " ", "transformation", " ", "law"}], "*)"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"prettyResult", "=", 
     RowBox[{"gammaPrimeTimesVector", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ap", "->", 
         RowBox[{"\[Alpha]", "'"}]}], ",", 
        RowBox[{"bp", "->", 
         RowBox[{"\[Beta]", "'"}]}], ",", 
        RowBox[{"mu", "->", "\[Mu]"}], ",", 
        RowBox[{"nu", "->", "\[Nu]"}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n=== THE TRANSFORMATION LAW (without quotient) ===\>\
\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<The term involving Gamma' must satisfy:\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<(A will be quotiented out in the next step)\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<(\!\(\*SuperscriptBox[\(A\), \
\(\[Gamma]'\)]\))\!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalGamma]\), \
\(a'\)], \(\[Beta]' \[Gamma]'\)]\)  =  \>\"", ",", "Bold", ",", "14"}], "]"}],
         ",", "\[IndentingNewLine]", 
        RowBox[{"TensorForm", "[", 
         RowBox[{"Collect", "[", 
          RowBox[{"prettyResult", ",", 
           RowBox[{"A", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "_", "]"}], "]"}]}], "]"}], 
         "]"}]}], "}"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "VIA", " ", "THE", " ", "QUOTIENT", " ", "THEOREM"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "the", " ", "coefficient", " ", "of", " ", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "cp", "]"}], "]"}], "."}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "When", " ", "we", " ", "convert", " ", "unprimed", " ", "A", " ", "to", 
      " ", "primed", " ", "A"}], ",", " ", 
     RowBox[{
      RowBox[{"force", " ", "'"}], 
      RowBox[{
       RowBox[{"cp", "'"}], "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Define", " ", "Inverse", " ", 
      RowBox[{"Rule", ":", 
       RowBox[{"A", "^", "mu"}]}]}], "->", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"dx", "^", "mu"}], "/", 
        RowBox[{"dx", "^", "cp"}]}], ")"}], "*", 
      RowBox[{"A", "^", "cp"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"inverseVectorRuleFixed", "=", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "idx_", "]"}], "]"}], ":>", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Partials", "[", 
        RowBox[{
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "idx", "]"}], "]"}], ",", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "cp", "]"}], "]"}]}], "]"}], "*", 
       
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "cp", "]"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Apply", " ", "to", " ", "our", " ", "result"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "ensuring", " ", "every", " ", "A", " ", "term", " ", "is", " ", "linear",
      " ", "in", " ", 
     RowBox[{"A", "^", "cp"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rhsWithTargetA", "=", 
     RowBox[{"gammaPrimeTimesVector", "/.", " ", "inverseVectorRuleFixed"}]}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Now", " ", "extract", " ", "the", " ", "coefficient"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"finalGammaLaw", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{"rhsWithTargetA", ",", 
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "cp", "]"}], "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"6.", " ", "FINAL", " ", "FORMATTING"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"prettyResult", "=", 
     RowBox[{"Echo", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"finalGammaLaw", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ap", "->", 
           RowBox[{"\[Alpha]", "'"}]}], ",", 
          RowBox[{"bp", "->", 
           RowBox[{"\[Beta]", "'"}]}], ",", 
          RowBox[{"cp", "->", 
           RowBox[{"\[Gamma]", "'"}]}], ",", 
          RowBox[{"mu", "->", "\[Mu]"}], ",", 
          RowBox[{"nu", "->", "\[Nu]"}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", "\"\<Final \[CapitalGamma] Law (before \
TensorForm)\>\""}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\n=== THE TRANSFORMATION LAW ===\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<By the Quotient Theorem, strip A to find Gamma':\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalGamma]\), \
\(\[Alpha]'\)], \(\[Beta]' \[Gamma]'\)]\)  =  \>\"", ",", "Bold", ",", "16"}],
          "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"TensorForm", "[", "prettyResult", "]"}]}], "}"}], "]"}], 
     "]"}], ";"}]}]}]], "Input",
