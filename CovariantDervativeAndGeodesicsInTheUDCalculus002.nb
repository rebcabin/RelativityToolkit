            " ", "\n", "      ", 
            RowBox[{"x", "[", 
             RowBox[{"\[ScriptCapitalU]", "[", 
              RowBox[{"\[Beta]", "'"}], "]"}], "]"}]}], "]"}], "*", "\n", 
          "     ", 
