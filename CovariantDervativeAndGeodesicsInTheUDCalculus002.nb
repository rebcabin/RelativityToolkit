Cell[TextData[{
 StyleBox["Given what we want to measure, we see why ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", "\[Alpha]"], 
    RowBox[{"\[Mu]", " ", "\[Beta]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b7f26378-d86d-4667-9f54-d849ed740d63"],
 StyleBox[" must have three indices: it measures how much ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"\[Alpha]", "'"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d4e20b18-43d7-47a8-8cb0-cbaa8fb121e8"],
 " ",
 StyleBox["changes when we change ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"\[Beta]", " ", "'"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eb011ee9-e1a5-4dda-a281-c1c946d380f3"],
 " ",
 StyleBox["a little, in terms of the components ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Mu]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3a5fc6d9-9c27-4d70-973f-16df4f4c7bd2"],
 " ",
 StyleBox["at the home point ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Mu]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3dda177d-7943-4dc9-969a-06ae25b3d12b"],
 StyleBox["! Parallel transport simply must look exactly like this, no more, \
no less.",
  FontSlant->"Italic"]
}], "Item",
