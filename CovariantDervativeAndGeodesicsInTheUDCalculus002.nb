    "Define", " ", "a", " ", "list", " ", "of", " ", "scenarios", " ", "to", " ",
      "render"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"gallery", " ", "=", " ", 
     RowBox[{"{", "\n", "   ", 
