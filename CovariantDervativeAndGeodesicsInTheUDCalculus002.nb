   StyleBox["\<\"\\!\\(\\*SuperscriptBox[\\(A\\), \\(\[Mu]\\)]\\) \
\\!\\(\\*SubscriptBox[\\(B\\), \\(\[Mu]\\)]\\)\"\>",
    StripOnInput->False,
    FontSlant->Italic], "\[InvisibleSpace]", "\<\" is equivalent to \"\>", "\[InvisibleSpace]", 
   StyleBox["\<\"\\!\\(\\*SubscriptBox[\\(A\\), \\(\[Nu]\\)]\\) \
\\!\\(\\*SuperscriptBox[\\(B\\), \\(\[Nu]\\)]\\)\"\>",
    StripOnInput->False,
    FontSlant->Italic], "\[InvisibleSpace]", "\<\".\"\>"}],
  SequenceForm["Demonstrating that ", 
   Style["\!\(\*SuperscriptBox[\(A\), \(\[Mu]\)]\) \!\(\*SubscriptBox[\(B\), \
\(\[Mu]\)]\)", Italic], " is equivalent to ", 
   Style["\!\(\*SubscriptBox[\(A\), \(\[Nu]\)]\) \!\(\*SuperscriptBox[\(B\), \
\(\[Nu]\)]\)", Italic], "."],
  Editable->False]], "Print",
 CellChangeTimes->{{3.976977191657687*^9, 3.9769772076046267`*^9}, 
   3.9769776829567337`*^9, 3.976977990612915*^9, 3.9770093056503487`*^9, 
