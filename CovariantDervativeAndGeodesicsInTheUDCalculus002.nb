Cell[CellGroupData[{

Cell["Covariant Derivative", "Section",
 CellChangeTimes->{{3.976976704581627*^9, 
  3.976976708832714*^9}},ExpressionUUID->"2de3c925-4bd0-4c7c-b240-\
31a502b1501e"],

Cell[TextData[{
 "Consider a curve with coordinate functions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Alpha]"], "(", "\[Lambda]", ")"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "25eddf97-a413-4337-b8ad-4295217c28a2"],
 " along the curve, tangent (contravariant) vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["u", "\[Alpha]"], "\[Congruent]", 
    RowBox[{"d", "\[VeryThinSpace]", 
     RowBox[{
      SuperscriptBox["x", "\[Alpha]"], "/", "d"}], "\[VeryThinSpace]", 
     "\[Lambda]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a614fd3d-5239-41e1-9a9d-d1b8a478337d"],
 ". Also consider a (contravariant) vector field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Alpha]"], "(", 
    RowBox[{
     SuperscriptBox["x", "\[Beta]"], "(", "\[Lambda]", ")"}], ")"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "14a50700-31d5-4a71-b872-f8a2fcac5615"],
 " defined in neighborhoods around every point ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Alpha]"], "(", "\[Lambda]", ")"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b9cebccf-ee14-41b2-a9fb-4466ffc63d88"],
 " along the curve. We\[CloseCurlyQuote]d like a \
\[OpenCurlyDoubleQuote]derivative\[CloseCurlyDoubleQuote] of the vector \
field, schematically (leaving off the parameter dependence)"
}], "Text",
 CellChangeTimes->{{3.977003584330347*^9, 3.977003894123189*^9}, {
  3.97700393339956*^9, 3.977003933603921*^9}, {3.97700419429191*^9, 
  3.977004203125691*^9}, {3.977038071780509*^9, 
  3.9770380863791122`*^9}},ExpressionUUID->"f30c4eea-54b7-48a9-86d8-\
0ee2004bdfff"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], "\[TildeFullEqual]", 
   FractionBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["A", "\[Alpha]"], "(", 
      RowBox[{
       SuperscriptBox["x", "\[Beta]"], "+", 
       RowBox[{"d", "\[VeryThinSpace]", 
        SuperscriptBox["x", "\[Beta]"]}]}], ")"}], "-", 
     RowBox[{
      SuperscriptBox["A", "\[Alpha]"], "(", 
      SuperscriptBox["x", "\[Beta]"], ")"}]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
  3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
  3.977038167010255*^9}},
 CellTags->
  "NAIVE DERIVATIVE",ExpressionUUID->"3e7185b2-be53-4220-8811-709ca7e96e9e"],

Cell[TextData[{
 "Seems a reasonable thing to ask: \[OpenCurlyDoubleQuote]How much does \
component \[Alpha] of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "36d19af6-deaa-40f7-bc14-9200e072bb19"],
 " change when I change coordinate \[Beta] a little?\[CloseCurlyDoubleQuote] \
However, the derivative cannot be cogently defined this way because we cannot \
subtract vectors at different points, not even infinitesimally different \
points. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Alpha]"], "(", 
    RowBox[{
     SuperscriptBox["x", "\[Beta]"], "+", 
     RowBox[{"d", "\[VeryThinSpace]", 
      SuperscriptBox["x", "\[Beta]"]}]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "bc3b0f48-fa92-493b-9e9d-1a4a55f319f2"],
 " doesn\[CloseCurlyQuote]t point in the same direction as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Alpha]"], "(", 
    SuperscriptBox["x", "\[Beta]"], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "249a1cde-bf33-4176-8766-580efd21b2c2"],
 "! The vectors are in different tangent spaces. Subtracting them, \
numerically, will scramble information from other directions because the \
underlying manifold curves away. "
}], "Text",
 CellChangeTimes->{{3.9770040526557817`*^9, 3.9770040885876007`*^9}, {
   3.977004137896049*^9, 3.977004145931327*^9}, {3.977004214858284*^9, 
   3.977004294138308*^9}, {3.977004332057253*^9, 3.977004333463525*^9}, {
   3.9770043811140347`*^9, 3.977004453579987*^9}, {3.977007247223049*^9, 
   3.9770072547584133`*^9}, {3.977038173587933*^9, 3.977038497226171*^9}, {
   3.977038540931356*^9, 3.977038579669528*^9}, {3.977038804232141*^9, 
   3.97703884675251*^9}, {3.9770389951471367`*^9, 3.977039023921427*^9}, 
   3.977039241349597*^9, {3.977039455610796*^9, 
   3.977039487120262*^9}},ExpressionUUID->"a239f143-eb86-4585-91e4-\
d5fe602fcb92"],

Cell[TextData[{
 "To answer this conundrum, we need backwards ",
 StyleBox["parallel transport",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", to move the vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Alpha]"], "(", 
    RowBox[{
     SuperscriptBox["x", "\[Beta]"], "+", 
     RowBox[{"d", "\[VeryThinSpace]", 
      SuperscriptBox["x", "\[Beta]"]}]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}},ExpressionUUID->
  "954043c7-1de4-4d21-899a-eb0453ee02f7"],
 " smoothly and with a ",
 StyleBox["provable minimum",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of \[OpenCurlyDoubleQuote]bending\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]twisting\[CloseCurlyDoubleQuote], back from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Beta]"], "+", 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]}], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}},ExpressionUUID->
  "138f83e9-acfc-4786-be80-9dc3019c8501"],
 " to the point ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Beta]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ca25019d-7152-4bf1-9a0a-380875f5301f"],
 " so we can measure the components of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Alpha]"], "(", 
    RowBox[{
     SuperscriptBox["x", "\[Beta]"], "+", 
     RowBox[{"d", "\[VeryThinSpace]", 
      SuperscriptBox["x", "\[Beta]"]}]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}},ExpressionUUID->
  "46b2224c-75e4-408d-bdb8-08a547aa5257"],
 " on the coordinate axes (basis vectors) at point ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Beta]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ca6466ff-fce0-4260-b3c8-736acff0f49c"],
 " and then subtract the numbers. "
}], "Text",
 CellChangeTimes->{{3.9770040526557817`*^9, 3.9770040885876007`*^9}, {
  3.977004137896049*^9, 3.977004145931327*^9}, {3.977004214858284*^9, 
  3.977004294138308*^9}, {3.977004332057253*^9, 3.977004333463525*^9}, {
  3.9770043811140347`*^9, 3.977004453579987*^9}, {3.977007247223049*^9, 
  3.9770072547584133`*^9}, {3.977038173587933*^9, 3.9770382226080093`*^9}, {
  3.977038589248727*^9, 3.977038632705469*^9}, {3.977039144347281*^9, 
  3.9770392038997087`*^9}, {3.977039626915082*^9, 3.9770397003204203`*^9}, {
  3.977039952082591*^9, 3.977039953245672*^9}, {3.9770400219426003`*^9, 
  3.9770400238143177`*^9}, {3.977040825192885*^9, 
  3.97704084832859*^9}},ExpressionUUID->"e975218c-da2a-4de9-b5ea-\
cae10438cf1a"],

Cell[TextData[{
 "Now, even if we could subtract the vectors, how is that difference going to \
survive a coordinate transformation? How can I find out, when I change \
coordinates from ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a6471b6e-54f3-4215-bcf4-b886803e3666"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "435b2eb2-cc59-413d-ac74-75aaddabfe42"],
 ", how much component ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3995f2d1-9ad1-4b7e-b9e6-c7f85859dbfc"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "598c03d7-c530-4062-940a-7e72659ae730"],
 "changes when I change coordinate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "809037a4-1f27-436e-8a7c-03a03746f5eb"],
 "? What\[CloseCurlyQuote]s the value of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", 
      RowBox[{"\[Alpha]", " ", "'"}]]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", 
      RowBox[{"\[Beta]", " ", "'"}]]}]], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "006d5211-41a9-47b9-b84c-db4a993c2c38"],
 " when all I know is ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "ad0cdaaa-3de0-423c-9c74-73a2f053dc22"],
 "? As always, we insist that the ",
 StyleBox["intrinsic ",
  FontSlant->"Italic"],
 "geometry and physics not depend on choice of coordinates. But what does ",
 StyleBox["intrinsic",
  FontSlant->"Italic"],
 " mean when all we have are numerical components whose values depend on \
choice of coordinates?"
}], "Text",
 CellChangeTimes->{{3.9770040526557817`*^9, 3.9770040885876007`*^9}, {
  3.977004137896049*^9, 3.977004145931327*^9}, {3.977004214858284*^9, 
  3.977004294138308*^9}, {3.977004332057253*^9, 3.977004333463525*^9}, {
  3.9770043811140347`*^9, 3.977004453579987*^9}, {3.977007247223049*^9, 
  3.9770072547584133`*^9}, {3.977038173587933*^9, 3.977038497226171*^9}, {
  3.977038540931356*^9, 3.977038558382607*^9}, {3.9770386442395363`*^9, 
  3.977038745129084*^9}, {3.977039055494041*^9, 3.977039136565977*^9}, {
  3.977039505207293*^9, 3.9770396040583878`*^9}, {3.977039995456196*^9, 
  3.977039996382832*^9}},ExpressionUUID->"5e16f76b-3674-4a09-b04e-\
c36a63426924"],

Cell[TextData[{
 "To answer this conundrum, ",
 StyleBox["intrinsic",
  FontSlant->"Italic"],
 " is exactly what we mean by ",
 StyleBox["tensorial",
  FontSlant->"Italic"],
 ". Our desired, derivative-like quantities ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "5b1991d2-15d1-4220-85bf-ec11b979dd38"],
 " must transform like a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "480fe5fc-cace-4565-8fba-672aaa6601fc"],
 " tensor as we change the basis vectors at point \[Beta]. The components of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "d9667a78-36d4-4259-a2ac-e93a4343b61c"],
 " must change with coordinate frames in exactly the way any other geometric \
or physical quantity with two indices, one up and one down, would change, so \
that projections on basis vectors, or any other vectors, measure geometric \
and physical properties, not properties of the coordinate systems \
themselves."
}], "Text",
 CellChangeTimes->{{3.9770040526557817`*^9, 3.9770040885876007`*^9}, {
  3.977004137896049*^9, 3.977004145931327*^9}, {3.977004214858284*^9, 
  3.977004294138308*^9}, {3.977004332057253*^9, 3.977004333463525*^9}, {
  3.9770043811140347`*^9, 3.977004453579987*^9}, {3.977007247223049*^9, 
  3.9770072547584133`*^9}, {3.977038173587933*^9, 3.9770382226080093`*^9}, {
  3.977038589248727*^9, 3.977038632705469*^9}, {3.977039144347281*^9, 
  3.9770391878980713`*^9}, {3.977039219320077*^9, 3.977039335691654*^9}, {
  3.977039726634755*^9, 3.9770398631459713`*^9}, {3.9770408810411873`*^9, 
  3.9770409177565737`*^9}, {3.977040985697022*^9, 
  3.9770410320985518`*^9}},ExpressionUUID->"0302b9c0-b730-4187-bdbe-\
4c9b469958ec"],

Cell["\<\
It turns out that simply demanding that our new derivative be tensorial and \
linear suffices to solve the problem. \
\>", "Text",
 CellChangeTimes->{{3.977004335524499*^9, 3.9770043704738903`*^9}, {
   3.977004459862672*^9, 3.977004462955502*^9}, {3.977004607950364*^9, 
   3.977004657450521*^9}, {3.9770051541433764`*^9, 3.977005223612775*^9}, {
   3.97700531611539*^9, 3.9770055667106743`*^9}, {3.9770056293925962`*^9, 
   3.977005692088046*^9}, {3.9770057691765127`*^9, 3.977005809766267*^9}, {
   3.9770058466687117`*^9, 3.977005916940502*^9}, {3.9770060689174433`*^9, 
   3.977006082939225*^9}, {3.977007267875451*^9, 3.977007287649378*^9}, {
   3.977007606552973*^9, 3.977007804922398*^9}, 3.9770096096309032`*^9, {
   3.977039890629109*^9, 3.977039895746916*^9}, {3.9770411661340227`*^9, 
   3.977041194191555*^9}, {3.977041249443462*^9, 3.977041264803671*^9}, 
   3.9770412970304193`*^9, 
   3.9770629808685913`*^9},ExpressionUUID->"e26e79c9-9ac9-48a7-b95c-\
b285adfafc8f"],

Cell[TextData[{
 "\[SZ]First, let\[CloseCurlyQuote]s check that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", "\[VeryThinSpace]", "\[Beta]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9b31dd55-db39-4b90-94c6-18be7ffee3a8"],
 " is not tensorial. Let\[CloseCurlyQuote]s transform ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "03e80078-2f83-4c30-99cf-0eb1397fb396"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "195b1cd5-22b9-4f10-b935-e38bd83424ac"],
 ": "
}], "Text",
 CellChangeTimes->{{3.977004335524499*^9, 3.9770043704738903`*^9}, {
   3.977004459862672*^9, 3.977004462955502*^9}, {3.977004607950364*^9, 
   3.977004657450521*^9}, {3.9770051541433764`*^9, 3.977005223612775*^9}, {
   3.97700531611539*^9, 3.9770055667106743`*^9}, {3.9770056293925962`*^9, 
   3.977005692088046*^9}, {3.9770057691765127`*^9, 3.977005809766267*^9}, {
   3.9770058466687117`*^9, 3.977005916940502*^9}, {3.9770060689174433`*^9, 
   3.977006082939225*^9}, {3.977007267875451*^9, 3.977007287649378*^9}, {
   3.977007606552973*^9, 3.977007804922398*^9}, 3.9770096096309032`*^9, {
   3.977039890629109*^9, 3.977039895746916*^9}, {3.9770411661340227`*^9, 
   3.977041194191555*^9}, {3.977041249443462*^9, 3.977041264803671*^9}, 
   3.9770412970304193`*^9, 
   3.9770629871072083`*^9},ExpressionUUID->"a9464779-ae86-457d-8be6-\
ba15324599a7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["A", 
    RowBox[{"\[Alpha]", "'"}]], "\[Congruent]", 
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Alpha]", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Alpha]"]}]], 
    SuperscriptBox["A", "\[Alpha]"]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977008276090537*^9, 3.977008414049974*^9}, {
  3.977041280713253*^9, 
  3.977041288005127*^9}},ExpressionUUID->"1398b8b5-d066-42af-afd4-\
159a79ce9548"],

Cell["\<\
Now calculate its partial derivatives with respect to the primed frame:\
\>", "Text",
 CellChangeTimes->{{3.977009690387065*^9, 3.977009710899132*^9}, {
  3.977041301946884*^9, 
  3.9770413251682167`*^9}},ExpressionUUID->"6486085b-2402-492d-a175-\
3585b6949957"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], 
    RowBox[{",", 
     RowBox[{"\[Beta]", " ", "'"}]}]], "\[Congruent]", 
   RowBox[{
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{"\[Alpha]", "'"}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "\[Alpha]"]}]], 
      SuperscriptBox["A", "\[Alpha]"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977008276090537*^9, 3.977008414049974*^9}, {
  3.977060850916094*^9, 
  3.977060862323194*^9}},ExpressionUUID->"a4fe1c7f-d7b3-412a-8c44-\
20df7796f258"],

Cell[TextData[{
 StyleBox["This notation is different from Lovelock & Rund, who write",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "_"], "\[Alpha]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9503deda-ff8f-471d-94d0-5233c72da24b"],
 " ",
 StyleBox["for the transformation functions, with Greek indices that have no \
primes. However, we will not be confused: ",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"\[Alpha]", "'"}]], TraditionalForm]],ExpressionUUID->
  "02199e11-78af-4160-8fe2-318f60454a72"],
 " ",
 StyleBox["is short for",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", 
     RowBox[{"\[Alpha]", "'"}]], "(", 
    SuperscriptBox["x", "\[Beta]"], ")"}], TraditionalForm]],ExpressionUUID->
  "24d1c814-4c71-451c-871e-b31ce3d391e4"],
 ", ",
 StyleBox["four functions of four arguments each, expressing new coordinates \
in terms of old. The prime isn\[CloseCurlyQuote]t really on the index, but on \
the pair of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,
  FontSlant->"Italic",ExpressionUUID->
  "ca397c36-0541-4fee-83a0-d464f38c3db0"],
 StyleBox[" and the index. We write it on the index only for ease of \
typesetting. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977004335524499*^9, 3.9770043704738903`*^9}, {
  3.977004459862672*^9, 3.977004462955502*^9}, {3.977004607950364*^9, 
  3.977004657450521*^9}, {3.9770051541433764`*^9, 3.977005223612775*^9}, {
  3.97700531611539*^9, 3.9770055667106743`*^9}, {3.9770056293925962`*^9, 
  3.977005692088046*^9}, {3.9770057691765127`*^9, 3.977005809766267*^9}, {
  3.9770058466687117`*^9, 3.977005916940502*^9}, {3.9770060689174433`*^9, 
  3.977006082939225*^9}, {3.977007267875451*^9, 3.977007287649378*^9}, {
  3.977007606552973*^9, 3.977007804922398*^9}, {3.977065238980687*^9, 
  3.9770652412681017`*^9}},ExpressionUUID->"620cbe4c-e2ba-4552-9c34-\
9b50a700b51f"],

Cell["Let the \[ScriptCapitalU]\[ScriptCapitalD] engine to do this bit of \
calculus:", "Text",
 CellChangeTimes->{{3.977041334909045*^9, 3.977041357964467*^9}, {
   3.9770413927139*^9, 3.977041393667335*^9}, 
   3.9770652572467546`*^9},ExpressionUUID->"b2d77625-7405-4742-b8f5-\
13c59f7aa6d6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"ap", ",", "bp", ",", "mu"}], "]"}], ";"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "1"}], ":", 
    RowBox[{"Define", " ", "the", " ", "Input"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Partial", " ", "derivative", " ", "of", " ", "the", " ", "Transformed", " ",
     "Vector", " ", 
    RowBox[{"A", "'"}], " ", 
    RowBox[{"w", ".", "r", ".", "t"}], " ", 
    RowBox[{"x", "'"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Input", ":", 
    RowBox[{"d", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", "^", 
        RowBox[{"a", "'"}]}], ")"}], "/", "d"}], 
     RowBox[{"(", 
      RowBox[{"x", "^", 
       RowBox[{"b", "'"}]}], ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"inputTerm", "=", 
    RowBox[{"Echo", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Partials", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Expand", " ", 
         RowBox[{"A", "^", 
          RowBox[{"a", "'"}]}], " ", "into", " ", "J", "*", 
         RowBox[{"A", "^", "mu"}], " ", "immediately", " ", "via", " ", 
         "existing", " ", "rule"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "ap", "]"}], "]"}], "/.", " ", 
         "robustTransformRules"}], ",", 
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "\"\<1. Input \
\!\(\*SubscriptBox[\(\[PartialD]\), \
\(\[Beta]'\)]\)(\!\(\*SuperscriptBox[\(A\), \(\[Alpha]'\)]\)):\>\""}], 
     "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "2"}], ":", 
    RowBox[{"Mechanical", " ", "Expansion"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Apply", " ", "Leibniz", " ", "and", " ", "Chain", " ", "Rule", " ", 
    "repeatedly", " ", "until", " ", "stable"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"expandedTerm", "=", 
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"ExpandDerivatives", "[", "inputTerm", "]"}], ",", 
      "\[IndentingNewLine]", "\"\<2. Mechanically Expanded Derivative:\>\""}],
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "3"}], ":", "Formatting"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Map", " ", "internal", " ", "unique", " ", "dummies", " ", "to", " ", 
    "readable", " ", "Greek"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"prettyResult", "=", 
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"expandedTerm", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ap", "->", 
          RowBox[{"\[Alpha]", "'"}]}], ",", 
         RowBox[{"bp", "->", 
          RowBox[{"\[Beta]", "'"}]}], ",", 
         RowBox[{"mu", "->", "\[Mu]"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", "\"\<3. Peek at unique dummy indices\>\""}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"brokenPartial", "=", 
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"TensorForm", "[", "prettyResult", "]"}], ",", 
     "\[IndentingNewLine]", "\"\<4. Expanded \!\(\*SubscriptBox[\(\[PartialD]\
\), \(\[Beta]'\)]\)(\!\(\*SuperscriptBox[\(A\), \(\[Alpha]'\)]\)) in Readable \
Greek\>\""}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.977008741929626*^9, 3.977008820235695*^9}, 
   3.977008885372672*^9, {3.9770094423020697`*^9, 3.9770094577204313`*^9}, {
   3.977009737355989*^9, 3.977009833411221*^9}, {3.9770098725691023`*^9, 
   3.977009904582294*^9}, {3.977009936258263*^9, 3.977009980150612*^9}, {
   3.9770414147097273`*^9, 3.977041424849421*^9}, {3.9770532950091743`*^9, 
   3.977053301338974*^9}, {3.977065288356881*^9, 3.977065415628669*^9}},
 CellLabel->
  "In[140]:=",ExpressionUUID->"f2ecf498-1b10-4db8-9555-6f43d404622a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  TagBox["\<\"1. Input \\!\\(\\*SubscriptBox[\\(\[PartialD]\\), \
\\(\[Beta]'\\)]\\)(\\!\\(\\*SuperscriptBox[\\(A\\), \\(\[Alpha]'\\)]\\)):\"\>",
   "EchoLabel"], "  ", 
  SubscriptBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"A", 
      SuperscriptBox["", "\[Mu]15"]}], ")"}], " ", 
    FractionBox[
     RowBox[{
      RowBox[{"\[PartialD]", "x"}], 
      SuperscriptBox["", "ap"]}], 
     RowBox[{
      RowBox[{"\[PartialD]", "x"}], 
      SuperscriptBox["", "\[Mu]15"]}]]}], 
   RowBox[{",", "bp"}]]}]], "Echo",
 CellChangeTimes->{
  3.977070507408291*^9},ExpressionUUID->"0b7ebe6f-4c73-4a87-a1ac-\
b2d035ef19dc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   TagBox["\<\"2. Mechanically Expanded Derivative:\"\>",
    "EchoLabel"], "  ", 
   RowBox[{"(", 
    RowBox[{"A", 
     SuperscriptBox["", "\[Mu]15"]}], ")"}], " ", 
   FractionBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["\[PartialD]", "2"], "x"}], 
     SuperscriptBox["", "ap"]}], 
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "bp"], 
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "\[Mu]15"]}]]}], "+", 
  RowBox[{
   RowBox[{"(", 
    SubscriptBox[
     RowBox[{"A", 
      SuperscriptBox["", "\[Mu]15"]}], 
     RowBox[{",", "bp"}]], ")"}], " ", 
   FractionBox[
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "ap"]}], 
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "\[Mu]15"]}]]}]}]], "Echo",
 CellChangeTimes->{
  3.977070507424604*^9},ExpressionUUID->"0b3dc996-a313-4753-9ae6-\
bc4bdd24be10"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   TagBox["\<\"3. Peek at unique dummy indices\"\>",
    "EchoLabel"], "  ", 
   RowBox[{"(", 
    RowBox[{"A", 
     SuperscriptBox["", "\[Mu]15"]}], ")"}], " ", 
   FractionBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["\[PartialD]", "2"], "x"}], 
     SuperscriptBox["", 
      SuperscriptBox["\[Alpha]", "\[Prime]",
       MultilineFunction->None]]}], 
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", 
      SuperscriptBox["\[Beta]", "\[Prime]",
       MultilineFunction->None]], 
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "\[Mu]15"]}]]}], "+", 
  RowBox[{
   RowBox[{"(", 
    SubscriptBox[
     RowBox[{"A", 
      SuperscriptBox["", "\[Mu]15"]}], 
     RowBox[{",", 
      SuperscriptBox["\[Beta]", "\[Prime]",
       MultilineFunction->None]}]], ")"}], " ", 
   FractionBox[
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", 
      SuperscriptBox["\[Alpha]", "\[Prime]",
       MultilineFunction->None]]}], 
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "\[Mu]15"]}]]}]}]], "Echo",
 CellChangeTimes->{
  3.977070507428914*^9},ExpressionUUID->"ef5f9840-6dcd-4a19-a6f8-\
8eaddbf9b828"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"4. Expanded \\!\\(\\*SubscriptBox[\\(\[PartialD]\\), \
\\(\[Beta]'\\)]\\)(\\!\\(\\*SuperscriptBox[\\(A\\), \\(\[Alpha]'\\)]\\)) in \
Readable Greek\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"A", 
       SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
     FractionBox[
      RowBox[{
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], "x"}], 
       SuperscriptBox["", 
        SuperscriptBox["\[Alpha]", "\[Prime]",
         MultilineFunction->None]]}], 
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", 
        SuperscriptBox["\[Beta]", "\[Prime]",
         MultilineFunction->None]], 
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", "\[Lambda]"]}]]}], "+", 
    RowBox[{
     RowBox[{"(", 
      SubscriptBox[
       RowBox[{"A", 
        SuperscriptBox["", "\[Lambda]"]}], 
       RowBox[{",", 
        SuperscriptBox["\[Beta]", "\[Prime]",
         MultilineFunction->None]}]], ")"}], " ", 
     FractionBox[
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", 
        SuperscriptBox["\[Alpha]", "\[Prime]",
         MultilineFunction->None]]}], 
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", "\[Lambda]"]}]]}]}],
   HoldForm]}]], "Echo",
 CellChangeTimes->{
  3.97707050744392*^9},ExpressionUUID->"bfce530d-f13b-44b5-8ae0-5b2ba96ef3a5"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The partial derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", " ", "\[Beta]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3070d98c-a02c-4a3e-b79e-370c4cf461fd"],
 " is not tensorial, else it would transform like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Alpha]", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Alpha]"]}]], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    SubscriptBox[
     SuperscriptBox["A", "\[Alpha]"], 
     RowBox[{",", " ", "\[Beta]", " "}]]}], TraditionalForm]],
  CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
   3.9770114425225677`*^9, 3.977011477474715*^9}},ExpressionUUID->
  "5b3691bd-bb3b-4a1b-9920-7dbf35fabe22"],
 ". However, when we differentiate ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Alpha]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3191fc55-4493-4ca3-b4b1-3d83e575b428"],
 "\[CloseCurlyQuote]s transform, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"\[Alpha]", "'"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f2856a66-242a-4ec0-8e28-248b06daee09"],
 ", in the new coordinate system ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"\[Beta]", " ", "'"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bd0cb467-3319-4ab7-be62-2fbed0326646"],
 ":"
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
  3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
  3.977011051138826*^9}, {3.977011515235486*^9, 3.977011570673971*^9}, {
  3.9770414603757057`*^9, 3.977041538097261*^9}, {3.977053320309387*^9, 
  3.977053356535059*^9}, {3.9770538109602013`*^9, 
  3.9770538155186*^9}},ExpressionUUID->"06a7d4c4-a2c0-479b-8a69-6ab4468c4c67"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{" ", 
         RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["A", 
        RowBox[{"\[Alpha]", " ", "'"}]], "=", 
       RowBox[{
        SuperscriptBox["A", "\[Mu]"], 
        FractionBox[
         RowBox[{"\[PartialD]", 
          SuperscriptBox["x", 
           RowBox[{" ", 
            RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["x", 
           RowBox[{" ", "\[Mu]"}]]}]]}]}], ")"}]}], "\[Congruent]", 
    SubscriptBox[
     SuperscriptBox["A", 
      RowBox[{"\[Alpha]", "'"}]], 
     RowBox[{",", 
      RowBox[{"\[Beta]", " ", "'"}]}]]}], "=", 
   RowBox[{
    RowBox[{"(", 
     SuperscriptBox["A", "\[Mu]19"], ")"}], " ", 
    SubscriptBox[
     FractionBox[
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", "ap"]}], 
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", "\[Mu]19"]}]], 
     RowBox[{",", "bp"}]]}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977053825090283*^9, 3.9770539820693007`*^9}, {
  3.977054016679175*^9, 3.977054049741235*^9}, {3.977054102978526*^9, 
  3.977054109922058*^9}},ExpressionUUID->"c5d11daf-857b-4d39-9ac6-\
57636f2c0a9e"],

Cell[TextData[{
 "we don\[CloseCurlyQuote]t get the transform  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "\[Alpha]"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", " ", "'"}]]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{" ", 
         RowBox[{"\[Beta]", " ", "'"}]}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{" ", "\[Beta]"}]]}]], 
     SubscriptBox[
      SuperscriptBox["A", 
       RowBox[{"\[Alpha]", " ", "'"}]], 
      RowBox[{",", " ", 
       RowBox[{"\[Beta]", " ", "'"}]}]]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
   3.9770114425225677`*^9, 3.977011477474715*^9}},ExpressionUUID->
  "6a465448-e981-439b-b64a-655ba41e5065"],
 " of the derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b4ca2611-eb27-47a3-a7cb-2f9b846875a1"],
 ", but two terms that are difficult to interpret. "
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
   3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
   3.977011051138826*^9}, {3.977011515235486*^9, 3.977011570673971*^9}, {
   3.9770414603757057`*^9, 3.977041538097261*^9}, {3.977053320309387*^9, 
   3.977053356535059*^9}, {3.9770592584261723`*^9, 3.977059369274659*^9}, 
   3.9770594025116243`*^9, {3.9770666475906487`*^9, 
   3.977066648961801*^9}},ExpressionUUID->"8f1ec892-b6d9-4a76-8149-\
21b4735ad9e8"],

Cell[TextData[{
 "Both terms, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["A", "\[Lambda]"], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], 
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", "'"}]]}], 
      RowBox[{
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{"\[Beta]", " ", "'"}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "\[Lambda]"]}]}]]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "75ccce2a-8699-411e-a533-baa9caccd6cb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["A", "\[Lambda]"], 
      RowBox[{",", " ", 
       RowBox[{"\[Beta]", " ", "'"}]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", "'"}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "\[Lambda]"]}]]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3e0521c4-0fdf-4f2e-9311-3e6e5347eff7"],
 " have factors, ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     SuperscriptBox["x", 
      RowBox[{"\[Alpha]", "'"}]]}], 
    RowBox[{
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Beta]", " ", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Lambda]"]}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "adad717a-7a29-4596-86c0-e48fcdaa64f3"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Lambda]"], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], TraditionalForm]],ExpressionUUID->
  "43450047-a74f-43fd-94a7-765e5cea86e8"],
 ", that are calculated in both coordinate systems, and \
that\[CloseCurlyQuote]s disturbing. We can extract one factor of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{" ", "\[Beta]"}]]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{" ", 
       RowBox[{"\[Beta]", " ", "'"}]}]]}]], TraditionalForm]],ExpressionUUID->
  "f7e8d4b6-9256-44aa-8d86-785359c057d7"],
 ", but that\[CloseCurlyQuote]s it. Rewrite the last line ",
 Cell[BoxData["\"\<Expanded \!\(\*SubscriptBox[\(\[PartialD]\), \(\[Beta]'\)]\
\)(\!\(\*SuperscriptBox[\(A\), \(\[Alpha]'\)]\))...\>\""],
  CellChangeTimes->{3.9770654174452257`*^9},ExpressionUUID->
  "101f671b-f705-42da-865b-8fe2980f4323"],
 " from above as follows:"
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
  3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
  3.977011051138826*^9}, {3.977011515235486*^9, 3.977011570673971*^9}, {
  3.9770414603757057`*^9, 3.977041538097261*^9}, {3.977053320309387*^9, 
  3.977053356535059*^9}, {3.9770592584261723`*^9, 3.977059369274659*^9}, {
  3.9770594205474043`*^9, 3.977059425344063*^9}, {3.9770655434250927`*^9, 
  3.977065571669265*^9}, {3.9770659566282063`*^9, 3.9770659782154293`*^9}, {
  3.9770666890912848`*^9, 
  3.977066749670599*^9}},ExpressionUUID->"216108f1-fe2e-400a-a1e0-\
31ea1a07077c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", " ", "'"}]], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["A", 
       RowBox[{" ", "\[Lambda]"}]], "(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], 
        SuperscriptBox["x", 
         RowBox[{" ", 
          RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
       RowBox[{
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Beta]", " ", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]}]], ")"}], "+", 
     RowBox[{
      RowBox[{"(", 
       SubscriptBox[
        SuperscriptBox["A", 
         RowBox[{" ", "\[Lambda]"}]], 
        RowBox[{",", " ", 
         RowBox[{"\[Beta]", " ", "'"}]}]], ")"}], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", 
          RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", "\[Lambda]"}]]}]]}]}], "=", "\[LineSeparator]", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["A", 
        RowBox[{" ", "\[Lambda]"}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Beta]"}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
       RowBox[{"(", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], 
          SuperscriptBox["x", 
           RowBox[{" ", 
            RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
         RowBox[{
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Beta]"}]]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Lambda]"}]]}]}]], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          SuperscriptBox["A", 
           RowBox[{" ", "\[Lambda]"}]], 
          RowBox[{",", " ", "\[Beta]", " "}]], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Beta]"}]]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", 
             RowBox[{"\[Beta]", " ", "'"}]}]]}]]}], ")"}], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]]}]}], "=", "\[LineSeparator]", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", "\[Beta]"}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", 
          RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["A", 
          RowBox[{" ", "\[Lambda]"}]], 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[PartialD]", "2"], 
           SuperscriptBox["x", 
            RowBox[{" ", 
             RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
          RowBox[{
           RowBox[{"\[PartialD]", 
            SuperscriptBox["x", 
             RowBox[{" ", "\[Beta]"}]]}], 
           RowBox[{"\[PartialD]", 
            SuperscriptBox["x", 
             RowBox[{" ", "\[Lambda]"}]]}]}]]}], "+", 
        RowBox[{
         SubscriptBox[
          SuperscriptBox["A", 
           RowBox[{" ", "\[Lambda]"}]], 
          RowBox[{",", " ", "\[Beta]", " "}]], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Alpha]"}]]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Lambda]"}]]}]]}]}], ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977053379479414*^9, 3.97705375883645*^9}, {
  3.9770594797492647`*^9, 3.977059513634585*^9}, {3.9770600785843143`*^9, 
  3.977060105446658*^9}, {3.977060142965212*^9, 3.9770601668754187`*^9}, {
  3.977060241161337*^9, 3.97706024837414*^9}, {3.9770655886816063`*^9, 
  3.977065613258123*^9}, {3.977065745169601*^9, 3.977065785382228*^9}, {
  3.977066767336562*^9, 
  3.977066812952137*^9}},ExpressionUUID->"68824569-07ee-4dde-aba3-\
054006e8fab6"],

Cell[TextData[{
 "T",
 "he quantity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["A", 
       RowBox[{" ", "\[Lambda]"}]], 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], 
        SuperscriptBox["x", 
         RowBox[{" ", 
          RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
       RowBox[{
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Beta]"}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]}]]}], "+", 
     RowBox[{
      SubscriptBox[
       SuperscriptBox["A", 
        RowBox[{" ", "\[Lambda]"}]], 
       RowBox[{",", " ", "\[Beta]", " "}]], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", "\[Alpha]"}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", "\[Lambda]"}]]}]]}]}], ")"}], TraditionalForm]],
  ExpressionUUID->"9aa93cc7-3892-41a9-ba6c-bd51f8fb66ca"],
 " is not tensorial either. ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     SuperscriptBox["x", 
      RowBox[{" ", 
       RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
    RowBox[{
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Lambda]"}]]}]}]], TraditionalForm]],ExpressionUUID->
  "57648b80-f7ab-4510-82c5-c78b42b9bae4"],
 " is the Hessian of the coordinate transformation and is not a an intrinsic \
geometrical object. It doesn\[CloseCurlyQuote]t live in either tangent space. \
It can\[CloseCurlyQuote]t itself be transformed. It depends entirely on a \
particular choice of two coordinate systems. It\[CloseCurlyQuote]s of no help."
}], "Text",
 CellChangeTimes->{{3.9770595997808647`*^9, 3.977059649976912*^9}, {
  3.977060262908671*^9, 3.977060269336875*^9}, {3.977065629016151*^9, 
  3.9770656653095827`*^9}, {3.977065732646055*^9, 3.977065734676793*^9}, {
  3.977065803951926*^9, 3.9770659401694393`*^9}, {3.977066838368587*^9, 
  3.977066845133431*^9}},ExpressionUUID->"ebe8ffac-67c3-483f-adef-\
8fd6a04619f1"],

Cell[TextData[{
 "There\[CloseCurlyQuote]s a way out. Write an additive correction to the \
partial derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", " ", "\[Beta]", " "}]], TraditionalForm]],ExpressionUUID->
  "4538a6d3-9eb4-43d0-90e7-3db2329578b6"],
 ". Demand the correction be linear in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Alpha]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "de4487a5-b9aa-4306-b988-17626f8719d7"],
 " such that the derivative plus the correction transforms tensorially. \
Calling this \[OpenCurlyDoubleQuote]corrected derivative\
\[CloseCurlyDoubleQuote] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]", " "}]], TraditionalForm]],ExpressionUUID->
  "913dd4b6-f1c0-4800-a31c-a34290168771"],
 ", with a semicolon instead of a comma, define"
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
   3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
   3.977010967374028*^9}, {3.977011058197987*^9, 3.9770111504156837`*^9}, {
   3.977011577000286*^9, 3.977011599925207*^9}, {3.9770415661310177`*^9, 
   3.9770416017082853`*^9}, 3.977065836365576*^9, {3.977066857271544*^9, 
   3.977066886804606*^9}},ExpressionUUID->"63150d01-ceda-4f22-803b-\
1a97f3847230"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]", " "}]], "\[Congruent]", 
   RowBox[{
    SubscriptBox[
     SuperscriptBox["A", "\[Alpha]"], 
     RowBox[{",", " ", "\[Beta]"}]], "+", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["\[CapitalGamma]", "\[Alpha]"], 
      RowBox[{"\[Mu]", " ", "\[Beta]"}]], 
     SuperscriptBox["A", "\[Mu]"]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977010636055129*^9, 3.977010643913973*^9}, {
  3.9770111624798183`*^9, 
  3.977011270616735*^9}},ExpressionUUID->"f9347413-dcec-4b5a-b910-\
1ddd35a13a6e"],

Cell["such that it may transform as follows:", "Text",
 CellChangeTimes->{{3.9770112779099293`*^9, 3.977011307443584*^9}, {
  3.9770416099832573`*^9, 3.97704163759873*^9}, {3.97704167848347*^9, 
  3.977041680128821*^9}},ExpressionUUID->"e22434f5-50f6-4a8b-9f8c-\
d3508d56c6ca"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], 
    RowBox[{";", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Alpha]", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Alpha]"]}]], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    SubscriptBox[
     SuperscriptBox["A", "\[Alpha]"], 
     RowBox[{";", " ", "\[Beta]", " "}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
  3.9770114425225677`*^9, 
  3.977011477474715*^9}},ExpressionUUID->"6b548b6d-3f69-4925-8eed-\
