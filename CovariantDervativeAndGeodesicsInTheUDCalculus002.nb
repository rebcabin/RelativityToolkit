        "___", "]"}], "]"}], ":=", 
     RowBox[{"valence", "[", "h", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"valence", "[", "prod_Times", "]"}], ":=", 
     RowBox[{"contractValence", "[", 
      RowBox[{"Fold", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{"#1", ",", 
           RowBox[{"valence", "[", "#2", "]"}], ",", "2"}], "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "}"}], ",", 
          RowBox[{"{", "}"}]}], "}"}], ",", 
        RowBox[{"List", "@@", "prod"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"valence", "[", "sum_Plus", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "vs", "}"}], ",", 
       RowBox[{
        RowBox[{"vs", "=", 
         RowBox[{"valence", "/@", 
          RowBox[{"(", 
           RowBox[{"List", "@@", "sum"}], ")"}]}]}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"Apply", "[", 
           RowBox[{"SameQ", ",", "vs"}], "]"}], ",", 
          RowBox[{"First", "[", "vs", "]"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", "\"\<Valence Mismatch\>\"", "]"}], ";", 
