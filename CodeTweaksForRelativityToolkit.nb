Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", \
"\"\<=========================================================================\
\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Christoffel Symbols for Gravitation from Metric via the \
\\\n\[ScriptCapitalU]\[ScriptCapitalD] Calculus\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", \
"\"\<=========================================================================\
\>\"", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "g", ",", " ", "GammaSymmetryRule", ",", " ", "MetricSymmetryRule", ",", 
     " ", "term1", ",", " ", "term2", ",", " ", "\n", "  ", "term3", ",", " ",
      "combination", ",", " ", "targetIndex"}], "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<1. PHYSICAL CONSTRAINTS \
-------------------------------------------------\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<1a. Torsion-free geometry: \\\n\
\\!\\(\\*SubscriptBox[SuperscriptBox[\\(\[CapitalGamma]\\), \\(\[Alpha]\\)], \
\\\n\\(\[Beta]\[Gamma]\\)]\\) == \\!\\(\\*SubscriptBox[SuperscriptBox[\\(\\\n\
\[CapitalGamma]\\), \\(\[Alpha]\\)], \\(\[Gamma]\[Beta]\\)]\\), \\\n[MTW] Box \
10.2, page 250 \>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GammaSymmetryRule", " ", "=", " ", 
    RowBox[{"Echo", "[", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[CapitalGamma]", "[", 
        RowBox[{"u_", ",", " ", 
         RowBox[{"\[ScriptCapitalD]", "[", "b_", "]"}], ",", " ", 
         RowBox[{"\[ScriptCapitalD]", "[", "c_", "]"}]}], "]"}], " ", ":>", 
       "\n", "    ", 
       RowBox[{"\[CapitalGamma]", "[", "\n", "     ", 
        RowBox[{"u", ",", " ", 
         RowBox[{"\[ScriptCapitalD]", "[", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"{", 
             RowBox[{"b", ",", " ", "c"}], "}"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"\[ScriptCapitalD]", "[", "\n", "      ", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"{", 
             RowBox[{"b", ",", " ", "c"}], "}"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], ",", "\n", 
      "   ", "\"\<\[CapitalGamma] Symmetry: \>\""}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<1b. Metric Symmetry: \\!\\(\\*SubscriptBox[\\(g\\), \\(\
\[Alpha]\\\n\[Beta]\\)]\\) == \\!\\(\\*SubscriptBox[\\(g\\), \\(\[Beta]\
\[Alpha]\\)]\\), \\\n[MTW] Equation 8.24, page 210\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Style", "[", "\n", "   ", 
    RowBox[{"\"\<(output manipulated as expected by \[ScriptCapitalU]\\\n\
\[ScriptCapitalD] display rules)\>\"", ",", " ", "Gray"}], "]"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MetricSymmetryRule", " ", "=", " ", 
    RowBox[{"Echo", "[", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "a_", "]"}], ",", " ", 
         RowBox[{"\[ScriptCapitalD]", "[", "b_", "]"}]}], "]"}], " ", ":>", 
       "\n", "    ", 
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"{", 
             RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"\[ScriptCapitalD]", "[", "\n", "      ", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"{", 
             RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], ",", "\n", 
      "   ", "\"\<g Symmetry\>\""}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<1c. Metric Compatibility Postulates \
\\!\\(\\*SubscriptBox[\\(\\\n\[Del]\\), \
\\([\[Lambda]\\)]\\)\\!\\(\\*SubscriptBox[\\(g\\), \\\n\
\\(\[Mu]\[Nu]\\(]\\)\\)]\\) = 0 [MTW] Eqn 8.23 & Chapter 14.\>\"", "]"}], 
   ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Term", " ", "1"}], ":", " ", 
    RowBox[{"\\!", 
     RowBox[{"\\(", "\n", 
      RowBox[{
       RowBox[{"\\*", 
        RowBox[{"SubscriptBox", "[", 
         RowBox[{
          RowBox[{"\\(", "\[Del]", "\\)"}], ",", " ", 
          RowBox[{"\\(", "\[Lambda]", "\\)"}]}], "]"}]}], "\n", 
       RowBox[{"\\*", 
        RowBox[{"SubscriptBox", "[", 
         RowBox[{
          RowBox[{"\\(", "g", "\\)"}], ",", " ", 
          RowBox[{"\\(", "\[Mu]\[Nu]", "\\)"}]}], "]"}]}]}], "\\)"}]}]}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"term1", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", " ", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], ",", " ", 
       "\n", "     ", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Lambda]", "]"}], "]"}]}], "]"}], 
     " ", "/.", " ", "GammaSymmetryRule"}], " ", "/.", " ", "\n", "   ", 
    "MetricSymmetryRule"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"TensorForm", "[", "term1", "]"}], ",", " ", "\n", 
     "  ", "\"\<0 = \\!\\(\\*SubscriptBox[\\(\[Del]\\), \\\n\
\\(\[Lambda]\\)]\\)\\!\\(\\*SubscriptBox[\\(g\\), \\(\[Mu]\[Nu]\\)]\\) \
=\>\""}], "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Term", " ", "2"}], ":", " ", 
    RowBox[{
     RowBox[{"\\!", 
      RowBox[{"\\(", "\n", 
       RowBox[{
        RowBox[{"\\*", 
         RowBox[{"SubscriptBox", "[", 
          RowBox[{
           RowBox[{"\\(", "\[Del]", "\\)"}], ",", " ", 
           RowBox[{"\\(", "\[Mu]", "\\)"}]}], "]"}]}], "\n", 
        RowBox[{"\\*", 
         RowBox[{"SubscriptBox", "[", 
          RowBox[{
           RowBox[{"\\(", "g", "\\)"}], ",", " ", 
           RowBox[{"\\(", "\[Nu]\[Lambda]", "\\)"}]}], "]"}]}]}], "\\)"}]}], " ", 
     RowBox[{"(", 
      RowBox[{"Left", "-", 
       RowBox[{"Cycle", " ", "Indices"}]}], ")"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"term2", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], ",", " ", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Lambda]", "]"}]}], "]"}], ",", 
       " ", "\n", "     ", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], "]"}], " ",
      "/.", " ", "GammaSymmetryRule"}], " ", "/.", " ", "\n", "   ", 
    "MetricSymmetryRule"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"TensorForm", "[", "term2", "]"}], ",", " ", "\n", 
     "  ", "\"\<0 = \\!\\(\\*SubscriptBox[\\(\[Del]\\), \\(\[Mu]\\)]\\)\\!\\(\
\\*SubscriptBox[\\\n\\(g\\), \\(\[Mu]\[Lambda]\\)]\\) =\>\""}], "]"}], ";"}], 
  "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Term", " ", "3"}], ":", " ", 
    RowBox[{
     RowBox[{"\\!", 
      RowBox[{"\\(", "\n", 
       RowBox[{
        RowBox[{"\\*", 
         RowBox[{"SubscriptBox", "[", 
          RowBox[{
           RowBox[{"\\(", "\[Del]", "\\)"}], ",", " ", 
           RowBox[{"\\(", "\[Nu]", "\\)"}]}], "]"}]}], "\n", 
        RowBox[{"\\*", 
         RowBox[{"SubscriptBox", "[", 
          RowBox[{
           RowBox[{"\\(", "g", "\\)"}], ",", " ", 
           RowBox[{"\\(", "\[Lambda]\[Mu]", "\\)"}]}], "]"}]}]}], "\\)"}]}], " ", 
     RowBox[{"(", 
      RowBox[{"Left", "-", 
       RowBox[{"Cycle", " ", "Indices"}]}], ")"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"term3", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Lambda]", "]"}], ",", " ", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}]}], "]"}], ",", " ", 
       "\n", "     ", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], " ",
      "/.", " ", "GammaSymmetryRule"}], " ", "/.", " ", "\n", "   ", 
    "MetricSymmetryRule"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"TensorForm", "[", "term3", "]"}], ",", " ", "\n", 
    "  ", "\"\<0 = \\!\\(\\*SubscriptBox[\\(\[Del]\\), \
\\(\[Nu]\\)]\\)\\!\\(\\*SubscriptBox[\\\n\\(g\\), \\(\[Lambda]\[Mu]\\)]\\) \
=\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<2. CYCLIC PERMUTATION TRICK \
---------------------------------------------\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Write 'Koszul' sum of \[Del]g permutations that isolates \
a \\\n\[CapitalGamma] term.\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<[MTW] Equation 8.24b, page 210, in coordinate basis \\\n\
(\\!\\(\\*SubscriptBox[\\(c\\), \\(abc\\)]\\)===0)\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<The Linear Combination 0 = (\\!\\(\\*SubscriptBox[\\(\
\[Del]\\), \\(\\\n\[Mu]\\)]\\)\\!\\(\\*SubscriptBox[\\(g\\), \
\\(\[Nu]\[Lambda]\\)]\\) + \\\n\\!\\(\\*SubscriptBox[\\(\[Del]\\), \
\\(\[Nu]\\)]\\)\\!\\(\\*SubscriptBox[\\(g\\), \\\n\\(\[Lambda]\[Mu]\\)]\\) - \
\\!\\(\\*SubscriptBox[\\(\[Del]\\), \\(\[Lambda]\\)]\\\n\
\\)\\!\\(\\*SubscriptBox[\\(g\\), \\(\[Mu]\[Nu]\\)]\\)) ===\>\"", "]"}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"combination", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{"term2", " ", "+", " ", "term3", " ", "-", " ", "term1"}], 
       ")"}]}], ",", " ", "\"\<0 =\>\""}], "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"gammaPart", " ", "=", " ", "\n", "   ", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"List", " ", "@@", " ", "combination"}], ",", " ", 
        RowBox[{
         RowBox[{"!", " ", 
          RowBox[{"FreeQ", "[", 
           RowBox[{"#", ",", " ", "\[CapitalGamma]"}], "]"}]}], " ", "&"}]}], 
       "]"}], " ", "//", " ", "Total"}]}], ",", "\n", 
    "  ", "\"\<\[CapitalGamma] part =\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"gammaPartCanonical", " ", "=", " ", 
     RowBox[{"gammaPart", " ", "//", " ", "CanonicalizeIndices"}]}], ",", 
    "\n", "  ", "\"\<\[CapitalGamma] part (canonical) =\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"metricPartials", " ", "=", " ", "\n", "   ", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"List", " ", "@@", " ", "combination"}], ",", " ", 
        RowBox[{
         RowBox[{"FreeQ", "[", 
          RowBox[{"#", ",", " ", "\[CapitalGamma]"}], "]"}], " ", "&"}]}], 
       "]"}], " ", "//", " ", "Total"}]}], ",", "\n", 
    "  ", "\"\<g partials\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<3. SOLVE FOR \[CapitalGamma] \
----------------------------------------------------------\>\"", "]"}], ";"}],
   "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Equation", ":", " ", 
     RowBox[{"gammaPart", " ", "+", " ", "metricPartials"}]}], " ", "=", " ", 
    
    RowBox[{"0", " ", "=", 
     RowBox[{
      RowBox[{">", " ", 
       RowBox[{"-", "gammaPart"}]}], " ", "=", " ", 
      RowBox[{"\\\n", "metricPartials"}]}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<3a. Equation to solve:\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"lhsRaw", " ", "=", " ", 
   RowBox[{"-", "gammaPartCanonical"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rhsRaw", " ", "=", " ", "metricPartials"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"TensorForm", "[", 
      RowBox[{"lhsRaw", " ", "==", " ", "rhsRaw"}], "]"}], ",", 
     " ", "\"\<Isolated Equation:\>\""}], "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<3b. Find correct \\!\\(\\*SuperscriptBox[\\(g\\), \\(-1\
\\)]\\) to \\\nmultiply through.\>\"", "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Find", " ", "the", " ", "metric", " ", "inside", " ", "the", " ",
     "LHS", " ", "term"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"metricFound", " ", "=", " ", 
      RowBox[{"First", "[", 
       RowBox[{"Cases", "[", 
        RowBox[{"lhsRaw", ",", " ", 
         RowBox[{"g", "[", "__", "]"}], ",", " ", "Infinity"}], "]"}], 
       "]"}]}], ",", " ", "\"\<g found\>\""}], "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "Find", " ", "the", " ", "Gamma", " ", "inside", " ", "the", " ",
     "LHS", " ", "term"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"gammaFound", " ", "=", " ", 
