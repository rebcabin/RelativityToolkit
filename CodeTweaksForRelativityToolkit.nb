           ",", " ", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]", "]"}], "]"}]}], 
         "]"}]}], ";", "\n", "  ", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Assertion", ":", " ", 
         RowBox[{
         "Check", " ", "for", " ", "generated", " ", "dummy", " ", "indices", 
          " ", "to", " ", "ensure", " ", "uniqueness"}]}], " ", "*)"}], "\n", 
       "  ", 
       RowBox[{"allIndices", " ", "=", " ", 
        RowBox[{"Cases", "[", 
