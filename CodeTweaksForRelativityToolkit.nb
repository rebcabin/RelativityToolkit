        RowBox[{"prettyResult", ",", " ", 
         RowBox[{"A", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "_", "]"}], "]"}]}], "]"}], "]"}],
       ",", "\n", 
      "  ", "\"\<4. \\!\\(\\*SuperscriptBox[\\(A\\), \\(\[Gamma]'\\(\\\\\\ \\\
\n\\)\\)]\\)\\!\\(\\*SubscriptBox[SuperscriptBox[\\(\[CapitalGamma]\\), \\(\\\
\\\\ \\\n\\(\[Alpha]'\\)\\)], \\(\[Beta]' \[Gamma]'\\)]\\) = \>\""}], "]"}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"4.", "APPLY", " ", "QUOTIENT", " ", "THEOREM"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Extract", " ", "the", " ", "coefficient", " ", "of", " ", 
      RowBox[{"A", "^", "cp"}]}], "=", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "cp", "]"}], "]"}], "."}]}], "*)"}], 
   "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"temporarily", " ", "force", " ", "index", " ", "cp"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"inverseVectorRule", " ", "=", " ", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "idx_", "]"}], "]"}], " ", ":>", 
      "\n", "   ", 
      RowBox[{
       RowBox[{"Partials", "[", 
        RowBox[{
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "idx", "]"}], "]"}], ",", " ", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "cp", "]"}], "]"}]}], "]"}], "*", 
       "\n", "    ", 
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "cp", "]"}], "]"}]}]}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"Apply", " ", "to", " ", "residual"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "ensuring", " ", "every", " ", "A", " ", "term", " ", "is", " ", "linear",
      " ", "in", " ", 
     RowBox[{"A", "^", "cp"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rhsWithTargetA", " ", "=", " ", 
     RowBox[{"gammaPrimeTimesVector", " ", "/.", " ", "inverseVectorRule"}]}],
     ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", 
     RowBox[{"(", "strip", ")"}], " ", "the", " ", "coefficient"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"finalGammaLaw", " ", "=", " ", 
