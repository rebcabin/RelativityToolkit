     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "\[Mu]23"], 
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "bp"]}]]}], "+", 
  RowBox[{
