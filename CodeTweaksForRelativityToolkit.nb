        RowBox[{"Partials", "[", 
         RowBox[{"Aprimed", ",", " ", "xprimed"}], "]"}], " ", "//.", " ", 
        "allRules"}], ",", "\n", 
       "   ", "\"\<2b. Broken partial \
\\!\\(\\*SubscriptBox[SuperscriptBox[\\(A\\), \\(\\\n\[Alpha]'\\)], \\(, \
\\(\\\\\\ \\)\\(\[Beta]'\\)\\)]\\) =\>\""}], "]"}]}], ";"}], "\n", 
