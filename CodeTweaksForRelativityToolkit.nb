   RowBox[{"(*", " ", 
    RowBox[{
    "1.2", " ", "Expand", " ", "algebraically", " ", "and", " ", "apply", " ",
      "torsion", " ", "rules"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
