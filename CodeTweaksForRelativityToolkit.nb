             "\[ScriptCapitalU]", " ", "|", " ", "\[ScriptCapitalD]"}], ")"}],
             "[", "s_Symbol", "]"}], " ", ":>", " ", "s"}], ",", " ", 
          "Infinity"}], "]"}]}], ";", "\n", "  ", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Filter", " ", "for", " ", "symbols", " ", "that", " ", "look", " ", 
         "like", " ", "generated", " ", "Lambdas"}], " ", "*)"}], "\n", "  ", 
       
       RowBox[{"generatedDummies", " ", "=", " ", 
