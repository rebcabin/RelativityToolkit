        "\n", "   ", "\"\<1. \[ScriptCapitalU]\[ScriptCapitalD] says \\\n\
\\!\\(\\*SubscriptBox[SuperscriptBox[\\(A\\), \\(\[Alpha]'\\)], \\(; \
\\(\\\\\\ \\)\\\n\\(\[Beta]'\\)\\)]\\) =\>\""}], "]"}]}], ";"}], "\n", "\n", 
