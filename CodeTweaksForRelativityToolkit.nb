       RowBox[{"\[PartialD]", 
        RowBox[{"x", "^", "\[Mu]"}]}], "/", 
       RowBox[{"\[PartialD]", 
        RowBox[{"x", "^", 
         RowBox[{"\[Beta]", "'"}]}]}]}], 
      RowBox[{"Subscript", "[", 
       RowBox[{"A", ",", " ", ",", 
        RowBox[{"\\\n", "\[Mu]"}]}], "]"}]}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Condition", "/;", 
     RowBox[{"!", 
