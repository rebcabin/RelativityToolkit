Cell[CellGroupData[{

Cell["The Commutator", "Section",
 CellChangeTimes->{{3.9774033383195677`*^9, 
  3.977403342304595*^9}},ExpressionUUID->"6c0db613-6c9e-4dcd-9409-\
61ea194a30b8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"DEFINITION", ":", 
    RowBox[{"The", " ", "Commutator"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Del]", "\[Gamma]"}], 
     RowBox[{
      SubscriptBox["\[Del]", "\[Delta]"], 
      SuperscriptBox["A", "\[Alpha]"]}]}], " ", "-", " ", 
    RowBox[{
     SubscriptBox["\[Del]", "\[Delta]"], 
     RowBox[{
      SubscriptBox["\[Del]", "\[Gamma]"], 
      SuperscriptBox["A", "\[Alpha]"]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"term1", "=", 
       RowBox[{"CD", "[", 
        RowBox[{
         RowBox[{"CD", "[", 
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]", "]"}], "]"}], ",", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "\[Delta]", "]"}], "]"}]}], 
          "]"}], ",", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Gamma]", "]"}], "]"}]}], 
        "]"}]}], 
      ",", "\"\<\[Del]\[Gamma]\!\(\*SubscriptBox[\(\[Del]\), \
\(\[Delta]\)]\)\!\(\*SuperscriptBox[\(A\), \(\[Beta]\)]\):\>\""}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Echo", "[", 
      RowBox[{
       RowBox[{"term2", "=", 
        RowBox[{"CD", "[", 
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{
            RowBox[{"A", "[", 
             RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]", "]"}], "]"}], ",", 
            
            RowBox[{"x", "[", 
             RowBox[{"\[ScriptCapitalU]", "[", "\[Gamma]", "]"}], "]"}]}], 
           "]"}], ",", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "\[Delta]", "]"}], "]"}]}], 
         "]"}]}], 
       ",", "\"\<\!\(\*SubscriptBox[\(\[Del]\), \
\(\[Delta]\)]\)\!\(\*SubscriptBox[\(\[Del]\), \
\(\[Gamma]\)]\)\!\(\*SuperscriptBox[\(A\), \(\[Beta]\)]\):\>\""}], "]"}], ";;",
      "\[IndentingNewLine]", "\n", 
     RowBox[{"Echo", "[", 
      RowBox[{
       RowBox[{"commutator", "=", 
        RowBox[{"term1", "-", "term2"}]}], ",", 
       "\[IndentingNewLine]", "\"\<raw commutator\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"STEP", " ", "1"}], ":", " ", "Simplify"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"1.1", " ", "Expand", " ", "derivatives"}], " ", "*)"}], "\[IndentingNewLine]",
    " ", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"expanded", "=", 
       RowBox[{"ExpandDerivatives", "[", "commutator", "]"}]}], ",", 
      "\[IndentingNewLine]", "\"\<xpd commutator:\>\""}], "]"}], ";"}], " ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"tmp$", "=", 
       RowBox[{"expanded", "-", "commutator"}]}], 
      ",", "\"\<Expanded - SealedBox diagnostic:\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "1.2", " ", "Expand", " ", "algebraically", " ", "and", " ", "apply", " ",
      "torsion", " ", "rules"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "crucial", " ", "to", " ", "separate", " ", "\[CapitalGamma]", "*", 
     "Partial", " ", "from", " ", "\[CapitalGamma]", "*", "\[CapitalGamma]"}],
     " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"simplified", "=", 
       RowBox[{
        RowBox[{"CanonicalizeIndices", "[", 
         RowBox[{"expanded", "//", "Expand"}], "]"}], "//.", 
        "torsionRules"}]}], ",", 
      "\[IndentingNewLine]", "\"\<alg. xp + torsion elmin:\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"STEP", " ", "2"}], ":", " ", 
     RowBox[{"Verify", " ", "Algebra"}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Does", " ", "the", " ", "second", " ", "derivative", " ", "of", " ", "A",
      " ", 
     RowBox[{"vanish", "?"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"hasSecondDerivative", "=", 
       RowBox[{"!", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"simplified", ",", 
          RowBox[{"Partials", "[", 
           RowBox[{"Partials", "[", "__", "]"}], "]"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "\"\<test: has 2d derivs?\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Apply", " ", "Quotient", " ", "Theorem"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"rawRiemann", "=", 
       RowBox[{"ExtractCoefficient", "[", 
        RowBox[{"simplified", ",", "A"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "\"\<raw Riemann\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n=== THE RIEMANN CURVATURE TENSOR ===\>\"", "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"5.", " ", "Readable", " ", "Greek"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"TensorForm", "[", "rawRiemann", "]"}], ",", 
      " ", "\"\<\!\(\*SubscriptBox[SuperscriptBox[\(R\), \(\[Alpha]\)], \(\
\[Lambda]\[Gamma]\[Delta]\)]\) =\>\""}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9774033443966503`*^9, 3.977403377320426*^9}, {
   3.977403413067555*^9, 3.9774035803718023`*^9}, {3.9774036238519793`*^9, 
