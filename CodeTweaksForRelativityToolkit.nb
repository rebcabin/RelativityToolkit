Cell[CellGroupData[{

Cell["Covariant Derivatives", "Section",
 CellChangeTimes->{{3.977354529427115*^9, 
  3.977354537373464*^9}},ExpressionUUID->"94fb8ff3-1f69-48e9-84b7-\
a5e61141ea52"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"ap", ",", " ", "bp", ",", " ", "mu"}], "]"}], ";"}], "\n", "\n", 
  
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "1"}], ":", " ", 
    RowBox[{"Define", " ", "the", " ", "Input"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Partial", " ", "derivative", " ", "of", " ", "the", " ", "Transformed", " ",
     "Vector", " ", 
    RowBox[{"A", "'"}], " ", 
    RowBox[{"w", ".", "r", ".", "t"}], " ", 
    RowBox[{"x", "'"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Input", ":", " ", 
    RowBox[{"via", " ", "Partials"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"inputTerm", " ", "=", " ", 
    RowBox[{"Echo", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"Partials", "[", "\n", "    ", 
       RowBox[{"(*", 
        RowBox[{"Expand", " ", 
         RowBox[{"A", "^", 
          RowBox[{"\[Alpha]", "'"}]}], " ", "into", " ", "Jac", " ", "*", " ",
          "\n", "    ", 
         RowBox[{"A", "^", "\[Mu]"}], " ", "immediately", " ", "via", " ", 
         "existing", " ", "rule"}], "*)"}], "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "ap", "]"}], "]"}], " ", "/.", 
         " ", "robustTransformRules"}], ",", " ", "\n", "    ", 
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], ",", 
      "\n", "   ", "\"\<1. Input \!\(\*SubscriptBox[\(\[PartialD]\), \
\(\[Beta]'\)]\)(\!\(\*SuperscriptBox[\(A\), \(\[Alpha]'\)]\)) \[Congruent] \!\
\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Alpha]'\)], \(, \(\[Beta]'\)\)]\):\
\>\""}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "2"}], ":", 
