           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], "]"}], 
         ",", " ", "\n", "    ", "\"\<CD of Scalar reduces to Partial\>\""}], 
        "]"}], ";", "\n", "    ", "\n", "  ", 
       RowBox[{"AssertTrue", "[", 
        RowBox[{
         RowBox[{"FreeQ", "[", 
          RowBox[{"scalarCD", ",", " ", "\[CapitalGamma]"}], "]"}], ",", " ", 
         "\n", "    ", "\"\<Scalar CD contains no Connection \
Coefficients\>\""}], "]"}], ";"}]}], "\n", "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"TEST", ":", " ", 
     RowBox[{"Nested", " ", "Covariant", " ", "Derivatives", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Stress", " ", "Test", " ", "for", " ", "Alpha"}], "-", 
        "Conversion"}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "nestedCD", ",", " ", "allIndices", ",", " ", "generatedDummies"}], 
       "}"}], ",", "\n", "  ", "\n", "  ", 
      RowBox[{
       RowBox[{"nestedCD", " ", "=", " ", 
        RowBox[{"CD", "[", 
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{
            RowBox[{"A", "[", 
             RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", 
            " ", 
            RowBox[{"x", "[", 
