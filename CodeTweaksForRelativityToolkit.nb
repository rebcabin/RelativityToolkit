      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"List", " ", "@@", " ", "combination"}], ",", " ", 
        RowBox[{
         RowBox[{"FreeQ", "[", 
          RowBox[{"#", ",", " ", "\[CapitalGamma]"}], "]"}], " ", "&"}]}], 
       "]"}], " ", "//", " ", "Total"}]}], ",", "\n", 
    "  ", "\"\<g partials\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<3. SOLVE FOR \[CapitalGamma] \
----------------------------------------------------------\>\"", "]"}], ";"}],
   "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Equation", ":", " ", 
     RowBox[{"gammaPart", " ", "+", " ", "metricPartials"}]}], " ", "=", " ", 
    
    RowBox[{"0", " ", "=", 
     RowBox[{
      RowBox[{">", " ", 
       RowBox[{"-", "gammaPart"}]}], " ", "=", " ", 
      RowBox[{"\\\n", "metricPartials"}]}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<3a. Equation to solve:\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"lhsRaw", " ", "=", " ", 
   RowBox[{"-", "gammaPartCanonical"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rhsRaw", " ", "=", " ", "metricPartials"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"TensorForm", "[", 
      RowBox[{"lhsRaw", " ", "==", " ", "rhsRaw"}], "]"}], ",", 
     " ", "\"\<Isolated Equation:\>\""}], "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<3b. Find correct \\!\\(\\*SuperscriptBox[\\(g\\), \\(-1\
\\)]\\) to \\\nmultiply through.\>\"", "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Find", " ", "the", " ", "metric", " ", "inside", " ", "the", " ",
     "LHS", " ", "term"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"metricFound", " ", "=", " ", 
      RowBox[{"First", "[", 
       RowBox[{"Cases", "[", 
        RowBox[{"lhsRaw", ",", " ", 
         RowBox[{"g", "[", "__", "]"}], ",", " ", "Infinity"}], "]"}], 
       "]"}]}], ",", " ", "\"\<g found\>\""}], "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "Find", " ", "the", " ", "Gamma", " ", "inside", " ", "the", " ",
     "LHS", " ", "term"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"gammaFound", " ", "=", " ", 
      RowBox[{"First", "[", 
       RowBox[{"Cases", "[", 
        RowBox[{"lhsRaw", ",", " ", 
         RowBox[{"\[CapitalGamma]", "[", "__", "]"}], ",", " ", "Infinity"}], 
        "]"}], "]"}]}], ",", "\n", "   ", "\"\<\[CapitalGamma] found\>\""}], 
    "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "Extract", " ", "raw", " ", "symbols", " ", "from", " ", "the", 
    " ", "indices"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"metricIndices", " ", "=", " ", 
     RowBox[{"First", " ", "/@", " ", 
      RowBox[{"(", 
       RowBox[{"List", " ", "@@", " ", "metricFound"}], ")"}]}]}], ",", 
    " ", "\"\<g indices\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"gammaUpIndex", " ", "=", " ", 
      RowBox[{"First", "[", 
       RowBox[{"First", "[", "gammaFound", "]"}], "]"}]}], ",", " ", "\n", 
     "  ", "\"\<\[CapitalGamma] up index\>\""}], "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"4.", " ", "Identify", " ", "the", " ", "Target", " ", "Index"}], 
   "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "The", " ", "g", " ", "index", " ", "that", " ", "matches", " ", 
     "\[CapitalGamma]", " ", "up"}], "-", 
    RowBox[{"index", " ", "is", " ", "the", " ", 
     RowBox[{"Dummy", ".", " ", 
      RowBox[{"\\\n", "The"}]}], " ", "other", " ", "is", " ", "the", " ", 
     RowBox[{"Target", "."}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"targetIndex", " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"metricIndices", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "===", " ", "gammaUpIndex"}], ",",
         "\n", "    ", 
        RowBox[{"metricIndices", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
        RowBox[{"metricIndices", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ",", 
     " ", "\"\<target index\>\""}], "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "5.", " ", "Construct", " ", "the", " ", "specific", " ", "Inverse", " ", 
    "needed"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"invMetricFactor", " ", "=", " ", "\n", "   ", 
