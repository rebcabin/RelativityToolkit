        RowBox[{"\[ScriptCapitalU]", "[", "\[Sigma]", "]"}], ",", " ", 
        RowBox[{"\[ScriptCapitalU]", "[", "targetIndex", "]"}]}], "]"}]}]}], ",",
     "\n", "   ", "\"\<\\!\\(\\*FractionBox[\\(1\\), \
\\(2\\)]\\)\\!\\(\\*SuperscriptBox[\\(g\\), \\(-1\\\n\\)]\\) =\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
