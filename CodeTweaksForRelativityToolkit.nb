      RowBox[{"A", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "cp", "]"}], "]"}], "."}]}], "*)"}], 
   "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"temporarily", " ", "force", " ", "index", " ", "cp"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"inverseVectorRule", " ", "=", " ", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "idx_", "]"}], "]"}], " ", ":>", 
      "\n", "   ", 
      RowBox[{
       RowBox[{"Partials", "[", 
        RowBox[{
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "idx", "]"}], "]"}], ",", " ", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "cp", "]"}], "]"}]}], "]"}], "*", 
       "\n", "    ", 
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "cp", "]"}], "]"}]}]}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"Apply", " ", "to", " ", "residual"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
