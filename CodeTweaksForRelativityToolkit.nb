in the \\\nfuture)\>\"", ",", " ", "Gray"}], "]"}], "]"}], ";"}], "\n", "\n", 
  
  RowBox[{"(*", 
   RowBox[{"Execute", " ", "the", " ", "algebra"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
