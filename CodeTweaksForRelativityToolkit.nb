  RowBox[{
  "Print", "[", "\"\<1a. Torsion-free geometry: \\\n\
\\!\\(\\*SubscriptBox[SuperscriptBox[\\(\[CapitalGamma]\\), \\(\[Alpha]\\)], \
\\\n\\(\[Beta]\[Gamma]\\)]\\) == \\!\\(\\*SubscriptBox[SuperscriptBox[\\(\\\n\
\[CapitalGamma]\\), \\(\[Alpha]\\)], \\(\[Gamma]\[Beta]\\)]\\), \\\n[MTW] Box \
10.2, page 250 \>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GammaSymmetryRule", " ", "=", " ", 
    RowBox[{"Echo", "[", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[CapitalGamma]", "[", 
        RowBox[{"u_", ",", " ", 
         RowBox[{"\[ScriptCapitalD]", "[", "b_", "]"}], ",", " ", 
         RowBox[{"\[ScriptCapitalD]", "[", "c_", "]"}]}], "]"}], " ", ":>", 
       "\n", "    ", 
       RowBox[{"\[CapitalGamma]", "[", "\n", "     ", 
        RowBox[{"u", ",", " ", 
         RowBox[{"\[ScriptCapitalD]", "[", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"{", 
