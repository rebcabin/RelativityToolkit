above)\>\"", ",", "\n", "    ", "Gray"}], "]"}], "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<3c. Multiply and Contract\>\"", "]"}], ";"}], 
  "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"\[Delta]", "-", 
