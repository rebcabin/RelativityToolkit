(\\!\\(\\*SubscriptBox[SuperscriptBox[\\(A\\), \\\n\\(\[Alpha]'\\)], \\(; \\(\
\\\\\\ \\)\\(\[Beta]'\\)\\)]\\) - \\\n\
\\!\\(\\*SubscriptBox[SuperscriptBox[\\(A\\), \\(\[Alpha]'\\)], \\(, \
\\(\\\\\\ \\)\\\n\\(\[Beta]'\\)\\)]\\)) =\>\""}], "]"}]}], ";"}], "\n", "\n", 
   
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n=== \[CapitalGamma] TRANSFORMATION LAW (without \
quotient) ===\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<The term involving \[CapitalGamma]' must satisfy:\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"HERE", " ", "IS", " ", "THE", " ", "MAGIC"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Tensor", " ", "Form", " ", "does", " ", "index", " ", "coalescing", " ", 
     "and", " ", 
     RowBox[{"simplification", "!"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Echo", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"TensorForm", "[", 
       RowBox[{"Collect", "[", 
        RowBox[{"prettyResult", ",", " ", 
         RowBox[{"A", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "_", "]"}], "]"}]}], "]"}], "]"}],
       ",", "\n", 
      "  ", "\"\<4. \\!\\(\\*SuperscriptBox[\\(A\\), \\(\[Gamma]'\\(\\\\\\ \\\
\n\\)\\)]\\)\\!\\(\\*SubscriptBox[SuperscriptBox[\\(\[CapitalGamma]\\), \\(\\\
\\\\ \\\n\\(\[Alpha]'\\)\\)], \\(\[Beta]' \[Gamma]'\\)]\\) = \>\""}], "]"}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"4.", "APPLY", " ", "QUOTIENT", " ", "THEOREM"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Extract", " ", "the", " ", "coefficient", " ", "of", " ", 
      RowBox[{"A", "^", "cp"}]}], "=", 
