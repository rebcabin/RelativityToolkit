Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"DEFINITION", ":", 
    RowBox[{"The", " ", "Commutator"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Rho]"], 
     RowBox[{
      SubscriptBox["\[Del]", "\[Nu]"], 
      SuperscriptBox["A", "\[Mu]"]}]}], " ", "-", " ", 
    RowBox[{
     SubscriptBox["\[Del]", "\[Nu]"], 
     RowBox[{
      SubscriptBox["\[Del]", "\[Rho]"], 
      SuperscriptBox["A", "\[Mu]"]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"term1", "=", 
       RowBox[{"CD", "[", 
        RowBox[{
         RowBox[{"CD", "[", 
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], 
         ",", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]", "]"}], "]"}]}], "]"}]}],
       ",", "\"\<\!\(\*SubscriptBox[\(\[Del]\), \
\(\[Rho]\)]\)\!\(\*SubscriptBox[\(\[Del]\), \(\[Nu]\)]\)\!\(\*SuperscriptBox[\
\(A\), \(\[Mu]\)]\):\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Echo", "[", 
      RowBox[{
       RowBox[{"term2", "=", 
        RowBox[{"CD", "[", 
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{
            RowBox[{"A", "[", 
             RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", 
            RowBox[{"x", "[", 
             RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]", "]"}], "]"}]}], 
           "]"}], ",", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}]}],
        ",", "\"\<\!\(\*SubscriptBox[\(\[Del]\), \
\(\[Nu]\)]\)\!\(\*SubscriptBox[\(\[Del]\), \(\[Rho]\)]\)\!\(\*SuperscriptBox[\
\(A\), \(\[Mu]\)]\):\>\""}], "]"}], ";;", "\[IndentingNewLine]", "\n", 
     RowBox[{"Echo", "[", 
      RowBox[{
       RowBox[{"commutator", "=", 
        RowBox[{"term1", "-", "term2"}]}], ",", 
       "\[IndentingNewLine]", "\"\<raw commutator\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"STEP", " ", "1"}], ":", " ", "Simplify"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"1.1", " ", "Expand", " ", "derivatives"}], " ", "*)"}], "\[IndentingNewLine]",
    " ", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"expanded", "=", 
       RowBox[{"ExpandDerivatives", "[", "commutator", "]"}]}], ",", 
      "\[IndentingNewLine]", "\"\<xpd commutator:\>\""}], "]"}], ";"}], " ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"tmp$", "=", 
       RowBox[{"expanded", "-", "commutator"}]}], 
      ",", "\"\<Expanded - SealedBox diagnostic:\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "1.2", " ", "Expand", " ", "algebraically", " ", "and", " ", "apply", " ",
      "torsion", " ", "rules"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "crucial", " ", "to", " ", "separate", " ", "\[CapitalGamma]", "*", 
     "Partial", " ", "from", " ", "\[CapitalGamma]", "*", "\[CapitalGamma]"}],
     " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"simplified", "=", 
       RowBox[{
        RowBox[{"CanonicalizeIndices", "[", 
         RowBox[{"expanded", "//", "Expand"}], "]"}], "//.", 
        "torsionRules"}]}], ",", 
      "\[IndentingNewLine]", "\"\<alg. xp + torsion elmin:\>\""}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"STEP", " ", "2"}], ":", " ", 
     RowBox[{"Verify", " ", "Algebra"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Does", " ", "the", " ", "second", " ", "derivative", " ", "of", " ", "A",
      " ", 
     RowBox[{"vanish", "?"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"hasSecondDerivative", "=", 
       RowBox[{"!", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"simplified", ",", 
          RowBox[{"Partials", "[", 
           RowBox[{"Partials", "[", "__", "]"}], "]"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "\"\<test: has 2d derivs?\>\""}], "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Apply", " ", "Quotient", " ", "Theorem"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"rawRiemann", "=", 
       RowBox[{"ExtractCoefficient", "[", 
        RowBox[{"simplified", ",", "A"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "\"\<raw Riemann\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n=== THE RIEMANN CURVATURE TENSOR ===\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"5.", " ", "Readable", " ", "Greek"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"TensorForm", "[", "rawRiemann", "]"}], ",", 
      " ", "\"\<\!\(\*SubscriptBox[SuperscriptBox[\(R\), \(\[Mu]\)], \(\
\[Lambda]\[Nu]\[Rho]\)]\) =\>\""}], "]"}], ";"}]}]}]], "Input",
