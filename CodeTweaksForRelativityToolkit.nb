Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"ap", ",", " ", "bp", ",", " ", "mu"}], "]"}], ";"}], "\n", "\n", 
  
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "1"}], ":", " ", 
    RowBox[{"Define", " ", "the", " ", "Input"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Partial", " ", "derivative", " ", "of", " ", "the", " ", "Transformed", " ",
     "Vector", " ", 
    RowBox[{"A", "'"}], " ", 
    RowBox[{"w", ".", "r", ".", "t"}], " ", 
    RowBox[{"x", "'"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Input", ":", " ", 
    RowBox[{"via", " ", "Partials"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"inputTerm", " ", "=", " ", 
    RowBox[{"Echo", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"Partials", "[", "\n", "    ", 
       RowBox[{"(*", 
        RowBox[{"Expand", " ", 
         RowBox[{"A", "^", 
          RowBox[{"\[Alpha]", "'"}]}], " ", "into", " ", "Jac", " ", "*", " ",
          "\n", "    ", 
         RowBox[{"A", "^", "\[Mu]"}], " ", "immediately", " ", "via", " ", 
         "existing", " ", "rule"}], "*)"}], "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "ap", "]"}], "]"}], " ", "/.", 
         " ", "robustTransformRules"}], ",", " ", "\n", "    ", 
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], ",", 
      "\n", "   ", "\"\<1. Input \!\(\*SubscriptBox[\(\[PartialD]\), \
\(\[Beta]'\)]\)(\!\(\*SuperscriptBox[\(A\), \(\[Alpha]'\)]\)) \[Congruent] \!\
\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Alpha]'\)], \(, \(\[Beta]'\)\)]\):\
\>\""}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "2"}], ":", 
    RowBox[{"Mechanical", " ", "Expansion"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Apply", " ", "Leibniz", " ", "and", " ", "Chain", " ", "Rule", " ", 
    "repeatedly", " ", "until", " ", "stable"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"expandedTerm", " ", "=", " ", 
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"ExpandDerivatives", "[", "inputTerm", "]"}], ",", "\n", 
      "   ", "\"\<2. Mechanically Expanded Derivative:\>\""}], "]"}]}], ";"}],
   "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "3"}], ":", "Formatting"}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Map", " ", "internal", " ", "unique", " ", "dummies", " ", "to", " ", 
    "readable", " ", "Greek"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"prettyResult", " ", "=", " ", "\n", "  ", 
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"expandedTerm", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ap", " ", "->", " ", 
          RowBox[{"\[Alpha]", "'"}]}], ",", " ", 
         RowBox[{"bp", " ", "->", " ", 
          RowBox[{"\[Beta]", "'"}]}], ",", " ", 
         RowBox[{"mu", " ", "->", " ", "\[Mu]"}]}], "}"}]}], ",", "\n", 
      "   ", "\"\<3. Peek at unique dummy indices\>\""}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"brokenPartial", " ", "=", " ", 
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"TensorForm", "[", "prettyResult", "]"}], ",", "\n", 
     "   ", "\"\<4. Expanded \!\(\*SubscriptBox[SuperscriptBox[\(A\), \(\
\[Alpha]'\)], \(, \(\[Beta]'\)\)]\) in \\\nReadable Greek\>\""}], "]"}]}], 
  ";"}]}], "Code",
 InitializationCell->False,
