      " ", "in", " ", 
     RowBox[{"A", "^", "cp"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rhsWithTargetA", " ", "=", " ", 
     RowBox[{"gammaPrimeTimesVector", " ", "/.", " ", "inverseVectorRule"}]}],
     ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", 
     RowBox[{"(", "strip", ")"}], " ", "the", " ", "coefficient"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"finalGammaLaw", " ", "=", " ", 
     RowBox[{"Coefficient", "[", 
      RowBox[{"rhsWithTargetA", ",", " ", 
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "cp", "]"}], "]"}]}], "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "FINAL", " ", "FORMATTING"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"prettyResult", " ", "=", "\n", "  ", 
     RowBox[{"finalGammaLaw", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ap", " ", "->", " ", 
         RowBox[{"\[Alpha]", "'"}]}], ",", " ", 
        RowBox[{"bp", " ", "->", " ", 
         RowBox[{"\[Beta]", "'"}]}], ",", " ", 
        RowBox[{"cp", " ", "->", " ", 
         RowBox[{"\[Gamma]", "'"}]}], ",", " ", "\n", "    ", 
        RowBox[{"mu", " ", "->", " ", "\[Mu]"}], ",", " ", 
        RowBox[{"nu", " ", "->", " ", "\[Nu]"}]}], "}"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n=== \[CapitalGamma] TRANSFORMATION LAW ===\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<By a Quotient Theorem, stripping A to find \
\[CapitalGamma]':\>\"", "]"}], ";"}], "\n", "\n", 
