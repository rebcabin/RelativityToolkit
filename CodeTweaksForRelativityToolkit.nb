        RowBox[{"Define", " ", "as", " ", "scalar"}], " ", "*)"}], "\n", "  ", 
       RowBox[{"scalarCD", " ", "=", " ", 
        RowBox[{"CD", "[", 
         RowBox[{"phi", ",", " ", 
          RowBox[{"x", "[", 
