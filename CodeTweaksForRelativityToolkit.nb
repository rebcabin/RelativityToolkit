         RowBox[{"TEST", " ", "1"}], ":", " ", 
         RowBox[{"The", " ", "\"\<Happy Path\>\"", " ", 
          RowBox[{"(", 
           RowBox[{"Simple", " ", "Tensor"}], ")"}]}]}], " ", "*)"}], "\n", 
       "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"A", "^", "u_"}], ",", 
         RowBox[{"v", " ", "->", " ", 
          RowBox[{"No", " ", "Parens"}]}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{"checkDisplay", "[", 
        RowBox[{"\"\<Atomic Tensor\>\"", ",", " ", "\n", "    ", 
         RowBox[{"Partials", "[", 
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", " ", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], 
         ",", " ", "\n", "    ", "False"}], "]"}], ";", "\n", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"TEST", " ", "2"}], ":", " ", 
         RowBox[{"The", " ", "\"\<Gamma Glue\>\"", " ", "Case", " ", 
          RowBox[{"(", "Product", ")"}]}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"A", "^", "u"}], " ", "Gamma"}], ")"}], "_"}], ",", 
         RowBox[{"v", " ", "->", " ", 
          RowBox[{"MUST", " ", "HAVE", " ", "PARENS"}]}]}], " ", "*)"}], "\n",
        "  ", 
       RowBox[{"checkDisplay", "[", 
        RowBox[{"\"\<Sealed Product (Gamma Glue)\>\"", ",", " ", "\n", "    ", 
         RowBox[{"Partials", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"A", "[", 
             RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], " ", "*",
             " ", 
            RowBox[{"\[CapitalGamma]", "[", 
             RowBox[{
              RowBox[{"\[ScriptCapitalU]", "[", "a", "]"}], ",", " ", 
              RowBox[{"\[ScriptCapitalD]", "[", "b", "]"}], ",", " ", 
              RowBox[{"\[ScriptCapitalD]", "[", "c", "]"}]}], "]"}]}], ",", 
           " ", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], 
         ",", " ", "\n", "    ", "True"}], "]"}], ";", "\n", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"TEST", " ", "3"}], ":", " ", 
         RowBox[{"The", " ", "\"\<Linearity\>\"", " ", "Case", " ", 
          RowBox[{"(", "Sum", ")"}]}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"A", " ", "+", " ", "B"}], ")"}], "_"}], ",", 
         RowBox[{"v", " ", "->", " ", 
          RowBox[{"MUST", " ", "HAVE", " ", "PARENS"}]}]}], " ", "*)"}], "\n",
        "  ", 
       RowBox[{"checkDisplay", "[", 
        RowBox[{"\"\<Sealed Sum\>\"", ",", " ", "\n", "    ", 
         RowBox[{"Partials", "[", 
          RowBox[{
           RowBox[{"A", " ", "+", " ", "B"}], ",", " ", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], 
         ",", " ", "\n", "    ", "True"}], "]"}], ";", "\n", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"TEST", " ", "4"}], ":", " ", 
         RowBox[{"The", " ", "\"\<Non-Linear\>\"", " ", "Case", " ", 
          RowBox[{"(", "Power", ")"}]}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"A", "^", "2"}], ")"}], "_"}], ",", 
         RowBox[{"v", " ", "->", " ", 
          RowBox[{"MUST", " ", "HAVE", " ", "PARENS"}]}]}], " ", "*)"}], "\n",
        "  ", 
       RowBox[{"checkDisplay", "[", 
        RowBox[{"\"\<Sealed Power\>\"", ",", " ", "\n", "    ", 
         RowBox[{"Partials", "[", 
          RowBox[{
           RowBox[{"A", "^", "2"}], ",", " ", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], 
         ",", " ", "\n", "    ", "True"}], "]"}], ";", "\n", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"TEST", " ", "5"}], ":", " ", 
         RowBox[{"The", " ", "\"\<Funky\>\"", " ", "Case", " ", 
          RowBox[{"(", 
           RowBox[{"Arbitrary", " ", "Function"}], ")"}]}]}], " ", "*)"}], 
       "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", "x", "]"}], "_"}], ",", 
         RowBox[{"v", " ", "->", " ", 
          RowBox[{"No", " ", "Parens", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Head", " ", "is", " ", "Sin"}], ",", " ", 
             RowBox[{"not", " ", 
              RowBox[{
               RowBox[{"Times", "/", "Plus"}], "/", "Power"}]}]}], 
            ")"}]}]}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{"checkDisplay", "[", 
        RowBox[{"\"\<Arbitrary Function (Sin)\>\"", ",", " ", "\n", "    ", 
         RowBox[{"Partials", "[", 
          RowBox[{
           RowBox[{"Sin", "[", "theta", "]"}], ",", " ", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], 
         ",", " ", "\n", "    ", "False"}], "]"}], ";", "\n", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"TEST", " ", "6"}], ":", " ", 
         RowBox[{"Complex", " ", "Nested", " ", "Structure"}]}], " ", "*)"}], 
       "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"A", " ", "*", " ", 
            RowBox[{"(", 
             RowBox[{"B", "+", "C"}], ")"}]}], ")"}], "_"}], ",", 
         RowBox[{"v", " ", "->", " ", 
          RowBox[{"MUST", " ", "HAVE", " ", "PARENS", " ", 
           RowBox[{"(", 
            RowBox[{"Head", " ", "is", " ", "Times"}], ")"}]}]}]}], " ", 
        "*)"}], "\n", "  ", 
       RowBox[{"checkDisplay", "[", 
        RowBox[{"\"\<Nested Math (A*(B+C))\>\"", ",", " ", "\n", "    ", 
         RowBox[{"Partials", "[", 
          RowBox[{
           RowBox[{"A", " ", "*", " ", 
            RowBox[{"(", 
             RowBox[{"B", " ", "+", " ", "C"}], ")"}]}], ",", " ", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], 
         ",", " ", "\n", "    ", "True"}], "]"}], ";"}]}], "\n", "]"}], ";"}],
    "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "==="}], "="}], " ", "*)"}], "\n", 
