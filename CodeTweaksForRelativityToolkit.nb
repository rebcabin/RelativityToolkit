          RowBox[{"_", "\\\n"}], "]"}]}], "]"}], " ", "prevents", " ", 
       "expanding", " ", "a", " ", "Jacobian", " ", "itself", " ", 
       RowBox[{"(", 
        RowBox[{"dx", "/", 
