\\!\\(\\*SubscriptBox[SuperscriptBox[\\(A\\), \\(\\\n\[Alpha]'\\)], \\(, \
\\(\\\\\\ \\)\\(\[Beta]'\\)\\)]\\) =\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gammaPrimeTimesVector", " ", "=", "\n", "  ", 
     RowBox[{"targetTensor", " ", "-", " ", "brokenPartialOnly"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "FORMATTING", " ", 
     RowBox[{"(", 
      RowBox[{"Lovelock", " ", "Style"}], ")"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
