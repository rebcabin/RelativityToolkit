\[Congruent] \\\n\\!\\(\\*SubscriptBox[SuperscriptBox[\\(A\\), \
\\(\[Alpha]'\\)], \\(, \\(\\\\\\ \\)\\\n\\(\[Beta]'\\)\\)]\\):\>\""}], 
     "]"}]}], ";"}], "\n", "\n", 
