       RowBox[{"Cases", "[", 
        RowBox[{"lhsRaw", ",", " ", 
         RowBox[{"\[CapitalGamma]", "[", "__", "]"}], ",", " ", "Infinity"}], 
        "]"}], "]"}]}], ",", "\n", "   ", "\"\<\[CapitalGamma] found\>\""}], 
    "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "Extract", " ", "raw", " ", "symbols", " ", "from", " ", "the", 
    " ", "indices"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"metricIndices", " ", "=", " ", 
     RowBox[{"First", " ", "/@", " ", 
      RowBox[{"(", 
       RowBox[{"List", " ", "@@", " ", "metricFound"}], ")"}]}]}], ",", 
    " ", "\"\<g indices\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"gammaUpIndex", " ", "=", " ", 
      RowBox[{"First", "[", 
       RowBox[{"First", "[", "gammaFound", "]"}], "]"}]}], ",", " ", "\n", 
     "  ", "\"\<\[CapitalGamma] up index\>\""}], "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"4.", " ", "Identify", " ", "the", " ", "Target", " ", "Index"}], 
   "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "The", " ", "g", " ", "index", " ", "that", " ", "matches", " ", 
     "\[CapitalGamma]", " ", "up"}], "-", 
    RowBox[{"index", " ", "is", " ", "the", " ", 
     RowBox[{"Dummy", ".", " ", 
      RowBox[{"\\\n", "The"}]}], " ", "other", " ", "is", " ", "the", " ", 
     RowBox[{"Target", "."}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"targetIndex", " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"metricIndices", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "===", " ", "gammaUpIndex"}], ",",
         "\n", "    ", 
        RowBox[{"metricIndices", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
        RowBox[{"metricIndices", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ",", 
     " ", "\"\<target index\>\""}], "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "5.", " ", "Construct", " ", "the", " ", "specific", " ", "Inverse", " ", 
    "needed"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"invMetricFactor", " ", "=", " ", "\n", "   ", 
