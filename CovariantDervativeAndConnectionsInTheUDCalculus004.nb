  3.977175618510482*^9, 
  3.97717563638277*^9}},ExpressionUUID->"5539db76-9765-4a81-a23a-\
d32ef107c9fd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Hold", "[", 
  RowBox[{"CD", "[", 
