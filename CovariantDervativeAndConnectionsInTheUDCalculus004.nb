}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Solving for Connection Coefficients ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d357a919-1d93-4f7c-933c-65f45deaee56"]
}], "Subsection",
 CellChangeTimes->{{3.977157366603115*^9, 3.9771573818269167`*^9}, {
  3.977158108541811*^9, 3.9771581154153957`*^9}, {3.977158573169484*^9, 
  3.9771585736278048`*^9}, {3.977175639150772*^9, 
  3.9771756426997843`*^9}},ExpressionUUID->"3fbd09dd-237f-49db-93b7-\
706eff8fd2bc"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s have \[ScriptCapitalU]\[ScriptCapitalD] do all the \
dirty work. We\[CloseCurlyQuote]re not only going to solve for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "d48adeac-892b-4e69-bf87-f736694870da"],
 " , assuming only that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["A", "\[Alpha]"], 
     RowBox[{";", " ", "\[Beta]", " "}]], "\[Congruent]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       SuperscriptBox["A", "\[Alpha]"], 
       RowBox[{",", " ", "\[Beta]"}]], " ", "+", " ", 
      RowBox[{
       SuperscriptBox["A", "\[Mu]"], " ", 
       SubscriptBox[
        SuperscriptBox["\[CapitalGamma]", "\[Alpha]"], 
        RowBox[{"\[Beta]", " ", "\[Mu]"}]]}]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"c5f5c83c-3fcf-4263-8b3b-8431f39d2a6b"],
 " is tensorial (already encoded in \[ScriptCapitalU]\[ScriptCapitalD]\
\[CloseCurlyQuote]s ",
 StyleBox["CD", "Input"],
 "), but we\[CloseCurlyQuote]ll derive the transformation law for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "ad1ff2af-4d47-4f63-89d7-6829b8ccd14a"],
 " , proving that \[CapitalGamma] is not tensorial, and show how the \
contraction ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Mu]"], " ", 
    SubscriptBox[
     SuperscriptBox["\[CapitalGamma]", "\[Alpha]"], 
     RowBox[{"\[Beta]", " ", "\[Mu]"}]]}], TraditionalForm]],ExpressionUUID->
  "1f573e0c-9b05-435b-94e7-f9897f6a94a1"],
 " subtracts, exactly, the non-tensorial parts of the messy partial \
derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", " ", "\[Beta]"}]], TraditionalForm]],ExpressionUUID->
  "dc7fe1db-875d-4d3c-9eed-b40d68890e9a"],
 "."
}], "Text",
 CellChangeTimes->{{3.977157413306628*^9, 3.977157443646986*^9}, {
   3.977158000396985*^9, 3.9771581331777763`*^9}, {3.9771584901968613`*^9, 
   3.977158559700755*^9}, {3.977159233230836*^9, 3.977159275659182*^9}, {
   3.97716034733475*^9, 3.9771603831633177`*^9}, 3.977174428436172*^9, {
   3.977174520359071*^9, 3.9771746954389687`*^9}, {3.977176035023839*^9, 
   3.977176083633816*^9}, {3.977343483282104*^9, 3.977343544742365*^9}, {
   3.9776615573639593`*^9, 
   3.977661558498899*^9}},ExpressionUUID->"8bb22f91-235e-459c-8e8f-\
b46a81b15932"],

Cell[TextData[{
 "As usual, ",
 StyleBox["Read The Code",
  FontWeight->"Bold"],
 " and the results. Note specifically how TensorForm does the index \
coalescing and simplification, right where humans go down the drain!"
}], "Text",
 CellChangeTimes->{{3.9771590374457493`*^9, 3.9771591052734623`*^9}, {
   3.9771597568086967`*^9, 3.977159785646925*^9}, {3.977176096714246*^9, 
   3.977176123776059*^9}, 3.97717858536027*^9, {3.9771793912053623`*^9, 
   3.977179445500153*^9}, {3.977226127543551*^9, 3.9772261844233093`*^9}, {
   3.977327259962119*^9, 
   3.9773272626594067`*^9}},ExpressionUUID->"fbc896bf-508c-4339-b94d-\
12ec9ddcd73c"],

Cell[TextData[{
 StyleBox["IMPORTANT",
  FontWeight->"Bold"],
 ": The final step invokes a Quotient Theorem, by which, schematically, (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"T", "'"}], " ", 
       SubscriptBox[
        SuperscriptBox["\[CapitalGamma]", 
         RowBox[{" ", 
          RowBox[{"\[Alpha]", " ", "'"}]}]], 
        RowBox[{
         RowBox[{"\[Beta]", " ", "'"}], " ", 
         RowBox[{"\[Mu]", " ", "'"}]}]]}], "=", 
      RowBox[{
       StyleBox[
        RowBox[{"\[LeftAngleBracket]", "Jacobians", "\[RightAngleBracket]"}],
        FontSlant->"Italic"], " ", "*", " ", "T", " ", 
       SubscriptBox[
        SuperscriptBox["\[CapitalGamma]", 
         RowBox[{" ", "\[Alpha]"}]], 
        RowBox[{"\[Beta]", " ", "\[Mu]"}]]}]}], ")"}], " "}], 
   TraditionalForm]],ExpressionUUID->"b9af3c02-06aa-44fd-a72e-237bcfe9501c"],
 " implies ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["\[CapitalGamma]", 
       RowBox[{" ", 
        RowBox[{"\[Alpha]", " ", "'"}]}]], 
      RowBox[{
       RowBox[{"\[Beta]", " ", "'"}], " ", 
       RowBox[{"\[Mu]", " ", "'"}]}]], "=", 
     RowBox[{
      RowBox[{"\[LeftAngleBracket]", 
       StyleBox["Jacobians",
        FontSlant->"Italic"], "\[RightAngleBracket]"}], " ", "*", " ", 
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", 
        RowBox[{" ", "\[Alpha]"}]], 
       RowBox[{"\[Beta]", " ", "\[Mu]"}]]}]}], ")"}], TraditionalForm]],
  ExpressionUUID->"ef14a006-1506-422e-991f-fd3425e29da2"],
 ", factoring out (quotienting) the tensors ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],ExpressionUUID->
  "541174a4-093d-4abe-849f-3b2a47393158"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "'"], TraditionalForm]],ExpressionUUID->
  "5cecbee6-9dc8-46ec-99bc-429561a8acd1"],
 " and their Jacobians, if and only if (iff) they\[CloseCurlyQuote]re truly \
arbitrary. "
}], "Text",
 CellChangeTimes->{{3.9771591100870857`*^9, 3.977159128116858*^9}, {
  3.977159286045546*^9, 3.977159420408484*^9}, {3.977159457530117*^9, 
  3.977159690082397*^9}, {3.97716047428098*^9, 3.977160484785824*^9}, {
  3.9771761373017*^9, 3.9771765270762587`*^9}, {3.977327759915182*^9, 
  3.977327762317103*^9}, {3.977661581955504*^9, 
  3.977661645271441*^9}},ExpressionUUID->"17472e51-75a1-41a7-bf80-\
7c467e51c9e8"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Lovelock & Rund write dire warnings about these \
theorems, that misapplication is the occasion of many published errors. Here, \
because we know the answer is correct, even by comparison to Lovelock & Rund, \
we\[CloseCurlyQuote]re going to hand-wave the issue, here.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.9771591100870857`*^9, 3.977159128116858*^9}, {
  3.977159286045546*^9, 3.977159420408484*^9}, {3.977159457530117*^9, 
  3.977159690082397*^9}, {3.97716047428098*^9, 3.977160484785824*^9}, {
  3.9771761373017*^9, 3.9771765270762587`*^9}, {3.977327759915182*^9, 
  3.977327762317103*^9}, {3.977661581955504*^9, 
  3.977661666095199*^9}},ExpressionUUID->"bfe25b34-bafe-491e-a40d-\
77fd0b32ab5f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"DERIVATION", ":", 
    RowBox[{
    "The", " ", "Transformation", " ", "Law", " ", "of", " ", "Gamma"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"ap", ",", "bp", ",", "mu", ",", "nu"}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"0.", " ", "SPECIAL", " ", "RULES"}], ",", " ", 
     RowBox[{
     "not", " ", "in", " ", "\[ScriptCapitalU]\[ScriptCapitalD]", " ", 
      "proper"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     SubscriptBox["A", 
      RowBox[{",", 
       RowBox[{"\[Beta]", "'"}]}]], "->", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "\[Mu]"]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{"\[Beta]", "'"}]]}]], 
      SubscriptBox["A", 
       RowBox[{",", "\[Mu]"}]]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Condition", "/;", 
     RowBox[{"!", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{"expr", ",", 
         RowBox[{"x", "[", "_", "]"}]}], "]"}], " ", "prevents", " ", 
       "expanding", " ", "a", " ", "Jacobian", " ", "itself", " ", 
       RowBox[{"(", 
        RowBox[{"dx", "/", 
         RowBox[{"dx", "'"}]}], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"manualChainRule", "=", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Partials", "[", 
        RowBox[{"expr_", ",", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], "/;", 
       RowBox[{"!", 
        RowBox[{"MatchQ", "[", 
         RowBox[{"expr", ",", 
          RowBox[{"x", "[", "_", "]"}]}], "]"}]}]}], ":>", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"fresh", "=", 
          RowBox[{"Unique", "[", "\"\<\[Mu]\>\"", "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Partials", "[", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "fresh", "]"}], "]"}], ",", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], "*",
          "\[IndentingNewLine]", 
         RowBox[{"Partials", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "fresh", "]"}], "]"}]}], 
          "]"}]}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Combine", " ", "differentiationRules", " ", "from", " ", 
     "\[ScriptCapitalU]\[ScriptCapitalD]", " ", "and", " ", "the", " ", 
     "special", " ", "manualChainRule", " ", "here", " ", "into", " ", "a", " ",
      "single", " ", "flat", " ", "list"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"allRules", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"{", 
       RowBox[{"differentiationRules", ",", "manualChainRule"}], "}"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "transformed", " ", "covariant", " ", "derivative"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"targetTensor", "=", 
     RowBox[{"Echo", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", "Jacobians", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Partials", "[", 
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "ap", "]"}], "]"}], ",", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "mu", "]"}], "]"}]}], "]"}], "*",
         "\[IndentingNewLine]", 
        RowBox[{"Partials", "[", 
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "nu", "]"}], "]"}], ",", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], "*",
         "\[IndentingNewLine]", 
        RowBox[{"CD", "[", 
         RowBox[{
          RowBox[{"A", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "mu", "]"}], "]"}], ",", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "nu", "]"}], "]"}]}], "]"}]}], ",",
        "\[IndentingNewLine]", "\"\<1. \[ScriptCapitalU]\[ScriptCapitalD] \
says \!\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Alpha]'\)], \(; \(\\\ \)\(\
\[Beta]'\)\)]\) =\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "just", " ", "calculate"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", 
     RowBox[{"A", "'"}], " ", "and", " ", 
     RowBox[{"x", "'"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"Aprimed", "=", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "ap", "]"}], "]"}], "/.", " ", 
        "robustTransformRules"}]}], ",", 
      "\[IndentingNewLine]", "\"\<2a. \!\(\*SuperscriptBox[\(A\), \(\[Mu]'\)]\
\) =\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xprimed", "=", 
     RowBox[{"x", "[", 
      RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      SuperscriptBox["A", 
       RowBox[{"\[Mu]", "'"}]], " ", 
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", 
        RowBox[{"\[Alpha]", "'"}]], 
       RowBox[{
        RowBox[{"\[Beta]", "'"}], " ", 
        RowBox[{"\[Mu]", "'"}]}]]}], " ", "=", " ", 
     RowBox[{
      SubscriptBox[
       SuperscriptBox["A", 
        RowBox[{"\[Alpha]", "'"}]], 
       RowBox[{";", " ", 
        RowBox[{"\[Beta]", "'"}]}]], " ", "-", " ", 
      SubscriptBox[
       SuperscriptBox["A", 
        RowBox[{"\[Alpha]", "'"}]], 
       RowBox[{",", " ", 
        RowBox[{"\[Beta]", "'"}]}]]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"brokenPartialOnly", "=", 
     RowBox[{"Echo", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Partials", "[", 
         RowBox[{"Aprimed", ",", "xprimed"}], "]"}], "//.", "allRules"}], ",",
        "\[IndentingNewLine]", "\"\<2b. Broken partial \
\!\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Alpha]'\)], \(, \(\\\ \
\)\(\[Beta]'\)\)]\) =\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gammaPrimeTimesVector", "=", "\[IndentingNewLine]", 
     RowBox[{"targetTensor", "-", "brokenPartialOnly"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "FORMATTING", " ", 
     RowBox[{"(", 
      RowBox[{"Lovelock", " ", "Style"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Collect", " ", "terms", " ", "by", " ", "A", " ", "to", " ", "isolate", " ",
      "the", " ", "transformation", " ", "law"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"prettyResult", "=", 
     RowBox[{"Echo", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"gammaPrimeTimesVector", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ap", "->", 
           RowBox[{"\[Alpha]", "'"}]}], ",", 
          RowBox[{"bp", "->", 
           RowBox[{"\[Beta]", "'"}]}], ",", 
          RowBox[{"mu", "->", "\[Mu]"}], ",", 
          RowBox[{"nu", "->", "\[Nu]"}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", "\"\<3a. Residual \
(\!\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Alpha]'\)], \(; \(\\\ \)\(\
\[Beta]'\)\)]\) - \!\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Alpha]'\)], \
\(, \(\\\ \)\(\[Beta]'\)\)]\)) =\>\""}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n=== \[CapitalGamma] TRANSFORMATION LAW (without \
quotient) ===\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<The term involving \[CapitalGamma]' must satisfy:\>\"",
      "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"HERE", " ", "IS", " ", "THE", " ", "MAGIC"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Tensor", " ", "Form", " ", "does", " ", "index", " ", "coalescing", " ", 
     "and", " ", 
     RowBox[{"simplification", "!"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Echo", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"TensorForm", "[", 
       RowBox[{"Collect", "[", 
        RowBox[{"prettyResult", ",", 
         RowBox[{"A", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "_", "]"}], "]"}]}], "]"}], "]"}],
       ",", "\[IndentingNewLine]", "\"\<4. \!\(\*SuperscriptBox[\(A\), \(\
\[Gamma]'\(\\\ \)\)]\)\!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalGamma]\), \
\(\\\ \(\[Alpha]'\)\)], \(\[Beta]' \[Gamma]'\)]\) = \>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"4.", "APPLY", " ", "QUOTIENT", " ", "THEOREM"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Extract", " ", "the", " ", "coefficient", " ", "of", " ", 
      SuperscriptBox["A", "cp"]}], "=", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "cp", "]"}], "]"}], "."}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"temporarily", " ", "force", " ", "index", " ", "cp"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"inverseVectorRule", "=", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "idx_", "]"}], "]"}], ":>", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Partials", "[", 
        RowBox[{
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "idx", "]"}], "]"}], ",", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "cp", "]"}], "]"}]}], "]"}], "*", 
       
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "cp", "]"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Apply", " ", "to", " ", "residual"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "ensuring", " ", "every", " ", "A", " ", "term", " ", "is", " ", "linear",
      " ", "in", " ", 
     SuperscriptBox["A", "cp"]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rhsWithTargetA", "=", 
     RowBox[{"gammaPrimeTimesVector", "/.", " ", "inverseVectorRule"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", 
     RowBox[{"(", "strip", ")"}], " ", "the", " ", "coefficient"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"finalGammaLaw", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{"rhsWithTargetA", ",", 
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "cp", "]"}], "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "FINAL", " ", "FORMATTING"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"prettyResult", "=", "\[IndentingNewLine]", 
     RowBox[{"finalGammaLaw", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ap", "->", 
         RowBox[{"\[Alpha]", "'"}]}], ",", 
        RowBox[{"bp", "->", 
         RowBox[{"\[Beta]", "'"}]}], ",", 
        RowBox[{"cp", "->", 
         RowBox[{"\[Gamma]", "'"}]}], ",", 
        RowBox[{"mu", "->", "\[Mu]"}], ",", 
        RowBox[{"nu", "->", "\[Nu]"}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n=== \[CapitalGamma] TRANSFORMATION LAW ===\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<By a Quotient Theorem, stripping A to find \
\[CapitalGamma]':\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"MORE", " ", "MAGIC", " ", "FROM", " ", "TensorForm"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"temp$", "=", 
     RowBox[{"Echo", "[", 
      RowBox[{
       RowBox[{"TensorForm", "[", "prettyResult", "]"}], 
       ",", "\"\<5. \!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalGamma]\), \(\
\[Alpha]'\)], \(\[Beta]' \[Gamma]'\)]\) =\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<Not Tensorial!\>\"", "]"}]}]}]], "Input",
