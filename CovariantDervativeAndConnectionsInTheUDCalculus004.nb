Cell[BoxData[
 RowBox[{
  TagBox["\<\"5. \\!\\(\\*SubscriptBox[SuperscriptBox[\\(\[CapitalGamma]\\), \
\\(\[Alpha]'\\)], \\(\[Beta]' \[Gamma]'\\)]\\) =\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], "x"}], 
        SuperscriptBox["", 
         SuperscriptBox["\[Alpha]", "\[Prime]",
          MultilineFunction->None]]}], 
       RowBox[{
        RowBox[{"\[PartialD]", "x"}], 
        SuperscriptBox["", "\[Kappa]"], 
        RowBox[{"\[PartialD]", "x"}], 
        SuperscriptBox["", "\[Lambda]"]}]]}], " ", 
     FractionBox[
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", "\[Kappa]"]}], 
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", 
        SuperscriptBox["\[Beta]", "\[Prime]",
         MultilineFunction->None]]}]], " ", 
     FractionBox[
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", "\[Lambda]"]}], 
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", 
        SuperscriptBox["\[Gamma]", "\[Prime]",
         MultilineFunction->None]]}]]}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", "\[Kappa]"]}], 
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", 
        SuperscriptBox["\[Beta]", "\[Prime]",
         MultilineFunction->None]]}]], " ", 
     FractionBox[
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", "\[Lambda]"]}], 
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", 
        SuperscriptBox["\[Gamma]", "\[Prime]",
         MultilineFunction->None]]}]], " ", 
     FractionBox[
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", 
        SuperscriptBox["\[Alpha]", "\[Prime]",
         MultilineFunction->None]]}], 
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", "\[Rho]"]}]], " ", 
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Kappa]", "\[Lambda]"}], "\[Rho]"]}]}],
   HoldForm]}]], "Echo",
 CellChangeTimes->{
  3.977327593559807*^9},ExpressionUUID->"23f991f4-e53b-427d-8122-\
9b4ea500f3da"],

