Cell[CellGroupData[{

Cell["Conclusion", "Section",
 CellChangeTimes->{{3.977327626538269*^9, 
  3.977327628335918*^9}},ExpressionUUID->"cd7ccaae-8a48-4951-8813-\
25a2f004c76f"],

Cell["\<\
We began this notebook with a broken tool, the partial derivative of a \
contravariant vector. This derivative cannot survive a coordinate \
transformation. However, by demanding linearity and tensoriality, we forced \
the covariant derivative to emerge with its correction to the partial \
derivative: the connection \[CapitalGamma].\
\>", "Text",
 CellChangeTimes->{{3.977328046772869*^9, 3.9773280628431273`*^9}, {
  3.977342981967009*^9, 
  3.9773430912152443`*^9}},ExpressionUUID->"c00739a0-29e7-4328-8514-\
912f49061aa3"],

Cell[TextData[{
 "Also, we did not just accept textbook derivations of the Christoffel \
symbols for relativistic gravitation. We used \[ScriptCapitalU]\
\[ScriptCapitalD] to derive them ",
 StyleBox["ab-initio",
  FontSlant->"Italic"],
 ". By insisting that lengths be preserved (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Del]", "g"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "10316afd-2b5b-4b06-9bfd-2f068367e1e5"],
 ") and twisting be forbidden ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Mu]", " ", "\[Nu]"}]], "=", 
     SubscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Nu]", " ", "\[Mu]"}]]}], ")"}], TraditionalForm]],
  ExpressionUUID->"a32e654e-fb81-49c4-a45d-24f75b7c143c"],
 ", \[ScriptCapitalU]\[ScriptCapitalD]\[CloseCurlyQuote]s algebraic solver \
collapsed the Koszul sum into the standard formula: "
}], "Text",
 CellChangeTimes->{{3.977328046772869*^9, 3.977328210801209*^9}, {
  3.977343100774181*^9, 
  3.977343151365741*^9}},ExpressionUUID->"eb16f1b4-e1af-4b81-adfc-\
344b15856a90"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Sigma]"}]], 
    RowBox[{"\[Mu]", " ", "\[Nu]"}]], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     SuperscriptBox["g", 
      RowBox[{" ", 
       RowBox[{"\[Sigma]", " ", "\[Lambda]"}]}]], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["g", 
       RowBox[{" ", 
        RowBox[{
         RowBox[{"\[Lambda]", " ", "\[Mu]"}], ",", " ", "\[Nu]"}]}]], "+", 
      SubscriptBox["g", 
       RowBox[{" ", 
        RowBox[{
         RowBox[{"\[Lambda]", " ", "\[Nu]"}], ",", " ", "\[Mu]"}]}]], "-", 
      SubscriptBox["g", 
       RowBox[{" ", 
        RowBox[{
         RowBox[{"\[Mu]", " ", "\[Nu]"}], ",", " ", "\[Lambda]"}]}]]}], 
     ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.9773281838333473`*^9, 
  3.9773281960566483`*^9}},ExpressionUUID->"21e826cf-797d-4630-b140-\
750929317dba"],

Cell["\<\
confirming that gravitation, manifested in the connection, is fully \
determined by the metric and its ordinary partial derivatives. \
\>", "Text",
 CellChangeTimes->{{3.977328046772869*^9, 3.97732815255791*^9}, {
  3.977328217593349*^9, 3.9773283262560883`*^9}, {3.977331904529643*^9, 
  3.9773319380057592`*^9}, {3.977342897568602*^9, 3.9773429356828938`*^9}, {
  3.977343165287672*^9, 
  3.977343180758193*^9}},ExpressionUUID->"759ba772-a97b-46b1-b548-\
3f915124bd99"],

Cell["\<\
With a working covariant derivative in the Relativity Toolkit, we are \
equipped for future installments on geodesics, geodesic deviation, tidal \
forces, accelerated observers, Schwarzschild and Kerr metrics, black holes, \
etc. all via curvature. \
\>", "Text",
 CellChangeTimes->{{3.977328046772869*^9, 3.97732815255791*^9}, {
  3.977328217593349*^9, 3.9773283262560883`*^9}, {3.977331904529643*^9, 
  3.9773319380057592`*^9}, {3.977342897568602*^9, 
  3.977342963915614*^9}},ExpressionUUID->"2b46e7ed-067e-4f36-bab3-\
c9616286175c"]
}, Open  ]],

