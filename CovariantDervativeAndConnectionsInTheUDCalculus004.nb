Cell[CellGroupData[{

Cell["Covariant Derivative", "Section",
 CellChangeTimes->{{3.976976704581627*^9, 
  3.976976708832714*^9}},ExpressionUUID->"2de3c925-4bd0-4c7c-b240-\
31a502b1501e"],

Cell[TextData[{
 StyleBox["A .wl block-version of code for this section, minus the prose, is \
available at ",
  FontSlant->"Italic"],
 StyleBox["https://github.com/rebcabin/RelativityToolkit/blob/main/covariant_\
derivative.wl",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[". ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9771500832617273`*^9, 3.9771501268724957`*^9}, {
  3.9773269695399323`*^9, 
  3.977326970911551*^9}},ExpressionUUID->"863d214a-4d2f-4ef8-8fda-\
b92660fb4339"],

Cell[CellGroupData[{

Cell["We Want a Derivative!", "Subsection",
 CellChangeTimes->{{3.977155428734043*^9, 
  3.9771554351031723`*^9}},ExpressionUUID->"7ed9b348-6ca9-4c37-84f2-\
8af74418565e"],

Cell[TextData[{
 "Consider a curve with invertible, continuous, differentiable coordinate \
functions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Alpha]"], "(", "\[Lambda]", ")"}], 
   TraditionalForm]],ExpressionUUID->"25eddf97-a413-4337-b8ad-4295217c28a2"],
 " along the curve, and tangent (contravariant) vectors ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["u", "\[Alpha]"], "\[Congruent]", 
    RowBox[{"d", "\[VeryThinSpace]", 
     RowBox[{
      SuperscriptBox["x", "\[Alpha]"], "/", "d"}], "\[VeryThinSpace]", 
     "\[Lambda]"}]}], TraditionalForm]],ExpressionUUID->
  "a614fd3d-5239-41e1-9a9d-d1b8a478337d"],
 ". Also consider a (contravariant) vector field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Alpha]"], "(", 
    RowBox[{
     SuperscriptBox["x", "\[Beta]"], "(", "\[Lambda]", ")"}], ")"}], 
   TraditionalForm]],ExpressionUUID->"14a50700-31d5-4a71-b872-f8a2fcac5615"],
 " defined in neighborhoods around every point ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Alpha]"], "(", "\[Lambda]", ")"}], 
   TraditionalForm]],ExpressionUUID->"b9cebccf-ee14-41b2-a9fb-4466ffc63d88"],
 " along the curve. We\[CloseCurlyQuote]d like a \
\[OpenCurlyDoubleQuote]derivative\[CloseCurlyDoubleQuote] of the vector \
field, schematically:"
}], "Text",
 CellChangeTimes->{{3.977003584330347*^9, 3.977003894123189*^9}, {
  3.97700393339956*^9, 3.977003933603921*^9}, {3.97700419429191*^9, 
  3.977004203125691*^9}, {3.977038071780509*^9, 3.9770380863791122`*^9}, {
  3.977149778206624*^9, 3.977149778753806*^9}, {3.977649882030355*^9, 
  3.9776499135851803`*^9}, {3.977649945583139*^9, 
  3.977649992038724*^9}},ExpressionUUID->"f30c4eea-54b7-48a9-86d8-\
0ee2004bdfff"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], 
   OverscriptBox["\[Congruent]", "?"], 
   FractionBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["A", "\[Alpha]"], "(", 
      RowBox[{
       SuperscriptBox["x", "\[Beta]"], "+", 
       RowBox[{"d", "\[VeryThinSpace]", 
        SuperscriptBox["x", "\[Beta]"]}]}], ")"}], "-", 
     RowBox[{
      SuperscriptBox["A", "\[Alpha]"], "(", 
      SuperscriptBox["x", "\[Beta]"], ")"}]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
  3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
  3.977038167010255*^9}, {3.977150885720536*^9, 3.9771508953483267`*^9}},
 CellTags->
  "NAIVE DERIVATIVE",ExpressionUUID->"3e7185b2-be53-4220-8811-709ca7e96e9e"],

Cell[TextData[{
 StyleBox["We\[CloseCurlyQuote]ll have a better, \[OpenCurlyDoubleQuote]cool\
\[CloseCurlyDoubleQuote] notation for ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],ExpressionUUID->
  "1c0d9465-a958-44e7-9578-b88cb7a6cfde"],
 StyleBox[" soon enough. For now, read it as \[OpenCurlyDoubleQuote]the \
derivative we\[CloseCurlyQuote]re trying to define.\[CloseCurlyDoubleQuote]",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977153421002161*^9, 3.977153467909046*^9}, {
  3.9771560805534763`*^9, 
  3.977156082398275*^9}},ExpressionUUID->"45ef1c05-5024-486b-8e04-\
f982e122d953"],

Cell[TextData[{
 "Seems a reasonable thing to ask: \[OpenCurlyDoubleQuote]How much does \
component \[Alpha] of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "36d19af6-deaa-40f7-bc14-9200e072bb19"],
 " change when I change coordinate \[Beta] a little?\[CloseCurlyDoubleQuote] \
"
}], "Text",
 CellChangeTimes->{{3.9770040526557817`*^9, 3.9770040885876007`*^9}, {
   3.977004137896049*^9, 3.977004145931327*^9}, {3.977004214858284*^9, 
   3.977004294138308*^9}, {3.977004332057253*^9, 3.977004333463525*^9}, {
   3.9770043811140347`*^9, 3.977004453579987*^9}, {3.977007247223049*^9, 
   3.9770072547584133`*^9}, {3.977038173587933*^9, 3.977038497226171*^9}, {
   3.977038540931356*^9, 3.977038579669528*^9}, {3.977038804232141*^9, 
   3.97703884675251*^9}, {3.9770389951471367`*^9, 3.977039023921427*^9}, 
   3.977039241349597*^9, {3.977039455610796*^9, 3.977039487120262*^9}, 
   3.977150749449057*^9},ExpressionUUID->"a239f143-eb86-4585-91e4-\
d5fe602fcb92"],

Cell[TextData[{
 "However, Equation ",
 
 CounterBox["DisplayFormulaNumbered", "NAIVE DERIVATIVE"],
 " is not a cogent definition of derivative on a manifold. We cannot subtract \
vectors at different points, not even infinitesimally different points. The \
coordinate axes at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["x", "\[Beta]"], "+", 
     RowBox[{"d", "\[VeryThinSpace]", 
      SuperscriptBox["x", "\[Beta]"]}]}], ")"}], TraditionalForm]],
  ExpressionUUID->"56b1f2d4-81b2-491d-9fbe-97df5f38a866"],
 " don\[CloseCurlyQuote]t point in the same directions as the coordinate axes \
at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Beta]"], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "45fc45ca-0339-4163-af6e-fa6767d7730f"],
 " because the manifold bends and twists away between the two points! The \
components of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "730d251d-6e90-4257-a057-73c3f110ad34"],
 " are not commensurable at the two points because the two vectors are in ",
 StyleBox["different tangent spaces",
  FontWeight->"Bold"],
 ". Subtracting components as prescribed by Equation ",
 
 CounterBox["DisplayFormulaNumbered", "NAIVE DERIVATIVE"],
 ", numerically, scrambles information from other directions. "
}], "Text",
 CellChangeTimes->{{3.9770040526557817`*^9, 3.9770040885876007`*^9}, {
   3.977004137896049*^9, 3.977004145931327*^9}, {3.977004214858284*^9, 
   3.977004294138308*^9}, {3.977004332057253*^9, 3.977004333463525*^9}, {
   3.9770043811140347`*^9, 3.977004453579987*^9}, {3.977007247223049*^9, 
   3.9770072547584133`*^9}, {3.977038173587933*^9, 3.977038497226171*^9}, {
   3.977038540931356*^9, 3.977038579669528*^9}, {3.977038804232141*^9, 
   3.97703884675251*^9}, {3.9770389951471367`*^9, 3.977039023921427*^9}, 
   3.977039241349597*^9, {3.977039455610796*^9, 3.977039487120262*^9}, {
   3.977150752846341*^9, 3.977150772508114*^9}, {3.9771508061256104`*^9, 
   3.9771508091198177`*^9}, {3.9771508455881777`*^9, 
   3.9771508769242887`*^9}, {3.977150936475584*^9, 3.977151305182768*^9}, {
   3.977151371937068*^9, 3.977151376909506*^9}, {3.977325216809762*^9, 
   3.977325247145625*^9}, {3.977344897670967*^9, 
   3.977344899651649*^9}},ExpressionUUID->"a5007e72-e1ec-4b61-905d-\
5c299f30012a"],

Cell[CellGroupData[{

Cell["Parallel Transport", "Subsubsection",
 CellChangeTimes->{{3.977650208828105*^9, 
  3.97765021382131*^9}},ExpressionUUID->"cd7a46c2-c83a-485a-a6fb-\
29a8b3c51519"],

Cell[TextData[{
 "To answer this conundrum, we need backwards ",
 StyleBox["parallel transport",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", to move the vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Alpha]"], "(", 
    RowBox[{
     SuperscriptBox["x", "\[Beta]"], "+", 
     RowBox[{"d", "\[VeryThinSpace]", 
      SuperscriptBox["x", "\[Beta]"]}]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}},ExpressionUUID->
  "954043c7-1de4-4d21-899a-eb0453ee02f7"],
 " smoothly and with a ",
 StyleBox["provable minimum",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of bending and twisting, back from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Beta]"], "+", 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]}], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}},ExpressionUUID->
  "138f83e9-acfc-4786-be80-9dc3019c8501"],
 " to the point ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Beta]"], TraditionalForm]],ExpressionUUID->
  "ca25019d-7152-4bf1-9a0a-380875f5301f"],
 ", so we can measure the components of the transported ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Alpha]"], "(", 
    RowBox[{
     SuperscriptBox["x", "\[Beta]"], "+", 
     RowBox[{"d", "\[VeryThinSpace]", 
      SuperscriptBox["x", "\[Beta]"]}]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}},ExpressionUUID->
  "46b2224c-75e4-408d-bdb8-08a547aa5257"],
 " on the coordinate axes at point ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Beta]"], TraditionalForm]],ExpressionUUID->
  "ca6466ff-fce0-4260-b3c8-736acff0f49c"],
 " and then subtract the numbers. "
}], "Text",
 CellChangeTimes->{{3.9770040526557817`*^9, 3.9770040885876007`*^9}, {
   3.977004137896049*^9, 3.977004145931327*^9}, {3.977004214858284*^9, 
   3.977004294138308*^9}, {3.977004332057253*^9, 3.977004333463525*^9}, {
   3.9770043811140347`*^9, 3.977004453579987*^9}, {3.977007247223049*^9, 
   3.9770072547584133`*^9}, {3.977038173587933*^9, 3.9770382226080093`*^9}, {
   3.977038589248727*^9, 3.977038632705469*^9}, {3.977039144347281*^9, 
   3.9770392038997087`*^9}, {3.977039626915082*^9, 3.9770397003204203`*^9}, {
   3.977039952082591*^9, 3.977039953245672*^9}, {3.9770400219426003`*^9, 
   3.9770400238143177`*^9}, {3.977040825192885*^9, 3.97704084832859*^9}, {
   3.977151341577095*^9, 3.977151365015212*^9}, 3.977151405918866*^9, {
   3.977344911090847*^9, 
   3.97734491823934*^9}},ExpressionUUID->"e975218c-da2a-4de9-b5ea-\
cae10438cf1a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], 
   OverscriptBox["\[Congruent]", "?"], 
   FractionBox[
    RowBox[{
     RowBox[{"ParallelTransport", "(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["A", "\[Alpha]"], "(", 
        RowBox[{
         SuperscriptBox["x", "\[Beta]"], "+", 
         RowBox[{"d", "\[VeryThinSpace]", 
          SuperscriptBox["x", "\[Beta]"]}]}], ")"}], ",", " ", 
       RowBox[{"to", " ", 
        SuperscriptBox["x", "\[Beta]"]}]}], ")"}], "-", 
     RowBox[{
      SuperscriptBox["A", "\[Alpha]"], "(", 
      SuperscriptBox["x", "\[Beta]"], ")"}]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
  3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
  3.977038167010255*^9}, {3.977150885720536*^9, 3.9771508953483267`*^9}, {
  3.977344956310335*^9, 3.977344986553255*^9}},
 CellTags->
  "NAIVE DERIVATIVE",ExpressionUUID->"eb25d690-fcc1-4094-ad53-3dd7f10b3f93"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Coordinate-Independence", "Subsubsection",
 CellChangeTimes->{{3.977650218972563*^9, 
  3.9776502269602547`*^9}},ExpressionUUID->"7203b804-0c3b-40bc-9c30-\
89f0240bcafa"],

Cell[TextData[{
 "Now, with subtraction conceptually solved, how will that difference survive \
a coordinate transformation? How can I find out, when I ",
 StyleBox["change coordinates from ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Beta]"], TraditionalForm]],ExpressionUUID->
  "0386fa33-8d84-4054-9b5d-ab08eb1ad6b8"],
 StyleBox[" to ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"\[Beta]", "'"}]], TraditionalForm]],ExpressionUUID->
  "00fb31d7-101b-4f0d-bb0a-833c8442dd1c"],
 StyleBox[" at the same point",
  FontWeight->"Bold"],
 ", how much component ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "->", 
    RowBox[{"\[Alpha]", "'"}]}], TraditionalForm]],ExpressionUUID->
  "3995f2d1-9ad1-4b7e-b9e6-c7f85859dbfc"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", " "}], TraditionalForm]],ExpressionUUID->
  "598c03d7-c530-4062-940a-7e72659ae730"],
 "changes when I change coordinate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "->", 
    RowBox[{"\[Beta]", "'"}]}], TraditionalForm]],ExpressionUUID->
  "809037a4-1f27-436e-8a7c-03a03746f5eb"],
 "? That is, what\[CloseCurlyQuote]s the value of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", 
      RowBox[{"\[Alpha]", " ", "'"}]]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", 
      RowBox[{"\[Beta]", " ", "'"}]]}]], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "006d5211-41a9-47b9-b84c-db4a993c2c38"],
 " when all I know is ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "ad0cdaaa-3de0-423c-9c74-73a2f053dc22"],
 "? "
}], "Text",
 CellChangeTimes->{{3.9770040526557817`*^9, 3.9770040885876007`*^9}, {
  3.977004137896049*^9, 3.977004145931327*^9}, {3.977004214858284*^9, 
  3.977004294138308*^9}, {3.977004332057253*^9, 3.977004333463525*^9}, {
  3.9770043811140347`*^9, 3.977004453579987*^9}, {3.977007247223049*^9, 
  3.9770072547584133`*^9}, {3.977038173587933*^9, 3.977038497226171*^9}, {
  3.977038540931356*^9, 3.977038558382607*^9}, {3.9770386442395363`*^9, 
  3.977038745129084*^9}, {3.977039055494041*^9, 3.977039136565977*^9}, {
  3.977039505207293*^9, 3.9770396040583878`*^9}, {3.977039995456196*^9, 
  3.977039996382832*^9}, {3.977151421225566*^9, 3.977151507962015*^9}, {
  3.977345004556221*^9, 3.9773450662757874`*^9}, {3.977650132757598*^9, 
  3.977650134753867*^9}, {3.977650172387261*^9, 3.977650173893743*^9}, {
  3.977650265641521*^9, 
  3.9776502808831882`*^9}},ExpressionUUID->"5e16f76b-3674-4a09-b04e-\
c36a63426924"],

Cell[TextData[{
 "To answer this conundrum, we insist, as always, that the ",
 StyleBox["intrinsic ",
  FontSlant->"Italic"],
 "geometry and physics ",
 StyleBox["not",
  FontWeight->"Bold"],
 " depend on choice of coordinates. But what does ",
 StyleBox["intrinsic",
  FontSlant->"Italic"],
 " mean when all we have are numerical components whose values depend on \
choice of coordinates?"
}], "Text",
 CellChangeTimes->{{3.9770040526557817`*^9, 3.9770040885876007`*^9}, {
  3.977004137896049*^9, 3.977004145931327*^9}, {3.977004214858284*^9, 
  3.977004294138308*^9}, {3.977004332057253*^9, 3.977004333463525*^9}, {
  3.9770043811140347`*^9, 3.977004453579987*^9}, {3.977007247223049*^9, 
  3.9770072547584133`*^9}, {3.977038173587933*^9, 3.977038497226171*^9}, {
  3.977038540931356*^9, 3.977038558382607*^9}, {3.9770386442395363`*^9, 
  3.977038745129084*^9}, {3.977039055494041*^9, 3.977039136565977*^9}, {
  3.977039505207293*^9, 3.9770396040583878`*^9}, {3.977039995456196*^9, 
  3.977039996382832*^9}, {3.977151421225566*^9, 
  3.9771515219508553`*^9}},ExpressionUUID->"80ef238f-15b2-409f-9ec6-\
bd745961488a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Intrinsic Means Tensorial", "Subsection",
 CellChangeTimes->{{3.977151584847031*^9, 3.9771516007004223`*^9}, {
  3.977151643447052*^9, 3.977151653225214*^9}, {3.977650338691291*^9, 
  3.977650343897122*^9}},ExpressionUUID->"b5290a30-4898-4325-9cd6-\
e44a282e6870"],

Cell[TextData[{
 "Tensorial quantities encapsulate both intrinsic and coordinate-dependent \
information. If our desired, derivative-like quantities ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "5b1991d2-15d1-4220-85bf-ec11b979dd38"],
 " transform like a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]],ExpressionUUID->
  "480fe5fc-cace-4565-8fba-672aaa6601fc"],
 " tensor when we change the basis vectors at point \[Beta], we\
\[CloseCurlyQuote]ll capture both: "
}], "Text",
 CellChangeTimes->{{3.9770040526557817`*^9, 3.9770040885876007`*^9}, {
  3.977004137896049*^9, 3.977004145931327*^9}, {3.977004214858284*^9, 
  3.977004294138308*^9}, {3.977004332057253*^9, 3.977004333463525*^9}, {
  3.9770043811140347`*^9, 3.977004453579987*^9}, {3.977007247223049*^9, 
  3.9770072547584133`*^9}, {3.977038173587933*^9, 3.9770382226080093`*^9}, {
  3.977038589248727*^9, 3.977038632705469*^9}, {3.977039144347281*^9, 
  3.9770391878980713`*^9}, {3.977039219320077*^9, 3.977039335691654*^9}, {
  3.977039726634755*^9, 3.9770398631459713`*^9}, {3.9770408810411873`*^9, 
  3.9770409177565737`*^9}, {3.977040985697022*^9, 3.9770410320985518`*^9}, {
  3.977151538384181*^9, 3.977151542670525*^9}, {3.9771516581266623`*^9, 
  3.977151858091786*^9}, {3.9771533549961567`*^9, 3.9771533677038813`*^9}, {
  3.977345082361144*^9, 3.977345084223401*^9}, {3.977651721215536*^9, 
  3.977651750996725*^9}},ExpressionUUID->"0302b9c0-b730-4187-bdbe-\
4c9b469958ec"],

Cell[TextData[{
 StyleBox["intrinsic",
  FontSlant->"Italic"],
 " geometric and physical properties of a tensor"
}], "Item",
 CellChangeTimes->{{3.9771518713554688`*^9, 3.977151894839384*^9}, {
  3.9776517567952843`*^9, 
  3.977651760732111*^9}},ExpressionUUID->"d36b10bd-98d8-4d1f-a31b-\
b4d6a8ab5419"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["extrinsic",
  FontSlant->"Italic"],
 " artifacts arising from choice of coordinates "
}], "Item",
 CellChangeTimes->{{3.9771518971945*^9, 3.977152000425416*^9}, {
  3.977325325555357*^9, 3.9773253283215*^9}, {3.9776517688921623`*^9, 
  3.97765178119512*^9}},ExpressionUUID->"91d5068e-2e63-479f-92c6-\
f1adaed1c4f5"],

Cell["\<\
Think of changing from Cartesian to spherical coordinates in flat Euclidean 3\
\[NoBreak]-\[NoBreak]space: the numbers change but the geometry and physics \
don\[CloseCurlyQuote]t.\
\>", "Subitem",
 CellChangeTimes->{{3.9771518971945*^9, 3.977152000425416*^9}, {
  3.977325325555357*^9, 3.9773253283215*^9}, {3.9776517688921623`*^9, 
  3.9776518235003653`*^9}},ExpressionUUID->"f4302e12-32d7-4437-995a-\
ad2be9b936ae"]
}, Open  ]],

Cell["\<\
Plus, we will be able to separate intrinsic from extrinsic quantities cleanly.\
\>", "Text",
 CellChangeTimes->{{3.977651846588592*^9, 
  3.9776518695517063`*^9}},ExpressionUUID->"3e43eff9-08c3-4efd-96a6-\
e8e92cf15024"],

Cell[TextData[{
 StyleBox["The first couple of chapters of ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Lovelock & Rund",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://a.co/d/1Lm1ipR"], None},
  ButtonNote->"https://a.co/d/1Lm1ipR"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[" address this issue of intrinsic, geometry-dependent effects \
versus extrinsic, coordinate-dependent effects rigorously. Thinking like \
physicists, let\[CloseCurlyQuote]s be satisfied with the conceptual \
description above for now.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9771518971945*^9, 3.977152068313332*^9}, {
  3.977152286928215*^9, 3.977152342341874*^9}, {3.9771554709922533`*^9, 
  3.9771555036139708`*^9}, {3.977345123528822*^9, 3.977345126266317*^9}, {
  3.977651882963048*^9, 
  3.977651896379106*^9}},ExpressionUUID->"a7559088-2ae6-4a9b-8809-\
503593db137b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tensorial and Linear Requirements", "Subsection",
 CellChangeTimes->{{3.977155579722578*^9, 
  3.9771555943695583`*^9}},ExpressionUUID->"1dd82dff-2885-468f-be6b-\
4d83a55295c0"],

Cell[TextData[{
 "Agree that the components of our desired derivative, ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],
  CellChangeTimes->{{3.977003919526229*^9, 3.977004045385124*^9}, {
   3.977004095014958*^9, 3.977004126198254*^9}, {3.9770381492006693`*^9, 
   3.977038167010255*^9}},ExpressionUUID->
  "178368a4-f56f-44a1-8b5a-ea8d9cc8d39e"],
 ", change with coordinate frames in exactly the way components of any other \
tensor with one up and one down index, would change. These components are \
projections of the vector ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9108dc1e-11df-4e2f-90ba-1b625c1d15a5"],
 " on the basis vectors of the coordinate system ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Beta]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fbbeaf4c-82e9-4aa5-adb7-5ba8b8122d7b"],
 ", and measure both intrinsic and extrinsic information. "
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQBWIQrfVnSlPHwreOC84KtYPo/DU2vSA676xtH4gWKL89
DUSz5h5ZAKJZrjYuBdFGV9eBaZ1li1eDaMf+TVtAtIXyc8EuIP3G5YYQiI68
sEl7JpC+UHLZEERP+ro8HkSbTBZLBdFvZbiXgmiGvTWrQLSQXdY6EM2h9G0P
iH7lf+UtiD6z+sk/EJ0RqFg3C0jfMt3RBKIZ/cy6QXSYOvNEEG3m7dN2AUh/
LLkKpufxukwF0U4P7q8F0T0Ld+wF0f84hfaD6JKp+W9BtNWE3o8g+g8/U8JF
IF326ncKiLZcoVEFoq9B6U+/lt44sgiofnLRcxBdudD/HYhW/x7zDUQDAHUg
wBA=
  "],ExpressionUUID->"7122303d-f6d7-4976-9445-835bd34a2b4f"],

Cell[TextData[{
 "It turns out that simply demanding that our new derivative be ",
 StyleBox["tensorial and linear",
  FontWeight->"Bold"],
 " suffices to solve all the problems above, including optimality. "
}], "Text",
 CellChangeTimes->{{3.977004335524499*^9, 3.9770043704738903`*^9}, {
   3.977004459862672*^9, 3.977004462955502*^9}, {3.977004607950364*^9, 
   3.977004657450521*^9}, {3.9770051541433764`*^9, 3.977005223612775*^9}, {
   3.97700531611539*^9, 3.9770055667106743`*^9}, {3.9770056293925962`*^9, 
   3.977005692088046*^9}, {3.9770057691765127`*^9, 3.977005809766267*^9}, {
   3.9770058466687117`*^9, 3.977005916940502*^9}, {3.9770060689174433`*^9, 
   3.977006082939225*^9}, {3.977007267875451*^9, 3.977007287649378*^9}, {
   3.977007606552973*^9, 3.977007804922398*^9}, 3.9770096096309032`*^9, {
   3.977039890629109*^9, 3.977039895746916*^9}, {3.9770411661340227`*^9, 
   3.977041194191555*^9}, {3.977041249443462*^9, 3.977041264803671*^9}, 
   3.9770412970304193`*^9, 3.9770629808685913`*^9, {3.977152405626762*^9, 
   3.977152410722218*^9}, {3.977152455257874*^9, 
   3.977152479083568*^9}},ExpressionUUID->"e26e79c9-9ac9-48a7-b95c-\
b285adfafc8f"],

Cell[TextData[StyleBox["TODO: This claim of optimality may not be good \
enough, even for a physicist happy with mathematical hand-waving. Misner, \
Thorne, and Wheeler [MTW] devote many chapters (8-15) to a more careful, \
physicist\[CloseCurlyQuote]s level of understanding, including demonstrations \
that the covariant derivative perform parallel transport! Those are missing \
pieces in this notebook. ",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.977152428492296*^9, 3.9771524493190536`*^9}, {
  3.977152484271647*^9, 3.977152495271927*^9}, {3.977325379023426*^9, 
  3.977325396012842*^9}, {3.977325450489462*^9, 3.977325586377109*^9}, {
  3.9773256502676153`*^9, 3.977325820245413*^9}, {3.977328390348002*^9, 
  3.977328447303895*^9}, {3.977345170622044*^9, 3.977345196667638*^9}, {
  3.977652050128789*^9, 
  3.977652050508645*^9}},ExpressionUUID->"81380b7c-1ee4-47d1-a0de-\
593db6c3b54a"],

Cell[TextData[{
 StyleBox["A mathematician will demand rigorous proofs. For those, see the \
many texts on differential geometry, perhaps starting with ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["do\[NonBreakingSpace]Carmo's Differential Geometry of \
Curves and Surfaces",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://a.co/d/3H8xcym"], None},
  ButtonNote->"https://a.co/d/3H8xcym"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[". Other texts such as ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Tristan Needham, Visual Differential Geometry and Forms",
  
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://a.co/d/dNpxCGc"], None},
  ButtonNote->"https://a.co/d/dNpxCGc"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[", and ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Michael Spivak's 5\[NoBreak]-\[NoBreak]volume \
Comprehensive Introduction to Differential Geometry",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://a.co/d/dmvEZeo"], None},
  ButtonNote->"https://a.co/d/dmvEZeo"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[" are recommended.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977152428492296*^9, 3.9771524493190536`*^9}, {
  3.977152484271647*^9, 3.977152495271927*^9}, {3.977325379023426*^9, 
  3.977325396012842*^9}, {3.977325450489462*^9, 3.977325586377109*^9}, {
  3.9773256502676153`*^9, 3.977325820245413*^9}, {3.977328390348002*^9, 
  3.9773284647398863`*^9}, {3.9773432447043447`*^9, 
  3.977343255656417*^9}},ExpressionUUID->"a842e4e4-c7d7-4358-b4eb-\
fdf794ad624b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Partials are Not Tensors", "Subsection",
 CellChangeTimes->{{3.977155403581815*^9, 
  3.9771554107464933`*^9}},ExpressionUUID->"b9b48166-8058-4717-98d4-\
068aa789b5c1"],

Cell[TextData[{
 "First, let\[CloseCurlyQuote]s check that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", " ", "\[Beta]"}]], TraditionalForm]],ExpressionUUID->
  "9b31dd55-db39-4b90-94c6-18be7ffee3a8"],
 " is not tensorial. It\[CloseCurlyQuote]s not enough for our desired \
derivative, but we\[CloseCurlyQuote]ll figure out how to correct it."
}], "Text",
 CellChangeTimes->{{3.977004335524499*^9, 3.9770043704738903`*^9}, {
   3.977004459862672*^9, 3.977004462955502*^9}, {3.977004607950364*^9, 
   3.977004657450521*^9}, {3.9770051541433764`*^9, 3.977005223612775*^9}, {
   3.97700531611539*^9, 3.9770055667106743`*^9}, {3.9770056293925962`*^9, 
   3.977005692088046*^9}, {3.9770057691765127`*^9, 3.977005809766267*^9}, {
   3.9770058466687117`*^9, 3.977005916940502*^9}, {3.9770060689174433`*^9, 
   3.977006082939225*^9}, {3.977007267875451*^9, 3.977007287649378*^9}, {
   3.977007606552973*^9, 3.977007804922398*^9}, 3.9770096096309032`*^9, {
   3.977039890629109*^9, 3.977039895746916*^9}, {3.9770411661340227`*^9, 
   3.977041194191555*^9}, {3.977041249443462*^9, 3.977041264803671*^9}, 
   3.9770412970304193`*^9, 3.9770629871072083`*^9, {3.977152499226038*^9, 
   3.9771525355367804`*^9}, {3.977152738873259*^9, 3.97715279238125*^9}, {
   3.977652181109983*^9, 
   3.977652204690743*^9}},ExpressionUUID->"a9464779-ae86-457d-8be6-\
ba15324599a7"],

Cell[TextData[{
 StyleBox["The comma notation, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", " ", "\[Beta]"}]], TraditionalForm]],ExpressionUUID->
  "501b6e5f-c283-4b36-a045-f933594add84"],
 ",",
 StyleBox[" is short for ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],ExpressionUUID->
  "f2d58f91-0ff5-4c52-a973-b87d40596bca"],
 ", ",
 StyleBox["also written",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Beta]"], 
    SuperscriptBox["A", "\[Alpha]"]}], TraditionalForm]],ExpressionUUID->
  "1fb013bd-9c6b-4c9c-9a63-2b65069bb280"],
 StyleBox[". Though we don\[CloseCurlyQuote]t yet know how to define",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],ExpressionUUID->
  "4787107e-c460-4a51-a924-b85704df9366"],
 ", ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],ExpressionUUID->
  "4c75a3d8-3119-4e61-b1ea-35574f86914b"],
 " ",
 StyleBox["is just good-ol\[CloseCurlyQuote] partial derivative from ordinary \
calculus, a mechanical, symbolical calculation that Wolfram automates very \
well. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977152428492296*^9, 3.9771524493190536`*^9}, {
   3.977152484271647*^9, 3.977152495271927*^9}, {3.977152569214983*^9, 
   3.977152727412465*^9}, {3.977153544174263*^9, 3.97715361358597*^9}, 
   3.977153659776372*^9, {3.977326138124316*^9, 3.977326165635598*^9}, 
   3.977345221438566*^9},ExpressionUUID->"eb0acd93-825a-4431-874e-\
151a9e26b1b0"],

Cell[TextData[{
 StyleBox["\[ScriptCapitalU]\[ScriptCapitalD] ",
  FontWeight->"Bold"],
 StyleBox["embraces the comma notation ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["as you can see from the Visual Showcase gallery above.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977152428492296*^9, 3.9771524493190536`*^9}, {
   3.977152484271647*^9, 3.977152495271927*^9}, {3.977152569214983*^9, 
   3.977152727412465*^9}, {3.977153544174263*^9, 3.97715361358597*^9}, 
   3.977153659776372*^9, {3.977326138124316*^9, 
   3.977326142028016*^9}},ExpressionUUID->"6f26dfde-8b38-4760-bc1c-\
745fe53a2095"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s transform bases and calculate ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"\[Alpha]", "'"}]], TraditionalForm]],ExpressionUUID->
  "de6760d6-7fbc-4dbb-9918-c20174ce111d"],
 ", components in basis ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"\[Alpha]", "'"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "30f027bc-d22e-4652-81a2-8a41c0629b1b"],
 ", from ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "bba2f6c3-02ba-48bf-b3fc-b2dd41e69789"],
 ", components in basis ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Alpha]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ee77af82-2b9a-40b0-b3c9-be80d152d706"],
 ". ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "96912661-20da-4a84-8a05-e2e0627ef346"],
 " is a contravariant tensor, so transforms as follows:"
}], "Text",
 CellChangeTimes->{{3.977004335524499*^9, 3.9770043704738903`*^9}, {
   3.977004459862672*^9, 3.977004462955502*^9}, {3.977004607950364*^9, 
   3.977004657450521*^9}, {3.9770051541433764`*^9, 3.977005223612775*^9}, {
   3.97700531611539*^9, 3.9770055667106743`*^9}, {3.9770056293925962`*^9, 
   3.977005692088046*^9}, {3.9770057691765127`*^9, 3.977005809766267*^9}, {
   3.9770058466687117`*^9, 3.977005916940502*^9}, {3.9770060689174433`*^9, 
   3.977006082939225*^9}, {3.977007267875451*^9, 3.977007287649378*^9}, {
   3.977007606552973*^9, 3.977007804922398*^9}, 3.9770096096309032`*^9, {
   3.977039890629109*^9, 3.977039895746916*^9}, {3.9770411661340227`*^9, 
   3.977041194191555*^9}, {3.977041249443462*^9, 3.977041264803671*^9}, 
   3.9770412970304193`*^9, 3.9770629871072083`*^9, {3.977152499226038*^9, 
   3.9771525355367804`*^9}, {3.977152738873259*^9, 3.977152798556941*^9}, {
   3.9773452383164663`*^9, 3.977345252625969*^9}, {3.977652236313735*^9, 
   3.97765228716009*^9}},ExpressionUUID->"898f3d8f-1c1c-4038-9082-\
2116da46773b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["A", 
    RowBox[{"\[Alpha]", "'"}]], "\[Congruent]", 
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Alpha]", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Alpha]"]}]], 
    SuperscriptBox["A", "\[Alpha]"]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977008276090537*^9, 3.977008414049974*^9}, {
  3.977041280713253*^9, 
  3.977041288005127*^9}},ExpressionUUID->"1398b8b5-d066-42af-afd4-\
159a79ce9548"],

Cell[TextData[{
 StyleBox["A mnemonic for \[OpenCurlyDoubleQuote]contravariant:\
\[CloseCurlyDoubleQuote] let ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{"\[Alpha]", "'"}]]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "\[Alpha]"]}]], TraditionalForm]],
  CellChangeTimes->{{3.977008276090537*^9, 3.977008414049974*^9}, {
   3.977041280713253*^9, 3.977041288005127*^9}},ExpressionUUID->
  "cc197d4f-add3-4d9a-b7fa-6097b9b600fc"],
 StyleBox[" measure feet (primed) per inch (unprimed), that is (",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "12"}], TraditionalForm]],ExpressionUUID->
  "444600ef-2f34-4e14-b0e9-4f742f04964e"],
 StyleBox["). Any unprimed contravariant vector ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "3b41a0b7-321b-4e38-9266-3d3f61b4f34d"],
 " ",
 StyleBox["is, mnemonically, like a velocity in inches per second, and its \
primed partner ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"\[Alpha]", "'"}]], TraditionalForm]],ExpressionUUID->
  "e9cb03f7-0ec8-4817-a491-97d2a270c1e3"],
 " ",
 StyleBox["is, mnemonically, like a velocity in feet per second. Multiply ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "a6753cb3-3e0a-4427-b7bb-a689b934ecf9"],
 StyleBox[" (inches per second) by ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{"\[Alpha]", "'"}]]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "\[Alpha]"]}]], TraditionalForm]],
  CellChangeTimes->{{3.977008276090537*^9, 3.977008414049974*^9}, {
   3.977041280713253*^9, 3.977041288005127*^9}},ExpressionUUID->
  "0da389dc-2d54-4e94-99de-cda9d5fccc52"],
 StyleBox[" (feet per inch, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "12"}], TraditionalForm]],ExpressionUUID->
  "3a4f0b29-c38f-4278-84fd-c4229804c10a"],
 ") ",
 StyleBox["to get ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"\[Alpha]", "'"}]], TraditionalForm]],ExpressionUUID->
  "ea6379ff-194e-4769-ae7a-9d38cf0475ab"],
 StyleBox[" (feet per second), i.e., ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", "'"}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "\[Alpha]"]}]], 
     SuperscriptBox["A", "\[Alpha]"]}]}], TraditionalForm]],ExpressionUUID->
  "6de91c39-f54b-46a1-90d4-312e17ca35ac"],
 ". ",
 StyleBox["The same rule goes for any kind of coordinate change, curvilinear, \
non-orthogonal, whatever: Contravariant? Multiply by ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{"\[Alpha]", "'"}]]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "\[Alpha]"]}]], TraditionalForm]],ExpressionUUID->
  "6ae1da51-913e-483a-92e2-3391844eba56"],
 "."
}], "Item",
 CellChangeTimes->{{3.977152428492296*^9, 3.9771524493190536`*^9}, {
  3.977152484271647*^9, 3.977152495271927*^9}, {3.977152569214983*^9, 
