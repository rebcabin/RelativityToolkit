Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"LOAD", " ", "THE", " ", "CODE"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"base", ",", "rules", ",", "tests", ",", "viz", ",", "bust"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
     "base", "=", \
"\"\<https://raw.githubusercontent.com/rebcabin/RelativityToolkit/main/\>\""}]\
, ";", "\[IndentingNewLine]", 
     RowBox[{"bust", "=", 
      RowBox[{"\"\<?t=\>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"Round", "[", 
         RowBox[{"AbsoluteTime", "[", "]"}], "]"}], "]"}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"Force", " ", "fresh", " ", "download"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Define", " ", "URLs"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rules", "=", 
      RowBox[{"base", "<>", "\"\<RelativityToolkit.wl\>\"", "<>", "bust"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"tests", "=", 
      RowBox[{
      "base", "<>", "\"\<RelativityToolkit_RegressionTests.wl\>\"", "<>", 
       "bust"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"viz", "=", 
      RowBox[{
      "base", "<>", "\"\<RelativityToolkit_VisualShowcase.wl\>\"", "<>", 
       "bust"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Load", " ", "them"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Get", "[", "rules", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Get", "[", "tests", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Get", "[", "viz", "]"}]}]}], 
   RowBox[{"(*", 
    RowBox[{
    "no", " ", "semicolon", " ", "on", " ", "purpose", " ", "to", " ", "see", 
     " ", "the", " ", "gallery"}], "*)"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9770986696878853`*^9, 3.977098749638117*^9}, 
   3.977150256537381*^9, {3.977325178432681*^9, 3.977325178827859*^9}, {
   3.9776497944860983`*^9, 3.9776497972981787`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"72b311c1-de2c-42f8-8366-69ea41a0c8c5"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"Description\"\>",
      StripOnInput->False,
      FontSize->16,
      FontWeight->Bold], 
     StyleBox["\<\"Rendered Output\"\>",
      StripOnInput->False,
      FontSize->16,
      FontWeight->Bold]},
    {
     StyleBox["\<\"Generic Mixed Partial\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], "f"}], 
       RowBox[{
        RowBox[{"\[PartialD]", "x"}], 
        RowBox[{"\[PartialD]", "y"}]}]],
      DisplayForm]},
    {
     StyleBox["\<\"Coordinate Hessian (The 'Garbage Term')\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      FractionBox[
       RowBox[{
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], "x"}], 
        SuperscriptBox["", 
         SuperscriptBox["\[Alpha]", "\[Prime]",
          MultilineFunction->None]]}], 
       RowBox[{
        RowBox[{"\[PartialD]", "x"}], 
        SuperscriptBox["", "\[Beta]"], 
        RowBox[{"\[PartialD]", "x"}], 
        SuperscriptBox["", "\[Alpha]"]}]],
      DisplayForm]},
    {
     StyleBox["\<\"Nested in an Equation\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      RowBox[{"lhs", "\[Equal]", 
       FractionBox[
        RowBox[{
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], "A"}], 
         SuperscriptBox["", "\[Mu]"]}], 
        RowBox[{
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "\[Nu]"], 
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "\[Lambda]"]}]]}],
      DisplayForm]},
    {
     StyleBox["\<\"Multiplied by Jacobian\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], "x"}], 
         SuperscriptBox["", 
          SuperscriptBox["\[Alpha]", "\[Prime]",
           MultilineFunction->None]]}], 
        RowBox[{
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "\[Beta]"], 
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "\[Alpha]"]}]], " ", 
       FractionBox[
        RowBox[{
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "\[Beta]"]}], 
        RowBox[{
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", 
          SuperscriptBox["\[Beta]", "\[Prime]",
           MultilineFunction->None]]}]]}],
      DisplayForm]},
    {
     StyleBox["\<\"Comma Notation\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      SubscriptBox[
       RowBox[{"A", 
        SuperscriptBox["", "\[Mu]"]}], 
       RowBox[{",", "\[Nu]"}]],
      DisplayForm]},
    {
     StyleBox["\<\"Covariant Derivative (Abstract)\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      TagBox[
       SubscriptBox[
        RowBox[{"A", 
         SuperscriptBox["", "\[Mu]"]}], 
        RowBox[{";", "\[Nu]"}]],
       HoldForm],
      DisplayForm]},
    {
     StyleBox["\<\"Covariant Derivative (Expanded)\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      TagBox[
       RowBox[{
        SubscriptBox[
         RowBox[{"A", 
          SuperscriptBox["", "\[Mu]"]}], 
         RowBox[{",", "\[Nu]"}]], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"A", 
           SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{"\[Nu]", "\[Lambda]"}], "\[Mu]"]}]}],
       HoldForm],
      DisplayForm]}
   },
   AutoDelete->False,
