 StyleBox[". ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9771500832617273`*^9, 3.9771501268724957`*^9}, {
  3.977150679079076*^9, 3.977150685730893*^9}, {3.9771576592071667`*^9, 
  3.977157676916306*^9}, {3.9773233415879374`*^9, 3.977323343514309*^9}, {
  3.9773434490468388`*^9, 
  3.977343450602543*^9}},ExpressionUUID->"d666e820-84ea-483e-8043-\
8a96ac078e85"],

Cell["\<\
Up to this point, we have not actually used a metric tensor! MTW devote seven \
whole chapters to differential geometry without a metric (9-15), stressing \
that many general results in differential geometry\[LongDash]the topological \
results\[LongDash]can be derived without the metric. In particular, the \
covariant derivative and the connection coefficients do not, actually, depend \
on any metrical ability to measure distances, but only on assumptions of \
continuity and differentiability. \
\>", "Text",
 CellChangeTimes->{{3.97732333012521*^9, 3.9773233350406647`*^9}, {
  3.977323423324995*^9, 3.977323488527858*^9}, {3.9773235280813227`*^9, 
  3.977323631376588*^9}, {3.9773237435059967`*^9, 3.9773237462946033`*^9}, {
  3.977325424659396*^9, 3.977325428158806*^9}, {3.977343307434906*^9, 
  3.977343370799951*^9}, {3.9776616843987837`*^9, 
  3.977661688316935*^9}},ExpressionUUID->"d2f190a3-1caf-4e5b-add3-\
3ac012ba79fc"],

Cell["\<\
But gravitation via general relativity requires a special case: Riemannian \
Geometry. For that, we need a metric, and even a bit more: symmetry \
conditions on both the connection coefficients and on the metric. From these \
additions, we derive the ultra-famous gravitational Christoffel symbols:\
\>", "Text",
 CellChangeTimes->{{3.977323636710183*^9, 3.977323694809557*^9}, {
  3.977323759476172*^9, 3.977323854177054*^9}, {3.977343391493824*^9, 
  3.977343427749483*^9}, {3.9776629662133512`*^9, 
  3.9776629812021303`*^9}},ExpressionUUID->"bdc35c0c-6611-4319-b3a9-\
3695eb0858e2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Sigma]"}]], 
    RowBox[{"\[Mu]", " ", "\[Nu]"}]], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     SuperscriptBox["g", 
      RowBox[{" ", 
       RowBox[{"\[Sigma]", " ", "\[Lambda]"}]}]], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["g", 
       RowBox[{" ", 
        RowBox[{
         RowBox[{"\[Lambda]", " ", "\[Mu]"}], ",", " ", "\[Nu]"}]}]], "+", 
      SubscriptBox["g", 
       RowBox[{" ", 
        RowBox[{
         RowBox[{"\[Lambda]", " ", "\[Nu]"}], ",", " ", "\[Mu]"}]}]], "-", 
      SubscriptBox["g", 
       RowBox[{" ", 
        RowBox[{
         RowBox[{"\[Mu]", " ", "\[Nu]"}], ",", " ", "\[Lambda]"}]}]]}], 
     ")"}]}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977323862292182*^9, 3.977323876119052*^9}, {
  3.977323907803689*^9, 3.97732403687103*^9}, {3.977331646123781*^9, 
  3.977331646125001*^9}},ExpressionUUID->"6aa9bfaf-a2e3-4b49-b180-\
c698a4f0be7a"],

Cell["\<\
This is equation 8.24 of MTW, after renaming some indices. It is also called \
\[OpenCurlyDoubleQuote]The Fundamental Theorem of Riemannian Geometry\
\[CloseCurlyDoubleQuote] in mathematical texts like do\[NonBreakingSpace]\
\[NoBreak]Carmo and Lee (see References). \
\>", "Text",
 CellChangeTimes->{{3.977324211658308*^9, 3.977324265210064*^9}, {
  3.977324302567616*^9, 3.9773243242949*^9}, {3.977324527106386*^9, 
  3.977324585469681*^9}, {3.977343217427327*^9, 
  3.977343221529702*^9}},ExpressionUUID->"b3e94a6d-cee9-4c10-b2f2-\
6e34e966da39"],

Cell["\<\
The following block of code shows a step-by-step derivation via \
\[ScriptCapitalU]\[ScriptCapitalD]. As usual, the \
\[OpenCurlyDoubleQuote]prose\[CloseCurlyDoubleQuote] is in the comments and \
Echoes. Run it and read it!\
\>", "Text",
 CellChangeTimes->{{3.977324211658308*^9, 3.977324265210064*^9}, {
   3.977324302567616*^9, 3.9773243242949*^9}, {3.977324527106386*^9, 
   3.9773245814547977`*^9}, 3.9773248625354967`*^9, 3.977331634734275*^9, 
   3.977345535831894*^9},ExpressionUUID->"c3853764-aafa-4e4d-a1d0-\
515dce9f11c8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", \
"\"\<=========================================================================\
\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Christoffel Symbols for Gravitation from Metric via the \
\[ScriptCapitalU]\[ScriptCapitalD] Calculus\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", \
"\"\<=========================================================================\
\>\"", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "g", ",", "GammaSymmetryRule", ",", "MetricSymmetryRule", ",", "term1", ",",
      "term2", ",", "term3", ",", "combination", ",", "targetIndex"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<1. PHYSICAL CONSTRAINTS \
-------------------------------------------------\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<1a. Torsion-free geometry: \
\!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalGamma]\), \(\[Alpha]\)], \(\
\[Beta]\[Gamma]\)]\) == \
\!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalGamma]\), \(\[Alpha]\)], \(\
\[Gamma]\[Beta]\)]\), [MTW] Box 10.2, page 250 \>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GammaSymmetryRule", "=", 
    RowBox[{"Echo", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[CapitalGamma]", "[", 
        RowBox[{"u_", ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "b_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "c_", "]"}]}], "]"}], ":>", 
       "\[IndentingNewLine]", 
       RowBox[{"\[CapitalGamma]", "[", 
        RowBox[{"u", ",", 
         RowBox[{"\[ScriptCapitalD]", "[", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"{", 
             RowBox[{"b", ",", "c"}], "}"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"{", 
             RowBox[{"b", ",", "c"}], "}"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "\"\<\[CapitalGamma] Symmetry: \>\""}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<1b. Metric Symmetry: \!\(\*SubscriptBox[\(g\), \
\(\[Alpha]\[Beta]\)]\) == \!\(\*SubscriptBox[\(g\), \(\[Beta]\[Alpha]\)]\), \
[MTW] Equation 8.24, page 210\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
