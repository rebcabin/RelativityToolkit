   3.977322297059043*^9, 3.9773223132076263`*^9}, 3.977322404847395*^9, 
   3.9773231929183893`*^9, 3.977325166625751*^9, 3.977327594010818*^9},
 CellLabel->
  "During evaluation of \
In[29]:=",ExpressionUUID->"efb592ff-784a-4f2c-b7af-f8b284a33934"]
}, Open  ]],

Cell[BoxData[
 TagBox[
  RowBox[{
   SubsuperscriptBox["\[CapitalGamma]", 
    RowBox[{"\[Mu]", "\[Nu]"}], "\[Sigma]"], "\[Equal]", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"g", 
      SuperscriptBox["", "\[Sigma]"], 
      SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       RowBox[{"g", 
        SubscriptBox["", "\[Lambda]"], 
        SubscriptBox["", "\[Mu]"]}], 
       RowBox[{",", "\[Nu]"}]], "+", 
      SubscriptBox[
       RowBox[{"g", 
        SubscriptBox["", "\[Lambda]"], 
        SubscriptBox["", "\[Nu]"]}], 
       RowBox[{",", "\[Mu]"}]], "-", 
      SubscriptBox[
       RowBox[{"g", 
        SubscriptBox["", "\[Mu]"], 
        SubscriptBox["", "\[Nu]"]}], 
       RowBox[{",", "\[Lambda]"}]]}], ")"}]}]}],
  HoldForm]], "Output",
 CellChangeTimes->{
  3.977318019192609*^9, 3.977318156642076*^9, 3.977318272258873*^9, 
   3.97731835132066*^9, 3.977318468573053*^9, 3.97731862873346*^9, 
   3.977318677016766*^9, 3.977319225406111*^9, 3.977319301126915*^9, 
   3.9773195510289307`*^9, 3.97731991661285*^9, 3.9773201110460863`*^9, 
   3.9773202114968987`*^9, 3.97732024782148*^9, 3.97732029205053*^9, 
   3.9773203383107*^9, 3.977320425424859*^9, {3.9773204708280087`*^9, 
   3.97732049148219*^9}, 3.9773205279923143`*^9, 3.9773206788143578`*^9, 
   3.977320775032148*^9, 3.977320862956888*^9, 3.977320937595018*^9, 
   3.977321164949706*^9, 3.977321336257566*^9, 3.9773214011273203`*^9, 
   3.977321616649445*^9, 3.977321852875246*^9, 3.977321926559836*^9, 
