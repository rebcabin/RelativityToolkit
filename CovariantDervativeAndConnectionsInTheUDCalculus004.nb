  3.977660323163662*^9}},ExpressionUUID->"b9623eb4-8fbc-41e1-b382-\
d4e882563d59"],

Cell[TextData[{
 StyleBox["Another mnemonic: the unprimed up index of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "2d8022b2-f2a2-44f2-9846-5eb6ae420ed7"],
 StyleBox[" matches ",
  FontSlant->"Italic"],
 "contrariwise",
 StyleBox[" the unprimed down index of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{"\[Alpha]", "'"}]]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "\[Alpha]"]}]], TraditionalForm]],ExpressionUUID->
  "00261e28-49a0-4b21-8a80-fe67a2809299"],
 StyleBox[", given that an up index in the denominator ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PartialD]", 
    SuperscriptBox["x", "\[Alpha]"]}], TraditionalForm]],ExpressionUUID->
  "f51120b7-1c14-4269-abf5-8de83cdb544f"],
 " ",
 StyleBox["of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{"\[Alpha]", "'"}]]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "\[Alpha]"]}]], TraditionalForm]],ExpressionUUID->
  "96607a4e-8261-497c-9edb-cffb6fbce135"],
 StyleBox[" is a down index of the whole ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{"\[Alpha]", "'"}]]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "\[Alpha]"]}]], TraditionalForm]],ExpressionUUID->
  "d3e20f4b-f1da-47e2-9d96-ede2902b5b8e"],
 StyleBox[". ",
  FontSlant->"Italic"],
 "\[ScriptCapitalU]\[ScriptCapitalD]",
 StyleBox[" automates this ",
  FontSlant->"Italic"],
 StyleBox["valence check",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977153861326132*^9, 3.9771540497460938`*^9}, {
   3.977154168063142*^9, 3.97715419045991*^9}, 3.9771545610602417`*^9, {
   3.977345312899496*^9, 3.977345316776931*^9}, {3.9776603298573*^9, 
   3.977660423567828*^9}},ExpressionUUID->"eaf08590-b345-4ca2-8f37-\
13d8c37d6ea6"],

Cell[TextData[{
 StyleBox["The quantities ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{"\[Alpha]", "'"}]]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "\[Alpha]"]}]], TraditionalForm]],ExpressionUUID->
  "f41d46d2-c937-4a59-984b-057bcc220ef4"],
 StyleBox[" are the ",
  FontSlant->"Italic"],
 StyleBox["Jacobian of the coordinate transformation",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" from ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "b6720132-3ca7-434d-9c43-f2e112617cac"],
 StyleBox[" to  ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Alpha]"], "'"}], TraditionalForm]],ExpressionUUID->
  "40c62663-d116-4f99-a9cb-eff889ca804e"],
 StyleBox[", sometimes written (totally ambiguously!) as J, with ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "\[Alpha]"]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{"\[Alpha]", "'"}]]}]], TraditionalForm]],ExpressionUUID->
  "d308708d-1360-40b4-bc25-ccf77a8a28d5"],
 StyleBox[" being ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["J", 
    RowBox[{" ", 
     RowBox[{"-", "1"}]}]], TraditionalForm]],ExpressionUUID->
  "cd25ff91-a873-4466-9acf-27ff575e9a66"],
 ". ",
 StyleBox["In manual calculations, one must constantly check the \
\[OpenCurlyDoubleQuote]direction\[CloseCurlyDoubleQuote] of Jacobian every \
time; it\[CloseCurlyQuote]s a fertile source of error. ",
  FontSlant->"Italic"],
 StyleBox["\[ScriptCapitalU]\[ScriptCapitalD]",
  FontWeight->"Bold"],
 StyleBox[" won\[CloseCurlyQuote]t let you make this mistake!",
  FontWeight->"Bold",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9771542756179323`*^9, 3.9771544303299227`*^9}, {
  3.977154467162887*^9, 3.977154516779744*^9}, {3.977154553142323*^9, 
  3.97715455559272*^9}, {3.977345389145159*^9, 
  3.9773454135796547`*^9}},ExpressionUUID->"87eaa408-b340-40f6-b664-\
2d50915a3075"],

Cell[TextData[StyleBox["Covariant tensors transform with the matching index \
co-wise in the numerator of the Jacobian. The mnemonical example is a \
gradient, say degrees of temperature per foot or inch.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.977326453193863*^9, 3.977326611836729*^9}, {
  3.977345353444269*^9, 
  3.977345363862248*^9}},ExpressionUUID->"6ddc640f-8050-4b45-a557-\
3b4e39319ebf"],

Cell["\<\
Now calculate partial derivatives with respect to the primed frame: \
\>", "Text",
 CellChangeTimes->{{3.977009690387065*^9, 3.977009710899132*^9}, {
   3.977041301946884*^9, 3.9770413251682167`*^9}, {3.977152808983655*^9, 
   3.977152809465775*^9}, 
   3.97732848109962*^9},ExpressionUUID->"6486085b-2402-492d-a175-\
3585b6949957"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], "\[Congruent]", 
   RowBox[{
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{"\[Alpha]", "'"}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "\[Alpha]"]}]], 
      SuperscriptBox["A", "\[Alpha]"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977008276090537*^9, 3.977008414049974*^9}, {
   3.977060850916094*^9, 3.977060862323194*^9}, 
   3.97715281905665*^9},ExpressionUUID->"a4fe1c7f-d7b3-412a-8c44-\
20df7796f258"],

Cell[TextData[{
 StyleBox["This notation is different from ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Lovelock & Rund",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://a.co/d/1Lm1ipR"], None},
  ButtonNote->"https://a.co/d/1Lm1ipR"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[", who write",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "_"], "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "9503deda-ff8f-471d-94d0-5233c72da24b"],
 " ",
 StyleBox["for the transformation functions, with Greek indices that have no \
primes. However, we will not be confused: ",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"\[Alpha]", "'"}]], TraditionalForm]],ExpressionUUID->
  "02199e11-78af-4160-8fe2-318f60454a72"],
 " ",
 StyleBox["is short for",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", 
     RowBox[{"\[Alpha]", "'"}]], "(", 
    SuperscriptBox["x", "\[Beta]"], ")"}], TraditionalForm]],ExpressionUUID->
  "24d1c814-4c71-451c-871e-b31ce3d391e4"],
 ", ",
 StyleBox["four functions of four arguments each in relativistic physics, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "68095f46-653c-4f67-a324-61b2e8ed2390"],
 " ",
 StyleBox["functions of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1a04770a-211c-4c58-856a-bc5d0ed2f168"],
 StyleBox[" arguments more generally. These functions",
  FontSlant->"Italic"],
 StyleBox[" express new coordinates in terms of old. The prime isn\
\[CloseCurlyQuote]t really on the index, but on the pair of literal ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "ca397c36-0541-4fee-83a0-d464f38c3db0"],
 StyleBox[" and the index. We write it on the index only for ease of \
typesetting. Also be reminded that the partial derivatives with respect to \
independent variables ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Beta]"], TraditionalForm]],ExpressionUUID->
  "6d9056b6-fd39-4c94-bded-5660cfd9613a"],
 StyleBox[" are mechanical, symbolical operations.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977004335524499*^9, 3.9770043704738903`*^9}, {
  3.977004459862672*^9, 3.977004462955502*^9}, {3.977004607950364*^9, 
  3.977004657450521*^9}, {3.9770051541433764`*^9, 3.977005223612775*^9}, {
  3.97700531611539*^9, 3.9770055667106743`*^9}, {3.9770056293925962`*^9, 
  3.977005692088046*^9}, {3.9770057691765127`*^9, 3.977005809766267*^9}, {
  3.9770058466687117`*^9, 3.977005916940502*^9}, {3.9770060689174433`*^9, 
  3.977006082939225*^9}, {3.977007267875451*^9, 3.977007287649378*^9}, {
  3.977007606552973*^9, 3.977007804922398*^9}, {3.977065238980687*^9, 
  3.9770652412681017`*^9}, {3.977152543318152*^9, 3.977152543318892*^9}, {
  3.977154096432994*^9, 3.977154158510647*^9}, {3.9773267180013533`*^9, 
  3.977326722423489*^9}, {3.97734544397766*^9, 3.97734547245648*^9}, {
  3.977660499552113*^9, 
  3.9776605936105556`*^9}},ExpressionUUID->"620cbe4c-e2ba-4552-9c34-\
9b50a700b51f"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s have \[ScriptCapitalU]\[ScriptCapitalD] do this bit \
of calculus. As stated, the code is maintained as a block of code rather than \
as alternating prose and code cells. But the comments and the Echoes tell the \
whole story as prose. ",
 StyleBox["Read The Code",
  FontWeight->"Bold"],
 " and the results. "
}], "Text",
 CellChangeTimes->{{3.977041334909045*^9, 3.977041357964467*^9}, {
   3.9770413927139*^9, 3.977041393667335*^9}, 3.9770652572467546`*^9, {
   3.977154207926816*^9, 3.977154217613781*^9}, {3.977326764596551*^9, 
   3.9773268080223083`*^9}, 3.977327236988377*^9, {3.977345485094471*^9, 
   3.97734552493747*^9}, {3.977345571806055*^9, 3.977345572042383*^9}, {
   3.977660619678384*^9, 
   3.97766064498179*^9}},ExpressionUUID->"b2d77625-7405-4742-b8f5-\
13c59f7aa6d6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"ap", ",", "bp", ",", "mu"}], "]"}], ";"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "1"}], ":", " ", 
    RowBox[{"Define", " ", "the", " ", "Input"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Partial", " ", "derivative", " ", "of", " ", "the", " ", "Transformed", " ",
     "Vector", " ", 
    RowBox[{"A", "'"}], " ", 
    RowBox[{"w", ".", "r", ".", "t"}], " ", 
    RowBox[{"x", "'"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Input", ":", " ", 
    RowBox[{"via", " ", "Partials"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"inputTerm", "=", 
    RowBox[{"Echo", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Partials", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Expand", " ", 
         SuperscriptBox["A", 
          RowBox[{"\[Alpha]", "'"}]], " ", "into", " ", "Jac", " ", "*", " ", 
         
         SuperscriptBox["A", "\[Mu]"], " ", "immediately", " ", "via", " ", 
         "existing", " ", "rule"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "ap", "]"}], "]"}], "/.", " ", 
         "robustTransformRules"}], ",", 
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "\"\<1. Input \
\!\(\*SubscriptBox[\(\[PartialD]\), \
\(\[Beta]'\)]\)(\!\(\*SuperscriptBox[\(A\), \(\[Alpha]'\)]\)) \[Congruent] \!\
\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Alpha]'\)], \(, \(\\\ \)\(\[Beta]'\
\)\)]\):\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "2"}], ":", 
    RowBox[{"Mechanical", " ", "Expansion"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Apply", " ", "Leibniz", " ", "and", " ", "Chain", " ", "Rule", " ", 
    "repeatedly", " ", "until", " ", "stable"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"expandedTerm", "=", 
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"ExpandDerivatives", "[", "inputTerm", "]"}], ",", 
      "\[IndentingNewLine]", "\"\<2. Mechanically Expanded Derivative:\>\""}],
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "3"}], ":", "Formatting"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Map", " ", "internal", " ", "unique", " ", "dummies", " ", "to", " ", 
    "readable", " ", "Greek"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"prettyResult", "=", 
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"expandedTerm", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ap", "->", 
          RowBox[{"\[Alpha]", "'"}]}], ",", 
         RowBox[{"bp", "->", 
          RowBox[{"\[Beta]", "'"}]}], ",", 
         RowBox[{"mu", "->", "\[Mu]"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", "\"\<3. Peek at unique dummy indices\>\""}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"brokenPartial", "=", 
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"TensorForm", "[", "prettyResult", "]"}], ",", 
     "\[IndentingNewLine]", "\"\<4. Expanded \!\(\*SubscriptBox[\(\[PartialD]\
\), \(\[Beta]'\)]\)(\!\(\*SuperscriptBox[\(A\), \(\[Alpha]'\)]\)) in Readable \
Greek\>\""}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.977008741929626*^9, 3.977008820235695*^9}, 
   3.977008885372672*^9, {3.9770094423020697`*^9, 3.9770094577204313`*^9}, {
   3.977009737355989*^9, 3.977009833411221*^9}, {3.9770098725691023`*^9, 
   3.977009904582294*^9}, {3.977009936258263*^9, 3.977009980150612*^9}, {
   3.9770414147097273`*^9, 3.977041424849421*^9}, {3.9770532950091743`*^9, 
   3.977053301338974*^9}, {3.977065288356881*^9, 3.977065415628669*^9}, {
   3.9771542395214577`*^9, 3.977154247109915*^9}, {3.977154624176413*^9, 
   3.977154690844907*^9}, 3.977179168389043*^9, {3.9773268593533373`*^9, 
   3.977326877296373*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"f2ecf498-1b10-4db8-9555-6f43d404622a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  TagBox["\<\"1. Input \\!\\(\\*SubscriptBox[\\(\[PartialD]\\), \
\\(\[Beta]'\\)]\\)(\\!\\(\\*SuperscriptBox[\\(A\\), \\(\[Alpha]'\\)]\\)) \
\[Congruent] \\!\\(\\*SubscriptBox[SuperscriptBox[\\(A\\), \\(\[Alpha]'\\)], \
\\(, \\(\\\\ \\)\\(\[Beta]'\\)\\)]\\):\"\>",
   "EchoLabel"], "  ", 
  SubscriptBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"A", 
      SuperscriptBox["", "\[Mu]23"]}], ")"}], " ", 
    FractionBox[
     RowBox[{
      RowBox[{"\[PartialD]", "x"}], 
      SuperscriptBox["", "ap"]}], 
     RowBox[{
      RowBox[{"\[PartialD]", "x"}], 
      SuperscriptBox["", "\[Mu]23"]}]]}], 
   RowBox[{",", "bp"}]]}]], "Echo",
 CellChangeTimes->{
  3.977660657659204*^9},ExpressionUUID->"3006387e-3fb3-42fb-a9fa-\
db678a7c867e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   TagBox["\<\"2. Mechanically Expanded Derivative:\"\>",
    "EchoLabel"], "  ", 
   RowBox[{"(", 
    RowBox[{"A", 
     SuperscriptBox["", "\[Mu]23"]}], ")"}], " ", 
   FractionBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["\[PartialD]", "2"], "x"}], 
     SuperscriptBox["", "ap"]}], 
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "\[Mu]23"], 
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "bp"]}]]}], "+", 
  RowBox[{
   RowBox[{"(", 
    SubscriptBox[
     RowBox[{"A", 
      SuperscriptBox["", "\[Mu]23"]}], 
     RowBox[{",", "bp"}]], ")"}], " ", 
   FractionBox[
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "ap"]}], 
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "\[Mu]23"]}]]}]}]], "Echo",
 CellChangeTimes->{
  3.9776606576646147`*^9},ExpressionUUID->"5e6661e5-2579-4324-9b89-\
0927df3e6a9b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   TagBox["\<\"3. Peek at unique dummy indices\"\>",
    "EchoLabel"], "  ", 
   RowBox[{"(", 
    RowBox[{"A", 
     SuperscriptBox["", "\[Mu]23"]}], ")"}], " ", 
   FractionBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["\[PartialD]", "2"], "x"}], 
     SuperscriptBox["", 
      SuperscriptBox["\[Alpha]", "\[Prime]",
       MultilineFunction->None]]}], 
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", 
      SuperscriptBox["\[Beta]", "\[Prime]",
       MultilineFunction->None]], 
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "\[Mu]23"]}]]}], "+", 
  RowBox[{
   RowBox[{"(", 
    SubscriptBox[
     RowBox[{"A", 
      SuperscriptBox["", "\[Mu]23"]}], 
     RowBox[{",", 
      SuperscriptBox["\[Beta]", "\[Prime]",
       MultilineFunction->None]}]], ")"}], " ", 
   FractionBox[
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", 
      SuperscriptBox["\[Alpha]", "\[Prime]",
       MultilineFunction->None]]}], 
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "\[Mu]23"]}]]}]}]], "Echo",
 CellChangeTimes->{
  3.9776606576860867`*^9},ExpressionUUID->"1a68c48a-931c-4c54-b6ed-\
e5c56c390f8e"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"4. Expanded \\!\\(\\*SubscriptBox[\\(\[PartialD]\\), \
\\(\[Beta]'\\)]\\)(\\!\\(\\*SuperscriptBox[\\(A\\), \\(\[Alpha]'\\)]\\)) in \
Readable Greek\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"A", 
       SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
     FractionBox[
      RowBox[{
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], "x"}], 
       SuperscriptBox["", 
        SuperscriptBox["\[Alpha]", "\[Prime]",
         MultilineFunction->None]]}], 
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", 
        SuperscriptBox["\[Beta]", "\[Prime]",
         MultilineFunction->None]], 
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", "\[Lambda]"]}]]}], "+", 
    RowBox[{
     RowBox[{"(", 
      SubscriptBox[
       RowBox[{"A", 
        SuperscriptBox["", "\[Lambda]"]}], 
       RowBox[{",", 
        SuperscriptBox["\[Beta]", "\[Prime]",
         MultilineFunction->None]}]], ")"}], " ", 
     FractionBox[
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", 
        SuperscriptBox["\[Alpha]", "\[Prime]",
         MultilineFunction->None]]}], 
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", "\[Lambda]"]}]]}]}],
   HoldForm]}]], "Echo",
 CellChangeTimes->{
  3.977660657688713*^9},ExpressionUUID->"15bf4e1b-7113-40f4-b7a2-\
d90fdac4f621"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Connection Coefficients", "Section",
 CellChangeTimes->{{3.977150665926794*^9, 3.97715067080284*^9}, {
  3.977154806254768*^9, 
  3.9771548116241627`*^9}},ExpressionUUID->"75d41b3d-e4ba-476b-9f3a-\
8ca1677b5c28"],

Cell[TextData[{
 StyleBox["A .wl block-version of code for this section, minus the prose, is \
available at ",
  FontSlant->"Italic"],
 StyleBox["https://github.com/rebcabin/RelativityToolkit/blob/main/law_of_\
gamma.wl",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[". ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9771500832617273`*^9, 3.9771501268724957`*^9}, {
   3.977150679079076*^9, 3.977150685730893*^9}, 
   3.9773269896849327`*^9},ExpressionUUID->"9fd95b46-6eef-4116-ab9a-\
aa2d4b83f835"],

Cell[CellGroupData[{

Cell["The Partials are a Mess", "Subsection",
 CellChangeTimes->{{3.977155403581815*^9, 3.9771554107464933`*^9}, {
  3.977155655529076*^9, 3.9771556615944233`*^9}, {3.977155780594692*^9, 
  3.977155782482003*^9}},ExpressionUUID->"8e87641c-a52f-415f-aef1-\
2bcf61db11be"],

Cell[TextData[{
 "The partial derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", " ", "\[Beta]"}]], TraditionalForm]],ExpressionUUID->
  "3070d98c-a02c-4a3e-b79e-370c4cf461fd"],
 " is not tensorial, else it would transform like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Alpha]", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Alpha]"]}]], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    SubscriptBox[
     SuperscriptBox["A", "\[Alpha]"], 
     RowBox[{",", " ", "\[Beta]", " "}]]}], TraditionalForm]],
  CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
   3.9770114425225677`*^9, 3.977011477474715*^9}},ExpressionUUID->
  "5b3691bd-bb3b-4a1b-9920-7dbf35fabe22"],
 ". When we differentiate ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"\[Alpha]", "'"}]], TraditionalForm]],ExpressionUUID->
  "44acfb1d-81ff-45ef-8255-289a1c404c79"],
 ", the transform of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "3191fc55-4493-4ca3-b4b1-3d83e575b428"],
 ", in the new coordinate system ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"\[Beta]", " ", "'"}]], TraditionalForm]],ExpressionUUID->
  "bd0cb467-3319-4ab7-be62-2fbed0326646"],
 " (from Echo 1, above): "
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
   3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
   3.977011051138826*^9}, {3.977011515235486*^9, 3.977011570673971*^9}, {
   3.9770414603757057`*^9, 3.977041538097261*^9}, {3.977053320309387*^9, 
   3.977053356535059*^9}, {3.9770538109602013`*^9, 3.9770538155186*^9}, {
   3.977155682100684*^9, 3.977155691256544*^9}, {3.977155725060988*^9, 
   3.977155731954468*^9}, {3.977343598017371*^9, 3.97734360794422*^9}, 
   3.977343642359399*^9, 3.977345646389398*^9, {3.977660706507341*^9, 
   3.9776607157901993`*^9}},ExpressionUUID->"06a7d4c4-a2c0-479b-8a69-\
6ab4468c4c67"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["A", 
       RowBox[{"\[Alpha]", " ", "'"}]], "\[Congruent]", 
      RowBox[{
       SuperscriptBox["A", "\[Mu]"], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Mu]"}]]}]]}]}], ")"}]}], "\[Congruent]", 
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], "\[Congruent]", 
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["A", "\[Mu]"], " ", 
      FractionBox[
       RowBox[{
        RowBox[{"\[PartialD]", "x"}], 
        SuperscriptBox["", 
         RowBox[{"\[Alpha]", "'"}]]}], 
       RowBox[{
        RowBox[{"\[PartialD]", "x"}], 
        SuperscriptBox["", "\[Mu]"]}]]}], ")"}], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", "  ", "'"}]}]]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977053825090283*^9, 3.9770539820693007`*^9}, {
   3.977054016679175*^9, 3.977054049741235*^9}, {3.977054102978526*^9, 
   3.977054109922058*^9}, {3.9771548635966177`*^9, 3.977154934476821*^9}, 
   3.97715496480508*^9, {3.9773436256094437`*^9, 
   3.977343627052876*^9}},ExpressionUUID->"c5d11daf-857b-4d39-9ac6-\
57636f2c0a9e"],

Cell[TextData[{
 "we don\[CloseCurlyQuote]t get the transform  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "\[Alpha]"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", " ", "'"}]]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{" ", 
         RowBox[{"\[Beta]", " ", "'"}]}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{" ", "\[Beta]"}]]}]], 
     SubscriptBox[
      SuperscriptBox["A", 
       RowBox[{"\[Alpha]", " ", "'"}]], 
      RowBox[{",", " ", 
       RowBox[{"\[Beta]", " ", "'"}]}]]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
   3.9770114425225677`*^9, 3.977011477474715*^9}},ExpressionUUID->
  "6a465448-e981-439b-b64a-655ba41e5065"],
 " of the derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], TraditionalForm]],ExpressionUUID->
  "b4ca2611-eb27-47a3-a7cb-2f9b846875a1"],
 ", but two terms that are difficult to interpret: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["A", "\[Lambda]"], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], 
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", "'"}]]}], 
      RowBox[{
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{"\[Beta]", " ", "'"}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "\[Lambda]"]}]}]]}], ")"}], TraditionalForm]],
  ExpressionUUID->"a90d8813-4cc4-43d0-ba69-d386cde6ca32"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["A", "\[Lambda]"], 
      RowBox[{",", " ", 
       RowBox[{"\[Beta]", " ", "'"}]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", "'"}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "\[Lambda]"]}]]}], ")"}], TraditionalForm]],
  ExpressionUUID->"1d9509af-8d70-48fa-9efc-e35bb0909e5c"],
 " from Echo 4 above)."
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
   3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
   3.977011051138826*^9}, {3.977011515235486*^9, 3.977011570673971*^9}, {
   3.9770414603757057`*^9, 3.977041538097261*^9}, {3.977053320309387*^9, 
   3.977053356535059*^9}, {3.9770592584261723`*^9, 3.977059369274659*^9}, 
   3.9770594025116243`*^9, {3.9770666475906487`*^9, 3.977066648961801*^9}, {
   3.97715503842208*^9, 3.9771550518985853`*^9}, {3.977155694581345*^9, 
   3.977155698895607*^9}, {3.97734365529335*^9, 3.9773436934118547`*^9}, {
   3.97766087814517*^9, 
   3.9776608791074753`*^9}},ExpressionUUID->"8f1ec892-b6d9-4a76-8149-\
21b4735ad9e8"],

Cell[TextData[{
 "These terms have factors, ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     SuperscriptBox["x", 
      RowBox[{"\[Alpha]", "'"}]]}], 
    RowBox[{
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Beta]", " ", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Lambda]"]}]}]], TraditionalForm]],ExpressionUUID->
  "adad717a-7a29-4596-86c0-e48fcdaa64f3"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Lambda]"], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], TraditionalForm]],ExpressionUUID->
  "43450047-a74f-43fd-94a7-765e5cea86e8"],
 " respectively, that are calculated in both coordinate systems, and that\
\[CloseCurlyQuote]s disturbing. We can extract one Jacobian factor of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{" ", "\[Beta]"}]]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{" ", 
       RowBox[{"\[Beta]", " ", "'"}]}]]}]], TraditionalForm]],ExpressionUUID->
  "f7e8d4b6-9256-44aa-8d86-785359c057d7"],
 ", but that\[CloseCurlyQuote]s it. Rewrite the last line, Echo 4, as follows:"
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
  3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
  3.977011051138826*^9}, {3.977011515235486*^9, 3.977011570673971*^9}, {
  3.9770414603757057`*^9, 3.977041538097261*^9}, {3.977053320309387*^9, 
  3.977053356535059*^9}, {3.9770592584261723`*^9, 3.977059369274659*^9}, {
  3.9770594205474043`*^9, 3.977059425344063*^9}, {3.9770655434250927`*^9, 
  3.977065571669265*^9}, {3.9770659566282063`*^9, 3.9770659782154293`*^9}, {
  3.9770666890912848`*^9, 3.977066749670599*^9}, {3.977155100992359*^9, 
  3.977155102669262*^9}, {3.977155147971437*^9, 3.977155149729313*^9}, {
  3.977343702069891*^9, 3.977343751225404*^9}, {3.977660872900454*^9, 
  3.977660905951573*^9}},ExpressionUUID->"216108f1-fe2e-400a-a1e0-\
31ea1a07077c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", " ", "'"}]], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["A", 
       RowBox[{" ", "\[Lambda]"}]], "(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], 
        SuperscriptBox["x", 
         RowBox[{" ", 
          RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
       RowBox[{
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Beta]", " ", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]}]], ")"}], "+", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        SuperscriptBox["A", 
         RowBox[{" ", "\[Lambda]"}]], 
        RowBox[{",", " ", 
         RowBox[{"\[Beta]", " ", "'"}]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]]}], ")"}]}], "=", "\[LineSeparator]", 
    
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["A", 
        RowBox[{" ", "\[Lambda]"}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Beta]"}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
       RowBox[{"(", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], 
          SuperscriptBox["x", 
           RowBox[{" ", 
            RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
         RowBox[{
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Beta]"}]]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Lambda]"}]]}]}]], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          SuperscriptBox["A", 
           RowBox[{" ", "\[Lambda]"}]], 
          RowBox[{",", " ", "\[Beta]", " "}]], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Beta]"}]]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", 
             RowBox[{"\[Beta]", " ", "'"}]}]]}]]}], ")"}], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]]}]}], "=", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", "\[Beta]"}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", 
          RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["A", 
          RowBox[{" ", "\[Lambda]"}]], 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[PartialD]", "2"], 
           SuperscriptBox["x", 
            RowBox[{" ", 
             RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
          RowBox[{
           RowBox[{"\[PartialD]", 
            SuperscriptBox["x", 
             RowBox[{" ", "\[Beta]"}]]}], 
           RowBox[{"\[PartialD]", 
            SuperscriptBox["x", 
             RowBox[{" ", "\[Lambda]"}]]}]}]]}], "+", 
        RowBox[{
         SubscriptBox[
          SuperscriptBox["A", 
           RowBox[{" ", "\[Lambda]"}]], 
          RowBox[{",", " ", "\[Beta]", " "}]], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", 
             RowBox[{"\[Alpha]", "'"}]}]]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Lambda]"}]]}]]}]}], ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977053379479414*^9, 3.97705375883645*^9}, {
   3.9770594797492647`*^9, 3.977059513634585*^9}, {3.9770600785843143`*^9, 
   3.977060105446658*^9}, {3.977060142965212*^9, 3.9770601668754187`*^9}, {
   3.977060241161337*^9, 3.97706024837414*^9}, {3.9770655886816063`*^9, 
   3.977065613258123*^9}, {3.977065745169601*^9, 3.977065785382228*^9}, {
   3.977066767336562*^9, 3.977066812952137*^9}, {3.977155128974546*^9, 
   3.977155134609047*^9}, 3.9771552277992783`*^9, 
   3.977660972452651*^9},ExpressionUUID->"68824569-07ee-4dde-aba3-\
054006e8fab6"],

Cell[TextData[{
 "The quantity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["A", 
        RowBox[{" ", "\[Lambda]"}]], 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
        RowBox[{
         RowBox[{"\[PartialD]", 
          SuperscriptBox["x", 
           RowBox[{" ", "\[Beta]"}]]}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["x", 
           RowBox[{" ", "\[Lambda]"}]]}]}]]}], "+", 
      RowBox[{
       SubscriptBox[
        SuperscriptBox["A", 
         RowBox[{" ", "\[Lambda]"}]], 
        RowBox[{",", " ", "\[Beta]", " "}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]]}]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"9aa93cc7-3892-41a9-ba6c-bd51f8fb66ca"],
 " is not tensorial because it has a free index \[Alpha]\[CloseCurlyQuote]. \
Worse, it depends on both coordinate systems, the primed and the unprimed, \
and we can\[CloseCurlyQuote]t have that! Worse still, ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     SuperscriptBox["x", 
      RowBox[{" ", 
       RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
    RowBox[{
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Lambda]"}]]}]}]], TraditionalForm]],ExpressionUUID->
  "57648b80-f7ab-4510-82c5-c78b42b9bae4"],
 " the ",
 StyleBox["Hessian",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of the coordinate transformation, is not a geometrical object, but rather \
an algebraic object. It can\[CloseCurlyQuote]t itself be transformed. It \
depends on particular choices of two coordinate systems. \
It\[CloseCurlyQuote]s of no help."
}], "Text",
 CellChangeTimes->{{3.9770595997808647`*^9, 3.977059649976912*^9}, {
  3.977060262908671*^9, 3.977060269336875*^9}, {3.977065629016151*^9, 
  3.9770656653095827`*^9}, {3.977065732646055*^9, 3.977065734676793*^9}, {
  3.977065803951926*^9, 3.9770659401694393`*^9}, {3.977066838368587*^9, 
  3.977066845133431*^9}, {3.97715523729615*^9, 3.97715537923213*^9}, {
  3.9773437825923567`*^9, 3.977343789036359*^9}, {3.977343823429101*^9, 
  3.977343854911965*^9}, {3.977660923145067*^9, 3.977660946711089*^9}, {
  3.97766098417078*^9, 
  3.977661019079178*^9}},ExpressionUUID->"ebe8ffac-67c3-483f-adef-\
8fd6a04619f1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Way Out: Covariant Derivative", "Subsection",
 CellChangeTimes->{{3.977155386127281*^9, 3.977155391519208*^9}, {
  3.9771566757235737`*^9, 
  3.977156681157469*^9}},ExpressionUUID->"8cdcbe6e-365d-468f-be86-\
83a59db22473"],

Cell[TextData[{
 "There\[CloseCurlyQuote]s a way out: insist on a certain form. Write the \
tensorial derivative we want, ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],ExpressionUUID->
  "a8336d50-c4e3-4ab3-a0f9-b625815fbd11"],
 ", as the non-tensorial partial derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", " ", "\[Beta]", " "}]], TraditionalForm]],ExpressionUUID->
  "4538a6d3-9eb4-43d0-90e7-3db2329578b6"],
 " plus a correction. Demand that the correction be linear in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "de4487a5-b9aa-4306-b988-17626f8719d7"],
 " and that the sum\[LongDash]partial derivative plus \
correction\[LongDash]transform tensorially. Defining the ",
 StyleBox["semicolon notation ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "for this \[OpenCurlyDoubleQuote]corrected \
derivative\[CloseCurlyDoubleQuote] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]", " "}]], TraditionalForm]],ExpressionUUID->
  "913dd4b6-f1c0-4800-a31c-a34290168771"]
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
   3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
   3.977010967374028*^9}, {3.977011058197987*^9, 3.9770111504156837`*^9}, {
   3.977011577000286*^9, 3.977011599925207*^9}, {3.9770415661310177`*^9, 
   3.9770416017082853`*^9}, 3.977065836365576*^9, {3.977066857271544*^9, 
   3.977066886804606*^9}, {3.977155793273237*^9, 3.9771558080498247`*^9}, {
   3.977155856304111*^9, 3.977155940793297*^9}, {3.977156702547564*^9, 
   3.977156715247168*^9}, {3.9771747857993298`*^9, 3.9771748228690023`*^9}, {
   3.977174854204146*^9, 3.9771748754519863`*^9}, {3.977661032215549*^9, 
   3.977661040330563*^9}, {3.977661075485488*^9, 
   3.977661110346837*^9}},ExpressionUUID->"63150d01-ceda-4f22-803b-\
1a97f3847230"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]", " "}]], "\[Congruent]", 
   RowBox[{
    SubscriptBox[
     SuperscriptBox["A", "\[Alpha]"], 
     RowBox[{",", " ", "\[Beta]"}]], "+", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["\[CapitalGamma]", 
       RowBox[{" ", "\[Alpha]"}]], 
      RowBox[{"\[Beta]", " ", "\[Mu]"}]], 
     SuperscriptBox["A", 
      RowBox[{" ", "\[Mu]"}]]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977010636055129*^9, 3.977010643913973*^9}, {
   3.9770111624798183`*^9, 3.977011270616735*^9}, {3.9771747395848227`*^9, 
   3.977174765973565*^9}, 
   3.977174843804628*^9},ExpressionUUID->"f9347413-dcec-4b5a-b910-\
1ddd35a13a6e"],

Cell["require that it transform as follows:", "Text",
 CellChangeTimes->{{3.9770112779099293`*^9, 3.977011307443584*^9}, {
  3.9770416099832573`*^9, 3.97704163759873*^9}, {3.97704167848347*^9, 
  3.977041680128821*^9}, {3.977174880283556*^9, 
  3.9771748832725563`*^9}},ExpressionUUID->"e22434f5-50f6-4a8b-9f8c-\
d3508d56c6ca"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], 
    RowBox[{";", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Alpha]", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Alpha]"]}]], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    SubscriptBox[
     SuperscriptBox["A", "\[Alpha]"], 
     RowBox[{";", " ", "\[Beta]", " "}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
  3.9770114425225677`*^9, 
  3.977011477474715*^9}},ExpressionUUID->"6b548b6d-3f69-4925-8eed-\
d69868613da1"],

Cell[TextData[{
 "then solve for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],
  CellChangeTimes->{{3.977010636055129*^9, 3.977010643913973*^9}, {
   3.9770111624798183`*^9, 3.977011270616735*^9}, {3.9771747395848227`*^9, 
   3.977174743955871*^9}},ExpressionUUID->
  "3e5103bb-3e12-4990-9d9b-f8465c1a1f08"],
 ". Notice contraction on the third index: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["\[CapitalGamma]", 
      RowBox[{" ", "\[Alpha]"}]], 
     RowBox[{"\[Beta]", " ", "\[Mu]"}]], 
    SuperscriptBox["A", 
     RowBox[{" ", "\[Mu]"}]]}], TraditionalForm]],ExpressionUUID->
  "b96c3df9-c068-46d0-8dc5-830ec825c2dd"],
 "."
}], "Text",
 CellChangeTimes->{{3.9770416266716547`*^9, 3.977041647098284*^9}, {
  3.977174763967944*^9, 3.97717476786619*^9}, {3.977175050927993*^9, 
  3.977175078468285*^9}},ExpressionUUID->"8d4d9e22-f3be-4906-b992-\
4ae23379e624"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]"}]], TraditionalForm]],
  CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
   3.9770114425225677`*^9, 3.977011477474715*^9}},ExpressionUUID->
  "aaff0e20-8a10-420c-ad21-d6122df7e173"],
 " is called the ",
 StyleBox["covariant derivative",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellChangeTimes->{{3.97715676668683*^9, 3.977156901945867*^9}, {
   3.977156959104426*^9, 3.9771569645507193`*^9}, 3.9771579540882998`*^9, {
   3.977174907070912*^9, 
   3.9771749073345127`*^9}},ExpressionUUID->"aa677b05-ae16-4eae-bbdd-\
f266f39e6736"],

Cell[TextData[{
 "Despite the name, the covariant derivative is ",
 StyleBox["contravariant",
  FontSlant->"Italic"],
 " in ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],ExpressionUUID->
  "3be9f4b4-3579-40d0-9f67-c0f7470f914a"],
 " and ",
 StyleBox["covariant",
  FontSlant->"Italic"],
 " in \[Beta], as we see shortly below. The word \
\[OpenCurlyDoubleQuote]covariant\[CloseCurlyDoubleQuote] here does not have \
its usual meaning, but we\[CloseCurlyQuote]re stuck with this historical \
nomenclature."
}], "Text",
 CellChangeTimes->{{3.97715676668683*^9, 3.977156901945867*^9}, {
  3.977156959104426*^9, 3.9771569645507193`*^9}, {3.977157960079286*^9, 
  3.977157987657321*^9}, {3.977174903293665*^9, 
  3.977174945451392*^9}},ExpressionUUID->"f4596ff2-20d6-46b9-810d-\
014bd9bf7e17"],

Cell[TextData[{
 StyleBox["The form of a term plus a correction is ubiquitous in linear \
theories such as that for the Kalman filter (see my notebook ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Kalman filtering as a functional fold",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3078712"], None},
  ButtonNote->"https://community.wolfram.com/groups/-/m/t/3078712"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox["). ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9771559693517923`*^9, 3.977156021556655*^9}, {
  3.977156121895274*^9, 3.97715618015761*^9}, {3.9771562325276012`*^9, 
  3.977156233055827*^9}, {3.97715673704572*^9, 3.9771567417996492`*^9}, {
  3.9771569819587927`*^9, 3.9771570277110653`*^9}, {3.9771586560285892`*^9, 
  3.977158662161306*^9}, {3.9771749724308147`*^9, 3.977174993224945*^9}, {
  3.977343903097906*^9, 3.977343949526277*^9}, {3.9773439915680857`*^9, 
  3.9773440134019623`*^9}},ExpressionUUID->"35276c52-c2f7-42af-bae3-\
7aad79ca3628"],

Cell[TextData[{
 StyleBox["The contravariant vector ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f380e0e8-e35e-4250-8f52-732cde379efb"],
 StyleBox[" is tensorial, measuring intrinsic properties of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8dfcecb3-85bf-4e18-9a0b-6767e8f3960f"],
 StyleBox[". ",
  FontSlant->"Italic"],
 "\[CapitalGamma]",
 StyleBox[" is not tensorial, mixing in extrinsic information about the \
coordinate system. The product ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "\[CapitalGamma]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8beca113-8cce-4659-8cdc-750fab619775"],
 StyleBox[" is tensorial again. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977661264549698*^9, 
  3.977661411282783*^9}},ExpressionUUID->"48be144d-a194-442b-9ec5-\
687f119d2990"],

Cell[TextData[{
 StyleBox["If we do our job right (proving tensoriality and linearity),",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]", " "}]], TraditionalForm]],ExpressionUUID->
  "a07fbd11-71da-429f-91d1-89ba5aca6b1a"],
 StyleBox[" becomes the promised \[OpenCurlyDoubleQuote]cool notation\
\[CloseCurlyDoubleQuote] for",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],ExpressionUUID->
  "086756b8-7739-4ca1-82ff-5717534bad2b"],
 StyleBox[", the derivative we want, the covariant derivative. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9771559693517923`*^9, 3.977156021556655*^9}, {
  3.977156121895274*^9, 3.97715618015761*^9}, {3.9771562325276012`*^9, 
  3.977156233055827*^9}, {3.97715673704572*^9, 3.9771567417996492`*^9}, {
  3.9771569819587927`*^9, 3.9771570277110653`*^9}, {3.9771586560285892`*^9, 
  3.977158662161306*^9}, {3.9771749724308147`*^9, 
  3.977174993224945*^9}},ExpressionUUID->"1d83214e-86d7-4ad8-bfd2-\
aecc4b565ba5"],

Cell[TextData[{
 StyleBox["One may also write ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Beta]"], 
    SuperscriptBox["A", "\[Alpha]"]}], TraditionalForm]],ExpressionUUID->
  "471dc727-dc48-4bc9-b946-f22491454a0d"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", " ", "\[Beta]"}]], TraditionalForm]],ExpressionUUID->
  "c40981cc-26ab-4dde-8fb5-5d93a7d45945"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "\[Beta]"], 
    SuperscriptBox["A", "\[Alpha]"]}], TraditionalForm]],ExpressionUUID->
  "e8553c96-7efe-450a-a763-edddc4e62890"],
 StyleBox[" for ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]"}]], TraditionalForm]],ExpressionUUID->
  "e7924a84-dafe-4933-a105-d18c5e1e4e0e"],
 StyleBox[". These forms frequently appear in the literature.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9771559693517923`*^9, 3.977156021556655*^9}, {
  3.977156121895274*^9, 3.97715618015761*^9}, {3.9771562325276012`*^9, 
  3.977156233055827*^9}, {3.97715673704572*^9, 3.9771567417996492`*^9}, {
  3.9771569819587927`*^9, 3.9771570277110653`*^9}, {3.9771586560285892`*^9, 
  3.977158662161306*^9}, {3.9771749724308147`*^9, 3.9771750114689007`*^9}, {
  3.977175131437334*^9, 3.977175253763031*^9}, {3.977344611788052*^9, 
  3.977344612098686*^9}},ExpressionUUID->"4258b0c6-f5b9-4f49-bc97-\
550d54ee2079"],

Cell[TextData[{
 StyleBox["TODO: Why must the correction ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["\[CapitalGamma]", 
      RowBox[{" ", "\[Alpha]"}]], 
     RowBox[{"\[Beta]", " ", "\[Mu]"}]], 
    SuperscriptBox["A", 
     RowBox[{" ", "\[Mu]"}]]}], TraditionalForm]],ExpressionUUID->
  "fd0324df-9389-4f2e-9cd7-20beaddacd1a"],
 " ",
 StyleBox["be linear in ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "37c96623-a5ed-4e06-9ed5-d665f61130c5"],
 "?"
}], "Item",
 CellChangeTimes->{{3.977011617039833*^9, 3.977011636431033*^9}, {
  3.977042016238361*^9, 3.977042024601349*^9}, {3.977156923684321*^9, 
  3.97715693513172*^9}, {3.977175276385495*^9, 
  3.9771752777294807`*^9}},ExpressionUUID->"5a9eb602-93d2-434f-87e1-\
04e0949c271c"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["SPOILER: We want our new derivative ",
  FontSlant->"Italic"],
 "\[Del]",
 StyleBox[" (aka the semicolon) to behave like any other derivative. That \
means it must satisfy two properties:",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.977012306806328*^9}, {
  3.977012633337566*^9, 3.977012649604801*^9}, {3.977012908231069*^9, 
  3.977012952354192*^9}, {3.977156038024061*^9, 3.977156040257764*^9}, {
  3.9771562072202053`*^9, 
  3.977156209677186*^9}},ExpressionUUID->"76428ab0-8541-45b0-8c78-\
82faffcebf92"],

Cell[TextData[{
 StyleBox["Linearity:",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Mu]"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["A", "\[Nu]"], "+", 
       SuperscriptBox["B", "\[Nu]"]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", "\[Mu]"], 
      SuperscriptBox["A", "\[Nu]"]}], "+", 
     RowBox[{
      SubscriptBox["\[Del]", "\[Mu]"], 
      SuperscriptBox["B", "\[Nu]"]}]}]}], TraditionalForm]],ExpressionUUID->
  "b512c16b-8097-4bc8-9abc-c0dd89a4bcfe"]
}], "Subitem",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770123871945553`*^9}, {
  3.977012726040819*^9, 
  3.977012726973077*^9}},ExpressionUUID->"ecaa396f-685e-4f68-a913-\
268a0ce9b653"],

Cell[TextData[{
 StyleBox["Leibniz Rule:",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Mu]"], 
     RowBox[{"(", 
      RowBox[{"f", "\[VeryThinSpace]", 
       SuperscriptBox["A", "\[Nu]"]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["A", "\[Nu]"], 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Mu]"], "f"}]}], "+", 
     RowBox[{"f", 
      RowBox[{
       SubscriptBox["\[Del]", "\[Mu]"], 
       SuperscriptBox["A", "\[Nu]"]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "6d47b40f-b4c9-48f8-8b61-4048ad49f41d"]
}], "Subitem",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770124711684523`*^9}, {
  3.9770125446957417`*^9, 3.977012552474452*^9}, {3.977012729129239*^9, 
  3.977012729966456*^9}, {3.9771753028095083`*^9, 
  3.977175312929349*^9}},ExpressionUUID->"304ef2c6-a37a-4caf-93e1-\
eb14e20e48c6"],

Cell[TextData[{
 StyleBox["If we assume the general form of derivative plus a correction,",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Mu]"], 
     SuperscriptBox["A", "\[Nu]"]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], 
      SuperscriptBox["A", "\[Nu]"]}], "+", 
     RowBox[{
      SuperscriptBox["C", "\[Nu]"], "(", 
      RowBox[{"A", ",", 
       RowBox[{"\[PartialD]", "A"}], ",", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], "A"}], "..."}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"1f0b000a-fc4d-4023-a7d8-63cd275c45c7"],
 StyleBox[", then:",
  FontSlant->"Italic"]
}], "ItemParagraph",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770125300520372`*^9}, {
  3.977012580526639*^9, 3.9770126298321247`*^9}, {3.977012673856485*^9, 
  3.977012691117526*^9}, {3.977012800847804*^9, 3.977012812824003*^9}, {
  3.97717533216661*^9, 
  3.977175352706544*^9}},ExpressionUUID->"fcc63762-011a-4f88-a9c4-\
b4ceb500b07c"],

Cell[TextData[{
 StyleBox["Linearity forces",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "A", ")"}], TraditionalForm]],ExpressionUUID->
  "ab40a2d3-ab4d-4200-8bba-81b5398f44e3"],
 " ",
 StyleBox["to be linear in",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "6f34ea28-28a9-45ce-ab2c-b98f237285f8"],
 "."
}], "Subitem",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770125300520372`*^9}, {
  3.977012580526639*^9, 3.9770126143825073`*^9}, {3.977012699450643*^9, 
  3.977012733528748*^9}, {3.977175390801517*^9, 
  3.977175401404395*^9}},ExpressionUUID->"a4631cff-c7ac-4d1e-9131-\
d9ab72e1e35d"],

Cell[TextData[{
 StyleBox["Leibniz forces ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "A", ")"}], TraditionalForm]],ExpressionUUID->
  "10f1163b-8def-4f71-b562-0c0c51425a4e"],
 StyleBox[" to have no derivatives of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "7943b409-feb0-4ffd-aab1-87b9707ed198"],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Subitem",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770125300520372`*^9}, {
  3.977012580526639*^9, 3.9770126143825073`*^9}, {3.977012699450643*^9, 
  3.977012740815217*^9}, {3.977012778543912*^9, 3.977012790515648*^9}, {
  3.977012824730361*^9, 
  3.977012846107419*^9}},ExpressionUUID->"f1d3cb88-dfd3-4c24-ad30-\
cd2d73ebcce3"],

Cell[TextData[{
 StyleBox["Therefore, the correction must be a multiplicative term: matrix \
multiplication of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "dbc797e1-db16-40a0-9d85-8f5ccbf59829"],
 StyleBox[" by some object",
  FontSlant->"Italic"],
 " \[CapitalGamma]."
}], "ItemParagraph",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770125300520372`*^9}, {
   3.977012580526639*^9, 3.9770126143825073`*^9}, {3.977012699450643*^9, 
   3.977012742347784*^9}, 3.977041927315693*^9, {3.977175417877757*^9, 
   3.97717542161299*^9}},ExpressionUUID->"789a89e8-59ba-4a8c-a945-\
85885165e07c"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Given what we want to measure, we see why ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "b7f26378-d86d-4667-9f54-d849ed740d63"],
 StyleBox[" ",
  FontSlant->"Italic"],
 StyleBox["must have three indices",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[": it measures how much ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "d4e20b18-43d7-47a8-8cb0-cbaa8fb121e8"],
 " ",
 StyleBox["changes when we change ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"\[Beta]", " "}]], TraditionalForm]],ExpressionUUID->
  "eb011ee9-e1a5-4dda-a281-c1c946d380f3"],
 " ",
 StyleBox["a little, in terms of the components of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "3a5fc6d9-9c27-4d70-973f-16df4f4c7bd2"],
 " ",
 StyleBox["contracted against ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
