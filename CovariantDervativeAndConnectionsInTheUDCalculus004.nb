    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "890a3729-c724-47d9-8dc0-19dc272ce5b3"],
 StyleBox[" at the home point ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{" ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "3dda177d-7943-4dc9-969a-06ae25b3d12b"],
 StyleBox["! Parallel transport simply must look exactly like this, no more, \
no less. (a physicist\[CloseCurlyQuote]s hand-wave; mathematicians want \
more!)",
  FontSlant->"Italic"]
}], "Item",
