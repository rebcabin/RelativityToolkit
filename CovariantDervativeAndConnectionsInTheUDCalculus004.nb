        SuperscriptBox["\[Alpha]", "\[Prime]",
         MultilineFunction->None]]}], 
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", "\[Rho]"]}]], " ", 
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Kappa]", "\[Lambda]"}], "\[Rho]"]}]}],
   HoldForm]}]], "Echo",
 CellChangeTimes->{
  3.977661668952092*^9},ExpressionUUID->"f704321e-bb4f-4379-9e25-\
220453ed4f35"],

