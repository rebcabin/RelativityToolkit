Cell["Christoffel Symbols", "Section",
 CellChangeTimes->{{3.977157494795023*^9, 3.977157505043858*^9}, 
   3.977179251390432*^9},ExpressionUUID->"f696c536-e857-4da0-a54e-\
fa3930b80e8b"],

