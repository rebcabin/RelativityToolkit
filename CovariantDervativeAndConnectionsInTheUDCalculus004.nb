      SubscriptBox[
       RowBox[{"g", 
        SubscriptBox["", "\[Mu]"], 
        SubscriptBox["", "\[Nu]"]}], 
       RowBox[{",", "\[Lambda]"}]]}], ")"}]}]}],
  HoldForm]], "Output",
