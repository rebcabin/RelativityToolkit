Cell[BoxData[
 TagBox[
  RowBox[{
   SubsuperscriptBox["\[CapitalGamma]", 
    RowBox[{"\[Mu]", "\[Nu]"}], "\[Sigma]"], "\[Equal]", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"g", 
      SuperscriptBox["", "\[Sigma]"], 
      SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       RowBox[{"g", 
        SubscriptBox["", "\[Lambda]"], 
        SubscriptBox["", "\[Mu]"]}], 
