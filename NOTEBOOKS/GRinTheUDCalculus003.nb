cef1962cd4a2"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["This kind of collision will be fixed by \
\[OpenCurlyDoubleQuote]alpha renaming\[CloseCurlyDoubleQuote] when we write a \
proper compiler for ",
  FontSlant->"Italic"],
 "\[ScriptCapitalU]\[ScriptCapitalD]",
 StyleBox[".",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9763790805089912`*^9, 3.976379131487015*^9}, {
  3.976449497569188*^9, 3.976449521627575*^9}, {3.976707412694602*^9, 
