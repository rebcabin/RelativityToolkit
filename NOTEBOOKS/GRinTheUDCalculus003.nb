Cell[CellGroupData[{

Cell[TextData[{
 "The Metric Perturbation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"4fec011d-7211-44e3-aeb0-241dab4b0310"]
}], "Subsection",
 CellChangeTimes->{{3.9763183048928137`*^9, 
  3.97631833987549*^9}},ExpressionUUID->"7ac816f5-9d42-46f0-9066-\
62f7bc43a430"],

Cell[TextData[{
 "In the weak-field approximation (linearized gravity), the metric ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"bc34d4ae-9ddf-4cbf-8994-3df303c00be8"],
 " is the Minkowski metric ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Eta]", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"e65606a7-9ed2-49f2-9402-8fe9f843df4f"],
 " plus a small perturbation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ffbaf0b7-e0d5-45e2-873e-a410d35ecc83"],
 ":"
}], "Text",
 CellChangeTimes->{{3.976318126536161*^9, 3.976318145674673*^9}, {
  3.976318324968709*^9, 3.976318392098468*^9}, {3.976374012944892*^9, 
  3.976374017198011*^9}, {3.976449430180409*^9, 3.976449435725156*^9}, {
  3.976522938201899*^9, 
  3.976522939100395*^9}},ExpressionUUID->"5ebfe45f-4b59-46e3-8180-\
df67ce5b943f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["g", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "\[TildeTilde]", 
   RowBox[{
    SubscriptBox["\[Eta]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "+", 
    SubscriptBox["h", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.976318398387661*^9, 
  3.976318448227997*^9}},ExpressionUUID->"9a67e4df-d91c-4367-b034-\
f288a4426193"],

Cell[TextData[{
 "For a point mass ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "76d31bbc-1ba4-410b-b455-cd60c761b8e8"],
 " moving with 4\[NoBreak]-\[NoBreak]velocity ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "34696713-1b34-4ac8-a5bf-55b78f9208a8"],
 ", the metric perturbation is the direct gravitational analog of the \
electrodynamical Li\[EAcute]nard-Wiechert potential. "
}], "Text",
 CellChangeTimes->{{3.976318487039044*^9, 3.976318549743784*^9}, {
  3.976375100248762*^9, 3.976375108115966*^9}, {3.9767071697914762`*^9, 
  3.976707222690292*^9}, {3.97670729995557*^9, 
  3.9767073394480743`*^9}},ExpressionUUID->"50bc8a9f-ddef-4f0a-8708-\
69480aa0767c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["h", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"4", "G", " ", "M"}], "r"], 
    SubscriptBox["\[Lambda]", "\[Mu]"], 
    SubscriptBox["\[Lambda]", "\[Nu]"]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.976318555619935*^9, 3.976318609564765*^9}, {
  3.9763186575948677`*^9, 
  3.976318657974804*^9}},ExpressionUUID->"f5105efa-f07c-4416-a319-\
e4000cf96bf9"],

Cell[TextData[{
 StyleBox["Note this is ", "Item",
  FontSlant->"Italic"],
 StyleBox["not", "Item"],
 StyleBox[" Carlip\[CloseCurlyQuote]s Equation 2.1, which is the Kinnersley \
metric for the photon rocket-problem. That problem has similar outcome to the \
outcome of this paper, as we may show in a future notebook.", "Item",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{
  3.976707354052362*^9},ExpressionUUID->"21fe32b2-5e2a-4f27-9639-\
8523e48d7c80"],

Cell[TextData[{
 "In \[ScriptCapitalU]\[ScriptCapitalD], we capture the constant factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"4", "G", " ", "M"}], "\[Congruent]", "k"}], TraditionalForm]],
  ExpressionUUID->"fde8bb9a-e389-478b-953c-7b22bfb5fa3a"],
 " as a symbolic constant ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "6b190eb8-e2b1-4655-9c58-6f623d574a51"],
 " without a value, and write"
}], "Text",
 CellChangeTimes->{{3.9763186265498*^9, 3.976318678376561*^9}, {
  3.97631878142759*^9, 3.976318784307719*^9}, {3.976375113970159*^9, 
