Cell[CellGroupData[{

Cell["Intuitions", "Subsubsection",
 CellChangeTimes->{{3.976406861163542*^9, 
  3.976406863620969*^9}},ExpressionUUID->"b901faee-dbbf-4be5-a246-\
92ce623a6063"],

Cell[TextData[{
 "The second term, with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", "3"], TraditionalForm]],ExpressionUUID->
  "0d480a50-2121-46cb-a180-c4fc687a0305"],
 " in the denominator, is Coulomb-like, scaling as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox["r", "2"]}], TraditionalForm]],ExpressionUUID->
  "b4b9a491-ff0d-46f6-9c8b-98fe4f73fbc7"],
 " because the \[Sigma] in the numerator represents the physical distance \
between source and test and scales like ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "fb80e4f6-9f32-4b81-bc88-c7ad01d51cff"],
 ". The first term, with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", "2"], TraditionalForm]],ExpressionUUID->
  "c5801036-e1fe-4d45-abee-76489b82dcb7"],
 " in the denominator, is radiative, scaling as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "r"}], TraditionalForm]],ExpressionUUID->
  "b01154ac-0d31-4997-a155-d9095515dbcd"],
 " due also to a ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]],ExpressionUUID->
  "766f1bf1-85e4-4f7a-9699-9ea8bedb454f"],
 " in the denominator, but also scaling with the acceleration ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "\[VeryThinSpace]", 
    RowBox[{"\[Lambda]", "/", "d"}], "\[VeryThinSpace]", "s"}], 
   TraditionalForm]],ExpressionUUID->"075fcb43-a8d7-42fa-ad10-bfb1c358bb46"],
 ". A field proportional to both acceleration and to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "r"}], TraditionalForm]],ExpressionUUID->
  "dbb2a07b-67ef-41e8-ae29-3c92a3b6d19c"],
 " is the definition of a radiative field."
}], "Text",
 CellChangeTimes->{{3.976376610860808*^9, 3.976376848200593*^9}, {
  3.976405452916387*^9, 3.976405544815357*^9}, {3.9764495722867327`*^9, 
  3.976449573857396*^9}, {3.976523295630456*^9, 3.976523313128447*^9}, {
  3.976523366191909*^9, 3.9765233982566643`*^9}, {3.976707435479705*^9, 
  3.976707435847064*^9}},ExpressionUUID->"d30d8ec4-05db-47b5-9e2a-\
51557038b2d6"],

Cell[TextData[{
 "The factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    RowBox[{
     FractionBox[
      RowBox[{"d", "\[VeryThinSpace]", 
       SuperscriptBox["\[Lambda]", "\[Rho]"]}], 
      RowBox[{"d", "\[VeryThinSpace]", "s"}]], 
     SubscriptBox["\[Sigma]", "\[Rho]"]}]}], TraditionalForm]],ExpressionUUID->
  "4e18e777-66f3-435d-a7b0-ae81fda62db8"],
 " in the Coulomb-like portion of the field accounts for changes in the \
gradient of ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "f06f025a-f76d-47ce-b0ae-6d9b7e602a09"],
 " due to acceleration ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["\[Lambda]", "\[Rho]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", "s"}]], TraditionalForm]],ExpressionUUID->
  "0781d0a8-e100-4e70-af90-84d30b76c0d0"],
 ". It encapsulates the quadratic part of the extrapolation of the retarded \
position, schematically like the Newtonian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "ret"], "+", 
    RowBox[{"v\[CapitalDelta]", "\[VeryThinSpace]", "t"}], "+", 
    RowBox[{
     FractionBox["1", "2"], "a", "\[VeryThinSpace]", "\[CapitalDelta]", "\[VeryThinSpace]", 
     SuperscriptBox["t", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "89f77213-8905-478f-9825-e620a284e078"],
 ". The velocity of the source causes level surfaces of the Coulomb field to \
\[OpenCurlyDoubleQuote]squish\[CloseCurlyDoubleQuote] in front of the source, \
a ",
 StyleBox["Doppler-like effect",
  FontWeight->"Bold"],
 ", and acceleration causes the spacing of the surfaces to compress."
}], "Text",
 CellChangeTimes->{{3.9764060105528307`*^9, 3.9764061002548227`*^9}, {
  3.976406147439021*^9, 3.97640631221244*^9}, {3.9764064068736773`*^9, 
  3.976406421337152*^9}, {3.976406452548161*^9, 3.976406553101644*^9}, {
  3.976707459479413*^9, 
  3.976707479198902*^9}},ExpressionUUID->"7e67c8e6-4015-4e6a-b8b7-\
0a74e7fb2638"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The Christoffel Connection ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", "\[Tau]"], 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d799c75e-6bae-483e-b523-59ce15e28bef"]
}], "Subsection",
 CellChangeTimes->{
  3.976308362575985*^9, {3.976308564836528*^9, 3.976308582840405*^9}, {
   3.976376871939151*^9, 
   3.976376913504778*^9}},ExpressionUUID->"218d7e6b-1653-41e9-99ac-\
ae631c44408d"],

Cell[TextData[{
 "The \[OpenCurlyDoubleQuote]force\[CloseCurlyDoubleQuote] in gravitation \
arises from the non-tensorial connection, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", "\[Tau]"], 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"a7fe66b9-d4fb-40f1-9888-2ee48e58294e"],
 ". "
}], "Text",
 CellChangeTimes->{{3.976376926034861*^9, 3.976377032216123*^9}, {
  3.976377417726636*^9, 3.976377460162353*^9}, {3.976377610453426*^9, 
  3.9763776107768497`*^9}},ExpressionUUID->"160d239a-a013-4b34-a199-\
770ff74adf91"],

Cell[TextData[StyleBox["Aside: Gravitation shares this idea with quantum \
fields, where force bosons come from the connections of gauge fields that \
leave Lagrangians invariant. This similarity is so alluring that physicists \
strongly suspect an underlying unified theory. However, unification has \
resisted all attempts. Various attempts make predictions refuted by \
experiment. Other attempts fail renormalization, and so on. It is an open \
question whether the unification even exists or whether Nature gives us two \
different but similar-looking kinds of force laws (space-time and gauge), \
laughing at our petty struggles to understand.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.976376926034861*^9, 3.976377032216123*^9}, {
  3.976377417726636*^9, 3.9763775079237137`*^9}, {3.976449634898127*^9, 
  3.97644975396916*^9}, {3.9764513272667503`*^9, 3.976451431312574*^9}, {
  3.9765234885882177`*^9, 3.9765235200451593`*^9}, {3.976707506720737*^9, 
  3.976707560717752*^9}},ExpressionUUID->"fd25b5aa-a933-49d7-a79a-\
ffd20df275f2"],

Cell[TextData[{
 "In the weak field limit (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "\[TildeTilde]", 
    RowBox[{
     SubscriptBox["\[Eta]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "+", 
     SubscriptBox["h", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]]}]}], TraditionalForm]],
  CellChangeTimes->{{3.976318398387661*^9, 3.976318448227997*^9}},
  ExpressionUUID->"d078f48d-a271-4f09-aa40-0e5b858077b1"],
 "), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", "\[Tau]"], 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"6e091aa8-3d9e-479b-86f1-f0a69980a516"],
 " is a linear combinations of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PartialD]", "h"}], TraditionalForm]],ExpressionUUID->
  "1bfa1ebd-04c9-4583-93ad-b371db0a4cbe"],
 " gradients: "
}], "Text",
 CellChangeTimes->{
  3.976308362575985*^9, 3.976308566682349*^9, {3.976376171692402*^9, 
   3.97637617959409*^9}, {3.9763776022874413`*^9, 3.9763776268414*^9}, {
   3.976377687412127*^9, 3.976377713150785*^9}, {3.9765235319911118`*^9, 
   3.976523550339569*^9}, {3.976707594781414*^9, 
   3.976707603743514*^9}},ExpressionUUID->"1ec5b37c-18b9-4fe9-977a-\
34ae207ffa1a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", "\[Tau]"], 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "\[TildeTilde]", 
   RowBox[{
    FractionBox["1", "2"], 
    SuperscriptBox["\[Eta]", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Tau]", "\[VeryThinSpace]", "\[Chi]"}]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Mu]"], 
       SubscriptBox["h", 
        RowBox[{"\[Nu]", "\[VeryThinSpace]", "\[Chi]"}]]}], "+", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Nu]"], 
       SubscriptBox["h", 
        RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Chi]"}]]}], "-", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Chi]"], 
       SubscriptBox["h", 
        RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9763776364039907`*^9, 3.976377662737043*^9}, {
  3.976377718594913*^9, 
  3.976377843139291*^9}},ExpressionUUID->"2d096983-07c8-46dc-91f0-\
4c646c656b8d"],

Cell[TextData[{
 "To implement this efficiently in \[ScriptCapitalU]\[ScriptCapitalD], we \
define a helper function to \[OpenCurlyDoubleQuote]instantiate\
\[CloseCurlyDoubleQuote] ",
 StyleBox["metricGradient", "Input"],
 " with specific indices."
}], "Text",
 CellChangeTimes->{
  3.976308362575985*^9, 3.976308566682349*^9, {3.976376171692402*^9, 
   3.97637617959409*^9}, {3.9763776022874413`*^9, 3.97637761563146*^9}, {
   3.976377850016176*^9, 
   3.9763778638682127`*^9}},ExpressionUUID->"bff7fc49-f266-470b-bebf-\
2fb7bbe13f7e"],

Cell[BoxData[
 RowBox[{
