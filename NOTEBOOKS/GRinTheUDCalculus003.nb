     FractionBox["k", "r"], 
     RowBox[{"\[Lambda]", "[", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], "]"}], 
     RowBox[{"\[Lambda]", "[", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "]"}]}]}], ";"}], 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Display", " ", "rule", " ", "for", " ", "h"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AppendTo", "[", 
    RowBox[{"dpyRules", ",", 
     RowBox[{
      RowBox[{"h", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}]}], "]"}], ":>", 
      RowBox[{"Subscript", "[", 
       RowBox[{"h", ",", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], "]"}]}], "]"}]}]}], "]"}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Verify", " ", "the", " ", "display"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", "[", 
   RowBox[{
    RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
    RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], "/.", " ", 
  "dpyRules"}]}], "Input",
 CellChangeTimes->{{3.9763078456258097`*^9, 3.976307860613257*^9}, {
  3.976307906724279*^9, 3.976307934183831*^9}, {3.976307996008998*^9, 
