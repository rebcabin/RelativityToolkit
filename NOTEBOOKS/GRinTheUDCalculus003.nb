Cell[TextData[{
 "Invoke the previously defined ",
 StyleBox["rExpr", "Input"],
 " and the ",
 StyleBox["fourGrad", "Input"],
 " rule for ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "993727ec-0503-4206-9b9e-99687957a096"],
 " via manually renamed summation index \[Gamma] that does not collide with \
the free index \[Rho]."
}], "Text",
 CellChangeTimes->{
  3.976307970148697*^9, {3.976308406735373*^9, 3.976308419314743*^9}, {
   3.976375288736164*^9, 3.976375296622808*^9}, {3.976375999235568*^9, 
