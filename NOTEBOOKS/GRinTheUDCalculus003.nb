           RowBox[{"d", " ", "s"}]],
          DisplayForm], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             SubscriptBox["\[Lambda]", "\[Mu]"]}], " ", 
            SubscriptBox["\[Lambda]", "\[Rho]"]}], "+", 
           RowBox[{"2", " ", 
            TagBox[
             FractionBox[
              RowBox[{"d", " ", 
               SubscriptBox["\[Lambda]", "\[Rho]"]}], 
              RowBox[{"d", " ", "s"}]],
             DisplayForm], " ", 
            SubscriptBox["\[Sigma]", "\[Mu]"]}]}], ")"}]}], "+", 
        RowBox[{
         TagBox[
          FractionBox[
           RowBox[{"d", " ", 
            SubscriptBox["\[Lambda]", "\[Mu]"]}], 
           RowBox[{"d", " ", "s"}]],
          DisplayForm], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[Lambda]", "\[Nu]"], " ", 
            SubscriptBox["\[Lambda]", "\[Rho]"]}], "-", 
           RowBox[{"2", " ", 
            TagBox[
             FractionBox[
              RowBox[{"d", " ", 
               SubscriptBox["\[Lambda]", "\[Rho]"]}], 
              RowBox[{"d", " ", "s"}]],
             DisplayForm], " ", 
            SubscriptBox["\[Sigma]", "\[Nu]"]}]}], ")"}]}]}], ")"}], " ", 
      SubscriptBox["\[Sigma]", "\[Sigma]"]}]}], ")"}]}], "+", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"2", " ", 
     SuperscriptBox["r", "4"]}]], "k", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Sigma]", "\[Rho]"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", 
         TagBox[
          FractionBox[
           RowBox[{"d", " ", 
            SubscriptBox["\[Lambda]", "\[Sigma]"]}], 
           RowBox[{"d", " ", "s"}]],
          DisplayForm], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[Lambda]", "\[Nu]"], " ", 
            SubscriptBox["\[Sigma]", "\[Mu]"]}], "-", 
           RowBox[{
            SubscriptBox["\[Lambda]", "\[Mu]"], " ", 
            SubscriptBox["\[Sigma]", "\[Nu]"]}]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{
            TagBox[
             FractionBox[
              RowBox[{"d", " ", 
               TemplateBox[{"\[Lambda]", "\[Rho]"},
                "Superscript"]}], 
              RowBox[{"d", " ", "s"}]],
             DisplayForm], " ", 
            SubscriptBox["\[Sigma]", "\[Rho]"]}]}], ")"}]}], "+", 
        RowBox[{
         SubscriptBox["\[Lambda]", "\[Sigma]"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"3", " ", 
            TagBox[
             FractionBox[
              RowBox[{"d", " ", 
               SubscriptBox["\[Lambda]", "\[Mu]"]}], 
              RowBox[{"d", " ", "s"}]],
             DisplayForm], " ", 
            SubscriptBox["\[Sigma]", "\[Nu]"]}], "+", 
           RowBox[{"3", " ", 
            TagBox[
             FractionBox[
              RowBox[{"d", " ", 
               SubscriptBox["\[Lambda]", "\[Nu]"]}], 
              RowBox[{"d", " ", "s"}]],
             DisplayForm], " ", 
            SubscriptBox["\[Sigma]", "\[Mu]"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              RowBox[{
               TagBox[
                FractionBox[
                 RowBox[{"d", " ", 
                  TemplateBox[{"\[Lambda]", "\[Rho]"},
                   "Superscript"]}], 
                 RowBox[{"d", " ", "s"}]],
                DisplayForm], " ", 
               SubscriptBox["\[Sigma]", "\[Rho]"]}]}], ")"}]}], "+", 
           RowBox[{
            TagBox[
             FractionBox[
              RowBox[{"d", " ", 
               TemplateBox[{"\[Lambda]", "\[Rho]"},
                "Superscript"]}], 
              RowBox[{"d", " ", "s"}]],
             DisplayForm], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", 
                SubscriptBox["\[Lambda]", "\[Nu]"]}], " ", 
               SubscriptBox["\[Lambda]", "\[Rho]"], " ", 
               SubscriptBox["\[Sigma]", "\[Mu]"]}], "+", 
              RowBox[{
               SubscriptBox["\[Sigma]", "\[Nu]"], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  SubscriptBox["\[Lambda]", "\[Mu]"], " ", 
                  SubscriptBox["\[Lambda]", "\[Rho]"]}], "-", 
                 RowBox[{"3", " ", 
                  TagBox[
                   FractionBox[
                    RowBox[{"d", " ", 
                    SubscriptBox["\[Lambda]", "\[Mu]"]}], 
                    RowBox[{"d", " ", "s"}]],
                   DisplayForm], " ", 
                  SubscriptBox["\[Sigma]", "\[Rho]"]}]}], ")"}]}]}], 
             ")"}]}]}], ")"}]}]}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "3"}], " ", 
         TagBox[
          FractionBox[
           RowBox[{"d", " ", 
            SubscriptBox["\[Lambda]", "\[Rho]"]}], 
           RowBox[{"d", " ", "s"}]],
          DisplayForm], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[Lambda]", "\[Nu]"], " ", 
            SubscriptBox["\[Sigma]", "\[Mu]"]}], "-", 
           RowBox[{
            SubscriptBox["\[Lambda]", "\[Mu]"], " ", 
            SubscriptBox["\[Sigma]", "\[Nu]"]}]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{
            TagBox[
             FractionBox[
              RowBox[{"d", " ", 
               TemplateBox[{"\[Lambda]", "\[Rho]"},
                "Superscript"]}], 
              RowBox[{"d", " ", "s"}]],
             DisplayForm], " ", 
            SubscriptBox["\[Sigma]", "\[Rho]"]}]}], ")"}]}], "+", 
        RowBox[{
         SubscriptBox["\[Lambda]", "\[Rho]"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "3"}], " ", 
            TagBox[
             FractionBox[
              RowBox[{"d", " ", 
               SubscriptBox["\[Lambda]", "\[Mu]"]}], 
              RowBox[{"d", " ", "s"}]],
             DisplayForm], " ", 
            SubscriptBox["\[Sigma]", "\[Nu]"]}], "-", 
           RowBox[{"3", " ", 
            TagBox[
             FractionBox[
              RowBox[{"d", " ", 
               SubscriptBox["\[Lambda]", "\[Nu]"]}], 
              RowBox[{"d", " ", "s"}]],
             DisplayForm], " ", 
            SubscriptBox["\[Sigma]", "\[Mu]"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              RowBox[{
               TagBox[
                FractionBox[
                 RowBox[{"d", " ", 
                  TemplateBox[{"\[Lambda]", "\[Rho]"},
                   "Superscript"]}], 
                 RowBox[{"d", " ", "s"}]],
                DisplayForm], " ", 
               SubscriptBox["\[Sigma]", "\[Rho]"]}]}], ")"}]}], "+", 
           RowBox[{
            TagBox[
             FractionBox[
              RowBox[{"d", " ", 
               TemplateBox[{"\[Lambda]", "\[Rho]"},
                "Superscript"]}], 
              RowBox[{"d", " ", "s"}]],
             DisplayForm], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               SubscriptBox["\[Lambda]", "\[Rho]"], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  SubscriptBox["\[Lambda]", "\[Nu]"], " ", 
                  SubscriptBox["\[Sigma]", "\[Mu]"]}], "-", 
                 RowBox[{
                  SubscriptBox["\[Lambda]", "\[Mu]"], " ", 
                  SubscriptBox["\[Sigma]", "\[Nu]"]}]}], ")"}]}], "+", 
              RowBox[{"3", " ", 
               TagBox[
                FractionBox[
                 RowBox[{"d", " ", 
                  SubscriptBox["\[Lambda]", "\[Mu]"]}], 
                 RowBox[{"d", " ", "s"}]],
                DisplayForm], " ", 
               SubscriptBox["\[Sigma]", "\[Nu]"], " ", 
               SubscriptBox["\[Sigma]", "\[Rho]"]}]}], ")"}]}]}], ")"}]}]}], 
       ")"}], " ", 
      SubscriptBox["\[Sigma]", "\[Sigma]"]}]}], ")"}]}]}]], "Output",
 CellChangeTimes->{{3.976316564445922*^9, 3.9763165893221807`*^9}, 
   3.9763169556921463`*^9, 3.976317011883271*^9, {3.976317043811298*^9, 
   3.9763170867871437`*^9}, 3.976317528231925*^9, 3.976319057025342*^9, 
   3.976375038280594*^9, 3.976375524821734*^9, 3.9763755723720407`*^9, 
   3.976375658709579*^9, 3.9763757635797997`*^9, 3.9763758086650057`*^9, 
   3.976375875324585*^9, 3.976376269007524*^9, 3.9763801725376472`*^9, 
   3.976388577963913*^9, 3.976407669794115*^9, 3.9764081305792*^9, 
   3.9764516285287943`*^9, {3.976452377904518*^9, 3.9764523961429234`*^9}, 
   3.976454818312872*^9, 3.9765239497428102`*^9, 3.976524047398283*^9, 
   3.976524827401492*^9, 3.976544546859417*^9},
 CellLabel->"Out[45]=",ExpressionUUID->"eedf521d-3a0a-4adf-8087-ba5f39352709"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Intuitions", "Subsubsection",
 CellChangeTimes->{{3.976408451291256*^9, 
  3.9764084650746517`*^9}},ExpressionUUID->"13b97edf-6ca0-4fb4-a915-\
1794ab4517cb"],

Cell[TextData[{
 "The raw output for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    RowBox[{"\[Rho]\[Sigma]\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], 
   TraditionalForm]],
  CellChangeTimes->{{3.976407400619911*^9, 3.976407550999305*^9}, {
   3.976407834602461*^9, 3.9764078356774597`*^9}},ExpressionUUID->
  "c19399e7-146f-4623-8837-0d3b92ccf69a"],
 " above is a formidable \[OpenCurlyDoubleQuote]wall of math\
\[CloseCurlyDoubleQuote] comprising dozens of terms scaling from ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", 
    RowBox[{"-", "2"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "837bcc71-eaa6-40b5-87c0-d1a5b29e5fc2"],
 " down to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", 
    RowBox[{"-", "5"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c2744adb-cd8d-4a4d-aabb-8e865b9ce995"],
 ". You might find this alarming. However, ",
 StyleBox["this verbosity is not a bug, it\[CloseCurlyQuote]s a feature",
  FontWeight->"Bold"],
 " and primary virtue of \[ScriptCapitalU]\[ScriptCapitalD]."
}], "Text",
 CellChangeTimes->{
  3.976408531825014*^9, {3.976408585233749*^9, 3.976408703344245*^9}, {
   3.976408863197585*^9, 3.976408864345812*^9}, 3.976451652420381*^9, {
   3.976451735561101*^9, 3.976451743522533*^9}, {3.976523974770527*^9, 
   3.976523975101437*^9}},ExpressionUUID->"d29630a6-0501-4235-aa18-\
5d5d4b138d8c"],

Cell["\<\
In a manual calculation, a physicist would usually discard higher-order terms \
and exploit symmetries in intermediate steps to keep the expressions \
manageable. While elegant, that process is perilous; a single dropped index \
or misplaced sign propagates errors that are extremely expensive to trace or \
redo. By contrast, Wolfram\[CloseCurlyQuote]s symbolic engine is \
syntactically rigid. It does not simplify until told to do so, and it does \
not make algebraic mistakes. The \[OpenCurlyDoubleQuote]wall of math\
\[CloseCurlyDoubleQuote] is assurance that every interaction\[LongDash]every \
chain rule and every suitable contraction\[LongDash]is applied.\
\>", "Text",
 CellChangeTimes->{
  3.976408531825014*^9, {3.976408585233749*^9, 3.976408803424974*^9}, {
   3.976451759265255*^9, 3.97645179115335*^9}, {3.976524019925776*^9, 
   3.976524020556508*^9}, {3.9765240775402813`*^9, 3.976524087984445*^9}, {
   3.976524314351377*^9, 3.976524351233073*^9}, {3.97670776688195*^9, 
   3.976707768930134*^9}},ExpressionUUID->"241b8ebe-42a8-4fe0-acfa-\
e0313a606e4c"],

Cell[TextData[StyleBox["I have first-hand experience with this, leading me to \
cherish an ancestor of Mathematica. My first job out of school in the early \
80\[CloseCurlyQuote]s was to check the math for relativistic clock \
corrections in GPS signals, long before such was routine and automated. I \
recall doing page after page of algebra, only to fail a sign or index check \
at the end, then failing to find the bug on backtracking, and ending up \
starting over from scratch, multiple times. This very project caused me to \
seek out Stephen Wolfram, then at Caltech Physics, and get a copy of SMP from \
him to check those calculations. Without SMP, I would have had little \
confidence in my final results and would have felt irresponsible. Of course, \
SMP eventually became Mathematica, which became Wolfram, and here we are some \
45 years later. I have used it every day for all kinds of tasks, including \
designing C code, since long before it was a commercial product.", "Item"]], \
"Item",
 CellChangeTimes->{{3.976449086797675*^9, 3.9764491578865643`*^9}, {
   3.9764518180355577`*^9, 3.976451891686057*^9}, {3.9764519262366447`*^9, 
   3.976451960578751*^9}, {3.976524101840035*^9, 3.976524106674533*^9}, {
   3.9765241626274433`*^9, 3.9765241709792423`*^9}, 3.97670778960859*^9, {
   3.976707828115987*^9, 3.976707838666717*^9}},
 FontSlant->"Italic",ExpressionUUID->"78e1a898-2896-42f1-91c0-a94b1364c3ff"],

Cell[TextData[{
 "We can trust this result ",
 StyleBox["not",
  FontSlant->"Italic"],
 " because the output is pretty or ugly or anything else, but because the \
process is robust. The same ",
 StyleBox["fourGrad", "Input"],
 " and ",
 StyleBox["tensorRules", "Input"],
 " that successfully reproduced the Li\[EAcute]nard-Wiechert fields in \
electrodynamics apply here without modification."
}], "Text",
 CellChangeTimes->{
  3.976408531825014*^9, {3.976408585233749*^9, 3.976408853614354*^9}, {
   3.97645202096327*^9, 3.9764520358409367`*^9}, {3.976524182857685*^9, 
   3.976524197284234*^9}, 3.976544512378778*^9, {3.9767078481201887`*^9, 
   3.976707848586907*^9}},ExpressionUUID->"561cbaee-0959-416a-a3bf-\
6ff384f96b94"],

Cell[TextData[{
 "Therefore, we do not need to read the raw tensor. Just as we write software \
to visualize large datasets, we write a symbolic \
\[OpenCurlyDoubleQuote]Component Inspector\[CloseCurlyDoubleQuote] in the \
next section to probe this result. By projecting ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    RowBox[{"\[Rho]\[Sigma]\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], 
   TraditionalForm]],
  CellChangeTimes->{{3.976407400619911*^9, 3.976407550999305*^9}, {
   3.976407834602461*^9, 3.9764078356774597`*^9}},ExpressionUUID->
  "bf3f9dba-88de-4ede-9a9e-80d174222dfe"],
 " onto specific physical vectors, we will demonstrate that it collapses \
neatly into recognizable predictions of General Relativity."
}], "Text",
 CellChangeTimes->{
  3.976408531825014*^9, {3.976408585233749*^9, 3.976408855622974*^9}, {
   3.9764520637989187`*^9, 3.976452089543735*^9}, {3.9765242076970043`*^9, 
   3.976524234407428*^9}, {3.976707863726618*^9, 
   3.976707864188115*^9}},ExpressionUUID->"d8fbe254-ecf1-49f2-901b-\
b955c02081e3"],

Cell["\<\
That said, the big-picture structure is exactly what a relativist hopes to \
see:\
\>", "Text",
 CellChangeTimes->{
  3.976408556676867*^9, {3.976408896838912*^9, 
   3.976408927307686*^9}},ExpressionUUID->"178acd84-e434-4498-a7ee-\
156d0a1f6c5c"],

Cell[TextData[{
 "The Peeling Property",
 ": The terms sort themselves into powers of r. You clearly see the radiative \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "r"}], TraditionalForm]],ExpressionUUID->
  "dffc0edd-dade-49a7-a722-6e85a39f3328"],
 " terms (top line), the Coulomb/static ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", 
    RowBox[{"-", "2"}]], TraditionalForm]],ExpressionUUID->
  "9cf899a9-37fd-425f-943a-9ac6efb37f99"],
 " terms, the near-field ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", 
    RowBox[{"-", "3"}]], TraditionalForm]],ExpressionUUID->
  "0c61da2b-c705-4773-8ab5-d494503602ca"],
 " etc. terms. "
}], "Item",
 CellChangeTimes->{
  3.976408556676867*^9, {3.976408896838912*^9, 3.976408931328106*^9}, {
   3.976452103697983*^9, 3.9764521524938517`*^9}, {3.9765242640320053`*^9, 
   3.976524264495637*^9}, 
   3.976544523197838*^9},ExpressionUUID->"663fd0ed-8f5f-462b-a7f1-\
b46310a1a7f6"],

Cell[TextData[{
 "Evaluation Completeness: There are no \[OpenCurlyDoubleQuote]blue,\
\[CloseCurlyDoubleQuote] unevaluated symbols or calls of ",
 StyleBox["fourGrad", "Input"],
 ". Every single term has been reduced to the fundamental physical variables: \
",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a6c03dcf-f2c4-4c4f-9946-0f9c3029c83b"],
 ", ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e1828708-2d91-40d8-88d2-26bbe039ec48"],
 ", ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "67b3f7da-f542-48d6-be71-d32d3c0dfa31"],
 ", ",
 Cell[BoxData[
  FormBox["\[Eta]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9d9de084-172a-432a-8d91-b7b52a48228a"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Lambda]", "/", "ds"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b99fcfe9-abe4-4416-a949-2f5d406e3df9"],
 "."
}], "Item",
 CellChangeTimes->{
  3.976408556676867*^9, {3.976408896838912*^9, 3.976408939578844*^9}, {
   3.976452170677514*^9, 3.9764521958030167`*^9}, {3.976524281147764*^9, 
   3.976524297030198*^9}},ExpressionUUID->"4d75cc35-0222-4d3b-ae12-\
10f1e44ed5b9"],

Cell[TextData[{
 "The Doppler Signature: The ubiquitous presence of the Doppler-like factor \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    RowBox[{
     FractionBox[
      RowBox[{"d", "\[VeryThinSpace]", 
       SuperscriptBox["\[Lambda]", "\[Rho]"]}], 
      RowBox[{"d", "\[VeryThinSpace]", "s"}]], 
     SubscriptBox["\[Sigma]", "\[Rho]"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40e72e8c-a6aa-46f7-8c3d-13ebdea6b35f"],
 " confirms that the retardation effects have been propagated through the \
second derivative."
}], "Item",
 CellChangeTimes->{
  3.976408556676867*^9, {3.976408896838912*^9, 3.9764089359470453`*^9}, {
   3.976452266295361*^9, 3.9764522735399647`*^9}, {3.9765243625471687`*^9, 
   3.976524362726616*^9}},ExpressionUUID->"53cd219b-8541-4508-ba42-\
dd765f4db9c9"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Verification: The Component Inspector", "Section",
 CellChangeTimes->{{3.976309974560424*^9, 
  3.976309983366247*^9}},ExpressionUUID->"8a838f09-1274-4117-826d-\
abbbbe2b06aa"],

Cell["\<\
Finally, we apply the following \[OpenCurlyDoubleQuote]Component Inspector\
\[CloseCurlyDoubleQuote] logic. We check the Newtonian limit (tidal tensor) \
and the radiation term.\
\>", "Text",
 CellChangeTimes->{{3.976309974560424*^9, 3.976309979404787*^9}, {
  3.976452287844987*^9, 3.976452301182411*^9}, {3.97652437316206*^9, 
  3.976524383797452*^9}},ExpressionUUID->"109c9b05-a52b-4c6b-b812-\
78d911c7637e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"NEWTONIAN", " ", "TIDAL", " ", "LIMIT", " ", 
    RowBox[{"(", 
     RowBox[{"a", " ", "->", " ", "0"}], ")"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"tidal", " ", "tensor", " ", 
     SubscriptBox["E", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]]}], "=", 
    RowBox[{
     SubscriptBox["R", "\[Mu]\[Alpha]\[Nu]\[Beta]"], 
     SuperscriptBox["\[Lambda]", "\[Alpha]\[Beta]"]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n--- TEST 1: Newtonian Tidal Limit (a \[Rule] 0) ---\
\>\"", "]"}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Project", " ", "onto", " ", "velocity", " ", "\[Lambda]"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tidalRaw", "=", 
     RowBox[{"RiemannTensor", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Rho]", "]"}], "->", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}]}], ",", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Sigma]", "]"}], "->", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]", "]"}]}], ",", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], "->", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], ",", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "->", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Beta]", "]"}]}]}], "}"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Contract", " ", "with", " ", 
     SuperscriptBox["\[Lambda]", "\[Alpha]\[Beta]"]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"tidalContraction", "=", 
     RowBox[{
      RowBox[{"tidalRaw", " ", "*", 
       RowBox[{"\[Lambda]", "[", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Alpha]", "]"}], "]"}], 
       RowBox[{"\[Lambda]", "[", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Beta]", "]"}], "]"}]}], "//.", 
      "tensorRules"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Limit", ":", "Acceleration"}], " ", "->", " ", "0"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"newtonianLimit", "=", 
     RowBox[{"tidalContraction", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"d\[Lambda]ds", "[", "_", "]"}], "->", "0"}], "}"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"newtonianLimit", "=", 
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{"newtonianLimit", "//", "FullSimplify"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "k"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Tidal Tensor \!\(\*SubscriptBox[\(E\), \(\[Mu]\
\[VeryThinSpace]\[Nu]\)]\) (Static Limit):\>\"", "]"}], ";"}], "\n", 
   RowBox[{"newtonianLimit", "/.", " ", "dpyRules"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"RADIATION", " ", "CHECK", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", "/", "r"}], " ", "Term"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n--- TEST 2: Gravitational radiation rerm \
(1/\!\(\*SuperscriptBox[\(r\), \(2\)]\)) ---\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "coefficient", " ", "of", " ", 
     RowBox[{"1", "/", 
      SuperscriptBox["r", "2"]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radTerm", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{"RiemannTensor", ",", "r", ",", 
       RowBox[{"-", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"radTerm", "===", "0"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<FAILED: No radiation term found.\>\"", "]"}],
       ",", "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", "\"\<PASSED: Radiation term detected. Leading terms \
shown:\>\"", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "snippet"}], "*)"}], "\n", 
   RowBox[{"Short", "[", 
    RowBox[{
     RowBox[{"radTerm", "/.", " ", "dpyRules"}], ",", "5"}], 
    "]"}]}]}]], "Input",
