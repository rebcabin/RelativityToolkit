Cell[CellGroupData[{

Cell["Intuitions", "Subsubsection",
 CellChangeTimes->{{3.976406875567185*^9, 
  3.976406877380052*^9}},ExpressionUUID->"bd790391-13a8-4ed8-a718-\
3bfb8cc0b117"],

Cell[TextData[{
 "\[CapitalGamma] encapsulates effects we can intuit as forces. The Geodesic \
Equation for a test particle with 4\[NoBreak]-\[NoBreak]velocity ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["v", 
    RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "13e84cbd-6a7a-49d0-aef9-cc368395b777"],
 " gives the equation of motion:"
}], "Text",
 CellChangeTimes->{{3.976406802620414*^9, 3.976406825856605*^9}, {
  3.976406890263914*^9, 3.9764069416299877`*^9}, {3.976523699218315*^9, 
  3.976523723163568*^9}},ExpressionUUID->"9c348e9c-7c2f-4e17-84a7-\
1872eed7fb30"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["v", "\[Chi]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}]], "=", 
   RowBox[{
    RowBox[{"-", 
     SubscriptBox[
      SuperscriptBox["\[CapitalGamma]", "\[Chi]"], 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]]}], 
    SuperscriptBox["v", "\[Mu]"], 
    SuperscriptBox["v", "\[Nu]"]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.976406945962009*^9, 3.976407010297072*^9}, {
  3.976407046718092*^9, 
  3.9764070849931173`*^9}},ExpressionUUID->"ac23f105-1c4e-4a46-9138-\
bdd79231619e"],

Cell[TextData[{
 "which resembles Newtonian ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "=", 
    RowBox[{"m", "\[VeryThinSpace]", "a"}]}], TraditionalForm]],
  ExpressionUUID->"80d56a3d-9519-463f-97da-0ca1485378d8"],
 ", with ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "e7bd4a7b-e811-4695-9887-bb3a7fee9150"],
 " as ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["v", "\[Chi]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}]], TraditionalForm]],
  CellChangeTimes->{{3.976406945962009*^9, 3.976407010297072*^9}, {
   3.976407046718092*^9, 3.9764070849931173`*^9}},ExpressionUUID->
  "0676c026-e619-4b91-97bc-6c328b041458"],
 " and the negative gradient of some velocity-dependent potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    RowBox[{"\[Del]", "\[CapitalPhi]"}]}], TraditionalForm]],ExpressionUUID->
  "23d5018d-6e7d-4ce1-9630-0b925dcc6414"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubscriptBox[
      SuperscriptBox["\[CapitalGamma]", "\[Chi]"], 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]]}], 
    SuperscriptBox["v", "\[Mu]"], 
    SuperscriptBox["v", "\[Nu]"]}], TraditionalForm]],
  CellChangeTimes->{{3.976406945962009*^9, 3.976407010297072*^9}, {
   3.976407046718092*^9, 3.9764070849931173`*^9}},ExpressionUUID->
  "c16c47ab-5b79-4d9d-94f9-423de2e7c882"],
 ". The terms in \[CapitalGamma] that scale as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox["r", "2"]}], TraditionalForm]],ExpressionUUID->
  "a01d1485-0479-4537-aa7c-e344d6061a8b"],
 ", namely the first term (",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c7607c99-e17f-4113-9a7f-1d8c639a117f"],
 " in the numerator cancels ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fe790b31-e0ed-4ff4-9e1e-9b985c9758b4"],
 " to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c4094534-6de9-4a20-b117-029c8b5eb1d0"],
 " in the denominator), represent the gravitational pull from the \
Coulomb-like part of the metric gradient. The \
\[OpenCurlyDoubleQuote]Doppler-like\[CloseCurlyDoubleQuote] factor in the \
second term ensures that the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox["r", "2"]}], TraditionalForm]],ExpressionUUID->
  "6c075274-37d5-4964-b3c9-3cdaf46fd69c"],
 " \[OpenCurlyDoubleQuote]force\[CloseCurlyDoubleQuote] points to the \
instantaneous position of the source!"
