551ef6fe0422"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gradHRaw", "=", 
    RowBox[{"fourGrad", "[", 
     RowBox[{
      RowBox[{"h", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], ",", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Gamma]", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Simplify", " ", "and", " ", "apply", " ", "tensor", " ", "rules"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"metricGradient", "=", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"gradHRaw", "//.", "tensorRules"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "k"}], "}"}], ",", "FullSimplify"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Gradient \!\(\*SubscriptBox[\(\[PartialD]\), \(\[Rho]\)]\
\)\!\(\*SubscriptBox[\(h\), \(\[Mu]\[VeryThinSpace]\[Nu]\)]\) of the metric \
perturbation \!\(\*SubscriptBox[\(h\), \(\[Mu]\[VeryThinSpace]\[Nu]\)]\):\>\"",
    "]"}], ";"}], "\n", 
 RowBox[{"metricGradient", "/.", " ", "dpyRules"}]}], "Input",
 CellChangeTimes->{{3.976308325195485*^9, 3.9763083251974173`*^9}, {
  3.976308491104574*^9, 3.976308550557601*^9}, {3.976310384067379*^9, 
  3.9763104083173447`*^9}, {3.976310540843061*^9, 3.976310560048774*^9}, {
  3.976310591069653*^9, 3.976310591754273*^9}, {3.976376070763318*^9, 
  3.976376096918991*^9}, {3.9763761535475817`*^9, 3.9763761581703663`*^9}, {
  3.9763763282444277`*^9, 3.976376328574682*^9}, {3.976376369361322*^9, 
  3.976376372676647*^9}, {3.97637902533519*^9, 3.976379028567297*^9}, {
  3.9765230730724497`*^9, 3.97652312164392*^9}, {3.9765232051213217`*^9, 
  3.976523226318177*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"b64a2725-8be7-430f-9f46-fa3ee53b69ce"],

Cell[BoxData["\<\"Gradient \\!\\(\\*SubscriptBox[\\(\[PartialD]\\), \\(\[Rho]\
\\)]\\)\\!\\(\\*SubscriptBox[\\(h\\), \\(\[Mu]\[VeryThinSpace]\[Nu]\\)]\\) of \
the metric perturbation \\!\\(\\*SubscriptBox[\\(h\\), \\(\[Mu]\
\[VeryThinSpace]\[Nu]\\)]\\):\"\>"], "Print",
 CellChangeTimes->{{3.976523199934729*^9, 3.976523227798462*^9}, 
   3.9765248265826397`*^9, 3.976544546147505*^9},
 CellLabel->
  "During evaluation of \
In[26]:=",ExpressionUUID->"6b457476-1d3a-4dd4-9de2-e80a260b7284"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"k", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        SubscriptBox["\[Lambda]", "\[Gamma]"]}], " ", 
       SubscriptBox["\[Lambda]", "\[Mu]"], " ", 
       SubscriptBox["\[Lambda]", "\[Nu]"]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          TagBox[
           FractionBox[
            RowBox[{"d", " ", 
             SubscriptBox["\[Lambda]", "\[Nu]"]}], 
            RowBox[{"d", " ", "s"}]],
           DisplayForm], " ", 
          SubscriptBox["\[Lambda]", "\[Mu]"]}], "+", 
         RowBox[{
          TagBox[
           FractionBox[
            RowBox[{"d", " ", 
             SubscriptBox["\[Lambda]", "\[Mu]"]}], 
            RowBox[{"d", " ", "s"}]],
           DisplayForm], " ", 
          SubscriptBox["\[Lambda]", "\[Nu]"]}]}], ")"}], " ", 
       SubscriptBox["\[Sigma]", "\[Gamma]"]}]}], ")"}]}], 
   SuperscriptBox["r", "2"]], "+", 
  FractionBox[
   RowBox[{"k", " ", 
    SubscriptBox["\[Lambda]", "\[Mu]"], " ", 
    SubscriptBox["\[Lambda]", "\[Nu]"], " ", 
    SubscriptBox["\[Sigma]", "\[Gamma]"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{
       TagBox[
        FractionBox[
         RowBox[{"d", " ", 
          TemplateBox[{"\[Lambda]", "\[Rho]"},
           "Superscript"]}], 
         RowBox[{"d", " ", "s"}]],
        DisplayForm], " ", 
       SubscriptBox["\[Sigma]", "\[Rho]"]}]}], ")"}]}], 
   SuperscriptBox["r", "3"]]}]], "Output",
 CellChangeTimes->{{3.976523199936493*^9, 3.976523227800006*^9}, 
   3.9765248265838737`*^9, 3.976544546148376*^9},
