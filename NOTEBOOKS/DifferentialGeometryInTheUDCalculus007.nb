Cell[TextData[{
 "The code is presented here in reverse of the best order for human reading, \
because it\[CloseCurlyQuote]s necessary to evaluate the implementation before \
showing what it can do and how to use it (",
 StyleBox["def before ref",
  FontSlant->"Italic"],
 ", the standard dilemma of ",
 StyleBox["Literate Programming",
  FontSlant->"Italic"],
 ", which we can\[CloseCurlyQuote]t practice)",
 ". "
}], "Text",
