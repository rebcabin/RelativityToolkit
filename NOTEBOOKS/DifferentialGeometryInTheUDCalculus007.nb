   3.977100958290923*^9}},ExpressionUUID->"d196a6e9-ad1f-4a66-b242-\
fd06c700e5b5"],

Cell["\<\
Abstractions: \[ScriptCapitalU]\[ScriptCapitalD] manipulates tensors as whole \
symbolic objects, rather than as decorated arrays, preserving index notation \
in both input and output forms.\
\>", "Item",
 CellChangeTimes->{
  3.976805343965353*^9, {3.976807171258144*^9, 3.976807218345378*^9}, {
   3.976807258054213*^9, 3.976807372892746*^9}, {3.9768074213746433`*^9, 
