Cell[TextData[{
 "Our guide for this journey is Eric Poisson\[CloseCurlyQuote]s text, ",
 StyleBox["A Relativist\[CloseCurlyQuote]s Toolkit",
  FontSlant->"Italic"],
 ". We will proceed section by section over several notebooks, implementing \
his textual toolkit as a software toolkit."
}], "Text",
 CellChangeTimes->{
