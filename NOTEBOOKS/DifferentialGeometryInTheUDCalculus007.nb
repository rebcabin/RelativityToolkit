Cell[TextData[{
 "The Metric: An operator that automates isomorphisms resulting from raising \
and lowering indices, capable, for instance, of showing, that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["A", "\[Mu]"], 
