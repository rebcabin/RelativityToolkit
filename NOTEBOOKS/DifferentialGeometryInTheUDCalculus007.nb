  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Should", " ", "be", " ", 
    RowBox[{"False", "/", "Error"}], " ", "for", " ", "bad", " ", "physics"}],
    "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"badPhysics", "=", 
