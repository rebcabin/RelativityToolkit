 RowBox[{
  RowBox[{"Print", "[", "\"\<\\n1. Metric Gymnastics:\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"termLower", "=", 
   RowBox[{
    RowBox[{"g", "[", 
     RowBox[{
      RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], 
    RowBox[{"A", "[", 
     RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resLower", "=", 
   RowBox[{"termLower", "/.", " ", "metricRules"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
   "termLower", 
    ",", "\"\<Input g[\[ScriptCapitalD][\[Mu]],\[ScriptCapitalD][\[Nu]]] A[\
\[ScriptCapitalU][\[Nu]]]: \>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{"resLower", ",", "\"\<Result (A_u): \>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"termInverse", "=", 
   RowBox[{
    RowBox[{"g", "[", 
     RowBox[{
      RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], ",", 
      RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]", "]"}]}], "]"}], " ", 
    RowBox[{"g", "[", 
     RowBox[{
      RowBox[{"\[ScriptCapitalD]", "[", "\[Alpha]", "]"}], ",", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resInverse", "=", 
   RowBox[{"termInverse", "/.", " ", "metricRules"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
   "termInverse", 
    ",", "\"\<Metric Product: g[\[ScriptCapitalU][\[Mu]],\[ScriptCapitalU][\
\[Alpha]]] g[\[ScriptCapitalD][\[Alpha]],\[ScriptCapitalD][\[Nu]]]\>\""}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{"resInverse", ",", "\"\<Inverse Identity (Delta^u_v): \>\""}], 
    "]"}], ";"}], "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"2.", " ", "VALENCE", " ", "CHECKER"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<\\n2. Valence Safety Check:\>\"", "]"}], ";"}], 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Should", " ", "be", " ", "True"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"valCheck", "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"valence", "[", "resLower", "]"}], "===", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "}"}], ",", 
       RowBox[{"{", "\[Mu]", "}"}]}], "}"}]}], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
