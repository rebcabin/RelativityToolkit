Cell[CellGroupData[{

Cell["The Road Beyond the Dragon: Comparing to the WFR", "Section",
 CellChangeTimes->{{3.979076149677253*^9, 3.979076166384181*^9}, {
  3.979302066457344*^9, 
  3.9793020778827677`*^9}},ExpressionUUID->"8c271e6b-6a11-4e38-8cfb-\
7f3bf0f25be5"],

Cell["\<\
Now that we are past the dragon, the details of the Wizard\[CloseCurlyQuote]s \
Map are meaningful. We travel to the Great Library (the Wolfram Function \
Repository) to seek our prize. \
\>", "Text",
 CellChangeTimes->{{3.97930641753378*^9, 3.9793064950301027`*^9}, {
   3.9793065706159153`*^9, 3.979306576737336*^9}, {3.979306716338992*^9, 
   3.979306800717072*^9}, 
   3.979307005574925*^9},ExpressionUUID->"652caaf7-dce7-4361-8bf4-\
2b2aba8d4a1a"],

Cell[TextData[{
 "We must be careful with dialects. The Wizard Chandra speaks of \
\[OpenCurlyDoubleQuote]specific angular momentum\[CloseCurlyDoubleQuote] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"a", "=", 
     RowBox[{"J", "/", "M"}]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "654b756b-1a14-4844-b4dd-5fe6fd0de18d"],
 ", while the Library\[CloseCurlyQuote]s books speak of \
\[OpenCurlyDoubleQuote]total angular momentum\[CloseCurlyDoubleQuote] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "J", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "74caddee-c75d-45d1-9201-9da48b5bb3d3"],
 ". But there is a picture of the jewel, now in the hilt of the Magical \
Sword. We perform the translation and overlay our jewel upon theirs."
}], "Text",
 CellChangeTimes->{
  3.97930641753378*^9, {3.979306504279571*^9, 3.979306583505916*^9}, {
   3.9793070151211767`*^9, 3.979307058143992*^9}, 3.979313236184844*^9, 
   3.979313969870174*^9},ExpressionUUID->"b7881ae7-04fa-4d65-af3c-\
a6f17c9af728"],

Cell["\<\
It is a perfect match. The very jewel that enchanted the dragon into letting \
us pass is the secret key to the Wondrous Machine! Our quest is over, and we \
thought we had only begun! The visualizer is no longer a mysterious artifact. \
The Wondrous Machine is a solved and understood instrument, ready for us to \
explore the Ergosphere and beyond.\
\>", "Text",
 CellChangeTimes->{
  3.97930641753378*^9, {3.979306504279571*^9, 3.979306632633141*^9}, {
   3.979306970310088*^9, 3.979306989063858*^9}, {3.979307063665641*^9, 
   3.979307133623201*^9}},ExpressionUUID->"029e3d10-c810-4934-82e5-\
8cbfe266f33d"],

Cell[CellGroupData[{

Cell["Retrieving the Kerr Metric from WFR", "Subsection",
 CellChangeTimes->{{3.979220215745728*^9, 
  3.979220228710517*^9}},ExpressionUUID->"58ced0cf-86db-49ee-9f60-\
d0bbf9dc0c42"],

Cell[TextData[{
 "With parameters ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6e18bb4b-58ed-4be1-b258-ce8d7561c049"],
 " and ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "92f5eec8-31bb-455c-b439-995bf0525d5f"],
 ", substituting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"M", "\[VeryThinSpace]", "a"}], "=", "J"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "64882382-0156-49d0-b657-1440123907eb"],
 " for the angular-momentum expected by WFR:"
}], "Text",
 CellChangeTimes->{{3.979220254781226*^9, 3.9792202965135813`*^9}, {
  3.979221225882245*^9, 3.97922123100631*^9}, {3.979225971990326*^9, 
  3.979225973175668*^9}},ExpressionUUID->"4d4270de-883f-40b2-92d6-\
e64fe83855fa"],

