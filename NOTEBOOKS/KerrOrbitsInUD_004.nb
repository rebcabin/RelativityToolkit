Cell[TextData[{
 "The Geodesic Equation, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x", "''"}], "+", 
     RowBox[{"\[CapitalGamma]", " ", 
      RowBox[{"x", "'"}], " ", 
