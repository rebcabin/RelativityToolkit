    RowBox[{"{", 
     RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}]}], " ", 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"wfrMatrix", "=", 
    RowBox[{
