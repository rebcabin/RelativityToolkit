    FractionBox[
     RowBox[{"2", "M"}], 
     RowBox[{"r", "+", 
      RowBox[{"\[ImaginaryI]", " ", "a", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.979123393686983*^9, 3.979123393688423*^9}, {
   3.9791678213096113`*^9, 3.979167821857141*^9}, {3.979168021848728*^9, 
