$CellContext`r[$CellContext`\[Tau]] Cos[
               $CellContext`\[Theta][$CellContext`\[Tau]]]}, \
$CellContext`sol$], {$CellContext`\[Tau], 0, $CellContext`Tmax$}, PlotStyle -> {
