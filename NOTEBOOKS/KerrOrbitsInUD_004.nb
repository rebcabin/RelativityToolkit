 CellChangeTimes->{{3.979076962136963*^9, 3.9790771243117867`*^9}, {
   3.979077324506407*^9, 3.979077328374013*^9}, 3.97911560507299*^9, 
   3.979117600409993*^9, {3.979117645833679*^9, 3.9791179045511093`*^9}, {
   3.979117959161922*^9, 3.97911797528207*^9}, 3.9791457695832653`*^9},
 CellLabel->"In[43]:=",ExpressionUUID->"4b6d808f-fd5b-48de-af6c-941e5adc4e42"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"gDD", 
     SubscriptBox["", "t"], 
     SubscriptBox["", "t"]}], "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{
    RowBox[{"gDD", 
     SubscriptBox["", "t"], 
     SubscriptBox["", "\[Phi]"]}], "\[Rule]", 
    RowBox[{"-", 
     RowBox[{"h", "[", 
      RowBox[{"r", ",", "\[Theta]"}], "]"}]}]}], ",", 
   RowBox[{
    RowBox[{"gDD", 
     SubscriptBox["", "r"], 
     SubscriptBox["", "r"]}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"gDD", 
     SubscriptBox["", "\[Theta]"], 
     SubscriptBox["", "\[Theta]"]}], "\[Rule]", 
    SuperscriptBox["r", "2"]}], ",", 
   RowBox[{
    RowBox[{"gDD", 
     SubscriptBox["", "\[Phi]"], 
     SubscriptBox["", "t"]}], "\[Rule]", 
    RowBox[{"-", 
     RowBox[{"h", "[", 
      RowBox[{"r", ",", "\[Theta]"}], "]"}]}]}], ",", 
   RowBox[{
    RowBox[{"gDD", 
     SubscriptBox["", "\[Phi]"], 
     SubscriptBox["", "\[Phi]"]}], "\[Rule]", 
    RowBox[{
     SuperscriptBox["r", "2"], " ", 
     SuperscriptBox[
      RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.979338083436742*^9},
 CellLabel->"Out[43]=",ExpressionUUID->"018bccf8-e476-4411-9d2f-483d8e16a17a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"weakInvRules", "=", 
  RowBox[{"MatrixToUDRules", "[", 
   RowBox[{
   "weakMetricInvLinearized", ",", "gUU", ",", "\[ScriptCapitalU]", ",", 
    "coords"}], "]"}]}]], "Input",
