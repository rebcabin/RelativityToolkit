 RowBox[{
  RowBox[{"physAssumptions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "\[Element]", "Reals"}], ",", 
     RowBox[{"\[Theta]", "\[Element]", "Reals"}], ",", 
     RowBox[{"M", ">", "0"}], ",", 
     RowBox[{"a", "\[Element]", "Reals"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.979123393686983*^9, 3.979123393688423*^9}, {
