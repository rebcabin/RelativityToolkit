Cell[CellGroupData[{

Cell["Provisions for the Sword: New Compiler Functions", "Section",
 CellChangeTimes->{{3.978215211558666*^9, 3.978215217736579*^9}, {
  3.978215256463418*^9, 3.978215258586466*^9}, {3.9792386866529903`*^9, 
  3.979238687458605*^9}, {3.979287742298235*^9, 3.979287746889595*^9}, {
  3.979294457532069*^9, 3.979294459553138*^9}, {3.979294499706122*^9, 
  3.9792945174557056`*^9}, {3.97929470845288*^9, 3.9792947183178177`*^9}, {
  3.979298551556937*^9, 
  3.97929855709571*^9}},ExpressionUUID->"dfb3196a-61e5-4ae5-aef0-\
eacbddf5853b"],

Cell["\<\
The Wizard Chandra gave us the pieces for The Magical Sword. We are sure we \
will need it, but we should not put it together too early, lest we damage it \
or dissipate its power.\
\>", "Text",
 CellChangeTimes->{{3.979302987097279*^9, 3.9793030450175543`*^9}, {
  3.979304762768875*^9, 3.979304767146954*^9}, {3.9793127279107*^9, 
  3.97931273077208*^9}, {3.979313997183207*^9, 
  3.979314018821072*^9}},ExpressionUUID->"636bd650-87cb-4123-a3e2-\
6622aec113bd"],

Cell["\<\
We add several new general-purpose functions to the \[ScriptCapitalU]\
\[ScriptCapitalD] compiler corpus. This section sketches their functionality, \
and the rest of the notebook illustrates their use by example. These \
functions pertain to future problems in general relativity and differential \
geometry.\
\>", "Text",
 CellChangeTimes->{{3.978224402203388*^9, 3.9782244940026903`*^9}, {
  3.979238698107998*^9, 3.979238701857283*^9}, {3.979238889454331*^9, 
  3.9792388907138166`*^9}, {3.9792528777406187`*^9, 3.979252907154374*^9}, {
  3.979287636005085*^9, 3.979287754556941*^9}, {3.9792985718941193`*^9, 
  3.9792985871727867`*^9}, {3.979303047511545*^9, 3.979303050627738*^9}, {
  3.979312748778365*^9, 
  3.979312749883649*^9}},ExpressionUUID->"4ecf1271-efad-4fa7-9d81-\
962636d3e7e4"],

Cell["\<\
In this notebook, \[OpenCurlyDoubleQuote]matrix\[CloseCurlyDoubleQuote] is a \
synonym for a Wolfram 2D array. A tensor is either a matrix that satisfies \
coordinate-transformation rules, or a collection of symbolic \
\[ScriptCapitalU]\[ScriptCapitalD] expressions that also satisfy \
coordinate-transformation rules.\
\>", "Text",
 CellChangeTimes->{{3.978225091165732*^9, 
  3.978225175875058*^9}},ExpressionUUID->"1e9f92bf-1c32-430a-85c4-\
d3b813d63209"],

Cell[CellGroupData[{

Cell["A Summoning Spell: \[CapitalGamma]\[NoBreak]-\[NoBreak]getter", \
"Subsection",
 CellChangeTimes->{{3.979074333501361*^9, 3.979074333503202*^9}, {
   3.979074382141273*^9, 3.97907438830672*^9}, {3.979074421606793*^9, 
   3.979074590520749*^9}, {3.979074638210091*^9, 3.979074709815413*^9}, {
   3.9790749742263727`*^9, 3.9790751588520517`*^9}, {3.979075195429298*^9, 
   3.979075219218081*^9}, {3.979075258653852*^9, 3.9790752734725657`*^9}, {
   3.979075337625022*^9, 3.979075451712229*^9}, {3.979075843337785*^9, 
   3.979075867526464*^9}, {3.979075901585245*^9, 3.979075915205324*^9}, {
   3.979114269443429*^9, 3.979114288601308*^9}, {3.979114945465322*^9, 
   3.979114976458199*^9}, {3.979115047653364*^9, 3.979115051183404*^9}, {
   3.979115119745513*^9, 3.979115173985195*^9}, 3.979115253907941*^9, {
   3.979115373619516*^9, 3.979115386283698*^9}, 3.979115457164303*^9, 
   3.979144060787876*^9, {3.9791444621084538`*^9, 3.979144477733529*^9}, {
   3.979288554312101*^9, 
   3.979288561569928*^9}},ExpressionUUID->"2a4d05bd-7100-456f-84ce-\
5e18600bd4fa"],

Cell[TextData[{
 "Just as ",
 StyleBox["CalculateRicciComponent", "Input"],
 ", already in the toolkit, needs a Riemann-getter for fetching components \
from Riemann, so ",
 StyleBox["CalculateRiemannComponent", "Input"],
 " needs a \[CapitalGamma]\[NoBreak]-\[NoBreak]getter for fetching components \
of the Christoffel symbols. Heretofore, \
\[CapitalGamma]\[NoBreak]-\[NoBreak]getters were ad-hoc, constructed \
on-the-fly. But now we offer a way to build them from rule-patterned \
ancestors: the metric and its inverse. "
}], "Text",
 CellChangeTimes->{{3.979252934774337*^9, 3.97925303846382*^9}, {
  3.979253236223192*^9, 3.979253259295124*^9}, {3.979253297258065*^9, 
  3.9792533178478823`*^9}, {3.979253431033354*^9, 3.9792534563292027`*^9}, {
  3.9792877848226643`*^9, 3.979288026238204*^9}, {3.979288090529805*^9, 
  3.979288116875629*^9}, {3.979294539742413*^9, 3.979294561227523*^9}, {
  3.979312785465255*^9, 
  3.979312791647963*^9}},ExpressionUUID->"fc2fd3cd-ca5b-48bd-a946-\
d954420f206e"],

Cell[TextData[{
 "Given symbols and rules for the covariant metric, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  ExpressionUUID->"185319d1-aae2-4288-94d0-9f0acf06d159"],
 ", and its contravariant inverse, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  ExpressionUUID->"4f5e374b-b926-407f-b6f4-1d3cac39b6a4"],
 ", ",
 StyleBox["CalculateGammaComponent", "Input"],
 " is a general way to fetch an individual component at indices ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalU]", "[", "s", "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ff4289dc-7a18-4fc5-a29c-41960fb765a6"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalD]", "[", "m", "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4ae38d9d-236a-439c-9c5f-b1157bad945e"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalD]", "[", "n", "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "128a4a1f-7aa2-4f41-93c8-71d65c1d9bf9"],
 " of the Christoffel symbols. This definition and implementation mirrors its \
partners, ",
 StyleBox["CalculateRiemannComponent", "Input"],
 " and ",
 StyleBox["CalculateRicciComponent", "Input"],
 ", introduced in v1.9.0. "
}], "Text",
 CellChangeTimes->{{3.979252934774337*^9, 3.97925303846382*^9}, {
  3.979253236223192*^9, 3.979253259295124*^9}, {3.979253297258065*^9, 
  3.9792533178478823`*^9}, {3.979253431033354*^9, 3.9792534563292027`*^9}, {
  3.9792877848226643`*^9, 3.979288000694112*^9}, {3.979288037690797*^9, 
  3.979288058434655*^9}, {3.9792945901246977`*^9, 
  3.979294695879385*^9}},ExpressionUUID->"344f11dd-08c7-4772-90e5-\
0e205c2bd57d"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["The covariant and contravariant metrics stand in a mutually \
matrix-inverse relationship because ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Rho]"}]}]], 
     SubscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Rho]", " ", "n"}]}]]}], "=", 
    SubscriptBox[
     SuperscriptBox["\[Delta]", 
      RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], 
     RowBox[{"\[VeryThinSpace]", "\[Nu]"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "853e41bb-a22c-4bf6-ad5d-3f1c48f26c60"],
 ", ",
 StyleBox["the Kronecker delta, aka the Identity matrix.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.979253058767469*^9, 
  3.979253218000629*^9}},ExpressionUUID->"a2144d02-445e-4b13-8a38-\
7a8a4cfeb980"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CalculateGammaComponent", "[", 
    RowBox[{
    "s_", ",", "m_", ",", "n_", ",", "\[IndentingNewLine]", "gDD_Symbol", ",",
      "gDDRules_", ",", "\[IndentingNewLine]", "gInvUU_Symbol", ",", 
     "gInvUURules_", ",", "\[IndentingNewLine]", "coords_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"ContractAll", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ChristoffelsFromMetric", "[", 
          RowBox[{"gDD", ",", "gInvUU", ",", "s", ",", "m", ",", "n"}], "]"}],
          ",", "\[IndentingNewLine]", "coords"}], "]"}], "/.", 
       "\[IndentingNewLine]", "gDDRules"}], "/.", "\[IndentingNewLine]", 
      "gInvUURules"}], ")"}], "//", "\[IndentingNewLine]", 
    "EvaluateUDPartials"}]}], ";"}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.979223283754856*^9, 3.979223293204425*^9}, {
   3.979224173652074*^9, 3.979224199481469*^9}, {3.979224478541786*^9, 
   3.979224640409203*^9}, {3.979225135002983*^9, 3.979225141814267*^9}, 
   3.979241346181397*^9},
 CellLabel->"In[8]:=",ExpressionUUID->"da248c96-abe4-42ef-9fae-dbca8e651502"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["The Handguard: Gradient",
 FontWeight->"Plain"]], "Subsection",
 CellChangeTimes->{{3.979167517340946*^9, 3.9791675347096653`*^9}, {
  3.979167681747864*^9, 3.979167695448578*^9}, {3.979169938783897*^9, 
  3.979169939339129*^9}, {3.9791702373610907`*^9, 3.979170238932434*^9}, {
  3.979240631209446*^9, 3.979240632022749*^9}, {3.979288571851192*^9, 
  3.979288578147974*^9}},
 FontWeight->"Bold",ExpressionUUID->"355c5b6e-e587-404a-aafa-34cbb0ceaa20"],

Cell["\<\
For Ernst\[CloseCurlyQuote]s equation (the Magical Sword), we\
\[CloseCurlyQuote]ll need the gradient operator in curved spacetime.\
\>", "Text",
 CellChangeTimes->{{3.9792881874825363`*^9, 3.9792882230190067`*^9}, {
  3.979312814455658*^9, 
  3.979312817193101*^9}},ExpressionUUID->"c88258d9-50f8-4b04-9430-\
14daa17c70a6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[Del]", 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], "f"}], "\[Congruent]", 
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], 
    SubscriptBox["f", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{",", "\[VeryThinSpace]", "\[Nu]"}]}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.97916997973195*^9, 3.979170016147656*^9}, {
  3.979171178371128*^9, 
  3.9791711783722363`*^9}},ExpressionUUID->"bb302c4e-f321-4f6b-b271-\
6d67d7415f40"],

Cell["\<\
is also the workhorse of Hamilton-Jacobi Theory (whence we get the geodesic \
equations) e.g.\
\>", "Text",
 CellChangeTimes->{{3.9791710274027767`*^9, 3.9791710512711887`*^9}, {
  3.979288229245164*^9, 
  3.979288288357403*^9}},ExpressionUUID->"920a6bed-af97-4640-a705-\
6d1cabb2ee69"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"H", "=", 
    RowBox[{
     FractionBox["1", "2"], 
     SuperscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], 
     SubscriptBox["p", "\[Mu]"], 
     SubscriptBox["p", "\[Nu]"]}]}], "    ", ",", " ", 
   RowBox[{
    RowBox[{"where", " ", 
     SubscriptBox["p", "\[Mu]"]}], "=", 
    RowBox[{
     SubscriptBox["S", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{",", "\[VeryThinSpace]", "\[Mu]"}]}]], " ", "is", " ", "the", " ",
      "derivative", " ", "of", " ", "the", " ", "action", " ", "S"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.979171062081292*^9, 
  3.979171168037533*^9}},ExpressionUUID->"365183b0-8ffd-42ea-a472-\
114ca6e7db3c"],

Cell[TextData[{
 "Because ",
 StyleBox["GradRaised", "Input"],
 " needs only the contravariant metric, it takes only a symbol and rules for \
that."
}], "Text",
 CellChangeTimes->{{3.979253502620185*^9, 
  3.979253569726528*^9}},ExpressionUUID->"01275cfc-173f-4ffa-910b-\
6d04f07afe43"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GradRaised", "[", 
    RowBox[{
    "func_", ",", "gInvUU_Symbol", ",", "gInvUURules_", ",", "coords_"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gInvUU", "[", 
           RowBox[{
            RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], ",", 
            RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}]}], "]"}], "/.", 
          " ", "gInvUURules"}], ")"}], 
        RowBox[{"D", "[", 
         RowBox[{"func", ",", "\[Nu]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"{", 
        RowBox[{"\[Nu]", ",", "coords"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Mu]", ",", "coords"}], "}"}]}], "]"}]}], ";"}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.979170046831539*^9, 3.979170103166464*^9}, {
   3.979170133794673*^9, 3.979170203999188*^9}, {3.979238983865803*^9, 
   3.979239069259131*^9}, 3.9792391016172457`*^9},
 CellLabel->"In[9]:=",ExpressionUUID->"9cdad717-ddad-4acc-be19-f1db3a13bff2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Hilt: Gradient Squared", "Subsection",
 CellChangeTimes->{{3.979167716355565*^9, 3.979167734879045*^9}, 
   3.979170405199916*^9, {3.9791707793257*^9, 3.979170781416658*^9}, {
   3.979240636319227*^9, 3.979240637413432*^9}, {3.97928858421131*^9, 
   3.979288587950664*^9}},ExpressionUUID->"fbe061f3-074e-49df-a6b3-\
dd8b284164cb"],

Cell["The hilt of the Magical Sword requires the squared gradient.", "Text",
 CellChangeTimes->{{3.979288317101103*^9, 3.9792883708446283`*^9}, {
  3.9792884245080147`*^9, 3.979288427568955*^9}, {3.9793128248831463`*^9, 
  3.979312830066435*^9}},ExpressionUUID->"cb622e87-9802-400d-8b01-\
cf7e8a135b09"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"\[Del]", "f"}], ")"}], "2"], "\[Congruent]", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Mu]"], "f"}], 
    RowBox[{
     SuperscriptBox["\[Del]", 
      RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], "f"}]}], "\[Congruent]", 
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], 
    SubscriptBox["f", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{",", "\[VeryThinSpace]", "\[Mu]"}]}]], 
    SubscriptBox["f", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{",", "\[VeryThinSpace]", "\[Nu]"}]}]]}], "\[Congruent]", 
   RowBox[{
    RowBox[{"\[Del]", "f"}], "\[VeryThinSpace]", "\[FilledSmallCircle]", "\[VeryThinSpace]", 
    RowBox[{"\[Del]", "f"}]}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.97916997973195*^9, 3.979170016147656*^9}, {
  3.979170426453018*^9, 3.979170506128488*^9}, {3.979171188306525*^9, 
  3.979171188307576*^9}, {3.9791713439605*^9, 
  3.979171364483396*^9}},ExpressionUUID->"43a1b00c-e685-4b46-b181-\
e6aa0119c691"],

Cell[TextData[{
 "Likewise, ",
 StyleBox["GradSquared", "Input",
  FontWeight->"Plain"],
 " needs only the contravariant metric, taking only a symbol and rules for \
that."
}], "Text",
 CellChangeTimes->{{3.979253502620185*^9, 3.979253560105633*^9}, {
  3.9792536637805023`*^9, 
  3.9792536792222557`*^9}},ExpressionUUID->"96d06d07-ebce-4cfc-81dc-\
f203962be68f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GradSquared", "[", 
    RowBox[{
    "func_", ",", "gInvUU_Symbol", ",", "gInvUURules_", ",", "coords_"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"grad", "=", 
       RowBox[{"MakeIndexer", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"GradRaised", "[", 
          RowBox[{"func", ",", "gInvUU", ",", "gInvUURules", ",", "coords"}], 
          "]"}], ",", "coords"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"Simplify", "[", "\[IndentingNewLine]", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"func", ",", "\[Mu]"}], "]"}], 
         RowBox[{"grad", "[", "\[Mu]", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Mu]", ",", "coords"}], "}"}]}], "]"}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.979170521118479*^9, 3.979170585847939*^9}, 
   3.979171488516252*^9, {3.9792391980512753`*^9, 3.97923933147298*^9}, 
   3.9792883012816677`*^9},ExpressionUUID->"611e1e95-597f-4dd0-a694-\
5f4ce8cb66e0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Blade: Scalar Laplacian", "Subsection",
 CellChangeTimes->{{3.979167766250102*^9, 3.979167770098526*^9}, {
  3.979171625495186*^9, 3.97917162728156*^9}, {3.979240660229392*^9, 
  3.9792406618071203`*^9}, {3.979288592486866*^9, 
  3.979288597316739*^9}},ExpressionUUID->"b47e744f-8428-4fb4-876e-\
db36740468d7"],

Cell["The blade of the Magical Sword is the Laplacian:", "Text",
 CellChangeTimes->{{3.979288390192957*^9, 3.979288441154537*^9}, {
  3.9793128349057283`*^9, 
  3.979312837881133*^9}},ExpressionUUID->"06270f85-ffea-4a01-afe9-\
c1243594a49f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[Del]", "2"], "f"}], "\[Congruent]", 
   RowBox[{
    FractionBox["1", 
     SqrtBox[
      RowBox[{"|", "g", "|"}]]], 
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], 
     RowBox[{"(", 
      RowBox[{
       SqrtBox[
        RowBox[{"|", "g", "|"}]], 
       SuperscriptBox["g", 
        RowBox[{"\[VeryThinSpace]", 
         RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], 
       RowBox[{
        SubscriptBox["\[PartialD]", "\[Nu]"], "f"}]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9791712017076807`*^9, 3.979171301447033*^9}, {
  3.979171670395409*^9, 
  3.9791717036930647`*^9}},ExpressionUUID->"da6b868b-0c3e-406f-b6bb-\
68e4f52970af"],

Cell[TextData[{
 "This is not ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"\[Del]", "f"}], ")"}], "2"], TraditionalForm]],ExpressionUUID->
  "96eef5b8-31da-4d09-b680-49793f7e5f08"],
 "."
}], "Text",
 CellChangeTimes->{{3.979171313515233*^9, 3.979171331524455*^9}, 
   3.979171371231926*^9, 
   3.979288446790967*^9},ExpressionUUID->"f28a3a14-3e38-4362-81d0-\
8b5d6c26e846"],

Cell[TextData[{
 "In addition to the now-regulatory contravariant metric, the Laplacian needs \
one more parameter, the square root of the determinant of the ",
 StyleBox["covariant",
  FontWeight->"Bold"],
 " metric, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  ExpressionUUID->"0ecffb3d-b5ab-480f-8bee-3fc248d5af2c"],
 "\[LongDash]Emphasis: the determinant of the down-down metric. This is best \
computed externally and passed in. "
}], "Text",
 CellChangeTimes->{{3.979253881549305*^9, 3.97925396518248*^9}, {
  3.9792540999878674`*^9, 3.9792541238760233`*^9}, {3.979288466796077*^9, 
  3.97928847484422*^9}, {3.979302599177719*^9, 
  3.979302613881555*^9}},ExpressionUUID->"fc35fab5-9908-4b0b-8267-\
7ab4ae13cfc4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ScalarLaplacian", "[", 
    RowBox[{
    "func_", ",", "gInvUU_Symbol", ",", "gInvUURules_", ",", "sqrtDetg_", ",",
      "coords_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"grad", "=", 
       RowBox[{"MakeIndexer", "[", 
        RowBox[{
         RowBox[{"GradRaised", "[", 
          RowBox[{"func", ",", "gInvUU", ",", "gInvUURules", ",", "coords"}], 
          "]"}], ",", "coords"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"Simplify", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"sqrtDetg", " ", "*", 
            RowBox[{"grad", "[", "\[Mu]", "]"}]}], ",", "\[Mu]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "coords"}], "}"}]}], "]"}], "/", "sqrtDetg"}],
       "]"}]}], "]"}]}], ";"}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.9791708636885*^9, 3.979170863689351*^9}, {
  3.979170930529274*^9, 3.979170999285639*^9}, {3.979171376087406*^9, 
  3.979171453451522*^9}, {3.979171525554514*^9, 3.979171615067799*^9}, {
  3.979238330990307*^9, 3.979238398219307*^9}, {3.9792384556347103`*^9, 
  3.9792384578521976`*^9}, {3.979239498695706*^9, 3.979239668218843*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"de7ba8fc-3ca4-448c-bb06-0c3a12d1628f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Wondrous Machine: Kerr Orbit Visualizer", "Section",
 CellChangeTimes->{{3.97907622322797*^9, 3.9790762304737*^9}, {
  3.979288617398196*^9, 3.979288623581114*^9}, {3.9792947398112507`*^9, 
  3.9792947457222977`*^9}},ExpressionUUID->"7583472e-6399-42ce-bd5d-\
3c5905455d6d"],

Cell["\<\
Before we leave on the quest to find out how it works, the Wizard Chandra \
shows us the whole machine and demonstrates what it does. \
\>", "Text",
 CellChangeTimes->{{3.9793056644431267`*^9, 3.9793057038545322`*^9}, {
  3.979312851413528*^9, 3.979312856238052*^9}, {3.9793139405779343`*^9, 
  3.979313946119183*^9}},ExpressionUUID->"334241c0-535f-4dbb-88fb-\
5c8b0b8f0c8d"],

Cell[TextData[{
 "But there is a warning label: this ancient artifact is designed to \
illustrate physically plausible scenarios. Given the particular decomposition \
of unconstrained initial conditions and parameters, it is possible to create \
non-physical scenarios, specifically ones that validate the null condition \
that velocity squared is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2d665f45-444f-4834-b60a-bb76afa82825"],
 ". "
}], "Text",
 CellChangeTimes->{{3.979244857301414*^9, 3.9792449594177313`*^9}, {
   3.979254160787346*^9, 3.979254185255986*^9}, 3.979288630392912*^9, {
   3.979303069716752*^9, 3.979303077472618*^9}, {3.979305720146557*^9, 
   3.979305726575643*^9}, 
   3.979312886960959*^9},ExpressionUUID->"bec3a4a2-84ed-4938-9584-\
8e1ae31f81ee"],

Cell[CellGroupData[{

Cell["Dependencies, Mute, En-Bloc", "Subsection",
 CellChangeTimes->{{3.9792543121254177`*^9, 
  3.97925432704935*^9}},ExpressionUUID->"800b7903-60b7-4f77-a1c4-\
06cc18efabca"],

Cell["\<\
These will be explained as we go along the quest\[CloseCurlyQuote]s journey. \
For now, take them as granted, as just enough to enable the visualizer.\
\>", "Text",
 CellChangeTimes->{{3.979254333748666*^9, 3.9792543906646137`*^9}, {
  3.979288661839445*^9, 3.979288662290839*^9}, {3.979294795612389*^9, 
  3.9792948016861963`*^9}, {3.979312899252708*^9, 
  3.979312901094001*^9}},ExpressionUUID->"732c2053-324b-4fcd-b437-\
f0f38fd8cb40"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coords", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalSigma]", "=", 
   RowBox[{
    SuperscriptBox["r", "2"], "+", 
    RowBox[{
     SuperscriptBox["a", "2"], 
     SuperscriptBox[
      RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalDelta]", "=", 
   RowBox[{
    SuperscriptBox["r", "2"], "-", 
    RowBox[{"2", "M", " ", "r"}], "+", 
    SuperscriptBox["a", "2"]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrMetric", "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"2", "M", " ", "r"}], "\[CapitalSigma]"]}], ")"}]}], "0", 
       "0", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"2", "M", " ", "a", " ", "r", " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
         "\[CapitalSigma]"]}]},
      {"0", 
       FractionBox["\[CapitalSigma]", "\[CapitalDelta]"], "0", "0"},
      {"0", "0", "\[CapitalSigma]", "0"},
      {
       RowBox[{"-", 
        FractionBox[
         RowBox[{"2", "M", " ", "a", " ", "r", " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
         "\[CapitalSigma]"]}], "0", "0", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["r", "2"], "+", 
          SuperscriptBox["a", "2"], "+", 
          FractionBox[
           RowBox[{"2", "M", " ", 
            SuperscriptBox["a", "2"], "r", " ", 
            SuperscriptBox[
             RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
           "\[CapitalSigma]"]}], ")"}], 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}
     }], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"gDD", ",", "gUU"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrRules", " ", "=", " ", 
   RowBox[{"Join", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"MatrixToUDRules", "[", 
      RowBox[{
      "kerrMetric", ",", " ", "gDD", ",", " ", "\[ScriptCapitalD]", ",", " ", 
       "coords"}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"gDD", "[", "__", "]"}], " ", "->", " ", "0"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrInverse", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Inverse", "[", "kerrMetric", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrInvRules", " ", "=", " ", 
   RowBox[{"Join", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"MatrixToUDRules", "[", 
      RowBox[{
      "kerrInverse", ",", " ", "gUU", ",", " ", "\[ScriptCapitalU]", ",", " ",
        "coords"}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"gUU", "[", "__", "]"}], " ", "->", " ", "0"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kerrGamma", "[", 
