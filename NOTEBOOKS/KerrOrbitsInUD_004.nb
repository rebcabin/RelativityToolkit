Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"defaultDuration", "=", "500"}], ",", "\[IndentingNewLine]", 
     RowBox[{"defaultEnergy", "=", "1.2"}], ",", "\[IndentingNewLine]", 
     RowBox[{"defaultVerticalKick", "=", "0.02"}], ",", "\[IndentingNewLine]", 
     RowBox[{"defaultAngularMomentum", "=", "0.05"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"defaultInitialRadius", "=", "8.0"}], ",", "\[IndentingNewLine]", 
     RowBox[{"defaultSpinParameter", "=", "0.9"}], ",", "\[IndentingNewLine]", 
     RowBox[{"defaultPuff", "=", "1.5"}]}], "}"}], ",", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"minDuration", "=", "10"}], ",", 
     RowBox[{"maxDuration", "=", "10000"}], ",", "\[IndentingNewLine]", 
     RowBox[{"minPuff", "=", "1.5"}], ",", 
     RowBox[{"maxPuff", "=", "20"}], ",", "\[IndentingNewLine]", 
     RowBox[{"minSpin", "=", "0.0"}], ",", 
     RowBox[{"maxSpin", "=", "0.99"}], ",", "\[IndentingNewLine]", 
     RowBox[{"minRadius", "=", "1.0"}], ",", 
     RowBox[{"maxRadius", "=", "20.0"}], ",", "\[IndentingNewLine]", 
     RowBox[{"minAngMom", "=", 
      RowBox[{"-", "0.15"}]}], ",", 
     RowBox[{"maxAngMom", "=", ".15"}], ",", "\[IndentingNewLine]", 
     RowBox[{"minKick", "=", "0.0"}], ",", 
     RowBox[{"maxKick", "=", "0.10"}], ",", "\[IndentingNewLine]", 
     RowBox[{"minE", "=", "0.8"}], ",", 
     RowBox[{"maxE", "=", "2.0"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"innerLimitRadius", "=", "2.1"}], "}"}], ",", "\n", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sol", ",", 
         RowBox[{"Mval", "=", "1"}], ",", 
         RowBox[{"Tmax", "=", "duration"}], ",", "rMin"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"initConds", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"t", "[", "0", "]"}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"t", "'"}], "[", "0", "]"}], "==", "initE"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"r", "[", "0", "]"}], "==", "initR"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"r", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"\[Theta]", "[", "0", "]"}], "==", 
            RowBox[{"\[Pi]", "/", "2"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Theta]", "'"}], "[", "0", "]"}], "==", 
            "initVelTheta"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"\[Phi]", "[", "0", "]"}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Phi]", "'"}], "[", "0", "]"}], "==", "initL"}]}], 
          "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"explicitAccelerations", "/.", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"M", "->", "Mval"}], ",", 
                  RowBox[{"a", "->", "spinParam"}]}], "}"}]}], ",", 
               "initConds"}], "}"}], "/.", " ", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"M", "->", "Mval"}], ",", 
               RowBox[{"a", "->", "spinParam"}]}], "}"}]}], ",", 
            "\[IndentingNewLine]", "funcs", ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"\[Tau]", ",", "0", ",", "Tmax"}], "}"}], ",", 
            RowBox[{"Method", "->", "\"\<StiffnessSwitching\>\""}], ",", 
            RowBox[{"MaxSteps", "->", "100000"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rMin", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{"MinValue", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"r", "[", "\[Tau]", "]"}], "/.", " ", "sol"}], ")"}],
                "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"0", "<=", "\[Tau]", "<=", "Tmax"}]}], "}"}], ",", 
            "\[Tau]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"ParametricPlot3D", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"r", "[", "\[Tau]", "]"}], "*", 
                RowBox[{"Sin", "[", 
                 RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], "]"}], "*", 
                RowBox[{"Cos", "[", 
                 RowBox[{"\[Phi]", "[", "\[Tau]", "]"}], "]"}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"r", "[", "\[Tau]", "]"}], "*", 
                RowBox[{"Sin", "[", 
                 RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], "]"}], "*", 
                RowBox[{"Sin", "[", 
                 RowBox[{"\[Phi]", "[", "\[Tau]", "]"}], "]"}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"r", "[", "\[Tau]", "]"}], "*", 
                RowBox[{"Cos", "[", 
                 RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], "]"}]}]}], "}"}], "/.",
              " ", "sol"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"\[Tau]", ",", "0", ",", "Tmax"}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"rMin", "<", "innerLimitRadius"}], ",", "Red", ",", 
                 "Cyan"}], "]"}], ",", 
               RowBox[{"Thickness", "[", "0.003", "]"}]}], "}"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "initR"}], "*", "puff"}], ",", 
                 RowBox[{"initR", "*", "puff"}]}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "initR"}], "*", "puff"}], ",", 
                 RowBox[{"initR", "*", "puff"}]}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "initR"}], "*", "puff"}], ",", 
                 RowBox[{"initR", "*", "puff"}]}], "}"}]}], "}"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Boxed", "->", "True"}], ",", 
            RowBox[{"Axes", "->", "False"}], ",", 
            RowBox[{"Background", "->", "Black"}], ",", 
            RowBox[{"ImageSize", "->", "Large"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"The", " ", "Black", " ", "Hole", " ", "Horizons"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Graphics3D", "[", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Outer", " ", "Event", " ", 
               RowBox[{"Horizon", ":", 
                RowBox[{"r", "+"}]}]}], " ", "=", 
              RowBox[{"M", "+", 
               RowBox[{"Sqrt", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"M", "^", "2"}], "-", 
                  RowBox[{"a", "^", "2"}]}], ")"}]}]}]}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"Black", ",", 
             RowBox[{"Sphere", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
               RowBox[{"Mval", "+", 
                RowBox[{"Sqrt", "[", 
                 RowBox[{
                  RowBox[{"Mval", "^", "2"}], "-", 
                  RowBox[{"spinParam", "^", "2"}]}], "]"}]}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{
                RowBox[{"Ergosphere", " ", 
                 RowBox[{"(", 
                  RowBox[{"approximate", " ", "at", " ", "equator"}], ")"}]}],
                 ":", "r"}], "=", 
               RowBox[{"2", "M"}]}], "*)"}], "\[IndentingNewLine]", 
             RowBox[{"Opacity", "[", ".25", "]"}], ",", "Orange", ",", 
             RowBox[{"Sphere", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
               RowBox[{"2", "*", "Mval"}]}], "]"}]}], "}"}], "]"}]}], 
         "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", "Controls", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<Black Hole Parameters\>\"", ",", "Bold"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "spinParam", ",", "defaultSpinParameter", ",", "\"\<Spin (a)\>\""}], 
        "}"}], ",", "minSpin", ",", "maxSpin", ",", 
       RowBox[{"Appearance", "->", "\"\<Open\>\""}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<Orbit Parameters\>\"", ",", "Bold"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "initR", ",", "defaultInitialRadius", ",", "\"\<Initial Radius\>\""}],
         "}"}], ",", "minRadius", ",", "maxRadius", ",", 
       RowBox[{"Appearance", "->", "\"\<Open\>\""}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "initL", ",", "defaultAngularMomentum", 
         ",", "\"\<Ang Mom (Phi vel)\>\""}], "}"}], ",", "minAngMom", ",", 
       "maxAngMom", ",", 
       RowBox[{"Appearance", "->", "\"\<Open\>\""}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
