Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"gUU", 
     SuperscriptBox["", "t"], 
     SuperscriptBox["", "t"]}], "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{
    RowBox[{"gUU", 
     SuperscriptBox["", "t"], 
     SuperscriptBox["", "\[Phi]"]}], "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"], " ", 
       RowBox[{"h", "[", 
        RowBox[{"r", ",", "\[Theta]"}], "]"}]}], 
      SuperscriptBox["r", "2"]]}]}], ",", 
   RowBox[{
    RowBox[{"gUU", 
     SuperscriptBox["", "r"], 
     SuperscriptBox["", "r"]}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"gUU", 
     SuperscriptBox["", "\[Theta]"], 
     SuperscriptBox["", "\[Theta]"]}], "\[Rule]", 
    FractionBox["1", 
     SuperscriptBox["r", "2"]]}], ",", 
   RowBox[{
    RowBox[{"gUU", 
     SuperscriptBox["", "\[Phi]"], 
     SuperscriptBox["", "t"]}], "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"], " ", 
       RowBox[{"h", "[", 
        RowBox[{"r", ",", "\[Theta]"}], "]"}]}], 
      SuperscriptBox["r", "2"]]}]}], ",", 
   RowBox[{
    RowBox[{"gUU", 
     SuperscriptBox["", "\[Phi]"], 
     SuperscriptBox["", "\[Phi]"]}], "\[Rule]", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"], 
     SuperscriptBox["r", "2"]]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9793380834444313`*^9},
