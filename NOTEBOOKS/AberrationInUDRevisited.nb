Cell[CellGroupData[{

Cell[TextData[{
 "The Christoffel Connection ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", "\[Tau]"], 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d799c75e-6bae-483e-b523-59ce15e28bef"]
}], "Subsection",
 CellChangeTimes->{
  3.976308362575985*^9, {3.976308564836528*^9, 3.976308582840405*^9}, {
   3.976376871939151*^9, 
   3.976376913504778*^9}},ExpressionUUID->"218d7e6b-1653-41e9-99ac-\
ae631c44408d"],

Cell[TextData[{
 "The \[OpenCurlyDoubleQuote]force\[CloseCurlyDoubleQuote] in gravitation \
arises from the non-tensorial connection, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", "\[Tau]"], 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"a7fe66b9-d4fb-40f1-9888-2ee48e58294e"],
 ". "
}], "Text",
 CellChangeTimes->{{3.976376926034861*^9, 3.976377032216123*^9}, {
  3.976377417726636*^9, 3.976377460162353*^9}, {3.976377610453426*^9, 
  3.9763776107768497`*^9}},ExpressionUUID->"160d239a-a013-4b34-a199-\
770ff74adf91"],

Cell[TextData[StyleBox["Aside: Gravitation shares this idea with quantum \
fields, where force bosons come from the connections of gauge fields that \
leave Lagrangians invariant. This similarity is so alluring that physicists \
strongly suspect an underlying unified theory. However, unification has \
resisted all attempts. Various attempts make predictions refuted by \
experiment. Other attempts fail renormalization, and so on. It is an open \
question whether the unification even exists or whether Nature gives us two \
different but similar-looking kinds of force laws (space-time and gauge), \
laughing at our petty struggles to understand.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.976376926034861*^9, 3.976377032216123*^9}, {
  3.976377417726636*^9, 3.9763775079237137`*^9}, {3.976449634898127*^9, 
  3.97644975396916*^9}, {3.9764513272667503`*^9, 3.976451431312574*^9}, {
  3.9765234885882177`*^9, 3.9765235200451593`*^9}, {3.976707506720737*^9, 
  3.976707560717752*^9}},ExpressionUUID->"fd25b5aa-a933-49d7-a79a-\
ffd20df275f2"],

Cell[TextData[{
 "In the weak field limit (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "\[TildeTilde]", 
    RowBox[{
     SubscriptBox["\[Eta]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "+", 
     SubscriptBox["h", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]]}]}], TraditionalForm]],
  CellChangeTimes->{{3.976318398387661*^9, 3.976318448227997*^9}},
  ExpressionUUID->"d078f48d-a271-4f09-aa40-0e5b858077b1"],
 "), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", "\[Tau]"], 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"6e091aa8-3d9e-479b-86f1-f0a69980a516"],
 " is a linear combinations of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PartialD]", "h"}], TraditionalForm]],ExpressionUUID->
  "1bfa1ebd-04c9-4583-93ad-b371db0a4cbe"],
 " gradients: "
}], "Text",
 CellChangeTimes->{
  3.976308362575985*^9, 3.976308566682349*^9, {3.976376171692402*^9, 
   3.97637617959409*^9}, {3.9763776022874413`*^9, 3.9763776268414*^9}, {
   3.976377687412127*^9, 3.976377713150785*^9}, {3.9765235319911118`*^9, 
   3.976523550339569*^9}, {3.976707594781414*^9, 
   3.976707603743514*^9}},ExpressionUUID->"1ec5b37c-18b9-4fe9-977a-\
34ae207ffa1a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", "\[Tau]"], 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "\[TildeTilde]", 
   RowBox[{
    FractionBox["1", "2"], 
    SuperscriptBox["\[Eta]", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Tau]", "\[VeryThinSpace]", "\[Chi]"}]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Mu]"], 
       SubscriptBox["h", 
        RowBox[{"\[Nu]", "\[VeryThinSpace]", "\[Chi]"}]]}], "+", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Nu]"], 
       SubscriptBox["h", 
        RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Chi]"}]]}], "-", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Chi]"], 
       SubscriptBox["h", 
        RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9763776364039907`*^9, 3.976377662737043*^9}, {
  3.976377718594913*^9, 
  3.976377843139291*^9}},ExpressionUUID->"2d096983-07c8-46dc-91f0-\
4c646c656b8d"],

Cell[TextData[{
 "To implement this efficiently in \[ScriptCapitalU]\[ScriptCapitalD], we \
define a helper function to \[OpenCurlyDoubleQuote]instantiate\
\[CloseCurlyDoubleQuote] ",
 StyleBox["metricGradient", "Input"],
 " with specific indices."
}], "Text",
 CellChangeTimes->{
  3.976308362575985*^9, 3.976308566682349*^9, {3.976376171692402*^9, 
   3.97637617959409*^9}, {3.9763776022874413`*^9, 3.97637761563146*^9}, {
   3.976377850016176*^9, 
   3.9763778638682127`*^9}},ExpressionUUID->"bff7fc49-f266-470b-bebf-\
2fb7bbe13f7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"gradH", ",", "\[CapitalGamma]Linear"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.976308377612563*^9, 3.976308377614217*^9}, {
   3.976308597237835*^9, 3.976308677550885*^9}, {3.976308721283277*^9, 
   3.976308904975586*^9}, {3.976309001330008*^9, 3.976309003409586*^9}, {
   3.976309036773983*^9, 3.976309041257915*^9}, {3.9763092069082603`*^9, 
   3.97630934633646*^9}, {3.976309378826654*^9, 3.976309436688509*^9}, {
   3.9763094688982477`*^9, 3.976309495214625*^9}, {3.976309539760462*^9, 
   3.976309578641024*^9}, {3.976309621423224*^9, 3.976309744539186*^9}, 
   3.9763097877737913`*^9, {3.976309838499655*^9, 3.976309869429779*^9}, {
   3.976310045082717*^9, 3.976310049334676*^9}, {3.976310169720414*^9, 
   3.9763101947923517`*^9}, 3.976377915709285*^9},
 CellLabel->"In[30]:=",ExpressionUUID->"35235269-58cd-45a3-94d4-978eeeeed457"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Helper", ":", " ", 
    RowBox[{"instantiate", " ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Rho]"], 
      SubscriptBox["h", "\[Alpha]\[Beta]"]}], " ", "with", " ", "specific", " ",
      "indices"}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gradH", "[", 
      RowBox[{"x\[Gamma]_", ",", "x\[Alpha]_", ",", "x\[Beta]_"}], "]"}], ":=", 
     RowBox[{"metricGradient", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Gamma]", "]"}], "->", 
         "x\[Gamma]"}], ",", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], "->", 
         "x\[Alpha]"}], ",", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "->", 
         "x\[Beta]"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "test", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gradH", "[", 
     RowBox[{
      RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], ",", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Chi]", "]"}]}], "]"}], "/.", 
    "dpyRules"}]}]}]], "Input",
 CellChangeTimes->{{3.976308377612563*^9, 3.976308377614217*^9}, {
   3.976308597237835*^9, 3.976308677550885*^9}, {3.976308721283277*^9, 
   3.976308904975586*^9}, {3.976309001330008*^9, 3.976309003409586*^9}, {
   3.976309036773983*^9, 3.976309041257915*^9}, {3.9763092069082603`*^9, 
   3.97630934633646*^9}, {3.976309378826654*^9, 3.976309436688509*^9}, {
   3.9763094688982477`*^9, 3.976309495214625*^9}, {3.976309539760462*^9, 
   3.976309578641024*^9}, {3.976309621423224*^9, 3.976309744539186*^9}, 
   3.9763097877737913`*^9, {3.976309838499655*^9, 3.976309869429779*^9}, {
   3.976310045082717*^9, 3.976310049334676*^9}, {3.976310169720414*^9, 
   3.976310172248564*^9}, {3.976310205978375*^9, 3.976310246578764*^9}, {
   3.976316151482766*^9, 3.976316154476301*^9}, 3.976376190686822*^9, {
   3.976378743711204*^9, 3.976378753197451*^9}, {3.976380131495521*^9, 
   3.976380155060235*^9}, {3.976523557168831*^9, 3.976523591680592*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"9c770754-4260-4e95-b1d1-52b062cf17f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "leave", " ", "index", " ", "\[Chi]", " ", "free", " ", "for", " ", 
    "later", " ", "contraction"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalGamma]Linear", "[", 
      RowBox[{
       RowBox[{"\[ScriptCapitalU]", "[", "\[Tau]_", "]"}], ",", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], ",", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}]}], "]"}], ":=", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"\[Eta]", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalU]", "[", "\[Tau]", "]"}], ",", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Chi]", "]"}]}], "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gradH", "[", 
         RowBox[{
          RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
          RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], ",", 
          RowBox[{"\[ScriptCapitalD]", "[", "\[Chi]", "]"}]}], "]"}], "+", 
        RowBox[{"gradH", "[", 
         RowBox[{
          RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], ",", 
          RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
          RowBox[{"\[ScriptCapitalD]", "[", "\[Chi]", "]"}]}], "]"}], "-", 
        RowBox[{"gradH", "[", 
         RowBox[{
          RowBox[{"\[ScriptCapitalD]", "[", "\[Chi]", "]"}], ",", 
          RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
          RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}]}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "a", " ", "specific", " ", "instance", " ", "and", " ", 
     "display", " ", "it"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalGamma]Instance", "=", 
     RowBox[{
      RowBox[{"\[CapitalGamma]Linear", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalU]", "[", "\[Tau]", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], "//.", 
      "tensorRules"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[CapitalGamma]Result", "=", 
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{"Expand", "[", "\[CapitalGamma]Instance", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "k"}], "}"}], ",", "FullSimplify"}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Linearized Christoffel connection \
\!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalGamma]\), \(\[Tau]\)], \(\[Mu]\
\[VeryThinSpace]\[Nu]\)]\):\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[CapitalGamma]Result", "//", "FullSimplify"}], ")"}], "/.", 
    " ", "dpyRules"}]}]}]], "Input",
 CellChangeTimes->{{3.976308377612563*^9, 3.976308377614217*^9}, {
   3.976308597237835*^9, 3.976308677550885*^9}, {3.976308721283277*^9, 
   3.976308904975586*^9}, {3.976309001330008*^9, 3.976309003409586*^9}, {
   3.976309036773983*^9, 3.976309041257915*^9}, {3.9763092069082603`*^9, 
   3.97630934633646*^9}, {3.976309378826654*^9, 3.976309436688509*^9}, {
   3.9763094688982477`*^9, 3.976309495214625*^9}, {3.976309539760462*^9, 
   3.976309578641024*^9}, {3.976309621423224*^9, 3.976309744539186*^9}, 
   3.9763097877737913`*^9, {3.976309838499655*^9, 3.976309869429779*^9}, {
   3.976310045082717*^9, 3.976310049334676*^9}, {3.976310169720414*^9, 
   3.976310172248564*^9}, {3.976310205978375*^9, 3.976310211312168*^9}, {
   3.976315946671213*^9, 3.976315962336356*^9}, 3.9763161917291193`*^9, {
   3.976316246755641*^9, 3.976316277602727*^9}, {3.976406590655932*^9, 
   3.976406631021105*^9}, {3.976407023145751*^9, 3.97640703506327*^9}, 
   3.976451474079493*^9, {3.976523623541772*^9, 3.976523678743029*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"ed64797a-2906-428e-af1f-507a3506079c"],

Cell[CellGroupData[{

Cell["Intuitions", "Subsubsection",
 CellChangeTimes->{{3.976406875567185*^9, 
  3.976406877380052*^9}},ExpressionUUID->"bd790391-13a8-4ed8-a718-\
3bfb8cc0b117"],

Cell[TextData[{
 "\[CapitalGamma] encapsulates effects we can intuit as forces. The Geodesic \
Equation for a test particle with 4\[NoBreak]-\[NoBreak]velocity ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["v", 
    RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "13e84cbd-6a7a-49d0-aef9-cc368395b777"],
 " gives the equation of motion:"
}], "Text",
 CellChangeTimes->{{3.976406802620414*^9, 3.976406825856605*^9}, {
  3.976406890263914*^9, 3.9764069416299877`*^9}, {3.976523699218315*^9, 
  3.976523723163568*^9}},ExpressionUUID->"9c348e9c-7c2f-4e17-84a7-\
1872eed7fb30"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["v", "\[Chi]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}]], "=", 
   RowBox[{
    RowBox[{"-", 
     SubscriptBox[
      SuperscriptBox["\[CapitalGamma]", "\[Chi]"], 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]]}], 
    SuperscriptBox["v", "\[Mu]"], 
    SuperscriptBox["v", "\[Nu]"]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.976406945962009*^9, 3.976407010297072*^9}, {
  3.976407046718092*^9, 
  3.9764070849931173`*^9}},ExpressionUUID->"ac23f105-1c4e-4a46-9138-\
bdd79231619e"],

Cell[TextData[{
 "which resembles Newtonian ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "=", 
    RowBox[{"m", "\[VeryThinSpace]", "a"}]}], TraditionalForm]],
  ExpressionUUID->"80d56a3d-9519-463f-97da-0ca1485378d8"],
 ", with ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "e7bd4a7b-e811-4695-9887-bb3a7fee9150"],
 " as ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["v", "\[Chi]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}]], TraditionalForm]],
  CellChangeTimes->{{3.976406945962009*^9, 3.976407010297072*^9}, {
   3.976407046718092*^9, 3.9764070849931173`*^9}},ExpressionUUID->
  "0676c026-e619-4b91-97bc-6c328b041458"],
 " and the negative gradient of some velocity-dependent potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    RowBox[{"\[Del]", "\[CapitalPhi]"}]}], TraditionalForm]],ExpressionUUID->
  "23d5018d-6e7d-4ce1-9630-0b925dcc6414"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubscriptBox[
      SuperscriptBox["\[CapitalGamma]", "\[Chi]"], 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]]}], 
    SuperscriptBox["v", "\[Mu]"], 
    SuperscriptBox["v", "\[Nu]"]}], TraditionalForm]],
  CellChangeTimes->{{3.976406945962009*^9, 3.976407010297072*^9}, {
   3.976407046718092*^9, 3.9764070849931173`*^9}},ExpressionUUID->
  "c16c47ab-5b79-4d9d-94f9-423de2e7c882"],
 ". The terms in \[CapitalGamma] that scale as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox["r", "2"]}], TraditionalForm]],ExpressionUUID->
  "a01d1485-0479-4537-aa7c-e344d6061a8b"],
 ", namely the first term (",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c7607c99-e17f-4113-9a7f-1d8c639a117f"],
 " in the numerator cancels ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fe790b31-e0ed-4ff4-9e1e-9b985c9758b4"],
 " to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c4094534-6de9-4a20-b117-029c8b5eb1d0"],
 " in the denominator), represent the gravitational pull from the \
Coulomb-like part of the metric gradient. The \
\[OpenCurlyDoubleQuote]Doppler-like\[CloseCurlyDoubleQuote] factor in the \
second term ensures that the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox["r", "2"]}], TraditionalForm]],ExpressionUUID->
  "6c075274-37d5-4964-b3c9-3cdaf46fd69c"],
 " \[OpenCurlyDoubleQuote]force\[CloseCurlyDoubleQuote] points to the \
instantaneous position of the source!"
}], "Text",
 CellChangeTimes->{{3.9764071076875343`*^9, 3.976407308561304*^9}, {
  3.976523742606531*^9, 3.9765238486899977`*^9}, {3.9767076543250504`*^9, 
  3.9767076848932247`*^9}},ExpressionUUID->"faecb325-573c-438c-9833-\
ba68eba0d672"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The Riemann Curvature Tensor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["R", "\[Rho]\[Tau]\[Mu]\[Nu]"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cf506bdc-ac05-48cd-9f01-b09d6eb09259"]
}], "Subsection",
 CellChangeTimes->{{3.976309919471038*^9, 3.976309927016775*^9}, {
  3.9764073388130836`*^9, 
  3.976407363278099*^9}},ExpressionUUID->"4ef3ddc4-0feb-45d8-a215-\
5f462cc2371b"],

Cell[TextData[{
 "In the linearized approximation, the Riemann tensor is the curl of the \
Christoffel connection, or the double gradient of ",
 Cell[BoxData[
  FormBox["h", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2ea926d8-861d-4b87-829a-5d64e0223281"],
 ". "
}], "Text",
 CellChangeTimes->{{3.976309919471038*^9, 3.9763099289156303`*^9}, {
  3.9763762029186*^9, 3.976376225018173*^9}, {3.97640737514485*^9, 
  3.976407396183547*^9}, {3.9765238592330647`*^9, 
  3.976523860596987*^9}},ExpressionUUID->"f101c32c-5c2b-42d7-af62-\
93653ee99ada"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["R", 
    RowBox[{"\[Rho]\[Sigma]\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "\[TildeTilde]", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Sigma]"], 
       RowBox[{
        SubscriptBox["\[PartialD]", "\[Mu]"], 
        SubscriptBox["h", "\[Rho]\[Nu]"]}]}], "+", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Rho]"], 
       RowBox[{
        SubscriptBox["\[PartialD]", "\[Nu]"], 
        SubscriptBox["h", "\[Sigma]\[Mu]"]}]}], "-", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Sigma]"], 
       RowBox[{
        SubscriptBox["\[PartialD]", "\[Nu]"], 
        SubscriptBox["h", 
         RowBox[{"\[Rho]", "\[VeryThinSpace]", "\[Mu]"}]]}]}], "-", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Rho]"], 
       RowBox[{
        SubscriptBox["\[PartialD]", "\[Mu]"], 
        SubscriptBox["h", "\[Sigma]\[Nu]"]}]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.976407400619911*^9, 3.976407550999305*^9}, {
  3.976407834602461*^9, 
  3.9764078356774597`*^9}},ExpressionUUID->"a23faf2d-a6f0-46bf-9060-\
2c714ec80396"],

Cell[TextData[{
 "Define a second-derivative helper, ",
 StyleBox["doubleGradH", "Input"],
 ", and differentiate ",
 StyleBox["metricGradient", "Input"],
 " again."
}], "Text",
 CellChangeTimes->{{3.976309919471038*^9, 3.9763099289156303`*^9}, {
  3.9763762029186*^9, 3.976376225018173*^9}, {3.97640737514485*^9, 
  3.976407380782301*^9}, {3.976407588404752*^9, 3.97640762871202*^9}, {
  3.976707725781642*^9, 
  3.976707733297057*^9}},ExpressionUUID->"859461d3-8382-4801-9f83-\
5bea54d86dea"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"doubleGradH", ",", "RiemannLinear"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Acceleration", " ", "->", " ", 
    RowBox[{"0", " ", "for", " ", "this", " ", "model"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fourGrad", "[", 
     RowBox[{
      RowBox[{"d\[Lambda]ds", "[", "ud_", "]"}], ",", "_"}], "]"}], ":=", 
    "0"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"doubleGradH", "[", 
     RowBox[{"\[Sigma]_", ",", "\[Rho]_", ",", "\[Alpha]_", ",", "\[Beta]_"}],
      "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "firstDeriv", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Instantiate", " ", "the", " ", "first", " ", "derivative", " ", 
        "with", " ", "correct", " ", "indices"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"firstDeriv", "=", 
        RowBox[{"gradH", "[", 
         RowBox[{"\[Rho]", ",", "\[Alpha]", ",", "\[Beta]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Differentiate", " ", 
         RowBox[{"w", ".", "r", ".", "t"}], " ", "\[Sigma]"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"fourGrad", "[", 
         RowBox[{"firstDeriv", ",", "\[Sigma]"}], "]"}], "//.", 
        "tensorRules"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"RiemannLinear", "[", 
     RowBox[{
      RowBox[{"\[ScriptCapitalD]", "[", "\[Rho]_", "]"}], ",", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Sigma]_", "]"}], ",", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], ",", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"doubleGradH", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Sigma]", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Rho]", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], 
       "\[IndentingNewLine]", "+", 
       RowBox[{"doubleGradH", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Rho]", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Sigma]", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}]}], "]"}], 
       "\[IndentingNewLine]", "-", 
       RowBox[{"doubleGradH", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Sigma]", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Rho]", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}]}], "]"}], 
       "\[IndentingNewLine]", "-", 
       RowBox[{"doubleGradH", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Rho]", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Sigma]", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}]}], 
      ")"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RiemannRaw", "=", 
   RowBox[{"RiemannLinear", "[", 
    RowBox[{
     RowBox[{"\[ScriptCapitalD]", "[", "\[Rho]", "]"}], ",", 
     RowBox[{"\[ScriptCapitalD]", "[", "\[Sigma]", "]"}], ",", 
     RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
     RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RiemannTensor", "=", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{"Expand", "[", "RiemannRaw", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "k"}], "}"}], ",", "FullSimplify"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Riemann \!\(\*SubscriptBox[\(R\), \(\[Rho]\[Sigma]\[Mu]\
\[VeryThinSpace]\[Nu]\)]\) tensor (component extraction in the next section\>\
\"", "]"}], ";"}], "\n", 
 RowBox[{"RiemannTensor", "/.", "dpyRules"}]}], "Input",
 CellChangeTimes->{{3.976309944589417*^9, 3.976309944590806*^9}, {
  3.9763163331113043`*^9, 3.976316562527309*^9}, {3.976316997713689*^9, 
  3.9763170031401777`*^9}, {3.9763170598607273`*^9, 3.9763170861368647`*^9}, {
  3.9764076386862907`*^9, 3.976407646733474*^9}, {3.976407705545939*^9, 
  3.97640779140976*^9}, {3.976451561767009*^9, 3.976451626632815*^9}, {
  3.976523875185104*^9, 3.9765238771225348`*^9}, {3.9765239230506487`*^9, 
  3.976523948349292*^9}, {3.976524037851138*^9, 3.976524046496093*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"9452fa10-8e00-477c-99f2-1306fcba8161"],

Cell[CellGroupData[{

Cell["Intuitions", "Subsubsection",
 CellChangeTimes->{{3.976408451291256*^9, 
  3.9764084650746517`*^9}},ExpressionUUID->"13b97edf-6ca0-4fb4-a915-\
1794ab4517cb"],

Cell[TextData[{
 "The raw output for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    RowBox[{"\[Rho]\[Sigma]\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], 
   TraditionalForm]],
  CellChangeTimes->{{3.976407400619911*^9, 3.976407550999305*^9}, {
   3.976407834602461*^9, 3.9764078356774597`*^9}},ExpressionUUID->
  "c19399e7-146f-4623-8837-0d3b92ccf69a"],
 " above is a formidable \[OpenCurlyDoubleQuote]wall of math\
\[CloseCurlyDoubleQuote] comprising dozens of terms scaling from ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", 
    RowBox[{"-", "2"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "837bcc71-eaa6-40b5-87c0-d1a5b29e5fc2"],
 " down to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", 
    RowBox[{"-", "5"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c2744adb-cd8d-4a4d-aabb-8e865b9ce995"],
 ". You might find this alarming. However, ",
 StyleBox["this verbosity is not a bug, it\[CloseCurlyQuote]s a feature",
  FontWeight->"Bold"],
 " and primary virtue of \[ScriptCapitalU]\[ScriptCapitalD]."
}], "Text",
 CellChangeTimes->{
  3.976408531825014*^9, {3.976408585233749*^9, 3.976408703344245*^9}, {
   3.976408863197585*^9, 3.976408864345812*^9}, 3.976451652420381*^9, {
   3.976451735561101*^9, 3.976451743522533*^9}, {3.976523974770527*^9, 
   3.976523975101437*^9}},ExpressionUUID->"d29630a6-0501-4235-aa18-\
5d5d4b138d8c"],

Cell["\<\
In a manual calculation, a physicist would usually discard higher-order terms \
and exploit symmetries in intermediate steps to keep the expressions \
manageable. While elegant, that process is perilous; a single dropped index \
or misplaced sign propagates errors that are extremely expensive to trace or \
redo. By contrast, Wolfram\[CloseCurlyQuote]s symbolic engine is \
syntactically rigid. It does not simplify until told to do so, and it does \
not make algebraic mistakes. The \[OpenCurlyDoubleQuote]wall of math\
\[CloseCurlyDoubleQuote] is assurance that every interaction\[LongDash]every \
chain rule and every suitable contraction\[LongDash]is applied.\
\>", "Text",
 CellChangeTimes->{
  3.976408531825014*^9, {3.976408585233749*^9, 3.976408803424974*^9}, {
   3.976451759265255*^9, 3.97645179115335*^9}, {3.976524019925776*^9, 
   3.976524020556508*^9}, {3.9765240775402813`*^9, 3.976524087984445*^9}, {
   3.976524314351377*^9, 3.976524351233073*^9}, {3.97670776688195*^9, 
   3.976707768930134*^9}},ExpressionUUID->"241b8ebe-42a8-4fe0-acfa-\
e0313a606e4c"],

Cell[TextData[StyleBox["I have first-hand experience with this, leading me to \
cherish an ancestor of Mathematica. My first job out of school in the early \
80\[CloseCurlyQuote]s was to check the math for relativistic clock \
corrections in GPS signals, long before such was routine and automated. I \
recall doing page after page of algebra, only to fail a sign or index check \
at the end, then failing to find the bug on backtracking, and ending up \
starting over from scratch, multiple times. This very project caused me to \
seek out Stephen Wolfram, then at Caltech Physics, and get a copy of SMP from \
him to check those calculations. Without SMP, I would have had little \
confidence in my final results and would have felt irresponsible. Of course, \
SMP eventually became Mathematica, which became Wolfram, and here we are some \
45 years later. I have used it every day for all kinds of tasks, including \
designing C code, since long before it was a commercial product.", "Item"]], \
"Item",
 CellChangeTimes->{{3.976449086797675*^9, 3.9764491578865643`*^9}, {
   3.9764518180355577`*^9, 3.976451891686057*^9}, {3.9764519262366447`*^9, 
   3.976451960578751*^9}, {3.976524101840035*^9, 3.976524106674533*^9}, {
   3.9765241626274433`*^9, 3.9765241709792423`*^9}, 3.97670778960859*^9, {
   3.976707828115987*^9, 3.976707838666717*^9}},
 FontSlant->"Italic",ExpressionUUID->"78e1a898-2896-42f1-91c0-a94b1364c3ff"],

Cell[TextData[{
 "We can trust this result ",
 StyleBox["not",
  FontSlant->"Italic"],
 " because the output is pretty or ugly or anything else, but because the \
process is robust. The same ",
 StyleBox["fourGrad", "Input"],
 " and ",
 StyleBox["tensorRules", "Input"],
 " that successfully reproduced the Li\[EAcute]nard-Wiechert fields in \
electrodynamics apply here without modification."
}], "Text",
 CellChangeTimes->{
  3.976408531825014*^9, {3.976408585233749*^9, 3.976408853614354*^9}, {
   3.97645202096327*^9, 3.9764520358409367`*^9}, {3.976524182857685*^9, 
   3.976524197284234*^9}, 3.976544512378778*^9, {3.9767078481201887`*^9, 
   3.976707848586907*^9}},ExpressionUUID->"561cbaee-0959-416a-a3bf-\
6ff384f96b94"],

Cell[TextData[{
 "Therefore, we do not need to read the raw tensor. Just as we write software \
to visualize large datasets, we write a symbolic \
\[OpenCurlyDoubleQuote]Component Inspector\[CloseCurlyDoubleQuote] in the \
next section to probe this result. By projecting ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    RowBox[{"\[Rho]\[Sigma]\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], 
   TraditionalForm]],
  CellChangeTimes->{{3.976407400619911*^9, 3.976407550999305*^9}, {
   3.976407834602461*^9, 3.9764078356774597`*^9}},ExpressionUUID->
  "bf3f9dba-88de-4ede-9a9e-80d174222dfe"],
 " onto specific physical vectors, we will demonstrate that it collapses \
neatly into recognizable predictions of General Relativity."
}], "Text",
 CellChangeTimes->{
  3.976408531825014*^9, {3.976408585233749*^9, 3.976408855622974*^9}, {
   3.9764520637989187`*^9, 3.976452089543735*^9}, {3.9765242076970043`*^9, 
   3.976524234407428*^9}, {3.976707863726618*^9, 
   3.976707864188115*^9}},ExpressionUUID->"d8fbe254-ecf1-49f2-901b-\
b955c02081e3"],

Cell["\<\
That said, the big-picture structure is exactly what a relativist hopes to \
see:\
\>", "Text",
 CellChangeTimes->{
  3.976408556676867*^9, {3.976408896838912*^9, 
   3.976408927307686*^9}},ExpressionUUID->"178acd84-e434-4498-a7ee-\
156d0a1f6c5c"],

Cell[TextData[{
 "The Peeling Property",
 ": The terms sort themselves into powers of r. You clearly see the radiative \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "r"}], TraditionalForm]],ExpressionUUID->
  "dffc0edd-dade-49a7-a722-6e85a39f3328"],
 " terms (top line), the Coulomb/static ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", 
    RowBox[{"-", "2"}]], TraditionalForm]],ExpressionUUID->
  "9cf899a9-37fd-425f-943a-9ac6efb37f99"],
 " terms, the near-field ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", 
    RowBox[{"-", "3"}]], TraditionalForm]],ExpressionUUID->
  "0c61da2b-c705-4773-8ab5-d494503602ca"],
 " etc. terms. "
}], "Item",
 CellChangeTimes->{
  3.976408556676867*^9, {3.976408896838912*^9, 3.976408931328106*^9}, {
   3.976452103697983*^9, 3.9764521524938517`*^9}, {3.9765242640320053`*^9, 
   3.976524264495637*^9}, 
   3.976544523197838*^9},ExpressionUUID->"663fd0ed-8f5f-462b-a7f1-\
b46310a1a7f6"],

Cell[TextData[{
 "Evaluation Completeness: There are no \[OpenCurlyDoubleQuote]blue,\
\[CloseCurlyDoubleQuote] unevaluated symbols or calls of ",
 StyleBox["fourGrad", "Input"],
 ". Every single term has been reduced to the fundamental physical variables: \
",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a6c03dcf-f2c4-4c4f-9946-0f9c3029c83b"],
 ", ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e1828708-2d91-40d8-88d2-26bbe039ec48"],
 ", ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "67b3f7da-f542-48d6-be71-d32d3c0dfa31"],
 ", ",
 Cell[BoxData[
  FormBox["\[Eta]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9d9de084-172a-432a-8d91-b7b52a48228a"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Lambda]", "/", "ds"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b99fcfe9-abe4-4416-a949-2f5d406e3df9"],
 "."
}], "Item",
 CellChangeTimes->{
  3.976408556676867*^9, {3.976408896838912*^9, 3.976408939578844*^9}, {
   3.976452170677514*^9, 3.9764521958030167`*^9}, {3.976524281147764*^9, 
   3.976524297030198*^9}},ExpressionUUID->"4d75cc35-0222-4d3b-ae12-\
10f1e44ed5b9"],

Cell[TextData[{
 "The Doppler Signature: The ubiquitous presence of the Doppler-like factor \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    RowBox[{
     FractionBox[
      RowBox[{"d", "\[VeryThinSpace]", 
       SuperscriptBox["\[Lambda]", "\[Rho]"]}], 
      RowBox[{"d", "\[VeryThinSpace]", "s"}]], 
     SubscriptBox["\[Sigma]", "\[Rho]"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40e72e8c-a6aa-46f7-8c3d-13ebdea6b35f"],
 " confirms that the retardation effects have been propagated through the \
second derivative."
}], "Item",
 CellChangeTimes->{
  3.976408556676867*^9, {3.976408896838912*^9, 3.9764089359470453`*^9}, {
   3.976452266295361*^9, 3.9764522735399647`*^9}, {3.9765243625471687`*^9, 
   3.976524362726616*^9}},ExpressionUUID->"53cd219b-8541-4508-ba42-\
dd765f4db9c9"]
}, Open  ]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Verification: The Component Inspector", "Section",
 CellChangeTimes->{{3.976309974560424*^9, 
  3.976309983366247*^9}},ExpressionUUID->"8a838f09-1274-4117-826d-\
abbbbe2b06aa"],

Cell["\<\
Finally, we apply the following \[OpenCurlyDoubleQuote]Component Inspector\
\[CloseCurlyDoubleQuote] logic. We check the Newtonian limit (tidal tensor) \
and the radiation term.\
\>", "Text",
 CellChangeTimes->{{3.976309974560424*^9, 3.976309979404787*^9}, {
  3.976452287844987*^9, 3.976452301182411*^9}, {3.97652437316206*^9, 
  3.976524383797452*^9}},ExpressionUUID->"109c9b05-a52b-4c6b-b812-\
78d911c7637e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"NEWTONIAN", " ", "TIDAL", " ", "LIMIT", " ", 
    RowBox[{"(", 
     RowBox[{"a", " ", "->", " ", "0"}], ")"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"tidal", " ", "tensor", " ", 
     SubscriptBox["E", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]]}], "=", 
    RowBox[{
     SubscriptBox["R", "\[Mu]\[Alpha]\[Nu]\[Beta]"], 
     SuperscriptBox["\[Lambda]", "\[Alpha]\[Beta]"]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n--- TEST 1: Newtonian Tidal Limit (a \[Rule] 0) ---\
\>\"", "]"}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Project", " ", "onto", " ", "velocity", " ", "\[Lambda]"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tidalRaw", "=", 
     RowBox[{"RiemannTensor", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Rho]", "]"}], "->", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}]}], ",", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Sigma]", "]"}], "->", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]", "]"}]}], ",", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], "->", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], ",", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "->", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Beta]", "]"}]}]}], "}"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Contract", " ", "with", " ", 
     SuperscriptBox["\[Lambda]", "\[Alpha]\[Beta]"]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"tidalContraction", "=", 
     RowBox[{
      RowBox[{"tidalRaw", " ", "*", 
       RowBox[{"\[Lambda]", "[", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Alpha]", "]"}], "]"}], 
       RowBox[{"\[Lambda]", "[", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Beta]", "]"}], "]"}]}], "//.", 
      "tensorRules"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Limit", ":", "Acceleration"}], " ", "->", " ", "0"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"newtonianLimit", "=", 
     RowBox[{"tidalContraction", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"d\[Lambda]ds", "[", "_", "]"}], "->", "0"}], "}"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"newtonianLimit", "=", 
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{"newtonianLimit", "//", "FullSimplify"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "k"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Tidal Tensor \!\(\*SubscriptBox[\(E\), \(\[Mu]\
\[VeryThinSpace]\[Nu]\)]\) (Static Limit):\>\"", "]"}], ";"}], "\n", 
   RowBox[{"newtonianLimit", "/.", " ", "dpyRules"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"RADIATION", " ", "CHECK", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", "/", "r"}], " ", "Term"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n--- TEST 2: Gravitational radiation rerm \
(1/\!\(\*SuperscriptBox[\(r\), \(2\)]\)) ---\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "coefficient", " ", "of", " ", 
     RowBox[{"1", "/", 
      SuperscriptBox["r", "2"]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radTerm", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{"RiemannTensor", ",", "r", ",", 
       RowBox[{"-", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"radTerm", "===", "0"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<FAILED: No radiation term found.\>\"", "]"}],
       ",", "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", "\"\<PASSED: Radiation term detected. Leading terms \
shown:\>\"", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "snippet"}], "*)"}], "\n", 
   RowBox[{"Short", "[", 
    RowBox[{
     RowBox[{"radTerm", "/.", " ", "dpyRules"}], ",", "5"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.976309991279104*^9, 3.976309991281419*^9}, {
  3.976317299303207*^9, 3.976317496786137*^9}, {3.976452320507843*^9, 
  3.976452354845813*^9}, {3.9764523925920277`*^9, 3.976452464385131*^9}, {
  3.976452730287177*^9, 3.9764528639594307`*^9}, {3.976453506587123*^9, 
  3.976453517797229*^9}, {3.976524389423896*^9, 3.976524515448359*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"d9bbb2c0-3c3d-4f48-a054-0bb777670949"],

Cell[CellGroupData[{

Cell["Intuitions", "Subsection",
 CellChangeTimes->{{3.976452883656474*^9, 
  3.9764528857336617`*^9}},ExpressionUUID->"3369738f-9c77-4e39-9253-\
c0e70b226158"],

Cell["The Newtonian Tidal Limit contains two distinct scalings:", "Text",
 CellChangeTimes->{{3.9764528953374853`*^9, 
  3.976452937150132*^9}},ExpressionUUID->"fd4cd774-10dc-4469-84ab-\
ec7acf441681"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["E", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "\[Tilde]", 
   RowBox[{
    FractionBox["A", 
     SuperscriptBox["r", "3"]], "+", 
    FractionBox["B", 
     SuperscriptBox["r", "5"]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.976452939747059*^9, 
  3.976452992529051*^9}},ExpressionUUID->"74bdda31-8eb2-4ff7-b1e0-\
1247679d616c"],

Cell[TextData[{
 "This is the signature of the tidal tensor\[LongDash]the gradient of the \
gravitational force. The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox["r", "3"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d21ebb24-d454-4ac6-a401-ec847f778612"],
 " term is the trace part and the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox["r", "5"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "72abe0ac-99aa-4e18-8bf6-025e6ee7adb7"],
 " term is the traceless quadrupole part. In Newtonian gravitation, the tidal \
tensor is "
}], "Text",
 CellChangeTimes->{{3.9764530384136*^9, 
  3.9764531870603437`*^9}},ExpressionUUID->"64aeb6f8-3427-48f0-94ca-\
d141af467a6d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "i"], 
    RowBox[{
     SubscriptBox["\[PartialD]", "j"], 
     RowBox[{"(", 
      FractionBox["1", "r"], ")"}]}]}], "\[Tilde]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", 
       SubscriptBox["x", "i"], 
       SubscriptBox["x", "j"]}], "-", 
      RowBox[{
       SuperscriptBox["r", "2"], 
       SubscriptBox["\[Delta]", 
        RowBox[{"i", "\[VeryThinSpace]", "j"}]]}]}], ")"}], "/", 
    SuperscriptBox["r", "5"]}]}], TraditionalForm]], "DisplayFormulaNumbered",\

 CellChangeTimes->{{3.976453192957211*^9, 
  3.976453313119389*^9}},ExpressionUUID->"2cc8cd1a-f0f7-4425-b4d1-\
805e93bb4378"],

Cell[TextData[{
 "See that the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", 
    SubscriptBox["x", "i"], 
    RowBox[{
     SubscriptBox["x", "j"], "/", 
     SuperscriptBox["r", "5"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "76c02363-72a5-4443-a7f3-12d0c4de568e"],
 " scales as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox["r", "3"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6a66a053-36f3-4f46-8123-571f050f2d9e"],
 ". The fact that \[ScriptCapitalU]\[ScriptCapitalD] found the relativistic \
version of this behavior after blindly differentiating ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "r"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8839651c-2a42-4e33-92af-cac0388686f5"],
 " twice is confirmation that \[ScriptCapitalU]\[ScriptCapitalD] finds the \
right geometry in the thicket of indices."
}], "Text",
 CellChangeTimes->{{3.97645334189592*^9, 3.9764534251499853`*^9}, {
  3.976524554515353*^9, 
  3.9765245919374113`*^9}},ExpressionUUID->"ce9d9ed6-d8c7-4bbb-aedc-\
32cac9b41bf7"],

Cell[TextData[{
 "The radiation term, scaling as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox["r", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ca45c9d8-031d-4053-8848-17c5e6a9f81b"],
 ", is proportional to acceleration ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "\[VeryThinSpace]", 
    RowBox[{"\[Lambda]", "/", "d"}], "\[VeryThinSpace]", "s"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0b3e506f-1169-4552-a9c9-d545d22102b1"],
 ". This is unlike the electrodynamical radiation terms, which fall as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "r"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "02ded46e-7957-4323-8ee0-430547b4be5d"],
 ". However, it shows that the aberration effect is sensitive not only to \
velocity, as with  electrodynamics, but to acceleration as well. "
}], "Text",
 CellChangeTimes->{{3.976453545559001*^9, 3.976453658917553*^9}, {
  3.976453690633459*^9, 3.976453834176189*^9}, {3.976454747636318*^9, 
  3.97645474969486*^9}},ExpressionUUID->"0b261143-dfce-46fa-b892-\
728f9f91e3cb"],

Cell[TextData[{
 "Finally, structures like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"d", "\[VeryThinSpace]", "\[Lambda]"}], 
      RowBox[{"d", "\[VeryThinSpace]", "s"}]], "\[Eta]"}], "..."}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "10952143-a9c0-4e6a-9ae4-5cc87f7cb3af"],
 " signal coupling between the acceleration vector and the space-time metric, \
\[Eta]. This is the signature of a transverse gravitational wave."
}], "Text",
 CellChangeTimes->{{3.976453765506763*^9, 3.976453766675088*^9}, {
  3.9764538450383787`*^9, 
  3.97645392597359*^9}},ExpressionUUID->"66b5a970-0c0f-4782-bb1d-\
e1d6bcb568c2"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Conclusion", "Section",
 CellChangeTimes->{
  3.97631001620195*^9, {3.976453993939048*^9, 
   3.976454003277972*^9}},ExpressionUUID->"f5f1d71d-b656-4ee2-8af3-\
ae7e7f9d5b35"],

Cell["\<\
We have extended the \[ScriptCapitalU]\[ScriptCapitalD] (up-down) calculus \
from electrodynamics to general relativity. By formalizing index valence and \
implementing differentiation rules for retarded quantities, we have overlaid \
a tensorial symbolic engine on top of Wolfram. We showed how to derive a \
linearized Riemann tensor from first principles in \[ScriptCapitalU]\
\[ScriptCapitalD].\
\>", "Text",
 CellChangeTimes->{
  3.97631001620195*^9, {3.976453993939048*^9, 3.976454097820347*^9}, 
   3.976454574826397*^9, {3.976524628891753*^9, 3.97652464765164*^9}, {
   3.97670791348311*^9, 
   3.976707927111232*^9}},ExpressionUUID->"a63ec61f-abd9-4139-bb1c-\
a08ae96b64d0"],

Cell[TextData[{
 "\[ScriptCapitalU]\[ScriptCapitalD] overcomes the primary hurdle of manual \
relativistic calculations\[LongDash]\[OpenCurlyDoubleQuote]index explosion\
\[CloseCurlyDoubleQuote]. It handles differentiation of the retarded distance \
",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "ed3467a7-d86d-4206-a45e-fa1fde538195"],
 "\:200b, correctly resolving the peeling structure of the gravitational \
field into its Coulomb and radiative components."
}], "Text",
 CellChangeTimes->{
  3.97631001620195*^9, {3.976453993939048*^9, 3.976454180796112*^9}, {
   3.976524662937725*^9, 
   3.9765246644023113`*^9}},ExpressionUUID->"c3824762-deee-421e-9a48-\
6778098c71cc"],

Cell[TextData[{
 "\[ScriptCapitalU]\[ScriptCapitalD] is by now a proof-of-concept for a \
full-featured embedded tensor compiler on top of the Wolfram Language. Future \
work on the physics end will extend this framework to full non-linear General \
Relativity, where the metric ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Eta]", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Vee]"}]], TraditionalForm]],
  ExpressionUUID->"e6ac367f-cace-45ac-9e56-7a58dfc35576"],
 "\:200b is replaced by the dynamic metric ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"7164f3ba-81f7-4112-87d8-6d6f79e1281c"],
 "\:200b, letting us symbolically derive, for instance, Carlip\
\[CloseCurlyQuote]s rendition of the Kinnersley metric, or the exact \
Schwarzschild and Kerr solutions. On the compiler end, alpha-renaming and \
index coalescing should completely eliminate the remaining, nagging manual \
interventions to prevent name collisions."
}], "Text",
 CellChangeTimes->{
  3.97631001620195*^9, {3.976453993939048*^9, 3.9764543336263866`*^9}, {
   3.9764547642328157`*^9, 3.976454764731059*^9}, {3.976524683165557*^9, 
   3.976524685762677*^9}, {3.97652487502634*^9, 3.976524881091387*^9}, {
   3.976707945939047*^9, 
   3.976707996004768*^9}},ExpressionUUID->"7dd01ab7-aad2-4fc6-96f6-\
690812fc53bb"]
}, Closed]],

