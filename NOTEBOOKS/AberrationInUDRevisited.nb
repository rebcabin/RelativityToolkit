Cell[CellGroupData[{

Cell["The Physics", "Section",
 CellChangeTimes->{{3.9763740697092457`*^9, 
  3.976374072383339*^9}},ExpressionUUID->"d8823bc1-c3f4-4171-bf9c-\
768097e51e29"],

Cell[CellGroupData[{

Cell[TextData[{
 "The Metric Perturbation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"4fec011d-7211-44e3-aeb0-241dab4b0310"]
}], "Subsection",
 CellChangeTimes->{{3.9763183048928137`*^9, 
  3.97631833987549*^9}},ExpressionUUID->"7ac816f5-9d42-46f0-9066-\
62f7bc43a430"],

Cell[TextData[{
 "In the weak-field approximation (linearized gravity), the metric ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"bc34d4ae-9ddf-4cbf-8994-3df303c00be8"],
 " is the Minkowski metric ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Eta]", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"e65606a7-9ed2-49f2-9402-8fe9f843df4f"],
 " plus a small perturbation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ffbaf0b7-e0d5-45e2-873e-a410d35ecc83"],
 ":"
}], "Text",
 CellChangeTimes->{{3.976318126536161*^9, 3.976318145674673*^9}, {
  3.976318324968709*^9, 3.976318392098468*^9}, {3.976374012944892*^9, 
  3.976374017198011*^9}, {3.976449430180409*^9, 3.976449435725156*^9}, {
  3.976522938201899*^9, 
  3.976522939100395*^9}},ExpressionUUID->"5ebfe45f-4b59-46e3-8180-\
df67ce5b943f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["g", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "\[TildeTilde]", 
   RowBox[{
    SubscriptBox["\[Eta]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "+", 
    SubscriptBox["h", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.976318398387661*^9, 
  3.976318448227997*^9}},ExpressionUUID->"9a67e4df-d91c-4367-b034-\
f288a4426193"],

Cell[TextData[{
 "For a point mass ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "76d31bbc-1ba4-410b-b455-cd60c761b8e8"],
 " moving with 4\[NoBreak]-\[NoBreak]velocity ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "34696713-1b34-4ac8-a5bf-55b78f9208a8"],
 ", the metric perturbation is the direct gravitational analog of the \
electrodynamical Li\[EAcute]nard-Wiechert potential. "
}], "Text",
 CellChangeTimes->{{3.976318487039044*^9, 3.976318549743784*^9}, {
  3.976375100248762*^9, 3.976375108115966*^9}, {3.9767071697914762`*^9, 
  3.976707222690292*^9}, {3.97670729995557*^9, 
  3.9767073394480743`*^9}},ExpressionUUID->"50bc8a9f-ddef-4f0a-8708-\
69480aa0767c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["h", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"4", "G", " ", "M"}], "r"], 
    SubscriptBox["\[Lambda]", "\[Mu]"], 
    SubscriptBox["\[Lambda]", "\[Nu]"]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.976318555619935*^9, 3.976318609564765*^9}, {
  3.9763186575948677`*^9, 
  3.976318657974804*^9}},ExpressionUUID->"f5105efa-f07c-4416-a319-\
e4000cf96bf9"],

Cell[TextData[{
 StyleBox["Note this is ", "Item",
  FontSlant->"Italic"],
 StyleBox["not", "Item"],
 StyleBox[" Carlip\[CloseCurlyQuote]s Equation 2.1, which is the Kinnersley \
metric for the photon rocket-problem. That problem has similar outcome to the \
outcome of this paper, as we may show in a future notebook.", "Item",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{
  3.976707354052362*^9},ExpressionUUID->"21fe32b2-5e2a-4f27-9639-\
8523e48d7c80"],

Cell[TextData[{
 "In \[ScriptCapitalU]\[ScriptCapitalD], we capture the constant factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"4", "G", " ", "M"}], "\[Congruent]", "k"}], TraditionalForm]],
  ExpressionUUID->"fde8bb9a-e389-478b-953c-7b22bfb5fa3a"],
 " as a symbolic constant ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "6b190eb8-e2b1-4655-9c58-6f623d574a51"],
 " without a value, and write"
}], "Text",
 CellChangeTimes->{{3.9763186265498*^9, 3.976318678376561*^9}, {
  3.97631878142759*^9, 3.976318784307719*^9}, {3.976375113970159*^9, 
  3.9763751456554213`*^9}, {3.976405342223383*^9, 3.976405344126519*^9}, {
  3.976522964313471*^9, 
  3.9765229684183187`*^9}},ExpressionUUID->"677f6a95-3498-4e12-a23e-\
3923c0f2af28"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"h", ",", "k", ",", "metricGradient", ",", "gradHRaw"}], "]"}], 
   ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Gradient", " ", "of", " ", "the", " ", "constant", " ", "k"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fourGrad", "[", 
     RowBox[{"k", ",", "_"}], "]"}], ":=", "0"}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Perturbation", " ", "tensor"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"h", "[", 
     RowBox[{
      RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], ",", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}]}], "]"}], ":=", 
    RowBox[{
     FractionBox["k", "r"], 
     RowBox[{"\[Lambda]", "[", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], "]"}], 
     RowBox[{"\[Lambda]", "[", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "]"}]}]}], ";"}], 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Display", " ", "rule", " ", "for", " ", "h"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AppendTo", "[", 
    RowBox[{"dpyRules", ",", 
     RowBox[{
      RowBox[{"h", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}]}], "]"}], ":>", 
      RowBox[{"Subscript", "[", 
       RowBox[{"h", ",", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], "]"}]}], "]"}]}]}], "]"}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Verify", " ", "the", " ", "display"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", "[", 
   RowBox[{
    RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
    RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], "/.", " ", 
  "dpyRules"}]}], "Input",
 CellChangeTimes->{{3.9763078456258097`*^9, 3.976307860613257*^9}, {
  3.976307906724279*^9, 3.976307934183831*^9}, {3.976307996008998*^9, 
  3.9763080558607397`*^9}, {3.976308088892457*^9, 3.9763081258581133`*^9}, {
  3.976308210798617*^9, 3.976308217397337*^9}, {3.976310306823275*^9, 
  3.9763103176857643`*^9}, {3.9763104824981623`*^9, 3.976310486266396*^9}, {
  3.976375158909935*^9, 3.97637522063627*^9}, {3.9763761290779047`*^9, 
  3.976376141842887*^9}, {3.976522984435587*^9, 3.976523012613151*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"c668194e-ae90-4671-a670-40e8f04b26f7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Gradient ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Rho]"], 
    SubscriptBox["\:200bh", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]]}], TraditionalForm]],
  ExpressionUUID->"83e36360-85d9-4c70-9a62-11517d7a6c65"],
 "\:200b of the Metric Perturbation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\:200bh", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"1597aabd-ec7a-4ad0-a734-1f907ca3b201"],
 "\:200b"
}], "Subsection",
 CellChangeTimes->{
  3.976307970148697*^9, {3.976308406735373*^9, 3.9763084182089367`*^9}, {
   3.976308457288879*^9, 3.97630848242966*^9}, {3.976523025962656*^9, 
   3.976523033770485*^9}, {3.9765231303442173`*^9, 
   3.976523138355155*^9}},ExpressionUUID->"cbe329a8-7086-4a52-acf2-\
5be13db65ebe"],

Cell[TextData[{
 "Invoke the previously defined ",
 StyleBox["rExpr", "Input"],
 " and the ",
 StyleBox["fourGrad", "Input"],
 " rule for ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "993727ec-0503-4206-9b9e-99687957a096"],
 " via manually renamed summation index \[Gamma] that does not collide with \
the free index \[Rho]."
}], "Text",
 CellChangeTimes->{
  3.976307970148697*^9, {3.976308406735373*^9, 3.976308419314743*^9}, {
   3.976375288736164*^9, 3.976375296622808*^9}, {3.976375999235568*^9, 
   3.97637603407027*^9}, {3.976379000936994*^9, 3.976379077036853*^9}, {
   3.9764494846146517`*^9, 3.976449485952457*^9}, {3.976523046858754*^9, 
   3.976523057650917*^9}},ExpressionUUID->"8a66e4f8-1d4f-42bd-a7ba-\
cef1962cd4a2"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["This kind of collision will be fixed by \
\[OpenCurlyDoubleQuote]alpha renaming\[CloseCurlyDoubleQuote] when we write a \
proper compiler for ",
  FontSlant->"Italic"],
 "\[ScriptCapitalU]\[ScriptCapitalD]",
 StyleBox[".",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9763790805089912`*^9, 3.976379131487015*^9}, {
  3.976449497569188*^9, 3.976449521627575*^9}, {3.976707412694602*^9, 
  3.976707413367334*^9}},ExpressionUUID->"8d729494-92cc-41ee-964d-\
551ef6fe0422"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gradHRaw", "=", 
    RowBox[{"fourGrad", "[", 
     RowBox[{
      RowBox[{"h", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], ",", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Gamma]", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Simplify", " ", "and", " ", "apply", " ", "tensor", " ", "rules"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"metricGradient", "=", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"gradHRaw", "//.", "tensorRules"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "k"}], "}"}], ",", "FullSimplify"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Gradient \!\(\*SubscriptBox[\(\[PartialD]\), \(\[Rho]\)]\
\)\!\(\*SubscriptBox[\(h\), \(\[Mu]\[VeryThinSpace]\[Nu]\)]\) of the metric \
perturbation \!\(\*SubscriptBox[\(h\), \(\[Mu]\[VeryThinSpace]\[Nu]\)]\):\>\"",
    "]"}], ";"}], "\n", 
 RowBox[{"metricGradient", "/.", " ", "dpyRules"}]}], "Input",
 CellChangeTimes->{{3.976308325195485*^9, 3.9763083251974173`*^9}, {
  3.976308491104574*^9, 3.976308550557601*^9}, {3.976310384067379*^9, 
  3.9763104083173447`*^9}, {3.976310540843061*^9, 3.976310560048774*^9}, {
  3.976310591069653*^9, 3.976310591754273*^9}, {3.976376070763318*^9, 
  3.976376096918991*^9}, {3.9763761535475817`*^9, 3.9763761581703663`*^9}, {
  3.9763763282444277`*^9, 3.976376328574682*^9}, {3.976376369361322*^9, 
  3.976376372676647*^9}, {3.97637902533519*^9, 3.976379028567297*^9}, {
  3.9765230730724497`*^9, 3.97652312164392*^9}, {3.9765232051213217`*^9, 
  3.976523226318177*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"b64a2725-8be7-430f-9f46-fa3ee53b69ce"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Intuitions", "Subsubsection",
 CellChangeTimes->{{3.976406861163542*^9, 
  3.976406863620969*^9}},ExpressionUUID->"b901faee-dbbf-4be5-a246-\
92ce623a6063"],

Cell[TextData[{
 "The second term, with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", "3"], TraditionalForm]],ExpressionUUID->
  "0d480a50-2121-46cb-a180-c4fc687a0305"],
 " in the denominator, is Coulomb-like, scaling as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox["r", "2"]}], TraditionalForm]],ExpressionUUID->
  "b4b9a491-ff0d-46f6-9c8b-98fe4f73fbc7"],
 " because the \[Sigma] in the numerator represents the physical distance \
between source and test and scales like ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "fb80e4f6-9f32-4b81-bc88-c7ad01d51cff"],
 ". The first term, with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", "2"], TraditionalForm]],ExpressionUUID->
  "c5801036-e1fe-4d45-abee-76489b82dcb7"],
 " in the denominator, is radiative, scaling as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "r"}], TraditionalForm]],ExpressionUUID->
  "b01154ac-0d31-4997-a155-d9095515dbcd"],
 " due also to a ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]],ExpressionUUID->
  "766f1bf1-85e4-4f7a-9699-9ea8bedb454f"],
 " in the denominator, but also scaling with the acceleration ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "\[VeryThinSpace]", 
    RowBox[{"\[Lambda]", "/", "d"}], "\[VeryThinSpace]", "s"}], 
   TraditionalForm]],ExpressionUUID->"075fcb43-a8d7-42fa-ad10-bfb1c358bb46"],
 ". A field proportional to both acceleration and to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "r"}], TraditionalForm]],ExpressionUUID->
  "dbb2a07b-67ef-41e8-ae29-3c92a3b6d19c"],
 " is the definition of a radiative field."
}], "Text",
 CellChangeTimes->{{3.976376610860808*^9, 3.976376848200593*^9}, {
  3.976405452916387*^9, 3.976405544815357*^9}, {3.9764495722867327`*^9, 
  3.976449573857396*^9}, {3.976523295630456*^9, 3.976523313128447*^9}, {
  3.976523366191909*^9, 3.9765233982566643`*^9}, {3.976707435479705*^9, 
  3.976707435847064*^9}},ExpressionUUID->"d30d8ec4-05db-47b5-9e2a-\
51557038b2d6"],

Cell[TextData[{
 "The factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    RowBox[{
     FractionBox[
      RowBox[{"d", "\[VeryThinSpace]", 
       SuperscriptBox["\[Lambda]", "\[Rho]"]}], 
      RowBox[{"d", "\[VeryThinSpace]", "s"}]], 
     SubscriptBox["\[Sigma]", "\[Rho]"]}]}], TraditionalForm]],ExpressionUUID->
  "4e18e777-66f3-435d-a7b0-ae81fda62db8"],
 " in the Coulomb-like portion of the field accounts for changes in the \
gradient of ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "f06f025a-f76d-47ce-b0ae-6d9b7e602a09"],
 " due to acceleration ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["\[Lambda]", "\[Rho]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", "s"}]], TraditionalForm]],ExpressionUUID->
  "0781d0a8-e100-4e70-af90-84d30b76c0d0"],
 ". It encapsulates the quadratic part of the extrapolation of the retarded \
position, schematically like the Newtonian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "ret"], "+", 
    RowBox[{"v\[CapitalDelta]", "\[VeryThinSpace]", "t"}], "+", 
    RowBox[{
     FractionBox["1", "2"], "a", "\[VeryThinSpace]", "\[CapitalDelta]", "\[VeryThinSpace]", 
     SuperscriptBox["t", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "89f77213-8905-478f-9825-e620a284e078"],
 ". The velocity of the source causes level surfaces of the Coulomb field to \
\[OpenCurlyDoubleQuote]squish\[CloseCurlyDoubleQuote] in front of the source, \
a ",
 StyleBox["Doppler-like effect",
  FontWeight->"Bold"],
 ", and acceleration causes the spacing of the surfaces to compress."
}], "Text",
 CellChangeTimes->{{3.9764060105528307`*^9, 3.9764061002548227`*^9}, {
  3.976406147439021*^9, 3.97640631221244*^9}, {3.9764064068736773`*^9, 
  3.976406421337152*^9}, {3.976406452548161*^9, 3.976406553101644*^9}, {
