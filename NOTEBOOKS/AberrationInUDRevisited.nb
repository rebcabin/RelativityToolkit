Cell[CellGroupData[{

Cell["Tensor Rules", "Subsection",
 CellChangeTimes->{{3.976268207400592*^9, 
  3.9762682104631987`*^9}},ExpressionUUID->"b1a4f7d2-3712-4ae2-ade2-\
bf19873bf02f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "tensorRules", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tensorRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Special", " ", "Rules", " ", "First"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Definition", " ", "of", " ", "\[Sigma]"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x", "[", "ud_", "]"}], "-", 
       RowBox[{
        RowBox[{"z", "[", "s", "]"}], "[", "ud_", "]"}]}], ":>", 
      RowBox[{"\[Sigma]", "[", "ud", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
