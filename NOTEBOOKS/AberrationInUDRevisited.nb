       RowBox[{
        RowBox[{"Partials", "[", 
         RowBox[{"e", ",", "_"}], "]"}], ":>", "0"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "DEFINE", " ", "THE", " ", "POTENTIAL"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"A", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"e", "/", "r"}], ")"}], "*", "lambda"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"A", "[", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"e", "/", "r"}], ")"}], "*", 
      RowBox[{"\[Lambda]", "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "DERIVE", " ", "THE", " ", "FARADAY", " ", "TENSOR"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"F_mn", "=", 
     RowBox[{
      RowBox[{"dA_n", "/", "dm"}], "-", 
      RowBox[{"dA_m", "/", "dn"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Fraw", "=", 
     RowBox[{
      RowBox[{"Partials", "[", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "]"}], ",", 
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], "]"}], "-", 
      RowBox[{"Partials", "[", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], "]"}], ",", 
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}]}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"6.", " ", "COMPUTE", " ", "AND", " ", "DISPLAY"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", 
     RowBox[{"ExpandDerivatives", ":", 
      RowBox[{"Applies", " ", 
       RowBox[{"Product", "/", "Chain"}], " ", "Rule", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"turns", " ", "d", 
          RowBox[{"(", 
           RowBox[{"1", "/", "r"}], ")"}], " ", "into"}], "-", 
         RowBox[{
          RowBox[{"1", "/", 
           RowBox[{"r", "^", "2"}]}], " ", "dr"}]}], ")"}]}]}]}], "*)"}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"2.", " ", 
       RowBox[{"ReplaceAll", "[", 
        RowBox[{"physics", "..."}], "]"}]}], ":", 
      RowBox[{
      "Substitutes", " ", "our", " ", "explicit", " ", "rules", " ", "for", " ",
        "ds"}]}], ",", "dlambda", ",", "dr"}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"3.", " ", 
      RowBox[{"ReplaceAll", "[", 
       RowBox[{"tensor", "..."}], "]"}]}], ":", 
     RowBox[{"Cleans", " ", "up", " ", "algebra"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FEvaluated", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Fraw", "//", "ExpandDerivatives"}], "//", 
       RowBox[{"ReplaceAll", "[", "physicsDerivativeRules", "]"}]}], "//", 
      RowBox[{"ReplaceAll", "[", "tensorRules", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"7.", " ", "FORMAT", " ", "FOR", " ", "COMPARISON"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Use", " ", "Collect", " ", "to", " ", "group", " ", "by", " ", "powers",
       " ", "of", " ", "r"}], ",", 
     RowBox[{"exactly", " ", "like", " ", "the", " ", "paper"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Electrodynamic Field Tensor F_munu (Fully \
Evaluated):\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Result", "=", 
     RowBox[{"Collect", "[", 
      RowBox[{"FEvaluated", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "e"}], "}"}], ",", "FullSimplify"}], "]"}]}], ";"}],
    "\n", 
   RowBox[{"TensorForm", "[", "Result", "]"}]}]}]], "Input",
