Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{
  "t", ",", "r", ",", "\[Theta]", ",", "\[Phi]", ",", "\[Eta]", ",", 
   "\[Eta]Mat", ",", "\[Eta]Rules", ",", "\[Eta]Inv", ",", "\[Eta]InvRules"}],
   "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
