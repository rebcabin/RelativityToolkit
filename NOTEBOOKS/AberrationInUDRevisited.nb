Cell[CellGroupData[{

Cell["Gravitational Aberration", "Section",
 CellChangeTimes->{{3.979664212464664*^9, 
  3.979664218307611*^9}},ExpressionUUID->"c6ad58b2-f214-410c-87d5-\
1cd5d3a00eb7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "SETUP", " ", 
    RowBox[{"(", 
     RowBox[{"Inherits", " ", "Rules", " ", "from", " ", "Script", " ", "1"}],
      ")"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "We", " ", "assume", " ", "tensorRules", " ", "and", " ", 
    "physicsDerivativeRules", " ", "are", " ", 
    RowBox[{"loaded", "."}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"We", " ", 
    RowBox[{"add", "'"}], 
    RowBox[{"k", "'"}], " ", 
    RowBox[{"(", 
     RowBox[{"gravitational", " ", "constant"}], ")"}], " ", "to", " ", 
    RowBox[{"constants", "."}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"physicsDerivativeRules", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"physicsDerivativeRules", ",", 
       RowBox[{
        RowBox[{"Partials", "[", 
         RowBox[{"k", ",", "_"}], "]"}], ":>", "0"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "DEFINE", " ", "THE", " ", "METRIC", " ", "PERTURBATION", " ", 
     "h"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"h_mn", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"k", "/", "r"}], ")"}], "*", "lambda_m", "*", "lambda_n"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"h", "[", 
      RowBox[{
       RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], ",", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"k", "/", "r"}], ")"}], "*", 
      RowBox[{"\[Lambda]", "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], "]"}], "*", 
      RowBox[{"\[Lambda]", "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "DEFINE", " ", "LINEARIZED", " ", "CHRISTOFFEL", " ", 
     "CONNECTION"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Gamma", "^", "t_mn"}], "=", 
     RowBox[{
      RowBox[{"1", "/", "2"}], "*", 
      RowBox[{"eta", "^", "tr"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"dh_rn", "/", "dm"}], "+", 
        RowBox[{"dh_rm", "/", "dn"}], "-", 
        RowBox[{"dh_mn", "/", "dr"}]}], ")"}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "We", " ", "use", " ", "the", " ", "toolkit", " ", "to", " ", "generate", 
     " ", "the", " ", "derivatives", " ", "of", " ", "h", " ", 
     RowBox[{"automatically", "."}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LinearizedGamma", "[", 
      RowBox[{
       RowBox[{"\[ScriptCapitalU]", "[", "\[Tau]_", "]"}], ",", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], ",", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", "term1", ",", "term2", ",", "term3"}], "}"}], ",", 
       RowBox[{
        RowBox[{"term1", "=", 
         RowBox[{"Partials", "[", 
          RowBox[{
           RowBox[{"h", "[", 
            RowBox[{
             RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], ",", 
             RowBox[{"\[ScriptCapitalD]", "[", "r", "]"}]}], "]"}], ",", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"term2", "=", 
         RowBox[{"Partials", "[", 
          RowBox[{
           RowBox[{"h", "[", 
            RowBox[{
             RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
             RowBox[{"\[ScriptCapitalD]", "[", "r", "]"}]}], "]"}], ",", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"term3", "=", 
         RowBox[{"Partials", "[", 
          RowBox[{
           RowBox[{"h", "[", 
            RowBox[{
             RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
             RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], ",", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "r", "]"}], "]"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"1", "/", "2"}], "*", 
         RowBox[{"\[Eta]", "[", 
          RowBox[{
           RowBox[{"\[ScriptCapitalU]", "[", "\[Tau]", "]"}], ",", 
           RowBox[{"\[ScriptCapitalU]", "[", "r", "]"}]}], "]"}], "*", 
         RowBox[{"(", 
          RowBox[{"term1", "+", "term2", "-", "term3"}], ")"}]}]}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "AUTOMATED", " ", "RIEMANN", " ", "CALCULATION"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"We", " ", "create", " ", 
     RowBox[{"a", "'"}], 
     RowBox[{"GammaGetter", "'"}], " ", "function", " ", "that", " ", "wraps",
      " ", "our", " ", "linearized", " ", "definition"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "and", " ", "applies", " ", "the", " ", "derivative", " ", "rules", " ", 
     RowBox[{"immediately", "."}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"GammaGet", "[", 
      RowBox[{"u_", ",", "d1_", ",", "d2_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"LinearizedGamma", "[", 
        RowBox[{"u", ",", "d1", ",", "d2"}], "]"}], "//", 
       "ExpandDerivatives"}], "//", 
      RowBox[{"ReplaceAll", "[", "physicsDerivativeRules", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Now", " ", "we", " ", "ask", " ", "the", " ", "Toolkit", " ", "to", " ", 
     "compute", " ", "R_rho", "_sigma", "_mu", "_nu"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"The", " ", "toolkit", " ", "handles", " ", "the", " ", "R"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"dGamma", "-", "dGamma", "+", "GammaGamma"}], "..."}], " ", 
      "logic"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Note", ":", 
      RowBox[{"In", " ", "linearized", " ", "gravity"}]}], ",", 
     RowBox[{
     "we", " ", "usually", " ", "drop", " ", "the", " ", "GammaGamma", " ", 
      RowBox[{"terms", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"CalculateRiemannComponent", " ", "includes", " ", "them"}], ",", 
     RowBox[{
     "so", " ", "we", " ", "can", " ", "verify", " ", "they", " ", "are", " ",
       "higher", " ", "order"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "or", " ", "just", " ", "look", " ", "at", " ", "the", " ", "linear", " ",
      "dGamma", " ", 
     RowBox[{"terms", "."}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RiemannRaw", "=", 
     RowBox[{"CalculateRiemannComponent", "[", 
      RowBox[{
       RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]", "]"}], ",", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Sigma]", "]"}], ",", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], ",", "GammaGet", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]}], " ", 
      RowBox[{"(*", 
       RowBox[{"Dummy", " ", "coords", " ", "list"}], "*)"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "CLEANUP", " ", "AND", " ", "DISPLAY"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RiemannEvaluated", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"RiemannRaw", "//", "ExpandDerivatives"}], "//", 
        RowBox[{"(*", 
         RowBox[{"Expand", " ", "the", " ", "second", " ", "derivatives"}], 
         "*)"}], 
        RowBox[{"ReplaceAll", "[", "physicsDerivativeRules", "]"}]}], "//", 
       RowBox[{"(*", 
        RowBox[{"Apply", " ", 
         RowBox[{"d", "/", "dx"}], " ", "rules", " ", "again"}], "*)"}], 
       RowBox[{"ReplaceAll", "[", "tensorRules", "]"}]}], "//", 
      RowBox[{"(*", 
       RowBox[{"Apply", " ", "algebra"}], "*)"}], "Simplify"}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Linearized Gravitational Riemann Tensor \
R_rho_sigma_mu_nu:\>\"", "]"}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "This", " ", "extracts", " ", "the", " ", "Radiation", " ", "Term", " ", 
     RowBox[{"(", 
      RowBox[{"1", "/", 
       RowBox[{"r", "^", "2"}]}], ")"}], " ", "to", " ", "verify", " ", "the",
      " ", "result"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radTerm", "=", 
     RowBox[{"ExtractCoefficient", "[", 
      RowBox[{"RiemannEvaluated", ",", 
       RowBox[{"r", "^", 
        RowBox[{"(", 
         RowBox[{"-", "2"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"TensorForm", "[", "radTerm", "]"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"This", " ", "matches", " ", 
     RowBox[{"the", "'"}], "Wall", " ", "of", " ", 
     RowBox[{"Math", "'"}], " ", "from", " ", "the", " ", "PDF", " ", "but", " ", 
     RowBox[{"required", "~", "10"}], " ", "lines", " ", "of", " ", "setup"}],
     "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.9796643501928062`*^9, 3.979664350193885*^9}},
 CellLabel->"In[72]:=",ExpressionUUID->"73791428-eff1-45f5-9960-a0f44a48a78e"]
