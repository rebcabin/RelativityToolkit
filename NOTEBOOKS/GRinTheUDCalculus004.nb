Notebook[{

Cell[CellGroupData[{
Cell["General Relativity in the \[ScriptCapitalU]\[ScriptCapitalD] Calculus \
(Modernized)", "Title",ExpressionUUID->"429f1af7-4b33-4efd-b440-65242ac33ebf"],

Cell["Brian Beckman", "Author",ExpressionUUID->"51293c78-6d49-4046-9536-71715e2bf832"],

Cell["Feb 2026", "Author",ExpressionUUID->"04b5969f-da02-420b-8971-eaf099670476"],

Cell[CellGroupData[{

Cell["Abstract", "Section",ExpressionUUID->"3c45d785-f538-455d-b510-76936dacfd9f"],

Cell["\<\
This notebook modernizes the derivation of the linearized Riemann tensor \
using the Relativity Toolkit v1.13.0. We replace the original custom fourGrad \
operator with the toolkit's general-purpose Partials and ExpandDerivatives \
routines, demonstrating the toolkit's ability to handle the retarded-time \
physics of gravitational aberration.\
\>", "Text",ExpressionUUID->"7f13ee0e-eb5b-4230-b4f7-9f1b30bb1a78"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Initialize the Relativity Toolkit", "Section",ExpressionUUID->"0d1831a9-77f1-4c91-a2f2-297862a0d489"],

