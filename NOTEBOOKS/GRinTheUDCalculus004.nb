Cell[BoxData[
 RowBox[{
  RowBox[{"physicsTensorRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[Sigma]", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]_", "]"}], "]"}], " ", 
       RowBox[{"\[Sigma]", "[", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Alpha]_", "]"}], "]"}]}], ":>", 
      "0"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Sigma]", "[", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Alpha]_", "]"}], "]"}], " ", 
       RowBox[{"\[Sigma]", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]_", "]"}], "]"}]}], ":>", 
      "0"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Lambda]", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]_", "]"}], "]"}], " ", 
       RowBox[{"\[Lambda]", "[", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Alpha]_", "]"}], "]"}]}], ":>", 
      "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Lambda]", "[", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Alpha]_", "]"}], "]"}], " ", 
       RowBox[{"\[Lambda]", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]_", "]"}], "]"}]}], ":>", 
      "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Eta]", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], ",", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]_", "]"}]}], "]"}], ":>", 
      RowBox[{"\[Delta]", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]", "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Alpha]_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Beta]_", "]"}]}], "]"}], "/;", 
       RowBox[{"!", 
        RowBox[{"OrderedQ", "[", 
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}]}]}], ":>", 
      RowBox[{"\[Eta]", "[", 
