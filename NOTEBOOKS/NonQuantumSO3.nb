Cell[CellGroupData[{

Cell["Geodesic Equations", "Subsection",
 CellChangeTimes->{{3.9809536745827913`*^9, 
  3.98095367790361*^9}},ExpressionUUID->"bd4f1996-11c4-4c51-8051-\
40594b54854e"],

Cell["\<\
While standard Lagrangian mechanics produces equations of motion from scalar \
energy functionals, we can alternatively derive the equations of motion \
directly as geodesic equations in the geometry of the configuration space. \
One immediate benefit is that the geodesic equations yield directly intuitive \
terms: \
\>", "Text",
 CellChangeTimes->{{3.980887033220559*^9, 3.9808870411029654`*^9}, {
  3.980953447665412*^9, 3.9809534711740093`*^9}, {3.980953505854097*^9, 
  3.98095351723549*^9}, {3.980953565537094*^9, 3.9809535791090117`*^9}, {
  3.9809786144497213`*^9, 
  3.9809786197528057`*^9}},ExpressionUUID->"47eb5521-5c22-43b3-af6d-\
36ff6a146996"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{
       OverscriptBox["x", "\[FilledSmallCircle]\[FilledSmallCircle]"], " "}], 
      "\[Mu]"], " ", "+", " ", 
     RowBox[{
      SubsuperscriptBox["\[CapitalGamma]", 
       RowBox[{" ", 
        RowBox[{"\[Nu]", " ", "\[Lambda]"}]}], 
       RowBox[{" ", "\[Mu]"}]], " ", 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], 
       RowBox[{" ", "\[Nu]"}]], " ", 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], 
       RowBox[{" ", "\[Lambda]"}]]}]}], " ", "\[LongEqual]", " ", 
    SuperscriptBox["F", 
     RowBox[{" ", "\[Mu]"}]]}],
   HoldForm], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.980277768508177*^9, 3.9802778392253237`*^9}, {
  3.980277905690786*^9, 3.98027802991185*^9}, {3.980278106851225*^9, 
  3.9802781241296177`*^9}, {3.98028465095802*^9, 3.980284663093996*^9}, {
