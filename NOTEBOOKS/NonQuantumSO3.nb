Cell[CellGroupData[{

Cell["Visualization 2: Solving the Equations of Motion", "Subsection",
 CellChangeTimes->{{3.980283213818625*^9, 3.980283228586906*^9}, {
  3.980283875478362*^9, 
  3.980283878123726*^9}},ExpressionUUID->"d9fb30b6-135d-45b5-b3d5-\
5e2815882c77"],

Cell[TextData[{
 "The next ",
 StyleBox["Manipulate", "Input"],
 " lets you drop the baton from any initial conditions for \[Delta] and \
\[Eta]. Gravity takes over, swinging the pendulum down and back up on the \
other side, then down again and back up on the starting side, etc. The \
heads-up display (HUD) shows the conserved values of energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", "=", 
    RowBox[{"T", "+", "V"}]}], TraditionalForm]],ExpressionUUID->
  "2796bd60-f638-422e-a9fb-858a3b00dbc2"],
 ", and the Z component of angular momentum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "z"], TraditionalForm]],ExpressionUUID->
  "64e7b944-bcba-48a5-b819-c5de275a4279"],
 " (formula derived below). This Z component of angular momentum is zero for \
all settings of the initial conditions because gravity points straight down Z."
}], "Text",
 CellChangeTimes->{{3.980283897309293*^9, 3.980283903346251*^9}, {
   3.980283947193465*^9, 3.98028405556807*^9}, {3.9802840877009087`*^9, 
   3.980284114938589*^9}, {3.9806752443065367`*^9, 3.980675339146695*^9}, {
   3.9806792633048687`*^9, 3.9806792844050837`*^9}, {3.980882594793092*^9, 
   3.9808827608977003`*^9}, {3.980882977100451*^9, 3.980882980080408*^9}, {
   3.980883012612165*^9, 3.980883038968041*^9}, {3.9808833724874277`*^9, 
   3.980883400068479*^9}, 3.98097833633636*^9, {3.981239611943387*^9, 
   3.9812396143172626`*^9}},ExpressionUUID->"03b0498c-96aa-4127-99ac-\
911e65c0c393"],

Cell[TextData[{
 StyleBox["In another notebook, ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["How to Land a Rocket",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3581351"], None},
  ButtonNote->"https://community.wolfram.com/groups/-/m/t/3581351"],
  FontVariations->{"Underline"->True}],
 StyleBox[", I show how to balance the baton via control theory at the \
unstable equilibrium, standing straight up.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.980283897309293*^9, 3.980283903346251*^9}, {
  3.980283947193465*^9, 3.98028405556807*^9}, {3.9802840877009087`*^9, 
  3.980284114938589*^9}, {3.9806752443065367`*^9, 3.980675339146695*^9}, {
  3.9806792633048687`*^9, 3.980679275237558*^9}, {3.98088276570627*^9, 
  3.9808827901004333`*^9}},ExpressionUUID->"f27f6ae7-c89b-49f8-a812-\
61c32cefdbce"],

Cell[TextData[{
 "You can make the solution fail by moving the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "0"], TraditionalForm]],ExpressionUUID->
  "096ef2d0-bee7-426f-97ac-c5b8727c5e8f"],
 " slider all the way to the right to ",
 StyleBox[" ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Pi]", "/", "2"}], ")"}], "=", 
     RowBox[{"90", "\[Degree]"}]}]}], TraditionalForm]],ExpressionUUID->
  "eacdcbad-8ee3-4f25-a7b1-cf200206f34d"],
 ". The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Eta]", "''"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1c9bd601-d52b-43d7-b758-b91bddad4ebc"],
 " equation contains ",
 StyleBox["Sec[\[Delta][t]]", "Input"],
 ", which equals ",
 StyleBox["ComplexInfinity", "Input"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "=", 
    RowBox[{"90", "\[Degree]"}]}], TraditionalForm]],ExpressionUUID->
  "2ab338c6-73c1-45c5-8ee8-a2a0323cd94c"],
 ". That\[CloseCurlyQuote]s the realization of ",
 StyleBox["gimbal lock",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", which is inevitable in any attempt to cover the sphere with a single, \
global set of Euler angles."
}], "Text",
 CellChangeTimes->{{3.980930644122099*^9, 3.980930766990292*^9}, {
   3.9809307975831833`*^9, 3.980930898313175*^9}, {3.981239656146226*^9, 
   3.9812396783384113`*^9}, 
   3.9812397691828623`*^9},ExpressionUUID->"5287b8a6-e2c4-46d4-af28-\
ec016a1198a7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"nfm", ",", "vfm", ",", "font", ",", "myFont"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"myFont", "[", 
    RowBox[{"color_", ",", 
     RowBox[{"size_", ":", "18"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Style", "[", 
     RowBox[{"#", ",", "color", ",", "Bold", ",", "size", ",", 
      RowBox[{"FontFamily", "->", "\"\<Courier New\>\""}]}], "]"}], "&"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nfm", "[", 
    RowBox[{"num_", ",", 
     RowBox[{"dig_", ":", "10"}], ",", 
     RowBox[{"dec_", ":", "4"}]}], "]"}], ":=", 
   RowBox[{"ToString", "[", 
    RowBox[{"NumberForm", "[", 
     RowBox[{
      RowBox[{"Chop", "@", "num"}], ",", 
      RowBox[{"{", 
       RowBox[{"dig", ",", "dec"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vfm", "[", "vec_", "]"}], ":=", 
   RowBox[{"ToString", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"NumberForm", "[", 
       RowBox[{"#", ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "4"}], "}"}], ",", 
        RowBox[{"NumberSigns", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<-\>\"", ",", "\"\< \>\""}], "}"}]}], ",", 
        RowBox[{"NumberPadding", "->", 
         RowBox[{"{", 
          RowBox[{"\"\< \>\"", ",", "\"\<0\>\""}], "}"}]}]}], "]"}], "&"}], "/@", 
     RowBox[{"Chop", "@", "vec"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"font", "=", 
   RowBox[{"myFont", "[", 
    RowBox[{
     RowBox[{"Lighter", "[", "Blue", "]"}], ",", "12"}], "]"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"epsilon", "=", "0.0001"}], ",", 
     RowBox[{"h", "=", 
      RowBox[{"1", "/", "15."}]}], ",", 
     RowBox[{"w", "=", 
      RowBox[{"1", "/", "4."}]}], ",", 
     RowBox[{"vu", "=", "3."}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ztxt", "=", 
      RowBox[{"-", "1.5"}]}], ",", 
     RowBox[{"xtxt", "=", "0"}], ",", 
     RowBox[{"ytxt", "=", 
      RowBox[{"-", "2"}]}], ",", 
     RowBox[{"znl", "=", "0.3"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"kart", "=", 
      RowBox[{"Cuboid", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "w"}], ",", 
          RowBox[{"-", "w"}], ",", "epsilon"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"w", ",", "w", ",", 
          RowBox[{"epsilon", "+", "h"}]}], "}"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"floor", "=", 
      RowBox[{"Polygon", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "vu"}], ",", 
           RowBox[{"-", "vu"}], ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"vu", ",", 
           RowBox[{"-", "vu"}], ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"vu", ",", "vu", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "vu"}], ",", "vu", ",", "0"}], "}"}]}], "}"}], 
       "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"axisLabelStyle", "=", 
      RowBox[{"text", "|->", 
       RowBox[{"Style", "[", 
        RowBox[{"text", ",", "Red", ",", "Bold", ",", "18", ",", 
         RowBox[{"FontFamily", "->", "\"\<Courier New\>\""}]}], "]"}]}]}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"cb", "=", 
      RowBox[{"rig", "[", "\"\<cb\>\"", "]"}]}], ",", 
     RowBox[{"thin", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", ".0001"}], "}"}]}], ",", 
     RowBox[{"s", "=", "2"}], ",", 
     RowBox[{"o", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"c3", "=", 
      RowBox[{"Cylinder", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"o", ",", "thin"}], "}"}], ",", 
        RowBox[{"s", " ", 
         RowBox[{"cb", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"b3", "=", 
      RowBox[{"Sphere", "[", 
       RowBox[{"o", ",", 
        RowBox[{"s", " ", 
         RowBox[{"cb", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"t3x", "=", 
      RowBox[{"Tube", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "s"}], " ", 
           RowBox[{"cb", "[", 
            RowBox[{"[", "3", "]"}], "]"}], " ", "e2"}], ",", 
          RowBox[{"s", " ", 
           RowBox[{"cb", "[", 
            RowBox[{"[", "3", "]"}], "]"}], " ", "e2"}]}], "}"}], ",", 
        ".01"}], "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"DynamicModule", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ics", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Delta]", "[", "0", "]"}], "==", "\[Delta]0"}], ",", 
            RowBox[{
             RowBox[{"\[Eta]", "[", "0", "]"}], "==", "\[Eta]0"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Delta]", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Eta]", "'"}], "[", "0", "]"}], "==", "0"}]}], 
           "}"}]}], ",", "\[Delta]x", ",", "D\[Delta]x", ",", "\[Eta]x", ",", 
         "D\[Eta]x", ",", "stSolns"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"stSolns", "=", 
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"stEqns", ",", "ics"}], "]"}], "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"c", ",", "z"}], "]"}], "->", "1.2"}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Delta]", "[", "t", "]"}], ",", 
             RowBox[{"\[Eta]", "[", "t", "]"}], ",", 
             RowBox[{
              RowBox[{"\[Delta]", "'"}], "[", "t", "]"}], ",", 
             RowBox[{
              RowBox[{"\[Eta]", "'"}], "[", "t", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "tLim"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Delta]x", "=", 
         RowBox[{"stSolns", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
        RowBox[{"D\[Delta]x", "=", 
         RowBox[{"stSolns", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "3", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Eta]x", "=", 
         RowBox[{"stSolns", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2", ",", "2"}], "]"}], "]"}]}], ";", 
        RowBox[{"D\[Eta]x", "=", 
         RowBox[{"stSolns", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "4", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Animate", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"renderPos", "=", "o"}], ",", "cs", ",", "rotfn", ",", 
              "\[IndentingNewLine]", 
              RowBox[{"\[Delta]", "=", 
               RowBox[{"\[Delta]x", "/.", " ", 
                RowBox[{"t", "->", "u"}]}]}], ",", 
              RowBox[{"\[Eta]", "=", 
               RowBox[{"\[Eta]x", "/.", " ", 
                RowBox[{"t", "->", "u"}]}]}], ",", 
              RowBox[{"D\[Delta]", "=", 
               RowBox[{"D\[Delta]x", "/.", " ", 
                RowBox[{"t", "->", "u"}]}]}], ",", 
              RowBox[{"D\[Eta]", "=", 
               RowBox[{"D\[Eta]x", "/.", " ", 
                RowBox[{"t", "->", "u"}]}]}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"cs", "=", 
              RowBox[{
               RowBox[{"RotationMatrix", "[", 
                RowBox[{"\[Eta]", ",", "e1"}], "]"}], ".", 
               RowBox[{"RotationMatrix", "[", 
                RowBox[{"\[Delta]", ",", "e2"}], "]"}], ".", "cb"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"renderPos", "=", 
              RowBox[{
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"cs", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], " ", "e1"}], "-", 
               RowBox[{
                RowBox[{"cs", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], " ", "e2"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"rotfn", "=", 
              RowBox[{
               RowBox[{"RotationTransform", "[", 
                RowBox[{"\[Eta]", ",", "e1"}], "]"}], "@*", 
               RowBox[{"RotationTransform", "[", 
                RowBox[{"\[Delta]", ",", "e2"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Show", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Graphics3D", "[", 
                 RowBox[{
                  RowBox[{"{", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Text", "[", 
                    RowBox[{
                    RowBox[{"font", "[", 
                    RowBox[{"\"\<t = \>\"", "<>", 
                    RowBox[{"nfm", "@", "u"}], "<>", "\"\<, E = \>\"", "<>", 
                    RowBox[{"nfm", "@", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Tnum", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\[Delta]", ",", "\[Eta]"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"D\[Delta]", ",", "D\[Eta]"}], "}"}]}], "]"}], "+", 
                    RowBox[{"Vnum", "[", 
                    RowBox[{"{", 
                    RowBox[{"\[Delta]", ",", "\[Eta]"}], "}"}], "]"}]}], 
                    ")"}]}], "<>", 
                    "\[IndentingNewLine]", "\"\<, \!\(\*SubscriptBox[\(p\), \
\(z\)]\) = \>\"", "<>", 
                    RowBox[{"ToString", "@", 
                    RowBox[{"FortranForm", "@", 
                    RowBox[{"Chop", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"D\[Delta]", " ", 
                    RowBox[{"Sin", "[", "\[Eta]", "]"}]}], "-", 
                    RowBox[{"D\[Eta]", " ", 
                    RowBox[{"Sin", "[", "\[Delta]", "]"}], " ", 
                    RowBox[{"Cos", "[", "\[Delta]", "]"}], " ", 
                    RowBox[{"Cos", "[", "\[Eta]", "]"}]}]}], ")"}], ",", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "6"}]}]}], "]"}]}]}]}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"xtxt", ",", "ytxt", ",", "ztxt"}], "}"}]}], 
                    "]"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"Text", "[", 
                    RowBox[{
                    RowBox[{"font", "[", 
                    
                    RowBox[{"\"\<{\!\(\*SubscriptBox[\(\[Delta]\), \
\(0\)]\),\!\(\*SubscriptBox[\(\[Eta]\), \(0\)]\)} = \>\"", "<>", 
                    RowBox[{"vfm", "@", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\[Delta]0", "/", "\[Degree]"}], ",", 
