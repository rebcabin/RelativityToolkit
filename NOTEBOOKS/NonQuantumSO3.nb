Cell[TextData[StyleBox["QED\[FilledSquare]",
 FontColor->RGBColor[0.14, 0.8, 0.14]]], "Subsubsection",
 CellChangeTimes->{{3.980497990040112*^9, 3.980497993072949*^9}, 
   3.980498031757402*^9},ExpressionUUID->"20c4f829-8751-4307-a1c0-\
277f20d333db"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{"S", "\[VeryThinSpace]", 
   RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"a5a8ac84-3fdc-422a-b606-79eb9a00900d"]], \
"Section",
 CellChangeTimes->{{3.980542752661461*^9, 3.980542753095209*^9}, {
  3.9806926605033693`*^9, 
  3.980692668511153*^9}},ExpressionUUID->"65b7893f-5cde-4a3f-bb54-\
a9abbbb31ec5"],

Cell[TextData[{
 "Up to now, we have entertained only two angles, \[Delta] and \[Eta]. That \
means our metric and connections do not span the full ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "065b4c6b-f852-4f77-9d10-015ef772e31a"],
 " group of three angles, but inhabit a quotient group, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{
     RowBox[{"O", "(", "3", ")"}], "/", "S"}], "\[VeryThinSpace]", 
    RowBox[{"O", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "2480c48f-2521-41b5-95a5-1ca6bd68bfc6"],
 ". One angle, \[Psi], lives alone and ignored in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "fa8a6c75-cfd2-44f4-a611-1360bd2151dd"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       RowBox[{"cos", " ", "\[Psi]"}], 
       RowBox[{
        RowBox[{"-", "sin"}], " ", "\[Psi]"}]},
      {
       RowBox[{"sin", " ", "\[Psi]"}], 
       RowBox[{"cos", " ", "\[Psi]"}]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "37884ebb-2be3-499a-87d2-adae134bf182"],
 ", a matrix whose two dimensions give the \[OpenCurlyDoubleQuote]2\
\[CloseCurlyDoubleQuote] to \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "e2ccade5-c707-487f-bb3a-caf01aa6b5d3"],
 ".\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{3.9806922032678013`*^9, 3.98069220412999*^9}, {
  3.980692627382619*^9, 3.980692652868103*^9}, {3.980693422595975*^9, 
  3.980693604773776*^9}, {3.980775374521949*^9, 3.9807754130984087`*^9}, {
  3.981241516809654*^9, 
  3.981241535998932*^9}},ExpressionUUID->"0210fe37-79c2-44f9-a23a-\
82e92aae80b8"],

Cell["\<\
What is \[Psi]? The only thing it could be: twist around the long axis of the \
baton, changing the baton from a pendulum that falls over into a spinning, \
cylindrically symmetric top that gyroscopically resists falling over. \
\>", "Text",
 CellChangeTimes->{{3.9806936098682203`*^9, 3.980693779073493*^9}, {
   3.980707248421247*^9, 3.980707325861897*^9}, {3.9807754283450203`*^9, 
   3.9807754447518272`*^9}, 3.980775475684092*^9, {3.9807790680352793`*^9, 
   3.980779070874137*^9}, 3.980779197908812*^9, {3.9808849506543417`*^9, 
   3.980884952174028*^9}, {3.980955785375504*^9, 
   3.980955812433402*^9}},ExpressionUUID->"2a7a0ea6-6bc2-46f6-9522-\
2e0201f8c9e1"],

Cell["\<\
Gyroscopic forces are again inertial, arising from a new metric and \
connection, but we get them with no further manual effort. Just turn the \
crank and get a spinning symmetrical top.\
\>", "Text",
 CellChangeTimes->{{3.9806936098682203`*^9, 3.980693779073493*^9}, {
   3.980707248421247*^9, 3.980707325861897*^9}, {3.9807754283450203`*^9, 
   3.9807754447518272`*^9}, 3.980775475684092*^9, {3.9807790680352793`*^9, 
   3.980779070874137*^9}, {3.980955829638606*^9, 
   3.980955833532689*^9}},ExpressionUUID->"e4e5a373-3b12-4833-964e-\
c440e248b0ad"],

Cell[CellGroupData[{

Cell["Kinetic Energy", "Subsection",
 CellChangeTimes->{{3.9809558728747873`*^9, 
  3.980955876343951*^9}},ExpressionUUID->"e52e8764-7e2c-430f-94aa-\
fb7e4ee75fa9"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "3"], TraditionalForm]],ExpressionUUID->
  "1b9b5405-7d45-43c4-84c8-26fc6d44c3a0"],
 " be the moment of inertia around the \[Psi] axis. Set ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "3"], TraditionalForm]],ExpressionUUID->
  "0c807925-e8fe-42c6-bf78-48ec94e5800b"],
 " to be some manipulable multiple of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["I", "1"], "=", 
    RowBox[{"m", "\[VeryThinSpace]", 
     SuperscriptBox[
      SubscriptBox["c", "z"], "2"]}]}], TraditionalForm]],ExpressionUUID->
  "ccc051fb-438c-4565-95a0-c7f21b23b31a"],
 ", the \[Delta]\[NoBreak]-\[NoBreak]\[Eta] moment of inertia about the base \
of the baton. "
}], "Text",
 CellChangeTimes->{{3.980693800245324*^9, 3.98069400657944*^9}, {
   3.9806940389821787`*^9, 3.980694070825697*^9}, {3.980694494851349*^9, 
   3.9806944978040752`*^9}, {3.9806945510772343`*^9, 3.980694794586244*^9}, {
   3.980707352298134*^9, 3.980707402290766*^9}, 
   3.980884980840542*^9},ExpressionUUID->"1e7cc91a-7c6c-42bf-a925-\
310a2bce08c2"],

Cell["\<\
The \[Eta]\[NoBreak]-\[NoBreak]\[Psi] cross-terms in the kinetic energy arise \
from projecting \[Eta]\[NoBreak]-\[NoBreak]rotation against the \[Psi] axis. \
As the baton starts to fall, its spinning inertia about the \[Psi] axis \
flings it back up, decreasing \[Eta] and causing precession and nutation.\
\>", "Text",
 CellChangeTimes->{{3.980693800245324*^9, 3.98069400657944*^9}, {
   3.9806940389821787`*^9, 3.980694070825697*^9}, {3.980694494851349*^9, 
   3.9806944978040752`*^9}, {3.9806945510772343`*^9, 3.980694794586244*^9}, {
   3.980707352298134*^9, 3.9807074950362787`*^9}, 3.980775501295085*^9, {
   3.980775560134328*^9, 3.980775561227254*^9}, {3.98095589566678*^9, 
   3.980955931562552*^9}, {3.9809563735952044`*^9, 3.980956476997489*^9}, {
   3.9809565812990103`*^9, 3.980956581828237*^9}, {3.981241721623385*^9, 
   3.981241722554241*^9}},ExpressionUUID->"df8eeaac-de6d-46bc-bc6c-\
c0594c81de41"],

Cell["To consider the extremes: ", "Text",
 CellChangeTimes->{{3.980693800245324*^9, 3.98069400657944*^9}, {
   3.9806940389821787`*^9, 3.980694070825697*^9}, {3.980694494851349*^9, 
   3.9806944978040752`*^9}, {3.9806945510772343`*^9, 3.980694794586244*^9}, {
   3.980707352298134*^9, 3.9807074950362787`*^9}, 3.980775501295085*^9, {
   3.980775560134328*^9, 3.980775561227254*^9}, {3.98095589566678*^9, 
   3.980955931562552*^9}, {3.9809563735952044`*^9, 3.980956572131715*^9}, 
   3.981241746570931*^9},ExpressionUUID->"ca16708c-8388-4ccf-ab85-\
b85d894d7daf"],

Cell[TextData[{
 "when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "3d9128ce-df12-40a0-9a18-8f47ccc8e385"],
 ", the baton is straight up and and \[Eta]\[NoBreak]-\[NoBreak]rotation has \
no projection on the \[Psi]\[NoBreak]-\[NoBreak]spin axis. "
}], "Item",
 CellChangeTimes->{{3.980693800245324*^9, 3.98069400657944*^9}, {
   3.9806940389821787`*^9, 3.980694070825697*^9}, {3.980694494851349*^9, 
   3.9806944978040752`*^9}, {3.9806945510772343`*^9, 3.980694794586244*^9}, {
   3.980707352298134*^9, 3.9807074950362787`*^9}, 3.980775501295085*^9, {
   3.980775560134328*^9, 3.980775561227254*^9}, {3.98095589566678*^9, 
   3.980955931562552*^9}, {3.9809563735952044`*^9, 3.980956572131715*^9}, 
   3.98124176229902*^9},ExpressionUUID->"0df40d7f-98d2-4fea-99f2-\
4bb98628ce6d"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "=", 
    RowBox[{"90", "\[Degree]"}]}], TraditionalForm]],ExpressionUUID->
  "8d449c5f-2092-4214-b3b3-cae6dbf43d15"],
 ", the baton lies entirely in the equatorial plane and all \[Eta] rotation \
is around the \[Psi] axis. "
}], "Item",
 CellChangeTimes->{{3.980693800245324*^9, 3.98069400657944*^9}, {
   3.9806940389821787`*^9, 3.980694070825697*^9}, {3.980694494851349*^9, 
   3.9806944978040752`*^9}, {3.9806945510772343`*^9, 3.980694794586244*^9}, {
   3.980707352298134*^9, 3.9807074950362787`*^9}, 3.980775501295085*^9, {
   3.980775560134328*^9, 3.980775561227254*^9}, {3.98095589566678*^9, 
   3.980955931562552*^9}, {3.9809563735952044`*^9, 3.980956572131715*^9}, 
   3.981241769206161*^9},ExpressionUUID->"2ffa376b-7a2c-40ac-8341-\
266a90cbc2ef"],

Cell["\<\
The projection of the \[Eta]\[NoBreak]-\[NoBreak]rotation against the \[Psi] \
axis generates the gyroscopic forces, and we\[CloseCurlyQuote]ll see a term \
corresponding to that projection in the connection. \
\>", "Text",
 CellChangeTimes->{{3.980693800245324*^9, 3.98069400657944*^9}, {
   3.9806940389821787`*^9, 3.980694070825697*^9}, {3.980694494851349*^9, 
   3.9806944978040752`*^9}, {3.9806945510772343`*^9, 3.980694794586244*^9}, {
   3.980707352298134*^9, 3.9807074950362787`*^9}, 3.980775501295085*^9, {
   3.980775560134328*^9, 3.980775561227254*^9}, {3.98095589566678*^9, 
   3.980955931562552*^9}, {3.9809563735952044`*^9, 
   3.980956572131715*^9}},ExpressionUUID->"15fe064b-12a3-4df8-9f09-\
06f6e9c342a6"],

Cell[CellGroupData[{

Cell["Gauge Potential and Gauge Connection", "Subsubsection",
 CellChangeTimes->{{3.9809566373613*^9, 3.9809566402292337`*^9}, {
  3.9809567221962137`*^9, 
  3.9809567296911907`*^9}},ExpressionUUID->"265ecb6e-84ac-4d06-88e5-\
18bab22a1209"],

Cell[TextData[{
 "The off-diagonal element is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "864342a6-af2f-4474-9327-e84dd3460e32"],
 " ",
 StyleBox["gauge potential",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", analogous to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "4d4694e5-86b5-4192-9e0d-f312e884e9c4"],
 "\:200b in electrodynamics mentioned in an earlier notebook, ",
 StyleBox["Gauge Theory in ",
  FontSlant->"Italic"],
 "\[ScriptCapitalU]\[ScriptCapitalD]. In a flat, uncoupled configuration \
manifold with no cross-term, cone-rolling the baton (\[Eta]) and spinning the \
baton (\[Psi]) would be independent. However, because of the geometry of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "5c3b4b16-3d90-4723-b98a-614faf86a6a4"],
 ", moving the configuration along an \[Eta]\[NoBreak]-\[NoBreak]coordinate \
line leaks into the \[Psi] coordinate and vice versa. The amount of leak is \
exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["I", "3"], " ", "\:200bsin", " ", "\[Delta]"}], 
   TraditionalForm]],ExpressionUUID->"66ded5c3-e8a3-4a3c-a08d-01280a0d2380"],
 ". The geometric leak is the ",
 StyleBox["gauge connection",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", and its covariant derivative generates the Coriolis forces that \
physically manifest as gyroscopic precession."
}], "Text",
 CellChangeTimes->{{3.9807755942832737`*^9, 3.9807759015808907`*^9}, {
  3.980885031860437*^9, 3.9808850606871967`*^9}, {3.980885105767066*^9, 
  3.9808851264635077`*^9}, {3.980885159057826*^9, 3.980885208494945*^9}, {
  3.980889143209031*^9, 3.980889145973366*^9}, {3.980931199272172*^9, 
  3.980931202260936*^9}, {3.9809566675742817`*^9, 3.9809566893890944`*^9}, {
  3.981241866152247*^9, 
  3.9812418754004593`*^9}},ExpressionUUID->"215973be-51cf-4b1e-81e6-\
a0a119b83dee"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Topology", "Subsubsection",
 CellChangeTimes->{{3.980956744673203*^9, 
  3.980956747148857*^9}},ExpressionUUID->"ef071048-1e15-4d89-8430-\
210a446b0331"],

Cell[TextData[{
 "The fundamental reason for this leak is topological. The total \
configuration space, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "50691916-34ea-4fb4-bfd0-125e6e99ffa6"],
 ", is a non-trivial fibre bundle (see references). It is not merely a flat \
2D sphere ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"\[Delta]", ",", "\[Eta]"}], "\[NonBreakingSpace]", "}"}], 
   TraditionalForm]],ExpressionUUID->"5e8f28e5-62a7-42e9-a5a5-58a963083ba4"],
 " with a 1D circle ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[Psi]", " ", ")"}], TraditionalForm]],ExpressionUUID->
  "c7cbae4d-d64c-408d-9442-cc0d4d7d3c4d"],
 " glued on via Cartesian product. That would be a ",
 StyleBox["trivial",
  FontSlant->"Italic"],
 " fibre bundle. "
}], "Text",
 CellChangeTimes->{{3.980889150284308*^9, 3.980889481788769*^9}, {
  3.980931212438347*^9, 3.980931417559778*^9}, {3.9809567655008993`*^9, 
  3.980956783098413*^9}, {3.981241901166813*^9, 
  3.981241911509984*^9}},ExpressionUUID->"a1567be3-2962-4e66-a00d-\
a787980c8d2a"],

Cell["\<\
As the baton moves around the sphere, the spin fibers suffer a global \
topological twist. Gyroscopic precession and nutation are the physical \
manifestation of the baton\[CloseCurlyQuote]s navigating this twisted space. \
\
\>", "Text",
 CellChangeTimes->{{3.980889150284308*^9, 3.980889481788769*^9}, {
  3.980931212438347*^9, 3.980931417559778*^9}, {3.9809567655008993`*^9, 
  3.9809568317482147`*^9}},ExpressionUUID->"bcb84bf7-018d-4ce9-a5ca-\
5d57ce4aab1b"],

Cell["\<\
Now, just mimic the indexer-sector development above. Precession and nutation \
arise spontaneously.\
\>", "Text",
 CellChangeTimes->{{3.9806948028151007`*^9, 3.980694840462071*^9}, {
  3.980885227981599*^9, 3.980885246320693*^9}, {3.9808862528544397`*^9, 
  3.980886253212015*^9}},ExpressionUUID->"1e32c73c-09ca-4e21-9c8e-\
3f5b99c5b3ab"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "coords3", ",", "vels3", ",", "accels3", ",", "v3", ",", "a3", ",", 
    "\[CapitalGamma]3", ",", "I3", ",", "I1", ",", "cz", ",", "m"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords3", "=", 
   RowBox[{"{", 
    RowBox[{"\[Delta]", ",", "\[Eta]", ",", "\[Psi]"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"metric3", "=", 
   RowBox[{"(", GridBox[{
      {"I1", "0", "0"},
      {"0", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"I1", " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Delta]", "]"}], "2"]}], "+", 
         RowBox[{"I3", " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Delta]", "]"}], "2"]}]}], ")"}], 
       RowBox[{"I3", " ", 
        RowBox[{"Sin", "[", "\[Delta]", "]"}]}]},
      {"0", 
       RowBox[{"I3", " ", 
        RowBox[{"Sin", "[", "\[Delta]", "]"}]}], "I3"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g3", "=", 
   RowBox[{"MakeIndexer", "[", 
    RowBox[{"metric3", ",", "coords3"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ig3", "=", 
   RowBox[{"MakeIndexer", "[", 
    RowBox[{
     RowBox[{"Inverse", "@", "metric3"}], ",", "coords3"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"g3", "[", 
        RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Mu]", ",", "coords3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Nu]", ",", "coords3"}], "}"}]}], "]"}], "//", 
     "MatrixForm"}], 
    ",", "\"\<\!\(\*SubscriptBox[\(g3\), \(\\\ \(\[Mu]\\\ \[Nu]\)\)]\) \
:\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ig3", "[", 
        RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Mu]", ",", "coords3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Nu]", ",", "coords3"}], "}"}]}], "]"}], "//", 
     "MatrixForm"}], 
    ",", "\"\<\!\(\*SuperscriptBox[\(g3\), \(\\\ \(\[Mu]\\\ \[Nu]\)\)]\) \
:\>\""}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.980332732537895*^9, 3.980332745377611*^9}, {
  3.980550302707077*^9, 3.9805503549489202`*^9}, {3.9805523334915524`*^9, 
  3.980552360685157*^9}, {3.980552404731217*^9, 3.980552405077479*^9}, {
  3.980886261038479*^9, 3.980886262860896*^9}},
 CellLabel->"In[92]:=",ExpressionUUID->"5a1f20f2-fb59-40da-8e79-94726523ed54"],

