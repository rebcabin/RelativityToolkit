32bd59e94624"],

Cell[TextData[{
 "Page 286, Poincar\[EAcute]\[CloseCurlyQuote]s Theorem: ",
 StyleBox["the sum of the indices of all singularities of a differentiable \
vector field with isolated singular points on a compact surface equals the \
Euler-Poincar\[EAcute] characteristic of the surface. ",
  FontSlant->"Italic"],
 "Because the Euler characteristic of a 2D sphere is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Chi]", "(", "S2", ")"}], "=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8eeb1d57-f500-4300-9145-a17492c65742"],
 ", which is not zero, it is impossible to draw a continuous tangent vector \
field without at least one singularity."
}], "ItemParagraph",
 CellChangeTimes->{{3.9808875826505003`*^9, 3.9808876354564877`*^9}, {
   3.980887688905569*^9, 3.980887717056387*^9}, 3.980887749555641*^9, {
   3.980887818200058*^9, 3.9808878279553747`*^9}, {3.980887861505479*^9, 
   3.980887952194718*^9}, {3.980950000298601*^9, 
   3.980950104105506*^9}},ExpressionUUID->"e037405b-ac96-4073-b91c-\
05f2d5ded28a"]
}, Open  ]],

