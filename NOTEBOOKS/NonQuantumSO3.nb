Cell["\<\
This function internally produces a time injector rather than relying on an \
external definition. Its output is the full contravariant vector (up index) \
of inertial forces.\
\>", "Text",
 CellChangeTimes->{{3.9805015410015917`*^9, 3.980501546030754*^9}, {
   3.980519043918844*^9, 3.980519073017227*^9}, {3.9805323036590357`*^9, 
   3.980532303827695*^9}, {3.980545636681929*^9, 3.980545667616001*^9}, {
   3.980884464258965*^9, 3.980884483943282*^9}, {3.9808845160778*^9, 
   3.9808845253195667`*^9}, 3.980954436988645*^9, {3.981241157302149*^9, 
   3.981241171169654*^9}},ExpressionUUID->"addd2506-9d74-445e-8418-\
f54514cdcc0c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "CurvatureForcesFromConnectionIndexer", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CurvatureForcesFromConnectionIndexer", "[", 
     RowBox[{"v_", ",", "\[CapitalGamma]_", ",", "time_", ",", "coords_"}], 
     "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox["injectTime",
         FontColor->RGBColor[0, 0.74, 0.74]], "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"c", "|->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"c", "->", 
               RowBox[{"c", "[", "time", "]"}]}], ",", 
              RowBox[{
               RowBox[{"c", "'"}], "->", 
               RowBox[{
                RowBox[{"c", "'"}], "[", "time", "]"}]}]}], "}"}]}], ")"}], "/@",
           "coords"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         StyleBox["ContractIndexedAll",
          FontColor->RGBColor[0.14, 0.8, 0.14]], "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Nu]", ",", "\[Lambda]"}], "}"}], "|->", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[CapitalGamma]", "[", 
               RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Lambda]"}], "]"}], "/.", 
              StyleBox["injectTime",
               FontColor->RGBColor[0, 0.74, 0.74]]}], ")"}], 
            RowBox[{"v", "[", "\[Nu]", "]"}], 
            RowBox[{"v", "[", "\[Lambda]", "]"}]}]}], ",", 
          "\[IndentingNewLine]", "coords"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"\[Mu]", ",", "coords"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"CurvatureForcesFromConnectionIndexer", "[", 
      RowBox[{"v", ",", 
       StyleBox["\[CapitalGamma]Pendulum",
        FontColor->RGBColor[0.95, 0.43, 0.96]], ",", "t", ",", "coords"}], 
      "]"}], "//", "\[IndentingNewLine]", "MatrixForm"}], 
    ",", "\"\<\!\(\*SubsuperscriptBox[\(\[CapitalGamma]\), \(\\\ \(\[Nu]\\\ \
\[Lambda]\)\), \(\\\ \(\[Mu]\)\)]\) \!\(\*SuperscriptBox[OverscriptBox[\(x\), \
\(\[FilledSmallCircle]\)], \(\\\ \(\[Nu]\)\)]\) \
\!\(\*SuperscriptBox[OverscriptBox[\(x\), \(\[FilledSmallCircle]\)], \(\\\ \(\
\[Lambda]\)\)]\) :\>\""}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.980468295490818*^9, 3.980468297725953*^9}, {
   3.980468331451722*^9, 3.9804684708437347`*^9}, {3.980468895645056*^9, 
   3.9804689134196177`*^9}, {3.9804690999213057`*^9, 
   3.9804691000528584`*^9}, {3.980470511698824*^9, 3.9804705696223707`*^9}, {
   3.980470626732719*^9, 3.980470628923719*^9}, {3.980471215700007*^9, 
   3.980471238738048*^9}, {3.9805011935022593`*^9, 3.980501241941782*^9}, {
   3.980501274547111*^9, 3.9805013114532022`*^9}, {3.980518804216701*^9, 
   3.980518816027482*^9}, 3.9805478198934917`*^9, {3.9809545166288643`*^9, 
   3.9809545791616173`*^9}, {3.9809554826597652`*^9, 3.980955490388274*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"d2b81793-f58e-4059-a3cf-8227da2ebf30"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"\\!\\(\\*SubsuperscriptBox[\\(\[CapitalGamma]\\), \\(\\\\ \\(\
\[Nu]\\\\ \[Lambda]\\)\\), \\(\\\\ \\(\[Mu]\\)\\)]\\) \
\\!\\(\\*SuperscriptBox[OverscriptBox[\\(x\\), \\(\[FilledSmallCircle]\\)], \
\\(\\\\ \\(\[Nu]\\)\\)]\\) \\!\\(\\*SuperscriptBox[OverscriptBox[\\(x\\), \\(\
\[FilledSmallCircle]\\)], \\(\\\\ \\(\[Lambda]\\)\\)]\\) :\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{"(", "\[NoBreak]", 
    TagBox[GridBox[{
       {
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"\[Delta]", "[", "t", "]"}], "]"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Delta]", "[", "t", "]"}], "]"}], " ", 
         SuperscriptBox[
          RowBox[{
           SuperscriptBox["\[Eta]", "\[Prime]",
            MultilineFunction->None], "[", "t", "]"}], "2"]}]},
       {
        RowBox[{
         RowBox[{"-", "2"}], " ", 
         RowBox[{"Tan", "[", 
          RowBox[{"\[Delta]", "[", "t", "]"}], "]"}], " ", 
         RowBox[{
          SuperscriptBox["\[Delta]", "\[Prime]",
           MultilineFunction->None], "[", "t", "]"}], " ", 
         RowBox[{
          SuperscriptBox["\[Eta]", "\[Prime]",
           MultilineFunction->None], "[", "t", "]"}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.5599999999999999]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}],
     Column], "\[NoBreak]", ")"}],
   Function[BoxForm`e$, 
    MatrixForm[BoxForm`e$]]]}]], "Echo",
 CellChangeTimes->{
  3.981237671556602*^9},ExpressionUUID->"be1f70fa-3b51-45e3-810e-\
617ac0cfb880"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Absolute Derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"D", "\[VeryThinSpace]", 
       SuperscriptBox[
        OverscriptBox["x", "\[FilledSmallCircle]"], 
        RowBox[{" ", "\[Mu]"}]]}], 
      RowBox[{"d", "\[VeryThinSpace]", "t"}]], "\[Congruent]", 
     RowBox[{
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], 
       RowBox[{" ", "\[Nu]"}]], 
      RowBox[{
       SubscriptBox["\[Del]", "\[Nu]"], 
       SuperscriptBox[
        OverscriptBox["x", "\[FilledSmallCircle]"], 
        RowBox[{" ", "\[Mu]"}]]}]}]}], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{
       OverscriptBox["x", "\[FilledSmallCircle]\[FilledSmallCircle]"], " "}], 
      "\[Mu]"], "+", 
     RowBox[{
      SubsuperscriptBox["\[CapitalGamma]", 
       RowBox[{" ", 
        RowBox[{"\[Nu]", " ", "\[Lambda]"}]}], 
       RowBox[{" ", "\[Mu]"}]], 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], 
       RowBox[{" ", "\[Nu]"}]], 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], 
       RowBox[{" ", "\[Lambda]"}]]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "514ca1fb-2223-4775-b65f-2f9a8582bef5"],
 " "
}], "Subsection",
 CellChangeTimes->{{3.980355204258387*^9, 3.980355213187406*^9}, {
  3.980462153938167*^9, 3.980462161618561*^9}, {3.9804663794016237`*^9, 
  3.9804663794017057`*^9}, {3.9804664286531353`*^9, 3.980466472276762*^9}, {
  3.980472220257227*^9, 
  3.980472226203918*^9}},ExpressionUUID->"465bb3b3-f66c-4dac-b3d3-\
a81a705362cb"],

Cell["New function for the toolkit v1.13.0. ", "Text",
 CellChangeTimes->{{3.9805015410015917`*^9, 3.980501546030754*^9}, {
   3.980545677997059*^9, 3.9805457295553913`*^9}, {3.9805458849711533`*^9, 
   3.980545924322506*^9}, {3.9805460106032467`*^9, 3.980546466700238*^9}, {
   3.980546830785861*^9, 3.980546940306079*^9}, {3.980546986144538*^9, 
   3.980547124936084*^9}, 3.980689224771619*^9, {3.980884537070415*^9, 
   3.980884537595725*^9}, {3.980954668057094*^9, 3.9809546801542883`*^9}},
 FontWeight->"Bold",ExpressionUUID->"9a9cb6f6-de63-4ec6-a00b-9bd664cf689a"],

Cell["\<\
Adds an explicit coordinate acceleration term to the inertial forces and \
produces the entire vector. \
\>", "Text",
 CellChangeTimes->{{3.9805015410015917`*^9, 3.980501546030754*^9}, {
  3.980545677997059*^9, 3.9805457295553913`*^9}, {3.9805458849711533`*^9, 
  3.980545924322506*^9}, {3.9805460106032467`*^9, 3.980546466700238*^9}, {
  3.980546830785861*^9, 3.980546940306079*^9}, {3.980546986144538*^9, 
  3.980547124936084*^9}},ExpressionUUID->"906fe062-41f8-4773-986b-\
0ab6a94f4220"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["We have to do it this way because ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Delta]", "'"}], "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"\[Eta]", "'"}], "[", "t", "]"}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"36815428-eb84-44cb-a0dc-d179719f4409"],
 " ",
 StyleBox["is not , here, a field of velocity vectors, one for each point",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"\[Delta]", ",", "\[Eta]"}], "\[NonBreakingSpace]", "}"}], 
   TraditionalForm]],ExpressionUUID->"82d6e4b9-b747-48dc-a7aa-e407198acd7f"],
 StyleBox[", but rather a particular velocity that depends on time. \
Therefore, for instance, the derivative ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"\[PartialD]", 
      OverscriptBox["\[Delta]", "\[FilledSmallCircle]"]}], "/", 
     RowBox[{"\[PartialD]", "\[Delta]"}]}], ")"}], TraditionalForm]],
  ExpressionUUID->"ad4e35ed-5193-4f49-b96d-94f4a9452afc"],
 " ",
 StyleBox["or",
  FontSlant->"Italic"],
 " ",
 StyleBox["D[v[t],coord]", "Input"],
 StyleBox[", doesn\[CloseCurlyQuote]t make sense here. We can\
\[CloseCurlyQuote]t mechanically compute the chain rule of Equation ",
  FontSlant->"Italic"],
 StyleBox[
 CounterBox["DisplayFormulaNumbered", "CHAIN RULE FOR ABSOLUTE DERIVATIVE"],
  FontSlant->"Italic"],
 StyleBox[". Wolfram reduces",
  FontSlant->"Italic"],
 " ",
 StyleBox["D[v[t],coord]", "Input"],
 " ",
 StyleBox["to zero. This is not whimsical, but rather a consequence of the \
fact that we\[CloseCurlyQuote]ve already assumed a function of time and we\
\[CloseCurlyQuote]re no longer tracking the field. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9805015410015917`*^9, 3.980501546030754*^9}, {
  3.980545677997059*^9, 3.9805457295553913`*^9}, {3.9805458849711533`*^9, 
  3.980545924322506*^9}, {3.9805460106032467`*^9, 3.980546466700238*^9}, {
  3.980546830785861*^9, 3.980546940306079*^9}, {3.980546986144538*^9, 
  3.980547123052227*^9}, {3.980547168838632*^9, 3.9805472337839527`*^9}, {
  3.980689238964032*^9, 3.980689307604705*^9}, {3.980884552994687*^9, 
  3.980884642717125*^9}, {3.981240932108572*^9, 3.981240934490839*^9}, {
  3.9812412421775017`*^9, 3.9812412421777363`*^9}, {3.981241278731811*^9, 
  3.981241322026622*^9}, {3.9812413522312183`*^9, 
  3.9812413766819363`*^9}},ExpressionUUID->"69905c42-dd8f-4597-98b3-\
9b1dc7ff5883"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "AbsoluteDerivativeFromConnectionIndexer", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"AbsoluteDerivativeFromConnectionIndexer", "[", 
     RowBox[{"v_", ",", "\[CapitalGamma]_", ",", "time_", ",", "coords_"}], 
     "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"inertialTerms", "=", 
         RowBox[{"CurvatureForcesFromConnectionIndexer", "[", 
          RowBox[{"v", ",", "\[CapitalGamma]", ",", "time", ",", "coords"}], 
          "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"coordinateAcceleration", "=", 
