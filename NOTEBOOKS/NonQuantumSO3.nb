          RowBox[{"9.81`", " ", 
           RowBox[{"Sec", "[", 
            RowBox[{"\[Delta]", "[", "t", "]"}], "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Eta]", "[", "t", "]"}], "]"}]}], 
          SubscriptBox["c", "z"]], "+", 
         RowBox[{"2.`", " ", 
          RowBox[{"Tan", "[", 
           RowBox[{"\[Delta]", "[", "t", "]"}], "]"}], " ", 
          RowBox[{
           SuperscriptBox["\[Delta]", "\[Prime]",
            MultilineFunction->None], "[", "t", "]"}], " ", 
