Cell[TextData[{
 "This section is a recap of the standard Euler-Lagrange process, which was \
fully developed in ",
 StyleBox[ButtonBox["Perspectives on energy conservation: discrete \
variational spherical pendulum",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3444021"], None},
  ButtonNote->"https://community.wolfram.com/groups/-/m/t/3444021"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 ", April 2025. There are three sub-sections here, copy-pasted and lightly \
edited from that notebook:"
}], "Text",
 CellChangeTimes->{{3.980251471444002*^9, 3.980251534617103*^9}, {
  3.9802515739825783`*^9, 3.980251660922433*^9}, {3.9802657289792128`*^9, 
  3.980265770651466*^9}, {3.9802666259259577`*^9, 3.9802667586251793`*^9}, {
  3.980267075598579*^9, 3.980267076933495*^9}, {3.980280278851801*^9, 
  3.980280321851692*^9}, {3.98028042407204*^9, 3.980280494229422*^9}, {
  3.9802832525670767`*^9, 3.980283284853426*^9}, {3.9804613484910183`*^9, 
  3.9804613635512323`*^9}, {3.980673290132098*^9, 3.980673301665371*^9}, {
  3.980804697623548*^9, 3.9808047206881733`*^9}, {3.980882148449503*^9, 
  3.980882149517713*^9}},ExpressionUUID->"0f434c32-31c2-4ce7-9203-\
0fc0425dad3f"],

