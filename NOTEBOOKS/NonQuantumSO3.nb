Cell[CellGroupData[{

Cell["Gauge Choice", "ItemNumbered",
 CellChangeTimes->{{3.980951601687812*^9, 
  3.98095160604065*^9}},ExpressionUUID->"ce766801-3bfb-441f-bcdf-\
6c164918b16d"],

Cell[TextData[{
 "in electrodynamics (Reference 8), the arbitrary smooth scalar function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", "(", 
    SuperscriptBox["x", 
     RowBox[{" ", "\[Mu]"}]], ")"}], TraditionalForm]],ExpressionUUID->
  "622ffbb4-3a27-41e0-9d5f-bd895dbbc36a"],
 ", representing the local choice of \[OpenCurlyDoubleQuote]zero phase\
\[CloseCurlyDoubleQuote] at every point of spacetime. i.e., the origin of the \
reference frame in which the phase correction is measured"
}], "Subitem",
 CellChangeTimes->{{3.980951633538587*^9, 3.980951801958927*^9}, {
  3.9812422696887608`*^9, 
  3.98124230696758*^9}},ExpressionUUID->"050d3b2f-1e18-4f71-94d3-\
91749ba6ac07"],

Cell["\<\
in this notebook, the specific choice to place the poles of the coordinate \
system on the Equator\
\>", "Subitem",
 CellChangeTimes->{{3.980951783753532*^9, 3.9809518412915173`*^9}, {
  3.981242292503384*^9, 
  3.981242310847722*^9}},ExpressionUUID->"c44d0eb5-79d7-4060-924a-\
338288608363"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Gauge Transformation", "ItemNumbered",
 CellChangeTimes->{{3.9809518519175167`*^9, 
  3.980951856419094*^9}},ExpressionUUID->"06f54004-23c0-4c9e-a37f-\
a35412b7f27d"],

Cell[TextData[{
 "in electrodynamics (Reference 8), the unitary operator ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{" ", 
     RowBox[{"\[ImaginaryI]", " ", "q", " ", "\[CapitalLambda]"}]}]], 
   TraditionalForm]],ExpressionUUID->"3ae7c3fb-a2e9-40e0-989f-b1ee4028c9d0"],
 " that multiplies the matter field"
}], "Subitem",
 CellChangeTimes->{{3.980951633538587*^9, 3.980951801958927*^9}, {
  3.9809518958343973`*^9, 3.9809519276872997`*^9}, {3.981242300240315*^9, 
  3.9812423243891497`*^9}},ExpressionUUID->"5ce4d447-78bf-4aef-88aa-\
527682dbfb8f"],

Cell[TextData[{
 "in this notebook, the rotation matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["R", "X"], "(", "\[Eta]", ")"}], 
    RowBox[{
     SubscriptBox["R", "Y"], "(", "\[Delta]", ")"}]}], TraditionalForm]],
  ExpressionUUID->"47fc6ba1-3b43-41c3-96a1-c424921b93ed"],
 ", which you can see as ",
