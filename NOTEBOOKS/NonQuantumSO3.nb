Cell[TextData[{
 Cell[BoxData[
  FormBox["\[Eta]", TraditionalForm]],ExpressionUUID->
  "333c0beb-4b25-4181-a43c-d8d2a5f2aaf7"],
 ", measuring angle counterclockwise around the original X axis. Call it ",
 StyleBox["cone-roll",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "."
}], "Item",
