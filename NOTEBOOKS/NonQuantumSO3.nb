      FontSize->16,
      FontWeight->Bold], 
     StyleBox["\<\"Geometrical Interpretation\"\>",
      StripOnInput->False,
      FontFamily->"Arial",
      FontSize->16,
      FontWeight->Bold]},
    {
     StyleBox["\<\"\\!\\(\\*SubsuperscriptBox[\\(\[CapitalGamma]\\), \
\\(\[Eta]\[Eta]\\), \\(\[Delta]\\)]\\)\"\>",
      StripOnInput->False,
      FontSize->14], 
     StyleBox["\<\"\[NotEqual] 0\"\>",
      StripOnInput->False,
      LineColor->RGBColor[1, 0, 0],
      FrontFaceColor->RGBColor[1, 0, 0],
      BackFaceColor->RGBColor[1, 0, 0],
      GraphicsColor->RGBColor[1, 0, 0],
      FontWeight->Bold,
      FontColor->RGBColor[
       1, 0, 0]], "\<\"Spinning in \[Eta]\"\>", "\<\"Push in \[Delta]\"\>", "\
\<\"Centrifugal Force:\\n\\\"Spinning makes you fly outward.\\\"\"\>"},
    {
     StyleBox["\<\"\\!\\(\\*SubsuperscriptBox[\\(\[CapitalGamma]\\), \\(\
\[Delta]\[Eta]\\), \\(\[Eta]\\)]\\)\"\>",
      StripOnInput->False,
      FontSize->14], 
     StyleBox["\<\"\[NotEqual] 0\"\>",
      StripOnInput->False,
      LineColor->RGBColor[1, 0, 0],
      FrontFaceColor->RGBColor[1, 0, 0],
      BackFaceColor->RGBColor[1, 0, 0],
      GraphicsColor->RGBColor[1, 0, 0],
      FontWeight->Bold,
      FontColor->RGBColor[
       1, 0, 0]], "\<\"Mixing \[Delta] and \[Eta]\"\>", "\<\"Push in \[Eta]\"\
\>", "\<\"Coriolis Force:\\n\\\"Dipping while spinning swerves you \
sideways.\\\"\"\>"},
    {
     StyleBox["\<\"\\!\\(\\*SubsuperscriptBox[\\(\[CapitalGamma]\\), \\(\
\[Delta]\[Delta]\\), \\(\[Eta]\\)]\\)\"\>",
      StripOnInput->False,
