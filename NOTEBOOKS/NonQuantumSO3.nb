   TraditionalForm]],ExpressionUUID->"0a258c6a-f991-45bd-8286-c54be78cc9f2"]
}], "Subitem",
 CellChangeTimes->{{3.980951783753532*^9, 3.9809518412915173`*^9}, {
  3.980952093628097*^9, 3.980952122799852*^9}, {3.9812423388705063`*^9, 
