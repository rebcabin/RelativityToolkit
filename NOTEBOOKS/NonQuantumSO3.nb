Cell[TextData[{
 "Visualize the 2D, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"\[Delta]", ",", "\[Eta]"}], "\[NonBreakingSpace]", "}"}], 
   TraditionalForm]],ExpressionUUID->"fa11a741-fd46-4ad4-91dc-eaa2c2c22c0d"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{
     RowBox[{"O", "(", "3", ")"}], "/", "S"}], "\[VeryThinSpace]", 
    RowBox[{"O", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "cb541bc8-c777-4ac2-9ddf-8034c4f28e3f"],
 " coordinate system, common to both the old Euler-Lagrange process and to \
the new geometric derivation."
}], "Item",
