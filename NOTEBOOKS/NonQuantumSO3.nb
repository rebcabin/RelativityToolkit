Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"e1", ",", "e2", ",", "e3", ",", "o", ",", "g", ",", "plotRg"}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e1", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";", 
  RowBox[{"e2", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ";", 
  RowBox[{"e3", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"o", "=", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", 
   RowBox[{"g", "=", "9.81"}], ";", 
   RowBox[{"plotRg", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.25"}], ",", "1.25"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "cm", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"cm", "[", 
      RowBox[{"{", 
       RowBox[{"\[Delta]_", ",", "\[Eta]_"}], "}"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"RotationMatrix", "[", 
       RowBox[{"\[Eta]", ",", "e1"}], "]"}], " ", ".", " ", 
      RowBox[{"RotationMatrix", "[", 
       RowBox[{"\[Delta]", ",", "e2"}], "]"}], " ", ".", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", 
        RowBox[{"Subscript", "[", 
         RowBox[{"c", ",", " ", "z"}], "]"}]}], "}"}]}]}], ")"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "zh", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"zh", "[", 
     RowBox[{"{", 
      RowBox[{"\[Delta]_", ",", "\[Eta]_"}], "}"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"cm", "[", 
      RowBox[{"{", 
       RowBox[{"\[Delta]", ",", "\[Eta]"}], "}"}], "]"}], "[", 
     RowBox[{"[", "3", "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "numRules", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"numRules", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Delta]", "[", "t", "]"}], "->", "\[Delta]"}], ",", 
      RowBox[{
       RowBox[{"\[Eta]", "[", "t", "]"}], "->", "\[Eta]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Delta]", "'"}], "[", "t", "]"}], "->", "D\[Delta]"}], ",", 
      
      RowBox[{
       RowBox[{
        RowBox[{"\[Eta]", "'"}], "[", "t", "]"}], "->", "D\[Eta]"}], ",", 
      RowBox[{"m", "->", "1"}], ",", 
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"c", ",", " ", "z"}], "]"}], "->", "1.2"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"Vnum", ",", "V"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", 
    RowBox[{"{", 
     RowBox[{"\[Delta]_", ",", "\[Eta]_"}], "}"}], "]"}], ":=", 
   RowBox[{"m", " ", "g", " ", 
    RowBox[{"zh", "[", 
     RowBox[{"{", 
      RowBox[{"\[Delta]", ",", "\[Eta]"}], "}"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Vnum", "[", 
     RowBox[{"{", 
      RowBox[{"\[Delta]_", ",", "\[Eta]_"}], "}"}], "]"}], "=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"V", "[", 
        RowBox[{"{", 
         RowBox[{"\[Delta]", ",", "\[Eta]"}], "}"}], "]"}], ")"}], "/.", 
      "numRules"}], ")"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "v", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"v", "[", 
      RowBox[{"{", 
       RowBox[{"\[Delta]_", ",", "\[Eta]_"}], "}"}], "]"}], ":=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"cm", "[", 
        RowBox[{"{", 
         RowBox[{"\[Delta]", ",", "\[Eta]"}], "}"}], "]"}], ",", "t"}], 
      "]"}]}], ")"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"Tnum", ",", "T"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"T", "[", 
     RowBox[{"{", 
      RowBox[{"\[Delta]_", ",", "\[Eta]_"}], "}"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", "m", " ", 
     RowBox[{
      RowBox[{"v", "[", 
       RowBox[{"{", 
        RowBox[{"\[Delta]", ",", "\[Eta]"}], "}"}], "]"}], " ", ".", " ", 
      RowBox[{"v", "[", 
       RowBox[{"{", 
        RowBox[{"\[Delta]", ",", "\[Eta]"}], "}"}], "]"}]}]}]}], ")"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Tnum", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Delta]_", ",", "\[Eta]_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"D\[Delta]_", ",", "D\[Eta]_"}], "}"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{
     RowBox[{"(", "1.2", ")"}], "^", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"D\[Delta]", "^", "2"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"Cos", "[", 
            RowBox[{"2", "\[Delta]"}], "]"}]}], ")"}]}], ")"}], 
       RowBox[{"D\[Eta]", "^", "2"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Tnum", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Delta]_", ",", "\[Eta]_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"D\[Delta]_", ",", "D\[Eta]_"}], "}"}]}], "]"}], "=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"T", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Delta]", "[", "t", "]"}], ",", 
          RowBox[{"\[Eta]", "[", "t", "]"}]}], "}"}], "]"}], "/.", 
       "numRules"}], "//", "FullSimplify"}], ")"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"Lnum", ",", "L"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"L", "[", 
      RowBox[{"{", 
       RowBox[{"\[Delta]_", ",", "\[Eta]_"}], "}"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"T", "[", 
       RowBox[{"{", 
        RowBox[{"\[Delta]", ",", "\[Eta]"}], "}"}], "]"}], "-", 
      RowBox[{"V", "[", 
       RowBox[{"{", 
        RowBox[{"\[Delta]", ",", "\[Eta]"}], "}"}], "]"}]}]}], ")"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "Leqns", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Lcrds", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Delta]", "[", "t", "]"}], ",", 
         RowBox[{"\[Eta]", "[", "t", "]"}]}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Lvels", "=", 
         RowBox[{"D", "[", 
          RowBox[{"Lcrds", ",", "t"}], "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Lncnf", "=", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"non", "-", 
           RowBox[{"conservative", " ", "forces"}]}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"Leqns", "=", 
          RowBox[{"Flatten", "@", 
           RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"q", ",", "v", ",", "f"}], "}"}], "|->", 
              RowBox[{
               RowBox[{
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"L", "[", "Lcrds", "]"}], ",", "v"}], "]"}], ",", 
                  "t"}], "]"}], "-", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"L", "[", "Lcrds", "]"}], ",", "q"}], "]"}]}], "==",
                "f"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"Lcrds", ",", "Lvels", ",", "Lncnf"}], "}"}]}], 
            "]"}]}]}]}], "]"}]}], "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "stEqns", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"stEqns", "=", 
    RowBox[{"Equal", "@@@", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{"Leqns", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Delta]", "''"}], "[", "t", "]"}], ",", 
             RowBox[{
              RowBox[{"\[Eta]", "''"}], "[", "t", "]"}]}], "}"}]}], "]"}], "//",
          "FullSimplify"}], "//", "Chop"}], "//", 
       RowBox[{
        RowBox[{"Part", "[", 
         RowBox[{"#", ",", "1"}], "]"}], "&"}]}], ")"}]}]}], ")"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"stEqns", "//", "TableForm"}], 
     ",", "\"\<State-space equations (stEqns) :\>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"tLim", ",", "initialConditions", ",", "stSolns"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tLim", "=", "200"}], ";"}]}], "Input",
 CellChangeTimes->{{3.98026473143565*^9, 3.980264876458035*^9}, {
