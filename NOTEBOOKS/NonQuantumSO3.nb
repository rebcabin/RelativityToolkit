   3.980882473837809*^9},ExpressionUUID->"381b5ee2-add6-4234-8494-\
887f5f709523"],

Cell[TextData[{
 "This global coordinate system will be as good as any in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "00643f99-dbb9-4f54-8c8a-2dbdadc10f17"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{
     RowBox[{"O", "(", "3", ")"}], "/", "S"}], "\[VeryThinSpace]", 
    RowBox[{"O", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "9f39da96-6948-4dff-9106-bb647dfaa4e3"],
 " for numerical integration. "
}], "Text",
 CellChangeTimes->{{3.980282151016324*^9, 3.980282197470771*^9}, {
   3.980282311472803*^9, 3.980282384316176*^9}, 3.980805115602174*^9, {
   3.9808805932810793`*^9, 3.9808806542941847`*^9}, {3.980930359168638*^9, 
   3.980930462795257*^9}, {3.98095321863964*^9, 3.980953233173308*^9}, {
   3.980978072411787*^9, 3.980978089502651*^9}, {3.981239489648273*^9, 
   3.98123949330477*^9}, 
   3.9812395248901577`*^9},ExpressionUUID->"08aeb36b-5f97-4507-8653-\
4f368216f7f3"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["One way out of the singularity trap is multiple coordinate systems \
with transition functions in overlap areas. That\[CloseCurlyQuote]s a good \
solution, but much more complicated than going to ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "1a051e32-e91e-4564-9381-e81365a44e23"],
 StyleBox[", which double-covers the sphere with no singularity. When we go \
to ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "6a27a74b-8347-4c9d-868b-c6b19029c351"],
 StyleBox[" in an upcoming notebook, there will be no poles to worry about.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.980282151016324*^9, 3.980282197470771*^9}, {
   3.980282311472803*^9, 3.980282384316176*^9}, 3.980805115602174*^9, {
   3.9808805932810793`*^9, 3.9808806542941847`*^9}, {3.980930359168638*^9, 
   3.980930462795257*^9}, {3.98095321863964*^9, 3.980953233173308*^9}, {
   3.980978072411787*^9, 3.980978089502651*^9}, {3.981239489648273*^9, 
   3.98123949330477*^9}},ExpressionUUID->"5f85026b-c5f0-4219-8370-\
dd1c2fe6c798"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "rig", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"l", "=", "1.2"}], ",", 
      RowBox[{"mass", "=", "1.0"}], ",", 
      RowBox[{"d", "=", "2.4"}], ",", 
      RowBox[{"r", "=", "0.02"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"baton", "=", 
       RowBox[{"Cylinder", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", 
             RowBox[{"-", "l"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", 
             RowBox[{"+", "l"}]}], "}"}]}], "}"}], ",", "r"}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"batonCenterBodyFrame", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "l"}], "}"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"rig", "[", "\"\<graphics primitives\>\"", "]"}], "=", 
      "baton"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rig", "[", "\"\<moment of inertia\>\"", "]"}], "=", 
      "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Ib", "=", 
          RowBox[{"mass", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"MomentOfInertia", "[", "baton", "]"}], "/", 
             RowBox[{"Volume", "[", "baton", "]"}]}], ")"}]}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"Ibi", "=", 
          RowBox[{"Inverse", "@", "Ib"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"Ib", ",", "Ibi"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rig", "[", "\"\<cb\>\"", "]"}], ":=", "batonCenterBodyFrame"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rig", "[", "\"\<half length\>\"", "]"}], ":=", "l"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rig", "[", "\"\<mass\>\"", "]"}], ":=", "mass"}], ";"}]}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "jack", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"jack", "[", 
    RowBox[{"0", ",", 
     RowBox[{"opacity_", ":", "0.1"}], ",", 
     RowBox[{"diameter_", ":", "0.01"}]}], "]"}], ":=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Opacity", "[", "opacity", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"Red", ",", 
       RowBox[{"Arrow", "[", 
        RowBox[{
         RowBox[{"Tube", "[", 
          RowBox[{"{", 
           RowBox[{"o", ",", "e1"}], "}"}], "]"}], ",", "diameter"}], "]"}]}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Darker", "[", "Green", "]"}], ",", 
       RowBox[{"Arrow", "[", 
        RowBox[{
         RowBox[{"Tube", "[", 
          RowBox[{"{", 
           RowBox[{"o", ",", "e2"}], "}"}], "]"}], ",", "diameter"}], "]"}]}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Lighter", "[", "Blue", "]"}], ",", 
       RowBox[{"Arrow", "[", 
        RowBox[{
         RowBox[{"Tube", "[", 
          RowBox[{"{", 
           RowBox[{"o", ",", "e3"}], "}"}], "]"}], ",", "diameter"}], "]"}]}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Lighter", "[", "Cyan", "]"}], ",", 
       RowBox[{"Arrow", "[", 
        RowBox[{
         RowBox[{"Tube", "[", 
          RowBox[{"{", 
           RowBox[{"o", ",", 
            RowBox[{"-", "e1"}]}], "}"}], "]"}], ",", "diameter"}], "]"}]}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"Magenta", ",", 
       RowBox[{"Arrow", "[", 
        RowBox[{
         RowBox[{"Tube", "[", 
          RowBox[{"{", 
           RowBox[{"o", ",", 
            RowBox[{"-", "e2"}]}], "}"}], "]"}], ",", "diameter"}], "]"}]}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"Yellow", ",", 
       RowBox[{"Arrow", "[", 
        RowBox[{
         RowBox[{"Tube", "[", 
          RowBox[{"{", 
           RowBox[{"o", ",", 
            RowBox[{"-", "e3"}]}], "}"}], "]"}], ",", "diameter"}], "]"}]}], 
      "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"epsilon", "=", "0.0001"}], ",", 
     RowBox[{"h", "=", 
      RowBox[{"1", "/", "15."}]}], ",", 
     RowBox[{"w", "=", 
      RowBox[{"1", "/", "4."}]}], ",", 
     RowBox[{"vu", "=", "3."}], ",", 
     RowBox[{"o", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"thin", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", ".0001"}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"cb", "=", 
      RowBox[{"rig", "[", "\"\<cb\>\"", "]"}]}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"kart", "=", 
      RowBox[{"Cuboid", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "w"}], ",", 
          RowBox[{"-", "w"}], ",", "epsilon"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"w", ",", "w", ",", 
          RowBox[{"epsilon", "+", "h"}]}], "}"}]}], "]"}]}], ",", 
     RowBox[{"s", "=", "2"}], ",", "\[IndentingNewLine]", 
     RowBox[{"floor", "=", 
      RowBox[{"Polygon", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "vu"}], ",", 
           RowBox[{"-", "vu"}], ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"vu", ",", 
           RowBox[{"-", "vu"}], ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"vu", ",", "vu", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "vu"}], ",", "vu", ",", "0"}], "}"}]}], "}"}], 
       "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"c3", "=", 
      RowBox[{"Cylinder", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"o", ",", "thin"}], "}"}], ",", 
        RowBox[{"s", " ", 
         RowBox[{"cb", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"b3", "=", 
      RowBox[{"Sphere", "[", 
       RowBox[{"o", ",", 
        RowBox[{"s", " ", 
         RowBox[{"cb", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}]}], ",", 
     RowBox[{"t3x", "=", 
      RowBox[{"Tube", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "s"}], " ", 
           RowBox[{"cb", "[", 
            RowBox[{"[", "3", "]"}], "]"}], " ", "e2"}], ",", 
          RowBox[{"s", " ", 
           RowBox[{"cb", "[", 
            RowBox[{"[", "3", "]"}], "]"}], " ", "e2"}]}], "}"}], ",", 
        ".01"}], "]"}]}], ",", 
     RowBox[{"axisLabelStyle", "=", 
      RowBox[{"text", "|->", 
       RowBox[{"Style", "[", 
        RowBox[{"text", ",", "Red", ",", "Bold", ",", "18", ",", 
         RowBox[{"FontFamily", "->", "\"\<Courier New\>\""}]}], "]"}]}]}]}], 
    "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"DynamicModule", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"renderPos", "=", "o"}], ",", 
         RowBox[{"\[CapitalSigma]\[Tau]s", "=", "o"}], ",", "cs", ",", 
         "rotfn"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"cs", "=", 
         RowBox[{
          RowBox[{"RotationMatrix", "[", 
           RowBox[{"\[Eta]", ",", "e1"}], "]"}], ".", 
          RowBox[{"RotationMatrix", "[", 
           RowBox[{"\[Delta]", ",", "e2"}], "]"}], ".", "cb"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"renderPos", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"cs", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], " ", "e1"}], "-", 
          RowBox[{
           RowBox[{"cs", "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", "e2"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rotfn", "=", 
         RowBox[{
          RowBox[{"RotationTransform", "[", 
           RowBox[{"\[Eta]", ",", "e1"}], "]"}], "@*", 
          RowBox[{"RotationTransform", "[", 
           RowBox[{"\[Delta]", ",", "e2"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Show", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Graphics3D", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"GeometricTransformation", "[", 
                RowBox[{
                 RowBox[{"jack", "[", "0", "]"}], ",", "rotfn"}], "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"Black", ",", "t3x"}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"White", ",", 
                 RowBox[{"Opacity", "[", 
                  RowBox[{".7", "/", "8"}], "]"}], ",", "c3", ",", "b3", ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"GeometricTransformation", "[", 
                  RowBox[{"c3", ",", 
                   RowBox[{"RotationTransform", "[", 
                    RowBox[{"\[Delta]", ",", "e2"}], "]"}]}], "]"}]}], "}"}], 
               ",", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"Red", ",", 
                 RowBox[{"Sphere", "[", 
                  RowBox[{
                   RowBox[{"s", " ", "cs"}], ",", 
                   RowBox[{"1", "/", "16."}]}], "]"}]}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"Yellow", ",", 
                 RowBox[{"Opacity", "[", 
                  RowBox[{".3", "/", "4"}], "]"}], ",", "floor"}], "}"}], ",",
                "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"Green", ",", 
                 RowBox[{"Opacity", "[", ".6", "]"}], ",", 
                 RowBox[{"Translate", "[", 
                  RowBox[{"kart", ",", "renderPos"}], "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"White", ",", 
                 RowBox[{"Opacity", "[", ".75", "]"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"Translate", "[", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Translate", "[", 
                    RowBox[{
                    RowBox[{"GeometricTransformation", "[", 
                    RowBox[{
                    RowBox[{"rig", "[", "\"\<graphics primitives\>\"", "]"}], 
                    ",", "rotfn"}], "]"}], ",", "cs"}], "]"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{"renderPos", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"epsilon", "+", "h"}], ")"}], " ", "e3"}]}]}], 
                  "]"}]}], "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{"ImageSize", "->", "Large"}], ",", 
             RowBox[{"Axes", "->", "True"}], ",", 
             RowBox[{"AxesLabel", "->", 
              RowBox[{"axisLabelStyle", "/@", 
               RowBox[{"{", 
                RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], 
                "}"}]}]}], ",", "\[IndentingNewLine]", 
             RowBox[{"PlotRange", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "vu"}], ",", "vu"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "vu"}], ",", "vu"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "vu"}], ",", "vu"}], "}"}]}], "}"}]}]}], "]"}],
            ",", "\[IndentingNewLine]", 
           RowBox[{"ParametricPlot3D", "[", 
            RowBox[{
             RowBox[{"s", " ", 
              RowBox[{
               RowBox[{"RotationMatrix", "[", 
                RowBox[{"ha", ",", "e1"}], "]"}], ".", 
               RowBox[{"RotationMatrix", "[", 
                RowBox[{"\[Delta]", ",", "e2"}], "]"}], ".", "cb"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"ha", ",", "0", ",", 
               RowBox[{"2", " ", "\[Pi]"}]}], "}"}]}], "]"}]}], "}"}], 
         "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Delta]", ",", 
         RowBox[{"10", " ", "\[Degree]"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"-", "360"}], " ", "\[Degree]"}], ",", 
       RowBox[{"360", " ", "\[Degree]"}], ",", 
       RowBox[{"1", " ", "\[Degree]"}], ",", 
       RowBox[{"Appearance", "->", 
        RowBox[{"{", "\"\<Open\>\"", "}"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Eta]", ",", 
         RowBox[{"0", " ", "\[Degree]"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"-", "360"}], " ", "\[Degree]"}], ",", 
       RowBox[{"360", " ", "\[Degree]"}], ",", 
       RowBox[{"1", " ", "\[Degree]"}], ",", 
       RowBox[{"Appearance", "->", 
        RowBox[{"{", "\"\<Open\>\"", "}"}]}]}], "}"}]}], "]"}]}], 
  "]"}]}], "Input",
