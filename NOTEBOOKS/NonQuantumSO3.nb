Cell[BoxData[
 RowBox[{
  TagBox["\<\"\\!\\(\\*SuperscriptBox[\\(g3\\), \\(\\\\ \\(\[Mu]\\\\ \[Nu]\\)\
\\)]\\) :\"\>",
   "EchoLabel"], "  ", 
