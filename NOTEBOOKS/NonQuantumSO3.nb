Cell[BoxData[
 RowBox[{
  TagBox["\<\"\\!\\(\\*SubscriptBox[\\(g3\\), \\(\\\\ \\(\[Mu]\\\\ \
\[Nu]\\)\\)]\\) :\"\>",
   "EchoLabel"], "  ", 
