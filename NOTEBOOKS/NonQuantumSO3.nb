Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "CurvatureForcesUD", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CurvatureForcesUD", "[", "\[IndentingNewLine]", 
    RowBox[{
    "gDD_Symbol", ",", " ", "gDDRules_", ",", "\[IndentingNewLine]", 
     "gUU_Symbol", ",", " ", "gUURules_", ",", "\[IndentingNewLine]", 
     "time_Symbol", ",", "\[IndentingNewLine]", "coords_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["injectTime",
        FontColor->RGBColor[0, 0.74, 0.74]], "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"c", "|->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"c", "->", 
              RowBox[{"c", "[", "time", "]"}]}], ",", 
             RowBox[{
              RowBox[{"c", "'"}], "->", 
              RowBox[{
               RowBox[{"c", "'"}], "[", "time", "]"}]}]}], "}"}]}], ")"}], "/@",
          "coords"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ContractIndexedAll", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Nu]", ",", "\[Lambda]"}], "}"}], "|->", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"CalculateGammaComponent", "[", "\[IndentingNewLine]", 
              RowBox[{
              "\[Mu]", ",", "\[Nu]", ",", "\[Lambda]", ",", 
               "\[IndentingNewLine]", "gDD", ",", " ", "gDDRules", ",", 
               "\[IndentingNewLine]", "gUU", ",", " ", "gUURules", ",", 
               "\[IndentingNewLine]", "coords"}], "]"}], "/.", "injectTime"}],
             ")"}], "*", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"\[Nu]", "[", "time", "]"}], ",", " ", "time"}], "]"}], 
           " ", "*", " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"\[Lambda]", "[", "time", "]"}], ",", " ", "time"}], 
            "]"}]}]}], ",", "\[IndentingNewLine]", "coords"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"\[Mu]", ",", "coords"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.980538361507511*^9, 3.980538383078609*^9}, {
