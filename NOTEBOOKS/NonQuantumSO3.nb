Cell[TextData[{
 "Here\[CloseCurlyQuote]s were we use ",
 StyleBox["GradRaised", "Input",
  FontColor->RGBColor[0.8, 0.3, 0.8]],
 ". "
}], "Text",
 CellChangeTimes->{{3.980706038896451*^9, 
  3.98070605825956*^9}},ExpressionUUID->"866a87d4-f02c-4f71-afa6-\
