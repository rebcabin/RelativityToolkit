Cell[CellGroupData[{

Cell[TextData[{
 "Curvature Forces ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", 
      RowBox[{"\[Nu]", " ", "\[Lambda]"}]}], 
     RowBox[{" ", "\[Mu]"}]], 
    SuperscriptBox[
     OverscriptBox["x", "\[FilledSmallCircle]"], 
     RowBox[{" ", "\[Nu]"}]], 
    SuperscriptBox[
     OverscriptBox["x", "\[FilledSmallCircle]"], 
     RowBox[{" ", "\[Lambda]"}]]}], TraditionalForm]],ExpressionUUID->
  "4a2b2d70-10fa-4099-b001-f34af803a210"]
