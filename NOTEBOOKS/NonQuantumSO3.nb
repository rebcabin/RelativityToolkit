   3.980881959773122*^9}, {3.9808819947098017`*^9, 3.9808820146356497`*^9}, {
   3.980952522036831*^9, 3.9809525626528473`*^9}, {3.980952610718706*^9, 
   3.9809526517196836`*^9}, {3.980976863581985*^9, 3.980976864869096*^9}, 
