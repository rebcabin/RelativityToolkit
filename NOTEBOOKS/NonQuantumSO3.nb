Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"nfm", ",", "vfm", ",", "font", ",", "myFont"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"myFont", "[", 
    RowBox[{"color_", ",", 
     RowBox[{"size_", ":", "18"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Style", "[", 
     RowBox[{"#", ",", "color", ",", "Bold", ",", "size", ",", 
      RowBox[{"FontFamily", "->", "\"\<Courier New\>\""}]}], "]"}], "&"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nfm", "[", 
    RowBox[{"num_", ",", 
     RowBox[{"dig_", ":", "10"}], ",", 
     RowBox[{"dec_", ":", "4"}]}], "]"}], ":=", 
   RowBox[{"ToString", "[", 
    RowBox[{"NumberForm", "[", 
     RowBox[{
      RowBox[{"Chop", "@", "num"}], ",", 
      RowBox[{"{", 
       RowBox[{"dig", ",", "dec"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vfm", "[", "vec_", "]"}], ":=", 
   RowBox[{"ToString", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"NumberForm", "[", 
       RowBox[{"#", ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "4"}], "}"}], ",", 
        RowBox[{"NumberSigns", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<-\>\"", ",", "\"\< \>\""}], "}"}]}], ",", 
        RowBox[{"NumberPadding", "->", 
         RowBox[{"{", 
          RowBox[{"\"\< \>\"", ",", "\"\<0\>\""}], "}"}]}]}], "]"}], "&"}], "/@", 
     RowBox[{"Chop", "@", "vec"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"font", "=", 
   RowBox[{"myFont", "[", 
    RowBox[{
     RowBox[{"Lighter", "[", "Blue", "]"}], ",", "12"}], "]"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"epsilon", "=", "0.0001"}], ",", 
     RowBox[{"h", "=", 
      RowBox[{"1", "/", "15."}]}], ",", 
