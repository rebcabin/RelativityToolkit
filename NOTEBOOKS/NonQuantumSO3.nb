Cell[CellGroupData[{

Cell["Connection and Equations of Motion", "Subsection",
 CellChangeTimes->{{3.9805527297351847`*^9, 3.980552731182493*^9}, {
  3.980885265623434*^9, 
  3.980885270290113*^9}},ExpressionUUID->"fd364366-5ee4-4f54-82c7-\
a444a049bfa1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalGamma]3", "[", 
    RowBox[{"\[Mu]_", ",", "\[Nu]_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{"ChristoffelsFromMetricIndexer", "[", 
    RowBox[{
    "g3", ",", "ig3", ",", "\[Mu]", ",", "\[Nu]", ",", "\[Lambda]", ",", 
     "coords3"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\[CapitalGamma]3", "[", 
         RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Lambda]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Mu]", ",", "coords3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Nu]", ",", "coords3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Lambda]", ",", "coords3"}], "}"}]}], "]"}], "//", 
      "FullSimplify"}], "//", "MatrixForm"}], 
    ",", "\"\<\!\(\*SubsuperscriptBox[\(\[CapitalGamma]3\), \
\(\[Nu]\[Lambda]\), \(\[Mu]\)]\) :\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"ad3", "=", 
       RowBox[{
        RowBox[{"AbsoluteDerivativeFromConnectionIndexer", "[", 
