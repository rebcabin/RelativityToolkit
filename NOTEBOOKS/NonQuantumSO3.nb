Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["The z component of the angular momentum is conserved because there \
is no gravitational torque in the z direction. A routine calculation shows \
the z component of angular momentum to be proportional to ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"x", "\[VeryThinSpace]", 
      OverscriptBox["y", "\[FilledSmallCircle]"]}], "-", 
     RowBox[{"y", "\[VeryThinSpace]", 
      OverscriptBox["x", "\[FilledSmallCircle]"]}]}], ")"}], 
   TraditionalForm]],ExpressionUUID->"9ab5c2cf-3f7c-4eac-b0ed-9a1706fbd841"],
 StyleBox[" with ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{
     SubscriptBox["c", "z"], "sin", " ", "\[Delta]"}]}], TraditionalForm]],
  ExpressionUUID->"a14d3a7d-c211-419b-bd4f-a0331e8a22a1"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", 
    RowBox[{
     SubscriptBox["c", "z"], "cos", " ", "\[Delta]", " ", "sin", " ", 
     "\[Eta]"}]}], TraditionalForm]],ExpressionUUID->
  "565ff23b-20d1-4224-8d7e-dc7e93bb629a"],
 "."
}], "Item",
 CellChangeTimes->{{3.9806813493660517`*^9, 3.9806815847891703`*^9}, {
  3.980953364007895*^9, 3.9809533671540194`*^9}, {3.981239826821487*^9, 
  3.981239861529183*^9}},ExpressionUUID->"c1fc764c-a301-4c8a-bf56-\
8fa06f0ec962"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z", ",", "r", ",", "p"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "[", "t", "]"}], "=", 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Delta]", "[", "t", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"y", "[", "t", "]"}], "=", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[Delta]", "[", "t", "]"}], "]"}], 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Eta]", "[", "t", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"z", "[", "t", "]"}], "=", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[Delta]", "[", "t", "]"}], "]"}], 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Eta]", "[", "t", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"r", "[", "t", "]"}], "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "[", "t", "]"}], ",", 
         RowBox[{"y", "[", "t", "]"}], ",", 
         RowBox[{"z", "[", "t", "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{
       RowBox[{"p", "[", "t", "]"}], "=", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"r", "[", "t", "]"}], ",", "t"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "fetch", " ", "Z", " ", "component", " ", "at", " ", "index", " ", 
        "3"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"r", "[", "t", "]"}], "\[Cross]", 
          RowBox[{"p", "[", "t", "]"}]}], ")"}], "[", 
        RowBox[{"[", "3", "]"}], "]"}], "//", "FullSimplify"}]}]}], "]"}], "//", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
     "#", ",", "\"\<\!\(\*SubscriptBox[\(p\), \(z\)]\) conserved :\>\""}], 
     "]"}], "&"}]}], ";"}]], "Input",
