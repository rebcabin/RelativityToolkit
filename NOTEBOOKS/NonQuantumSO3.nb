              RowBox[{"D\[Psi]", "=", 
               RowBox[{"D\[Psi]x", "/.", " ", 
                RowBox[{"t", "->", "u"}]}]}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"cs", "=", 
