Cell[CellGroupData[{

Cell["\<\
Reformulate in geometric terms, with kinetic energy as the metric tensor, and \
potential energy as a scalar gradient field.\
\>", "Item",
 CellChangeTimes->{{3.980276862033346*^9, 3.9802769235149193`*^9}, {
   3.980331819070505*^9, 3.9803318288046923`*^9}, {3.9807751932715187`*^9, 
