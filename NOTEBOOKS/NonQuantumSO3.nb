f2fc94e4a81c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"D", "\[VeryThinSpace]", 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], 
       RowBox[{" ", "\[Mu]"}]]}], 
     RowBox[{"d", "\[VeryThinSpace]", "t"}]], " ", "\[Congruent]", " ", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], 
      RowBox[{" ", "\[Nu]"}]], 
     RowBox[{
      SubscriptBox["\[Del]", "\[Nu]"], 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], 
       RowBox[{" ", "\[Mu]"}]]}]}]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{" ", "\[Nu]"}]]}], 
      RowBox[{"\[PartialD]", "t"}]], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "\[FilledSmallCircle]"], 
        RowBox[{" ", "\[Mu]"}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{" ", "\[Nu]"}]]}]]}], "+", 
    RowBox[{
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{" ", 
       RowBox[{"\[Nu]", " ", "\[Lambda]"}]}], 
      RowBox[{" ", "\[Mu]"}]], 
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], 
      RowBox[{" ", "\[Nu]"}]], 
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], 
      RowBox[{" ", "\[Lambda]"}]]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.980439782405652*^9, 3.9804398053624077`*^9}, {
   3.9804398557407713`*^9, 3.980439890480068*^9}, {3.980439934793558*^9, 
