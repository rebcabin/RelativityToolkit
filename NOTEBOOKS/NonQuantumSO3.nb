Cell["\<\
Both angles can endure adding or subtracting any multiple of 360\[Degree]. \
\>", "Text",
 CellChangeTimes->{{3.980282151016324*^9, 3.980282197470771*^9}, {
   3.980282311472803*^9, 3.980282384316176*^9}, 3.980805115602174*^9, {
