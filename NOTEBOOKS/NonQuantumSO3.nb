Cell[BoxData[{
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"gDDrules", "=", 
     RowBox[{"MatrixToUDRules", "[", 
      RowBox[{"gDDMat", ",", "gDD", ",", "\[ScriptCapitalD]", ",", "coords"}],
       "]"}]}], 
    ",", "\"\<\!\(\*SubscriptBox[\(g\), \(\[VeryThinSpace]\(\[Mu]\(\
\[VeryThinSpace]\)\(\[Vee]\)\)\)]\) rules :\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"gUUrules", "=", 
     RowBox[{"MatrixToUDRules", "[", 
      RowBox[{
       RowBox[{"gDDMat", "//", "Inverse"}], ",", "gUU", ",", 
       "\[ScriptCapitalU]", ",", "coords"}], "]"}]}], 
    ",", "\"\<\!\(\*SuperscriptBox[\(g\), \(\[VeryThinSpace]\(\[Mu]\
\[VeryThinSpace]\[Nu]\)\)]\) rules :\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"offDiagonalRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"gUU", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalU]", "[", "a_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalU]", "[", "b_", "]"}]}], "]"}], "/;", 
       RowBox[{"a", "=!=", "b"}]}], "->", "0"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"gDD", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "a_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "b_", "]"}]}], "]"}], "/;", 
       RowBox[{"a", "=!=", "b"}]}], "->", "0"}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9804987858207693`*^9, 3.9804987950316067`*^9}, {
  3.980498836740139*^9, 3.980498888341851*^9}, {3.980548259336348*^9, 
