c507f82e0fcd"],

Cell[TextData[{
 "Further define contraction with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "\[Nu]"], TraditionalForm]],
  ExpressionUUID->"667d02b8-1247-4d60-b21d-7a584b73bc37"],
 " as the ",
 StyleBox["Absolute Derivative",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"D", "/", "d"}], "\[VeryThinSpace]", "t"}], TraditionalForm]],
  ExpressionUUID->"8a35d050-42bb-4d3f-9945-a6f4328be922"],
 " :"
}], "Text",
 CellChangeTimes->{{3.980447564073081*^9, 3.98044758397232*^9}, 
   3.9804612805083857`*^9, {3.980516757072548*^9, 3.980516765053965*^9}, {
