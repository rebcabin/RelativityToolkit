      FontWeight->Bold,
      FontColor->RGBColor[0, 
        Rational[2, 3], 
        0]], "\<\"Moving in \[Delta]\"\>", "\<\"Push in \[Eta]\"\>", \
"\<\"Path Stability:\\n\\\"Walking pure North doesn't drift you \
East.\\\"\"\>"},
    {
     StyleBox["\<\"\\!\\(\\*SubsuperscriptBox[\\(\[CapitalGamma]\\), \\(\
\[Delta]\[Eta]\\), \\(\[Delta]\\)]\\)\"\>",
      StripOnInput->False,
