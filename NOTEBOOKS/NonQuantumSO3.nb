  3.980516614223497*^9}},ExpressionUUID->"ca3df1cf-4b1c-4e7c-a908-\
e33b094ec6aa"],

Cell[TextData[{
 StyleBox["Coordinate accelerations",
  FontColor->RGBColor[0.14, 0.8, 0.14]],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]\[FilledSmallCircle]"], 
    RowBox[{" ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "6d988c6f-04d0-4c95-b5cd-b7871f26b969"],
 " + ",
 StyleBox["inertial accelerations",
  FontColor->RGBColor[0.14, 0.8, 0.14]],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", 
      RowBox[{"\[Nu]", " ", "\[Lambda]"}]}], 
     RowBox[{" ", "\[Mu]"}]], " ", 
    SuperscriptBox[
     OverscriptBox["x", "\[FilledSmallCircle]"], 
     RowBox[{" ", "\[Nu]"}]], " ", 
    SuperscriptBox[
     OverscriptBox["x", "\[FilledSmallCircle]"], 
     RowBox[{" ", "\[Lambda]"}]]}], TraditionalForm]],ExpressionUUID->
  "350d2926-a77d-43ec-b2ef-0086129747ff"],
 " = ",
 StyleBox["forces from potentials",
  FontColor->RGBColor[0.14, 0.8, 0.14]],
 "\[NonBreakingSpace]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["F", 
    RowBox[{" ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "61028df3-0490-4d3e-b7b3-1c9cea209d1f"],
 ". "
}], "Text",
 CellChangeTimes->{{3.980433922759899*^9, 3.98043401131837*^9}, {
  3.980439579020116*^9, 3.980439586051179*^9}, {3.9806883579855947`*^9, 
  3.980688374656452*^9}, {3.9807030245782833`*^9, 3.9807030459636707`*^9}, {
  3.981240001392201*^9, 
  3.981240009459556*^9}},ExpressionUUID->"59eaff24-bfb6-41ac-85a0-\
5eba6a7cec97"],

Cell[TextData[{
 "The left-hand side of Equation 1 is a contraction of coordinate velocity ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "\[Nu]"], TraditionalForm]],
  ExpressionUUID->"1d558360-5799-413f-b378-eacb3d0829cf"],
 " with covariant derivative of the velocity, which has two free indices, \
\[Mu] and \[Nu]:"
}], "Text",
 CellChangeTimes->{{3.980439601196292*^9, 3.980439774016308*^9}, {
  3.980440438648912*^9, 3.9804404610881557`*^9}, {3.9804475383642397`*^9, 
  3.980447545725977*^9}, {3.980461557515997*^9, 3.9804615604105597`*^9}, {
  3.9805184559736347`*^9, 3.9805184763806143`*^9}, {3.980686643120471*^9, 
  3.980686732368631*^9}, {3.980953616628147*^9, 3.9809536346473513`*^9}, {
  3.981240043053957*^9, 
  3.98124004568311*^9}},ExpressionUUID->"ead46821-13a4-43bf-bffe-\
c5021ee55671"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "\[Nu]"], 
    SuperscriptBox[
     OverscriptBox["x", "\[FilledSmallCircle]"], 
     RowBox[{" ", "\[Mu]"}]]}], "\[Congruent]", 
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], 
       RowBox[{" ", "\[Mu]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Nu]"]}]], "+", 
    RowBox[{
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{" ", 
       RowBox[{"\[Nu]", " ", "\[Lambda]"}]}], 
      RowBox[{" ", "\[Mu]"}]], 
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], 
      RowBox[{" ", "\[Lambda]"}]]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.980440090218896*^9, 3.9804401440211077`*^9}, {
   3.980440176938747*^9, 3.98044020774794*^9}, {3.980440254010903*^9, 
   3.980440391720213*^9}, {3.9804404958257923`*^9, 3.980440495827796*^9}, 
   3.980440939431868*^9},ExpressionUUID->"2d00bb2b-9b19-4c4b-be6e-\
3669bc190306"],

Cell[TextData[{
 "Note, for later, that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], 
    RowBox[{" ", "\[Mu]"}]], TraditionalForm]], "DisplayFormulaNumbered",
  CellChangeTimes->{{3.980440090218896*^9, 3.9804401440211077`*^9}, {
    3.980440176938747*^9, 3.98044020774794*^9}, {3.980440254010903*^9, 
    3.980440391720213*^9}, {3.9804404958257923`*^9, 3.980440495827796*^9}, 
    3.980440939431868*^9},ExpressionUUID->
  "ea0910cc-abe2-4d80-bf00-d74bc9f09d1b"],
 " here means a field of tangent vectors, one at at each ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Nu]"], TraditionalForm]], "DisplayFormulaNumbered",
  CellChangeTimes->{{3.980440090218896*^9, 3.9804401440211077`*^9}, {
    3.980440176938747*^9, 3.98044020774794*^9}, {3.980440254010903*^9, 
    3.980440391720213*^9}, {3.9804404958257923`*^9, 3.980440495827796*^9}, 
    3.980440939431868*^9},ExpressionUUID->
  "aa16eb56-a2e0-4d0b-ad5a-8e583cc53b7c"],
 ". Later we will use the same symbol to denote the time derivative of a \
particular function of time,\[NonBreakingSpace]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{" ", "\[Mu]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2e4535d0-ed06-4a70-bc50-92fb69f5e857"],
 ". "
}], "Text",
 CellChangeTimes->{{3.980447564073081*^9, 3.98044758397232*^9}, 
   3.9804612805083857`*^9, {3.980516757072548*^9, 3.980516765053965*^9}, {
   3.980546531649028*^9, 3.980546650977993*^9}, {3.9806867745049553`*^9, 
   3.980686852120089*^9}, {3.980703072556891*^9, 3.980703125912286*^9}, {
