Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "PotentialScalarFieldUD", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PotentialScalarFieldUD", "[", 
     RowBox[{
     "V_", ",", "gUU_Symbol", ",", "gUURules_", ",", "time_Symbol", ",", 
      "coords_"}], "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         StyleBox["injectTime",
          FontColor->RGBColor[0, 0.74, 0.74]], "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"c", "|->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"c", "->", 
                RowBox[{"c", "[", "time", "]"}]}], ",", 
               RowBox[{
                RowBox[{"c", "'"}], "->", 
                RowBox[{
                 RowBox[{"c", "'"}], "[", "time", "]"}]}]}], "}"}]}], ")"}], "/@",
            "coords"}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"GradV", "=", 
         RowBox[{
          StyleBox["GradRaised",
           FontColor->RGBColor[0.8, 0.3, 0.8]], "[", 
          RowBox[{"V", ",", "gUU", ",", "gUURules", ",", "coords"}], 
          "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       StyleBox[
        RowBox[{"-", "GradV"}], "Input"], 
       StyleBox["/.", "Input"], 
       StyleBox["injectTime",
        FontColor->RGBColor[0, 0.74, 0.74]]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"PotentialScalarFieldUD", "[", 
       RowBox[{"V", ",", "gUU", ",", 
        RowBox[{"gUUrules", "~", "Join", "~", "offDiagonalRules"}], ",", "t", 
        ",", "coords"}], "]"}], "//", "\[IndentingNewLine]", "FullSimplify"}],
      "//", "MatrixForm"}], ",", "\"\<-\[Del]V :\>\""}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.98054151945674*^9, 3.9805416322542067`*^9}, {
   3.980541670983786*^9, 3.980541721074951*^9}, {3.9805417612692537`*^9, 
   3.980541809615098*^9}, {3.980541850290814*^9, 3.980541859421288*^9}, {
   3.9805419054061832`*^9, 3.98054195719818*^9}, {3.980541997970042*^9, 
   3.980542109263826*^9}, {3.980548523637779*^9, 3.9805485309391737`*^9}, {
   3.9805485704908457`*^9, 3.980548622862763*^9}, {3.98069214335474*^9, 
   3.980692152212612*^9}, 3.9809556931249*^9},
 CellLabel->"In[86]:=",ExpressionUUID->"618df66b-7255-418d-8d46-5be7c734f5cc"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"-\[Del]V :\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{"(", "\[NoBreak]", 
    TagBox[GridBox[{
       {
        FractionBox[
         RowBox[{"9.81`", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"\[Eta]", "[", "t", "]"}], "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[Delta]", "[", "t", "]"}], "]"}]}], "cz"]},
       {
        FractionBox[
         RowBox[{"9.81`", " ", 
          RowBox[{"Sec", "[", 
           RowBox[{"\[Delta]", "[", "t", "]"}], "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[Eta]", "[", "t", "]"}], "]"}]}], "cz"]}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.5599999999999999]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}],
     Column], "\[NoBreak]", ")"}],
   Function[BoxForm`e$, 
    MatrixForm[BoxForm`e$]]]}]], "Echo",
 CellChangeTimes->{
  3.981237671782839*^9},ExpressionUUID->"84b678a3-3291-4222-a81b-\
b8bfd91317cf"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Final Test", "Subsection",
 CellChangeTimes->{{3.980548630736866*^9, 
  3.980548633938669*^9}},ExpressionUUID->"23ccddc5-c572-4845-84d0-\
4e3d642ae0d3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nEqnsUD", "=", 
   RowBox[{
    RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
     RowBox[{"Equal", ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"AbsoluteDerivativeUD", "[", "\[IndentingNewLine]", 
         RowBox[{"gDD", ",", 
          RowBox[{"gDDrules", "~", "Join", "~", "offDiagonalRules"}], ",", 
          "\[IndentingNewLine]", "gUU", ",", 
          RowBox[{"gUUrules", "~", "Join", "~", "offDiagonalRules"}], ",", 
          "\[IndentingNewLine]", "t", ",", "coords"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PotentialScalarFieldUD", "[", "\[IndentingNewLine]", 
         RowBox[{"V", ",", "\[IndentingNewLine]", "gUU", ",", 
          RowBox[{"gUUrules", "~", "Join", "~", "offDiagonalRules"}], ",", 
          "\[IndentingNewLine]", "t", ",", "coords"}], "]"}]}], "}"}]}], 
     "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{"g", "->", "9.81"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"nStateSpaceFormUD", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{"nEqnsUD", ",", 
           StyleBox["accels",
            FontColor->RGBColor[0.98, 0.56, 0.17]]}], "]"}], "//", 
         "FullSimplify"}], "//", "Flatten"}]}], ")"}], "//", "MatrixForm"}], ",",
     "\[IndentingNewLine]", "\"\<new state-space eqns in \[ScriptCapitalU]\
\[ScriptCapitalD] :\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"nStateSpaceFormUD", "/.", 
        RowBox[{"Rule", "->", "Equal"}]}], "/.", "oStateSpaceForm"}], ")"}], "//",
      "FullSimplify"}], ",", 
    "\[IndentingNewLine]", "\"\<old == new eqns in \[ScriptCapitalU]\
\[ScriptCapitalD] :\>\""}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.98047194712114*^9, 3.980471953749954*^9}, {
   3.980472038112115*^9, 3.980472047907935*^9}, {3.980472341466909*^9, 
   3.980472383658781*^9}, {3.98049982992871*^9, 3.980499835999476*^9}, 
   3.980501507919466*^9, {3.980501640325304*^9, 3.9805016425014257`*^9}, {
   3.980542764240838*^9, 3.980542823566846*^9}, 3.9805430451099997`*^9, 
   3.980548537571432*^9, {3.980706109492898*^9, 3.980706119623968*^9}, {
   3.9807664490924463`*^9, 3.980766511783662*^9}},
 CellLabel->"In[89]:=",ExpressionUUID->"7603f2e6-d66e-4441-8e6c-afd32db6a816"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  TagBox["\<\"new state-space eqns in \[ScriptCapitalU]\[ScriptCapitalD] \
:\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{"(", "\[NoBreak]", 
    TagBox[GridBox[{
       {
