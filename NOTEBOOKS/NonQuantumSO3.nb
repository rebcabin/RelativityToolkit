Cell[BoxData[
 RowBox[{
  TagBox["\<\"State-space equations (stEqns) :\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   TagBox[GridBox[{
      {
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Delta]", "\[Prime]\[Prime]",
          MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"\[Delta]", "[", "t", "]"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            RowBox[{"9.81`", " ", 
             RowBox[{"Cos", "[", 
              RowBox[{"\[Eta]", "[", "t", "]"}], "]"}]}], 
            SubscriptBox["c", "z"]], "-", 
           RowBox[{"1.`", " ", 
            RowBox[{"Cos", "[", 
             RowBox[{"\[Delta]", "[", "t", "]"}], "]"}], " ", 
            SuperscriptBox[
             RowBox[{
              SuperscriptBox["\[Eta]", "\[Prime]",
               MultilineFunction->None], "[", "t", "]"}], "2"]}]}], ")"}]}]}]},
      {
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Eta]", "\[Prime]\[Prime]",
          MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
