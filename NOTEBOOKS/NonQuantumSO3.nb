Cell[TextData[{
 "\[Delta], measuring co-latitude from North. Call it ",
 StyleBox["pitch",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Item",
