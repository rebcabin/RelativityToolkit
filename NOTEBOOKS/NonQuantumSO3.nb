Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"radPerSec", "[", "rpm_", "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"2.", "\[Pi]"}], "60."], "*", "rpm"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"DynamicModule", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ics", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Delta]", "[", "0", "]"}], "==", "\[Delta]0"}], ",", 
          RowBox[{
           RowBox[{"\[Eta]", "[", "0", "]"}], "==", "\[Eta]0"}], ",", 
          RowBox[{
           RowBox[{"\[Psi]", "[", "0", "]"}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Delta]", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Eta]", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Psi]", "'"}], "[", "0", "]"}], "==", "D\[Psi]0"}]}], 
         "}"}]}], ",", "\[IndentingNewLine]", "\[Delta]x", ",", "\[Eta]x", ",",
        "\[Psi]x", ",", "D\[Delta]x", ",", "D\[Eta]x", ",", "D\[Psi]x", ",", 
       "flt"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"soln3", "=", 
       RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Append", "[", 
           RowBox[{"eqns3", ",", "ics"}], "]"}], "//.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"m", "->", "1"}], ",", 
            RowBox[{"cz", "->", "1.2"}], ",", 
            RowBox[{"I1", "->", 
             SuperscriptBox["1.2", "2"]}], ",", 
            RowBox[{"I3", "->", 
             RowBox[{"rI31", "*", "I1"}]}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Delta]", "[", "t", "]"}], ",", 
           RowBox[{"\[Eta]", "[", "t", "]"}], ",", 
           RowBox[{"\[Psi]", "[", "t", "]"}], ",", 
           RowBox[{
            RowBox[{"\[Delta]", "'"}], "[", "t", "]"}], ",", 
           RowBox[{
            RowBox[{"\[Eta]", "'"}], "[", "t", "]"}], ",", 
           RowBox[{
            RowBox[{"\[Psi]", "'"}], "[", "t", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tLim"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Delta]x", "=", 
       RowBox[{"soln3", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
      RowBox[{"D\[Delta]x", "=", 
       RowBox[{"soln3", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "4", ",", "2"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Eta]x", "=", 
       RowBox[{"soln3", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2", ",", "2"}], "]"}], "]"}]}], ";", 
      RowBox[{"D\[Eta]x", "=", 
       RowBox[{"soln3", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "5", ",", "2"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Psi]x", "=", 
       RowBox[{"soln3", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "3", ",", "2"}], "]"}], "]"}]}], ";", 
      RowBox[{"D\[Psi]x", "=", 
       RowBox[{"soln3", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "6", ",", "2"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"flt", "=", 
       RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Delta]\), \(0\)]\) = \>\"", "<>", 
        RowBox[{"ToString", "[", "\[Delta]0", "]"}], 
        "<>", "\"\<\[Degree], \!\(\*SubscriptBox[\(\[Eta]\), \(0\)]\) = \>\"",
         "<>", 
        RowBox[{"ToString", "[", "\[Eta]0", "]"}], 
        "<>", "\"\<\[Degree], \[Psi]\!\(\*SubscriptBox[\('\), \(0\)]\) = \>\"",
         "<>", 
        RowBox[{"ToString", "[", "D\[Psi]0", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"GraphicsGrid", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Plot", "[", 
            RowBox[{
             RowBox[{"\[Delta]x", "/", "\[Degree]"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "0", ",", "tL"}], "}"}], ",", 
             RowBox[{"FrameLabel", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"\"\<\[Delta] [deg]\>\"", ",", "\"\<\>\""}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<t [sec]\>\"", ",", "flt"}], "}"}]}], "}"}]}], ",", 
             RowBox[{"Frame", "->", "True"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Plot", "[", 
            RowBox[{
             RowBox[{"D\[Delta]x", "/", "\[Degree]"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "0", ",", "tL"}], "}"}], ",", 
             RowBox[{"FrameLabel", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 
                 RowBox[{"\"\<\!\(\*SubscriptBox[\(\[DifferentialD]\), \(t\)]\
\)\[Delta] [deg/sec]\>\"", ",", "\"\<\>\""}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<t [sec]\>\"", ",", "flt"}], "}"}]}], "}"}]}], ",", 
             RowBox[{"Frame", "->", "True"}]}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Plot", "[", 
            RowBox[{
             RowBox[{"\[Eta]x", "/", "\[Degree]"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "0", ",", "tL"}], "}"}], ",", 
             RowBox[{"FrameLabel", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"\"\<\[Eta] [deg]\>\"", ",", "\"\<\>\""}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<t [sec]\>\"", ",", "flt"}], "}"}]}], "}"}]}], ",", 
             RowBox[{"Frame", "->", "True"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Plot", "[", 
            RowBox[{
             RowBox[{"D\[Eta]x", "/", "\[Degree]"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "0", ",", "tL"}], "}"}], ",", 
             RowBox[{"FrameLabel", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 
                 RowBox[{"\"\<\!\(\*SubscriptBox[\(\[DifferentialD]\), \(t\)]\
\)\[Eta] [deg/sec]\>\"", ",", "\"\<\>\""}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<t [sec]\>\"", ",", "flt"}], "}"}]}], "}"}]}], ",", 
             RowBox[{"Frame", "->", "True"}]}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Plot", "[", 
            RowBox[{
             RowBox[{"\[Psi]x", "/", "\[Degree]"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "0", ",", "tL"}], "}"}], ",", 
             RowBox[{"FrameLabel", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"\"\<\[Psi] [deg]\>\"", ",", "\"\<\>\""}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<t [sec]\>\"", ",", "flt"}], "}"}]}], "}"}]}], ",", 
             RowBox[{"Frame", "->", "True"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Plot", "[", 
            RowBox[{
             RowBox[{"D\[Psi]x", "/", "\[Degree]"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "0", ",", "tL"}], "}"}], ",", 
             RowBox[{"FrameLabel", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 
                 RowBox[{"\"\<\!\(\*SubscriptBox[\(\[DifferentialD]\), \(t\)]\
\)\[Eta] [deg/sec]\>\"", ",", "\"\<\>\""}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<t [sec]\>\"", ",", "flt"}], "}"}]}], "}"}]}], ",", 
             RowBox[{"Frame", "->", "True"}]}], "]"}]}], "}"}]}], "}"}], 
       "\[IndentingNewLine]", "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Delta]0", ",", 
       RowBox[{"10.", "\[Degree]"}]}], "}"}], ",", "0.", ",", 
     RowBox[{"90.", "\[Degree]"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Eta]0", ",", 
       RowBox[{"5.", "\[Degree]"}]}], "}"}], ",", "0", ",", 
     RowBox[{"90.", "\[Degree]"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"D\[Psi]0", ",", 
       RowBox[{"10", "//", "radPerSec"}]}], "}"}], ",", "0", ",", 
     RowBox[{"300.", "//", "radPerSec"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rI31", ",", "1"}], "}"}], ",", "0", ",", "10"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tL", ",", 
       FractionBox["tLim", "10"]}], "}"}], ",", "0", ",", "tLim"}], "}"}]}], 
  "]"}]}], "Input",
