Cell[TextData[{
 StyleBox["The second, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Eta]", "''"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "86faa9af-8a89-4296-8738-4714adfa4da1"],
 StyleBox[", equation has",
  FontSlant->"Italic"],
 " ",
 StyleBox["Sec[\[Delta][t]]", "Input"],
 StyleBox[", which equals ",
  FontSlant->"Italic"],
 StyleBox["ComplexInfinity", "Input",
  FontSlant->"Italic"],
 StyleBox[" when ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Pi]", "/", "2"}], ")"}], "=", 
     RowBox[{"90", "\[Degree]"}]}]}], TraditionalForm]],ExpressionUUID->
  "bec9fb64-0786-4357-af10-bb6d39e44338"],
 ". ",
 StyleBox["That\[CloseCurlyQuote]s the source of divergence we\
\[CloseCurlyQuote]ll see below in the solutions. ",
  FontSlant->"Italic"]
}], "Item",
