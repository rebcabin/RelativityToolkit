Cell[CellGroupData[{

Cell[TextData[{
 "Animate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a8bc0c77-d841-47fd-9652-6cc686bac5dd"],
 " Solution"
}], "Section",
 CellChangeTimes->{{3.980707660727304*^9, 3.980707674748995*^9}, {
  3.980766574046135*^9, 
  3.980766575493404*^9}},ExpressionUUID->"998e72d0-6cfa-4e8b-b725-\
f883647ad266"],

Cell[TextData[{
 "The animation is convincing. We have changed the cyan circle and red dot to \
track the plane and location of the center of mass because the angle \[Eta] \
will become meaningless as we later go to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "e4e229db-b448-4df6-af68-ffe92bd46173"],
 ". We have also chosen initial conditions to produce an extreme amount of \
nutation, stressing the solution."
}], "Text",
 CellChangeTimes->{{3.980772228419236*^9, 3.980772273231481*^9}, {
  3.980772330087636*^9, 3.980772412224367*^9}, {3.980885330275165*^9, 
  3.9808853324907627`*^9}, {3.980885689191835*^9, 3.980885691651483*^9}, {
  3.981241977338999*^9, 
  3.981241978239688*^9}},ExpressionUUID->"f93809d9-7e6b-41ba-a514-\
02fc34c71a66"],

Cell[CellGroupData[{

Cell["Things to Try", "Subsection",
 CellChangeTimes->{{3.9808856965155287`*^9, 
  3.980885699460087*^9}},ExpressionUUID->"66e89dbe-4497-4d51-bf00-\
0c424dc6a34f"],

Cell[TextData[{
 "Set the initial spin speed, ",
 StyleBox["D\[Psi]0", "Input"],
 ", to zero. Watch the motion devolve to the familiar, freely falling \
pendulum. See the conserved Z component, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "z"], TraditionalForm]],ExpressionUUID->
  "3c5c52d3-caeb-4e7e-bb3e-f50602f374b7"],
 ", of the angular momentum go to zero."
}], "Item",
 CellChangeTimes->{{3.980885705023376*^9, 
  3.980885827020503*^9}},ExpressionUUID->"5f745c1a-f132-43d4-a742-\
3880801bc7b0"],

Cell[TextData[{
 "Observe non-zero ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "z"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "41095353-b204-400e-9b87-84ac9fa410f6"],
 " for other values of ",
 StyleBox["D\[Psi]0", "Input"],
 ", as spin angular momentum \[OpenCurlyDoubleQuote]leaks\
\[CloseCurlyDoubleQuote] into ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "z"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "12773813-c8f6-4717-9dba-735ac059df4a"],
 ", which is still conserved."
}], "Item",
 CellChangeTimes->{{3.980885705023376*^9, 3.9808858899189243`*^9}, {
  3.9809569065464487`*^9, 
  3.980956918670657*^9}},ExpressionUUID->"a2781744-33d0-49cb-be33-\
10ddc3fb0fe2"],

Cell[CellGroupData[{

Cell[TextData[{
 "Slide ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5930fc77-ef97-4d84-9f57-98c7e0f8989a"],
 "\:200b to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"90", "\[Degree]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3975c810-c255-4318-bcf1-95e9323d2bd1"],
 " and watch the equations of motion diverge. ",
 StyleBox["Sec[\[Delta]]", "Input"],
 " goes to ",
 StyleBox["ComplexInfinity", "Input"],
 ". "
}], "Item",
 CellChangeTimes->{{3.980889531290225*^9, 3.980889745146418*^9}, {
  3.98092988207006*^9, 3.9809298841213293`*^9}, {3.980931004795188*^9, 
  3.980931112782898*^9}, {3.980956941586155*^9, 
  3.980956944451211*^9}},ExpressionUUID->"eb3a82b6-78c3-4a7b-8296-\
f8921ebbd15d"],

Cell[TextData[{
 StyleBox["Any other choice of Euler angles would fail somewhere. To \
circumvent this failure, we must avoid Euler angles. In an upcoming notebook, \
we will abandon trigonometry entirely and lift the geometry into ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "e5c02311-305f-439a-b1ce-4c17fc5fe42c"],
 StyleBox[", trading singularities of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "57650f35-de9a-4e6a-a02f-f304b9630a53"],
 StyleBox[" for a seamless algebra of spinors / quaternions.",
  FontSlant->"Italic"]
}], "Subitem",
 CellChangeTimes->{{3.980889531290225*^9, 3.980889745146418*^9}, {
  3.98092988207006*^9, 3.9809298841213293`*^9}, {3.980931004795188*^9, 
  3.980931112782898*^9}, {3.980956941586155*^9, 3.9809569422130404`*^9}, {
  3.981242131933456*^9, 
  3.981242132106433*^9}},ExpressionUUID->"7d3f4200-b224-4007-b676-\
c5b8bc89acff"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Set high values for spin speed or ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "3"], TraditionalForm]],ExpressionUUID->
  "bbfd9fde-1122-4f00-b262-ec03e401d296"],
 " to observe total resistance to falling, but with slow precession and \
small-amplitude nutation."
}], "Item",
 CellChangeTimes->{{3.9808860068693647`*^9, 3.980886084877933*^9}, {
  3.981242191088435*^9, 
  3.981242202399527*^9}},ExpressionUUID->"9c177cf6-75e7-4ea2-9f2e-\
ba96a8568f7a"],

