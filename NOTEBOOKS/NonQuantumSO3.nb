Cell[CellGroupData[{

Cell["In the \[ScriptCapitalU]\[ScriptCapitalD] Sector", "Section",
 CellChangeTimes->{{3.980348295766943*^9, 
  3.9803483076298027`*^9}},ExpressionUUID->"43ef8471-1679-4e91-b20b-\
0136b5a56927"],

Cell[TextData[{
 "In the above computations in the indexer sector, there is one nagging \
programming nit. We computed the gradient of the potential through an \
explicit contraction in ",
 StyleBox["PotentialScalarField", "Input"],
 ", rather than via \[ScriptCapitalU]\[ScriptCapitalD]\[CloseCurlyQuote]s \
gradient operator, ",
 StyleBox["GradRaised", "Input",
  FontColor->RGBColor[0.8, 0.3, 0.8]],
 ". To put ",
 StyleBox["GradRaised", "Input",
  FontColor->RGBColor[0.8, 0.3, 0.8]],
 " to work, we must redo the entire computation in the \[ScriptCapitalU]\
\[ScriptCapitalD] sector, where ",
 StyleBox["GradRaised", "Input",
  FontColor->RGBColor[0.8, 0.3, 0.8]],
 " was developed. We\[CloseCurlyQuote]ll find the code more verbose, but \
producing the same result."
}], "Text",
 CellChangeTimes->{{3.980547884900601*^9, 3.98054815305239*^9}, {
   3.980691971215951*^9, 3.9806919749552298`*^9}, 3.98069201205857*^9, 
   3.980692604709762*^9, {3.9807058382859077`*^9, 3.9807059054231453`*^9}, {
   3.980884740371052*^9, 3.9808847711429567`*^9}, {3.980884865640751*^9, 
   3.980884884230105*^9}, {3.981241432523467*^9, 
   3.981241439223597*^9}},ExpressionUUID->"52d9ae7b-14f2-4614-8716-\
18266bc2ebbf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "gDD", ",", "gUU", ",", "gDDMat", ",", "gDDrules", ",", "gUUrules"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"gDDMat", "=", 
       RowBox[{"m", " ", 
        SuperscriptBox["cz", "2"], 
        RowBox[{"(", GridBox[{
           {"1", "0"},
           {"0", 
            SuperscriptBox[
             RowBox[{"Cos", "[", "\[Delta]", "]"}], "2"]}
          }], ")"}]}]}], ")"}], "//", "MatrixForm"}], 
    ",", "\"\<\!\(\*SubscriptBox[\(g\), \(\\\ \(\[Mu]\\\ \[Nu]\)\)]\) \
(matrix) :\>\""}], "]"}], ";"}]}], "Input",
