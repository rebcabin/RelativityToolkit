Cell[CellGroupData[{

Cell["Inertial Forces from the Connection", "Subsection",
 CellChangeTimes->{{3.980953719797871*^9, 
  3.980953726616335*^9}},ExpressionUUID->"0d2a43d3-2011-464e-baf0-\
24a549a05647"],

Cell["\<\
By projecting (contracting) the covariant-derivative-of-the-velocity on the \
velocity, we get the coordinate accelerations\[LongDash]we might have \
expected that\[LongDash]plus all the inertial forces from the connection \
\[CapitalGamma]. Here is the interpretation of the inertial forces. \
\>", "Text",
 CellChangeTimes->{{3.980441240613205*^9, 3.980441406395988*^9}, {
  3.980441744866259*^9, 3.9804417905606527`*^9}, {3.980461650935339*^9, 
  3.9804616518358727`*^9}, {3.980687158542626*^9, 3.980687174104904*^9}, {
  3.9808836630783587`*^9, 3.9808836714999027`*^9}, {3.980978791084856*^9, 
  3.980978800733527*^9}, {3.981240368576913*^9, 
  3.981240368657445*^9}},ExpressionUUID->"8f1474e1-e59b-453b-870b-\
1924a1c1bc27"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"Symbol\"\>",
      StripOnInput->False,
      FontFamily->"Arial",
      FontSize->16,
      FontWeight->Bold], 
     StyleBox["\<\"Value\"\>",
      StripOnInput->False,
      FontFamily->"Arial",
      FontSize->16,
      FontWeight->Bold], 
     StyleBox["\<\"Cause\\n(\\!\\(\\*SuperscriptBox[\\(v\\), \
\\(\[Mu]\\)]\\)\\!\\(\\*SuperscriptBox[\\(v\\), \\(\[Nu]\\)]\\))\"\>",
      StripOnInput->False,
      FontFamily->"Arial",
      FontSize->16,
      FontWeight->Bold], 
     StyleBox["\<\"Effect\\n(Force Direction)\"\>",
