Cell[CellGroupData[{

Cell["Solution Strategy", "Section",
 CellChangeTimes->{{3.978216916211404*^9, 
  3.9782169210318336`*^9}},ExpressionUUID->"dc2c306f-1f55-4a32-9e6b-\
641b31a22283"],

Cell["\<\
The question to answer in this notebook is \[OpenCurlyDoubleQuote]what is the \
vacuum spacetime geometry outside a static, spherically symmetric black hole?\
\[CloseCurlyDoubleQuote]\
\>", "Text",
 CellChangeTimes->{{3.977916263698444*^9, 3.97791628883779*^9}, {
  3.9781909856055193`*^9, 3.978191001693035*^9}, {3.9782179519841223`*^9, 
  3.9782179552245293`*^9}, {3.978222449284503*^9, 3.9782224528302402`*^9}},
 FontWeight->"Bold",
 Background->RGBColor[
  1, 0.75, 0, 0.33],ExpressionUUID->"874d387a-8af9-4029-8cf9-4ac1158e447b"],

Cell[TextData[{
 "Guess at the form of the Schwarzschild metric tensor, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  CellChangeTimes->{{3.978217047016574*^9, 3.9782170482571173`*^9}, {
   3.978217135471945*^9, 3.97821718881602*^9}, {3.978217223791347*^9, 
   3.978217251179163*^9}},ExpressionUUID->
  "220418ad-4b17-4a07-b28f-0c9a028f7d56"],
 ", an ",
 StyleBox["ansatz",
  FontSlant->"Italic"],
 "."
}], "ItemNumbered",
 CellChangeTimes->{{3.978216932307979*^9, 3.978216949089439*^9}, {
  3.97821782834256*^9, 3.9782178640347652`*^9}, {3.978224264159258*^9, 
  3.9782242785073643`*^9}},ExpressionUUID->"9d88d21c-9cd5-46cb-8dd7-\
4b371cbe0762"],

Cell[TextData[StyleBox["The story of Karl Schwarzschild\[CloseCurlyQuote]s \
solution of the Einstein field equations while he was enlisted in the \
Prussian Army in WWI is fascinating. I was fortunate to have Schwarzschild\
\[CloseCurlyQuote]s son, Martin, as one of my advisors in graduate school.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.978216932307979*^9, 3.978216949089439*^9}, {
  3.97821782834256*^9, 3.9782178640347652`*^9}, {3.978224264159258*^9, 
  3.978224381748638*^9}},ExpressionUUID->"f515f095-0be4-43cf-8bba-\
d4e5d64a5e36"],

Cell[TextData[{
 "Grind this form through new compiler components to generate Christoffel \
symbols, the Riemann curvature tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["R", 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{
     "\[Lambda]", "\[VeryThinSpace]", "\[Nu]", "\[VeryThinSpace]", 
      "\[Rho]"}]}]], TraditionalForm]],ExpressionUUID->
  "44bc32e6-953a-4c95-aede-1978f76d1c87"],
 ", and the Ricci tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  ExpressionUUID->"733b41ab-9745-4d18-b404-92b33aa24ee0"],
 ", which is a specific contraction of Riemann."
}], "ItemNumbered",
 CellChangeTimes->{{3.978216953111328*^9, 3.978217025574943*^9}, {
  3.978217068290866*^9, 3.978217123789546*^9}, {3.978222480335887*^9, 
  3.978222514625066*^9}},ExpressionUUID->"f0cd42ea-21da-4b26-9ccf-\
b3c40c762093"],

Cell["\<\
Consult the Einstein field equations (not derived in this notebook):\
\>", "ItemNumbered",
 CellChangeTimes->{{3.978217032279943*^9, 3.9782170439041643`*^9}, 
   3.978217350522852*^9, {3.978217920784711*^9, 
   3.978217936370317*^9}},ExpressionUUID->"0c31a1cf-ac9b-4d11-93fa-\
006af40fe952"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], "-", 
    RowBox[{
     FractionBox["1", "2"], "R", "\[VeryThinSpace]", 
     SubscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]]}]}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"8", "\[Pi]", "\[VeryThinSpace]", "G"}], 
     SuperscriptBox["c", "4"]], 
    SubscriptBox["T", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.978217047016574*^9, 3.9782170482571173`*^9}, {
  3.978217135471945*^9, 3.97821718881602*^9}, {3.978217223791347*^9, 
  3.978217251179163*^9}},ExpressionUUID->"6514984c-374c-4ee3-8171-\
f5c257377640"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],ExpressionUUID->
  "e949595e-2317-4b3d-8605-59b55da198e6"],
 " is the metric trace of Ricci, namely ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], 
    SubscriptBox["R", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]]}], TraditionalForm]],
  ExpressionUUID->"de095cbd-85bc-4da8-a9f9-aff483ec9e88"],
 "."
}], "ItemParagraph",
 CellChangeTimes->{{3.978217467257217*^9, 3.978217532074066*^9}, {
  3.978222533227947*^9, 
  3.978222536233389*^9}},ExpressionUUID->"56de75e2-f220-496e-a04f-\
0f16fdfa6fbc"],

Cell[TextData[{
 "Set the Einstein equations equal to zero for the vacuum (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"f726ce40-a2ef-4ca7-8427-5881d1005776"],
 ", no stress-energy)."
}], "ItemNumbered",
 CellChangeTimes->{{3.978217257890685*^9, 3.9782172713477373`*^9}, {
   3.978217312450982*^9, 3.9782173174056187`*^9}, 3.9782173540879097`*^9, {
   3.9782175457468643`*^9, 
   3.978217579730043*^9}},ExpressionUUID->"aa5ba909-4c72-4211-85ba-\
938b9c329425"],

Cell[TextData[{
 "Contract the Einstein equations against ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  ExpressionUUID->"ee09e382-255b-4419-acc4-d8ce62cac7a0"],
 " to get the metric trace:"
}], "ItemNumbered",
 CellChangeTimes->{{3.978217344844315*^9, 3.978217424199491*^9}, {
   3.978217595295546*^9, 3.978217596201364*^9}, 3.978217917932048*^9, {
   3.978222579818718*^9, 
   3.9782225809463587`*^9}},ExpressionUUID->"b1b17f04-fad4-4e74-9531-\
fc9a764f7132"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], 
     SubscriptBox["R", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]]}], "-", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"R", "(", 
      RowBox[{
       SuperscriptBox["g", 
        RowBox[{"\[VeryThinSpace]", 
         RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], 
       SubscriptBox["g", 
        RowBox[{"\[VeryThinSpace]", 
         RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]]}], ")"}]}]}], "=", 
   
   RowBox[{
    RowBox[{"R", "-", 
     RowBox[{
      FractionBox["1", "2"], "4", "R"}]}], "=", 
    RowBox[{
     RowBox[{"0", "\[DoubleLongRightArrow]", "R"}], "=", "0"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.978217608396626*^9, 3.978217681211887*^9}, {
  3.97821776157961*^9, 3.978217778163095*^9}, {3.978217882967985*^9, 
  3.978217901006652*^9}},ExpressionUUID->"31fe2ede-258a-41d7-86e4-\
7570bbd2ebb2"],

Cell["\<\
Substitute this back into the Einstein equations to deduce that Ricci vanish \
in the vacuum:\
\>", "ItemNumbered",
 CellChangeTimes->{{3.978217715324844*^9, 3.9782177452912083`*^9}, 
   3.97821791428238*^9, {3.978222597160797*^9, 
   3.978222597388047*^9}},ExpressionUUID->"5c225423-309d-425d-8e69-\
a038fd235814"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], "-", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", "0", ")"}], "\[VeryThinSpace]", 
     SubscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]]}]}], "=", 
   RowBox[{
    RowBox[{"0", "\[DoubleLongRightArrow]", 
     SubscriptBox["R", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]]}], "=", "0"}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.978217047016574*^9, 3.9782170482571173`*^9}, {
  3.978217135471945*^9, 3.97821718881602*^9}, {3.978217223791347*^9, 
  3.978217251179163*^9}, {3.978217788115917*^9, 
  3.978217814933079*^9}},ExpressionUUID->"bd75cdb9-c9af-4adf-9af6-\
1ef2225b0b2c"],

Cell["\<\
Derive an ODE for terms in the ansatz from vanishing Ricci components.\
\>", "ItemNumbered",
 CellChangeTimes->{{3.978224058856709*^9, 
  3.978224141194763*^9}},ExpressionUUID->"f308eea8-5917-475f-8435-\
938e2d868fd2"],

Cell["\<\
Invoke boundary conditions at infinity to solve the ODE, and invoke a \
Newtonian approximation far from the black hole to evaluate the constants of \
integration.\
\>", "ItemNumbered",
 CellChangeTimes->{{3.978224145175152*^9, 
  3.978224207059524*^9}},ExpressionUUID->"a5ef06e5-6c82-4536-84e7-\
3e111b8f9dd4"],

Cell["\<\
Compare against Wolfram\[CloseCurlyQuote]s stored resource for the \
Schwarzschild metric.\
\>", "ItemNumbered",
 CellChangeTimes->{{3.978224210060697*^9, 
  3.9782242503571873`*^9}},ExpressionUUID->"a33d18e9-e263-4401-8baf-\
87ff78fec0db"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Introducing New Compiler Functions", "Section",
 CellChangeTimes->{{3.978215211558666*^9, 3.978215217736579*^9}, {
  3.978215256463418*^9, 
  3.978215258586466*^9}},ExpressionUUID->"486662a8-cf98-46c0-8e30-\
822a9512c6b0"],

Cell["\<\
We have enhanced \[ScriptCapitalU]\[ScriptCapitalD] with several new \
functions in service of this task. The following sketches their \
functionality, and the rest of the notebook illustrates their use by example. \
These functions are sufficiently general that they will apply to other \
problems in general relativity and differential geometry in the future.\
\>", "Text",
 CellChangeTimes->{{3.978224402203388*^9, 
  3.9782244940026903`*^9}},ExpressionUUID->"4d4f9261-8ea9-4027-978b-\
de1868dd1b85"],

Cell["\<\
In this notebook, \[OpenCurlyDoubleQuote]matrix\[CloseCurlyDoubleQuote] is a \
synonym for a Wolfram 2D array. A tensor is either a matrix that satisfies \
coordinate-transformation rules, or a collection of symbolic \
\[ScriptCapitalU]\[ScriptCapitalD] expressions that also satisfy \
coordinate-transformation rules.\
\>", "Text",
 CellChangeTimes->{{3.978225091165732*^9, 
  3.978225175875058*^9}},ExpressionUUID->"d27f0b30-b457-46b8-b532-\
aaf66f4bf80e"],

Cell[TextData[StyleBox["MatrixToUDRules", "Input",
 Background->RGBColor[1, 0.75, 0, 0.33]]], "Text",
 CellChangeTimes->{
  3.978215231246804*^9},ExpressionUUID->"ac450311-58f7-42c3-b1d9-\
6aa5d997d9bb"],

Cell[TextData[{
 "Converts the non-zero elements a matrix of components into rules for later \
application via ",
 StyleBox["Replace", "Input"],
 " and ",
 StyleBox["ReplaceAll", "Input"],
 " to symbolic expressions in \[ScriptCapitalU]\[ScriptCapitalD]."
}], "ItemParagraph",
 CellChangeTimes->{{3.9782245231480007`*^9, 3.978224579524329*^9}, {
  3.978224786093027*^9, 
  3.978224793128354*^9}},ExpressionUUID->"4378eae2-73a0-4a5e-b310-\
c48206ff4231"],

Cell[TextData[StyleBox["ChristoffelsFromMetric", "Input",
 Background->RGBColor[1, 0.75, 0, 0.33]]], "Text",
 CellChangeTimes->{
  3.978215251305468*^9},ExpressionUUID->"cdd73564-122c-42eb-a04d-\
cfe6c7eb433a"],

Cell["\<\
Computes torsion-free Christoffel symbols from a symmetric metric tensor \
written in \[ScriptCapitalU]\[ScriptCapitalD] notation.\
\>", "ItemParagraph",
 CellChangeTimes->{{3.978224589733425*^9, 3.978224619253777*^9}, {
  3.978224681427638*^9, 
  3.978224691014554*^9}},ExpressionUUID->"658dbe81-ab90-4aaa-aa21-\
8e18327931d5"],

Cell[TextData[StyleBox["ContractAll", "Input",
 Background->RGBColor[1, 0.75, 0, 0.33]]], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.978215273498835*^9, 3.9782152735007887`*^9}, 
   3.97822538705867*^9},
 CellLabel->"In[12]:=",ExpressionUUID->"de686504-459d-419f-b032-8bc36899b37f"],

Cell["\<\
Contracts all bound indices in a \[ScriptCapitalU]\[ScriptCapitalD] \
expression over a given set of coordinate symbols.\
\>", "ItemParagraph",
 CellChangeTimes->{{3.978224703357287*^9, 
  3.978224730008507*^9}},ExpressionUUID->"8148336b-4dc6-4e32-84d8-\
ca8c25e47835"],

Cell[TextData[StyleBox["EvaluateUDPartials", "Input",
 Background->RGBColor[1, 0.75, 0, 0.33]]], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.978215929928647*^9, 3.978215929929338*^9}, 
   3.978225396824547*^9},
 CellLabel->"In[13]:=",ExpressionUUID->"4ef6ab19-77f8-4f7f-be65-6987cc5d9d07"],

Cell["\<\
Converts partial derivatives in \[ScriptCapitalU]\[ScriptCapitalD]\
\[CloseCurlyQuote]s comma notation into forms that Wolfram can manipulate.\
\>", "ItemParagraph",
 CellChangeTimes->{{3.978224734348538*^9, 3.9782247409653387`*^9}, {
  3.9782248777517977`*^9, 
  3.9782249062008753`*^9}},ExpressionUUID->"53d11251-c505-4e4e-81c8-\
a324f93a377b"],

Cell[TextData[StyleBox["MakeIndexer", "Input",
 Background->RGBColor[1, 0.75, 0, 0.33]]], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.978216204084797*^9, 3.978216204086956*^9}, 
   3.978225400429134*^9},
 CellLabel->"In[14]:=",ExpressionUUID->"4ad228ed-2b96-4aa0-90f4-3ad016759d94"],

Cell["\<\
Makes a function that can index a matrix of components via symbolic \
coordinates.\
\>", "ItemParagraph",
 CellChangeTimes->{{3.978224734348538*^9, 3.9782247409653387`*^9}, {
  3.978224913612956*^9, 
  3.978224933600033*^9}},ExpressionUUID->"654c7d5c-b728-4987-a493-\
d15718e5e412"],

Cell[TextData[StyleBox["CalculateRiemannComponent", "Input",
 Background->RGBColor[1, 0.75, 0, 0.33]]], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.978216429400505*^9, 3.978216429402155*^9}, 
   3.978225404753154*^9},
 CellLabel->"In[15]:=",ExpressionUUID->"d179a226-76a0-4b91-84ce-d656ee9ed506"],

Cell["\<\
Given Christoffel symbols via an indexer, calculates a component of the \
Riemann curvature tensor by contracting over the Christoffel symbols.\
\>", "ItemParagraph",
 CellChangeTimes->{{3.978224734348538*^9, 3.9782247409653387`*^9}, {
  3.97822494113592*^9, 3.978224981146879*^9}, {3.9782250156184587`*^9, 
  3.9782250189595823`*^9}, {3.9782250658787117`*^9, 
  3.978225074052433*^9}},ExpressionUUID->"01494e09-6ce7-438c-8e32-\
6005b52f67e8"],

Cell[TextData[StyleBox["CalculateRicciComponent", "Input",
 Background->RGBColor[1, 0.75, 0, 0.33]]], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.978216490646516*^9, 3.978216490647324*^9}, 
   3.978225408335648*^9},
 CellLabel->"In[16]:=",ExpressionUUID->"fc0a9aea-9ad3-4ff9-9c71-2a99008ffe36"],

Cell["\<\
Given a Riemann tensor via an indexer, calculates a component of the Ricci \
tensor, a particular contraction of the Riemann tensor.\
\>", "ItemParagraph",
 CellChangeTimes->{{3.978224734348538*^9, 3.9782247409653387`*^9}, {
  3.978225027528164*^9, 
  3.978225083756073*^9}},ExpressionUUID->"ce0a22b0-3e70-4838-9c27-\
fb0592e300ae"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Ansatz", "Section",
 CellChangeTimes->{{3.977916246773687*^9, 
  3.977916252253207*^9}},ExpressionUUID->"3c8c91ea-e899-49bc-91fa-\
1ad35b9a116b"],

Cell["\<\
Set up a coordinate system in flat spacetime, at a safe distance from the \
central black hole, but with origin at that center. Measure all events with \
respect to this coordinate system. Solutions of these equations with respect \
to proper time account for spacetime curvature.\
\>", "Text",
 CellChangeTimes->{{3.97819106217358*^9, 3.978191124805711*^9}, {
  3.978191461600265*^9, 3.9781914855396347`*^9}, {3.978192096622428*^9, 
  3.9781921300750027`*^9}, {3.978218105985491*^9, 3.978218146350388*^9}, {
  3.978218239011086*^9, 3.9782182459332542`*^9}, {3.978222611908587*^9, 
  3.978222630425633*^9}},ExpressionUUID->"5af30864-89fc-4a2c-94bf-\
b8f03c43dda7"],

Cell[TextData[{
 "Assume as a guess, or ",
 StyleBox["ansatz, ",
  FontSlant->"Italic"],
 "the following form for an element of proper distance along a geodesic:"
}], "Text",
 CellChangeTimes->{{3.977916295785714*^9, 3.9779163100778646`*^9}, {
   3.978099170159231*^9, 3.978099171269863*^9}, {3.978099205230735*^9, 
   3.978099205727705*^9}, {3.978190623316001*^9, 3.978190636959577*^9}, {
   3.9781909384235992`*^9, 3.978190974111395*^9}, 
   3.9781915778900423`*^9},ExpressionUUID->"86cd0607-aad6-4c1c-8716-\
42093dc838bf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"d", "\[VeryThinSpace]", 
    SuperscriptBox["s", 
     RowBox[{" ", "2"}]]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "A"}], 
      RowBox[{"(", "r", ")"}], "d", "\[VeryThinSpace]", 
      SuperscriptBox["t", 
       RowBox[{"\[VeryThinSpace]", "2"}]]}], "+", 
     RowBox[{"B", 
      RowBox[{"(", "r", ")"}], "d", "\[VeryThinSpace]", 
      SuperscriptBox["r", 
       RowBox[{"\[VeryThinSpace]", "2"}]]}], "+", 
     RowBox[{
      SuperscriptBox["r", 
       RowBox[{"\[VeryThinSpace]", "2"}]], "d", "\[VeryThinSpace]", 
      SuperscriptBox["\[Theta]", 
       RowBox[{"\[VeryThinSpace]", "2"}]]}], "+", 
     RowBox[{
      SuperscriptBox["r", 
       RowBox[{"\[VeryThinSpace]", "2"}]], 
      RowBox[{
       SuperscriptBox["sin", "2"], "(", "\[Theta]", ")"}], " ", "d", "\[VeryThinSpace]", 
      SuperscriptBox["\[Phi]", 
       RowBox[{"\[VeryThinSpace]", "2"}]]}]}], "\[Congruent]", 
    "\[LineSeparator]", 
    RowBox[{
     RowBox[{
      SubscriptBox["g", 
       RowBox[{"\[VeryThinSpace]", 
        RowBox[{"t", "\[VeryThinSpace]", "t"}]}]], "d", "\[VeryThinSpace]", 
      SuperscriptBox["t", 
       RowBox[{"\[VeryThinSpace]", "2"}]]}], "+", 
     RowBox[{
      SubscriptBox["g", 
       RowBox[{"\[VeryThinSpace]", 
        RowBox[{"r", "\[VeryThinSpace]", "r"}]}]], "d", "\[VeryThinSpace]", 
      SuperscriptBox["r", 
       RowBox[{"\[VeryThinSpace]", "2"}]]}], "+", 
     RowBox[{
      SubscriptBox["g", 
       RowBox[{"\[VeryThinSpace]", 
        RowBox[{"\[Theta]", "\[VeryThinSpace]", "\[Theta]"}]}]], "d", "\[VeryThinSpace]", 
      SuperscriptBox["\[Theta]", 
       RowBox[{"\[VeryThinSpace]", "2"}]]}], "+", 
     RowBox[{
      SubscriptBox["g", 
       RowBox[{"\[VeryThinSpace]", 
        RowBox[{"\[Phi]", "\[VeryThinSpace]", "\[Phi]"}]}]], "d", "\[VeryThinSpace]", 
      SuperscriptBox["\[Phi]", 
       RowBox[{"\[VeryThinSpace]", "2"}]]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977916323565331*^9, 3.9779164571988707`*^9}, {
  3.977916518780223*^9, 3.977916535636404*^9}, {3.977916610920299*^9, 
  3.9779167496613283`*^9}, {3.978045504706258*^9, 
  3.978045510734001*^9}},ExpressionUUID->"213b58b5-4fde-4928-a243-\
61f6417ebe60"],

Cell[TextData[{
 "with two unknown functions of radius, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "[", "r", "]"}], TraditionalForm]],ExpressionUUID->
  "6dda3693-af88-459b-b0e0-38710f7d18d1"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "[", "r", "]"}], TraditionalForm]],ExpressionUUID->
  "0230c513-e32f-47a7-8217-90fa7ab8f973"],
 ", and with symbolic coordinates, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", ",", " ", "r", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], 
   TraditionalForm]],ExpressionUUID->"d400aad6-d278-40b2-9ec1-d334e6d71595"],
 ", all assumed to be functions of proper time, \[Tau], the time experienced \
by a particle in free-fall on a geodesic. Notice these functions do not \
depend on the angle coordinates \[Theta] and \[Phi]. That is the meaning of \
\[OpenCurlyDoubleQuote]spherically symmetric.\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{3.97819064600136*^9, 3.978190797478819*^9}, {
  3.97819089795123*^9, 3.978190916661297*^9}, {3.9781910117645073`*^9, 
  3.978191012205779*^9}, {3.978191587618043*^9, 3.9781916381208553`*^9}, {
  3.9782181632497*^9, 3.97821817961614*^9}, {3.97822264683989*^9, 
  3.978222669965879*^9}},ExpressionUUID->"03cfb319-aaea-4aff-9551-\
d4c1a926148c"],

Cell[CellGroupData[{

Cell["Covariant Metric Tensor", "Subsection",
 CellChangeTimes->{{3.978192158090149*^9, 
  3.978192167668303*^9}},ExpressionUUID->"b24d5cce-520f-4a76-8f9c-\
0fef5812a1fe"],

Cell["\<\
Express the covariant metric tensor of this ansatz as a diagonal matrix \
(Wolfram array); save the coordinates for later:\
\>", "Text",
 CellChangeTimes->{{3.97819064600136*^9, 3.978190797478819*^9}, {
  3.97819089795123*^9, 3.978190916661297*^9}, {3.9781910117645073`*^9, 
  3.978191012205779*^9}, {3.978191587618043*^9, 3.978191631215666*^9}, {
  3.978192171321978*^9, 3.978192189951953*^9}, {3.978217998591794*^9, 
  3.978218002685255*^9}},ExpressionUUID->"9e497488-b137-4ceb-ad63-\
97c163a6aaa7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"SchwAnsatz", "=", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"A", "[", "r", "]"}]}], ",", 
          RowBox[{"B", "[", "r", "]"}], ",", 
          SuperscriptBox["r", "2"], ",", 
          RowBox[{
           SuperscriptBox["r", "2"], 
           SuperscriptBox[
            RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], "}"}], "]"}]}], 
      ")"}], "//", "MatrixForm"}], ",", "\"\<Schw ansatz :\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"coords", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.977916813480853*^9, 3.977916826941023*^9}, {
   3.9779407308444233`*^9, 3.977940773866407*^9}, {3.97794082661156*^9, 
   3.977940939484643*^9}, 3.977941457585986*^9, {3.977941645311081*^9, 
   3.977941652043281*^9}, {3.977942092566986*^9, 3.977942100398808*^9}, {
   3.9779447081151657`*^9, 3.977944709680691*^9}, {3.977945319075341*^9, 
   3.977945326309247*^9}, 3.9779888441130342`*^9, {3.9780076892293797`*^9, 
   3.978007732449287*^9}, {3.9780077800160227`*^9, 3.978007837277759*^9}, {
   3.978007868330056*^9, 3.978007967053761*^9}, 3.9780080432740183`*^9, 
   3.9780081057016373`*^9, {3.978011018685891*^9, 3.97801102024509*^9}, {
   3.9781907845551023`*^9, 3.9781908826070423`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"d6e8e5f3-ff70-48df-8e45-424fe12c3997"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Schw ansatz :\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       RowBox[{"-", 
        RowBox[{"A", "[", "r", "]"}]}], "0", "0", "0"},
      {"0", 
       RowBox[{"B", "[", "r", "]"}], "0", "0"},
      {"0", "0", 
       SuperscriptBox["r", "2"], "0"},
      {"0", "0", "0", 
       RowBox[{
        SuperscriptBox["r", "2"], " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}], "\[NoBreak]", ")"}],
   Function[BoxForm`e$, 
    MatrixForm[BoxForm`e$]]]}]], "Echo",
 CellChangeTimes->{
  3.978228606437461*^9},ExpressionUUID->"c8ec78c2-926c-4fda-a3fb-\
a6d6c25f9537"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Coordinate time, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "75608554-dc66-4d1d-b238-a096ef96c628"],
 StyleBox[", is also a function of proper time, expressing time dilation. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.978191033305602*^9, 3.978191054467911*^9}, {
   3.978191961238701*^9, 3.978191961239932*^9}, {3.978218014424025*^9, 
   3.978218041240109*^9}, 3.978218193143099*^9, {3.978222729127228*^9, 
   3.978222733034404*^9}},ExpressionUUID->"8fdf4451-d7f7-48f5-92eb-\
f9a73552ef82"],

Cell[TextData[{
 StyleBox["The ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "\[VeryThinSpace]", "t"}], TraditionalForm]],ExpressionUUID->
  "adfa2405-707d-45cc-afe6-d5255bbb77d7"],
 StyleBox[" component of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  ExpressionUUID->"710e1bea-b01b-4842-9331-4f0bf338b633"],
 StyleBox[" is negative because we employ the ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "1", ",", "1", ",", "1"}], ")"}], 
   TraditionalForm]],ExpressionUUID->"59224e60-9cdf-4e37-acd7-f495512d63fa"],
 StyleBox[" sign convention for Lorentz invariance.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.978191033305602*^9, 3.978191054467911*^9}, {
  3.978191966259078*^9, 3.97819207592404*^9}, {3.9781924136227694`*^9, 
  3.9781924451217422`*^9}},ExpressionUUID->"2931150c-d1c1-48ea-ad20-\
5ba772e156ec"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Metric Rules", "Subsection",
 CellChangeTimes->{{3.9781922025654173`*^9, 
  3.9781922052266817`*^9}},ExpressionUUID->"924a3d83-73b0-4f92-bf41-\
5487b0bd38ce"],

Cell[TextData[{
 "Call the new compiler function, ",
 StyleBox["MatrixToUDRules", "Input",
  Background->RGBColor[1, 0.75, 0, 0.33]],
 ", to create some rules that map \
\[ScriptCapitalU]\[ScriptCapitalD]\[NoBreak]-\[NoBreak]indexed components of \
a given symbol, say ",
 StyleBox["gDD", "Input"],
 ", to the components of the ansatz matrix. We\[CloseCurlyQuote]ll need these \
rules later to concretize an abstract expression for \[CapitalGamma]. "
}], "Text",
 CellChangeTimes->{{3.978192221904088*^9, 3.9781922901081133`*^9}, {
   3.978214447515636*^9, 3.978214586780025*^9}, {3.9782146194738693`*^9, 
   3.978214806482099*^9}, {3.978218257599633*^9, 3.9782182588447313`*^9}, 
   3.978218327714691*^9, {3.9782186503010187`*^9, 
   3.97821865083925*^9}},ExpressionUUID->"3cad0f1c-00fc-4ce2-940e-\
e8d26693ad2d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"SchwRules", "=", 
     RowBox[{"MatrixToUDRules", "[", 
      RowBox[{
      "SchwAnsatz", ",", "gDD", ",", "\[ScriptCapitalD]", ",", "coords"}], 
      "]"}]}], ",", " ", "\"\<Schw rules :\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.977916813480853*^9, 3.977916826941023*^9}, {
   3.9779407308444233`*^9, 3.977940773866407*^9}, {3.97794082661156*^9, 
   3.977940939484643*^9}, 3.977941457585986*^9, {3.977941645311081*^9, 
   3.977941652043281*^9}, {3.977942092566986*^9, 3.977942100398808*^9}, {
   3.9779447081151657`*^9, 3.977944709680691*^9}, {3.977945319075341*^9, 
   3.977945326309247*^9}, 3.9779888441130342`*^9, {3.9780076892293797`*^9, 
   3.978007732449287*^9}, {3.9780077800160227`*^9, 3.978007837277759*^9}, {
   3.978007868330056*^9, 3.978007924283086*^9}, 3.978008110446718*^9, 
   3.978011024593129*^9, 3.97809641214109*^9, {3.97809656085817*^9, 
   3.9780965614850187`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"b8727725-69a5-482c-87c2-f899dae2ea30"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Schw rules :\"\>",
   "EchoLabel"], "  ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"gDD", 
      SubscriptBox["", "t"], 
      SubscriptBox["", "t"]}], "\[Rule]", 
     RowBox[{"-", 
      RowBox[{"A", "[", "r", "]"}]}]}], ",", 
    RowBox[{
     RowBox[{"gDD", 
      SubscriptBox["", "r"], 
      SubscriptBox["", "r"]}], "\[Rule]", 
     RowBox[{"B", "[", "r", "]"}]}], ",", 
    RowBox[{
     RowBox[{"gDD", 
      SubscriptBox["", "\[Theta]"], 
      SubscriptBox["", "\[Theta]"]}], "\[Rule]", 
     SuperscriptBox["r", "2"]}], ",", 
    RowBox[{
     RowBox[{"gDD", 
      SubscriptBox["", "\[Phi]"], 
      SubscriptBox["", "\[Phi]"]}], "\[Rule]", 
     RowBox[{
      SuperscriptBox["r", "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}]}], "}"}]}]], "Echo",
 CellChangeTimes->{
  3.978228606450687*^9},ExpressionUUID->"3cfa165c-cb4a-469e-b4f7-\
448bb6257c4b"]
}, Open  ]],

Cell[TextData[{
 "For brevity, ",
 StyleBox["MatrixToUDRules", "Input",
  FontSlant->"Plain"],
 " doesn\[CloseCurlyQuote]t produce rules for zeros in the matrix. We\
\[CloseCurlyQuote]ll put those in later, by hand, in a concise way that \
exploits structural knowledge of ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "ca52a634-f40e-4bf4-8c28-c8f20dced9f1"],
 "."
}], "Item",
 CellChangeTimes->{{3.978222774693768*^9, 3.978222853077169*^9}},
 FontSlant->"Italic",ExpressionUUID->"75f80a72-a867-4de7-984f-dc00fd937ef4"],

Cell[TextData[{
 "TODO: Sparse-matrix version of ",
 StyleBox["MatrixToUDRules", "Input",
  FontSlant->"Plain"],
 " that concisely handles zero elements."
}], "Item",
 CellChangeTimes->{{3.9782268391295223`*^9, 3.978226882529562*^9}},
 FontSlant->"Italic",ExpressionUUID->"e5d0f038-4b59-4b17-9494-d92fb58e0320"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Contravariant Metric Tensor and Rules", "Subsection",
 CellChangeTimes->{{3.9781923060218887`*^9, 3.978192313092054*^9}, {
  3.978214309186017*^9, 
  3.978214313927841*^9}},ExpressionUUID->"ae849ecc-f6d5-4b33-a9a6-\
6599fdb3ac0c"],

Cell[TextData[{
 "The contravariant version, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  ExpressionUUID->"a0eab90f-8ad7-4ecb-b7bc-e5d985f110bd"],
 ", of ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "fea9ba55-b445-4d0b-8e10-60151dd30fca"],
 " is just the matrix inverse of the covariant version. Ending with the \
needed rules for ",
 StyleBox[Cell[BoxData[
  FormBox["gUU", TraditionalForm]], "Input",ExpressionUUID->
  "e05296d6-bc70-4540-b144-8eca4b12b526"], "Input"],
 StyleBox[",", "Input"],
 " we get:"
}], "Text",
 CellChangeTimes->{{3.978192317741683*^9, 3.978192394869299*^9}, {
  3.978214835224828*^9, 
  3.9782148392929487`*^9}},ExpressionUUID->"c17a10ea-6ec8-41ee-bc8a-\
d60a486f6244"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SchwAnsatzInv", "=", 
   RowBox[{"Inverse", "[", "SchwAnsatz", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"SchwInvRules", "=", 
     RowBox[{"MatrixToUDRules", "[", 
      RowBox[{
      "SchwAnsatzInv", ",", "gUU", ",", "\[ScriptCapitalU]", ",", "coords"}], 
      "]"}]}], ",", " ", "\"\<Schw Inv rules :\>\""}], "]"}], ";"}]}], "Input",\

 CellChangeTimes->{{3.977942185004792*^9, 3.977942262929964*^9}, {
   3.977945341382947*^9, 3.977945352693774*^9}, 3.977988960547517*^9, {
   3.978007742089058*^9, 3.978007744336866*^9}, 3.978008111473281*^9, 
   3.978011027232847*^9, {3.978096584520122*^9, 3.978096585243936*^9}, 
   3.9782143179035873`*^9},
 CellLabel->"In[15]:=",ExpressionUUID->"90fd7d66-9943-44bd-a5fd-3e5a32e058fd"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Schw Inv rules :\"\>",
   "EchoLabel"], "  ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"gUU", 
      SuperscriptBox["", "t"], 
      SuperscriptBox["", "t"]}], "\[Rule]", 
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"A", "[", "r", "]"}]]}]}], ",", 
    RowBox[{
     RowBox[{"gUU", 
      SuperscriptBox["", "r"], 
      SuperscriptBox["", "r"]}], "\[Rule]", 
     FractionBox["1", 
      RowBox[{"B", "[", "r", "]"}]]}], ",", 
    RowBox[{
     RowBox[{"gUU", 
      SuperscriptBox["", "\[Theta]"], 
      SuperscriptBox["", "\[Theta]"]}], "\[Rule]", 
     FractionBox["1", 
      SuperscriptBox["r", "2"]]}], ",", 
    RowBox[{
     RowBox[{"gUU", 
      SuperscriptBox["", "\[Phi]"], 
      SuperscriptBox["", "\[Phi]"]}], "\[Rule]", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"], 
      SuperscriptBox["r", "2"]]}]}], "}"}]}]], "Echo",
 CellChangeTimes->{
  3.978228606463665*^9},ExpressionUUID->"d48524e1-97a5-4e0c-be6e-\
c2ab7c8842dd"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Christoffel Symbols", "Subsection",
 CellChangeTimes->{{3.978192469793416*^9, 
  3.9781924753917007`*^9}},ExpressionUUID->"e18e650e-ce83-4121-83bb-\
ad4cb4b50818"],

Cell[TextData[{
 "The functions developed in an earlier notebook, ",
 StyleBox["Riemann Curvature in ",
  FontSlant->"Italic"],
 "\[ScriptCapitalU]\[ScriptCapitalD]",
 StyleBox[" + Compiler POC",
  FontSlant->"Italic"],
 ", have been captured in a new compiler function, ",
 StyleBox["ChristoffelsFromMetric", "Input",
  Background->RGBColor[1, 0.75, 0, 0.33]],
 ", which computes a commutator of covariant derivatives. See it as an \
unevaluated contraction over a bound ",
 StyleBox["Unique", "Input"],
 " index:"
}], "Text",
 CellChangeTimes->{{3.9781925053629427`*^9, 3.978192522971711*^9}, {
   3.978192686763955*^9, 3.9781928505605173`*^9}, {3.978192907871084*^9, 
   3.978192975257187*^9}, {3.978193006206502*^9, 3.978193085030589*^9}, {
   3.978214384381565*^9, 3.978214437590973*^9}, {3.9782148675012083`*^9, 
   3.9782149030145893`*^9}, 3.978214967947057*^9, {3.978215032616589*^9, 
   3.978215049617358*^9}, {3.9782151248903923`*^9, 3.97821512789323*^9}, {
   3.9782153643193274`*^9, 3.978215376527761*^9}, {3.978222909410356*^9, 
   3.9782229112980833`*^9}},ExpressionUUID->"59218fb3-0edf-49cf-a307-\
74150863db68"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"ChristoffelsFromMetric", "[", 
     RowBox[{"gDD", ",", "gUU", ",", "\[Sigma]", ",", "\[Mu]", ",", "\[Nu]"}],
      "]"}], ",", " ", "\"\<Unevaluated Contraction :\>\""}], "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9779423861580877`*^9, 3.9779424752786703`*^9}, {
   3.977989900023822*^9, 3.9779899166293163`*^9}, 3.9781928103203506`*^9, 
   3.978193024936234*^9, 3.9782149525189133`*^9, {3.978215081894136*^9, 
   3.978215085313821*^9}, 3.978215337214772*^9, {3.9782155989712887`*^9, 
   3.978215620713814*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"0acf4058-9d89-45f8-bba6-f954bef1a780"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Unevaluated Contraction :\"\>",
   "EchoLabel"], "  ", 
  FractionBox["1", "2"], " ", 
  RowBox[{"(", 
   RowBox[{"gUU", 
    SuperscriptBox["", "\[Sigma]"], 
    SuperscriptBox["", "\[Lambda]11"]}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    SubscriptBox[
     RowBox[{"gDD", 
      SubscriptBox["", "\[Lambda]11"], 
      SubscriptBox["", "\[Mu]"]}], 
     RowBox[{",", "\[Nu]"}]], "+", 
    SubscriptBox[
     RowBox[{"gDD", 
      SubscriptBox["", "\[Lambda]11"], 
      SubscriptBox["", "\[Nu]"]}], 
     RowBox[{",", "\[Mu]"}]], "-", 
    SubscriptBox[
     RowBox[{"gDD", 
      SubscriptBox["", "\[Mu]"], 
      SubscriptBox["", "\[Nu]"]}], 
     RowBox[{",", "\[Lambda]11"}]]}], ")"}]}]], "Echo",
 CellChangeTimes->{
  3.978228606475389*^9},ExpressionUUID->"e6c43409-f12b-4df6-845e-\
b7e7fd03bcd1"]
}, Open  ]],

Cell[TextData[{
 "The new compiler function ",
 StyleBox["ContractAll", "Input",
  Background->RGBColor[1, 0.75, 0, 0.33]],
 " exhibits the contraction carried out over all coordinates. Note that the \
up-down index pairs are now the coordinate symbols rather than summation \
indices. Each term in the following exhibit is a product of components, not a \
further (recursive) contraction."
}], "Text",
 CellChangeTimes->{{3.978193094907441*^9, 3.978193205848093*^9}, {
  3.9782151788712893`*^9, 3.9782151926911077`*^9}, {3.978215307594297*^9, 
  3.9782153584940233`*^9}, {3.978215436764558*^9, 3.978215573725004*^9}, {
  3.978222948578018*^9, 
  3.978222951839971*^9}},ExpressionUUID->"d6999efc-b9f5-4fa3-ad55-\
e24e09f3d948"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ContractAll", "[", 
  RowBox[{
   RowBox[{"ChristoffelsFromMetric", "[", 
