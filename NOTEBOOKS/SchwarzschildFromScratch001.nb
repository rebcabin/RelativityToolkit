        RowBox[{"2", " ", 
         RowBox[{"A", "[", "r", "]"}], " ", 
         RowBox[{
          SuperscriptBox["A", "\[Prime]\[Prime]",
           MultilineFunction->None], "[", "r", "]"}]}]}], ")"}]}]}], 
    RowBox[{"4", " ", 
     SuperscriptBox[
      RowBox[{"A", "[", "r", "]"}], "2"], " ", 
     RowBox[{"B", "[", "r", "]"}]}]]}]}]], "Echo",
 CellChangeTimes->{
  3.9782286066011457`*^9},ExpressionUUID->"22a53e94-7ac0-4190-9f24-\
5293ff9ec7ce"]
}, Open  ]],

