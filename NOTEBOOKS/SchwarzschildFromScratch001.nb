                  MultilineFunction->None], "(", "r", ")"}]}], "+", 
               RowBox[{"2", " ", 
                SuperscriptBox[
                 RowBox[{"B", "(", "r", ")"}], "2"]}], "-", 
               RowBox[{"2", " ", 
                RowBox[{"B", "(", "r", ")"}]}]}], ")"}]}]}], ")"}]}], 
         RowBox[{"2", " ", 
          RowBox[{"A", "(", "r", ")"}], " ", 
          SuperscriptBox[
           RowBox[{"B", "(", "r", ")"}], "2"]}]]}
