f5454b7e7653"],

Cell[TextData[{
 "Another new \[ScriptCapitalU]\[ScriptCapitalD] compiler function, ",
 StyleBox["EvaluateUDPartials", "Input",
  Background->RGBColor[1, 0.75, 0, 0.33]],
 ", produces a factor of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", "'"}], "[", "r", "]"}], TraditionalForm]],ExpressionUUID->
  "5ef746f4-9a5f-45a4-a399-a3a7e8b8cad3"],
 ", which is, of course, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"A", "[", "r", "]"}], 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{",", "\[VeryThinSpace]", "r"}]}]], TraditionalForm]],
  ExpressionUUID->"fec4107d-9bfb-4daf-bd91-56b948493666"],
 ", just in terms (the tick notation) that Wolfram understands. We\
\[CloseCurlyQuote]ll wrestle this into differential equations for ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "b5357f5f-4d9c-469a-966f-c3caa7e4078c"],
 "."
}], "Text",
 CellChangeTimes->{{3.978193693449215*^9, 3.9781937180995913`*^9}, {
