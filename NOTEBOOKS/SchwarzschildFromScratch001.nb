  3.978222213354899*^9}},ExpressionUUID->"7a39f050-682d-405f-8d0e-\
29ca87e7a531"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"t", "\[VeryThinSpace]", "t"}]}]], "\[TildeTilde]", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"2", "\[CapitalPhi]"}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
