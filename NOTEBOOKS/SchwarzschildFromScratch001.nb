     RowBox[{",", "\[VeryThinSpace]", "t"}]}]], TraditionalForm]],
  ExpressionUUID->"f33542ad-f9d7-4237-b624-8bc09fbc2732"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["gDD", 
    RowBox[{"\[VeryThinSpace]", 
