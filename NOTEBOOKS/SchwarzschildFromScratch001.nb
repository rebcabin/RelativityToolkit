Cell[CellGroupData[{

Cell["The Riemann Ansatz in Full", "Subsection",
 CellChangeTimes->{{3.978195397445154*^9, 
  3.978195409985075*^9}},ExpressionUUID->"20d10b41-f9e1-4333-b0c9-\
da6682be3743"],

Cell[TextData[{
 "Call another new compiler function, ",
 StyleBox["CalculateRiemannComponent", "Input",
  Background->RGBColor[1, 0.75, 0, 0.33]],
 ", passing in ",
 Cell[BoxData[
  FormBox["\[CapitalGamma]get", TraditionalForm]],ExpressionUUID->
  "aa608394-cfd0-49f0-b23e-d93200f6536c"],
 " and the coordinate symbols. Iterate symbolic indices \[Mu], \[Lambda], \
\[Nu], and \[Rho] over all 256 combinations of the coordinates. There is far \
too much to inspect, by hand, here, but it\[CloseCurlyQuote]s instructing to \
see some of it."
}], "Text",
 CellChangeTimes->{{3.978195453902506*^9, 3.9781955454954433`*^9}, {
  3.9781956429666157`*^9, 3.978195662519079*^9}, {3.978195719465456*^9, 
  3.9781957211178427`*^9}, {3.978195761432806*^9, 3.9781957635788813`*^9}, {
  3.978218990697413*^9, 
  3.9782190022282553`*^9}},ExpressionUUID->"1991a0dd-6175-4eee-b084-\
0777c5e31673"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
