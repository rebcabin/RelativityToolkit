Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"finalODE", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"R\[Theta]\[Theta]", "==", "0"}], ")"}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"B", "[", "r", "]"}], "->", 
           RowBox[{"1", "/", 
            RowBox[{"A", "[", "r", "]"}]}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"B", "'"}], "[", "r", "]"}], "->", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"1", "/", 
              RowBox[{"A", "[", "r", "]"}]}], ",", "r"}], "]"}]}]}], "}"}]}], 
       "//", "\[IndentingNewLine]", "FullSimplify"}]}], ")"}], 
    ",", "\"\<Vacuum ODE for A[r] :\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.978049490595441*^9, 3.978049654295248*^9}, {
   3.9780497055433693`*^9, 3.9780497065355673`*^9}, {3.9780498757029037`*^9, 
