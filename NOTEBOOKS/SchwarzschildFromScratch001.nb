          RowBox[{
          "\[Mu]", ",", "\[Lambda]", ",", "\[Nu]", ",", "\[Rho]", ",", 
           "\[CapitalGamma]Get", ",", "coords"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
