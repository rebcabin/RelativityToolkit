\[VeryThinSpace]\[Theta]\\)\\)]\\) =\"\>",
   "EchoLabel"], "  ", 
  RowBox[{
   RowBox[{"-", "1"}], "+", 
   FractionBox[
    RowBox[{"1", "+", 
     FractionBox[
      RowBox[{"r", " ", 
       RowBox[{
        SuperscriptBox["A", "\[Prime]",
