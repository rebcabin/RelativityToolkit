Cell[BoxData[
 RowBox[{
  TagBox["\<\"Schwarzschild Solution via WFR :\"\>",
   "EchoLabel"], "  ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       FractionBox[
        RowBox[{
        "2", " ", "\<\"\[FormalCapitalM]\"\>"}], "\<\"\[FormalR]\"\>"]}], ",",
       "0", ",", "0", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      FractionBox["1", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{
         "2", " ", "\<\"\[FormalCapitalM]\"\>"}], "\<\"\[FormalR]\"\>"]}]], ",",
       "0", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", 
      SuperscriptBox["\<\"\[FormalR]\"\>", "2"], ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", 
      RowBox[{
       SuperscriptBox["\<\"\[FormalR]\"\>", "2"], " ", 
       SuperscriptBox[
        RowBox[{"Sin", "[", "\<\"\[FormalTheta]\"\>", "]"}], "2"]}]}], 
     "}"}]}], "}"}]}]], "Echo",
 CellChangeTimes->{
  3.978228607027277*^9},ExpressionUUID->"d7e1f357-4415-4fd8-acb3-\
c4e5b0e5e84b"]
}, Open  ]],

Cell["\<\
we see a perfect match, except for WFR\[CloseCurlyQuote]s convention of \
formal symbols (with underdots).\
\>", "Text",
 CellChangeTimes->{{3.9782238230028*^9, 
  3.978223854840865*^9}},ExpressionUUID->"ac2e29e4-338b-4528-9e1f-\
