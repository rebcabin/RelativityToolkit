Cell[TextData[StyleBox["Here we really needed to kill the off-diagonal terms \
to produce a visually tolerable result. ",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.9781945523058147`*^9, 3.978194592792253*^9}, {
  3.978194775726495*^9, 3.9781948346177597`*^9}, {3.978216106338798*^9, 
  3.978216120376935*^9}, {3.978218887382148*^9, 3.978218899547513*^9}, {
  3.9782231617438498`*^9, 
  3.978223175774847*^9}},ExpressionUUID->"77498719-6d92-44f1-af7f-\
338926b19f66"],

Cell[CellGroupData[{

Cell["\[CapitalGamma] Indexer", "Subsubsection",
 CellChangeTimes->{{3.978194904491295*^9, 3.978194906111876*^9}, {
  3.978195786099325*^9, 
  3.9781957906613827`*^9}},ExpressionUUID->"ab463132-3d43-430c-aeaa-\
d881f2815df1"],

Cell[TextData[{
 "To reduce opportunities for human error, we really want to index objects \
with the coordinates rather than with numerical ",
 StyleBox["Part", "Input"],
 " or ",
 StyleBox["levelspec",
  FontSlant->"Italic"],
 " numbers. We\[CloseCurlyQuote]d rather write ",
 StyleBox["\[CapitalGamma]get[r,t,t]", "Input"],
 " than ",
 StyleBox["\[CapitalGamma][[1,0,0]]", "Input"],
 ". ",
 StyleBox["MakeIndexer", "Input",
  Background->RGBColor[1, 0.75, 0, 0.33]],
 " is the new compiler function that makes a function that maps symbolic \
coordinates to ",
 StyleBox["Part", "Input"],
 " expressions. Let\[CloseCurlyQuote]s bind and test ",
 StyleBox["\[CapitalGamma]get", "Input"],
 " on an arbitrary component:"
}], "Text",
 CellChangeTimes->{{3.978195072881373*^9, 3.9781952746259317`*^9}, {
  3.978195327873698*^9, 3.978195355528059*^9}, {3.978216153503653*^9, 
  3.978216187488549*^9}, {3.978216243381607*^9, 3.978216245488435*^9}, {
  3.978216281297687*^9, 3.9782164056059113`*^9}, {3.9782189090664454`*^9, 
  3.978218938405086*^9}, {3.979337490537085*^9, 
  3.979337506211536*^9}},ExpressionUUID->"478b46d8-fee1-40c6-9056-\
877630579473"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[CapitalGamma]Get", "=", 
       RowBox[{"MakeIndexer", "[", 
        RowBox[{"Schw\[CapitalGamma]", ",", "coords"}], "]"}]}], ")"}], "[", 
     RowBox[{"r", ",", "r", ",", "r"}], "]"}], 
    ",", "\"\<\!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalGamma]\), \(\
\[VeryThinSpace]\(r\)\)], \(\[VeryThinSpace]\(r\[VeryThinSpace]r\)\)]\) \
=\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9780200372771053`*^9, 3.9780200667175417`*^9}, {
   3.978020924532802*^9, 3.978020926453854*^9}, 3.978020997650296*^9, {
