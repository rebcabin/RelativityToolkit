  TagBox["\<\"\\!\\(\\*SubscriptBox[SuperscriptBox[\\(\[CapitalGamma]\\), \\(\
\[VeryThinSpace]\\(r\\)\\)], \
\\(\[VeryThinSpace]\\(t\[VeryThinSpace]t\\)\\)]\\) diag only =\"\>",
   "EchoLabel"], "  ", 
  RowBox[{
