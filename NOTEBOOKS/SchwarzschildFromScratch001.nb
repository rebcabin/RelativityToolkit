Cell[CellGroupData[{

Cell["The Ricci Ansatz", "Subsection",
 CellChangeTimes->{{3.978195906218898*^9, 
  3.978195910617653*^9}},ExpressionUUID->"368c30ad-403d-4965-aa3f-\
68620081a433"],

Cell[TextData[{
 "Via another new compiler function, ",
 StyleBox["CalculateRicciComponent", "Input",
  Background->RGBColor[1, 0.75, 0, 0.33]],
 ", which contracts Riemann over its up index and its second down index. Pass \
in ",
 StyleBox["Rget", "Input"],
 " and the coords, and iterate over the remaining 16 index values. "
}], "Text",
 CellChangeTimes->{{3.978195921032857*^9, 3.978196051143051*^9}, {
   3.978216559279242*^9, 3.978216565790262*^9}, 3.978216605028508*^9, {
   3.978223263627935*^9, 
   3.978223306033126*^9}},ExpressionUUID->"d33d1e3b-f34e-4769-a884-\
c37cdae97797"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"SchwRicci", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"CalculateRicciComponent", "[", 
          RowBox[{"\[Lambda]", ",", "\[Rho]", ",", "RGet", ",", "coords"}], 
          "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\[Lambda]", ",", "coords"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Rho]", ",", "coords"}], "}"}]}], "]"}]}], ")"}], "//", 
     "TraditionalForm"}], 
    ",", "\"\<\!\(\*SubscriptBox[\(R\), \(\[VeryThinSpace]\(\[Lambda]\
\[VeryThinSpace]\[Rho]\)\)]\) =\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.978045429304514*^9, 3.978045435189722*^9}, {
   3.978045788850071*^9, 3.9780460051743927`*^9}, 3.978046223603492*^9, {
   3.978046269050295*^9, 3.9780462712250023`*^9}, {3.978048422060852*^9, 
   3.9780484269548597`*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"63dd3dca-8453-436a-9eb5-10042f985ca9"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"\\!\\(\\*SubscriptBox[\\(R\\), \\(\[VeryThinSpace]\\(\[Lambda]\
\[VeryThinSpace]\[Rho]\\)\\)]\\) =\"\>",
   "EchoLabel"], "  ", 
