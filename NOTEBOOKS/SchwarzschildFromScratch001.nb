Cell[CellGroupData[{

Cell["Boundary Conditions at Infinity", "Subsubsection",
 CellChangeTimes->{{3.978223392773527*^9, 
  3.978223400338682*^9}},ExpressionUUID->"06b7c44e-c563-4bef-ab78-\
9f760a1c0908"],

Cell[TextData[{
 "Apply boundary conditions: flat space at infinity, meaning ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderscriptBox["lim", 
      RowBox[{"r", "->", "\[Infinity]"}]], 
     RowBox[{"A", "[", "r", "]"}]}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"36641e3f-850a-4dbc-96c8-eea8c16f9be2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderscriptBox["lim", 
      RowBox[{"r", "->", "\[Infinity]"}]], 
     RowBox[{"B", "[", "r", "]"}]}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"2779d194-553d-493b-80ce-1cfdc0e95d1c"],
 " (time and space have their undistorted coordinate meanings in flat space, \
far from the black hole), to deduce that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ConstantC]", "1"], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"d80bf7f6-c0d0-47ce-aa99-f55c200dc9fa"],
 ".",
 Cell[BoxData[
  FormBox["\[ImplicitPlus]", TraditionalForm]],ExpressionUUID->
  "1e402634-a271-489a-ac9e-6e317e09af5f"]
}], "Text",
 CellChangeTimes->{{3.978219751015634*^9, 3.97821992299227*^9}, {
  3.978219953767622*^9, 3.978220141376216*^9}, {3.978223421336382*^9, 
