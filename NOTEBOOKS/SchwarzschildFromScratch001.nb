        RowBox[{
         RowBox[{"CalculateRiemannComponent", "[", 
          RowBox[{
          "\[Mu]", ",", "\[Lambda]", ",", "\[Nu]", ",", "\[Rho]", ",", 
           "\[CapitalGamma]Get", ",", "coords"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "coords"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Lambda]", ",", "coords"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Nu]", ",", "coords"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Rho]", ",", "coords"}], "}"}]}], "]"}]}], ")"}], "//", 
     RowBox[{
      RowBox[{"Short", "[", 
       RowBox[{"#", ",", "5"}], "]"}], "&"}]}], ",", 
    "\[IndentingNewLine]", "\"\<\!\(\*SubscriptBox[SuperscriptBox[\(R\), \(\
\[Mu]\)], \(\[Lambda]\[Nu]\[Rho]\)]\) =\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.978042907842923*^9, 3.9780430269607677`*^9}, {
  3.978044156876031*^9, 3.978044167990858*^9}, {3.978044264187767*^9, 
