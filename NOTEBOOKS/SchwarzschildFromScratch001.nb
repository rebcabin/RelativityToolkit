            RowBox[{"A", "(", "r", ")"}], "2"], " ", 
           RowBox[{"B", "(", "r", ")"}]}]]}], "0", "0"},
       {"0", "0", 
        RowBox[{
         FractionBox[
          RowBox[{
           FractionBox[
            RowBox[{"r", " ", 
             RowBox[{
              SuperscriptBox["A", "\[Prime]",
               MultilineFunction->None], "(", "r", ")"}]}], 
            RowBox[{"2", " ", 
             RowBox[{"A", "(", "r", ")"}]}]], "+", "1"}], 
          RowBox[{"B", "(", "r", ")"}]], "-", 
