Cell[TextData[{
 "Notice the unevaluated partial derivatives in comma notation, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox[
     RowBox[{"A", "[", "r", "]"}], 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{",", "\[VeryThinSpace]", "r"}]}]]}], TraditionalForm]],
  ExpressionUUID->"3645f3f7-f31b-473e-bfa3-f14f6d871c1b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"A", "[", "r", "]"}], 
