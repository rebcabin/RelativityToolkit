   3.977746648340251*^9}, {3.977915629794395*^9, 3.9779156364877872`*^9}, {
   3.977915706330698*^9, 3.9779157169166117`*^9}, {3.9781876577545357`*^9, 
   3.978187770261375*^9}, {3.978187828031942*^9, 3.9781878788497143`*^9}, {
