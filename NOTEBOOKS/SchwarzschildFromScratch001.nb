Cell[CellGroupData[{

Cell["The Einstein Vacuum Equations", "Section",
 CellChangeTimes->{{3.978196062857646*^9, 
  3.978196070012636*^9}},ExpressionUUID->"93b61e40-8564-46fd-a0e3-\
71223e4e7fb5"],

Cell[TextData[{
 "We can see immediately that there is a lot of structure in Ricci. In \
particular, the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "\[VeryThinSpace]", "t"}], TraditionalForm]],ExpressionUUID->
  "98c57133-30ed-474c-8eb4-6e53b7756ea6"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "\[VeryThinSpace]", "r"}], TraditionalForm]],ExpressionUUID->
  "d482c07f-0f5b-4e8d-9b9d-3f6f30b9eabb"],
 " components are very similar. We\[CloseCurlyQuote]ll wrestle a tight, easy \
equation out of them."
}], "Text",
 CellChangeTimes->{{3.97821661503404*^9, 3.9782166354563313`*^9}, {
  3.978219133534739*^9, 
  3.978219223081234*^9}},ExpressionUUID->"2b16b00a-0d94-46cf-8c82-\
49a715cc6bf1"],

Cell["Of course, we\[CloseCurlyQuote]ll need a getter for Ricci.", "Text",
 CellChangeTimes->{{3.9782165780310497`*^9, 
  3.978216610533434*^9}},ExpressionUUID->"76c12a14-1cd7-46b8-b93b-\
aaf22dc1b701"],

