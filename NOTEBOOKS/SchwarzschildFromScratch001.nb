Cell[TextData[{
 "Substituting our solution for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "[", "r", "]"}], TraditionalForm]],ExpressionUUID->
  "c4a9a058-d3f5-4f0b-bf60-b3942d69f84c"],
 " into the ansatz, we have"
}], "Text",
 CellChangeTimes->{{3.978221396220543*^9, 
  3.9782214581357594`*^9}},ExpressionUUID->"21dbf002-b41b-4f82-99fa-\
ad17192c5d96"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"t", "\[VeryThinSpace]", "t"}]}]], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"A", "[", "r", "]"}]}], "=", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       FractionBox[
        SubscriptBox["\[ConstantC]", "1"], "r"]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.978221183141355*^9, 3.9782212393804903`*^9}, {
  3.978221344512765*^9, 3.978221373324911*^9}, {3.978221469689541*^9, 
  3.97822150437001*^9}, {3.9782215469792128`*^9, 
  3.978221552219207*^9}},ExpressionUUID->"965f3827-7100-4aa3-907c-\
46afb7af56d4"],

Cell[TextData[{
 "Thus ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ConstantC]", "1"], "=", 
    RowBox[{
     RowBox[{"-", "2"}], "M"}]}], TraditionalForm]],ExpressionUUID->
  "dd27c3a0-b250-4a92-a499-052befad85c1"],
 "."
}], "Text",
 CellChangeTimes->{{3.978095708351858*^9, 3.978095719850621*^9}, {
  3.978220413042335*^9, 3.978220510319973*^9}, {3.978220542831746*^9, 
  3.978220569362372*^9}, {3.9782235299097147`*^9, 
  3.9782235418523684`*^9}},ExpressionUUID->"b49544c5-e5c9-4892-ba81-\
df61f13836e3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Validation Against Wolfram Function Repository", "Section",
 CellChangeTimes->{{3.97822355388585*^9, 
  3.978223567404305*^9}},ExpressionUUID->"d56323a5-62e4-4109-85ea-\
172757b979d6"],

Cell["Pulling together all our results:", "Text",
 CellChangeTimes->{{3.9782237366613483`*^9, 
  3.978223776463778*^9}},ExpressionUUID->"4a7a9aef-7c75-44e8-a008-\
3aad67462d3c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"SchwAnsatz", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"B", "[", "r", "]"}], "->", 
         RowBox[{"1", "/", 
          RowBox[{"A", "[", "r", "]"}]}]}], "}"}]}], "/.", "SchwA"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"1"},
        "C"], "->", 
       RowBox[{
        RowBox[{"-", "2"}], "M"}]}], "}"}]}], 
    ",", "\"\<Schwarzschild Solution via \[ScriptCapitalU]\[ScriptCapitalD] :\
\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.978223570813449*^9, 3.9782236426712847`*^9}, 
   3.978223677242341*^9, {3.978225542333416*^9, 3.9782255824789257`*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"0a5140af-748a-434f-8902-43cec3913877"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Schwarzschild Solution via \[ScriptCapitalU]\[ScriptCapitalD] :\
\"\>",
   "EchoLabel"], "  ", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        FractionBox[
         RowBox[{"2", " ", "M"}], "r"]}], ",", "0", ",", "0", ",", "0"}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox["1", 
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"2", " ", "M"}], "r"]}]], ",", "0", ",", "0"}], "}"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       SuperscriptBox["r", "2"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", 
       RowBox[{
        SuperscriptBox["r", "2"], " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], "}"}]}], "}"}], 
   "}"}]}]], "Echo",
 CellChangeTimes->{
  3.978228606841817*^9},ExpressionUUID->"b6f03efc-bff2-47ab-bae8-\
98c7abb9a0b0"]
}, Open  ]],

Cell["and comparing against the WFR resource", "Text",
 CellChangeTimes->{{3.978223762999488*^9, 
  3.978223810738841*^9}},ExpressionUUID->"e827ff39-3d0b-42ac-8662-\
1ff8bf052309"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"ResourceFunction", "[", "\"\<MetricTensor\>\"", "]"}], 
      "[", "\"\<Schwarzschild\>\"", "]"}], "[", "\"\<MatrixRepresentation\>\"",
      "]"}], ",", "\"\<Schwarzschild Solution via WFR :\>\""}], "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9782255897681723`*^9, 3.9782256107836103`*^9}, 
