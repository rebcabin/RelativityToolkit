Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"Schw\[CapitalGamma]", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"ContractAll", "[", 
            RowBox[{
             RowBox[{"ChristoffelsFromMetric", "[", 
              RowBox[{
              "gDD", ",", "gUU", ",", "\[Sigma]", ",", "\[Mu]", ",", 
               "\[Nu]"}], "]"}], ",", "coords"}], "]"}], "/.", 
           "\[IndentingNewLine]", "SchwRules"}], "/.", "SchwInvRules"}], "/.",
          "offDiagonalRules"}], "//", "EvaluateUDPartials"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"\[Sigma]", ",", "coords"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Mu]", ",", "coords"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Nu]", ",", "coords"}], "}"}]}], "]"}]}], ")"}], "//", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"#", "//", "MatrixForm"}], 
      ",", "\"\<Ansatz \[CapitalGamma] =\>\""}], "]"}], "&"}]}], 
  ";"}]], "Input",
