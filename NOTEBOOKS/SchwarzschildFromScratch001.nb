   3.978222733034404*^9}},ExpressionUUID->"8fdf4451-d7f7-48f5-92eb-\
f9a73552ef82"],

Cell[TextData[{
 StyleBox["The ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "\[VeryThinSpace]", "t"}], TraditionalForm]],ExpressionUUID->
  "adfa2405-707d-45cc-afe6-d5255bbb77d7"],
 StyleBox[" component of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  ExpressionUUID->"710e1bea-b01b-4842-9331-4f0bf338b633"],
 StyleBox[" is negative because we employ the ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "1", ",", "1", ",", "1"}], ")"}], 
   TraditionalForm]],ExpressionUUID->"59224e60-9cdf-4e37-acd7-f495512d63fa"],
 StyleBox[" sign convention for Lorentz invariance.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.978191033305602*^9, 3.978191054467911*^9}, {
  3.978191966259078*^9, 3.97819207592404*^9}, {3.9781924136227694`*^9, 
  3.9781924451217422`*^9}},ExpressionUUID->"2931150c-d1c1-48ea-ad20-\
5ba772e156ec"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Metric Rules", "Subsection",
 CellChangeTimes->{{3.9781922025654173`*^9, 
  3.9781922052266817`*^9}},ExpressionUUID->"924a3d83-73b0-4f92-bf41-\
5487b0bd38ce"],

Cell[TextData[{
 "Call the new compiler function, ",
 StyleBox["MatrixToUDRules", "Input",
  Background->RGBColor[1, 0.75, 0, 0.33]],
 ", to create some rules that map \
\[ScriptCapitalU]\[ScriptCapitalD]\[NoBreak]-\[NoBreak]indexed components of \
a given symbol, say ",
 StyleBox["gDD", "Input"],
 ", to the components of the ansatz matrix. We\[CloseCurlyQuote]ll need these \
rules later to concretize an abstract expression for \[CapitalGamma]. "
}], "Text",
 CellChangeTimes->{{3.978192221904088*^9, 3.9781922901081133`*^9}, {
   3.978214447515636*^9, 3.978214586780025*^9}, {3.9782146194738693`*^9, 
   3.978214806482099*^9}, {3.978218257599633*^9, 3.9782182588447313`*^9}, 
   3.978218327714691*^9, {3.9782186503010187`*^9, 
   3.97821865083925*^9}},ExpressionUUID->"3cad0f1c-00fc-4ce2-940e-\
e8d26693ad2d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"SchwRules", "=", 
     RowBox[{"MatrixToUDRules", "[", 
      RowBox[{
      "SchwAnsatz", ",", "gDD", ",", "\[ScriptCapitalD]", ",", "coords"}], 
      "]"}]}], ",", " ", "\"\<Schw rules :\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.977916813480853*^9, 3.977916826941023*^9}, {
   3.9779407308444233`*^9, 3.977940773866407*^9}, {3.97794082661156*^9, 
   3.977940939484643*^9}, 3.977941457585986*^9, {3.977941645311081*^9, 
   3.977941652043281*^9}, {3.977942092566986*^9, 3.977942100398808*^9}, {
   3.9779447081151657`*^9, 3.977944709680691*^9}, {3.977945319075341*^9, 
   3.977945326309247*^9}, 3.9779888441130342`*^9, {3.9780076892293797`*^9, 
   3.978007732449287*^9}, {3.9780077800160227`*^9, 3.978007837277759*^9}, {
   3.978007868330056*^9, 3.978007924283086*^9}, 3.978008110446718*^9, 
   3.978011024593129*^9, 3.97809641214109*^9, {3.97809656085817*^9, 
   3.9780965614850187`*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"b8727725-69a5-482c-87c2-f899dae2ea30"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Schw rules :\"\>",
   "EchoLabel"], "  ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"gDD", 
      SubscriptBox["", "t"], 
      SubscriptBox["", "t"]}], "\[Rule]", 
     RowBox[{"-", 
      RowBox[{"A", "[", "r", "]"}]}]}], ",", 
    RowBox[{
     RowBox[{"gDD", 
      SubscriptBox["", "r"], 
      SubscriptBox["", "r"]}], "\[Rule]", 
     RowBox[{"B", "[", "r", "]"}]}], ",", 
    RowBox[{
     RowBox[{"gDD", 
      SubscriptBox["", "\[Theta]"], 
      SubscriptBox["", "\[Theta]"]}], "\[Rule]", 
     SuperscriptBox["r", "2"]}], ",", 
    RowBox[{
     RowBox[{"gDD", 
      SubscriptBox["", "\[Phi]"], 
      SubscriptBox["", "\[Phi]"]}], "\[Rule]", 
     RowBox[{
      SuperscriptBox["r", "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}]}], "}"}]}]], "Echo",
 CellChangeTimes->{
  3.9793370102362633`*^9},ExpressionUUID->"6f837a6c-8e20-4ddd-bc82-\
49c6d6260005"]
}, Open  ]],

Cell[TextData[{
 "For brevity, ",
 StyleBox["MatrixToUDRules", "Input",
  FontSlant->"Plain"],
 " doesn\[CloseCurlyQuote]t produce rules for zeros in the matrix. We\
\[CloseCurlyQuote]ll put those in later, by hand, in a concise way that \
exploits structural knowledge of ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "ca52a634-f40e-4bf4-8c28-c8f20dced9f1"],
 "."
}], "Item",
 CellChangeTimes->{{3.978222774693768*^9, 3.978222853077169*^9}},
 FontSlant->"Italic",ExpressionUUID->"75f80a72-a867-4de7-984f-dc00fd937ef4"],

Cell[TextData[{
 "TODO: Sparse-matrix version of ",
 StyleBox["MatrixToUDRules", "Input",
  FontSlant->"Plain"],
 " that concisely handles zero elements."
}], "Item",
 CellChangeTimes->{{3.9782268391295223`*^9, 3.978226882529562*^9}},
 FontSlant->"Italic",ExpressionUUID->"e5d0f038-4b59-4b17-9494-d92fb58e0320"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Contravariant Metric Tensor and Rules", "Subsection",
 CellChangeTimes->{{3.9781923060218887`*^9, 3.978192313092054*^9}, {
  3.978214309186017*^9, 
  3.978214313927841*^9}},ExpressionUUID->"ae849ecc-f6d5-4b33-a9a6-\
6599fdb3ac0c"],

Cell[TextData[{
 "The contravariant version, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  ExpressionUUID->"a0eab90f-8ad7-4ecb-b7bc-e5d985f110bd"],
 ", of ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "fea9ba55-b445-4d0b-8e10-60151dd30fca"],
 " is just the matrix inverse of the covariant version ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "db83c3d7-5298-4c22-b7c6-71fdbe226aed"],
 " (because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Rho]"}]}]], 
     SubscriptBox["g", "\[Rho]\[Nu]"]}], "=", 
    SubscriptBox[
     SuperscriptBox["\[Delta]", 
      RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], "\[Nu]"]}], TraditionalForm]],
  ExpressionUUID->"ee0bfb5d-5288-48d2-b908-5ae5e839e292"],
 "). Ending with the needed rules for ",
 StyleBox[Cell[BoxData[
  FormBox["gUU", TraditionalForm]], "Input",ExpressionUUID->
  "e05296d6-bc70-4540-b144-8eca4b12b526"], "Input"],
 StyleBox[",", "Input"],
 " we get:"
}], "Text",
 CellChangeTimes->{{3.978192317741683*^9, 3.978192394869299*^9}, {
  3.978214835224828*^9, 3.9782148392929487`*^9}, {3.9793370420318613`*^9, 
  3.979337124170978*^9}},ExpressionUUID->"c17a10ea-6ec8-41ee-bc8a-\
d60a486f6244"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SchwAnsatzInv", "=", 
   RowBox[{"Inverse", "[", "SchwAnsatz", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"SchwInvRules", "=", 
     RowBox[{"MatrixToUDRules", "[", 
      RowBox[{
      "SchwAnsatzInv", ",", "gUU", ",", "\[ScriptCapitalU]", ",", "coords"}], 
      "]"}]}], ",", " ", "\"\<Schw Inv rules :\>\""}], "]"}], ";"}]}], "Input",\

 CellChangeTimes->{{3.977942185004792*^9, 3.977942262929964*^9}, {
   3.977945341382947*^9, 3.977945352693774*^9}, 3.977988960547517*^9, {
   3.978007742089058*^9, 3.978007744336866*^9}, 3.978008111473281*^9, 
   3.978011027232847*^9, {3.978096584520122*^9, 3.978096585243936*^9}, 
   3.9782143179035873`*^9},
 CellLabel->"In[12]:=",ExpressionUUID->"90fd7d66-9943-44bd-a5fd-3e5a32e058fd"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Schw Inv rules :\"\>",
   "EchoLabel"], "  ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"gUU", 
      SuperscriptBox["", "t"], 
      SuperscriptBox["", "t"]}], "\[Rule]", 
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"A", "[", "r", "]"}]]}]}], ",", 
    RowBox[{
     RowBox[{"gUU", 
      SuperscriptBox["", "r"], 
      SuperscriptBox["", "r"]}], "\[Rule]", 
     FractionBox["1", 
      RowBox[{"B", "[", "r", "]"}]]}], ",", 
    RowBox[{
     RowBox[{"gUU", 
      SuperscriptBox["", "\[Theta]"], 
      SuperscriptBox["", "\[Theta]"]}], "\[Rule]", 
     FractionBox["1", 
      SuperscriptBox["r", "2"]]}], ",", 
    RowBox[{
     RowBox[{"gUU", 
      SuperscriptBox["", "\[Phi]"], 
      SuperscriptBox["", "\[Phi]"]}], "\[Rule]", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"], 
      SuperscriptBox["r", "2"]]}]}], "}"}]}]], "Echo",
 CellChangeTimes->{
  3.979337037224153*^9},ExpressionUUID->"c5ed77be-eb0b-4d40-a8cf-\
9b6bcb83cd57"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Christoffel Symbols", "Subsection",
 CellChangeTimes->{{3.978192469793416*^9, 
  3.9781924753917007`*^9}},ExpressionUUID->"e18e650e-ce83-4121-83bb-\
ad4cb4b50818"],

Cell[TextData[{
 "The functions developed in an earlier notebook, ",
 StyleBox["Riemann Curvature in ",
  FontSlant->"Italic"],
 "\[ScriptCapitalU]\[ScriptCapitalD]",
 StyleBox[" + Compiler POC",
  FontSlant->"Italic"],
 ", have been captured in a new compiler function, ",
 StyleBox["ChristoffelsFromMetric", "Input",
  Background->RGBColor[1, 0.75, 0, 0.33]],
 ", which computes a commutator of covariant derivatives. See it as an \
unevaluated contraction over a bound ",
 StyleBox["Unique", "Input"],
 " index:"
}], "Text",
 CellChangeTimes->{{3.9781925053629427`*^9, 3.978192522971711*^9}, {
   3.978192686763955*^9, 3.9781928505605173`*^9}, {3.978192907871084*^9, 
   3.978192975257187*^9}, {3.978193006206502*^9, 3.978193085030589*^9}, {
   3.978214384381565*^9, 3.978214437590973*^9}, {3.9782148675012083`*^9, 
   3.9782149030145893`*^9}, 3.978214967947057*^9, {3.978215032616589*^9, 
   3.978215049617358*^9}, {3.9782151248903923`*^9, 3.97821512789323*^9}, {
   3.9782153643193274`*^9, 3.978215376527761*^9}, {3.978222909410356*^9, 
   3.9782229112980833`*^9}},ExpressionUUID->"59218fb3-0edf-49cf-a307-\
74150863db68"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"ChristoffelsFromMetric", "[", 
     RowBox[{"gDD", ",", "gUU", ",", "\[Sigma]", ",", "\[Mu]", ",", "\[Nu]"}],
      "]"}], ",", " ", "\"\<Unevaluated Contraction :\>\""}], "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9779423861580877`*^9, 3.9779424752786703`*^9}, {
   3.977989900023822*^9, 3.9779899166293163`*^9}, 3.9781928103203506`*^9, 
   3.978193024936234*^9, 3.9782149525189133`*^9, {3.978215081894136*^9, 
