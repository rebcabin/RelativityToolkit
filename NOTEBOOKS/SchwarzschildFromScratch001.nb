         RowBox[{"{", 
          RowBox[{"\[Nu]", ",", "coords"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Rho]", ",", "coords"}], "}"}]}], "]"}]}], ")"}], "//", 
     RowBox[{
      RowBox[{"Short", "[", 
