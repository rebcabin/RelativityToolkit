 CellLabel->"In[42]:=",ExpressionUUID->"2d1b3a2d-58d8-4686-b68f-d5a44ba5d9e8"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Schwarzschild Solution via WFR :\"\>",
   "EchoLabel"], "  ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       FractionBox[
        RowBox[{
        "2", " ", "\<\"\[FormalCapitalM]\"\>"}], "\<\"\[FormalR]\"\>"]}], ",",
       "0", ",", "0", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      FractionBox["1", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{
         "2", " ", "\<\"\[FormalCapitalM]\"\>"}], "\<\"\[FormalR]\"\>"]}]], ",",
       "0", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", 
      SuperscriptBox["\<\"\[FormalR]\"\>", "2"], ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", 
      RowBox[{
       SuperscriptBox["\<\"\[FormalR]\"\>", "2"], " ", 
       SuperscriptBox[
        RowBox[{"Sin", "[", "\<\"\[FormalTheta]\"\>", "]"}], "2"]}]}], 
     "}"}]}], "}"}]}]], "Echo",
 CellChangeTimes->{
  3.979337791477639*^9},ExpressionUUID->"e0a2d94e-c766-43f3-b2f2-\
6ab83b04160e"]
}, Open  ]],

Cell["\<\
we see a perfect match, except for WFR\[CloseCurlyQuote]s convention of \
formal symbols (with underdots).\
\>", "Text",
 CellChangeTimes->{{3.9782238230028*^9, 
  3.978223854840865*^9}},ExpressionUUID->"ac2e29e4-338b-4528-9e1f-\
