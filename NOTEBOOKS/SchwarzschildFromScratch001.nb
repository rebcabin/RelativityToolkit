Cell[CellGroupData[{

Cell["Kill Off-Diagonal Elements", "Subsubsection",
 CellChangeTimes->{{3.978194067731145*^9, 
  3.978194074710384*^9}},ExpressionUUID->"2a39e0ee-5b09-459e-85bb-\
c01943e728be"],

Cell["Write concise rules to zero-out the off-diagonal components:", "Text",
 CellChangeTimes->{{3.978194095934067*^9, 3.9781941454755077`*^9}, 
   3.9781945042664824`*^9, {3.978218410495751*^9, 3.978218490967349*^9}, {
   3.978218535129129*^9, 3.978218546507245*^9}, {3.97821857750417*^9, 
