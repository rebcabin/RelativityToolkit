   3.978218786392024*^9, 3.978218813433014*^9}, {3.978222991496331*^9, 
   3.978223087012775*^9}, {3.978226901095517*^9, 
   3.978226935451626*^9}},ExpressionUUID->"b742c509-f111-43da-9faa-\
3e34a45f8127"],

Cell[BoxData[
 RowBox[{
  RowBox[{"offDiagonalRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"gUU", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalU]", "[", "a_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalU]", "[", "b_", "]"}]}], "]"}], "/;", 
       RowBox[{"a", "=!=", "b"}]}], "->", "0"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"gDD", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "a_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "b_", "]"}]}], "]"}], "/;", 
       RowBox[{"a", "=!=", "b"}]}], "->", "0"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.978011280184704*^9, 3.978011369019741*^9}, {
  3.9780114357258368`*^9, 3.978011544372802*^9}, {3.9781941527910833`*^9, 
  3.978194154440064*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"08f8f69c-57f4-412f-8423-6b485d8a0efe"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Recall that MatrixToUDRules does not currently do \
this, for practical reasons.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.978226950639677*^9, 
  3.978226971084722*^9}},ExpressionUUID->"d16c6144-a24c-435b-a058-\
e9fbc7db3dd5"],

