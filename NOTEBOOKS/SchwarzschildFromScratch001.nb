Cell[TextData[{
 "For a star of mass ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "e01a300e-0970-461c-b388-a17b406a36b5"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "=", 
    RowBox[{
