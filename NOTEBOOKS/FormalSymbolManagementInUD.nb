Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "FormalSymbolQ"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "FormalSymbolQ", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SetAttributes", "[", 
     RowBox[{
      RowBox[{"{", "FormalSymbolQ", "}"}], ",", "HoldAll"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FormalSymbolQ", "[", "s_", "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"self", ",", "eval"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"self", "=", 
         RowBox[{"checkFormalIdentity", "[", "s", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"TrueQ", "[", 
           RowBox[{"self", "[", "\"\<Pure\>\"", "]"}], "]"}], ",", 
          RowBox[{"Return", "[", "True", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Peek", " ", "at", " ", "OwnValues"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"eval", "=", 
         RowBox[{"ReleaseHold", "[", 
          RowBox[{"Replace", "[", 
           RowBox[{
            RowBox[{"Hold", "[", "s", "]"}], ",", 
            RowBox[{"sym_Symbol", ":>", 
             RowBox[{"OwnValues", "[", "sym", "]"}]}], ",", 
            RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MatchQ", "[", 
           RowBox[{"eval", ",", 
            RowBox[{"{", 
             RowBox[{"(", 
              RowBox[{"_", ":>", "_Symbol"}], ")"}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"target", "=", 
              RowBox[{"eval", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Return", "[", 
             RowBox[{"TrueQ", "[", 
              RowBox[{
               RowBox[{"checkFormalIdentity", "[", "target", "]"}], 
               "[", "\"\<Pure\>\"", "]"}], "]"}], "]"}]}], "]"}]}], "]"}], ";",
         "\[IndentingNewLine]", "False"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.97983129262798*^9, 3.979831292629407*^9}, {
  3.979834058347336*^9, 3.979834062164982*^9}, {3.979834093625381*^9, 
  3.979834148050899*^9}, {3.979834244964264*^9, 3.9798343841097183`*^9}, {
