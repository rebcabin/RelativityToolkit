Cell[CellGroupData[{

Cell["Polymorphism and Mutual Exclusivity", "Subsubsection",
 CellChangeTimes->{{3.979854764238976*^9, 
  3.9798547906028852`*^9}},ExpressionUUID->"1b341074-84e3-41ba-b332-\
87f1a693a1a0"],

Cell[TextData[{
 "The following results illustrate design features of the predicate functions \
",
 StyleBox["FormalSymbolQ", "Input"],
 " and ",
 StyleBox["FormalSymbolExtendedQ", "Input"],
 "."
}], "Text",
 CellChangeTimes->{{3.979854764238976*^9, 3.9798548155560627`*^9}, {
  3.979858820078918*^9, 
  3.979858827879756*^9}},ExpressionUUID->"650605f0-5c71-4271-8ca9-\
6557d8cde0e1"],

Cell[TextData[{
 " Polymorphism (Strings vs. Symbols): Both functions are overloaded to \
accept either a ",
 StyleBox["String", "Input"],
 " (the name) or a ",
 StyleBox["Symbol", "Input"],
 " (the literal). "
}], "Item",
 CellChangeTimes->{{3.979854764238976*^9, 3.979854792881626*^9}, {
   3.979854829642274*^9, 3.9798548304888773`*^9}, 3.9798548841616096`*^9, {
   3.979858839854519*^9, 
   3.979858861781695*^9}},ExpressionUUID->"f595adcd-9afc-43c4-8750-\
d13afcf926cb"],

Cell[CellGroupData[{

Cell["\<\
 Mutual Exclusivity: The domain of formal symbols is strictly partitioned.\
\>", "Item",
 CellChangeTimes->{
  3.979854764238976*^9, 3.979854794289489*^9, {3.979858877422452*^9, 
   3.979858888428259*^9}},ExpressionUUID->"b125aacd-0e19-4ef1-be24-\
8b39da66fa75"],

Cell[TextData[{
 "Pure System Symbols (e.g., ",
 StyleBox["\[FormalI]", "Input"],
 ") satisfy ",
 StyleBox["FormalSymbolQ", "Input"],
 " but fail ",
 StyleBox["FormalSymbolExtendedQ", "Input"],
 "."
}], "Subitem",
 CellChangeTimes->{3.979854764238976*^9, 3.979854795131575*^9, 
  3.979858897029029*^9},ExpressionUUID->"77c67678-93a7-4f0b-831f-\
b0c28bbb4399"],

Cell[TextData[{
 "Extended User Symbols (e.g., ",
 StyleBox["\[FormalI]543", "Input"],
 ") satisfy ",
 StyleBox["FormalSymbolExtendedQ", "Input"],
 " but fail ",
 StyleBox["FormalSymbolQ", "Input"],
 "."
}], "Subitem",
 CellChangeTimes->{
  3.979854764238976*^9, 3.979854795859066*^9, {3.9798589336741047`*^9, 
   3.9798589380554028`*^9}},ExpressionUUID->"43433e4d-1534-4c92-abc4-\
eb075170acda"]
}, Open  ]],

