Cell[CellGroupData[{

Cell["Identity Helper", "Section",
 CellChangeTimes->{{3.979834745961418*^9, 
  3.9798347492483883`*^9}},ExpressionUUID->"0a05b8d9-3ab5-4604-9cc4-\
7924a04c3b27"],

Cell[CellGroupData[{

Cell["Purpose", "Subsubsection",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862124507115*^9}, {
  3.979862362746785*^9, 
  3.979862363512285*^9}},ExpressionUUID->"3a5b1622-99bf-49a9-ae89-\
24ce23972b28"],

Cell[TextData[{
 StyleBox["checkFormalIdentity", "Input"],
 " is a low-level diagnostic tool that analyzes the structure of an input (",
 StyleBox["Symbol", "Input"],
 " or ",
 StyleBox["String", "Input"],
 ") without triggering its evaluation. It returns an ",
 StyleBox["Association", "Input"],
 " describing the \[OpenCurlyDoubleQuote]formal content\
\[CloseCurlyDoubleQuote] of the name."
}], "Text",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862124507115*^9}, {
  3.979862362746785*^9, 
  3.979862364373609*^9}},ExpressionUUID->"1d6373e2-4116-404f-97c4-\
57709c360e80"],

Cell["\<\
This function uses a double-layer defense against evaluation, critical when \
inspecting symbols that might have values assigned to them.\
\>", "Text",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862103097492*^9}, {
  3.979862153113353*^9, 
  3.979862184193384*^9}},ExpressionUUID->"44ab201a-9522-48e7-8f83-\
39ac1e81e88f"],

Cell[TextData[{
 StyleBox["SetAttributes[..., HoldFirst]", "Input"],
 ": stops the argument ",
 StyleBox["s", "Input"],
 " from evaluating before it enters the function. Without this, calling the \
function on a variable ",
 StyleBox["x", "Input"],
 " would pass ",
 StyleBox["x", "Input"],
 "\[CloseCurlyQuote]s value instead of ",
 StyleBox["x", "Input"],
 "."
}], "Text",
 CellChangeTimes->{{3.979862092080511*^9, 3.9798621043362722`*^9}, {
  3.979862186669518*^9, 
  3.97986223217249*^9}},ExpressionUUID->"d89a3b4a-84d6-43ee-a0e5-\
e963dca22dea"],

Cell[TextData[{
 StyleBox["Unevaluated[...]", "Input"],
 ": Second line of defense inside the function body. Even inside a held \
function, passing ",
 StyleBox["s", "Input"],
 " to certain other functions can trigger evaluation. Wrapping occurrences of \
",
 StyleBox["s", "Input"],
 " in ",
 StyleBox["Unevaluated", "Input"],
 ", e.g., ",
 StyleBox["SymbolName[Unevaluated[s]]", "Input"],
 ", guarantees that the called function operates strictly on the symbol \
itself, not its value."
}], "Text",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862105935421*^9}, {
  3.9798622433201838`*^9, 
  3.979862331583283*^9}},ExpressionUUID->"e0569b52-4b76-4003-8739-\
6ec6acef0019"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\[OpenCurlyDoubleQuote]Pure\[CloseCurlyDoubleQuote] vs. \
\[OpenCurlyDoubleQuote]Any\[CloseCurlyDoubleQuote] Metrics", "Subsubsection",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862106803763*^9}, {
  3.979862341282469*^9, 
  3.979862353857593*^9}},ExpressionUUID->"94f20cbf-faa8-49ba-b4c4-\
5824018493d2"],

Cell[TextData[{
 StyleBox["checkFormalIdentity", "Input"],
 " creates the raw data needed to distinguish symbol types."
}], "Text",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862106803763*^9}, {
  3.979862341282469*^9, 
  3.9798623799018383`*^9}},ExpressionUUID->"02340f4c-5cc6-4d36-8f0c-\
b8ceb8781f0e"],

Cell["\<\
\[OpenCurlyDoubleQuote]Pure\[CloseCurlyDoubleQuote] (Strict Definition): \
Checks whether the name consists of exactly one character and that character \
is a valid formal symbol code.\
\>", "Text",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862107691328*^9}, {
  3.979862386156185*^9, 
  3.979862430942178*^9}},ExpressionUUID->"a0c9cc44-8dea-43d2-bc84-\
0b7d3474f82f"],

Cell[TextData[{
 "Result: True only for System Formal Symbols (e.g., ",
 StyleBox["\[FormalA]", "Input"],
 ")."
}], "Text",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862107691328*^9}, {
  3.979862386156185*^9, 
  3.979862427841846*^9}},ExpressionUUID->"10bacb45-e244-4fa3-98c3-\
594f909af3eb"],

Cell["\<\
\[OpenCurlyDoubleQuote]Any\[CloseCurlyDoubleQuote] (Loose Definition): Checks \
whether the name contains at least one valid Formal Symbol code anywhere in \
the string.\
\>", "Text",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862109331273*^9}, {
  3.979862441969781*^9, 
  3.979862451313066*^9}},ExpressionUUID->"3ae9ad81-11e7-458e-89c4-\
e6a48962f3bd"],

Cell[TextData[{
 "Result: True for both System Symbols (",
 StyleBox["\[FormalA]", "Input"],
 ") and Extended Symbols (",
 StyleBox["\[FormalA]123", "Input"],
 ")."
}], "Text",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862110132688*^9}, {
  3.9798625753163557`*^9, 
  3.979862587150037*^9}},ExpressionUUID->"98d210af-35c5-4f09-969b-\
f47609710739"],

Cell["\<\
Distinguishing Formal vs. Extended Does this function distinguish them? Yes, \
by inference. While it doesn\[CloseCurlyQuote]t output a classification \
string like \[OpenCurlyDoubleQuote]Extended\[CloseCurlyDoubleQuote], the \
returned association provides the logic to do so:\
\>", "Text",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862112435854*^9}, {
  3.979862655563686*^9, 
  3.9798626565420017`*^9}},ExpressionUUID->"f2c2efc9-ba3a-4115-9ee7-\
85acadb12afd"],

Cell["    Pure System Symbol: {| \[OpenCurlyDoubleQuote]Pure\
\[CloseCurlyDoubleQuote] -> True, \[OpenCurlyDoubleQuote]Any\
\[CloseCurlyDoubleQuote] -> True |}", "Text",
 CellChangeTimes->{{3.979862092080511*^9, 
  3.979862113162735*^9}},ExpressionUUID->"6c17cfe2-e1ce-4bab-bc08-\
7da59130652a"],

Cell["\<\
    Extended Formal Symbol: {| \[OpenCurlyDoubleQuote]Pure\
\[CloseCurlyDoubleQuote] -> False, \[OpenCurlyDoubleQuote]Any\
\[CloseCurlyDoubleQuote] -> True |}\
\>", "Text",
 CellChangeTimes->{{3.979862092080511*^9, 
  3.979862113886713*^9}},ExpressionUUID->"8185e93c-a383-401d-863c-\
67e0bd05e839"],

Cell["    Regular Symbol: {| \[OpenCurlyDoubleQuote]Pure\
\[CloseCurlyDoubleQuote] -> False, \[OpenCurlyDoubleQuote]Any\
\[CloseCurlyDoubleQuote] -> False |}", "Text",
 CellChangeTimes->{{3.979862092080511*^9, 
  3.979862114622738*^9}},ExpressionUUID->"90224fd5-3119-4161-924d-\
c93328829c1f"],

Cell["\<\
This helper serves as the \[OpenCurlyDoubleQuote]truth on the ground\
\[CloseCurlyDoubleQuote] for your higher-level predicates.\
\>", "Text",
 CellChangeTimes->{
  3.979862092080511*^9},ExpressionUUID->"84953a13-0bd4-463e-afc6-\
4de13d3ec4d5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "checkFormalIdentity", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"checkFormalIdentity", ",", "HoldFirst"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"checkFormalIdentity", "[", "s_", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", "codes"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"name", "=", 
       RowBox[{"Which", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "===", "Symbol"}], ",", 
         RowBox[{"SymbolName", "[", 
          RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"StringQ", "[", 
          RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], ",", 
         RowBox[{"Unevaluated", "[", "s", "]"}], ",", "\[IndentingNewLine]", 
         "True", ",", 
         RowBox[{"ToString", "[", 
          RowBox[{"Unevaluated", "[", "s", "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"codes", "=", 
       RowBox[{"ToCharacterCode", "[", "name", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Pure\>\"", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "codes", "]"}], "==", "1"}], "&&", 
           RowBox[{"formalCharCodeQ", "[", 
            RowBox[{"First", "[", "codes", "]"}], "]"}]}], ")"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<Any\>\"", "->", 
         RowBox[{"AnyTrue", "[", 
          RowBox[{"codes", ",", "formalCharCodeQ"}], "]"}]}]}], "|>"}]}]}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.97983129262798*^9, 3.979831292629407*^9}, {
   3.979834058347336*^9, 3.979834062164982*^9}, {3.979834093625381*^9, 
   3.979834148050899*^9}, {3.979834244964264*^9, 3.9798343841097183`*^9}, {
   3.979834842063798*^9, 3.97983486372563*^9}, 
   3.979862471211678*^9},ExpressionUUID->"1e710411-6e34-4cf2-9f56-\
89a8dd97fb8b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FormalSymbolExtendedQ", "[", "\"\<qwer\[FormalI]2345\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{3.979862521857583*^9, 3.979862540019125*^9}},
 CellLabel->
  "In[432]:=",ExpressionUUID->"38bfaa1a-c56a-4e33-8e44-7a151fdad91a"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.97986254247976*^9},
 CellLabel->
  "Out[432]=",ExpressionUUID->"437abb31-8d85-43ef-b702-f6cfe4193b0e"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Formal Symbol Predicate", "Section",
 CellChangeTimes->{{3.9798348695613956`*^9, 
  3.979834877758819*^9}},ExpressionUUID->"ed66d3d7-2c39-4617-83c2-\
c0b8baabb5d5"],

Cell[CellGroupData[{

Cell[TextData[{
 "TODO 4: Documentation of what a formal symbol is and is not; explanation of \
how this works and why it\[CloseCurlyQuote]s so complicated (all the edge \
cases that we found and eliminated). Explain the need for all the hard-core \
features of Wolfram: the ",
 StyleBox["HoldAll", "Input"],
 " attribute, the ",
 StyleBox["Hold", "Input"],
 " and ",
 StyleBox["ReleaseHold", "Input"],
 " calls, and why we\[CloseCurlyQuote]re checking ",
 StyleBox["OwnValues", "Input"],
 " and not ",
 StyleBox["DownValues", "Input"],
 ", ",
 StyleBox["UpValues", "Input"],
 ", and any other kinds of values., and any other details we can think of. We \
did a LOT of work to get to this point, and I don\[CloseCurlyQuote]t want us \
to lose any of the thinking and trial-and-error we did along the way."
}], "Item",
 CellChangeTimes->{{3.979834957921474*^9, 3.9798350069595547`*^9}, {
