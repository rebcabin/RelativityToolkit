Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "showCodes", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"showCodes", "[", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"codes", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"63488", ",", "63615"}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"MapIndexed", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Column", "[", 
             RowBox[{
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Item", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"Symbol", "@", 
                    RowBox[{"FromCharacterCode", "@", "#1"}]}], ",", "20", ",",
                     "Bold"}], "]"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"Background", "->", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"formalCharCodeQ", "[", "#1", "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Darker", "[", "StandardGreen", "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Darker", "[", "StandardRed", "]"}]}], "]"}]}]}], 
                 "]"}], ",", "\[IndentingNewLine]", 
                RowBox[{"Style", "[", 
