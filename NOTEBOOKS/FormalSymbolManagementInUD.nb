}, Open  ]],

Cell["\<\
A manifestly extended formal symbol IS an extended formal symbol\
\>", "Text",
 CellChangeTimes->{{3.979850968000102*^9, 3.979850989582073*^9}, {
  3.979851873844692*^9, 3.979851878940976*^9}, {3.979854105861034*^9, 
  3.9798541072078238`*^9}},ExpressionUUID->"d6778275-f03a-4f46-90ee-\
fec715c69e8e"],

Cell[CellGroupData[{

