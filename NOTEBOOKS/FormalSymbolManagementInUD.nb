 CellLabel->
  "Out[369]=",ExpressionUUID->"e9dcb707-eb2d-4011-a078-9ec1f5452fd4"]
}, Open  ]],

Cell["\<\
A manifestly extended formal symbol is not an unextended formal symbol\
\>", "Text",
