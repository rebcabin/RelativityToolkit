  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "CREATION", " ", "OF", " ", "EXTENDED", " ", "SYMBOLS"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Returns", " ", "False", " ", "because", " ", "\"\<\[FormalI]543\>\"", " ",
      "is", " ", "an", " ", "Extended", " ", "symbol"}], ",", 
    RowBox[{"so", " ", "it", " ", "is", " ", "NOT", " ", 
     RowBox[{"Pure", "."}]}]}], "*)"}], 
  RowBox[{"FormalSymbolQ", "[", 
   RowBox[{"Evaluate", "@", 
    RowBox[{"CreateExtendedFormal", "[", "\"\<\[FormalI]543\>\"", "]"}]}], 
