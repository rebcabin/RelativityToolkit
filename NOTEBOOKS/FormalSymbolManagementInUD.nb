Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["CreateFormalSymbol ", "Subsubsection"],
 "Constructor Can Create a Formal Symbol"
}], "Subsection",
 CellChangeTimes->{{3.979850876347815*^9, 3.979850897907886*^9}, {
  3.979851852587569*^9, 3.979851858038988*^9}, {3.9798541918487463`*^9, 
  3.979854225217928*^9}},ExpressionUUID->"95d44d58-ee78-4646-a72d-\
a459eea2f5dc"],

Cell[TextData[{
 "Preservation of Purity (Idempotency): The constructor ",
 StyleBox["CreateExtendedFormal", "Input"],
 " is \[OpenCurlyDoubleQuote]idempotent\[CloseCurlyDoubleQuote] regarding \
system symbols."
}], "Text",
 CellChangeTimes->{3.979854057777211*^9, 
  3.979854132098516*^9},ExpressionUUID->"4cc269ab-acac-45a9-8903-\
c3afeb2e7fe0"],

Cell[TextData[{
 "Inputting a Pure Name: If you pass the name of a standard system symbol \
(e.g., ",
 StyleBox["\[OpenCurlyDoubleQuote]\[FormalI]\[CloseCurlyDoubleQuote]", 
  "Input"],
 "), the constructor returns the standard, pure symbol ",
 StyleBox["\[FormalI]", "Input"],
 ". It does not convert it into an extended symbol. Therefore, the result \
satisfies ",
 StyleBox["FormalSymbolQ", "Input"],
 " (True) but fails ",
 StyleBox["FormalSymbolExtendedQ", "Input"],
 " (False)."
}], "Text",
 CellChangeTimes->{
  3.979854057777211*^9, {3.979854133120698*^9, 3.979854134817095*^9}, 
   3.979854177682035*^9},ExpressionUUID->"27b00fc9-0218-4128-9d3a-\
d2f33d7b5a26"],

Cell[TextData[{
 "Inputting an Extended Name: If you pass a name with a suffix (e.g., ",
 StyleBox["\[OpenCurlyDoubleQuote]\[FormalI]543\[CloseCurlyDoubleQuote]", 
  "Input"],
 "), the constructor creates (and protects) a new extended formal symbol. \
This result fails ",
 StyleBox["FormalSymbolQ", "Input"],
 " (False) but satisfies ",
 StyleBox["FormalSymbolExtendedQ", "Input"],
 " (True)."
}], "Text",
 CellChangeTimes->{
  3.979854057777211*^9, {3.979854133120698*^9, 3.979854134817095*^9}, {
   3.979854178661989*^9, 3.9798541805036077`*^9}, {3.9798542648496227`*^9, 
   3.979854269400158*^9}},ExpressionUUID->"234c5e8c-6865-411f-80e8-\
ad662009c6e6"],

Cell["\<\
Predicates return False on unevaluated extended formal symbols.\
\>", "Text",
 CellChangeTimes->{{3.979851010330175*^9, 3.9798510423376226`*^9}, {
  3.979853886402532*^9, 3.9798539541897793`*^9}, {3.979854291720068*^9, 
  3.979854305632607*^9}, {3.979854491928678*^9, 
  3.979854493423862*^9}},ExpressionUUID->"b2d98c71-7fcc-412d-983a-\
fa4dda9a1b56"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "THE", " ", "EVALUATION", " ", "TRAP"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Returns", " ", "False", " ", "because", " ", "the", " ", "Q"}], 
     "-", 
     RowBox[{"function", " ", "Holds", " ", "the", " ", "function", " ", 
      RowBox[{"call", " ", "'"}], 
      RowBox[{
       RowBox[{"CreateExtendedFormal", "[", "...", "]"}], "'"}]}]}], ",", " ", 
    RowBox[{"an", " ", "expression"}], ",", " ", 
    RowBox[{"not", " ", "a", " ", 
     RowBox[{"symbol", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"FormalSymbolQ", "[", 
   RowBox[{"CreateExtendedFormal", "[", "\"\<\[FormalI]\>\"", "]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.979850572380599*^9, 3.979850624021989*^9}, {
  3.979850954665481*^9, 3.979850955184546*^9}, {3.979853860181531*^9, 
  3.9798538831247663`*^9}, {3.9798543745947313`*^9, 3.979854382818974*^9}, {
  3.979854464961011*^9, 
  3.979854515733526*^9}},ExpressionUUID->"92bde903-b945-4986-a1f4-\
78ca6c21ad28"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.979853883787664*^9},
 CellLabel->
  "Out[391]=",ExpressionUUID->"c7f8b7b2-f753-4a3a-b6d2-7475ffbcbad5"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"2.", " ", "PRESERVATION", " ", "OF", " ", "PURITY"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Returns", " ", "True", " ", "because", " ", "\"\<\[FormalI]\>\"", " ", 
     "is", " ", "a", " ", "system", " ", 
     RowBox[{"symbol", ".", " ", "The"}], " ", "constructor", " ", "returns", 
     " ", "it", " ", "as"}], "-", 
    RowBox[{"is", " ", 
     RowBox[{
      RowBox[{"(", "Pure", ")"}], "."}]}]}], "*)"}], 
  RowBox[{"FormalSymbolQ", "[", 
   RowBox[{"Evaluate", "@", 
    RowBox[{"CreateExtendedFormal", "[", "\"\<\[FormalI]\>\"", "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.979850572380599*^9, 3.979850624021989*^9}, {
  3.979850954665481*^9, 3.979850955184546*^9}, {3.979853860181531*^9, 
  3.9798538629125023`*^9}, {3.9798544324425383`*^9, 
  3.979854455663685*^9}},ExpressionUUID->"e6b1c8c3-bf00-4ff5-8c54-\
834c78594f45"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.979850956150445*^9, 3.979851696963022*^9, 
  3.979853863635248*^9},
 CellLabel->
  "Out[390]=",ExpressionUUID->"b7e4d7a0-5107-40ec-90f3-2885690edd50"]
}, Open  ]],

Cell["\<\
Requesting a pure symbol name from the constructor yields a Pure Formal \
Symbol, which is NOT an Extended Formal Symbol.\
\>", "Text",
 CellChangeTimes->{{3.979851707801281*^9, 3.979851780065077*^9}, {
  3.979854077429538*^9, 
  3.979854085757575*^9}},ExpressionUUID->"8e4f6b2d-dad6-4c15-a72b-\
ce1c62b4d8ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Returns", " ", "False", " ", "because", " ", "the", " ", "result", " ", 
     "is", " ", "a", " ", "Pure", " ", "symbol"}], ",", 
    RowBox[{"which", " ", "by", " ", "definition", " ", "is", " ", "NOT", " ", 
     RowBox[{"Extended", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"FormalSymbolExtendedQ", "[", 
   RowBox[{"Evaluate", "@", 
    RowBox[{"CreateExtendedFormal", "[", "\"\<\[FormalI]\>\"", "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.979850572380599*^9, 3.979850624021989*^9}, {
