Cell[CellGroupData[{

Cell["Formal Symbol Character Ranges", "Section",
 CellChangeTimes->{{3.979834759386332*^9, 3.97983476805156*^9}, {
  3.979862013926944*^9, 
  3.9798620185718107`*^9}},ExpressionUUID->"9ef9df89-1e21-49f3-8295-\
1a72b016cd81"],

Cell[TextData[{
 StyleBox["showCodes", "Input"],
 " generates a visual map of the specific Unicode Private Use Area (63488\
\[Dash]63615) that Mathematica uses for formal symbols."
}], "Text",
 CellChangeTimes->{{3.9798359933313437`*^9, 3.9798360188792877`*^9}, {
  3.979846574114739*^9, 3.9798465782927217`*^9}, {3.979861363842334*^9, 
  3.979861369123272*^9}, {3.9798614203309317`*^9, 3.97986144871868*^9}, {
  3.979911316413883*^9, 
  3.9799113235429583`*^9}},ExpressionUUID->"b942bd1e-3ae1-475d-a1ac-\
8d9206c541f7"],

Cell[TextData[{
 "Green Tiles: Valid, assigned formal symbols (e.g., ",
 StyleBox["\[FormalA]", "Input"],
 ", ",
 StyleBox["\[FormalAlpha]", "Input"],
 ")."
}], "Item",
 CellChangeTimes->{{3.9798359933313437`*^9, 3.9798360188792877`*^9}, {
  3.979846574114739*^9, 3.9798465782927217`*^9}, {3.979861363842334*^9, 
  3.979861369123272*^9}, {3.9798614203309317`*^9, 
  3.979861452451716*^9}},ExpressionUUID->"0edc087a-09a1-4522-ba09-\
2ed2d632f3c2"],

Cell["\<\
Red Tiles: Unassigned or invalid slots (gaps in the sequence).\
\>", "Item",
 CellChangeTimes->{{3.9798359933313437`*^9, 3.9798360188792877`*^9}, {
  3.979846574114739*^9, 3.9798465782927217`*^9}, {3.979861363842334*^9, 
  3.979861369123272*^9}, {3.9798614203309317`*^9, 3.9798615319577427`*^9}, {
  3.979861978341097*^9, 
  3.979861979650832*^9}},ExpressionUUID->"779d201b-029c-442d-b2cb-\
42e1e975e1ea"],

Cell[TextData[{
 "The visualization iterates through the integer range and queries ",
 StyleBox["formalCharCodeQ", "Input"],
 " for every number to decide whether it should be colored Green (Valid) or \
Red (Invalid)."
}], "Text",
 CellChangeTimes->{{3.9798359933313437`*^9, 3.9798360188792877`*^9}, {
   3.979846574114739*^9, 3.9798465782927217`*^9}, {3.979861363842334*^9, 
   3.979861369123272*^9}, {3.9798614203309317`*^9, 3.9798615319577427`*^9}, 
   3.979861978341097*^9, {3.979911350610853*^9, 
   3.9799113510471373`*^9}},ExpressionUUID->"7a3e503e-5d5f-4c46-8eca-\
a12accf986b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "formalCharCodeQ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"formalCharCodeQ", "[", "code_Integer", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"63488", "<=", "code", "<=", "63556"}], ")"}], "||", 
     RowBox[{"(*", 
      RowBox[{"Latin", " ", "and", " ", "primary", " ", "math"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(", 
      RowBox[{"63558", "<=", "code", "<=", "63564"}], ")"}], "||", 
     RowBox[{"(*", 
      RowBox[{
      "Remaining", " ", "math", " ", "symbols", " ", "after", " ", "arrow"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(", 
      RowBox[{"63572", "<=", "code", "<=", "63596"}], ")"}], "||", 
     RowBox[{"(*", 
      RowBox[{"Lowercase", " ", "Greek"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(", 
