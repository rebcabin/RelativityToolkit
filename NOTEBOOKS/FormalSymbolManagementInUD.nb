Cell[CellGroupData[{

Cell["Symbol Inspector", "Section",
 CellChangeTimes->{{3.979835875548971*^9, 
  3.97983587910151*^9}},ExpressionUUID->"ee176073-85ec-4039-84f8-\
c6e1e964d611"],

Cell["\<\
TODO 9: Documentation of how to use this, how it works, and explanation of \
the usage of all the hard-core features like HoldForm, OwnValues, etc., how \
we found out they\[CloseCurlyQuote]re needed, why they\[CloseCurlyQuote]re \
the minimal usages, and all the thinking and trial-and-error (which we don\
\[CloseCurlyQuote]t want to lose) that we had to do to come up with this.\
\>", "Item",
 CellChangeTimes->{{3.9798360440900297`*^9, 3.9798361604924507`*^9}, {
  3.9798465819626083`*^9, 
  3.979846582260235*^9}},ExpressionUUID->"fe9eec93-4334-4666-ab96-\
6759727516b8"],

Cell[CellGroupData[{

Cell["Design & internal Logic", "Subsection",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860030986598*^9}, {
  3.9798600734064503`*^9, 
  3.9798600790301847`*^9}},ExpressionUUID->"bc40c5f5-acd6-4c41-9083-\
e08208808d67"],

Cell[CellGroupData[{

Cell["Purpose", "Subsubsection",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860032690536*^9}, {
  3.979860083969038*^9, 
  3.979860093989253*^9}},ExpressionUUID->"50269add-2851-43f3-8f5c-\
761a6e02dceb"],

Cell[TextData[{
 StyleBox["SymbolInspector", "Input"],
 " is a \[OpenCurlyDoubleQuote]smart\[CloseCurlyDoubleQuote] introspection \
tool for revealing the internal properties of a symbol. Unlike standard \
Mathematica functions like ",
 StyleBox["Information", "Input"],
 " or ",
 StyleBox["??", "Input"],
 ", ",
 StyleBox["SymbolInspector", "Input"],
 " is pointer-aware. It can distinguish between a variable (the container) \
and the symbol it points to (the content), resolving pointers to show the \
properties of the underlying target."
}], "Text",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860032690536*^9}, {
  3.979860083969038*^9, 
  3.979860177060965*^9}},ExpressionUUID->"915716e0-0a33-4646-a91f-\
6f3e07b59539"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Usage", "Subsubsection",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860034501046*^9}, {
  3.9798601808566227`*^9, 
  3.979860192276836*^9}},ExpressionUUID->"e87d61e2-25b8-4870-a99a-\
5c50cb5cc853"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SymbolInspector", "[", "symbol", "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "or", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"SymbolInspector", "[", 
  RowBox[{"Evaluate", "[", "expression", "]"}], "]"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.979860269148712*^9, 
  3.979860312364558*^9}},ExpressionUUID->"02db1efa-7132-4956-b8cc-\
45421ffcab0b"],

Cell[TextData[{
 "On a Literal: ",
 StyleBox["SymbolInspector[x]", "Input"],
 " inspects ",
 StyleBox["x", "Input"],
 ".\nOn an Expression: ",
 StyleBox["SymbolInspector[Evaluate[CreateExtendedFormal[\
\[OpenCurlyDoubleQuote]...\[CloseCurlyDoubleQuote]]]]", "Input"],
 " resolves the expression first, then inspects the resulting symbol."
}], "Text",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860035725148*^9}, {
  3.97986024275636*^9, 3.97986025009196*^9}, {3.9798603315039463`*^9, 
  3.979860381695609*^9}},ExpressionUUID->"1c8f0cfc-00d2-4344-9363-\
68258c537cb4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Hard-Core Mechanics Explained", "Subsubsection",
 CellChangeTimes->{{3.979860017533279*^9, 3.97986003687854*^9}, {
  3.9798603897876663`*^9, 
  3.979860398795208*^9}},ExpressionUUID->"b31943dd-584b-46bb-917f-\
514690352be0"],

Cell["\<\
The function relies on three advanced features to work without side effects.\
\>", "Text",
 CellChangeTimes->{{3.979860017533279*^9, 3.97986003687854*^9}, {
  3.9798603897876663`*^9, 
  3.979860417035342*^9}},ExpressionUUID->"2ff86b3f-72d8-4d03-a40f-\
4d4d5292a254"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["SetAttributes[..., HoldAll]", "Input"]], \
"ItemNumbered",
 CellChangeTimes->{{3.979860017533279*^9, 3.9798600414297037`*^9}, {
   3.979860420874848*^9, 3.979860673403614*^9}, 
   3.9798608525350857`*^9},ExpressionUUID->"7d90b732-016b-4109-a8f6-\
f070ca1efac7"],

Cell[TextData[{
 "Problem: Normally, if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "5"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7c6d038a-d65b-4c59-9c38-3d42ba37d90e"],
 ", typing ",
 StyleBox["f[x]", "Input"],
 " evaluates to ",
 StyleBox["f[5]", "Input"],
 ": ",
 StyleBox["x", "Input"],
 " is evaluated before being sent into the function ",
 StyleBox["f", "Input"],
 ". "
}], "ItemParagraph",
 CellChangeTimes->{{3.979860017533279*^9, 3.9798600414297037`*^9}, {
   3.979860420874848*^9, 3.979860673403614*^9}, 
   3.9798609863533897`*^9},ExpressionUUID->"b044aad6-26ce-4f49-97e6-\
8529141cdc9b"],

Cell[TextData[{
 "Solution: ",
 StyleBox["HoldAll", "Input"],
 " prevents ",
 StyleBox["x", "Input"],
 " from evaluating, leting the raw symbol ",
 StyleBox["x", "Input"],
 " through for deeper inspection."
}], "ItemParagraph",
 CellChangeTimes->{{3.979860017533279*^9, 3.9798600414297037`*^9}, {
  3.979860420874848*^9, 
  3.979860673403614*^9}},ExpressionUUID->"6f142f9d-8c7f-454b-b7cd-\
fca537c4d3f9"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["OwnValues", "Input"],
 " Introspection"
}], "ItemNumbered",
 CellChangeTimes->{{3.979860017533279*^9, 3.9798600454963627`*^9}, {
  3.979860652487898*^9, 
  3.9798608510129547`*^9}},ExpressionUUID->"7cb99037-6321-4469-94d0-\
e2571d1b7497"],

Cell[TextData[{
 "Problem: In Mathematica, variables normally store definitions (if any) in \
",
 StyleBox["OwnValues", "Input"],
 ", whereas functions (",
 StyleBox["f[x_] := x", "Input"],
 ") store definitions in ",
 StyleBox["DownValues", "Input"],
 ". "
}], "ItemParagraph",
 CellChangeTimes->{{3.979860017533279*^9, 3.9798600454963627`*^9}, {
   3.979860652487898*^9, 3.979860823351594*^9}, {3.9798608889592943`*^9, 
   3.979860914386208*^9}, 
   3.979860984642659*^9},ExpressionUUID->"27a6ab82-f03e-4104-ab0a-\
f25bfb4a8e64"],

Cell[TextData[{
 "Solution: To detect whether ",
 StyleBox["x", "Input"],
 " is a pointer to another symbol, we interrogate ",
 StyleBox["OwnValues[x]", "Input"],
 ". If we find a rule like ",
 StyleBox["{x :> y}", "Input"],
 ", we know ",
 StyleBox["x", "Input"],
 " is a pointer."
}], "ItemParagraph",
 CellChangeTimes->{{3.979860017533279*^9, 3.9798600454963627`*^9}, {
  3.979860652487898*^9, 3.979860823351594*^9}, {3.9798608889592943`*^9, 
  3.979860914386208*^9}},ExpressionUUID->"11526999-ef68-4f50-8665-\
d470d7b06f3f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\[OpenCurlyDoubleQuote]Safe Peek\[CloseCurlyDoubleQuote] Pattern", \
"ItemNumbered",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860049115114*^9}, {
  3.9798608369781837`*^9, 
  3.979860848257024*^9}},ExpressionUUID->"d726c670-4f7f-4e70-b8eb-\
289aff36db6d"],

Cell[TextData[{
 "Code: ",
 StyleBox["ReleaseHold[Replace[Hold[s], sym_Symbol :> OwnValues[sym], {1}]]", 
  "Input"]
}], "ItemParagraph",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860049115114*^9}, {
  3.9798608369781837`*^9, 3.97986084627289*^9}, {3.979860930098592*^9, 
  3.979860956902413*^9}},ExpressionUUID->"6df36928-4053-472a-b4d3-\
a293663acb34"],

Cell["\<\
This is the specific syntax required to extract a symbol\[CloseCurlyQuote]s \
value *without* letting the symbol evaluate.\
\>", "ItemParagraph",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860049115114*^9}, {
  3.9798608369781837`*^9, 3.97986084627289*^9}, {3.979860930098592*^9, 
  3.979860972779063*^9}},ExpressionUUID->"49e86dc7-0b5e-4f52-9cb0-\
22cdd30b6d5d"],

Cell[TextData[{
 StyleBox["Hold[s]", "Input"],
 " freezes the symbol."
}], "SubitemNumbered",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860049115114*^9}, {
  3.9798608369781837`*^9, 3.97986084627289*^9}, {3.979860930098592*^9, 
  3.9798609598528557`*^9}, {3.9798610034713573`*^9, 
  3.979861012463216*^9}},ExpressionUUID->"aa458837-fe2a-494a-8e6f-\
a39691e55493"],

Cell[TextData[{
 StyleBox["Replace", "Input"],
 " swaps the symbol for its ",
 StyleBox["OwnValues", "Input"],
 " rule list inside the hold."
}], "SubitemNumbered",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860049115114*^9}, {
  3.9798608369781837`*^9, 3.97986084627289*^9}, {3.979860930098592*^9, 
  3.979860960655725*^9}, {3.979861016523367*^9, 
  3.979861040376515*^9}},ExpressionUUID->"c3e4f7cc-505e-4551-93ca-\
b1507fb896fa"],

Cell[TextData[{
 StyleBox["ReleaseHold", "Input"],
 " lets us look at the rule list."
}], "SubitemNumbered",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860049115114*^9}, {
  3.9798608369781837`*^9, 3.97986084627289*^9}, {3.979860930098592*^9, 
  3.979860950589943*^9}, {3.979861045328641*^9, 
  3.979861053541428*^9}},ExpressionUUID->"1cd68e64-7711-42dd-b226-\
a2e74de571ca"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Trial & Error Lesson", "Subsubsection",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860051726892*^9}, {
  3.979861063097209*^9, 
  3.97986106772685*^9}},ExpressionUUID->"8849afc5-e657-434b-92d3-\
ec7b89943d45"],

Cell[TextData[{
 "Simply calling ",
 StyleBox["OwnValues[s]", "Input"],
 " inside a held function often evaluates ",
 StyleBox["s", "Input"],
 " too early or fails to find the context. This discovered pattern was the \
only way we found to get the definition safely."
}], "Text",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860051726892*^9}, {
  3.979861063097209*^9, 
  3.97986112306455*^9}},ExpressionUUID->"92e6f13f-93e2-499f-9931-\
47d18adabbd6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\[OpenCurlyDoubleQuote]Smart Pointer\[CloseCurlyDoubleQuote] Logic", \
"Subsubsection",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860061280345*^9}, {
  3.979861125838952*^9, 
  3.979861132236545*^9}},ExpressionUUID->"f70244d7-ae30-4c2d-8ba0-\
3b6cbb139d97"],

Cell[TextData[{
 "The distinctive feature of this tool is the ",
 StyleBox["isPointer", "Input"],
 " check."
}], "Text",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860061280345*^9}, {
  3.979861125838952*^9, 
  3.97986114727497*^9}},ExpressionUUID->"9af60af3-511d-49e9-a481-\
84e77ee68a97"],

Cell[TextData[{
 "Logic: ",
 StyleBox["MatchQ[eval, {(_ :> _Symbol)}]", "Input"]
}], "Text",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860059311348*^9}, {
  3.979861152866125*^9, 
  3.9798611812755613`*^9}},ExpressionUUID->"742d84b0-ffd6-4a9e-b790-\
3f4abbe48ff2"],

Cell["Behavior:", "Text",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860059311348*^9}, {
  3.979861152866125*^9, 
  3.979861188157975*^9}},ExpressionUUID->"baee57db-1706-4205-bf9a-\
a9745a7d5514"],

Cell[TextData[{
 "If ",
 StyleBox["x", "Input"],
 " is defined as ",
 StyleBox["x = y", "Input"],
 " where ",
 StyleBox["y", "Input"],
 " is a symbol, the Inspector detects this pattern."
}], "ItemNumbered",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860059311348*^9}, {
  3.979861152866125*^9, 3.979861159005665*^9}, {3.979861190827448*^9, 
  3.9798612151967087`*^9}},ExpressionUUID->"06f19d90-e2fc-4c89-804f-\
ff61779918fe"],

Cell[CellGroupData[{

Cell[TextData[{
 "It \[OpenCurlyDoubleQuote]dereferences\[CloseCurlyDoubleQuote] the pointer, \
switching focus to ",
 StyleBox["y", "Input"],
 ", ensuring that inspecting a local variable holding a formal symbol yields \
the properties of the formal symbol content, not the \
\[OpenCurlyDoubleQuote]pointer\[CloseCurlyDoubleQuote] variable (the \
container)."
}], "ItemNumbered",
 CellChangeTimes->{{3.979860017533279*^9, 3.979860059311348*^9}, {
  3.979861152866125*^9, 3.979861160409718*^9}, {3.979861222185182*^9, 
  3.979861319786021*^9}},ExpressionUUID->"9d9c6c23-2954-4a22-a51d-\
fdd26a040139"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "SymbolInspector", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"SymbolInspector", ",", "HoldAll"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SymbolInspector", "[", "s_Symbol", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"targetSym", ",", "eval", ",", "isPointer"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "1.", " ", "Peek", " ", "inside", " ", "the", " ", "pointer", " ", 
       "safely"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"eval", "=", 
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"Replace", "[", 
         RowBox[{
          RowBox[{"Hold", "[", "s", "]"}], ",", 
          RowBox[{"sym_Symbol", ":>", 
           RowBox[{"OwnValues", "[", "sym", "]"}]}], ",", 
          RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"isPointer", "=", 
       RowBox[{"MatchQ", "[", 
        RowBox[{"eval", ",", 
         RowBox[{"{", 
          RowBox[{"(", 
           RowBox[{"_", ":>", "_Symbol"}], ")"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"2.", " ", 
        RowBox[{"Use", " ", "'"}], 
        RowBox[{"With", "'"}], " ", 
        RowBox[{"to", " ", "'"}], "lock", " ", 
        RowBox[{"in", "'"}], " ", "the", " ", "symbol", " ", "we", " ", "are",
         " ", "actually", " ", "inspecting"}], "*)"}], "\[IndentingNewLine]", 
      
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"actualSym", "=", 
          RowBox[{"If", "[", 
           RowBox[{"isPointer", ",", 
            RowBox[{"eval", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{"Unevaluated", "[", "s", "]"}]}], "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"name", "=", 
             RowBox[{"SymbolName", "[", "actualSym", "]"}]}], ",", 
            RowBox[{"attr", "=", 
             RowBox[{"Attributes", "[", "actualSym", "]"}]}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Grid", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<Property\>\"", ",", "\"\<Value\>\""}], "}"}], ",",
               "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"\"\<Literal Symbol\>\"", ",", 
                RowBox[{"HoldForm", "[", "s", "]"}]}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"\"\<Points To\>\"", ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                 "isPointer", ",", "actualSym", 
                  ",", "\"\<N/A (Literal)\>\""}], "]"}]}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"\"\<Current Value\>\"", ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"OwnValues", "[", "s", "]"}], "===", 
                   RowBox[{"{", "}"}]}], ",", "\"\<None (Undefined)\>\"", ",",
                   "s"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"\"\<Context\>\"", ",", 
                RowBox[{"Context", "[", "actualSym", "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"\"\<Character Codes\>\"", ",", 
                RowBox[{"ToCharacterCode", "[", "name", "]"}]}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"\"\<Classification\>\"", ",", 
