Cell[TextData[{
 "Indirect a ",
 StyleBox["metaphorical pointer",
  FontSlant->"Italic"],
 ": Evaluate a symbol to get the formal symbol we ",
 StyleBox["Really",
  FontSlant->"Italic"],
 " want to inspect"
}], "Text",
 CellChangeTimes->{{3.97997809035851*^9, 3.979978193143132*^9}, {
  3.979978592359786*^9, 
  3.979978609980555*^9}},ExpressionUUID->"b3485d72-802c-43f0-9c32-\
05bdd6595d36"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "=", "\[FormalI]"}], "}"}], ",", 
   RowBox[{"SymbolInspector", "[", "x", "]"}]}], "]"}]], "Input",
