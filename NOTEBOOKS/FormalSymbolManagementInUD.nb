Cell[CellGroupData[{

Cell["Master Class in Evaluation Control", "Section",
 CellChangeTimes->{{3.979926511599001*^9, 
  3.9799265190346823`*^9}},ExpressionUUID->"684acf67-ce87-483f-8e51-\
76e87c100e23"],

Cell[TextData[{
 "Wolfram Mathematica is a term-rewriting system, not a function evaluator \
like Clojure or JavaScript, let alone a function compiler like C or Java. \
There are enough similarities between term-rewriting and function-calling \
that we often speak of \[OpenCurlyDoubleQuote]calling a function\
\[CloseCurlyDoubleQuote] in Mathematica, but actually that is the unusual \
case, as with explicit ",
 StyleBox["Function", "Input"],
 " forms or ",
 StyleBox["foo[#]&", "Input"],
 " syntax. Most of the time, we\[CloseCurlyQuote]re applying rules: replacing \
the mentioning of ",
 StyleBox["SymbolInspector[x]", "Input"],
 " with the definition of ",
 StyleBox["SymbolInspector", "Input"],
 " after replacing its argument pattern ",
 StyleBox["s_Symbol", "Input"],
 " with ",
 StyleBox["x", "Input"],
 ". "
}], "Text",
 CellChangeTimes->{{3.97997598230847*^9, 3.979976143909684*^9}, {
   3.979976275051353*^9, 3.979976525629855*^9}, {3.979976618825576*^9, 
   3.97997694149914*^9}, 3.97997698660537*^9, {3.9799799254293747`*^9, 
   3.979979931278626*^9}},ExpressionUUID->"ee6ee972-3a37-4434-99a3-\
71bfae571928"],

Cell[TextData[{
 "But wait, we don\[CloseCurlyQuote]t want the value of ",
 StyleBox["x", "Input"],
 " to go in, we want the symbol ",
 StyleBox["x", "Input"],
 " itself to go in. Mathematica aggressively tries to evaluate (replace by \
its definition) every term, every symbol, at every opportunity. That makes it \
tricky to write a rule like ",
 StyleBox["SymbolInspector", "Input"],
 " that tries to inspect a symbol. Holding on to a symbol inside ",
 StyleBox["SymbolInspector", "Input"],
 " is like holding on to a slippery fish that wants to get out of your hands \
and back into the lake!"
}], "Text",
 CellChangeTimes->{{3.97997598230847*^9, 3.979976143909684*^9}, {
  3.979976275051353*^9, 3.979976525629855*^9}, {3.979976618825576*^9, 
  3.97997694149914*^9}, {3.979977000387423*^9, 
  3.979977000874784*^9}},ExpressionUUID->"d82a8f51-28de-4204-9920-\
d003f2832b31"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["SetAttributes[SymbolInspector, HoldAll]", "Input"]], \
"Subsection",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926557940024*^9}, {
   3.979974636600232*^9, 3.979974658051023*^9}, 3.9799746900889997`*^9, {
   3.979975757284292*^9, 3.979975776967189*^9}, {3.979980093269533*^9, 
   3.979980095914888*^9}},ExpressionUUID->"31c389a4-1f63-4b8d-85c8-\
c29c928cf601"],

Cell[TextData[{
 StyleBox["HoldAll", "Input"],
 " stops evaluation of arguments before replacing ",
 StyleBox["SymbolInspector", "Input"],
 " with its definition."
}], "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926562096149*^9}, {
  3.979974669511458*^9, 3.9799747359481163`*^9}, {3.979975796712373*^9, 
  3.979975938598485*^9}, {3.979977026495385*^9, 3.9799770316879*^9}, {
  3.979979977839817*^9, 
  3.97997997964995*^9}},ExpressionUUID->"7b5652c8-06ff-469c-82a9-\
f03cfcd1c690"],

Cell[TextData[{
 "Without this, if you wrote ",
 StyleBox["SymbolInspector[x]", "Input"],
 " and it so happened that ",
 StyleBox["x", "Input"],
 " has the value ",
 StyleBox["5", "Input"],
 ", Mathematica would evaluate ",
 StyleBox["5", "Input"],
 " before ",
 StyleBox["SymbolInspector", "Input"],
 " even starts: the fish slips out of your hands and back into the lake right \
away. ",
 StyleBox["SymbolInspector", "Input"],
 " would receive ",
 StyleBox["5", "Input"],
 ", fail to match ",
 StyleBox["s_Symbol", "Input"],
 ", and return ",
 StyleBox["$Failed", "Input"],
 "."
}], "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926562096149*^9}, {
  3.979974669511458*^9, 3.979974730470931*^9}, {3.9799748263873653`*^9, 
  3.979974835554184*^9}, {3.979975619461956*^9, 3.979975742242613*^9}, {
  3.97997595923919*^9, 3.979975970075523*^9}, {3.9799770381533403`*^9, 
  3.9799771317885103`*^9}, {3.979979999365591*^9, 
  3.979980003549753*^9}},ExpressionUUID->"89bda21f-02fd-4e38-985b-\
e88dc501a327"],

Cell[TextData[{
 "But with the ",
 StyleBox["HoldAll", "Input"],
 " (or ",
 StyleBox["HoldFirst", "Input"],
 ") attribute, Mathematica skips argument-evaluation and binds the variable \
",
 StyleBox["s", "Input"],
 " in the body of ",
 StyleBox["SymbolInspector", "Input"],
 " to the symbol ",
 StyleBox["x", "Input"],
 ", not to its value ",
 StyleBox["5", "Input"],
 "."
}], "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926562096149*^9}, {
  3.979974669511458*^9, 3.979974730470931*^9}, {3.9799748263873653`*^9, 
  3.979974835554184*^9}, {3.979975619461956*^9, 3.979975734650297*^9}, {
  3.9799771581654453`*^9, 3.9799772806276083`*^9}, {3.979980020617332*^9, 
  3.979980040036194*^9}},ExpressionUUID->"496abae6-da71-4f0d-956c-\
e8e7ecc7a644"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["ownVals = OwnValues[Unevaluated[s]];", "Input"]], \
"Subsection",
 CellChangeTimes->{{3.979926523664399*^9, 3.9799265646821613`*^9}, {
  3.9799801631382427`*^9, 
  3.979980166820146*^9}},ExpressionUUID->"f750a6da-80be-4b5a-af0f-\
e358ceee593c"],

Cell[TextData[{
 "Pass the wriggling fish ",
 StyleBox["s", "Input"],
 " to ",
 StyleBox["OwnValues", "Input"],
 " without triggering evaluation. "
}], "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.9799265667982893`*^9}, {
   3.979980178838426*^9, 3.979980291977481*^9}, 3.979980351849387*^9, {
   3.979981533540365*^9, 
   3.9799815366052217`*^9}},ExpressionUUID->"1cd99042-497a-4c3e-9db9-\
c6de0fbba7d1"],

Cell[TextData[{
 "Even though ",
 StyleBox["s", "Input"],
 " is held by ",
 StyleBox["SymbolInspector", "Input"],
 ", passing ",
 StyleBox["s", "Input"],
 " to another function exposes ",
 StyleBox["s", "Input"],
 " to the evaluator again. The fish wriggles whenever you try to move it. If ",
 StyleBox["s", "Input"],
 " is ",
 StyleBox["x", "Input"],
 " and ",
 StyleBox["x = 5", "Input"],
 ", ",
 StyleBox["OwnValues[s]", "Input"],
 " becomes ",
 StyleBox["OwnValues[5[", "Input"],
 ". Error."
}], "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.9799265667982893`*^9}, {
  3.979980178838426*^9, 3.979980428926998*^9}, {3.9799815567432737`*^9, 
  3.979981584731072*^9}},ExpressionUUID->"0a2359c9-f636-47ec-bf9a-\
7782d8ef0bf8"],

Cell[TextData[{
 "Why not ",
 StyleBox["OwnValues[Hold[s]]", "Input"],
 "? ",
 StyleBox["OwnValues", "Input"],
 " expects a ",
 StyleBox["Symbol", "Input"],
 " argument, not a ",
 StyleBox["Hold", "Input"],
 " object."
}], "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.9799265667982893`*^9}, {
  3.979980178838426*^9, 
  3.979980469437975*^9}},ExpressionUUID->"c20763d6-c4b0-46ad-80a7-\
cb30b3b728c9"],

Cell[TextData[{
 StyleBox["Unevaluated[s]", "Input"],
 " tells ",
 StyleBox["OwnValues", "Input"],
 ": \[OpenCurlyDoubleQuote]Pretend I passed this wrapped in ",
 StyleBox["Hold", "Input"],
 ", but treat it as the raw argument.\[CloseCurlyDoubleQuote] It evaporates \
after the rewrite of ",
 StyleBox["OwnValues[s]", "Input"],
 " to its definition."
}], "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.9799265667982893`*^9}, {
  3.979980178838426*^9, 3.979980596125093*^9}, {3.979981619178009*^9, 
  3.979981621766725*^9}},ExpressionUUID->"4b97e396-3145-4da0-85ad-\
271469d2b4dc"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The Evaluation Override: ",
 StyleBox["Hold[Evaluate[...]]", "Input"]
}], "Subsection",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926567788987*^9}, {
  3.979980611236699*^9, 
  3.979980625276853*^9}},ExpressionUUID->"b8ecd4c9-cf15-40b2-bf86-\
ed47ff02a116"],

Cell["\<\
The Job: Perform a calculation inside a metaphorical locked box.\
\>", "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926572109503*^9}, {
  3.9799806479326363`*^9, 3.9799806905594683`*^9}, {3.9799816359599047`*^9, 
  3.979981636402062*^9}},ExpressionUUID->"c3d7ed4e-0d5a-4639-957a-\
9a919e8cb863"],

Cell[TextData[{
 "The Scenario: You have ",
 StyleBox["ownVals", "Input"],
 ", a list of rules. You need to extract the target symbol, e.g., ",
 StyleBox["x", "Input"],
 ", from that list and wrap it in a ",
 StyleBox["Hold", "Input"],
 " so it doesn\[CloseCurlyQuote]t evaluate to ",
 StyleBox["5", "Input"],
 "."
}], "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926572109503*^9}, 
   3.979980649627804*^9, {3.9799806927116737`*^9, 
   3.979980767155533*^9}},ExpressionUUID->"d52b5cff-66c1-4a60-9eba-\
fa3290afb057"],

Cell["The Mechanics:", "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926572109503*^9}, 
   3.979980652275094*^9, {3.9799807754214354`*^9, 
   3.979980778313569*^9}},ExpressionUUID->"99b5becc-933b-41c2-a198-\
006934887e33"],

Cell[TextData[{
 StyleBox["Hold[...]", "Input"],
 " normally stops everything."
}], "ItemParagraph",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926572109503*^9}, 
   3.979980653166695*^9, {3.9799807821002607`*^9, 
   3.97998079092444*^9}},ExpressionUUID->"1ce06cf2-47fe-4234-a5bb-\
5a21e9b2c1d8"],

Cell[TextData[{
 StyleBox["Evaluate[...]", "Input"],
 " idiomatically forces evaluation inside the ",
 StyleBox["Evaluate", "Input"],
 " wrapper before the ",
 StyleBox["Hold", "Input"],
 " freezes the result."
}], "ItemParagraph",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926572109503*^9}, 
   3.979980654457383*^9, {3.979980793240979*^9, 3.979980831562121*^9}, {
   3.979981147615926*^9, 
   3.9799811829337683`*^9}},ExpressionUUID->"23d655f3-e1ce-45a8-8e41-\
5f1a3b41b25c"],

Cell[TextData[{
 "Result: ",
 StyleBox["Hold[Evaluate[ownVals\[LeftDoubleBracket]1,2\[RightDoubleBracket]]]\
", "Input"],
 " rewrites to  ",
 StyleBox["Hold[x]", "Input"],
 ". "
}], "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926572109503*^9}, {
  3.979980834671523*^9, 3.979980961805497*^9}, {3.9799811895543423`*^9, 
  3.979981191283882*^9}},ExpressionUUID->"98f2d02c-1cac-43d4-8c5b-\
83c718dd5777"],

Cell[TextData[{
 "Without ",
 StyleBox["Evaluate", "Input"],
 ", you would be holding the code ",
 StyleBox["ownVals\[LeftDoubleBracket]1,2", "Input"],
 "\[RightDoubleBracket] rather than the symbol ",
 StyleBox["x", "Input"],
 "."
}], "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926572109503*^9}, {
   3.979980834671523*^9, 3.979980961805497*^9}, 
   3.9799811895543423`*^9},ExpressionUUID->"21fc04d7-bebf-41ac-ba97-\
b765b86b6c7f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Trojan Horse Injection: ",
 StyleBox["Replace[heldSym, Hold[sym_] :> With[{...}]]", "Input"]
}], "Subsection",
 CellChangeTimes->{{3.979926523664399*^9, 3.9799265745836277`*^9}, {
  3.9799809780350103`*^9, 3.9799810125808783`*^9}, {3.979981206806263*^9, 
  3.97998120790729*^9}},ExpressionUUID->"99f3eb28-8843-404b-9cce-\
b11dd2b08ae4"],

Cell[TextData[{
 "The Job: move a symbol, without triggering evaluation, from the locked box \
(",
 StyleBox["Hold", "Input"],
 ") into a working environment (",
 StyleBox["With", "Input"],
 ")."
}], "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.9799265796387043`*^9}, 
   3.9799810345229597`*^9, {3.9799812107192297`*^9, 3.979981268691749*^9}, {
   3.9799816955460367`*^9, 
   3.979981696114875*^9}},ExpressionUUID->"cf4096a4-7092-4af2-9e08-\
8da5ce28ab9d"],

Cell[TextData[{
 "The \[OpenCurlyDoubleQuote]Gotcha\[CloseCurlyDoubleQuote]: You have ",
 StyleBox["heldSym", "Input"],
 ", which is ",
 StyleBox["Hold[x]", "Input"],
 ". You can\[CloseCurlyQuote]t just say ",
 StyleBox["sym = ReleaseHold[heldSym]", "Input"],
 " because x would instantly evaluate into 5. The fish wriggles out of the \
box and back into the lake."
}], "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.9799265796387043`*^9}, 
   3.97998103608432*^9, {3.979981276343293*^9, 3.979981281592291*^9}, {
   3.979981341446005*^9, 3.9799813958326178`*^9}, {3.979981500876643*^9, 
   3.9799815055991*^9}, {3.979981709902433*^9, 
   3.9799817214766703`*^9}},ExpressionUUID->"58412889-c18a-4d47-afd4-\
bff2fb638018"],

Cell["The Trick:", "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.9799265796387043`*^9}, 
   3.979981037149982*^9, {3.979981725150136*^9, 
   3.9799817296878157`*^9}},ExpressionUUID->"1b3b7864-64ea-4626-9685-\
91a4b99b0a48"],

Cell[TextData[{
 "Match the pattern ",
 StyleBox["Hold[sym_]", "Input"],
 ", binding the name ",
 StyleBox["sym", "Input"],
 " to the unevaluated content ",
 StyleBox["x", "Input"],
 " inside the hold."
}], "Item",
 CellChangeTimes->{{3.979926523664399*^9, 3.9799265796387043`*^9}, 
   3.979981038033658*^9, {3.979981734450889*^9, 
   3.979981819850374*^9}},ExpressionUUID->"10327eb2-ff04-49ce-ab95-\
36dd14290c2a"],

Cell[TextData[{
 "\[RuleDelayed] (",
 StyleBox["RuleDelayed", "Input"],
 ") inserts that raw symbol ",
 StyleBox["x", "Input"],
 " into the body of the ",
 StyleBox["With", "Input"],
 " statement."
}], "Item",
 CellChangeTimes->{{3.979926523664399*^9, 3.9799265796387043`*^9}, 
   3.979981039781052*^9, {3.979981834580945*^9, 
   3.979981884284202*^9}},ExpressionUUID->"8916182e-7565-49ac-9e0d-\
b52d8be1288f"],

Cell["\<\
Crucially, this injection happens *structurally*, bypassing the evaluator.\
\>", "Item",
 CellChangeTimes->{{3.979926523664399*^9, 3.9799265796387043`*^9}, {
  3.979981893166398*^9, 
  3.979981894319812*^9}},ExpressionUUID->"21e8945c-d57e-4379-a26c-\
0d3a40a0745a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Scope Lock: ",
 StyleBox["With[{name = SymbolName[Unevaluated[sym]], ...}, ...]", "Input"]
}], "Subsection",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926549905693*^9}, 
   3.979926581436755*^9, {3.979981948566358*^9, 3.9799819640765667`*^9}, {
   3.9799819993238897`*^9, 
   3.9799820015368547`*^9}},ExpressionUUID->"02cb85a5-a549-404b-b744-\
2ff7944c3319"],

Cell["\<\
The Job: Calculate properties once, safely, and freeze them as constants.\
\>", "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926549905693*^9}, 
   3.979926585555197*^9, 3.979982028449787*^9, {3.979982075720481*^9, 
   3.979982079218069*^9}},ExpressionUUID->"6a380dfa-f70f-4fc8-94b7-\
371b9fb071d1"],

Cell[TextData[{
 "Why: Inside the ",
 StyleBox["With", "Input"],
 " body, ",
 StyleBox["sym", "Input"],
 " is the raw symbol ",
 StyleBox["x", "Input"],
 ". If we used ",
 StyleBox["sym", "Input"],
 " directly in the grid without ",
 StyleBox["Unevaluated", "Input"],
 ", it would evaluate to ",
 StyleBox["5", "Input"],
 ". Another opportunity for the fish to escape."
}], "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926549905693*^9}, 
   3.979926585555197*^9, 3.9799820313278522`*^9, {3.9799820830435753`*^9, 
   3.979982168419571*^9}},ExpressionUUID->"38909cc2-beeb-4002-83a9-\
216d2fc1bd36"],

Cell[TextData[{
 "Strategy: Calculate safe strings (",
 StyleBox["name", "Input"],
 ", ",
 StyleBox["ctx", "Input"],
 ", ",
 StyleBox["attr", "Input"],
 ") in the ",
 StyleBox["With", "Input"],
 " header (using ",
 StyleBox["Unevaluated", "Input"],
 " shields). In the ",
 StyleBox["With", "Input"],
 " body, every instance of ",
 StyleBox["name", "Input"],
 " in the ",
 StyleBox["Grid", "Input"],
 " is replaced with the string \[OpenCurlyDoubleQuote]",
 StyleBox["x\[CloseCurlyDoubleQuote]", "Input"],
 ". Strings are safe; they don\[CloseCurlyQuote]t evaluate."
}], "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926549905693*^9}, 
   3.979926585555197*^9, {3.979982173751005*^9, 3.97998220882201*^9}, {
   3.979982270076086*^9, 
   3.979982444310494*^9}},ExpressionUUID->"998410ee-7d97-4297-b5bf-\
fa1cf0f0a1a9"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The Display Wrapper: ",
 StyleBox["HoldForm[s]", "Input"]
}], "Subsection",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926549905693*^9}, 
   3.9799265907323847`*^9, {3.9799820406103153`*^9, 
   3.9799820497534943`*^9}},ExpressionUUID->"fea99f73-4bda-4309-a12c-\
cde0aa473881"],

Cell["\<\
The Job: \[OpenCurlyDoubleQuote]Take a snapshot\[CloseCurlyDoubleQuote] of \
the symbol for display purposes.\
\>", "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926549905693*^9}, 
   3.979926594462985*^9, {3.979982455345845*^9, 
   3.979982488314686*^9}},ExpressionUUID->"aebc3e6d-df03-4def-9325-\
4e3640f7bad6"],

Cell[TextData[{
 "Difference from ",
 StyleBox["Hold", "Input"],
 ": ",
 StyleBox["Hold[s]", "Input"],
 " evaluates to ",
 StyleBox["Hold[x]", "Input"],
 ". ",
 StyleBox["HoldForm[s]", "Input"],
 " evaluates to ",
 StyleBox["x", "Input"],
 " (visually), but it is an inert form, protected from further evaluation. It \
is purely cosmetic."
}], "Text",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926549905693*^9}, 
   3.979926594462985*^9, {3.979982491455817*^9, 
   3.979982575185688*^9}},ExpressionUUID->"530f7133-21b9-4522-9ba8-\
4ae3425b9eed"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Summary Table", "Subsection",
 CellChangeTimes->{{3.979926523664399*^9, 3.979926549905693*^9}, 
   3.97992660157098*^9, {3.979982792641814*^9, 
   3.979982795526926*^9}},ExpressionUUID->"ed68798f-cb96-447e-aab5-\
f1611e1dbb3f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Keyword\>\"", ",", "Bold"}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Role\>\"", ",", "Bold"}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Plain English Translation\>\"", ",", "Bold"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<HoldAll\>\"", ",", "\"\<Gatekeeper\>\"", 
       ",", "\"\<Don't compute the inputs; let me handle them raw.\>\""}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Unevaluated\>\"", ",", "\"\<Shield\>\"", 
       ",", "\"\<Pass this symbol to the function, but don't let it explode \
into a value.\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Hold\>\"", ",", "\"\<Cage\>\"", 
       ",", "\"\<Keep this expression frozen indefinitely.\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Evaluate\>\"", ",", "\"\<Override\>\"", 
       ",", "\"\<Compute this specific part now, even though you are inside a \
Cage.\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Replace\>\"", ",", "\"\<Injector\>\"", 
       ",", "\"\<Move the contents of the Cage into a new piece of code \
without letting them explode.\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<HoldForm\>\"", ",", "\"\<Photograph\>\"", 
       ",", "\"\<Show the code as it looks, but don't run it.\>\""}], "}"}]}],
     "}"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Left", ",", "Left", ",", "Left"}], "}"}], ",", "Top"}], 
     "}"}]}], ",", 
   RowBox[{"Background", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"1", "->", "DarkGray"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"Spacings", "->", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1"}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9799829216596537`*^9, 3.979982955207472*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"a2c6b6aa-4ceb-4ed9-8e9a-80df7abf45c2"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"Keyword\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"Role\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"Plain English Translation\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"HoldAll\"\>", "\<\"Gatekeeper\"\>", "\<\"Don't compute the inputs; \
let me handle them raw.\"\>"},
    {"\<\"Unevaluated\"\>", "\<\"Shield\"\>", "\<\"Pass this symbol to the \
function, but don't let it explode into a value.\"\>"},
    {"\<\"Hold\"\>", "\<\"Cage\"\>", "\<\"Keep this expression frozen \
indefinitely.\"\>"},
    {"\<\"Evaluate\"\>", "\<\"Override\"\>", "\<\"Compute this specific part \
now, even though you are inside a Cage.\"\>"},
    {"\<\"Replace\"\>", "\<\"Injector\"\>", "\<\"Move the contents of the \
Cage into a new piece of code without letting them explode.\"\>"},
    {"\<\"HoldForm\"\>", "\<\"Photograph\"\>", "\<\"Show the code as it \
looks, but don't run it.\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {Left, Left, Left}, "Rows" -> {{Top}}},
   GridBoxBackground->{
    "Columns" -> {{None}}, "RowsIndexed" -> {1 -> GrayLevel[0.28]}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{1}}}],
  "Grid"]], "Output",
 CellChangeTimes->{3.9799848172893476`*^9, 3.979988770886503*^9},
 CellLabel->"Out[83]=",ExpressionUUID->"e7370add-bbf7-4682-b423-121e2380610d"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
