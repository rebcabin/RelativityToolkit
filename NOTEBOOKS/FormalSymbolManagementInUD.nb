Cell[CellGroupData[{

Cell["Case Analysis", "Subsubsection",
 CellChangeTimes->{{3.9798532616721067`*^9, 
  3.979853265137939*^9}},ExpressionUUID->"8b22cdbf-d40d-4c4f-b4cc-\
a9d4f54be337"],

Cell[TextData[{
 "Expected: ",
 StyleBox["adHocDummy", "Input"],
 " not an unexteded formal symbol. "
}], "Text",
 CellChangeTimes->{{3.9798491410674467`*^9, 3.979849152367305*^9}, 
   3.979849473022393*^9, {3.97985194454259*^9, 3.9798519470267267`*^9}, 
   3.979853278998056*^9, {3.9798534991924753`*^9, 3.97985350040162*^9}, {
   3.979853781123431*^9, 
   3.979853784725507*^9}},ExpressionUUID->"fd2e53dc-9969-4c84-bf31-\
37efff2af563"],

Cell[TextData[{
 StyleBox["Evaluate", "Input"],
 " is needed because ",
 StyleBox["FormalSymbolQueue", "Input"],
 " has the attribute ",
 StyleBox["HoldAll", "Input"],
 " (or ",
 StyleBox["HoldFirst", "Input"],
 "). Without ",
 StyleBox["Evaluate", "Input"],
 ", ",
 StyleBox["FormalSymbolQ", "Input"],
 " \[OpenCurlyDoubleQuote]grabs\[CloseCurlyDoubleQuote] the literal code ",
 StyleBox["Echo[..., adHocDummy]", "Input"],
 " instead of the symbol inside it. It would then test if ",
 StyleBox["Echo", "Input"],
 " is a formal symbol, and it\[CloseCurlyQuote]s not. ",
 StyleBox["Evaluate", "Input"],
 " forces the ",
 StyleBox["Echo", "Input"],
 " code to run first so the function receives the actual symbol ",
 StyleBox["\[FormalI]999", "Input"],
 "."
}], "Text",
 CellChangeTimes->{{3.979853288318434*^9, 3.9798533741482058`*^9}, {
  3.9798534255785837`*^9, 
  3.97985342652186*^9}},ExpressionUUID->"0a7f4ab5-b370-4cba-8c70-\
06b6c8a6a589"],

Cell[TextData[{
 "Why it\[CloseCurlyQuote]s ",
 StyleBox["False", "Input"],
 ": ",
 StyleBox["FormalSymbolQ", "Input"],
 " is strict : it only likes Pure System symbols (like ",
 StyleBox["\[FormalI]", "Input"],
 ") . Your input is ",
 StyleBox["\[FormalI]999", "Input"],
 " (an Extended symbol) . Therefore, FormalSymbolQ correctly says : \"No, \
this is not a pure system symbol.\""
}], "Text",
 CellChangeTimes->{{3.979853452674254*^9, 
  3.97985346616611*^9}},ExpressionUUID->"363e8b49-aa80-47d4-a3c8-\
