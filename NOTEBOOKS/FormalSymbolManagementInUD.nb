8843e68b0bcf"],

Cell[CellGroupData[{

Cell["Protection Returns", "Subsubsection",
 CellChangeTimes->{{3.9798507386579647`*^9, 3.979850742603971*^9}, {
  3.9798519023235607`*^9, 
  3.97985190340639*^9}},ExpressionUUID->"0adcbfa3-8986-4181-aea0-\
74c59d8e0595"],

Cell["\<\
The Concept : The difference between the container and the content . \
\>", "Text",
 CellChangeTimes->{{3.979852905140964*^9, 
  3.9798529375955048`*^9}},ExpressionUUID->"20f3bbe6-2484-4ad4-ac13-\
440e6d6b9eb7"],

Cell[TextData[{
 "The Explanation : ",
 StyleBox["adHocDummy", "Input"],
 " is a variable (the container) . We ran ",
 StyleBox["Unprotect[adHocDummy]", "Input"],
 ", which means we can change what variable ",
 StyleBox["adHocDummy", "Input"],
 " points to, e . g ., we could run ",
 StyleBox["adHocDummy = 5", "Input"],
 ") . That is why its attributes are empty . "
}], "Text",
 CellChangeTimes->{{3.979852905140964*^9, 3.9798529086412888`*^9}, {
  3.979852963310714*^9, 
  3.979853024492784*^9}},ExpressionUUID->"07931d9a-c920-4840-878f-\
fe73f495840f"],

Cell[TextData[{
 "The content inside ",
 StyleBox["adHocDummy ", "Input"],
 "is the symbol ",
 StyleBox["\[FormalI]999", "Input"],
 " . This symbol is ",
 StyleBox["Protected", "Input"],
 " , as revealed by the symbol inspector"
}], "Text",
 CellChangeTimes->{{3.979852905140964*^9, 3.9798529086412888`*^9}, {
  3.979852963310714*^9, 3.9798530217164383`*^9}, {3.9798530590350227`*^9, 
  3.979853065041325*^9}, {3.979853097409902*^9, 
  3.979853120429575*^9}},ExpressionUUID->"e4293ffb-e0b7-41e4-a972-\
2d0f3290003a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SymbolInspector", "[", "\[FormalI]999", "]"}]], "Input",
 CellChangeTimes->{{3.979853148536721*^9, 3.97985315983464*^9}},
 CellLabel->
  "In[385]:=",ExpressionUUID->"f6bce8b0-3034-4fb0-9b72-9766e19a7799"],

