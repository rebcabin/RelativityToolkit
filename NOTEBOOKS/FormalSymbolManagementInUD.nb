                  RowBox[{
                   RowBox[{"#2", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "+", "63487"}], ",", "10",
                   ",", 
                  RowBox[{"GrayLevel", "[", "0.90", "]"}]}], "]"}]}], "}"}], ",",
               "\[IndentingNewLine]", 
              RowBox[{"Alignment", "->", "Center"}]}], "]"}], "&"}], ",", 
           "codes"}], "]"}], ",", "16"}], "]"}], ",", "\[IndentingNewLine]", 
