Cell[TextData[{
 "DON\[CloseCurlyQuote]T DO THIS: A Module will let you have the illusion of \
assigning a value to a formal symbol, but the symbol won\[CloseCurlyQuote]t \
be any kind of formal. It\[CloseCurlyQuote]s a ",
 StyleBox["User", "Input"],
 " symbol rather than ",
 StyleBox["Pure Formal", "Input"],
 " or ",
 StyleBox["Extended", "Input"],
 ", the only alternatives to ",
 StyleBox["User", "Input"],
 "."
}], "Text",
