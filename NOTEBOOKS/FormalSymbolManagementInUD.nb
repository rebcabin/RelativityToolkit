 RowBox[{
  RowBox[{"ClearAll", "[", "adHocDummy", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"adHocDummy", "=", 
   RowBox[{"Symbol", "[", "\"\<\[FormalI]999\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Unprotect", "[", "adHocDummy", "]"}], ";"}]}], "Input",
