 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Returns", " ", "True", " ", "because", " ", "the", " ", "result", " ", 
     "is", " ", "a", " ", "valid"}], ",", "Protected", ",", 
    RowBox[{"Extended", " ", "Formal", " ", 
     RowBox[{"Symbol", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"FormalSymbolExtendedQ", "[", 
   RowBox[{"Evaluate", "@", 
    RowBox[{"CreateExtendedFormal", "[", "\"\<\[FormalI]543\>\"", "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.979850488039214*^9, 3.9798505016846457`*^9}, {
