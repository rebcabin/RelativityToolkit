Cell[CellGroupData[{

Cell["\<\
TODO 6: Documentation of how to use this (are inputs always strings? If so, \
what should they look like? What if I call this with a formal symbol?); \
explanation of how this works and why it\[CloseCurlyQuote]s so complicated \
(all the edge cases that we found and eliminated). Refer to the documentation \
above. Explain the usage of the final \[OpenCurlyDoubleQuote]With\
\[CloseCurlyDoubleQuote] and why we had to create it in lieu of the earlier \
Module (unless I misunderstand, which is more than likely!)\
\>", "Item",
 CellChangeTimes->{{3.979834957921474*^9, 3.9798350069595547`*^9}, {
  3.979835303841235*^9, 3.9798353063541803`*^9}, {3.9798354418598337`*^9, 
  3.979835473805228*^9}, {3.979835637912068*^9, 3.979835725538581*^9}, {
  3.979846564414443*^9, 3.979846565640276*^9}, {3.979847849897571*^9, 
  3.979847856542564*^9}},ExpressionUUID->"f56aed3c-1e2e-40c2-b005-\
2884a1622002"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"3.", " ", "Constructor"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "CreateExtendedFormal", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"CreateExtendedFormal", "::", "notformal"}], 
     "=", "\"\<The string '`1`' does not contain any formal \
characters.\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"CreateExtendedFormal", "::", "invalidStructure"}], 
     "=", "\"\<The name '`1`' is invalid. Extended formals must start with \
exactly one formal character followed by non-formal characters.\>\""}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"CreateExtendedFormal", "[", "name_String", "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"codes", "=", 
         RowBox[{"ToCharacterCode", "[", "name", "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"1.", " ", "Basic", " ", 
         RowBox[{"Check", ":", 
          RowBox[{
          "Must", " ", "contain", " ", "at", " ", "least", " ", "one", " ", 
           "formal", " ", "character"}]}]}], "*)"}], 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AnyTrue", "[", 
            RowBox[{"codes", ",", "formalCharCodeQ"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"CreateExtendedFormal", "::", "notformal"}], ",", 
             "name"}], "]"}], ";", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"2.", " ", "Structural", " ", 
           RowBox[{"Check", ":", 
            RowBox[{
            "First", " ", "char", " ", "must", " ", "be", " ", "formal"}]}]}],
           ",", 
          RowBox[{
           RowBox[{"rest", " ", "must", " ", "be", " ", "non"}], "-", 
           "formal"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"formalCharCodeQ", "[", 
              RowBox[{"First", "[", "codes", "]"}], "]"}], "&&", 
             RowBox[{"!", 
              RowBox[{"AnyTrue", "[", 
               RowBox[{
                RowBox[{"Rest", "[", "codes", "]"}], ",", 
                "\[IndentingNewLine]", "formalCharCodeQ"}], "]"}]}]}], 
            ")"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"CreateExtendedFormal", "::", "invalidStructure"}], ",", 
             "name"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"3.", " ", "Creation"}], "&"}], " ", "Protection"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"s", "=", 
            RowBox[{"Symbol", "[", "name", "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Protect", "[", "s", "]"}], ";", "\[IndentingNewLine]", 
           "s"}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CreateExtendedFormal", "[", "sym_Symbol", "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "validStructure", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Check", " ", "structure", " ", "using", " ", "the", " ", "precise", " ",
         "predicate"}], "*)"}], 
      RowBox[{
       RowBox[{"validStructure", "=", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"codes", "=", 
            RowBox[{"ToCharacterCode", "[", 
             RowBox[{"SymbolName", "[", "sym", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "codes", "]"}], ">", "0"}], "&&", 
           RowBox[{"formalCharCodeQ", "[", 
            RowBox[{"First", "[", "codes", "]"}], "]"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"validStructure", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Ensure", " ", "it", " ", "is", " ", "protected"}], ",", 
           RowBox[{
           "even", " ", "if", " ", "it", " ", "already", " ", "exists"}]}], 
          "*)"}], 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"Attributes", "[", "sym", "]"}], ",", "Protected"}], 
              "]"}]}], ",", 
            RowBox[{"Protect", "[", "sym", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "sym"}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Else", ":", 
           RowBox[{
           "Not", " ", "a", " ", "valid", " ", "formal", " ", "symbol", " ", 
            "target"}]}], "*)"}], "\[IndentingNewLine]", "$Failed"}], 
        "]"}]}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.979831309843245*^9, 3.979831309844861*^9}, {
   3.9798324101787767`*^9, 3.97983241351702*^9}, {3.979833809880989*^9, 
   3.9798338246422453`*^9}, {3.979834393144713*^9, 3.979834497686458*^9}, 
   3.979847623037448*^9, {3.979849483680211*^9, 3.9798495296412363`*^9}, {
   3.9798496213767014`*^9, 3.979849644903208*^9}, {3.979849920947633*^9, 
   3.979849929144068*^9}},
 CellLabel->
  "In[302]:=",ExpressionUUID->"fa292672-a799-4ba4-8c9c-820d1d20d560"]
}, Open  ]]
}, Open  ]],

