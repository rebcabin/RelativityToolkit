Cell["Extended Formal Symbol Predicate", "Section",
 CellChangeTimes->{{3.979834927845302*^9, 
  3.97983494210434*^9}},ExpressionUUID->"97cb8253-6af2-40b1-8c61-\
cf96059fbc18"],

Cell[CellGroupData[{

Cell[TextData[{
 "TODO 5: Documentation of what an extended formal symbol is and is not; \
explanation of how this works and why it\[CloseCurlyQuote]s so complicated \
(all the edge cases that we found and eliminated). Refer to the documentation \
of ",
 StyleBox["FormalSymbolQ", "Input"],
 " above for uses of the hard-core features like ",
 StyleBox["Hold", "Input"],
 ", ",
 StyleBox["ReleaseHold", "Input"],
 ", ",
 StyleBox["OwnValues", "Input"],
 ", and so on. Explain the usage of the second \[OpenCurlyDoubleQuote]With\
\[CloseCurlyDoubleQuote] and why we had to create it in lieu of the earlier \
Module (unless I misunderstand, which is more than likely!)"
}], "Item",
 CellChangeTimes->{{3.979834957921474*^9, 3.9798350069595547`*^9}, {
  3.979835303841235*^9, 3.9798353063541803`*^9}, {3.9798354418598337`*^9, 
  3.979835473805228*^9}, {3.979835748742161*^9, 3.979835758483131*^9}, {
  3.979846559847611*^9, 3.979846561161734*^9}, {3.979847786782716*^9, 
  3.979847826496071*^9}},ExpressionUUID->"4e530b0a-aaad-4a6c-bee5-\
94675ad168ad"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "FormalSymbolExtendedQ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{
    RowBox[{"{", "FormalSymbolExtendedQ", "}"}], ",", "HoldAll"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FormalSymbolExtendedQ", "[", "s_", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"self", ",", "eval", ",", "isPure"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"self", "=", 
       RowBox[{"checkFormalIdentity", "[", "s", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"isPure", "=", 
       RowBox[{"FormalSymbolQ", "[", "s", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"TrueQ", "[", 
         RowBox[{
          RowBox[{"self", "[", "\"\<Any\>\"", "]"}], "&&", 
          RowBox[{"!", "isPure"}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "True", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Pointer", " ", "check"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"eval", "=", 
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"Replace", "[", 
         RowBox[{
          RowBox[{"Hold", "[", "s", "]"}], ",", 
          RowBox[{"sym_Symbol", ":>", 
           RowBox[{"OwnValues", "[", "sym", "]"}]}], ",", 
          RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{"eval", ",", 
          RowBox[{"{", 
           RowBox[{"(", 
            RowBox[{"_", ":>", "_Symbol"}], ")"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"target", "=", 
            RowBox[{"eval", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Return", "[", 
           RowBox[{"TrueQ", "[", "\[IndentingNewLine]", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"res", "=", 
                RowBox[{"checkFormalIdentity", "[", "target", "]"}]}], "}"}], 
              ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"res", "[", "\"\<Any\>\"", "]"}], "&&", 
               RowBox[{"!", 
                RowBox[{"FormalSymbolQ", "[", "target", "]"}]}]}]}], "]"}], 
            "]"}], "]"}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      "False"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.97983129262798*^9, 3.979831292629407*^9}, {
   3.979834058347336*^9, 3.979834062164982*^9}, {3.979834093625381*^9, 
   3.979834148050899*^9}, {3.979834244964264*^9, 3.9798343841097183`*^9}, {
   3.979834842063798*^9, 3.979834947692215*^9}, 3.9798477813525343`*^9},
 CellLabel->
  "In[215]:=",ExpressionUUID->"170f2948-3462-4821-a2eb-adfacf2e2db2"]
}, Open  ]]
}, Open  ]],

