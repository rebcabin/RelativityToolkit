Cell[CellGroupData[{

Cell["Identity Helper", "Section",
 CellChangeTimes->{{3.979834745961418*^9, 
  3.9798347492483883`*^9}},ExpressionUUID->"0a05b8d9-3ab5-4604-9cc4-\
7924a04c3b27"],

Cell[CellGroupData[{

Cell["Purpose", "Subsubsection",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862124507115*^9}, {
  3.979862362746785*^9, 
  3.979862363512285*^9}},ExpressionUUID->"3a5b1622-99bf-49a9-ae89-\
24ce23972b28"],

Cell[TextData[{
 StyleBox["checkFormalIdentity", "Input"],
 " is a low-level, polymorphic interrogator of the structure of an input ",
 StyleBox["Symbol", "Input"],
 " or ",
 StyleBox["String", "Input"],
 ". It does not evaluate its input. It returns one of ",
 StyleBox["\[OpenCurlyDoubleQuote]Pure\[CloseCurlyDoubleQuote]", "Input"],
 ", ",
 StyleBox["\[OpenCurlyDoubleQuote]Extended\[CloseCurlyDoubleQuote]", 
  "Input"],
 ", or ",
 StyleBox["\[OpenCurlyDoubleQuote]Neither\[CloseCurlyDoubleQuote]", "Input"],
 ". It fails loudly (with ",
 StyleBox["$Failed", "Input"],
 ") on any other type of input."
}], "Text",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862124507115*^9}, {
  3.979862362746785*^9, 3.979862364373609*^9}, {3.979906974629003*^9, 
  3.9799069978092117`*^9}, {3.979907511770637*^9, 3.9799075299990807`*^9}, {
  3.979911076887458*^9, 3.979911209641465*^9}, {3.979911479765469*^9, 
  3.979911482810169*^9}},ExpressionUUID->"1d6373e2-4116-404f-97c4-\
57709c360e80"],

Cell["\<\
This function has a double-layer defense against evaluation, critical when \
inspecting symbols that might have values assigned.\
\>", "Text",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862103097492*^9}, {
  3.979862153113353*^9, 3.979862184193384*^9}, {3.9799070055766497`*^9, 
  3.979907016592517*^9}, {3.979911382956222*^9, 
  3.97991139537812*^9}},ExpressionUUID->"44ab201a-9522-48e7-8f83-\
39ac1e81e88f"],

Cell[TextData[{
 StyleBox["SetAttributes[..., HoldFirst]", "Input"],
 ": stops the argument ",
 StyleBox["s", "Input"],
 " from evaluating before it enters the function. Without this, calling the \
function on a variable ",
 StyleBox["x", "Input"],
 " would pass the value of ",
 StyleBox["x", "Input"],
 " instead of ",
 StyleBox["x", "Input"],
 "."
}], "ItemNumbered",
 CellChangeTimes->{{3.979862092080511*^9, 3.9798621043362722`*^9}, {
  3.979862186669518*^9, 3.97986223217249*^9}, {3.979907045353004*^9, 
  3.979907050861244*^9}},ExpressionUUID->"d89a3b4a-84d6-43ee-a0e5-\
e963dca22dea"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Unevaluated[...]", "Input"],
 ": Is a second line of defense inside the function body. Even inside a held \
function, passing ",
 StyleBox["s", "Input"],
 " to certain other functions can trigger evaluation. Wrapping occurrences of \
",
 StyleBox["s", "Input"],
 " in ",
 StyleBox["Unevaluated", "Input"],
 ", e.g., ",
 StyleBox["SymbolName[Unevaluated[s]]", "Input"],
 ", on a symbols ",
 StyleBox["s", "Input"],
 " guarantees that the called function operates on a symbol itself, not its \
value. ",
 StyleBox["Unevaluated", "Input"],
 " has no effect on a ",
 StyleBox["String", "Input"],
 "."
}], "ItemNumbered",
 CellChangeTimes->{{3.979862092080511*^9, 3.979862105935421*^9}, {
  3.9798622433201838`*^9, 3.979862331583283*^9}, {3.9799070574493923`*^9, 
  3.9799070967296677`*^9}, {3.9799849124963093`*^9, 
  3.9799849472876253`*^9}},ExpressionUUID->"e0569b52-4b76-4003-8739-\
6ec6acef0019"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "checkFormalIdentity", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"checkFormalIdentity", ",", "HoldFirst"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"checkFormalIdentity", "[", 
    RowBox[{"s", ":", 
     RowBox[{"(", 
      RowBox[{"_Symbol", "|", "_String"}], ")"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", "codes"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"name", "=", 
       RowBox[{"Which", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "===", "Symbol"}], ",", 
         RowBox[{"SymbolName", "[", 
          RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
           "if", " ", "input", " ", "is", " ", "a", " ", "literal", " ", 
            "string"}], ",", " ", 
           RowBox[{"not", " ", "a", " ", "symbol"}]}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"StringQ", "[", 
          RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], ",", "s", ",", 
         "\[IndentingNewLine]", "True", ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"codes", "=", 
       RowBox[{"ToCharacterCode", "[", "name", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "codes", "]"}], "==", "1"}], "&&", 
          RowBox[{"formalCharCodeQ", "[", 
           RowBox[{"First", "[", "codes", "]"}], "]"}]}], ")"}], ",", 
        " ", "\"\<Pure\>\"", ",", "\[IndentingNewLine]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "codes", "]"}], ">", "0"}], "&&", 
          RowBox[{"formalCharCodeQ", "[", 
           RowBox[{"First", "[", "codes", "]"}], "]"}]}], ")"}], 
        ",", "\"\<Extended\>\"", ",", "\[IndentingNewLine]", "True", 
        ",", "\"\<Neither\>\""}], "\[IndentingNewLine]", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checkFormalIdentity", "[", "___", "]"}], ":=", "$Failed"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.97983129262798*^9, 3.979831292629407*^9}, {
   3.979834058347336*^9, 3.979834062164982*^9}, {3.979834093625381*^9, 
   3.979834148050899*^9}, {3.979834244964264*^9, 3.9798343841097183`*^9}, {
   3.979834842063798*^9, 3.97983486372563*^9}, 3.979862471211678*^9, {
   3.979901932552689*^9, 3.979901988586347*^9}, {3.979906867131504*^9, 
   3.979906881040251*^9}, 3.9799095536995487`*^9, {3.97991037778579*^9, 
   3.9799103910784683`*^9}, 3.979910543701062*^9, {3.9799106999337387`*^9, 
   3.979910701069354*^9}, 3.979910762777516*^9, {3.979910842233569*^9, 
   3.9799109632112494`*^9}, {3.9799112586248198`*^9, 3.979911281970804*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"1e710411-6e34-4cf2-9f56-89a8dd97fb8b"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Formal Symbol Predicate", "Section",
 CellChangeTimes->{{3.9798348695613956`*^9, 
  3.979834877758819*^9}},ExpressionUUID->"ed66d3d7-2c39-4617-83c2-\
c0b8baabb5d5"],

Cell[TextData[{
 "Except for the ",
 StyleBox["HoldAll", "Input"],
 " attribute, this implementation is obvious, given ",
 StyleBox["checkFormalIdentity", "Input"],
 "."
}], "Text",
 CellChangeTimes->{{3.979984985569529*^9, 
  3.9799850327701817`*^9}},ExpressionUUID->"d5ff1776-f621-4e91-aa14-\
feac5f06b457"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "FormalSymbolQ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{
    RowBox[{"{", "FormalSymbolQ", "}"}], ",", "HoldAll"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FormalSymbolQ", "[", "s_", "]"}], ":=", 
   RowBox[{"\"\<Pure\>\"", "===", 
    RowBox[{"checkFormalIdentity", "[", "s", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.97983129262798*^9, 3.979831292629407*^9}, {
   3.979834058347336*^9, 3.979834062164982*^9}, {3.979834093625381*^9, 
   3.979834148050899*^9}, {3.979834244964264*^9, 3.9798343841097183`*^9}, {
   3.979834842063798*^9, 3.979834923158095*^9}, {3.9799025679612913`*^9, 
   3.979902610577709*^9}, {3.9799064398646183`*^9, 3.979906447533614*^9}, {
   3.9799097249197474`*^9, 3.979909733148682*^9}, {3.97991098959923*^9, 
   3.9799109980862913`*^9}, 3.979984975308573*^9},
 CellLabel->"In[11]:=",ExpressionUUID->"1e286348-5d37-44a5-b480-c4029e59f9cf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Extended Formal Symbol Predicate", "Section",
 CellChangeTimes->{{3.979834927845302*^9, 
  3.97983494210434*^9}},ExpressionUUID->"97cb8253-6af2-40b1-8c61-\
cf96059fbc18"],

Cell[TextData[{
 "One must write ",
 StyleBox["FormalSymbolExtendedQ[Evaluate[x]]", "Input"],
 " to check the value of an expression x, even if that expression is just a \
symbol whose value is a constructed extended formal symbol below. Many \
examples and tests below should make this clear."
}], "Text",
 CellChangeTimes->{{3.979834957921474*^9, 3.9798350069595547`*^9}, {
  3.979835303841235*^9, 3.9798353063541803`*^9}, {3.9798354418598337`*^9, 
  3.979835473805228*^9}, {3.979835748742161*^9, 3.979835758483131*^9}, {
  3.979846559847611*^9, 3.979846561161734*^9}, {3.979847786782716*^9, 
  3.979847826496071*^9}, {3.979906564952482*^9, 3.979906587669108*^9}, {
  3.979909775733593*^9, 3.97990979251554*^9}, {3.979985101622718*^9, 
  3.9799852323544064`*^9}},ExpressionUUID->"a9335b2c-5ab0-4447-8dcc-\
829465d5496f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "FormalSymbolExtendedQ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{
    RowBox[{"{", "FormalSymbolExtendedQ", "}"}], ",", "HoldAll"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FormalSymbolExtendedQ", "[", "s_", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"checkFormalIdentity", "[", "s", "]"}], 
     "===", "\"\<Extended\>\""}], "&&", 
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"Attributes", "[", "s", "]"}], ",", "Protected"}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.97983129262798*^9, 3.979831292629407*^9}, {
   3.979834058347336*^9, 3.979834062164982*^9}, {3.979834093625381*^9, 
   3.979834148050899*^9}, {3.979834244964264*^9, 3.9798343841097183`*^9}, {
   3.979834842063798*^9, 3.979834947692215*^9}, 3.9798477813525343`*^9, {
   3.979902006954969*^9, 3.979902016519998*^9}, {3.979902624040126*^9, 
   3.9799026597752323`*^9}, {3.9799064281535788`*^9, 3.979906433579461*^9}, {
   3.9799098347427473`*^9, 3.9799098353063087`*^9}, {3.979911024292821*^9, 
   3.979911046536448*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"170f2948-3462-4821-a2eb-adfacf2e2db2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Constructor for Extended Formal Symbols", "Section",
 CellChangeTimes->{{3.9798355989666853`*^9, 
  3.979835614160639*^9}},ExpressionUUID->"579ed213-b556-4487-b3e6-\
f1114523e372"],

Cell["\<\
Check for valid structure (one formal character followed by any number \
[including zero] of non-formal characters.\
\>", "Text",
 CellChangeTimes->{{3.9799852978965883`*^9, 
  3.9799853528141947`*^9}},ExpressionUUID->"c33e86c4-ca41-4ef0-85eb-\
4a87cc44d3bb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "CreateExtendedFormal", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CreateExtendedFormal", "::", "invalidStructure"}], 
   "=", "\"\<The name '`1`' is invalid. Extended formals must start with \
exactly one formal character followed by non-formal characters.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "valid", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"valid", "[", "codes_", "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "codes", "]"}], ">", "0"}], "&&", 
       "\[IndentingNewLine]", 
       RowBox[{"formalCharCodeQ", "[", 
        RowBox[{"First", "[", "codes", "]"}], "]"}], "&&", 
       "\[IndentingNewLine]", 
       RowBox[{"!", 
        RowBox[{"AnyTrue", "[", 
         RowBox[{
          RowBox[{"Rest", "[", "codes", "]"}], ",", "formalCharCodeQ"}], 
         "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"CreateExtendedFormal", "[", "name_String", "]"}], ":=", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"valid", "[", 
         RowBox[{"ToCharacterCode", "[", "name", "]"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"s", "=", 
            RowBox[{"Symbol", "[", "name", "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
