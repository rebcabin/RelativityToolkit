      RowBox[{"AssertTrue", "[", 
       RowBox[{
        RowBox[{"FormalSymbolExtendedQ", "[", "\[FormalI]123", "]"}], 
        ",", "\"\<12. Scoping: Extended identity persists despite value \
7\>\""}], "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Should", " ", "fail", " ", 
    RowBox[{"with", "::", "invalidStructure"}]}], "*)"}], 
  RowBox[{
   RowBox[{"AssertMatchQ", "[", 
    RowBox[{
     RowBox[{"Quiet", "[", 
      RowBox[{
      "CreateExtendedFormal", "[", "\"\<\[FormalK]\[FormalJ]888\>\"", "]"}], 
