Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"protectedDummy", "=", 
    RowBox[{"CreateExtendedFormal", "[", "\"\<\[FormalJ]888\>\"", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<--- (1) Identity & Built-in Protection ---\>\"", "]"}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Case", " ", "1"}], ":", 
    RowBox[{"System", " ", "Protection"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AssertMatchQ", "[", 
    RowBox[{
     RowBox[{"Attributes", "[", "\[FormalI]", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"___", ",", "Protected", ",", "___"}], "}"}], 
     ",", "\"\<1. Identity: Built-in \[FormalI] is Protected\>\""}], "]"}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Case", " ", "2"}], ":", 
    RowBox[{"Latin", " ", "Identification"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AssertTrue", "[", 
    RowBox[{
     RowBox[{"FormalSymbolQ", "[", "\[FormalI]", "]"}], 
     ",", "\"\<2. Identity: Latin Pure Formal recognized\>\""}], "]"}], ";"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Case", " ", "3"}], ":", 
    RowBox[{"Greek", " ", "Identification"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AssertTrue", "[", 
    RowBox[{
     RowBox[{"FormalSymbolQ", "[", "\[FormalAlpha]", "]"}], 
     ",", "\"\<3. Identity: Greek Pure Formal recognized\>\""}], "]"}], ";"}],
   "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<--- (2) Pointer & Construction Logic ---\>\"", "]"}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Case", " ", "4"}], ":", 
    RowBox[{"Pointer", " ", "Resolution"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AssertTrue", "[", 
    RowBox[{
     RowBox[{"FormalSymbolExtendedQ", "[", "protectedDummy", "]"}], 
     ",", "\"\<4. Pointer: Variable holding symbol recognized\>\""}], "]"}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Case", " ", "5"}], ":", 
    RowBox[{"The", " ", "Regression", " ", "Fix", " ", 
     RowBox[{"(", 
      RowBox[{
      "The", " ", "target", " ", "symbol", " ", "itself", " ", "must", " ", 
       "be", " ", "Protected"}], ")"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AssertMatchQ", "[", 
    RowBox[{
     RowBox[{"Attributes", "@@", 
      RowBox[{"{", "protectedDummy", "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"___", ",", "Protected", ",", "___"}], "}"}], 
     ",", "\"\<5. Pointer: Target symbol \[FormalJ]888 is Protected\>\""}], 
    "]"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Case", " ", "6"}], ":", 
    RowBox[{"Negative", " ", "Constructor", " ", "Check"}]}], "*)"}]}], "\n", 

 RowBox[{
  RowBox[{
   RowBox[{"AssertMatchQ", "[", 
    RowBox[{
     RowBox[{"Quiet", "[", 
      RowBox[{"CreateExtendedFormal", "[", "\"\<plainVar\>\"", "]"}], "]"}], ",",
      "$Failed", ",", "\"\<6. Safety: Rejects non-formal strings\>\""}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<--- (3) Structural Variety & Boundaries ---\>\"", "]"}],
    ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Case", " ", "7"}], ":", 
    RowBox[{"Numbered", " ", "Dummies"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AssertTrue", "[", 
    RowBox[{
     RowBox[{"FormalSymbolExtendedQ", "[", "\[FormalI]123", "]"}], 
     ",", "\"\<7. Structure: Numbered dummy recognized\>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Case", " ", "8"}], ":", 
    RowBox[{"Prefixed", " ", "Symbols"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AssertTrue", "[", 
    RowBox[{
     RowBox[{"FormalSymbolExtendedQ", "[", "Partial\[FormalX]", "]"}], 
     ",", "\"\<8. Structure: Prefixed symbol recognized\>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Case", " ", "9"}], ":", 
    RowBox[{"Pure", " ", "System", " ", "is", " ", "NOT", " ", "Extended"}]}],
    "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AssertFalse", "[", 
    RowBox[{
     RowBox[{"FormalSymbolExtendedQ", "[", "\[FormalI]", "]"}], 
     ",", "\"\<9. Boundary: Pure System is NOT Extended\>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Case", " ", "10"}], ":", 
    RowBox[{"Extended", " ", "is", " ", "NOT", " ", "Pure", " ", "System"}]}],
    "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AssertFalse", "[", 
    RowBox[{
     RowBox[{"FormalSymbolQ", "[", "\[FormalI]123", "]"}], 
     ",", "\"\<10. Boundary: Extended is NOT Pure System\>\""}], "]"}], ";"}],
   "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<--- (4) Scoping Integrity (The 'Hold' Check) ---\>\"", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "=", "10"}], ",", 
       RowBox[{"\[FormalI]", "=", "5"}], ",", 
       RowBox[{"\[FormalI]123", "=", "7"}]}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Case", " ", "11"}], ":", 
       RowBox[{
        RowBox[{"System", " ", "Symbol", " ", "Value"}], "-", "Shielding"}]}],
       "*)"}], 
     RowBox[{
      RowBox[{"AssertTrue", "[", 
       RowBox[{
        RowBox[{"FormalSymbolQ", "[", "\[FormalI]", "]"}], 
        ",", "\"\<11. Scoping: Built-in identity persists despite value \
5\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Case", " ", "12"}], ":", 
        RowBox[{
         RowBox[{"Extended", " ", "Symbol", " ", "Value"}], "-", 
