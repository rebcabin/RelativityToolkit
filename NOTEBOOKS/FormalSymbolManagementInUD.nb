 TagBox[GridBox[{
    {"\<\"Property\"\>", "\<\"Value\"\>"},
    {"\<\"Literal Symbol\"\>", 
     TagBox["\[FormalI]999",
      HoldForm]},
    {"\<\"Points To\"\>", "\<\"N/A (Literal)\"\>"},
    {"\<\"Current Value\"\>", "\<\"None (Undefined)\"\>"},
    {"\<\"Context\"\>", "\<\"Global`\"\>"},
    {"\<\"Character Codes\"\>", 
     RowBox[{"{", 
      RowBox[{"63496", ",", "57", ",", "57", ",", "57"}], "}"}]},
    {"\<\"Classification\"\>", "\<\"Extended\"\>"},
    {"\<\"Attributes\"\>", 
     RowBox[{"{", "Protected", "}"}]},
    {"\<\"Definition Type\"\>", "\<\"No Definitions\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       GrayLevel[0.3], 
       GrayLevel[0]}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{3.97985316065588*^9},
 CellLabel->
  "Out[385]=",ExpressionUUID->"ad263aed-3702-43d7-bd71-3adfae6eee94"]
}, Open  ]],

Cell[TextData[{
 "When we run ",
 StyleBox["Attributes[Evaluate@adHocDummy]", "Input"],
 ", the ",
 StyleBox["Evaluate", "Input"],
 " forces Mathematica to open the container, pull out ",
 StyleBox["\[FormalI]999", "Input"],
 ", and check that symbol' s attributes ."
}], "Text",
 CellChangeTimes->{{3.979852905140964*^9, 3.9798529086412888`*^9}, {
  3.979852963310714*^9, 3.9798530217164383`*^9}, {3.9798530590350227`*^9, 
  3.979853065041325*^9}, {3.979853097409902*^9, 
  3.979853127619906*^9}},ExpressionUUID->"3093e119-30b1-4753-ac99-\
d1a53e7cfb57"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Attributes", "[", "adHocDummy", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Output", ":", 
    RowBox[{
     RowBox[{"{", "}"}], "<", 
     RowBox[{
      RowBox[{"--", "The"}], " ", "variable", " ", "is", " ", "indeed", " ", 
      "unprotected"}]}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.979850340877994*^9, 3.979850340879648*^9}, 
   3.9798507200100718`*^9, 3.9798507636526537`*^9},
 CellLabel->
  "In[349]:=",ExpressionUUID->"26ab2068-d979-4d8f-9f27-edf9589c591b"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",
 CellChangeTimes->{3.979850770816041*^9},
 CellLabel->
  "Out[349]=",ExpressionUUID->"0cbd27dd-b8b5-4b0c-919a-cac4f6e7f732"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Attributes", "[", 
  RowBox[{"Evaluate", "@", "adHocDummy"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Output", ":", 
    RowBox[{
     RowBox[{"{", "Protected", "}"}], "<", 
     RowBox[{
      RowBox[{"--", "The"}], " ", "value", " ", 
      RowBox[{"(", "\[FormalI]999", ")"}], " ", "is", " ", "protected"}]}]}], 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{3.979850340877994*^9, 3.979850340879648*^9}, 
   3.9798507200100718`*^9, 3.9798507636526537`*^9, {3.979852182550851*^9, 
   3.9798521889950933`*^9}},
 CellLabel->
