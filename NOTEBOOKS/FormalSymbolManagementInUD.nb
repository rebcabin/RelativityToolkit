Cell[BoxData[
 RowBox[{"{", "Protected", "}"}]], "Output",
 CellChangeTimes->{3.979850344807438*^9, 3.979850770848184*^9, 
  3.979852189535864*^9},
 CellLabel->
  "Out[375]=",ExpressionUUID->"f0ef80e6-6280-4dcb-8072-8e1ab1ff5559"]
}, Open  ]]
}, Open  ]],

