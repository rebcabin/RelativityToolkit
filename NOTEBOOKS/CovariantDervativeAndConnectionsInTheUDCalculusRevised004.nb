Cell[CellGroupData[{

Cell["The Transformed Tensor We Want", "Subsubsection",
 CellChangeTimes->{{3.9783688836396227`*^9, 3.978368891652616*^9}, {
  3.978368988054161*^9, 
  3.9783689905920258`*^9}},ExpressionUUID->"c5d6beaf-96bb-40f7-b34f-\
6b2bd249fe36"],

Cell[TextData[{
 "Have \[ScriptCapitalU]\[ScriptCapitalD] write the form \
we\[CloseCurlyQuote]re looking for, unsimplified as of yet. In the next \
steps, we\[CloseCurlyQuote]ll do a roundabout calculation to isolate the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "\[CapitalGamma]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e12e3bc7-a097-4ecb-82b6-9845e7cc1539"],
 " term and figure out how it must transform:"
}], "Text",
 CellChangeTimes->{{3.978369094289789*^9, 3.9783691133190823`*^9}, {
  3.9783704925552197`*^9, 3.978370550054451*^9}, {3.978371647472073*^9, 
  3.978371656953396*^9}},ExpressionUUID->"a191c52a-1f61-464f-8011-\
9d6b2bf9955d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"targetTensor", "=", "\[IndentingNewLine]", 
        RowBox[{"(*", "Jacobians", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Partials", "[", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "ap", "]"}], "]"}], ",", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "mu", "]"}], "]"}]}], "]"}], "*",
          "\[IndentingNewLine]", 
         RowBox[{"Partials", "[", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "nu", "]"}], "]"}], ",", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], "*",
          "\[IndentingNewLine]", 
         RowBox[{"CD", "[", 
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "mu", "]"}], "]"}], ",", 
           RowBox[{"x", "[", 
            RowBox[{"\[ScriptCapitalU]", "[", "nu", "]"}], "]"}]}], "]"}]}]}],
        ")"}], "/.", "pretty"}], "//", "TensorForm"}], ",", 
    "\[IndentingNewLine]", "\"\<\[ScriptCapitalU]\[ScriptCapitalD] says the \
tensor we want, \!\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Alpha]'\)], \(; \
\(\\\ \)\(\[Beta]'\)\)]\) =\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.977069321327636*^9, 3.977069340461385*^9}, {
