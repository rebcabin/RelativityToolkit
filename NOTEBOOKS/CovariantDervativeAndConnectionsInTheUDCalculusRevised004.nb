  3.978364084302086*^9, 3.978364093220086*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"398fc6bd-375a-4b22-b63d-63c81ee48411"],

Cell[BoxData[
 SubscriptBox[
  RowBox[{"A", 
   SuperscriptBox["", 
    SuperscriptBox["\[Alpha]", "\[Prime]",
     MultilineFunction->None]]}], 
  RowBox[{",", 
   SuperscriptBox["\[Beta]", "\[Prime]",
    MultilineFunction->None]}]]], "Output",
 CellChangeTimes->{3.97838172632043*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"371a5cdc-aec8-454e-a671-9ff7448b9fe8"]
