55b5429d2168"],

Cell["\<\
\[ScriptCapitalU]\[ScriptCapitalD]\[CloseCurlyQuote]s CD functions shows off \
the evaluated covariant derivative:\
\>", "Text",
 CellChangeTimes->{{3.977157187685564*^9, 3.977157212898369*^9}, {
  3.9776614812414627`*^9, 
  3.977661516962577*^9}},ExpressionUUID->"6509aa68-bd65-47a2-a949-\
0b90971b8d0a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"TensorForm", "[", 
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]", "]"}], "]"}], ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Beta]", "]"}], "]"}]}], "]"}], 
     "]"}], ",", "\"\<\!\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Alpha]\\\ \
'\)], \(; \(\\\ \)\(\[Beta]\\\ '\)\)]\) =\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.977012219284894*^9, 3.9770122192876463`*^9}, {
  3.9770669668105087`*^9, 3.9770670394796457`*^9}, {3.977067089118279*^9, 
