   3.9770594025116243`*^9, {3.9770666475906487`*^9, 3.977066648961801*^9}, {
   3.97715503842208*^9, 3.9771550518985853`*^9}, {3.977155694581345*^9, 
   3.977155698895607*^9}, {3.97734365529335*^9, 3.9773436934118547`*^9}, {
   3.97766087814517*^9, 3.9776608791074753`*^9}, {3.978364741471477*^9, 
   3.978364747177815*^9}},ExpressionUUID->"8f1ec892-b6d9-4a76-8149-\
21b4735ad9e8"],

Cell[TextData[{
 "These terms have factors, ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     SuperscriptBox["x", 
      RowBox[{"\[Alpha]", "'"}]]}], 
    RowBox[{
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Beta]", " ", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Lambda]"]}]}]], TraditionalForm]],ExpressionUUID->
  "adad717a-7a29-4596-86c0-e48fcdaa64f3"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Lambda]"], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], TraditionalForm]],ExpressionUUID->
  "43450047-a74f-43fd-94a7-765e5cea86e8"],
 " respectively, that are calculated in both coordinate systems, and that\
\[CloseCurlyQuote]s disturbing. We can extract one Jacobian factor of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{" ", "\[Beta]"}]]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{" ", 
       RowBox[{"\[Beta]", " ", "'"}]}]]}]], TraditionalForm]],ExpressionUUID->
  "f7e8d4b6-9256-44aa-8d86-785359c057d7"],
 ", but that\[CloseCurlyQuote]s it:"
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
  3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
  3.977011051138826*^9}, {3.977011515235486*^9, 3.977011570673971*^9}, {
  3.9770414603757057`*^9, 3.977041538097261*^9}, {3.977053320309387*^9, 
  3.977053356535059*^9}, {3.9770592584261723`*^9, 3.977059369274659*^9}, {
  3.9770594205474043`*^9, 3.977059425344063*^9}, {3.9770655434250927`*^9, 
  3.977065571669265*^9}, {3.9770659566282063`*^9, 3.9770659782154293`*^9}, {
  3.9770666890912848`*^9, 3.977066749670599*^9}, {3.977155100992359*^9, 
  3.977155102669262*^9}, {3.977155147971437*^9, 3.977155149729313*^9}, {
  3.977343702069891*^9, 3.977343751225404*^9}, {3.977660872900454*^9, 
  3.977660905951573*^9}, {3.978366576115715*^9, 
  3.9783666311894712`*^9}},ExpressionUUID->"216108f1-fe2e-400a-a1e0-\
31ea1a07077c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", " ", "'"}]], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["A", 
       RowBox[{" ", "\[Lambda]"}]], "(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], 
        SuperscriptBox["x", 
         RowBox[{" ", 
          RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
       RowBox[{
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Beta]", " ", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]}]], ")"}], "+", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        SuperscriptBox["A", 
         RowBox[{" ", "\[Lambda]"}]], 
        RowBox[{",", " ", 
         RowBox[{"\[Beta]", " ", "'"}]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]]}], ")"}]}], "=", "\[LineSeparator]", 
    
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["A", 
        RowBox[{" ", "\[Lambda]"}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Beta]"}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
       RowBox[{"(", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], 
          SuperscriptBox["x", 
           RowBox[{" ", 
            RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
         RowBox[{
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Beta]"}]]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Lambda]"}]]}]}]], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          SuperscriptBox["A", 
           RowBox[{" ", "\[Lambda]"}]], 
          RowBox[{",", " ", "\[Beta]", " "}]], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Beta]"}]]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", 
             RowBox[{"\[Beta]", " ", "'"}]}]]}]]}], ")"}], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]]}]}], "=", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", "\[Beta]"}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", 
          RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["A", 
          RowBox[{" ", "\[Lambda]"}]], 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[PartialD]", "2"], 
           SuperscriptBox["x", 
            RowBox[{" ", 
             RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
          RowBox[{
           RowBox[{"\[PartialD]", 
            SuperscriptBox["x", 
             RowBox[{" ", "\[Beta]"}]]}], 
           RowBox[{"\[PartialD]", 
            SuperscriptBox["x", 
             RowBox[{" ", "\[Lambda]"}]]}]}]]}], "+", 
        RowBox[{
         SubscriptBox[
          SuperscriptBox["A", 
           RowBox[{" ", "\[Lambda]"}]], 
          RowBox[{",", " ", "\[Beta]", " "}]], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", 
             RowBox[{"\[Alpha]", "'"}]}]]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Lambda]"}]]}]]}]}], ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977053379479414*^9, 3.97705375883645*^9}, {
   3.9770594797492647`*^9, 3.977059513634585*^9}, {3.9770600785843143`*^9, 
   3.977060105446658*^9}, {3.977060142965212*^9, 3.9770601668754187`*^9}, {
   3.977060241161337*^9, 3.97706024837414*^9}, {3.9770655886816063`*^9, 
   3.977065613258123*^9}, {3.977065745169601*^9, 3.977065785382228*^9}, {
   3.977066767336562*^9, 3.977066812952137*^9}, {3.977155128974546*^9, 
   3.977155134609047*^9}, 3.9771552277992783`*^9, 
   3.977660972452651*^9},ExpressionUUID->"68824569-07ee-4dde-aba3-\
054006e8fab6"],

Cell[TextData[{
 "The quantity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["A", 
        RowBox[{" ", "\[Lambda]"}]], 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
        RowBox[{
         RowBox[{"\[PartialD]", 
          SuperscriptBox["x", 
           RowBox[{" ", "\[Beta]"}]]}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["x", 
           RowBox[{" ", "\[Lambda]"}]]}]}]]}], "+", 
      RowBox[{
       SubscriptBox[
        SuperscriptBox["A", 
         RowBox[{" ", "\[Lambda]"}]], 
        RowBox[{",", " ", "\[Beta]", " "}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]]}]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"9aa93cc7-3892-41a9-ba6c-bd51f8fb66ca"],
 " is again not tensorial because it has a free index \[Alpha]\
\[CloseCurlyQuote]. Worse, it depends on both coordinate systems, the primed \
and the unprimed, and we can\[CloseCurlyQuote]t have that! Worse still, ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     SuperscriptBox["x", 
      RowBox[{" ", 
       RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
    RowBox[{
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Lambda]"}]]}]}]], TraditionalForm]],ExpressionUUID->
  "57648b80-f7ab-4510-82c5-c78b42b9bae4"],
 " the ",
 StyleBox["Hessian",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of the coordinate transformation, is not a geometrical object, but rather \
an algebraic object. It can\[CloseCurlyQuote]t itself be transformed. It \
depends on particular choices of two coordinate systems. \
It\[CloseCurlyQuote]s of no help."
}], "Text",
 CellChangeTimes->{{3.9770595997808647`*^9, 3.977059649976912*^9}, {
  3.977060262908671*^9, 3.977060269336875*^9}, {3.977065629016151*^9, 
  3.9770656653095827`*^9}, {3.977065732646055*^9, 3.977065734676793*^9}, {
  3.977065803951926*^9, 3.9770659401694393`*^9}, {3.977066838368587*^9, 
  3.977066845133431*^9}, {3.97715523729615*^9, 3.97715537923213*^9}, {
  3.9773437825923567`*^9, 3.977343789036359*^9}, {3.977343823429101*^9, 
  3.977343854911965*^9}, {3.977660923145067*^9, 3.977660946711089*^9}, {
  3.97766098417078*^9, 3.977661019079178*^9}, {3.978366639079331*^9, 
  3.97836664032557*^9}},ExpressionUUID->"ebe8ffac-67c3-483f-adef-\
8fd6a04619f1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Way Out: Covariant Derivative", "Subsection",
 CellChangeTimes->{{3.977155386127281*^9, 3.977155391519208*^9}, {
  3.9771566757235737`*^9, 
  3.977156681157469*^9}},ExpressionUUID->"8cdcbe6e-365d-468f-be86-\
83a59db22473"],

Cell[TextData[{
 "There\[CloseCurlyQuote]s a way out: insist on a certain form. Write the \
tensorial derivative we want, ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],ExpressionUUID->
  "a8336d50-c4e3-4ab3-a0f9-b625815fbd11"],
 ", as the non-tensorial partial derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", " ", "\[Beta]", " "}]], TraditionalForm]],ExpressionUUID->
  "4538a6d3-9eb4-43d0-90e7-3db2329578b6"],
 " plus a correction. Demand that the correction be linear in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "de4487a5-b9aa-4306-b988-17626f8719d7"],
 " and that the sum\[LongDash]partial derivative plus \
correction\[LongDash]transform tensorially. Defining the ",
 StyleBox["semicolon notation ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "for this \[OpenCurlyDoubleQuote]corrected \
derivative\[CloseCurlyDoubleQuote] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]", " "}]], TraditionalForm]],ExpressionUUID->
  "913dd4b6-f1c0-4800-a31c-a34290168771"],
 ", we wite the partial plus the correction"
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
   3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
   3.977010967374028*^9}, {3.977011058197987*^9, 3.9770111504156837`*^9}, {
   3.977011577000286*^9, 3.977011599925207*^9}, {3.9770415661310177`*^9, 
   3.9770416017082853`*^9}, 3.977065836365576*^9, {3.977066857271544*^9, 
   3.977066886804606*^9}, {3.977155793273237*^9, 3.9771558080498247`*^9}, {
   3.977155856304111*^9, 3.977155940793297*^9}, {3.977156702547564*^9, 
   3.977156715247168*^9}, {3.9771747857993298`*^9, 3.9771748228690023`*^9}, {
   3.977174854204146*^9, 3.9771748754519863`*^9}, {3.977661032215549*^9, 
   3.977661040330563*^9}, {3.977661075485488*^9, 3.977661110346837*^9}, {
   3.978366681481967*^9, 
   3.9783666951706247`*^9}},ExpressionUUID->"63150d01-ceda-4f22-803b-\
1a97f3847230"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]", " "}]], "\[Congruent]", 
   RowBox[{
    SubscriptBox[
     SuperscriptBox["A", "\[Alpha]"], 
     RowBox[{",", " ", "\[Beta]"}]], "+", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["\[CapitalGamma]", 
       RowBox[{" ", "\[Alpha]"}]], 
      RowBox[{"\[Beta]", " ", "\[Mu]"}]], 
     SuperscriptBox["A", 
      RowBox[{" ", "\[Mu]"}]]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977010636055129*^9, 3.977010643913973*^9}, {
   3.9770111624798183`*^9, 3.977011270616735*^9}, {3.9771747395848227`*^9, 
   3.977174765973565*^9}, 
   3.977174843804628*^9},ExpressionUUID->"f9347413-dcec-4b5a-b910-\
1ddd35a13a6e"],

Cell["demand that it transform tensorially", "Text",
 CellChangeTimes->{{3.9770112779099293`*^9, 3.977011307443584*^9}, {
  3.9770416099832573`*^9, 3.97704163759873*^9}, {3.97704167848347*^9, 
  3.977041680128821*^9}, {3.977174880283556*^9, 3.9771748832725563`*^9}, {
  3.978366698938204*^9, 
  3.9783667236328583`*^9}},ExpressionUUID->"e22434f5-50f6-4a8b-9f8c-\
d3508d56c6ca"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], 
    RowBox[{";", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Alpha]", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Alpha]"]}]], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    SubscriptBox[
     SuperscriptBox["A", "\[Alpha]"], 
     RowBox[{";", " ", "\[Beta]", " "}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
  3.9770114425225677`*^9, 
  3.977011477474715*^9}},ExpressionUUID->"6b548b6d-3f69-4925-8eed-\
d69868613da1"],

Cell[TextData[{
 "then solve for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],
  CellChangeTimes->{{3.977010636055129*^9, 3.977010643913973*^9}, {
   3.9770111624798183`*^9, 3.977011270616735*^9}, {3.9771747395848227`*^9, 
   3.977174743955871*^9}},ExpressionUUID->
  "3e5103bb-3e12-4990-9d9b-f8465c1a1f08"],
 ". Notice contraction on the third index: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["\[CapitalGamma]", 
      RowBox[{" ", "\[Alpha]"}]], 
     RowBox[{"\[Beta]", " ", "\[Mu]"}]], 
    SuperscriptBox["A", 
     RowBox[{" ", "\[Mu]"}]]}], TraditionalForm]],ExpressionUUID->
  "b96c3df9-c068-46d0-8dc5-830ec825c2dd"],
 "."
}], "Text",
 CellChangeTimes->{{3.9770416266716547`*^9, 3.977041647098284*^9}, {
  3.977174763967944*^9, 3.97717476786619*^9}, {3.977175050927993*^9, 
  3.977175078468285*^9}},ExpressionUUID->"8d4d9e22-f3be-4906-b992-\
4ae23379e624"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]"}]], TraditionalForm]],
  CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
   3.9770114425225677`*^9, 3.977011477474715*^9}},ExpressionUUID->
  "aaff0e20-8a10-420c-ad21-d6122df7e173"],
 " is called the ",
 StyleBox["covariant derivative",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellChangeTimes->{{3.97715676668683*^9, 3.977156901945867*^9}, {
   3.977156959104426*^9, 3.9771569645507193`*^9}, 3.9771579540882998`*^9, {
   3.977174907070912*^9, 
   3.9771749073345127`*^9}},ExpressionUUID->"aa677b05-ae16-4eae-bbdd-\
f266f39e6736"],

Cell[TextData[{
 "Despite the name, the covariant derivative is ",
 StyleBox["contravariant",
  FontSlant->"Italic"],
 " in ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],ExpressionUUID->
  "3be9f4b4-3579-40d0-9f67-c0f7470f914a"],
 " and ",
 StyleBox["covariant",
  FontSlant->"Italic"],
 " in \[Beta], as we see shortly below. The word \
\[OpenCurlyDoubleQuote]covariant\[CloseCurlyDoubleQuote] here does not have \
its usual meaning, but we\[CloseCurlyQuote]re stuck with this historical \
nomenclature."
}], "Text",
 CellChangeTimes->{{3.97715676668683*^9, 3.977156901945867*^9}, {
  3.977156959104426*^9, 3.9771569645507193`*^9}, {3.977157960079286*^9, 
  3.977157987657321*^9}, {3.977174903293665*^9, 
  3.977174945451392*^9}},ExpressionUUID->"f4596ff2-20d6-46b9-810d-\
014bd9bf7e17"],

Cell[TextData[{
 StyleBox["The form of a term plus a correction is ubiquitous in linear \
theories such as that for the Kalman filter (see my notebook ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Kalman filtering as a functional fold",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3078712"], None},
  ButtonNote->"https://community.wolfram.com/groups/-/m/t/3078712"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox["). ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9771559693517923`*^9, 3.977156021556655*^9}, {
  3.977156121895274*^9, 3.97715618015761*^9}, {3.9771562325276012`*^9, 
  3.977156233055827*^9}, {3.97715673704572*^9, 3.9771567417996492`*^9}, {
  3.9771569819587927`*^9, 3.9771570277110653`*^9}, {3.9771586560285892`*^9, 
  3.977158662161306*^9}, {3.9771749724308147`*^9, 3.977174993224945*^9}, {
  3.977343903097906*^9, 3.977343949526277*^9}, {3.9773439915680857`*^9, 
  3.9773440134019623`*^9}},ExpressionUUID->"35276c52-c2f7-42af-bae3-\
7aad79ca3628"],

Cell[TextData[{
 StyleBox["The contravariant vector ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "f380e0e8-e35e-4250-8f52-732cde379efb"],
 StyleBox[" is tensorial, measuring intrinsic properties of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "8dfcecb3-85bf-4e18-9a0b-6767e8f3960f"],
 StyleBox[". ",
  FontSlant->"Italic"],
 "\[CapitalGamma]",
 StyleBox[" is not tensorial, mixing in extrinsic information about the \
coordinate system. The product ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "\[CapitalGamma]"}], TraditionalForm]],ExpressionUUID->
  "8beca113-8cce-4659-8cdc-750fab619775"],
 StyleBox[" is tensorial again. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977661264549698*^9, 3.977661411282783*^9}, {
  3.978366761837364*^9, 
  3.9783667665413227`*^9}},ExpressionUUID->"48be144d-a194-442b-9ec5-\
687f119d2990"],

Cell[TextData[{
 StyleBox["If we do our job right (proving tensoriality and linearity),",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]", " "}]], TraditionalForm]],ExpressionUUID->
  "a07fbd11-71da-429f-91d1-89ba5aca6b1a"],
 StyleBox[" becomes the promised \[OpenCurlyDoubleQuote]cool notation\
\[CloseCurlyDoubleQuote] for",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],ExpressionUUID->
  "086756b8-7739-4ca1-82ff-5717534bad2b"],
 StyleBox[", the derivative we want, the covariant derivative. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9771559693517923`*^9, 3.977156021556655*^9}, {
  3.977156121895274*^9, 3.97715618015761*^9}, {3.9771562325276012`*^9, 
  3.977156233055827*^9}, {3.97715673704572*^9, 3.9771567417996492`*^9}, {
  3.9771569819587927`*^9, 3.9771570277110653`*^9}, {3.9771586560285892`*^9, 
  3.977158662161306*^9}, {3.9771749724308147`*^9, 
  3.977174993224945*^9}},ExpressionUUID->"1d83214e-86d7-4ad8-bfd2-\
aecc4b565ba5"],

Cell[TextData[{
 StyleBox["One may also write ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Beta]"], 
    SuperscriptBox["A", "\[Alpha]"]}], TraditionalForm]],ExpressionUUID->
  "471dc727-dc48-4bc9-b946-f22491454a0d"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", " ", "\[Beta]"}]], TraditionalForm]],ExpressionUUID->
  "c40981cc-26ab-4dde-8fb5-5d93a7d45945"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "\[Beta]"], 
    SuperscriptBox["A", "\[Alpha]"]}], TraditionalForm]],ExpressionUUID->
  "e8553c96-7efe-450a-a763-edddc4e62890"],
 StyleBox[" for ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]"}]], TraditionalForm]],ExpressionUUID->
  "e7924a84-dafe-4933-a105-d18c5e1e4e0e"],
 StyleBox[". These forms frequently appear in the literature.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9771559693517923`*^9, 3.977156021556655*^9}, {
  3.977156121895274*^9, 3.97715618015761*^9}, {3.9771562325276012`*^9, 
  3.977156233055827*^9}, {3.97715673704572*^9, 3.9771567417996492`*^9}, {
  3.9771569819587927`*^9, 3.9771570277110653`*^9}, {3.9771586560285892`*^9, 
  3.977158662161306*^9}, {3.9771749724308147`*^9, 3.9771750114689007`*^9}, {
  3.977175131437334*^9, 3.977175253763031*^9}, {3.977344611788052*^9, 
  3.977344612098686*^9}},ExpressionUUID->"4258b0c6-f5b9-4f49-bc97-\
550d54ee2079"],

Cell[TextData[{
 StyleBox["TODO: Why must the correction ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["\[CapitalGamma]", 
      RowBox[{" ", "\[Alpha]"}]], 
     RowBox[{"\[Beta]", " ", "\[Mu]"}]], 
    SuperscriptBox["A", 
     RowBox[{" ", "\[Mu]"}]]}], TraditionalForm]],ExpressionUUID->
  "fd0324df-9389-4f2e-9cd7-20beaddacd1a"],
 " ",
 StyleBox["be linear in ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "37c96623-a5ed-4e06-9ed5-d665f61130c5"],
 "?"
}], "Item",
 CellChangeTimes->{{3.977011617039833*^9, 3.977011636431033*^9}, {
  3.977042016238361*^9, 3.977042024601349*^9}, {3.977156923684321*^9, 
  3.97715693513172*^9}, {3.977175276385495*^9, 
  3.9771752777294807`*^9}},ExpressionUUID->"5a9eb602-93d2-434f-87e1-\
04e0949c271c"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["SPOILER: We want our new derivative ",
  FontSlant->"Italic"],
 "\[Del]",
 StyleBox[" (aka the semicolon) to behave like any other derivative. That \
means it must satisfy two properties:",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.977012306806328*^9}, {
  3.977012633337566*^9, 3.977012649604801*^9}, {3.977012908231069*^9, 
  3.977012952354192*^9}, {3.977156038024061*^9, 3.977156040257764*^9}, {
  3.9771562072202053`*^9, 
  3.977156209677186*^9}},ExpressionUUID->"76428ab0-8541-45b0-8c78-\
82faffcebf92"],

Cell[TextData[{
 StyleBox["Linearity:",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Mu]"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["A", "\[Nu]"], "+", 
       SuperscriptBox["B", "\[Nu]"]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", "\[Mu]"], 
      SuperscriptBox["A", "\[Nu]"]}], "+", 
     RowBox[{
      SubscriptBox["\[Del]", "\[Mu]"], 
      SuperscriptBox["B", "\[Nu]"]}]}]}], TraditionalForm]],ExpressionUUID->
  "b512c16b-8097-4bc8-9abc-c0dd89a4bcfe"]
}], "Subitem",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770123871945553`*^9}, {
  3.977012726040819*^9, 
  3.977012726973077*^9}},ExpressionUUID->"ecaa396f-685e-4f68-a913-\
268a0ce9b653"],

Cell[TextData[{
 StyleBox["Leibniz Rule:",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Mu]"], 
     RowBox[{"(", 
      RowBox[{"f", "\[VeryThinSpace]", 
       SuperscriptBox["A", "\[Nu]"]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["A", "\[Nu]"], 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Mu]"], "f"}]}], "+", 
     RowBox[{"f", 
      RowBox[{
       SubscriptBox["\[Del]", "\[Mu]"], 
       SuperscriptBox["A", "\[Nu]"]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "6d47b40f-b4c9-48f8-8b61-4048ad49f41d"]
}], "Subitem",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770124711684523`*^9}, {
  3.9770125446957417`*^9, 3.977012552474452*^9}, {3.977012729129239*^9, 
  3.977012729966456*^9}, {3.9771753028095083`*^9, 
  3.977175312929349*^9}},ExpressionUUID->"304ef2c6-a37a-4caf-93e1-\
eb14e20e48c6"],

Cell[TextData[{
 StyleBox["when ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bbf7b5b4-d691-4c3d-b174-4ab0d938c7cd"],
 " and ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e48a2a90-1ac4-4417-aa35-0a6b0ad27321"],
 " are tensors. ",
 StyleBox["If we assume the general form of derivative plus a correction,",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Mu]"], 
     SuperscriptBox["A", "\[Nu]"]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], 
      SuperscriptBox["A", "\[Nu]"]}], "+", 
     RowBox[{
      SuperscriptBox["C", "\[Nu]"], "(", 
      RowBox[{"A", ",", 
       RowBox[{"\[PartialD]", "A"}], ",", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], "A"}], "..."}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"1f0b000a-fc4d-4023-a7d8-63cd275c45c7"],
 StyleBox[", then:",
  FontSlant->"Italic"]
}], "ItemParagraph",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770125300520372`*^9}, {
  3.977012580526639*^9, 3.9770126298321247`*^9}, {3.977012673856485*^9, 
  3.977012691117526*^9}, {3.977012800847804*^9, 3.977012812824003*^9}, {
  3.97717533216661*^9, 3.977175352706544*^9}, {3.978366799506407*^9, 
  3.978366809882592*^9}},ExpressionUUID->"fcc63762-011a-4f88-a9c4-\
b4ceb500b07c"],

Cell[TextData[{
 StyleBox["Linearity forces",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "A", ")"}], TraditionalForm]],ExpressionUUID->
  "ab40a2d3-ab4d-4200-8bba-81b5398f44e3"],
 " ",
 StyleBox["to be linear in",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "6f34ea28-28a9-45ce-ab2c-b98f237285f8"],
 "."
}], "Subitem",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770125300520372`*^9}, {
  3.977012580526639*^9, 3.9770126143825073`*^9}, {3.977012699450643*^9, 
  3.977012733528748*^9}, {3.977175390801517*^9, 
  3.977175401404395*^9}},ExpressionUUID->"a4631cff-c7ac-4d1e-9131-\
d9ab72e1e35d"],

Cell[TextData[{
 StyleBox["Leibniz forces ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "A", ")"}], TraditionalForm]],ExpressionUUID->
  "10f1163b-8def-4f71-b562-0c0c51425a4e"],
 StyleBox[" to have no derivatives of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "7943b409-feb0-4ffd-aab1-87b9707ed198"],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Subitem",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770125300520372`*^9}, {
  3.977012580526639*^9, 3.9770126143825073`*^9}, {3.977012699450643*^9, 
  3.977012740815217*^9}, {3.977012778543912*^9, 3.977012790515648*^9}, {
  3.977012824730361*^9, 
  3.977012846107419*^9}},ExpressionUUID->"f1d3cb88-dfd3-4c24-ad30-\
cd2d73ebcce3"],

Cell[TextData[{
 StyleBox["Therefore, the correction must be a multiplicative term: matrix \
multiplication of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "dbc797e1-db16-40a0-9d85-8f5ccbf59829"],
 StyleBox[" by some object",
  FontSlant->"Italic"],
 " \[CapitalGamma]."
}], "ItemParagraph",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770125300520372`*^9}, {
   3.977012580526639*^9, 3.9770126143825073`*^9}, {3.977012699450643*^9, 
   3.977012742347784*^9}, 3.977041927315693*^9, {3.977175417877757*^9, 
   3.97717542161299*^9}},ExpressionUUID->"789a89e8-59ba-4a8c-a945-\
85885165e07c"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Given what we want to measure, we see why ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "b7f26378-d86d-4667-9f54-d849ed740d63"],
 StyleBox[" ",
  FontSlant->"Italic"],
 StyleBox["must have three indices",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[": it measures how much ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "d4e20b18-43d7-47a8-8cb0-cbaa8fb121e8"],
 " ",
 StyleBox["changes when we change ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"\[Beta]", " "}]], TraditionalForm]],ExpressionUUID->
  "eb011ee9-e1a5-4dda-a281-c1c946d380f3"],
 " ",
 StyleBox["a little, in terms of the components of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "3a5fc6d9-9c27-4d70-973f-16df4f4c7bd2"],
 " ",
 StyleBox["contracted against ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "890a3729-c724-47d9-8dc0-19dc272ce5b3"],
 StyleBox[" at the home point ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{" ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "3dda177d-7943-4dc9-969a-06ae25b3d12b"],
 StyleBox["! Parallel transport simply must look exactly like this, no more, \
no less. (a physicist\[CloseCurlyQuote]s hand-wave; mathematicians want \
more!)",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9770417111334963`*^9, 3.977041902303838*^9}, {
  3.977157066040275*^9, 3.977157100518067*^9}, {3.977175440674534*^9, 
  3.97717549784636*^9}, {3.9773446450579557`*^9, 
  3.9773446952199087`*^9}},ExpressionUUID->"e372545c-923f-4b70-a9ec-\
cbc33cfc3212"],

Cell[TextData[{
 StyleBox["TODO: Is ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "ce48a29e-64cc-420b-af38-29b969c25e72"],
 StyleBox[" symmetric in ",
  FontSlant->"Italic"],
 "\[Beta] and \[Mu]",
 StyleBox["? HINT: don\[CloseCurlyQuote]t rathole on this now!",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977011617039833*^9, 3.977011636431033*^9}, {
  3.977041970911512*^9, 3.9770419976862583`*^9}, {3.977066070902594*^9, 
  3.977066092506713*^9}, {3.97706634307417*^9, 3.977066384746294*^9}, {
  3.9771755134014387`*^9, 
  3.977175527991873*^9}},ExpressionUUID->"eadf0a9a-7d16-48ce-9439-\
a84908cb5cf7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Connection Coefficients", "Subsection",
 CellChangeTimes->{{3.977157114998147*^9, 
  3.977157118893907*^9}},ExpressionUUID->"995372cc-f779-42e1-aef9-\
6c75ea4d6b2d"],

Cell[TextData[{
 "In this context, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "f76192e1-bcbb-493e-9dfe-b34a01908bea"],
 " are called ",
 StyleBox["connection coefficients",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". Later, we\[CloseCurlyQuote]ll use the same symbol ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "4d55dd4c-3585-4f75-990c-a71cd27acdbc"],
 " for Christoffel Symbols, which are particular connection coefficients, \
those that satisfy restrictive physical requirements for general relativity. \
"
}], "Text",
 CellChangeTimes->{{3.977156266188644*^9, 3.9771565565268917`*^9}, {
  3.9771571294538403`*^9, 3.9771571389562473`*^9}, {3.97717553867479*^9, 
  3.977175566956081*^9}, {3.9773271452213697`*^9, 3.977327145423967*^9}, {
  3.97766143551062*^9, 
  3.977661438248385*^9}},ExpressionUUID->"6645c2c4-1754-42eb-b7b8-\
ef2dbbcb65fe"],

Cell[TextData[StyleBox["In restricting connection coefficients for \
gravitation in general relativity, we\[CloseCurlyQuote]re saying \
\[OpenCurlyDoubleQuote]only certain kinds of manifold geometries and \
topologies are useful for describing gravitation.\[CloseCurlyDoubleQuote] \
Connection coefficients are more general than Christoffel symbols, pertaining \
to a broader class of manifolds.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.977156266188644*^9, 3.97715656402293*^9}, {
  3.977157150681932*^9, 3.977157158658589*^9}, {3.9771755750277147`*^9, 
  3.977175596798339*^9}},ExpressionUUID->"29b0eeb1-a8d8-4a00-a0c9-\
1d38188b2c3d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Covariant Derivatives and Connections in \[ScriptCapitalU]\
\[ScriptCapitalD]", "Subsection",
 CellChangeTimes->{{3.9771565971870327`*^9, 3.977156617529027*^9}, {
  3.9771571719352913`*^9, 
  3.977157175632118*^9}},ExpressionUUID->"2426a9d5-b02c-4727-9618-\
55b5429d2168"],

Cell["\<\
\[ScriptCapitalU]\[ScriptCapitalD]\[CloseCurlyQuote]s CD functions shows off \
the evaluated covariant derivative:\
\>", "Text",
 CellChangeTimes->{{3.977157187685564*^9, 3.977157212898369*^9}, {
  3.9776614812414627`*^9, 
  3.977661516962577*^9}},ExpressionUUID->"6509aa68-bd65-47a2-a949-\
0b90971b8d0a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"TensorForm", "[", 
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]", "]"}], "]"}], ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Beta]", "]"}], "]"}]}], "]"}], 
     "]"}], ",", "\"\<\!\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Alpha]\\\ \
'\)], \(; \(\\\ \)\(\[Beta]\\\ '\)\)]\) =\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.977012219284894*^9, 3.9770122192876463`*^9}, {
  3.9770669668105087`*^9, 3.9770670394796457`*^9}, {3.977067089118279*^9, 
  3.977067122702623*^9}, {3.97706716721443*^9, 3.9770672238024797`*^9}, {
  3.978366904223556*^9, 3.978366956466762*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"97b60638-dec3-4d8d-9a77-486a7477b318"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"\\!\\(\\*SubscriptBox[SuperscriptBox[\\(A\\), \\(\[Alpha]\\\\ '\
\\)], \\(; \\(\\\\ \\)\\(\[Beta]\\\\ '\\)\\)]\\) =\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"A", 
      SuperscriptBox["", "\[Alpha]"]}], 
     RowBox[{",", "\[Beta]"}]], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"A", 
       SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Beta]", "\[Lambda]"}], "\[Alpha]"]}]}],
   HoldForm]}]], "Echo",
 CellChangeTimes->{
  3.9783669579771147`*^9},ExpressionUUID->"7b061897-1d51-4e97-b1f4-\
e8ff844c1a9a"]
}, Open  ]],

Cell[TextData[{
 StyleBox["CD", "Input"],
 "\[CloseCurlyQuote]s held form exhibits semicolon notation!"
}], "Text",
 CellChangeTimes->{{3.977157244935853*^9, 3.977157268386498*^9}, {
  3.977175618510482*^9, 
  3.97717563638277*^9}},ExpressionUUID->"5539db76-9765-4a81-a23a-\
d32ef107c9fd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"HoldForm", "[", 
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]", "]"}], "]"}], ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Beta]", "]"}], "]"}]}], "]"}], 
     "]"}], ",", "\"\<\!\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Alpha]\\\ \
'\)], \(; \(\\\ \)\(\[Beta]\\\ '\)\)]\) ===\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.977157217083444*^9, 3.9771572274645433`*^9}, {
  3.978366986551076*^9, 3.978367014218301*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"3b49ba7a-fdf8-4c82-a314-f79b779cfa74"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"\\!\\(\\*SubscriptBox[SuperscriptBox[\\(A\\), \\(\[Alpha]\\\\ '\
\\)], \\(; \\(\\\\ \\)\\(\[Beta]\\\\ '\\)\\)]\\) ===\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   SubscriptBox[
    RowBox[{"A", 
     SuperscriptBox["", "\[Alpha]"]}], 
    RowBox[{";", "\[Beta]"}]],
   HoldForm]}]], "Echo",
