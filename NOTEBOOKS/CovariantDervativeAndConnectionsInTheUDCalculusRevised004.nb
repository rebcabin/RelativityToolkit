 RowBox[{
  RowBox[{"Partials", "[", 
   RowBox[{
    RowBox[{"A", "[", 
     RowBox[{"\[ScriptCapitalU]", "[", "ap", "]"}], "]"}], ",", 
    RowBox[{"x", "[", 
     RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], "/.", 
  "pretty"}]], "Input",
