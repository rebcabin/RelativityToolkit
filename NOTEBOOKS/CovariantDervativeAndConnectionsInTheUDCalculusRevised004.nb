Cell[TextData[{
 "Notice that some harmless Kronecker deltas, in the form of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{"\[VeryThinSpace]", "\[Kappa]"}]]}], "/", 
