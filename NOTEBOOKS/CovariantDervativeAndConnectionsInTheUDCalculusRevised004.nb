  3.978367562108519*^9}},ExpressionUUID->"8e87641c-a52f-415f-aef1-\
2bcf61db11be"],

Cell[TextData[{
 "The partial derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", " ", "\[Beta]"}]], TraditionalForm]],ExpressionUUID->
  "3070d98c-a02c-4a3e-b79e-370c4cf461fd"],
 " is not tensorial, else it would transform like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Alpha]", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Alpha]"]}]], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    SubscriptBox[
     SuperscriptBox["A", "\[Alpha]"], 
     RowBox[{",", " ", "\[Beta]", " "}]]}], TraditionalForm]],
  CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
   3.9770114425225677`*^9, 3.977011477474715*^9}},ExpressionUUID->
  "5b3691bd-bb3b-4a1b-9920-7dbf35fabe22"],
 ". When we differentiate ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"\[Alpha]", "'"}]], TraditionalForm]],ExpressionUUID->
  "44acfb1d-81ff-45ef-8255-289a1c404c79"],
 ", we get "
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
   3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
   3.977011051138826*^9}, {3.977011515235486*^9, 3.977011570673971*^9}, {
   3.9770414603757057`*^9, 3.977041538097261*^9}, {3.977053320309387*^9, 
   3.977053356535059*^9}, {3.9770538109602013`*^9, 3.9770538155186*^9}, {
   3.977155682100684*^9, 3.977155691256544*^9}, {3.977155725060988*^9, 
   3.977155731954468*^9}, {3.977343598017371*^9, 3.97734360794422*^9}, 
   3.977343642359399*^9, 3.977345646389398*^9, {3.977660706507341*^9, 
   3.9776607157901993`*^9}, {3.978364703655611*^9, 3.97836471164368*^9}, {
   3.978364922087956*^9, 
   3.9783649257545223`*^9}},ExpressionUUID->"06a7d4c4-a2c0-479b-8a69-\
6ab4468c4c67"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["A", 
       RowBox[{"\[Alpha]", " ", "'"}]], "\[Congruent]", 
      RowBox[{
       SuperscriptBox["A", "\[Mu]"], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Mu]"}]]}]]}]}], ")"}]}], "\[Congruent]", 
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], "\[Congruent]", 
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["A", "\[Mu]"], " ", 
      FractionBox[
       RowBox[{
        RowBox[{"\[PartialD]", "x"}], 
        SuperscriptBox["", 
         RowBox[{"\[Alpha]", "'"}]]}], 
       RowBox[{
        RowBox[{"\[PartialD]", "x"}], 
        SuperscriptBox["", "\[Mu]"]}]]}], ")"}], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", "  ", "'"}]}]]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977053825090283*^9, 3.9770539820693007`*^9}, {
   3.977054016679175*^9, 3.977054049741235*^9}, {3.977054102978526*^9, 
   3.977054109922058*^9}, {3.9771548635966177`*^9, 3.977154934476821*^9}, 
   3.97715496480508*^9, {3.9773436256094437`*^9, 
   3.977343627052876*^9}},ExpressionUUID->"c5d11daf-857b-4d39-9ac6-\
57636f2c0a9e"],

Cell[TextData[{
 "we don\[CloseCurlyQuote]t get the transform  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "\[Alpha]"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", " ", "'"}]]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{" ", 
         RowBox[{"\[Beta]", " ", "'"}]}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{" ", "\[Beta]"}]]}]], 
     SubscriptBox[
      SuperscriptBox["A", 
       RowBox[{"\[Alpha]", " ", "'"}]], 
      RowBox[{",", " ", 
       RowBox[{"\[Beta]", " ", "'"}]}]]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
   3.9770114425225677`*^9, 3.977011477474715*^9}},ExpressionUUID->
  "6a465448-e981-439b-b64a-655ba41e5065"],
 " of the derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], TraditionalForm]],ExpressionUUID->
  "b4ca2611-eb27-47a3-a7cb-2f9b846875a1"],
 ", but two terms that are difficult to interpret: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["A", "\[Lambda]"], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], 
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", "'"}]]}], 
      RowBox[{
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{"\[Beta]", " ", "'"}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "\[Lambda]"]}]}]]}], ")"}], TraditionalForm]],
  ExpressionUUID->"a90d8813-4cc4-43d0-ba69-d386cde6ca32"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["A", "\[Lambda]"], 
      RowBox[{",", " ", 
       RowBox[{"\[Beta]", " ", "'"}]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", "'"}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "\[Lambda]"]}]]}], ")"}], TraditionalForm]],
  ExpressionUUID->"1d9509af-8d70-48fa-9efc-e35bb0909e5c"],
 "."
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
   3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
   3.977011051138826*^9}, {3.977011515235486*^9, 3.977011570673971*^9}, {
   3.9770414603757057`*^9, 3.977041538097261*^9}, {3.977053320309387*^9, 
   3.977053356535059*^9}, {3.9770592584261723`*^9, 3.977059369274659*^9}, 
   3.9770594025116243`*^9, {3.9770666475906487`*^9, 3.977066648961801*^9}, {
   3.97715503842208*^9, 3.9771550518985853`*^9}, {3.977155694581345*^9, 
   3.977155698895607*^9}, {3.97734365529335*^9, 3.9773436934118547`*^9}, {
   3.97766087814517*^9, 3.9776608791074753`*^9}, {3.978364741471477*^9, 
   3.978364747177815*^9}},ExpressionUUID->"8f1ec892-b6d9-4a76-8149-\
21b4735ad9e8"],

Cell[TextData[{
 "These terms have factors, ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     SuperscriptBox["x", 
      RowBox[{"\[Alpha]", "'"}]]}], 
    RowBox[{
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Beta]", " ", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Lambda]"]}]}]], TraditionalForm]],ExpressionUUID->
  "adad717a-7a29-4596-86c0-e48fcdaa64f3"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Lambda]"], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], TraditionalForm]],ExpressionUUID->
  "43450047-a74f-43fd-94a7-765e5cea86e8"],
 " respectively, that are calculated in both coordinate systems, and that\
\[CloseCurlyQuote]s disturbing. We can extract one Jacobian factor of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{" ", "\[Beta]"}]]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{" ", 
       RowBox[{"\[Beta]", " ", "'"}]}]]}]], TraditionalForm]],ExpressionUUID->
  "f7e8d4b6-9256-44aa-8d86-785359c057d7"],
 ", but that\[CloseCurlyQuote]s it:"
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
  3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
  3.977011051138826*^9}, {3.977011515235486*^9, 3.977011570673971*^9}, {
  3.9770414603757057`*^9, 3.977041538097261*^9}, {3.977053320309387*^9, 
  3.977053356535059*^9}, {3.9770592584261723`*^9, 3.977059369274659*^9}, {
  3.9770594205474043`*^9, 3.977059425344063*^9}, {3.9770655434250927`*^9, 
  3.977065571669265*^9}, {3.9770659566282063`*^9, 3.9770659782154293`*^9}, {
  3.9770666890912848`*^9, 3.977066749670599*^9}, {3.977155100992359*^9, 
  3.977155102669262*^9}, {3.977155147971437*^9, 3.977155149729313*^9}, {
  3.977343702069891*^9, 3.977343751225404*^9}, {3.977660872900454*^9, 
  3.977660905951573*^9}, {3.978366576115715*^9, 
  3.9783666311894712`*^9}},ExpressionUUID->"216108f1-fe2e-400a-a1e0-\
31ea1a07077c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", " ", "'"}]], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["A", 
       RowBox[{" ", "\[Lambda]"}]], "(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], 
        SuperscriptBox["x", 
         RowBox[{" ", 
          RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
       RowBox[{
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Beta]", " ", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]}]], ")"}], "+", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        SuperscriptBox["A", 
         RowBox[{" ", "\[Lambda]"}]], 
        RowBox[{",", " ", 
         RowBox[{"\[Beta]", " ", "'"}]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]]}], ")"}]}], "=", "\[LineSeparator]", 
    
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["A", 
        RowBox[{" ", "\[Lambda]"}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Beta]"}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
       RowBox[{"(", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], 
          SuperscriptBox["x", 
           RowBox[{" ", 
            RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
         RowBox[{
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Beta]"}]]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Lambda]"}]]}]}]], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          SuperscriptBox["A", 
           RowBox[{" ", "\[Lambda]"}]], 
          RowBox[{",", " ", "\[Beta]", " "}]], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Beta]"}]]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", 
             RowBox[{"\[Beta]", " ", "'"}]}]]}]]}], ")"}], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]]}]}], "=", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", "\[Beta]"}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{" ", 
          RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["A", 
          RowBox[{" ", "\[Lambda]"}]], 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[PartialD]", "2"], 
           SuperscriptBox["x", 
            RowBox[{" ", 
             RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
          RowBox[{
           RowBox[{"\[PartialD]", 
            SuperscriptBox["x", 
             RowBox[{" ", "\[Beta]"}]]}], 
           RowBox[{"\[PartialD]", 
            SuperscriptBox["x", 
             RowBox[{" ", "\[Lambda]"}]]}]}]]}], "+", 
        RowBox[{
         SubscriptBox[
          SuperscriptBox["A", 
           RowBox[{" ", "\[Lambda]"}]], 
          RowBox[{",", " ", "\[Beta]", " "}]], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", 
             RowBox[{"\[Alpha]", "'"}]}]]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", 
            RowBox[{" ", "\[Lambda]"}]]}]]}]}], ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977053379479414*^9, 3.97705375883645*^9}, {
   3.9770594797492647`*^9, 3.977059513634585*^9}, {3.9770600785843143`*^9, 
   3.977060105446658*^9}, {3.977060142965212*^9, 3.9770601668754187`*^9}, {
   3.977060241161337*^9, 3.97706024837414*^9}, {3.9770655886816063`*^9, 
   3.977065613258123*^9}, {3.977065745169601*^9, 3.977065785382228*^9}, {
   3.977066767336562*^9, 3.977066812952137*^9}, {3.977155128974546*^9, 
   3.977155134609047*^9}, 3.9771552277992783`*^9, 
   3.977660972452651*^9},ExpressionUUID->"68824569-07ee-4dde-aba3-\
054006e8fab6"],

Cell[TextData[{
 "The quantity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["A", 
        RowBox[{" ", "\[Lambda]"}]], 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
        RowBox[{
         RowBox[{"\[PartialD]", 
          SuperscriptBox["x", 
           RowBox[{" ", "\[Beta]"}]]}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["x", 
           RowBox[{" ", "\[Lambda]"}]]}]}]]}], "+", 
      RowBox[{
       SubscriptBox[
        SuperscriptBox["A", 
         RowBox[{" ", "\[Lambda]"}]], 
        RowBox[{",", " ", "\[Beta]", " "}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Lambda]"}]]}]]}]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"9aa93cc7-3892-41a9-ba6c-bd51f8fb66ca"],
 " is again not tensorial because it has a free index \[Alpha]\
\[CloseCurlyQuote]. Worse, it depends on both coordinate systems, the primed \
and the unprimed, and we can\[CloseCurlyQuote]t have that! Worse still, ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     SuperscriptBox["x", 
      RowBox[{" ", 
       RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
    RowBox[{
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Lambda]"}]]}]}]], TraditionalForm]],ExpressionUUID->
  "57648b80-f7ab-4510-82c5-c78b42b9bae4"],
 " the ",
 StyleBox["Hessian",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of the coordinate transformation, is not a geometrical object, but rather \
an algebraic object. It can\[CloseCurlyQuote]t itself be transformed. It \
depends on particular choices of two coordinate systems. \
It\[CloseCurlyQuote]s of no help."
}], "Text",
 CellChangeTimes->{{3.9770595997808647`*^9, 3.977059649976912*^9}, {
  3.977060262908671*^9, 3.977060269336875*^9}, {3.977065629016151*^9, 
  3.9770656653095827`*^9}, {3.977065732646055*^9, 3.977065734676793*^9}, {
  3.977065803951926*^9, 3.9770659401694393`*^9}, {3.977066838368587*^9, 
  3.977066845133431*^9}, {3.97715523729615*^9, 3.97715537923213*^9}, {
  3.9773437825923567`*^9, 3.977343789036359*^9}, {3.977343823429101*^9, 
  3.977343854911965*^9}, {3.977660923145067*^9, 3.977660946711089*^9}, {
  3.97766098417078*^9, 3.977661019079178*^9}, {3.978366639079331*^9, 
  3.97836664032557*^9}},ExpressionUUID->"ebe8ffac-67c3-483f-adef-\
8fd6a04619f1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Way Out: Covariant Derivative", "Subsection",
 CellChangeTimes->{{3.977155386127281*^9, 3.977155391519208*^9}, {
  3.9771566757235737`*^9, 
  3.977156681157469*^9}},ExpressionUUID->"7b36d5b5-3138-4869-b8c0-\
ed76d38d24c4"],

Cell["There\[CloseCurlyQuote]s a way out: insist on a certain form. ", "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
   3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
   3.977010967374028*^9}, {3.977011058197987*^9, 3.9770111504156837`*^9}, {
   3.977011577000286*^9, 3.977011599925207*^9}, {3.9770415661310177`*^9, 
   3.9770416017082853`*^9}, 3.977065836365576*^9, {3.977066857271544*^9, 
   3.977066886804606*^9}, {3.977155793273237*^9, 3.9771558080498247`*^9}, {
   3.977155856304111*^9, 3.977155940793297*^9}, {3.977156702547564*^9, 
   3.977156715247168*^9}, {3.9771747857993298`*^9, 3.9771748228690023`*^9}, {
   3.977174854204146*^9, 3.9771748754519863`*^9}, {3.977661032215549*^9, 
   3.977661040330563*^9}, {3.977661075485488*^9, 3.977661110346837*^9}, 
   3.978375354479953*^9},ExpressionUUID->"8736fa4e-3b53-49bf-a1a4-\
f68d76b382b9"],

Cell[TextData[{
 "Write the tensorial derivative we want, ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],ExpressionUUID->
  "33210ea2-5572-4427-9d48-5583c0693a3f"],
 ", as the non-tensorial partial derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", " ", "\[Beta]", " "}]], TraditionalForm]],ExpressionUUID->
  "37046549-1309-4cef-add5-13a885c89a67"],
 " plus a correction. "
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
   3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
   3.977010967374028*^9}, {3.977011058197987*^9, 3.9770111504156837`*^9}, {
   3.977011577000286*^9, 3.977011599925207*^9}, {3.9770415661310177`*^9, 
   3.9770416017082853`*^9}, 3.977065836365576*^9, {3.977066857271544*^9, 
   3.977066886804606*^9}, {3.977155793273237*^9, 3.9771558080498247`*^9}, {
   3.977155856304111*^9, 3.977155940793297*^9}, {3.977156702547564*^9, 
   3.977156715247168*^9}, {3.9771747857993298`*^9, 3.9771748228690023`*^9}, {
   3.977174854204146*^9, 3.9771748754519863`*^9}, {3.977661032215549*^9, 
   3.977661040330563*^9}, {3.977661075485488*^9, 3.977661110346837*^9}, 
   3.978375357880967*^9},
 Background->RGBColor[
  1, 0.75, 0, 0.33],ExpressionUUID->"dea4c61d-0c6e-4e53-aefe-ff4f32839045"],

Cell[TextData[{
 "Demand that the correction be linear in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "02fbe2f0-30cc-466f-89c1-fa306f19f9aa"],
 " and that the sum\[LongDash]partial derivative plus \
correction\[LongDash]transform tensorially. Defining the ",
 StyleBox["semicolon notation ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "for this \[OpenCurlyDoubleQuote]corrected \
derivative\[CloseCurlyDoubleQuote] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]", " "}]], TraditionalForm]],ExpressionUUID->
  "12fa5e1f-0782-4432-b96d-7d4cf1f1dafd"]
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
   3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
   3.977010967374028*^9}, {3.977011058197987*^9, 3.9770111504156837`*^9}, {
   3.977011577000286*^9, 3.977011599925207*^9}, {3.9770415661310177`*^9, 
   3.9770416017082853`*^9}, 3.977065836365576*^9, {3.977066857271544*^9, 
   3.977066886804606*^9}, {3.977155793273237*^9, 3.9771558080498247`*^9}, {
   3.977155856304111*^9, 3.977155940793297*^9}, {3.977156702547564*^9, 
   3.977156715247168*^9}, {3.9771747857993298`*^9, 3.9771748228690023`*^9}, {
   3.977174854204146*^9, 3.9771748754519863`*^9}, {3.977661032215549*^9, 
   3.977661040330563*^9}, {3.977661075485488*^9, 
   3.977661110346837*^9}},ExpressionUUID->"259704bb-8907-4643-a346-\
54fbaf5d3035"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]", " "}]], "\[Congruent]", 
   RowBox[{
    SubscriptBox[
     SuperscriptBox["A", "\[Alpha]"], 
     RowBox[{",", " ", "\[Beta]"}]], "+", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["\[CapitalGamma]", 
       RowBox[{" ", "\[Alpha]"}]], 
      RowBox[{"\[Beta]", " ", "\[Mu]"}]], 
     SuperscriptBox["A", 
      RowBox[{" ", "\[Mu]"}]]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977010636055129*^9, 3.977010643913973*^9}, {
   3.9770111624798183`*^9, 3.977011270616735*^9}, {3.9771747395848227`*^9, 
   3.977174765973565*^9}, 
   3.977174843804628*^9},ExpressionUUID->"0423b2b3-f29b-4d84-a746-\
a8a544b0e595"],

Cell["require that it transform as follows:", "Text",
 CellChangeTimes->{{3.9770112779099293`*^9, 3.977011307443584*^9}, {
  3.9770416099832573`*^9, 3.97704163759873*^9}, {3.97704167848347*^9, 
  3.977041680128821*^9}, {3.977174880283556*^9, 
  3.9771748832725563`*^9}},ExpressionUUID->"227e21cc-6991-4861-954f-\
a138d91a4e2a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], 
    RowBox[{";", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Alpha]", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Alpha]"]}]], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    SubscriptBox[
     SuperscriptBox["A", "\[Alpha]"], 
     RowBox[{";", " ", "\[Beta]", " "}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
  3.9770114425225677`*^9, 
  3.977011477474715*^9}},ExpressionUUID->"92c4b4b5-4c9e-455b-b4c3-\
ee1c65dea9ad"],

Cell[TextData[{
 "then solve for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],
  CellChangeTimes->{{3.977010636055129*^9, 3.977010643913973*^9}, {
   3.9770111624798183`*^9, 3.977011270616735*^9}, {3.9771747395848227`*^9, 
   3.977174743955871*^9}},ExpressionUUID->
  "78788299-6e72-4c7e-a1e2-f077d72434a0"],
 ". Notice contraction on the third index: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["\[CapitalGamma]", 
      RowBox[{" ", "\[Alpha]"}]], 
     RowBox[{"\[Beta]", " ", "\[Mu]"}]], 
    SuperscriptBox["A", 
     RowBox[{" ", "\[Mu]"}]]}], TraditionalForm]],ExpressionUUID->
  "867dc762-431f-40b6-ba28-79685899e931"],
 "."
}], "Text",
 CellChangeTimes->{{3.9770416266716547`*^9, 3.977041647098284*^9}, {
  3.977174763967944*^9, 3.97717476786619*^9}, {3.977175050927993*^9, 
  3.977175078468285*^9}},ExpressionUUID->"6aadfbbc-86be-4c32-b761-\
af25138f32b2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]"}]], TraditionalForm]],
  CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
   3.9770114425225677`*^9, 3.977011477474715*^9}},ExpressionUUID->
  "e4773f1d-d44a-4593-9196-ea1bcd315e9f"],
 " is the ",
 StyleBox["covariant derivative",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellChangeTimes->{{3.97715676668683*^9, 3.977156901945867*^9}, {
   3.977156959104426*^9, 3.9771569645507193`*^9}, 3.9771579540882998`*^9, {
   3.977174907070912*^9, 3.9771749073345127`*^9}, {3.978375396394844*^9, 
   3.978375397782238*^9}},ExpressionUUID->"67c4ef89-0440-4355-a7c9-\
30536f3adf15"],

Cell[TextData[{
 StyleBox["Despite the name, the covariant derivative is ",
  FontSlant->"Italic"],
 "contravariant",
 StyleBox[" in ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"d17f08f1-343a-423c-9e64-c67efc714dff"],
 StyleBox[" and ",
  FontSlant->"Italic"],
 "covariant",
 StyleBox[" in ",
  FontSlant->"Italic"],
 StyleBox["\[Beta]", "Input",
  FontSlant->"Italic"],
 StyleBox[". The word \
\[OpenCurlyDoubleQuote]covariant\[CloseCurlyDoubleQuote] here does not have \
its usual meaning, but we\[CloseCurlyQuote]re stuck with this historical \
nomenclature.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.97715676668683*^9, 3.977156901945867*^9}, {
  3.977156959104426*^9, 3.9771569645507193`*^9}, {3.977157960079286*^9, 
  3.977157987657321*^9}, {3.977174903293665*^9, 3.977174945451392*^9}, {
  3.978375442795231*^9, 
  3.9783754473738422`*^9}},ExpressionUUID->"032b4768-715e-4866-810d-\
ca64e16309fb"],

Cell[TextData[{
 StyleBox["The form of a term plus a correction is ubiquitous in linear \
theories such as that for the Kalman filter (see my notebook ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Kalman filtering as a functional fold",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3078712"], None},
  ButtonNote->"https://community.wolfram.com/groups/-/m/t/3078712"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox["). ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9771559693517923`*^9, 3.977156021556655*^9}, {
  3.977156121895274*^9, 3.97715618015761*^9}, {3.9771562325276012`*^9, 
  3.977156233055827*^9}, {3.97715673704572*^9, 3.9771567417996492`*^9}, {
  3.9771569819587927`*^9, 3.9771570277110653`*^9}, {3.9771586560285892`*^9, 
  3.977158662161306*^9}, {3.9771749724308147`*^9, 3.977174993224945*^9}, {
  3.977343903097906*^9, 3.977343949526277*^9}, {3.9773439915680857`*^9, 
  3.9773440134019623`*^9}},ExpressionUUID->"f5ad45df-02e3-4aa6-beaa-\
25b837909854"],

Cell[TextData[{
 StyleBox["The contravariant vector ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "2d70c9aa-8c0d-425e-83fd-d194bf4b5f70"],
 StyleBox[" is tensorial, measuring intrinsic properties of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "00b0657c-e16b-46a3-8c7c-9fc99ee82a1c"],
 StyleBox[". ",
  FontSlant->"Italic"],
 "\[CapitalGamma]",
 StyleBox[" is not tensorial, mixing in extrinsic information about the \
coordinate system. The product ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "\[CapitalGamma]"}], TraditionalForm]],ExpressionUUID->
  "16e0e21a-26c4-4139-aaea-f8d214354751"],
 StyleBox[" is tensorial again. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977661264549698*^9, 
  3.977661411282783*^9}},ExpressionUUID->"3ba872b8-cd1a-460c-9771-\
3fd4e8cc8669"],

Cell[TextData[{
 StyleBox["If we do our job right (proving tensoriality and linearity),",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]", " "}]], TraditionalForm]],ExpressionUUID->
  "35469a05-997b-4ee1-a759-ee1f0e35a433"],
 StyleBox[" becomes the promised \[OpenCurlyDoubleQuote]cool notation\
\[CloseCurlyDoubleQuote] for",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["A", "\[Alpha]"]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Beta]"]}]], TraditionalForm]],ExpressionUUID->
  "9b76dadb-7253-4266-afbe-cec56a13d054"],
 StyleBox[", the derivative we want, the covariant derivative. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9771559693517923`*^9, 3.977156021556655*^9}, {
  3.977156121895274*^9, 3.97715618015761*^9}, {3.9771562325276012`*^9, 
  3.977156233055827*^9}, {3.97715673704572*^9, 3.9771567417996492`*^9}, {
  3.9771569819587927`*^9, 3.9771570277110653`*^9}, {3.9771586560285892`*^9, 
  3.977158662161306*^9}, {3.9771749724308147`*^9, 
  3.977174993224945*^9}},ExpressionUUID->"d09eef5d-2fff-41c3-a053-\
7e1d705ef183"],

Cell[TextData[{
 StyleBox["One may also write ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Beta]"], 
    SuperscriptBox["A", "\[Alpha]"]}], TraditionalForm]],ExpressionUUID->
  "e0bea853-bd20-4587-bc80-46131a2184fb"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", " ", "\[Beta]"}]], TraditionalForm]],ExpressionUUID->
  "6f932f7a-ba6d-4b4c-9ad5-c75d04ebd3c6"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "\[Beta]"], 
    SuperscriptBox["A", "\[Alpha]"]}], TraditionalForm]],ExpressionUUID->
  "9f8884d1-44cf-430f-bfcd-819fd925009d"],
 StyleBox[" for ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{";", " ", "\[Beta]"}]], TraditionalForm]],ExpressionUUID->
  "2ae82d0f-f55b-4889-bb9c-a67d3d48075c"],
 StyleBox[". These forms frequently appear in the literature.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9771559693517923`*^9, 3.977156021556655*^9}, {
  3.977156121895274*^9, 3.97715618015761*^9}, {3.9771562325276012`*^9, 
  3.977156233055827*^9}, {3.97715673704572*^9, 3.9771567417996492`*^9}, {
  3.9771569819587927`*^9, 3.9771570277110653`*^9}, {3.9771586560285892`*^9, 
  3.977158662161306*^9}, {3.9771749724308147`*^9, 3.9771750114689007`*^9}, {
  3.977175131437334*^9, 3.977175253763031*^9}, {3.977344611788052*^9, 
  3.977344612098686*^9}},ExpressionUUID->"c99a77f3-80c8-46fc-ab79-\
e0288d858296"],

Cell[TextData[{
 StyleBox["TODO: Why must the correction ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["\[CapitalGamma]", 
      RowBox[{" ", "\[Alpha]"}]], 
     RowBox[{"\[Beta]", " ", "\[Mu]"}]], 
    SuperscriptBox["A", 
     RowBox[{" ", "\[Mu]"}]]}], TraditionalForm]],ExpressionUUID->
  "0a9bfa51-ab6f-4c59-a788-298d7373f304"],
 " ",
 StyleBox["be linear in ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "f6bc90d3-090d-48ec-85ae-65651364859c"],
 "?"
}], "Item",
 CellChangeTimes->{{3.977011617039833*^9, 3.977011636431033*^9}, {
  3.977042016238361*^9, 3.977042024601349*^9}, {3.977156923684321*^9, 
  3.97715693513172*^9}, {3.977175276385495*^9, 
  3.9771752777294807`*^9}},ExpressionUUID->"65ecc853-88ce-4d8f-99c3-\
c36b93625db9"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["SPOILER: We want our new derivative ",
  FontSlant->"Italic"],
 "\[Del]",
 StyleBox[" (aka the semicolon) to behave like any other derivative. That \
means it must satisfy two properties:",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.977012306806328*^9}, {
  3.977012633337566*^9, 3.977012649604801*^9}, {3.977012908231069*^9, 
  3.977012952354192*^9}, {3.977156038024061*^9, 3.977156040257764*^9}, {
  3.9771562072202053`*^9, 
  3.977156209677186*^9}},ExpressionUUID->"65f2cb89-bce5-4c8d-8a48-\
417a68747993"],

Cell[TextData[{
 StyleBox["Linearity:",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Mu]"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["A", "\[Nu]"], "+", 
       SuperscriptBox["B", "\[Nu]"]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", "\[Mu]"], 
      SuperscriptBox["A", "\[Nu]"]}], "+", 
     RowBox[{
      SubscriptBox["\[Del]", "\[Mu]"], 
      SuperscriptBox["B", "\[Nu]"]}]}]}], TraditionalForm]],ExpressionUUID->
  "9ada96c9-49b7-4a06-ba65-40c70480c40e"]
}], "Subitem",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770123871945553`*^9}, {
  3.977012726040819*^9, 
  3.977012726973077*^9}},ExpressionUUID->"55771c0a-4ac8-48d1-ae88-\
32fdadf739c8"],

Cell[TextData[{
 StyleBox["Leibniz Rule:",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Mu]"], 
     RowBox[{"(", 
      RowBox[{"f", "\[VeryThinSpace]", 
       SuperscriptBox["A", "\[Nu]"]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["A", "\[Nu]"], 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Mu]"], "f"}]}], "+", 
     RowBox[{"f", 
      RowBox[{
       SubscriptBox["\[Del]", "\[Mu]"], 
       SuperscriptBox["A", "\[Nu]"]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "0ced0334-5b20-421d-a8dc-ae5707b653bd"]
}], "Subitem",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770124711684523`*^9}, {
  3.9770125446957417`*^9, 3.977012552474452*^9}, {3.977012729129239*^9, 
  3.977012729966456*^9}, {3.9771753028095083`*^9, 
  3.977175312929349*^9}},ExpressionUUID->"df49bb4e-959b-4c54-8a49-\
5a85a9130418"],

Cell[TextData[{
 StyleBox["If we assume the general form of derivative plus a correction,",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Mu]"], 
     SuperscriptBox["A", "\[Nu]"]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], 
      SuperscriptBox["A", "\[Nu]"]}], "+", 
     RowBox[{
      SuperscriptBox["C", "\[Nu]"], "(", 
      RowBox[{"A", ",", 
       RowBox[{"\[PartialD]", "A"}], ",", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], "A"}], "..."}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"3a4a761b-0db7-4a9d-a061-15186ef87466"],
 StyleBox[", then:",
  FontSlant->"Italic"]
}], "ItemParagraph",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770125300520372`*^9}, {
  3.977012580526639*^9, 3.9770126298321247`*^9}, {3.977012673856485*^9, 
  3.977012691117526*^9}, {3.977012800847804*^9, 3.977012812824003*^9}, {
  3.97717533216661*^9, 
  3.977175352706544*^9}},ExpressionUUID->"df47c430-0a9e-4a34-b156-\
b68630060b20"],

Cell[TextData[{
 StyleBox["Linearity forces",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "A", ")"}], TraditionalForm]],ExpressionUUID->
  "ffb41d50-91b2-466a-95bc-c04966ae6b36"],
 " ",
 StyleBox["to be linear in",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "581487e2-4445-4acb-99cc-018126d5a035"],
 "."
}], "Subitem",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770125300520372`*^9}, {
  3.977012580526639*^9, 3.9770126143825073`*^9}, {3.977012699450643*^9, 
  3.977012733528748*^9}, {3.977175390801517*^9, 
  3.977175401404395*^9}},ExpressionUUID->"665bf344-7f00-4bce-8131-\
c37a3779f9ca"],

Cell[TextData[{
 StyleBox["Leibniz forces ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "A", ")"}], TraditionalForm]],ExpressionUUID->
  "0db07966-8a6b-46fe-948b-e1a80c587388"],
 StyleBox[" to have no derivatives of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "230dc427-d610-46b6-a29a-e1ad9f436b87"],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Subitem",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770125300520372`*^9}, {
  3.977012580526639*^9, 3.9770126143825073`*^9}, {3.977012699450643*^9, 
  3.977012740815217*^9}, {3.977012778543912*^9, 3.977012790515648*^9}, {
  3.977012824730361*^9, 
  3.977012846107419*^9}},ExpressionUUID->"4dd6d619-d13d-499b-a94f-\
1f29a8eeeab0"],

Cell[TextData[{
 StyleBox["Therefore, the correction must be a multiplicative term: matrix \
multiplication of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "81bf2337-8489-486d-a3d8-9990302a20ac"],
 StyleBox[" by some object",
  FontSlant->"Italic"],
 " \[CapitalGamma]."
}], "ItemParagraph",
 CellChangeTimes->{{3.9770122577128143`*^9, 3.9770125300520372`*^9}, {
   3.977012580526639*^9, 3.9770126143825073`*^9}, {3.977012699450643*^9, 
   3.977012742347784*^9}, 3.977041927315693*^9, {3.977175417877757*^9, 
   3.97717542161299*^9}},ExpressionUUID->"1036e794-113f-4047-b0e8-\
91f4018fc503"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Given what we want to measure, we see why ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "beb3aa35-846a-47a9-8293-0a73a388583e"],
 StyleBox[" ",
  FontSlant->"Italic"],
 StyleBox["must have three indices",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[": it measures how much ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "fc538b65-18ec-447e-bb46-1576ecbf37d6"],
 " ",
 StyleBox["changes when we change ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"\[Beta]", " "}]], TraditionalForm]],ExpressionUUID->
  "a2afe1fc-5168-4662-9295-aa4c59728f4d"],
 " ",
 StyleBox["a little, in terms of the components of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "a19c2516-054c-417d-a2c3-fd8df7c9db50"],
 " ",
 StyleBox["contracted against ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "ef15f404-9885-469d-8f2a-8de3a95ceb14"],
 StyleBox[" at the home point ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{" ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "a0b24c0c-d013-4f90-a22b-39928973152b"],
 StyleBox["! Parallel transport simply must look exactly like this, no more, \
no less. (a physicist\[CloseCurlyQuote]s hand-wave; mathematicians want \
more!)",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9770417111334963`*^9, 3.977041902303838*^9}, {
  3.977157066040275*^9, 3.977157100518067*^9}, {3.977175440674534*^9, 
  3.97717549784636*^9}, {3.9773446450579557`*^9, 
  3.9773446952199087`*^9}},ExpressionUUID->"ae1f1652-cdfc-4906-9239-\
420397256875"],

Cell[TextData[{
 StyleBox["TODO: Is ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "7ec2496b-b400-40c5-b61c-69f62ad16c4d"],
 StyleBox[" symmetric in ",
  FontSlant->"Italic"],
 "\[Beta] and \[Mu]",
 StyleBox["? HINT: don\[CloseCurlyQuote]t rathole on this now!",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977011617039833*^9, 3.977011636431033*^9}, {
  3.977041970911512*^9, 3.9770419976862583`*^9}, {3.977066070902594*^9, 
  3.977066092506713*^9}, {3.97706634307417*^9, 3.977066384746294*^9}, {
  3.9771755134014387`*^9, 
  3.977175527991873*^9}},ExpressionUUID->"e03ab3c1-a4d8-4c0d-adbf-\
a1ee5b07069f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Connection Coefficients", "Subsection",
 CellChangeTimes->{{3.977157114998147*^9, 
  3.977157118893907*^9}},ExpressionUUID->"995372cc-f779-42e1-aef9-\
6c75ea4d6b2d"],

Cell[TextData[{
 "In this context, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "f76192e1-bcbb-493e-9dfe-b34a01908bea"],
 " are called ",
 StyleBox["connection coefficients",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " in the linear term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "\[CapitalGamma]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "405ebe85-2a76-4be7-9d5b-3159d7d7c0d7"],
 ", ",
 "or just ",
 StyleBox["connections",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". Later, we\[CloseCurlyQuote]ll use the same symbol ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Alpha]"}]], 
    RowBox[{"\[Beta]", " ", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "4d55dd4c-3585-4f75-990c-a71cd27acdbc"],
 " for Christoffel Symbols, which are particular connection coefficients, \
those that satisfy restrictive physical requirements for general relativity. \
"
}], "Text",
 CellChangeTimes->{{3.977156266188644*^9, 3.9771565565268917`*^9}, {
  3.9771571294538403`*^9, 3.9771571389562473`*^9}, {3.97717553867479*^9, 
  3.977175566956081*^9}, {3.9773271452213697`*^9, 3.977327145423967*^9}, {
  3.97766143551062*^9, 3.977661438248385*^9}, {3.97836762233672*^9, 
  3.978367643672656*^9}, {3.978367691885294*^9, 3.9783677587011023`*^9}, {
  3.978371587314497*^9, 
  3.978371606629813*^9}},ExpressionUUID->"6645c2c4-1754-42eb-b7b8-\
ef2dbbcb65fe"],

Cell[TextData[{
 StyleBox["We shall see, over the course of future notebooks, that ",
  FontSlant->"Italic"],
 StyleBox["connections produce forces",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" in all of physics, classical and quantum! Existence of forces \
depends ",
  FontSlant->"Italic"],
 StyleBox["both",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" on coordinate (gauge) choices and on intrinsic properties like \
mass and charge.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977156266188644*^9, 3.9771565565268917`*^9}, {
  3.9771571294538403`*^9, 3.9771571389562473`*^9}, {3.97717553867479*^9, 
  3.977175566956081*^9}, {3.9773271452213697`*^9, 3.977327145423967*^9}, {
  3.97766143551062*^9, 3.977661438248385*^9}, {3.97836762233672*^9, 
  3.978367643672656*^9}, {3.978367691885294*^9, 3.978367787857161*^9}, {
  3.978367824927924*^9, 3.978367876448988*^9}, {3.9783754951580267`*^9, 
  3.9783754964743433`*^9}},ExpressionUUID->"30759da7-eec1-45bd-b2bf-\
48a0679811b4"],

Cell[TextData[StyleBox["In restricting connection coefficients for \
gravitation in general relativity, we\[CloseCurlyQuote]re saying \
\[OpenCurlyDoubleQuote]only certain kinds of manifold geometries and \
topologies are useful for describing gravitation.\[CloseCurlyDoubleQuote] \
Connection coefficients are more general than Christoffel symbols, pertaining \
to a broader class of manifolds.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.977156266188644*^9, 3.97715656402293*^9}, {
  3.977157150681932*^9, 3.977157158658589*^9}, {3.9771755750277147`*^9, 
  3.977175596798339*^9}},ExpressionUUID->"29b0eeb1-a8d8-4a00-a0c9-\
1d38188b2c3d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Covariant Derivative and Connections in \[ScriptCapitalU]\
\[ScriptCapitalD]", "Section",
 CellChangeTimes->{{3.9771565971870327`*^9, 3.977156617529027*^9}, {
   3.9771571719352913`*^9, 3.977157175632118*^9}, 
