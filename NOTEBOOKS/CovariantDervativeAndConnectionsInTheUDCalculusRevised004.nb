Cell[CellGroupData[{

Cell["Isolate \[CapitalGamma]", "Subsubsection",
 CellChangeTimes->{{3.978380258147049*^9, 
  3.9783802627314796`*^9}},ExpressionUUID->"36bef8d9-a461-49d6-862b-\
c737508747c2"],

Cell[TextData[{
 "The strategy is to contract this equation over a contravariant metric, \
schematically ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Sigma]", "\[VeryThinSpace]", "\[Lambda]"}]}]], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "612d3595-7d26-4486-8368-9342e545d8eb"],
 ", to generate a Kronecker delta, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[Delta]", "\[Sigma]"], "\[Rho]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0f0da527-2a8e-4217-80dd-8708effdd318"],
 ", leaving a bare \[CapitalGamma] on the left. It takes a few steps of \
\[ScriptCapitalU]\[ScriptCapitalD] algebra to do this robustly:"
}], "Text",
 CellChangeTimes->{{3.978380323046361*^9, 3.978380344005818*^9}, {
  3.978380384174572*^9, 3.978380448576353*^9}, {3.978380551784511*^9, 
  3.978380599857443*^9}},ExpressionUUID->"05293a6a-1f55-46c9-8d3b-\
27bffd4cd459"],

