Cell[TextData[{
 "We\[CloseCurlyQuote]ll need Wolfram-friendly notation for primed indices. \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "31507be0-01dd-4803-ad25-4fe7790ca4ba"],
 " won\[CloseCurlyQuote]t do, except for display, because Wolfram interprets \
the prime as a derivative. We\[CloseCurlyQuote]ll just write ",
 StyleBox["ap", "Input"],
 " and ",
 StyleBox["bp", "Input"],
 " for the primed indices ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "25d38605-66ec-45ff-be15-c6769f34eddd"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fde6398c-1ccf-4a80-a5e9-7a260f5f089b"],
 " and a pretty rule for display."
}], "Text",
 CellChangeTimes->{{3.978363323561138*^9, 3.9783634343989773`*^9}, {
  3.9783640373537703`*^9, 
  3.9783640729405003`*^9}},ExpressionUUID->"80800b82-2ecc-4720-b3c1-\
836cb67f861b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"ap", ",", "bp", ",", "\[Mu]", ",", "pretty"}], "]"}], ";", 
  RowBox[{"pretty", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ap", "->", 
      RowBox[{"\[Alpha]", "'"}]}], ",", 
     RowBox[{"bp", "->", 
      RowBox[{"\[Beta]", "'"}]}], ",", 
     RowBox[{"mu", "->", "\[Mu]"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.978363807282136*^9, 3.97836381973028*^9}, {
  3.978364004260365*^9, 3.978364027795046*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"8ff9d738-6eaf-4f85-9678-31d5ad76933f"],

