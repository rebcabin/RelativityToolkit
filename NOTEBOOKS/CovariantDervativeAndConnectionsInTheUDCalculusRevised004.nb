 CellLabel->"In[15]:=",ExpressionUUID->"97b60638-dec3-4d8d-9a77-486a7477b318"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"\\!\\(\\*SubscriptBox[SuperscriptBox[\\(A\\), \\(\[Alpha]\\\\ '\
\\)], \\(; \\(\\\\ \\)\\(\[Beta]\\\\ '\\)\\)]\\) =\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"A", 
      SuperscriptBox["", "\[Alpha]"]}], 
