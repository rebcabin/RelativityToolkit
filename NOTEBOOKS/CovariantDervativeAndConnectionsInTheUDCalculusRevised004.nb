Cell[TextData[{
 "Notice, as promised, the connection coefficient exactly subtracts off the \
offending Hessian from the partial derivative of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40a0584b-5385-4bbb-819d-6677e27a0917"],
 "! "
}], "Text",
 CellChangeTimes->{{3.977664805000186*^9, 3.9776648648144913`*^9}},
 FontWeight->"Bold",ExpressionUUID->"ca16dc2e-5a73-4e9d-b26f-45671e01341d"]
}, Open  ]]
}, Open  ]],

