 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{"\[VeryThinSpace]", "\[Kappa]"}]]}], "/", 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", 
      RowBox[{"\[VeryThinSpace]", "c"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6593fb51-1181-40af-86fc-750340cc819a"],
 ", have been inserted. "
}], "Text",
