8ca1677b5c28"],

Cell[CellGroupData[{

Cell[TextData[{
 "Partials of the Transform ",
 Cell[BoxData[
  FormBox["!=", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8d6f8c36-20fa-4396-93a6-f640a57d7603"],
 " Transform of the Partials"
}], "Subsection",
 CellChangeTimes->{{3.977155403581815*^9, 3.9771554107464933`*^9}, {
  3.977155655529076*^9, 3.9771556615944233`*^9}, {3.977155780594692*^9, 
