8ca1677b5c28"],

Cell[CellGroupData[{

Cell["\<\
The Partials of the Transform are not the Transform of the Partials\
\>", "Subsection",
 CellChangeTimes->{{3.977155403581815*^9, 3.9771554107464933`*^9}, {
  3.977155655529076*^9, 3.9771556615944233`*^9}, {3.977155780594692*^9, 
  3.977155782482003*^9}, {3.978366527541847*^9, 
  3.9783665384880047`*^9}},ExpressionUUID->"8e87641c-a52f-415f-aef1-\
2bcf61db11be"],

Cell[TextData[{
 "The partial derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", "\[Alpha]"], 
    RowBox[{",", " ", "\[Beta]"}]], TraditionalForm]],ExpressionUUID->
  "3070d98c-a02c-4a3e-b79e-370c4cf461fd"],
 " is not tensorial, else it would transform like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[Alpha]", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Alpha]"]}]], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Beta]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    SubscriptBox[
     SuperscriptBox["A", "\[Alpha]"], 
     RowBox[{",", " ", "\[Beta]", " "}]]}], TraditionalForm]],
  CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
   3.9770114425225677`*^9, 3.977011477474715*^9}},ExpressionUUID->
  "5b3691bd-bb3b-4a1b-9920-7dbf35fabe22"],
 ". When we differentiate ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"\[Alpha]", "'"}]], TraditionalForm]],ExpressionUUID->
  "44acfb1d-81ff-45ef-8255-289a1c404c79"],
 ", we get "
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
   3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
   3.977011051138826*^9}, {3.977011515235486*^9, 3.977011570673971*^9}, {
   3.9770414603757057`*^9, 3.977041538097261*^9}, {3.977053320309387*^9, 
   3.977053356535059*^9}, {3.9770538109602013`*^9, 3.9770538155186*^9}, {
   3.977155682100684*^9, 3.977155691256544*^9}, {3.977155725060988*^9, 
   3.977155731954468*^9}, {3.977343598017371*^9, 3.97734360794422*^9}, 
   3.977343642359399*^9, 3.977345646389398*^9, {3.977660706507341*^9, 
   3.9776607157901993`*^9}, {3.978364703655611*^9, 3.97836471164368*^9}, {
   3.978364922087956*^9, 
   3.9783649257545223`*^9}},ExpressionUUID->"06a7d4c4-a2c0-479b-8a69-\
6ab4468c4c67"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{" ", 
        RowBox[{"\[Beta]", " ", "'"}]}]]}]], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["A", 
       RowBox[{"\[Alpha]", " ", "'"}]], "\[Congruent]", 
      RowBox[{
       SuperscriptBox["A", "\[Mu]"], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", 
           RowBox[{"\[Alpha]", " ", "'"}]}]]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", 
          RowBox[{" ", "\[Mu]"}]]}]]}]}], ")"}]}], "\[Congruent]", 
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], "\[Congruent]", 
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["A", "\[Mu]"], " ", 
      FractionBox[
       RowBox[{
        RowBox[{"\[PartialD]", "x"}], 
        SuperscriptBox["", 
         RowBox[{"\[Alpha]", "'"}]]}], 
       RowBox[{
        RowBox[{"\[PartialD]", "x"}], 
        SuperscriptBox["", "\[Mu]"]}]]}], ")"}], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", "  ", "'"}]}]]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977053825090283*^9, 3.9770539820693007`*^9}, {
   3.977054016679175*^9, 3.977054049741235*^9}, {3.977054102978526*^9, 
   3.977054109922058*^9}, {3.9771548635966177`*^9, 3.977154934476821*^9}, 
   3.97715496480508*^9, {3.9773436256094437`*^9, 
   3.977343627052876*^9}},ExpressionUUID->"c5d11daf-857b-4d39-9ac6-\
57636f2c0a9e"],

Cell[TextData[{
 "we don\[CloseCurlyQuote]t get the transform  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "\[Alpha]"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", " ", "'"}]]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{" ", 
         RowBox[{"\[Beta]", " ", "'"}]}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{" ", "\[Beta]"}]]}]], 
     SubscriptBox[
      SuperscriptBox["A", 
       RowBox[{"\[Alpha]", " ", "'"}]], 
      RowBox[{",", " ", 
       RowBox[{"\[Beta]", " ", "'"}]}]]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.977011319711506*^9, 3.9770114094026747`*^9}, {
   3.9770114425225677`*^9, 3.977011477474715*^9}},ExpressionUUID->
  "6a465448-e981-439b-b64a-655ba41e5065"],
 " of the derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[Alpha]", "'"}]], 
    RowBox[{",", " ", 
     RowBox[{"\[Beta]", " ", "'"}]}]], TraditionalForm]],ExpressionUUID->
  "b4ca2611-eb27-47a3-a7cb-2f9b846875a1"],
 ", but two terms that are difficult to interpret: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["A", "\[Lambda]"], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], 
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", "'"}]]}], 
      RowBox[{
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", 
         RowBox[{"\[Beta]", " ", "'"}]]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "\[Lambda]"]}]}]]}], ")"}], TraditionalForm]],
  ExpressionUUID->"a90d8813-4cc4-43d0-ba69-d386cde6ca32"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["A", "\[Lambda]"], 
      RowBox[{",", " ", 
       RowBox[{"\[Beta]", " ", "'"}]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", "'"}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "\[Lambda]"]}]]}], ")"}], TraditionalForm]],
  ExpressionUUID->"1d9509af-8d70-48fa-9efc-e35bb0909e5c"],
 "."
}], "Text",
 CellChangeTimes->{{3.977010011267717*^9, 3.977010320407144*^9}, {
   3.977010389596381*^9, 3.977010610265338*^9}, {3.9770106578367767`*^9, 
