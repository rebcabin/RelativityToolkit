Cell[TextData[{
 "The transformation law implies that \[CapitalGamma] is not tensorial: ",
 StyleBox["the ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "Hessian"}], TraditionalForm]],
  FormatType->TraditionalForm,
  FontWeight->"Bold",ExpressionUUID->"1f677934-ae1b-44b9-b38b-945d3a1b72b8"],
 StyleBox[" term remains with a minus sign that exactly cancels out the \
Hessian from the messy partials",
  FontWeight->"Bold"],
 ", by construction. "
}], "Text",
 CellChangeTimes->{{3.978377494452944*^9, 3.9783775869005938`*^9}, {
  3.9783778921413927`*^9, 
