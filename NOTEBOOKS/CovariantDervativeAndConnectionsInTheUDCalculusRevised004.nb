 " that isolates a factor of \[CapitalGamma] in a coordinate basis (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", 
     RowBox[{"a", "\[VeryThinSpace]", "b", "\[VeryThinSpace]", "c"}]], "\[Congruent]",
     "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8ad8e173-a512-4066-bcc3-f0d9d205d87f"],
 "). The particular one we choose is "
}], "Text",
