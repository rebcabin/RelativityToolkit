Cell[TextData[StyleBox["Prepare a Custom Chain Rule",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.978368120212782*^9, 3.978368125673772*^9}, {
  3.9783690803859386`*^9, 3.9783690856090508`*^9}, {3.978376896806569*^9, 
  3.978376899074506*^9}},ExpressionUUID->"b2559e48-22c0-4688-b69b-\
6aa0aad0efd4"],

Cell[TextData[{
 "Insert a Jacobian for a primed ",
 StyleBox["Partial", "Input"],
 " across coordinate system, i.e., rewrite ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[VeryThinSpace]", "\[Alpha]"}]], 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{",", "\[VeryThinSpace]", 
      RowBox[{"\[Beta]", " ", "'"}]}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "50b5a52c-29f5-4c69-84ce-4d081a1d8167"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[VeryThinSpace]", 
        RowBox[{"\[Beta]", "\[VeryThinSpace]", "'"}]}]]}]], 
    SubscriptBox[
     SuperscriptBox["A", 
      RowBox[{"\[VeryThinSpace]", "\[Alpha]"}]], 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{",", "\[VeryThinSpace]", "\[Mu]"}]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e08b4199-4f52-4cae-8581-a428a4c35290"],
 ". We can\[CloseCurlyQuote]t use \[ScriptCapitalU]\[ScriptCapitalD]\
\[CloseCurlyQuote]s general robust transform rules because they would chain \
on the Jacobian, so we stop that manually. Also, because this is a \
special-purpose rule just for this calculation, we don\[CloseCurlyQuote]t \
mind hard-coding on the primed index ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "29ae0455-77d9-4505-a000-bf11c7d88fdc"],
 ":"
}], "Text",
 CellChangeTimes->{{3.978368169723353*^9, 3.978368297869575*^9}, {
   3.978368395450083*^9, 3.9783685107403107`*^9}, {3.9783686693191433`*^9, 
   3.9783686787249126`*^9}, {3.978369217489888*^9, 3.978369219548739*^9}, 
   3.978369270049225*^9, {3.9783693091176977`*^9, 3.9783693268085203`*^9}, {
   3.9783706217522297`*^9, 3.978370660781953*^9}, {3.9783717005267677`*^9, 
   3.9783717561731167`*^9}},ExpressionUUID->"3120a45f-6294-4fdc-946c-\
01dc2e7e97a0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Condition", " ", "!"}], 
    RowBox[{"MatchQ", "[", 
     RowBox[{"expr", ",", 
      RowBox[{"x", "[", "_", "]"}]}], "]"}], " ", "prevents", " ", 
    "recursing", " ", "a", " ", "Jacobian", " ", "on", " ", "tself"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
