Cell[CellGroupData[{

Cell["Coalesce and Simplify (Magic)", "Subsubsection",
 CellChangeTimes->{{3.978370769130232*^9, 3.978370775105863*^9}, {
  3.978370905628933*^9, 
  3.978370907568421*^9}},ExpressionUUID->"cc2b0a02-7303-46b5-baa8-\
0ec13bdd877e"],

Cell[TextData[{
 "This is messy, of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     RowBox[{"A", ".", "Hessian"}]}], " ", "-", " ", 
    RowBox[{"A", 
     RowBox[{"(", "primed", ")"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Del]", "A"}], "=", 
       RowBox[{
        RowBox[{"\[PartialD]", "A"}], "+", 
        RowBox[{"A", ".", "\[CapitalGamma]"}]}]}], ")"}], 
     RowBox[{"(", "primed", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "201525fe-d66d-4442-8149-e0303156854f"],
 ", but we can spot that the derivative terms ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[VeryThinSpace]", "\[Lambda]"}]], 
    RowBox[{" ", 
     RowBox[{",", "\[VeryThinSpace]", "\[Kappa]"}]}]], TraditionalForm]],
  ExpressionUUID->"169d2a17-d2c9-4cbd-9ed3-a15945778c82"],
 " might cancel, if\[NonBreakingSpace]\[Ellipsis]"
}], "Text",
 CellChangeTimes->{{3.9783771763952007`*^9, 3.978377379475494*^9}, {
  3.978377529900889*^9, 3.978377531103545*^9}, {3.978377972146805*^9, 
  3.978377972146853*^9}},ExpressionUUID->"fa7a9900-ac16-48a5-8211-\
721cae595e5e"],

Cell[TextData[{
 "Here is the magic: if we collect the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "49adf9eb-f83c-479a-9906-b32d6210abd7"],
 " terms, \[ScriptCapitalU]\[ScriptCapitalD]\[CloseCurlyQuote]s ",
 StyleBox["TensorForm", "Input"],
 " expands, canonicalizes, and canceling the derivative term ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["A", 
     RowBox[{"\[VeryThinSpace]", "\[Lambda]"}]], 
    RowBox[{" ", 
     RowBox[{",", "\[VeryThinSpace]", "\[Kappa]"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8f2618d5-76b2-485d-8cea-27b78441b52e"],
 ":"
}], "Text",
 CellChangeTimes->{{3.978370783519539*^9, 3.9783708035307617`*^9}, {
  3.9783708430880423`*^9, 3.978370902921185*^9}, {3.97837100371705*^9, 
