 CellChangeTimes->{{3.9771500832617273`*^9, 3.9771501268724957`*^9}, {
  3.977150679079076*^9, 3.977150685730893*^9}, {3.9771576592071667`*^9, 
  3.977157676916306*^9}, {3.9773233415879374`*^9, 3.977323343514309*^9}, {
  3.9773434490468388`*^9, 
  3.977343450602543*^9}},ExpressionUUID->"d666e820-84ea-483e-8043-\
8a96ac078e85"],

Cell["\<\
Up to this point, we have not actually used a metric tensor! MTW devote seven \
whole chapters to differential geometry without a metric (9-15), stressing \
that many general results in differential geometry\[LongDash]the topological \
results\[LongDash]can be derived without the metric. In particular, the \
covariant derivative and the connection coefficients do not, actually, depend \
on any metrical ability to measure distances, but only on assumptions of \
continuity and differentiability. \
\>", "Text",
 CellChangeTimes->{{3.97732333012521*^9, 3.9773233350406647`*^9}, {
  3.977323423324995*^9, 3.977323488527858*^9}, {3.9773235280813227`*^9, 
  3.977323631376588*^9}, {3.9773237435059967`*^9, 3.9773237462946033`*^9}, {
  3.977325424659396*^9, 3.977325428158806*^9}, {3.977343307434906*^9, 
  3.977343370799951*^9}, {3.9776616843987837`*^9, 
  3.977661688316935*^9}},ExpressionUUID->"d2f190a3-1caf-4e5b-add3-\
3ac012ba79fc"],

Cell["\<\
But gravitation via general relativity requires a special case: Riemannian \
Geometry. For that, we need a metric, and even a bit more: symmetry \
conditions on both the connection coefficients and on the metric. From these \
additions, we derive the ultra-famous gravitational Christoffel symbols:\
\>", "Text",
 CellChangeTimes->{{3.977323636710183*^9, 3.977323694809557*^9}, {
  3.977323759476172*^9, 3.977323854177054*^9}, {3.977343391493824*^9, 
  3.977343427749483*^9}, {3.9776629662133512`*^9, 
  3.9776629812021303`*^9}},ExpressionUUID->"bdc35c0c-6611-4319-b3a9-\
3695eb0858e2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Sigma]"}]], 
    RowBox[{"\[Mu]", " ", "\[Nu]"}]], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     SuperscriptBox["g", 
      RowBox[{" ", 
       RowBox[{"\[Sigma]", " ", "\[Lambda]"}]}]], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["g", 
       RowBox[{" ", 
        RowBox[{
         RowBox[{"\[Lambda]", " ", "\[Mu]"}], ",", " ", "\[Nu]"}]}]], "+", 
      SubscriptBox["g", 
       RowBox[{" ", 
        RowBox[{
         RowBox[{"\[Lambda]", " ", "\[Nu]"}], ",", " ", "\[Mu]"}]}]], "-", 
      SubscriptBox["g", 
       RowBox[{" ", 
        RowBox[{
         RowBox[{"\[Mu]", " ", "\[Nu]"}], ",", " ", "\[Lambda]"}]}]]}], 
     ")"}]}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977323862292182*^9, 3.977323876119052*^9}, {
  3.977323907803689*^9, 3.97732403687103*^9}, {3.977331646123781*^9, 
  3.977331646125001*^9}},ExpressionUUID->"6aa9bfaf-a2e3-4b49-b180-\
c698a4f0be7a"],

Cell["\<\
This is equation 8.24 of MTW, after renaming some indices. It is also called \
\[OpenCurlyDoubleQuote]The Fundamental Theorem of Riemannian Geometry\
\[CloseCurlyDoubleQuote] in mathematical texts like do\[NonBreakingSpace]\
\[NoBreak]Carmo and Lee (see References). \
\>", "Text",
 CellChangeTimes->{{3.977324211658308*^9, 3.977324265210064*^9}, {
  3.977324302567616*^9, 3.9773243242949*^9}, {3.977324527106386*^9, 
  3.977324585469681*^9}, {3.977343217427327*^9, 
  3.977343221529702*^9}},ExpressionUUID->"b3e94a6d-cee9-4c10-b2f2-\
6e34e966da39"],

Cell["\<\
The following block of code shows a step-by-step derivation via \
\[ScriptCapitalU]\[ScriptCapitalD]. As usual, the \
\[OpenCurlyDoubleQuote]prose\[CloseCurlyDoubleQuote] is in the comments and \
Echoes. Run it and read it!\
\>", "Text",
 CellChangeTimes->{{3.977324211658308*^9, 3.977324265210064*^9}, {
   3.977324302567616*^9, 3.9773243242949*^9}, {3.977324527106386*^9, 
   3.9773245814547977`*^9}, 3.9773248625354967`*^9, 3.977331634734275*^9, 
   3.977345535831894*^9},ExpressionUUID->"c3853764-aafa-4e4d-a1d0-\
515dce9f11c8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", \
"\"\<=========================================================================\
\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Christoffel Symbols for Gravitation from Metric via the \
\[ScriptCapitalU]\[ScriptCapitalD] Calculus\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", \
"\"\<=========================================================================\
\>\"", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "g", ",", "GammaSymmetryRule", ",", "MetricSymmetryRule", ",", "term1", ",",
      "term2", ",", "term3", ",", "combination", ",", "targetIndex"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<1. PHYSICAL CONSTRAINTS \
-------------------------------------------------\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<1a. Torsion-free geometry: \
\!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalGamma]\), \(\[Alpha]\)], \(\
\[Beta]\[Gamma]\)]\) == \
\!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalGamma]\), \(\[Alpha]\)], \(\
\[Gamma]\[Beta]\)]\), [MTW] Box 10.2, page 250 \>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GammaSymmetryRule", "=", 
    RowBox[{"Echo", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[CapitalGamma]", "[", 
        RowBox[{"u_", ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "b_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "c_", "]"}]}], "]"}], ":>", 
       "\[IndentingNewLine]", 
       RowBox[{"\[CapitalGamma]", "[", 
        RowBox[{"u", ",", 
         RowBox[{"\[ScriptCapitalD]", "[", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"{", 
             RowBox[{"b", ",", "c"}], "}"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"{", 
             RowBox[{"b", ",", "c"}], "}"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "\"\<\[CapitalGamma] Symmetry: \>\""}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<1b. Metric Symmetry: \!\(\*SubscriptBox[\(g\), \
\(\[Alpha]\[Beta]\)]\) == \!\(\*SubscriptBox[\(g\), \(\[Beta]\[Alpha]\)]\), \
[MTW] Equation 8.24, page 210\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Style", "[", 
    RowBox[{"\"\<(output manipulated as expected by \[ScriptCapitalU]\
\[ScriptCapitalD] display rules)\>\"", ",", "Gray"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MetricSymmetryRule", "=", 
    RowBox[{"Echo", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "a_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "b_", "]"}]}], "]"}], ":>", 
       "\[IndentingNewLine]", 
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "\"\<g Symmetry\>\""}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<1c. Metric Compatibility Postulates \!\(\*SubscriptBox[\
\(\[Del]\), \([\[Lambda]\)]\)\!\(\*SubscriptBox[\(g\), \(\[Mu]\[Nu]\(]\)\)]\) \
= 0 [MTW] Eqn 8.23 & Chapter 14.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Term", " ", "1"}], ":", " ", 
    RowBox[{
     SubscriptBox["\[Del]", "\[Lambda]"], 
     SubscriptBox["g", "\[Mu]\[Nu]"]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"term1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Lambda]", "]"}], "]"}]}], "]"}], 
     "/.", " ", "GammaSymmetryRule"}], "/.", " ", "MetricSymmetryRule"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"TensorForm", "[", "term1", "]"}], 
     ",", "\"\<0 = \!\(\*SubscriptBox[\(\[Del]\), \
\(\[Lambda]\)]\)\!\(\*SubscriptBox[\(g\), \(\[Mu]\[Nu]\)]\) =\>\""}], "]"}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Term", " ", "2"}], ":", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", "\[Mu]"], 
      SubscriptBox["g", "\[Nu]\[Lambda]"]}], " ", 
     RowBox[{"(", 
      RowBox[{"Left", "-", 
       RowBox[{"Cycle", " ", "Indices"}]}], ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"term2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Lambda]", "]"}]}], "]"}], ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], "]"}], "/.",
      " ", "GammaSymmetryRule"}], "/.", " ", "MetricSymmetryRule"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"TensorForm", "[", "term2", "]"}], 
     ",", "\"\<0 = \!\(\*SubscriptBox[\(\[Del]\), \
\(\[Mu]\)]\)\!\(\*SubscriptBox[\(g\), \(\[Mu]\[Lambda]\)]\) =\>\""}], "]"}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Term", " ", "3"}], ":", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", "\[Nu]"], 
      SubscriptBox["g", "\[Lambda]\[Mu]"]}], " ", 
     RowBox[{"(", 
      RowBox[{"Left", "-", 
       RowBox[{"Cycle", " ", "Indices"}]}], ")"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"term3", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Lambda]", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}]}], "]"}], ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], "/.",
      " ", "GammaSymmetryRule"}], "/.", " ", "MetricSymmetryRule"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"TensorForm", "[", "term3", "]"}], 
     ",", "\"\<0 = \!\(\*SubscriptBox[\(\[Del]\), \
\(\[Nu]\)]\)\!\(\*SubscriptBox[\(g\), \(\[Lambda]\[Mu]\)]\) =\>\""}], "]"}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<2. CYCLIC PERMUTATION TRICK \
---------------------------------------------\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Write 'Koszul' sum of \[Del]g permutations that isolates \
a \[CapitalGamma] term.\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<[MTW] Equation 8.24b, page 210, in coordinate basis \
(\!\(\*SubscriptBox[\(c\), \(abc\)]\)===0)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<The Linear Combination 0 = (\!\(\*SubscriptBox[\(\[Del]\
\), \(\[Mu]\)]\)\!\(\*SubscriptBox[\(g\), \(\[Nu]\[Lambda]\)]\) + \
\!\(\*SubscriptBox[\(\[Del]\), \(\[Nu]\)]\)\!\(\*SubscriptBox[\(g\), \(\
\[Lambda]\[Mu]\)]\) - \!\(\*SubscriptBox[\(\[Del]\), \
\(\[Lambda]\)]\)\!\(\*SubscriptBox[\(g\), \(\[Mu]\[Nu]\)]\)) ===\>\"", "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"combination", "=", 
      RowBox[{"(", 
       RowBox[{"term2", "+", "term3", "-", "term1"}], ")"}]}], 
     ",", "\"\<0 =\>\""}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"gammaPart", "=", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"List", "@@", "combination"}], ",", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"FreeQ", "[", 
           RowBox[{"#", ",", "\[CapitalGamma]"}], "]"}]}], "&"}]}], "]"}], "//",
       "Total"}]}], ",", 
    "\[IndentingNewLine]", "\"\<\[CapitalGamma] part =\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"gammaPartCanonical", "=", 
     RowBox[{"gammaPart", "//", "CanonicalizeIndices"}]}], ",", 
    "\[IndentingNewLine]", "\"\<\[CapitalGamma] part (canonical) =\>\""}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"metricPartials", "=", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"List", "@@", "combination"}], ",", 
         RowBox[{
          RowBox[{"FreeQ", "[", 
           RowBox[{"#", ",", "\[CapitalGamma]"}], "]"}], "&"}]}], "]"}], "//",
        "Total"}]}], ",", "\[IndentingNewLine]", "\"\<g partials\>\""}], 
    "]"}], ";"}], "\n", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<3. SOLVE FOR \[CapitalGamma] \
----------------------------------------------------------\>\"", "]"}], ";"}],
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Equation", ":", " ", 
     RowBox[{"gammaPart", " ", "+", " ", "metricPartials"}]}], " ", "=", " ", 
    
    RowBox[{"0", " ", "=", 
     RowBox[{
      RowBox[{">", " ", 
       RowBox[{"-", "gammaPart"}]}], " ", "=", " ", "metricPartials"}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<3a. Equation to solve:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lhsRaw", "=", 
   RowBox[{"-", "gammaPartCanonical"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rhsRaw", "=", "metricPartials"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"TensorForm", "[", 
      RowBox[{"lhsRaw", "==", "rhsRaw"}], "]"}], 
     ",", "\"\<Isolated Equation:\>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<3b. Find correct \!\(\*SuperscriptBox[\(g\), \(-1\)]\) \
to multiply through.\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Find", " ", "the", " ", "metric", " ", "inside", " ", "the", " ",
     "LHS", " ", "term"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"metricFound", "=", 
      RowBox[{"First", "[", 
       RowBox[{"Cases", "[", 
        RowBox[{"lhsRaw", ",", 
         RowBox[{"g", "[", "__", "]"}], ",", "Infinity"}], "]"}], "]"}]}], 
     ",", "\"\<g found\>\""}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "Find", " ", "the", " ", "Gamma", " ", "inside", " ", "the", " ",
     "LHS", " ", "term"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"gammaFound", "=", 
      RowBox[{"First", "[", 
       RowBox[{"Cases", "[", 
        RowBox[{"lhsRaw", ",", 
         RowBox[{"\[CapitalGamma]", "[", "__", "]"}], ",", "Infinity"}], 
        "]"}], "]"}]}], ",", "\"\<\[CapitalGamma] found\>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "Extract", " ", "raw", " ", "symbols", " ", "from", " ", "the", 
    " ", "indices"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"metricIndices", "=", 
     RowBox[{"First", "/@", 
      RowBox[{"(", 
       RowBox[{"List", "@@", "metricFound"}], ")"}]}]}], 
    ",", "\"\<g indices\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"gammaUpIndex", "=", 
      RowBox[{"First", "[", 
       RowBox[{"First", "[", "gammaFound", "]"}], "]"}]}], 
     ",", "\"\<\[CapitalGamma] up index\>\""}], "]"}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"4.", " ", "Identify", " ", "the", " ", "Target", " ", "Index"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "The", " ", "g", " ", "index", " ", "that", " ", "matches", " ", 
     "\[CapitalGamma]", " ", "up"}], "-", 
    RowBox[{"index", " ", "is", " ", "the", " ", 
     RowBox[{"Dummy", ".", " ", "The"}], " ", "other", " ", "is", " ", "the", 
     " ", 
     RowBox[{"Target", "."}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"targetIndex", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"metricIndices", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "===", "gammaUpIndex"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"metricIndices", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"metricIndices", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], 
     ",", "\"\<target index\>\""}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "5.", " ", "Construct", " ", "the", " ", "specific", " ", "Inverse", " ", 
    "needed"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"invMetricFactor", "=", 
     RowBox[{
      RowBox[{"1", "/", "2"}], "*", 
      RowBox[{"g", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalU]", "[", "\[Sigma]", "]"}], ",", 
        RowBox[{"\[ScriptCapitalU]", "[", "targetIndex", "]"}]}], "]"}]}]}], 
    ",", "\"\<\!\(\*FractionBox[\(1\), \(2\)]\)\!\(\*SuperscriptBox[\(g\), \
\(-1\)]\) =\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<(1/2 cancels factor 2 from \[CapitalGamma] part (canonical) \
above)\>\"", ",", "Gray"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<3c. Multiply and Contract\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"\[Delta]", "-", 
    RowBox[{"\[CapitalGamma]", " ", "contraction", " ", "rule", " ", 
     RowBox[{"(", 
      RowBox[{
      "will", " ", "be", " ", "promoted", " ", "into", " ", "the", " ", 
       "engine", " ", "in", " ", "next", " ", "installment"}], ")"}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"deltaContractionRule", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Delta]", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalU]", "[", "s_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "r_", "]"}]}], "]"}], "*", 
       RowBox[{"\[CapitalGamma]", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalU]", "[", "r_", "]"}], ",", "a_", ",", 
         "b_"}], "]"}]}], ":>", 
      RowBox[{"\[CapitalGamma]", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalU]", "[", "s", "]"}], ",", "a", ",", "b"}], 
       "]"}]}]}], ",", 
    "\[IndentingNewLine]", "\"\<\[Delta]-\[CapitalGamma] contraction rule: \>\
\""}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<(will be promoted into \[ScriptCapitalU]\[ScriptCapitalD] \
in the future)\>\"", ",", "Gray"}], "]"}], "]"}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Execute", " ", "the", " ", "algebra"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"lhsSolved", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"lhsRaw", "*", "invMetricFactor"}], "//.", "metricRules"}], "//.",
        "deltaContractionRule"}]}], ",", 
     "\[IndentingNewLine]", "\"\<LHS solved: \>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Format", " ", 
    RowBox[{"RHS", ":", 
     RowBox[{"Factor", " ", "out", " ", 
      RowBox[{"1", "/", "2"}], " ", 
      SubscriptBox[
       SuperscriptBox["g", "\[Sigma]"], "\[Lambda]"]}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"rhsSolved", "=", 
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{"rhsRaw", "*", "invMetricFactor"}], ",", 
        RowBox[{"g", "[", 
         RowBox[{
          RowBox[{"\[ScriptCapitalU]", "[", "_", "]"}], ",", 
          RowBox[{"\[ScriptCapitalU]", "[", "_", "]"}]}], "]"}]}], "]"}]}], ",",
      "\[IndentingNewLine]", "\"\<RHS solved:\>\""}], "]"}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Step", " ", 
    RowBox[{"D", ":", " ", 
     RowBox[{"Final", " ", "Result"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\\n=== CHRISTOFFEL SYMBOLS FOR GRAVITATION ===\>\"", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<aka The Fundamental Theorem of Riemannian Geometry\>\"", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"finalEquation", "=", 
   RowBox[{"lhsSolved", "==", "rhsSolved"}]}], ";"}], "\n", 
 RowBox[{"TensorForm", "[", "finalEquation", "]"}]}], "Input",
 CellChangeTimes->{{3.9770981117137413`*^9, 3.9770981117158203`*^9}, {
   3.977098829941216*^9, 3.977098832342011*^9}, {3.977179588418297*^9, 
   3.9771798310532227`*^9}, {3.977179868658339*^9, 3.977179899869376*^9}, {
   3.9771799765078917`*^9, 3.977180013868384*^9}, {3.977180051845149*^9, 
   3.977180071922567*^9}, {3.977180106871004*^9, 3.977180209210095*^9}, 
   3.9771802584360743`*^9, {3.977180300075632*^9, 3.977180349523456*^9}, {
   3.9771804845188417`*^9, 3.977180545816358*^9}, {3.9771806151709023`*^9, 
   3.977180695201001*^9}, {3.977180748452641*^9, 3.977180974451383*^9}, {
   3.977181014741563*^9, 3.9771810248905077`*^9}, {3.977315085927628*^9, 
   3.977315152689231*^9}, {3.977315493019553*^9, 3.977315502010401*^9}, {
   3.977315879076455*^9, 3.977315886617988*^9}, {3.977315922290262*^9, 
   3.977315964011044*^9}, {3.977316009154687*^9, 3.977316022377968*^9}, {
   3.977316123378832*^9, 3.9773161476997643`*^9}, {3.977316224915759*^9, 
   3.977316240776288*^9}, {3.977316286309656*^9, 3.97731629611765*^9}, 
   3.977316490597039*^9, {3.977316971098374*^9, 3.9773169821083508`*^9}, {
   3.9773176531517553`*^9, 3.977317676911489*^9}, {3.9773177116930847`*^9, 
   3.977317925743244*^9}, {3.977318050979621*^9, 3.9773186279487047`*^9}, {
   3.977319010273041*^9, 3.977319048540351*^9}, {3.977319122382081*^9, 
   3.977319181637879*^9}, 3.9773192240910788`*^9, {3.9773196625018187`*^9, 
   3.977319794014806*^9}, {3.977319836009293*^9, 3.977319904541507*^9}, {
   3.9773200184010057`*^9, 3.9773201089236937`*^9}, {3.977320151235465*^9, 
   3.97732021047779*^9}, {3.977320246755556*^9, 3.977320270877893*^9}, {
   3.97732031545212*^9, 3.977320337655264*^9}, {3.9773203936974897`*^9, 
   3.977320490231146*^9}, {3.977320522832514*^9, 3.977320526581662*^9}, {
   3.977320566195903*^9, 3.97732067618921*^9}, {3.977320710566293*^9, 
   3.977320774197253*^9}, {3.977320812545466*^9, 3.977320916720937*^9}, {
   3.977321096597171*^9, 3.9773214757865677`*^9}, 3.977321515997673*^9, {
   3.9773215612167273`*^9, 3.977321615438087*^9}, {3.977321818574361*^9, 
   3.977321851597739*^9}, {3.977321893348645*^9, 3.9773219257649317`*^9}, {
   3.977322003448641*^9, 3.977322080991271*^9}, {3.977322115558934*^9, 
   3.977322202816578*^9}, {3.977322253669594*^9, 3.977322312614291*^9}, {
   3.977322377027413*^9, 3.977322388137892*^9}, {3.977323013081101*^9, 
