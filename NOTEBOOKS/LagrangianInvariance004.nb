   3.9751879555425*^9}},ExpressionUUID->"672be04f-5453-4099-870e-\
2bd5dfc6b630"],

Cell[TextData[{
 "To reach the Standard Model, we transition from the world-line of a single \
particle to a field-dependent ",
 ButtonBox["Lagrangian Density",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3584475"], None},
  ButtonNote->"https://community.wolfram.com/groups/-/m/t/3584475"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalL]", "(", 
    RowBox[{"\[Phi]", ",", 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]"}]}], ")"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e0f8b1f8-89c7-41ae-8fc2-e6d4f7f280fb"],
 "."
}], "Text",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 3.975185960766884*^9}, {
   3.975186335204997*^9, 3.975186378447083*^9}, {3.975186481658581*^9, 
   3.975186523869499*^9}, {3.975186557291993*^9, 3.975186598287777*^9}, {
   3.9751867212544107`*^9, 3.9751868361873503`*^9}, {3.9751868702450438`*^9, 
   3.975186918879197*^9}, 3.975187383155944*^9, {3.975187474714205*^9, 
   3.975187559493368*^9}, {3.975187877891349*^9, 3.975188018394823*^9}, {
   3.975188095613347*^9, 3.9751881210625877`*^9}, {3.975188500865512*^9, 
   3.975188509670395*^9}},ExpressionUUID->"d063b032-8da2-423b-b55b-\
bdbaac241ab9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Local Gauge Invariance", "Subsection",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 3.975185960766884*^9}, {
   3.975186335204997*^9, 3.975186378447083*^9}, {3.975186481658581*^9, 
   3.975186523869499*^9}, {3.975186557291993*^9, 3.975186598287777*^9}, {
   3.9751867212544107`*^9, 3.9751868361873503`*^9}, {3.9751868702450438`*^9, 
   3.975186918879197*^9}, 3.975187383155944*^9, {3.975187474714205*^9, 
   3.975187559493368*^9}, {3.975187877891349*^9, 3.975188018394823*^9}, {
   3.975188095613347*^9, 
   3.9751881285446577`*^9}},ExpressionUUID->"ce8a392f-bf1b-476d-91c0-\
c5b703154501"],

Cell[TextData[{
 "Just as we required invariance under ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "\[RightArrow]", "\[Tau]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3a3f56fb-bc08-43bd-b804-edf504c41755"],
 " for a particle, we require field theories to be invariant under other \
kinds of gauge transformations, e.g., under local phase shifts ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Phi]", "(", "x", ")"}], "\[RightArrow]", 
    RowBox[{
     SuperscriptBox["e", 
      RowBox[{"i", "\[VeryThinSpace]", 
       RowBox[{"\[Alpha]", "(", "x", ")"}]}]], 
     RowBox[{"\[Phi]", "(", "x", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f1924d4e-1b31-41ad-afe0-e46f316cb9a9"],
 ", where ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "54826f77-33b7-4d2b-87a9-1c6f09e943dc"],
 " varies smoothly with ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "831569fe-892f-446b-9ec4-b2f432c01863"],
 "."
}], "Text",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 3.975185960766884*^9}, {
   3.975186335204997*^9, 3.975186378447083*^9}, {3.975186481658581*^9, 
