   3.975188095613347*^9, 3.975188237850584*^9}, {3.975188286699457*^9, 
   3.975188305919156*^9}, {3.9751885409014177`*^9, 3.975188554054904*^9}, {
   3.975260703434181*^9, 
   3.975260725332922*^9}},ExpressionUUID->"156aff5b-f2f9-424a-86bd-\
9f19dc76b470"],

