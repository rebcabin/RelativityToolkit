Cell[CellGroupData[{

Cell["Index Notation", "Section",
 CellChangeTimes->{{3.9748324609640636`*^9, 3.9748324708127613`*^9}, 
   3.9751108159611053`*^9, {3.9751108771635637`*^9, 
   3.9751108801347017`*^9}},ExpressionUUID->"0a73d79f-7123-43b2-8077-\
35b08b2b5f53"],

Cell[TextData[{
 "This book uses the old-fashioned index notation typified by ",
 ButtonBox["Lovelock and Rund",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://a.co/d/8OvgqjF"], None},
  ButtonNote->"https://a.co/d/8OvgqjF"],
 " (L&R). It is written entirely in terms of transformation rules between \
coordinate systems. This is refreshingly concrete for the physicist concerned \
with calculation. After all, we must have numbers and arrays to do \
calculations. The downside of this ancient notation is that it\
\[CloseCurlyQuote]s no help in understanding contemporary literature. We can\
\[CloseCurlyQuote]t have our cake\[LongDash]coordinate-free notation for \
concise theorizing\[LongDash]and eat it, too\[LongDash]concrete coordinates \
for practical calculation. I\[CloseCurlyQuote]ll occasionally make \
parenthetical remarks about this tension, but the meat of this notebook is in \
L&R\[CloseCurlyQuote]s concrete notation."
}], "Text",
 CellChangeTimes->{{3.974839618834619*^9, 3.974839847057732*^9}, {
   3.9748398832218657`*^9, 3.97483991370277*^9}, {3.9748399448411694`*^9, 
   3.9748400104929323`*^9}, {3.974841227958062*^9, 3.974841240415347*^9}, 
   3.9749040289687757`*^9, {3.97490406481439*^9, 3.974904120890194*^9}, {
   3.9749059539953127`*^9, 3.9749063228927917`*^9}, {3.974906388654292*^9, 
   3.9749064037789392`*^9}, {3.974930653765031*^9, 3.9749308555301523`*^9}, {
   3.97493099093827*^9, 3.9749309911892223`*^9}, {3.9749331114516*^9, 
   3.974933166035701*^9}, {3.9749787830005074`*^9, 3.974978934890757*^9}, {
   3.974979462434782*^9, 3.974979462926145*^9}, {3.974979493095418*^9, 
   3.974979568492087*^9}, {3.975110819308917*^9, 3.975110850306181*^9}, {
   3.975110904328146*^9, 3.975110936527875*^9}, {3.97516809060752*^9, 
   3.975168092675219*^9}, {3.9751901735923157`*^9, 3.9751901766021147`*^9}, {
   3.975255725855509*^9, 3.975255830446087*^9}, {3.975261888607041*^9, 
   3.975261903322728*^9}, {3.975262521448887*^9, 
   3.975262525240299*^9}},ExpressionUUID->"4902c4d8-1d56-4294-b07e-\
45dc31a0fcda"],

Cell[CellGroupData[{

Cell["Ambiguity Warning", "Subsection",
 CellChangeTimes->{{3.9751901943977947`*^9, 
  3.9751902065494823`*^9}},ExpressionUUID->"15c2f609-c97b-4276-894d-\
a5115e5cd7bd"],

Cell[TextData[{
 "When \[Zeta] is a function of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "853e8f01-f14c-410c-b1b4-edb6080dc57e"],
 " and ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "b038978e-ad43-42ed-ac29-62ad1b535059"],
 ", physicists and mathematicians sometimes write ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Zeta]", "(", 
    RowBox[{"x", ",", "t"}], ")"}], TraditionalForm]],ExpressionUUID->
  "63c5c69e-bfe7-4fd8-9834-6b2230fbd7a0"],
 ". This notation is ambiguous because it also means the value of the \
function \[Zeta] given specific coordinates ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "841b62c5-dbdc-4d15-9394-a0280b981211"],
 " and ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "4aa26fbc-59ba-4cca-9e10-1e25e0052988"],
 ". We must tolerate this ambiguity in prose, and be very careful about it in \
code."
}], "Text",
 CellChangeTimes->{
  3.975190179495459*^9, {3.975190219222417*^9, 3.975190259536665*^9}, {
   3.9752558424369392`*^9, 3.975255855445669*^9}, {3.97526191325861*^9, 
   3.975261932529982*^9}},ExpressionUUID->"053ecf35-a4b8-4ea4-b4ce-\
6f55a93f1f82"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Points, Coordinates, States", "Section",
 CellChangeTimes->{{3.974904240322937*^9, 3.974904242415524*^9}, {
  3.974933273551091*^9, 3.974933277081917*^9}, {3.975256179823041*^9, 
  3.975256184895363*^9}},ExpressionUUID->"92bd511c-95a9-47ce-865f-\
10e6da17c626"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "n"], TraditionalForm]],ExpressionUUID->
  "5f2afc3c-dcd9-4644-a445-50484fce0a68"],
 " be an ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "7a33cc56-c17d-444d-b497-2c3a44b9c21a"],
 "\[NoBreak]-\[NoBreak]dimensional ",
 StyleBox["differentiable manifold",
  FontSlant->"Italic"],
 ". Informally, it is a space of abstract points ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "eb8673f2-6a78-4f58-a780-79b855ba1aa4"],
 " with Euclidean tangent spaces ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "p"], 
    SubscriptBox["X", "n"]}], TraditionalForm]],ExpressionUUID->
  "2df3ce01-b93b-47a4-ac0e-d4bdd86c395e"],
 " at each point, where vectors live, and corresponding ",
 StyleBox["dual",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " co-tangent spaces ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["T", "p", "\[Star]"], 
    SubscriptBox["X", "n"]}], TraditionalForm]],ExpressionUUID->
  "f0fda0e1-5fff-42ca-b92b-18451341ceb3"],
 ", where ",
 StyleBox["covectors",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " live. "
}], "Text",
 CellChangeTimes->{{3.974837542112522*^9, 3.974837669758956*^9}, {
   3.974837717627746*^9, 3.9748378830901957`*^9}, {3.9749036870320168`*^9, 
   3.974903689932686*^9}, {3.974903834988432*^9, 3.974903834988982*^9}, {
   3.9749040271630096`*^9, 3.97490403598552*^9}, {3.9749042655442247`*^9, 
   3.974904267928896*^9}, {3.974904331539605*^9, 3.974904356613131*^9}, {
   3.974905913432619*^9, 3.974905940127597*^9}, {3.974906343240944*^9, 
   3.974906351606468*^9}, {3.974906654652265*^9, 3.974906743718772*^9}, {
   3.974930874422373*^9, 3.974930892713695*^9}, {3.974933184356382*^9, 
   3.974933247052518*^9}, {3.9749791619514847`*^9, 3.97497917937989*^9}, {
   3.974979586615979*^9, 3.974979588528131*^9}, 3.975181810364642*^9, {
   3.9752558724882812`*^9, 3.975255908750761*^9}, {3.9752559918892937`*^9, 
   3.975255994457152*^9}, {3.975256170359642*^9, 3.9752561736079187`*^9}, {
   3.9752619570355787`*^9, 
   3.975261974135612*^9}},ExpressionUUID->"f02d08a6-ddee-4a2f-a2c3-\
12354905a14f"],

Cell[TextData[StyleBox["We elaborate and motivate the terms \
\[OpenCurlyDoubleQuote]vector\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]covector\[CloseCurlyDoubleQuote] below.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.974980120373328*^9, 3.974980155210205*^9}, {
  3.9750890710111732`*^9, 3.9750890720240993`*^9}, {3.975168447483603*^9, 
