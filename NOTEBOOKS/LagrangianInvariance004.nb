Cell["\<\
We also get, trivially, by the definition of partial derivative,\
\>", "Text",
 CellChangeTimes->{{3.9749352220712233`*^9, 3.9749352262566833`*^9}, {
  3.9749808782714863`*^9, 3.974980879951133*^9}, {3.9752572688266172`*^9, 
  3.9752572851762733`*^9}},ExpressionUUID->"ea1cf005-8bda-472a-8cea-\
cefe7d01eaae"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox[
        OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"]}]], "=", 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "h"]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "_"], "j"]}]]}],
   Background->RGBColor[1, 1, 0]], TraditionalForm]], "DisplayFormulaNumbered",\

 CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
