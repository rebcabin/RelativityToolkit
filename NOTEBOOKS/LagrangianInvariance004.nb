Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[EmptySquare]", "+", 
          SuperscriptBox["m", "2"]}], ")"}], "\[VerticalSeparator]", 
        "\[Psi]"}], " ", "\[RightAngleBracket]"}], " ", "\[Congruent]", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         SuperscriptBox["\[PartialD]", "2"], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["t", "2"]}]], 
        RowBox[{"-", 
         SuperscriptBox["\[Del]", "2"]}]}], ")"}]}], "\[VerticalSeparator]", 
     "\[Psi]"}], " ", "\[RightAngleBracket]"}], "=", "0", " "}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.975187743771097*^9, 3.97518775885868*^9}, {
  3.9751878097237787`*^9, 3.9751878653938427`*^9}, {3.975188383061019*^9, 
  3.975188458325492*^9}},ExpressionUUID->"02dfb12b-747e-4249-b782-\
a0aba411141e"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"c", "=", "1"}], ",", " ", 
    RowBox[{"\[HBar]", "=", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0b9a2d57-7073-4d8e-b0ba-ce700c3c8115"],
 " everywhere. The \[OpenCurlyDoubleQuote]unsolvability\
\[CloseCurlyDoubleQuote] of the non-quantum momenta gives birth to one of the \
wave equations of relativistic quantum mechanics. "
}], "Text",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 3.975185960766884*^9}, {
