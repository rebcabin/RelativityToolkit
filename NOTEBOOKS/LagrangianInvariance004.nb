Cell[CellGroupData[{

Cell["Coordinate Invariance of the Action", "Section",
 CellChangeTimes->{{3.97493524336943*^9, 3.9749352473554373`*^9}, {
  3.9749824155311604`*^9, 
  3.974982418741001*^9}},ExpressionUUID->"251ed51c-182e-48be-a2f5-\
f9c0281e55a5"],

Cell[TextData[{
 "For the action integral, Equation ",
 
 CounterBox["DisplayFormulaNumbered", "LOVELOCK ACTION INTEGRAL"],
 ", to be invariant with respect to coordinate transformations, it ",
 StyleBox["suffices",
  FontWeight->"Bold"],
 " to have"
}], "Text",
 CellChangeTimes->{{3.9748418905835953`*^9, 3.974841938844995*^9}, {
  3.974842082768436*^9, 3.974842094690179*^9}, {3.9748422605883503`*^9, 
  3.974842266121037*^9}, {3.974843952964323*^9, 3.974843971029723*^9}, {
  3.974844211743681*^9, 3.974844260924436*^9}, {3.9749809451076193`*^9, 
  3.974980952506074*^9}, {3.975182556376075*^9, 
  3.975182561820051*^9}},ExpressionUUID->"9bbb171a-08f2-4d4e-be16-\
f49f7ccdbb76"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["L", "_"], 
    RowBox[{"(", 
     RowBox[{"t", ",", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["x", "_"], "j"], 
       RowBox[{"(", "t", ")"}]}], ",", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox[
         OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"], 
       RowBox[{"(", "t", ")"}]}]}], ")"}]}], "=", 
   RowBox[{"L", 
    RowBox[{"(", 
     RowBox[{"t", ",", 
      RowBox[{
       SuperscriptBox["x", "h"], 
       RowBox[{"(", 
        SuperscriptBox[
         OverscriptBox["x", "_"], "j"], ")"}]}], ",", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["x", "\[FilledSmallCircle]"], "h"], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          OverscriptBox["x", "_"], "j"], ",", 
         SuperscriptBox[
          OverscriptBox[
           OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"]}], 
        ")"}]}]}], ")"}]}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974842016965528*^9, 3.974842077163102*^9}, {
  3.974842108001051*^9, 3.974842131478362*^9}, {3.9748421766836643`*^9, 
  3.974842191314451*^9}, {3.974842462468707*^9, 3.97484246247016*^9}},
 CellTags->
  "COORDINATE \
INVARIANCE",ExpressionUUID->"353c9db4-b104-44a4-9bcd-bf5a1e3d284e"],

Cell[TextData[{
 "with the ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "7f6721da-15b7-46d4-b1eb-e43ca2130227"],
 " indices varying independently, e.g., ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "h"], TraditionalForm]],
  ExpressionUUID->"8712f480-b1c2-4870-b337-bdc22eb2f92d"],
 " depends on all the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "_"], "j"], TraditionalForm]],ExpressionUUID->
  "b3b74320-24d1-4cdd-9a84-afc5749f2d37"],
 " and on all the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox[
     OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"], 
   TraditionalForm]],ExpressionUUID->"18d7dfa5-4891-4a96-8d66-787418434bce"],
 ", not just in matched pairs. "
}], "Text",
 CellChangeTimes->{{3.974842320104672*^9, 3.974842435895337*^9}, {
   3.9748424868817863`*^9, 3.974842499212853*^9}, {3.9748425439585857`*^9, 
   3.9748425597004766`*^9}, 3.974933787382159*^9, 3.9749829872514133`*^9, {
