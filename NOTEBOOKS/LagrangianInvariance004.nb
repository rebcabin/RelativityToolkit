  3.975181796360918*^9}},ExpressionUUID->"2d4bc21f-52ad-4ace-aa19-\
962519b0b8e7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "p"], 
    SubscriptBox["X", "n"]}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "356b13a2-c1a5-407f-ac4f-4462448b8b57"],
 StyleBox[", and ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["T", "p", "\[Star]"], 
    SubscriptBox["X", "n"]}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "52ce8cb6-a57b-455f-b8e2-0f3d0d504ba5"],
 StyleBox[" are indivisible notations, not some kind of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["T", TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "40f12e30-69e4-4a85-9b41-cf236dba3385"],
 StyleBox[" multiplying ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["X", TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "933c10cb-523d-41f1-a1b3-3b13e1998ade"],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.97490678309162*^9, 3.9749068732510157`*^9}, 
   3.9749309005346937`*^9, {3.974979191975546*^9, 3.974979192968198*^9}, {
   3.975168258403563*^9, 3.975168262143156*^9}, {3.975255925567621*^9, 
   3.975255926764538*^9}},ExpressionUUID->"d775c1e7-e85c-4912-86b0-\
42badfb6460e"],

Cell[TextData[{
 StyleBox["These definitions are just touch points. L&R avoid such \
abstractions and their steep learning curves. Find those in any book on \
modern differential geometry, such as ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Chris Isham\[CloseCurlyQuote]s book",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://a.co/d/htWKAMo"], None},
  ButtonNote->"https://a.co/d/htWKAMo"],
  FontSlant->"Italic"],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.974978990235663*^9, 3.974979143197933*^9}, {
  3.974979202954224*^9, 3.974979223203752*^9}, {3.975086655525642*^9, 
  3.97508665830626*^9}, {3.975181710637474*^9, 3.975181712096734*^9}, {
  3.975255933715261*^9, 
  3.9752559769232607`*^9}},ExpressionUUID->"21e3faba-647f-4b6b-a15e-\
a80ba01c5660"],

Cell[TextData[{
 "Let the coordinates of points along some parametric curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "46a8ba71-e683-4219-bf4a-8fa8ab1d2c42"],
 " in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "n"], TraditionalForm]],ExpressionUUID->
  "84dae85d-726b-4df3-af86-c4fa327bc539"],
 " be values of similarly-named (eponymous) coordinate functions:"
}], "Text",
 CellChangeTimes->{{3.97483790516743*^9, 3.974837972116292*^9}, {
  3.9748380769007483`*^9, 3.974838079861988*^9}, {3.974905673465012*^9, 
  3.974905742305728*^9}, {3.975111200877014*^9, 3.975111207456997*^9}, {
  3.975168284991645*^9, 3.975168302777493*^9}, {3.9751818707705507`*^9, 
  3.975181872816866*^9}},ExpressionUUID->"108663ef-5871-49d9-adef-\
080b95437ca1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "j"], 
     StyleBox["(",
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox["coordinate",
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox[")",
      FontColor->RGBColor[1, 0, 0]]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["x", "j"], "(", "t", ")"}], 
     StyleBox[
      RowBox[{"(", 
       RowBox[{"value", " ", "of", " ", "function", " ", 
        SuperscriptBox[
         StyleBox["x",
          FontColor->RGBColor[1, 0, 0]], "j"], " ", "at", " ", "t"}], ")"}],
      FontColor->RGBColor[1, 0, 0]]}]}], ",", " ", 
   RowBox[{"j", "\[Element]", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2", ",", " ", "\[Ellipsis]", ",", " ", "n"}], 
     "}"}]}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9748379856087112`*^9, 3.974838037286685*^9}, {
  3.974903895935947*^9, 3.9749039120173063`*^9}, {3.9749796475618887`*^9, 
  3.9749796928674097`*^9}, {3.974979724419239*^9, 3.9749797537665663`*^9}},
 CellTags->
  "COORDINATE \
FUNCTIONS",ExpressionUUID->"a2bbd4cc-1bee-4a22-8e8e-6531248db4ab"],

Cell[TextData[{
 "with \[OpenCurlyDoubleQuote]up\[CloseCurlyDoubleQuote] indices, and \
parameter ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "57e9507c-0a53-4ab8-a804-18f7e7c66c02"],
 ", initially Newtonian time. This dual meaning of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b3e5da5d-d7fc-4ac3-b1f8-1f37e14f14ed"],
 " is another notational ambiguity we must tolerate in prose and be careful \
with in code."
}], "Text",
 CellChangeTimes->{{3.974838044954418*^9, 3.974838070730803*^9}, {
  3.9748381049329653`*^9, 3.974838108630205*^9}, {3.974838477406354*^9, 
