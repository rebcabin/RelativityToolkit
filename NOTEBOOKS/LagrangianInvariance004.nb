Cell["This is shorthand for", "Text",
 CellChangeTimes->{{3.974982946765439*^9, 3.974982949582876*^9}, {
  3.974982994713834*^9, 
  3.974982995836152*^9}},ExpressionUUID->"3659ba78-0dc1-4d15-9135-\
a1a0c5c2cda1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["L", "_"], 
    RowBox[{"(", 
     RowBox[{"t", ",", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["x", "_"], "j"], 
       RowBox[{"(", "t", ")"}]}], ",", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox[
         OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"], 
       RowBox[{"(", "t", ")"}]}]}], ")"}]}], "=", 
   RowBox[{"L", 
    RowBox[{"(", 
     RowBox[{"t", ",", 
      RowBox[{
       SuperscriptBox["x", "h"], "(", 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["x", "_"], "j"], "(", "t", ")"}], ")"}], ",", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["x", "\[FilledSmallCircle]"], "h"], "(", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          OverscriptBox["x", "_"], "j"], "(", "t", ")"}], ",", 
        RowBox[{
         SuperscriptBox[
          OverscriptBox[
           OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"], "(", "t", 
         ")"}]}], ")"}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974842016965528*^9, 3.974842077163102*^9}, {
  3.974842108001051*^9, 3.974842131478362*^9}, {3.9748421766836643`*^9, 
  3.974842191314451*^9}, {3.974842462468707*^9, 3.97484246247016*^9}, {
  3.974982961152401*^9, 
  3.974982972522006*^9}},ExpressionUUID->"759cdafe-4039-490f-93c3-\
135c89bb084d"],

Cell[TextData[{
 "We leave the parameter ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "58e62368-ec2f-4b65-941b-612c5cdae6e1"],
 " alone for now."
}], "Text",
 CellChangeTimes->{{3.974842320104672*^9, 3.974842435895337*^9}, {
  3.9748424868817863`*^9, 3.974842499212853*^9}, {3.9748425439585857`*^9, 
