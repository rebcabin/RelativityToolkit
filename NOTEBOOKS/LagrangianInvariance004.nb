  3.975262033495488*^9}},ExpressionUUID->"b0b2e6d5-7944-4027-8310-\
0831111ea242"],

Cell[TextData[{
 "A curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "d235502a-af1a-4d7a-bfe7-a5293e5d8364"],
 " of points in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "n"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a18069b2-7c4b-462d-80c3-5d93d28474a2"],
 " represents a ",
 StyleBox["mathematically",
  FontSlant->"Italic"],
 " possible path\[LongDash]a continuous sequence of coordinate values ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "j"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7fbf5662-e0a5-4653-b89c-76f09b4615a9"],
 "\[LongDash]taken by a physical system as it evolves in time. A ",
 StyleBox["physically",
  FontSlant->"Italic"],
 " possible path is one such, often the one with ",
 StyleBox["least action",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", but this notebook doesn\[CloseCurlyQuote]t go deeply into this fact. "
}], "Text",
 CellChangeTimes->{{3.974904280138928*^9, 3.974904313497868*^9}, {
  3.9749043946351624`*^9, 3.9749043956039457`*^9}, {3.974905778070882*^9, 
  3.974905849287966*^9}, {3.974907599044756*^9, 3.974907708134343*^9}, {
  3.974933310857552*^9, 3.974933346312708*^9}, {3.97497977442906*^9, 
  3.9749798227232*^9}, {3.9751683121239643`*^9, 3.9751683146601*^9}, {
  3.975181946588151*^9, 3.975181973705731*^9}, {3.975256062230299*^9, 
  3.97525609007542*^9}, {3.975256273652524*^9, 3.97525633852918*^9}, {
  3.9752620712739477`*^9, 
  3.975262184530375*^9}},ExpressionUUID->"e983b4f7-7fa8-434d-9723-\
1108bfc75e67"],

Cell[TextData[{
 "The manifold ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "n"], TraditionalForm]],ExpressionUUID->
  "a6201e39-7763-417c-841b-7594ed34205c"],
 " represents the physical configuration of the system itself. The particular \
coordinate functions ",
 Cell[BoxData[
  FormBox[Cell[TextData[Cell[BoxData[
    FormBox[
     RowBox[{
      SuperscriptBox["x", "j"], "(", "t", ")"}], TraditionalForm]],
    ExpressionUUID->"73697b95-6437-4a0d-b633-53db522d9e7d"]],ExpressionUUID->
    "4f560788-2d41-4382-a6ef-3fc413aad770"], TraditionalForm]],ExpressionUUID->
  "d51f62ea-0b4f-4d1f-898f-ee823fd486d3"],
 " depend on a choice of generalized coordinates in the Lagrangian language. \
"
}], "Text",
 CellChangeTimes->{{3.974904280138928*^9, 3.974904313497868*^9}, {
  3.9749043946351624`*^9, 3.9749043956039457`*^9}, {3.974905778070882*^9, 
  3.974905849287966*^9}, {3.974907599044756*^9, 3.974907708134343*^9}, {
  3.974933310857552*^9, 3.974933346312708*^9}, {3.97497977442906*^9, 
  3.9749798227232*^9}, {3.9751683121239643`*^9, 3.9751683146601*^9}, {
  3.975181946588151*^9, 3.975181973705731*^9}, {3.975256062230299*^9, 
  3.97525609007542*^9}, {3.975256273652524*^9, 3.97525633852918*^9}, {
  3.9752620712739477`*^9, 
  3.975262165254484*^9}},ExpressionUUID->"0bafcb01-b059-45a9-aede-\
9e895a3f7bc5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Derivatives along a Curve", "Section",
 CellChangeTimes->{{3.974904421799736*^9, 3.974904423973572*^9}, {
  3.974936276678906*^9, 
  3.974936281633833*^9}},ExpressionUUID->"d1885921-daeb-43fc-af1d-\
d6894eeb9684"],

Cell[TextData[{
 "Such curves must be twice-differentiable with respect to ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0634a4d6-798f-438c-b695-64156e18cf7b"],
 ", with first derivatives"
}], "Text",
 CellChangeTimes->{{3.974838112109644*^9, 3.974838139250259*^9}, {
  3.975256214642703*^9, 
  3.975256219421398*^9}},ExpressionUUID->"8fa1bb4b-b184-4712-8656-\
08cbc5acd478"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "j"], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"d", "\[VeryThinSpace]", 
      SuperscriptBox["x", "j"]}], 
     RowBox[{"d", "\[VeryThinSpace]", "t"}]], "\[Congruent]", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], "j"], 
     RowBox[{"(", "t", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9748383875167294`*^9, 3.974838465130704*^9}, {
  3.9748385427447767`*^9, 3.974838591191772*^9}},
 CellTags->
  "VELOCITY-VECTOR \
COMPONENTS",ExpressionUUID->"b504d4c7-581e-4942-9d08-4b31ffcbb0bc"],

Cell[TextData[{
 "These are components of ",
 StyleBox["contravariant velocity vector",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (with \[OpenCurlyDoubleQuote]up\[CloseCurlyDoubleQuote] indices) along the \
curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "505443bb-83bf-4e64-98be-1ed374f92cd3"],
 ". At each point ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", 
    RowBox[{"x", "(", "t", ")"}]}], TraditionalForm]],ExpressionUUID->
  "cbb7655b-504d-48e2-b6d5-ca8d37fb798d"],
 " along the curve (",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "11e316f3-037a-4024-8f63-8a582cae2894"],
 " denoting the sequence ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["x", "1"], ",", 
     SuperscriptBox["x", "2"], ",", "\[Ellipsis]", ",", 
     SuperscriptBox["x", "n"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "cacb50ff-0f77-4ec0-8cdb-2ed6e4bae313"],
 ") the velocity vector lives in the tangent space ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", 
     RowBox[{"p", "=", 
      RowBox[{"x", "(", "t", ")"}]}]], 
    SubscriptBox["X", "n"]}], TraditionalForm]],ExpressionUUID->
  "5fe0eec2-a593-4cab-a59d-a53c7b9e9c2d"],
 " attached to the point ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "d90d89c1-c10b-40c7-a883-0f08a17decb1"],
 "."
}], "Text",
 CellChangeTimes->{{3.9749056500699778`*^9, 3.974905666243074*^9}, {
   3.974905859182604*^9, 3.974905902376247*^9}, {3.9749064463208027`*^9, 
   3.974906458777169*^9}, {3.974908669333376*^9, 3.974908735469482*^9}, {
   3.974931055013707*^9, 3.97493113497935*^9}, 3.974931329574273*^9, {
   3.974933367686323*^9, 3.9749334056441183`*^9}, {3.974937093716061*^9, 
   3.974937148495392*^9}, {3.97497985202355*^9, 
   3.974979877890167*^9}},ExpressionUUID->"9f4304d0-6e05-428b-8985-\
fde39e01cddf"],

Cell[TextData[{
 StyleBox["In some presentations, velocity vectors are directional-derivative \
operators in a ",
  FontSlant->"Italic"],
 StyleBox["covariant operator basis",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" (with \[OpenCurlyDoubleQuote]down\[CloseCurlyDoubleQuote] \
indices): ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "\[Congruent]", 
    RowBox[{
     SuperscriptBox["v", "j"], 
     SubscriptBox["\[PartialD]", "j"]}], "\[Congruent]", 
    RowBox[{
     SuperscriptBox["v", "j"], 
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "j"]}]]}], "\[Congruent]", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], "j"], 
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "j"]}]]}]}], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"7469fd23-a21b-4072-914c-d43d17b8262b"],
 StyleBox[" via the ",
  FontSlant->"Italic"],
 StyleBox["summation convention",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" (sum over repeated \[OpenCurlyDoubleQuote]up-down\
\[CloseCurlyDoubleQuote] pairs of indices in product expressions or in \
tensorial expressions). Mentally distinguish the vector, a geometric object \
in the tangent space, from its components in some basis. We are free to \
choose bases however we like, even something as exotic as a derivative \
operator.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.974904469655386*^9, 3.974904491556582*^9}, {
   3.9749055967475224`*^9, 3.974905641833653*^9}, {3.974906467836877*^9, 
   3.9749065969107323`*^9}, {3.974906933349362*^9, 3.9749070252455063`*^9}, {
   3.974907255414914*^9, 3.9749073886843643`*^9}, {3.974907460411456*^9, 
   3.974907562227539*^9}, {3.9749077563759327`*^9, 3.9749078183175077`*^9}, {
   3.974907863298753*^9, 3.974908084130295*^9}, {3.9749081349860687`*^9, 
   3.974908179957054*^9}, {3.974908253977799*^9, 3.9749083702082872`*^9}, {
   3.9749084125539494`*^9, 3.974908490159955*^9}, {3.9749085343402567`*^9, 
   3.974908633607006*^9}, 3.974908758127057*^9, {3.9749303248931713`*^9, 
   3.974930327459682*^9}, {3.9749304329040737`*^9, 3.9749304861911097`*^9}, {
   3.974930529532589*^9, 3.974930543906859*^9}, {3.974933460301779*^9, 
   3.974933518876926*^9}, {3.9749798856491823`*^9, 3.974979899231785*^9}, {
   3.9749799316498613`*^9, 3.974979987731468*^9}, {3.974980075453381*^9, 
   3.974980084868751*^9}, {3.975088997820592*^9, 3.9750890304665337`*^9}, {
   3.975089081352767*^9, 3.975089111569057*^9}, {3.975182084164732*^9, 
   3.975182106356835*^9}, {3.975182158051689*^9, 3.9751821615174427`*^9}, {
   3.975183285253456*^9, 3.9751832852545633`*^9}, {3.9752563908316603`*^9, 
   3.9752563943324013`*^9}, {3.975284171893675*^9, 3.9752842905654907`*^9}, {
   3.9752843257106743`*^9, 
   3.975284360907634*^9}},ExpressionUUID->"c9a468c9-111a-4e45-a95c-\
b4b941641b58"],

Cell[TextData[StyleBox["We elaborate on the terms \
\[OpenCurlyDoubleQuote]contravariant\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]covariant\[CloseCurlyDoubleQuote] below under the \
coordinate-transformation section.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.974980120373328*^9, 3.974980155210205*^9}, {
  3.9750890710111732`*^9, 3.9750890720240993`*^9}, {3.975168447483603*^9, 
  3.975168457711583*^9}, {3.975262257562949*^9, 
  3.9752622616710043`*^9}},ExpressionUUID->"c956a3ac-fcac-4dd5-ae34-\
d421d4d13fd3"],

Cell[TextData[{
 StyleBox["The summation convention is also called ",
  FontSlant->"Italic"],
 StyleBox["contraction",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.974904469655386*^9, 3.974904491556582*^9}, {
   3.9749055967475224`*^9, 3.974905641833653*^9}, {3.974906467836877*^9, 
   3.9749065969107323`*^9}, {3.974906933349362*^9, 3.9749070252455063`*^9}, {
   3.974907255414914*^9, 3.9749073886843643`*^9}, {3.974907460411456*^9, 
   3.974907562227539*^9}, {3.9749077563759327`*^9, 3.9749078183175077`*^9}, {
   3.974907863298753*^9, 3.974908084130295*^9}, {3.9749081349860687`*^9, 
   3.974908179957054*^9}, {3.974908253977799*^9, 3.9749083702082872`*^9}, {
   3.9749084125539494`*^9, 3.974908490159955*^9}, {3.9749085343402567`*^9, 
   3.974908633607006*^9}, 3.974908758127057*^9, {3.9749303248931713`*^9, 
   3.974930327459682*^9}, {3.9749304329040737`*^9, 3.9749304861911097`*^9}, {
   3.974930529532589*^9, 3.974930543906859*^9}, {3.974933460301779*^9, 
   3.974933518876926*^9}, {3.9749798856491823`*^9, 3.974979899231785*^9}, {
   3.9749799316498613`*^9, 3.974979987731468*^9}, {3.974980075453381*^9, 
   3.974980084868751*^9}, {3.975088997820592*^9, 3.9750890304665337`*^9}, {
   3.975089081352767*^9, 3.975089111569057*^9}, {3.975182084164732*^9, 
   3.975182106356835*^9}, {3.975182158051689*^9, 3.9751821615174427`*^9}, {
   3.9751832866212606`*^9, 
   3.97518330490269*^9}},ExpressionUUID->"dbf8ef24-12f9-42a4-b9a4-\
79a519e5ac24"],

Cell[TextData[{
 StyleBox["The components ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox["x", "\[FilledSmallCircle]"], "j"], "(", "t", ")"}], 
   TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"699c2763-ef97-428a-9ecd-b8cfcb58be13"],
 " ",
 StyleBox["of velocities along the curve ",
  FontSlant->"Italic"],
 StyleBox["are the result of applying such directional derivative operators \
to the coordinate functions ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["v", "i"], "\[Congruent]", 
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], "i"]}], "=", 
    RowBox[{
     RowBox[{"v", "[", 
      SuperscriptBox["x", "i"], "]"}], "=", 
     RowBox[{
      RowBox[{
       SuperscriptBox["v", "j"], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", "i"]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", "j"]}]]}], "=", 
      RowBox[{
       SuperscriptBox["v", "j"], 
       SubsuperscriptBox["\[Delta]", "j", "i"]}]}]}]}], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"931cd80b-d0bf-489e-be33-c007fc5e70a4"],
 StyleBox[". In traditional notation, one would write ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["v", "1"], ",", 
       SuperscriptBox["v", "2"], ",", "\[Ellipsis]", ",", 
       SuperscriptBox["v", "n"]}], ")"}], "\[FilledSmallCircle]", 
     "\[Del]"}]}], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"8d7a5fc5-e6d1-4a1d-9081-7d704173a8ae"],
 StyleBox[", a dot product of numerical components with a gradient operator. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.974904469655386*^9, 3.974904491556582*^9}, {
   3.9749055967475224`*^9, 3.974905641833653*^9}, {3.974906467836877*^9, 
   3.9749065969107323`*^9}, {3.974906933349362*^9, 3.9749070252455063`*^9}, {
   3.974907255414914*^9, 3.9749073886843643`*^9}, {3.974907460411456*^9, 
   3.974907562227539*^9}, {3.9749077563759327`*^9, 3.9749078183175077`*^9}, {
   3.974907863298753*^9, 3.974908084130295*^9}, {3.9749081349860687`*^9, 
   3.974908179957054*^9}, {3.974908253977799*^9, 3.9749083702082872`*^9}, {
   3.9749084125539494`*^9, 3.974908490159955*^9}, {3.9749085343402567`*^9, 
   3.974908633607006*^9}, 3.974908758127057*^9, {3.9749303248931713`*^9, 
   3.974930327459682*^9}, {3.9749304329040737`*^9, 3.9749304861911097`*^9}, {
   3.974930529532589*^9, 3.974930543906859*^9}, {3.974933460301779*^9, 
   3.974933518876926*^9}, {3.9749798856491823`*^9, 3.974979899231785*^9}, {
   3.9749799316498613`*^9, 3.974979987731468*^9}, {3.974980075453381*^9, 
   3.974980084868751*^9}, {3.975088997820592*^9, 3.975089018572508*^9}, {
   3.975182037808364*^9, 3.975182056016852*^9}, {3.975256409643667*^9, 
   3.975256425011092*^9}},ExpressionUUID->"c4d97e3e-5313-4af7-8888-\
73749497d907"],

Cell[TextData[StyleBox["These derivative operators should remind you of \
momentum operators in quantum mechanics. ",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.974904469655386*^9, 3.974904491556582*^9}, {
   3.9749055967475224`*^9, 3.974905641833653*^9}, {3.974906467836877*^9, 
   3.9749065969107323`*^9}, {3.974906933349362*^9, 3.9749070252455063`*^9}, {
   3.974907255414914*^9, 3.9749073886843643`*^9}, {3.974907460411456*^9, 
   3.974907562227539*^9}, {3.9749077563759327`*^9, 3.9749078183175077`*^9}, {
   3.974907863298753*^9, 3.974908084130295*^9}, {3.9749081349860687`*^9, 
   3.974908179957054*^9}, {3.974908253977799*^9, 3.9749083702082872`*^9}, {
   3.9749084125539494`*^9, 3.974908490159955*^9}, {3.9749085343402567`*^9, 
   3.974908633607006*^9}, 3.974908758127057*^9, {3.9749303248931713`*^9, 
   3.974930327459682*^9}, {3.9749304329040737`*^9, 3.9749304861911097`*^9}, {
   3.974930529532589*^9, 3.974930543906859*^9}, {3.974933460301779*^9, 
   3.974933518876926*^9}, {3.9749798856491823`*^9, 3.974979899231785*^9}, {
   3.9749799316498613`*^9, 3.974979987731468*^9}, {3.974980075453381*^9, 
   3.974980084868751*^9}, {3.975088997820592*^9, 
   3.975089033387738*^9}},ExpressionUUID->"ce7247d7-4cf2-41d1-823b-\
bed9dddab29e"],

Cell[TextData[{
 StyleBox["In coordinate-free presentations, tangent vectors are ",
  FontSlant->"Italic"],
 StyleBox["equivalence classes of curves",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[". One abstractly defines addition of equivalence classes and \
multiplication of equivalence classes by scalars to make the equivalence \
classes resemble ordinary vectors as tuples of components.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9749305512744093`*^9, 3.9749306198732224`*^9}, {
  3.975256497815508*^9, 3.975256520687096*^9}, {3.975262310280633*^9, 
  3.975262368642785*^9}},ExpressionUUID->"62fb55f1-2622-4b09-a755-\
573bb2ffddff"],

Cell[TextData[{
 "While the manifold ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "n"], TraditionalForm]],ExpressionUUID->
  "cb20dc73-9ffd-4f57-bf53-d8ea895d5053"],
 "\:200b has ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "339cc74c-dfbe-4b2c-a236-5e7bf925a2dd"],
 " dimensions (",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "13fa0005-ee74-4088-90ec-16935d4609d7"],
 " equals the number of degrees of freedom of the system), the curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", 
    RowBox[{"(", "t", ")"}]}], TraditionalForm]],ExpressionUUID->
  "11bba539-8e84-4739-a776-5b6cff0616ae"],
 " is a 1\[NoBreak]-\[NoBreak]dimensional object. This is why we can describe \
the kinematics and dynamics of a complex system like a steam engine using a \
single parameter ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "33a7a10c-c634-4cd0-a188-3e0dba98ebd1"],
 "."
}], "Text",
 CellChangeTimes->{{3.975111452532542*^9, 3.975111519391663*^9}, {
  3.975168512502253*^9, 3.975168524772029*^9}, {3.975256530757962*^9, 
  3.975256548163916*^9}},ExpressionUUID->"453537c8-cb05-40d5-8045-\
b191e8364469"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Lagrangian and Action", "Section",
 CellChangeTimes->{{3.9749086471514673`*^9, 3.974908650110715*^9}, {
  3.974935319109147*^9, 
  3.974935321249093*^9}},ExpressionUUID->"5be367bf-5c4d-42dc-9d23-\
661960f5c4fb"],

Cell[TextData[{
 "Let the Lagrangian ",
 Cell[BoxData[
  FormBox[
   RowBox[{"L", "(", 
    RowBox[{"t", ",", 
     SuperscriptBox["x", "j"], ",", 
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], "j"]}], ")"}], 
   TraditionalForm]],ExpressionUUID->"81415e58-3f8c-4e9e-9f85-ebbd54a12201"],
 " be a twice-differentiable function of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "n"}], "+", "1"}], TraditionalForm]],ExpressionUUID->
  "530af919-a880-4404-8ec6-b7b32cb4eb73"],
 " independent variables, noting that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "j"], TraditionalForm]],ExpressionUUID->
  "afad396b-fc58-4067-b8bb-27658df9a659"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "j"], TraditionalForm]],
  ExpressionUUID->"7fe3ae35-7f51-44fe-bc24-dc56d276e19e"],
 " may be treated, at will, as variables or functions. "
}], "Text",
 CellChangeTimes->{{3.974838614721426*^9, 3.974838903258356*^9}, {
   3.974839042206265*^9, 3.97483904797799*^9}, {3.974839175607698*^9, 
   3.9748392162876987`*^9}, {3.974903931664954*^9, 3.974903972320333*^9}, {
   3.974931231191711*^9, 3.974931233403346*^9}, {3.974931264147922*^9, 
   3.9749312755832376`*^9}, {3.974980199921876*^9, 3.974980202639127*^9}, 
   3.974982557055214*^9, {3.975086688520455*^9, 3.975086690459981*^9}, 
   3.9751685460463533`*^9, {3.9752626548958797`*^9, 
   3.9752626556347847`*^9}},ExpressionUUID->"08fe17b8-1b09-4119-bc55-\
01f5ced9cc6e"],

Cell[TextData[{
 StyleBox["Treating the arguments of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "16477259-53f6-4f83-969d-2cd2125f40da"],
 StyleBox[" as independent variables is justified because, as variables, they \
just describe kinematically possible states of the system. Dynamical \
evolution takes place along the curve ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "abd9c6fd-f260-4562-b700-5598ec00c830"],
 StyleBox[" where the arguments are functions of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "214ca1f3-6f04-444b-ade2-bd969c83d2f2"],
 "."
}], "Item",
 CellChangeTimes->{{3.975168554684759*^9, 3.9751686089700127`*^9}, {
  3.975182223321261*^9, 3.9751822595833063`*^9}, {3.9751822906257277`*^9, 
  3.975182299677959*^9}, {3.975256573125025*^9, 3.9752566315790977`*^9}, {
  3.9752626119024267`*^9, 
  3.975262638790897*^9}},ExpressionUUID->"db24ed96-a437-45f8-8528-\
72732b644e98"],

Cell[TextData[{
 "Let the ",
 StyleBox["action integral",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " along some curve ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f486ddda-db56-4f5d-a551-e627bdf25119"],
 " be "
}], "Text",
 CellChangeTimes->{{3.974838614721426*^9, 3.974838903258356*^9}, {
   3.974839042206265*^9, 3.97483904797799*^9}, {3.974839175607698*^9, 
   3.9748392162876987`*^9}, {3.974903931664954*^9, 3.974903972320333*^9}, {
   3.974931231191711*^9, 3.974931233403346*^9}, {3.974931264147922*^9, 
   3.9749312755832376`*^9}, {3.974980199921876*^9, 3.974980202639127*^9}, 
   3.974982557055214*^9, {3.975086688520455*^9, 3.975086690459981*^9}, {
   3.975262674455658*^9, 
   3.975262680131866*^9}},ExpressionUUID->"c8349a95-86bc-49a8-a5e9-\
0e5d35d3e886"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"I", 
    RowBox[{"(", "C", ")"}]}], "=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{" ", 
      RowBox[{"t", "=", 
       SubscriptBox["t", "1"]}]}], 
     RowBox[{" ", 
      RowBox[{"t", "=", 
       SubscriptBox["t", "2"]}]}]], 
    RowBox[{"L", 
     RowBox[{"(", 
      RowBox[{"t", ",", 
       RowBox[{
        SuperscriptBox["x", "j"], "(", "t", ")"}], ",", 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["x", "\[FilledSmallCircle]"], "j"], "(", "t", ")"}]}], 
      ")"}], 
     RowBox[{"\[DifferentialD]", "t"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9748392203107758`*^9, 3.974839287340811*^9}, {
  3.974839331461722*^9, 3.974839345068219*^9}, {3.975168624851574*^9, 
  3.975168627482049*^9}},
 CellTags->
  "LOVELOCK ACTION \
INTEGRAL",ExpressionUUID->"30f39fd3-1e5d-4569-a9f6-59eab053c270"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "j"], "(", "t", ")"}], TraditionalForm]],
  ExpressionUUID->"af783989-c59f-44ba-aed1-7b129bb25e44"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox["x", "\[FilledSmallCircle]"], "j"], "(", "t", ")"}], 
   TraditionalForm]],ExpressionUUID->"8ab61ebc-1d78-4f76-87f8-515f6e11b3b4"],
 " here denoting the values of functions ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "j"], TraditionalForm]],ExpressionUUID->
  "7949d8aa-4115-4da0-9a10-2c86db77afe0"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "j"], TraditionalForm]],
  ExpressionUUID->"cc6fb582-0f8b-4bc1-9072-3f7c16d15e3e"],
 " at parameter values ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "a912c67d-2c6f-447d-a58e-4393dbd749e8"],
 " along some curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "e6caf0c9-a002-4ab2-b460-e41160d750b5"],
 ".  "
}], "Text",
 CellChangeTimes->{{3.9748393711473637`*^9, 3.974839425463805*^9}, {
   3.974839557997168*^9, 3.974839592896125*^9}, {3.9752566712223787`*^9, 
   3.975256681084755*^9}, 
   3.975262696185817*^9},ExpressionUUID->"6ebf7e5d-9032-4936-b50b-\
a5634458451e"],

Cell[TextData[StyleBox["The action is a scalar real number. It has different \
values for different curves.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.975168656917274*^9, 
  3.9751686725439243`*^9}},ExpressionUUID->"8343e134-b598-4f3c-8ff6-\
ec0221d83398"],

Cell[TextData[{
 StyleBox["The ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "n"}], "+", "1"}], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"704db5b9-28c8-46f2-a0eb-ad8340e6d89f"],
 StyleBox[" dimensionality will be critical to understanding gauge freedom. \
For now, the ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "n"}], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"aed1cb71-22ee-4794-a3d9-0065c1acddb6"],
 StyleBox[" generalized coordinates and velocities double as dynamical \
variables leading to equations of motion, and Newtonian time ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "071be19d-cec6-4022-8fbc-de63285b451f"],
 StyleBox[" is the privileged parameter for tracking dynamical evolution of \
these variables. Later, we demote time ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"84128bd0-366d-4f17-9349-9d1d9e5de0bd"],
 StyleBox[" to be just another variable, opening the door to relativity, and \
replace its dynamical-tracking role with a freely chosen parameter ",
  FontSlant->"Italic"],
 "\[Tau]",
 StyleBox[" as a gauge.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9751116852869177`*^9, 3.9751117115977287`*^9}, {
  3.975114790214367*^9, 3.975115028697291*^9}, {3.97518233153544*^9, 
  3.975182379678108*^9}, {3.975256703939748*^9, 3.9752567039440603`*^9}, {
  3.975262729502316*^9, 
  3.9752627355716887`*^9}},ExpressionUUID->"2fbf6eb9-38bb-4276-8746-\
0eba6513893a"],

Cell[TextData[{
 StyleBox["This notebook is not concerned with solving the dynamical \
equations to find a \[OpenCurlyDoubleQuote]best\[CloseCurlyDoubleQuote] \
curve. Such is the subject of others of my notebooks. For now, just realize \
that the action integral is a function of the whole curve. Give me a curve ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["C", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eaab0c82-a924-4117-8d13-7dfb160e8c20"],
 StyleBox[" and I\[CloseCurlyQuote]ll tell you the action ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["I", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8f950e33-779b-495b-bd1d-648c29a525d6"],
 " ",
 StyleBox["along that curve.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9751116852869177`*^9, 3.9751117115977287`*^9}, {
  3.975114790214367*^9, 3.975115028697291*^9}, {3.97518233153544*^9, 
  3.975182379678108*^9}, {3.975256705652308*^9, 3.975256814539583*^9}, {
  3.975262771616394*^9, 
  3.975262774055242*^9}},ExpressionUUID->"834bdf03-90bf-460e-a26a-\
663c21d0cabf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Coordinate Transformations", "Section",
 CellChangeTimes->{{3.974935271773293*^9, 
  3.974935276659358*^9}},ExpressionUUID->"bff6c93b-4b1c-4051-85be-\
5fb048243b92"],

Cell["\<\
We need results in this section to define coordinate invariance of the \
Lagrangian. \
\>", "Text",
 CellChangeTimes->{{3.974840023907936*^9, 3.974840031984309*^9}, {
  3.974840261735073*^9, 3.9748402638127747`*^9}, {3.9749313670780163`*^9, 
  3.9749314226373672`*^9}, {3.97493528325721*^9, 3.974935308969586*^9}, {
  3.9749802218468113`*^9, 3.974980226981101*^9}, {3.975089150200727*^9, 
  3.975089151745562*^9}, {3.975256839703393*^9, 
  3.975256840097171*^9}},ExpressionUUID->"4b2bc2cc-263d-48c0-997b-\
288bad7aca1b"],

Cell[TextData[{
 "Consider invertible, continuous, twice-differentiable coordinate \
transformation functions to and from a new ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "f5b7b600-fadc-4f7a-9e60-cdc688e110eb"],
 "\[NoBreak]-\[NoBreak]dimensional coordinate system ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "_"], TraditionalForm]],ExpressionUUID->
  "4110356a-09f4-4163-8277-3fa388efc97d"],
 ", keeping the same parameter ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "64e4ec30-f224-45e1-9beb-b401cf33e9e4"],
 " (we\[CloseCurlyQuote]ll vary ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2fada3c1-5e60-449b-93b2-4666642830b6"],
 " later):"
}], "Text",
 CellChangeTimes->{{3.974840023907936*^9, 3.974840031984309*^9}, {
  3.974840261735073*^9, 3.9748402638127747`*^9}, {3.9749313670780163`*^9, 
  3.9749314226373672`*^9}, {3.97493528325721*^9, 3.974935307898299*^9}, {
  3.97493634573111*^9, 3.9749363664984627`*^9}, {3.974983751120579*^9, 
  3.9749837674934053`*^9}, {3.975256859107942*^9, 
  3.9752568596580877`*^9}},ExpressionUUID->"203f0076-5807-4dad-8073-\
ea83dc4267b4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     OverscriptBox["x", "_"], "j"], "=", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox["x", "_"], "j"], "(", 
     SuperscriptBox["x", "h"], ")"}]}], ",", " ", 
   RowBox[{
    SuperscriptBox["x", "h"], "=", 
    RowBox[{
     SuperscriptBox["x", "h"], "(", 
     SuperscriptBox[
      OverscriptBox["x", "_"], "j"], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974840043733162*^9, 3.974840072941757*^9}, {
  3.9748401034197407`*^9, 3.9748401798953953`*^9}, {3.9748403634010878`*^9, 
  3.974840385959042*^9}},
 CellTags->
  "COORDINATE TRANSFORMATION \
FUNCTIONS",ExpressionUUID->"2187e5b3-4d48-421f-b15f-489956879c60"],

Cell[TextData[{
 "The derivatives ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "h"], TraditionalForm]],
  ExpressionUUID->"88dc4c01-2f1b-4162-904f-27e4e09e600b"],
 " transform ",
 StyleBox["contravariantly",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " by the chain rule from the transformation functions:"
}], "Text",
 CellChangeTimes->{{3.974840491078636*^9, 3.97484056846175*^9}, {
   3.974931469855213*^9, 3.9749314731142273`*^9}, {3.974933595945074*^9, 
   3.974933612962946*^9}, {3.974933649297406*^9, 3.974933672677791*^9}, 
   3.97518242244903*^9},ExpressionUUID->"ccfe0fba-3a7d-4fcb-ab58-\
7d68fed33b51"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "h"], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "h"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "_"], "j"]}]], 
     SuperscriptBox[
      OverscriptBox[
       OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"]}], "\[Congruent]", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], "h"], "(", 
     RowBox[{
      SuperscriptBox[
       OverscriptBox["x", "_"], "j"], ",", 
      SuperscriptBox[
       OverscriptBox[
        OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
  3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
  3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
  3.974843674026392*^9, 
  3.974843676763193*^9}},ExpressionUUID->"aef4c547-35b6-4341-bced-\
a707f777b9e1"],

Cell[TextData[{
 StyleBox["Contravariance",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" of a tensorial (geometrical) object means that the magnitudes of \
components transform oppositely to the coordinate system. For example, Let  ",
  
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    OverscriptBox["x", "_"], "\[FilledSmallCircle]"], TraditionalForm]],
  CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
   3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
   3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
   3.974843674026392*^9, 3.974843676763193*^9}},
  FontSlant->"Plain",ExpressionUUID->"c5872d44-4e51-4481-89cb-4ea2065fe746"],
 StyleBox[" measure a velocity in feet per second and ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "\[FilledSmallCircle]"], TraditionalForm]],
  CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
   3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
   3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
   3.974843674026392*^9, 3.974843676763193*^9}},
  FontSlant->"Plain",ExpressionUUID->"247cd30d-1736-43b7-96de-c641d2242b17"],
 StyleBox[" measure the same velocity in inches per second. ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox[
     RowBox[{"\[PartialD]", "x"}], 
     RowBox[{"\[PartialD]", 
      OverscriptBox["x", "_"]}]],
    FontSlant->"Plain"], TraditionalForm]],
  CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
   3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
   3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
   3.974843674026392*^9, 3.974843676763193*^9}},
  FontSlant->"Italic",ExpressionUUID->
  "d9b37f91-98af-4e12-a251-8fef324be2ab"],
 StyleBox[" will be ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["12", TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "2f5a2452-e470-4193-95cb-606e371fb0f1"],
 StyleBox[" inches per foot, but the magnitude of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    OverscriptBox["x", "_"], "\[FilledSmallCircle]"], TraditionalForm]], 
  "Input",
  CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
   3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
   3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
   3.974843674026392*^9, 3.974843676763193*^9}},
  FontSlant->"Plain",ExpressionUUID->"c8e84373-05db-4c5e-9832-f6608ac3d898"],
 StyleBox[" in feet per second ",
  FontSlant->"Italic"],
 StyleBox["will be ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "12"}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "4aa09794-afd7-48a5-91d3-dedd4176344c"],
 StyleBox[" the magnitude of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "\[FilledSmallCircle]"], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"04d233b5-83d5-4d50-b6e8-e8563b813c58"],
 StyleBox[" in inches per second",
  FontSlant->"Italic"],
 StyleBox[". ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9749802641627283`*^9, 3.974980480908794*^9}, {
  3.974980516425631*^9, 3.974980637802083*^9}, {3.9749806866470537`*^9, 
  3.97498072630713*^9}, {3.974981794776587*^9, 3.974981798932282*^9}, {
  3.975115066293901*^9, 3.975115069509308*^9}, {3.975257061360057*^9, 
  3.975257105171661*^9}, {3.975262807779484*^9, 
  3.975262849217886*^9}},ExpressionUUID->"11066c99-afee-4aa2-8763-\
1e5ee3f2db1a"],

Cell[TextData[{
 StyleBox["A contravariant, rank\[NoBreak]-\[NoBreak]1 tensor is called, \
generically, a ",
  FontSlant->"Italic"],
 StyleBox["vector",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[". Velocity is the canonical example. Vectors (at point ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "fa00b753-59c5-447a-bcbf-af029443e6b3"],
 StyleBox[") inhabit the tangent space ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "p"], 
    SubscriptBox["X", "n"]}], TraditionalForm]],ExpressionUUID->
  "fbd67fae-9c99-4e0a-a75b-730a608cb63c"],
 StyleBox[". ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9749818623329563`*^9, 3.974981909084622*^9}, {
  3.975257170422391*^9, 3.9752571747436657`*^9}, {3.9752631694568243`*^9, 
  3.9752632018303432`*^9}},ExpressionUUID->"2cac7a7d-1c71-4cbe-a2ab-\
35b97f0e839e"],

Cell[TextData[{
 "From Equation ",
 
 CounterBox["DisplayFormulaNumbered", "COORDINATE TRANSFORMATION FUNCTIONS"],
 ", we get the rates of change of components ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "h"], TraditionalForm]],
  ExpressionUUID->"3e440fdd-4b1b-4f3b-b28e-3e6cd3db0213"],
 " with respect to changes in the new coordinates ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "_"], "j"], TraditionalForm]],ExpressionUUID->
  "221fedfc-0abc-46f6-885a-1d1c32b5fc06"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9748412726378307`*^9, 3.974841280912826*^9}, {
  3.974931478678451*^9, 3.974931479532049*^9}, {3.974980742155216*^9, 
  3.974980850298066*^9}},ExpressionUUID->"1a5e115a-5224-45c7-987c-\
5937123c578b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox[
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "_"], "j"]}]],
    Background->RGBColor[1, 1, 0]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SuperscriptBox[
         OverscriptBox["x", "_"], "j"]}]], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "h"]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox[
         OverscriptBox["x", "_"], "l"]}]]}], 
     SuperscriptBox[
      OverscriptBox[
       OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "l"]}], "=", 
    StyleBox[
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], 
        SuperscriptBox["x", "h"]}], 
       RowBox[{
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "_"], "j"]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "_"], "l"]}]}]], 
      SuperscriptBox[
       OverscriptBox[
        OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "l"]}],
     Background->RGBColor[1, 1, 0]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
  3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
  3.974841309193672*^9}, {3.974841346656712*^9, 3.974841401663694*^9}, {
  3.974841443644813*^9, 3.9748414807015343`*^9}, {3.9748415861433477`*^9, 
  3.974841665865241*^9}, {3.974843340768745*^9, 3.974843340998267*^9}, {
  3.9748435745354023`*^9, 3.97484357885846*^9}, {3.974843855248515*^9, 
  3.97484385562915*^9}, {3.974844027032526*^9, 3.9748440478969316`*^9}, {
  3.974844088721867*^9, 3.9748441468588943`*^9}, {3.97484417957139*^9, 
  3.974844184723298*^9}},ExpressionUUID->"d0b5a101-2398-4ba7-ae36-\
0fce1ce714d5"],

Cell[TextData[{
 "by renaming the dummy summation index: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "h"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "_"], "j"]}]], 
     SuperscriptBox[
      OverscriptBox[
       OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"]}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "h"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "_"], "l"]}]], 
     SuperscriptBox[
      OverscriptBox[
       OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "l"]}]}], 
   TraditionalForm]],
  CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
   3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
   3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
