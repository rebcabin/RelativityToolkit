  "d39c829e-a0d6-441e-bc62-8cb1677fc966"],
 ". "
}], "Text",
 CellChangeTimes->{{3.97493368914498*^9, 3.974933746251972*^9}, {
   3.9749352066495113`*^9, 3.974935209248104*^9}, {3.9749808603103447`*^9, 
   3.9749808614088087`*^9}, 3.974981441013918*^9, {3.9751824643105927`*^9, 
   3.975182466826861*^9}},ExpressionUUID->"0fedabee-56c1-474e-b22e-\
5bba6c75babd"],

Cell["\<\
We can swap the space and time derivatives to reveal the total time \
derivatives of the coordinate transformations as the same second-order \
partial derivatives:\
\>", "Text",
 CellChangeTimes->{{3.9749346126267347`*^9, 3.974934626451116*^9}, {
  3.97498090848949*^9, 3.974980926476329*^9}, {3.975257211491579*^9, 
  3.975257228391905*^9}},ExpressionUUID->"a9bc5653-45d2-4592-84d3-\
a51d4375066c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox[
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "_"], "j"]}]],
    Background->RGBColor[1, 1, 0]], "=", 
   RowBox[{
    RowBox[{
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "_"], "j"]}]], 
     FractionBox[
      RowBox[{"d", "\[VeryThinSpace]", 
       SuperscriptBox["x", "h"]}], 
      RowBox[{"d", "\[VeryThinSpace]", "t"}]]}], "=", 
    StyleBox[
     RowBox[{
      RowBox[{
       FractionBox["d", 
        RowBox[{"d", "\[VeryThinSpace]", "t"}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", "h"]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "_"], "j"]}]]}], "=", 
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], 
         SuperscriptBox["x", "h"]}], 
        RowBox[{
         RowBox[{"\[PartialD]", 
          SuperscriptBox[
           OverscriptBox["x", "_"], "j"]}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox[
           OverscriptBox["x", "_"], "l"]}]}]], 
       SuperscriptBox[
        OverscriptBox[
         OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "l"]}]}],
     Background->RGBColor[1, 1, 0]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
  3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
  3.974841309193672*^9}, {3.974841346656712*^9, 3.974841401663694*^9}, {
  3.974841443644813*^9, 3.9748414807015343`*^9}, {3.9748415861433477`*^9, 
  3.974841665865241*^9}, {3.974843340768745*^9, 3.974843340998267*^9}, {
  3.9748435745354023`*^9, 3.97484357885846*^9}, {3.974843855248515*^9, 
  3.97484385562915*^9}, {3.974844027032526*^9, 3.9748440478969316`*^9}, {
  3.974844088721867*^9, 3.9748441468588943`*^9}, {3.97484417957139*^9, 
  3.974844184723298*^9}, {3.97493481755618*^9, 3.974934937796451*^9}, {
  3.9749351214467373`*^9, 3.974935126812785*^9}},
 CellTags->
  "TOTAL TIME DERIVATIVE OF THE COORDINATE \
TRANSFORMATIONS",ExpressionUUID->"ab8e87c7-8766-4860-b802-47c64b166d90"],

