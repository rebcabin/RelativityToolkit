Cell[TextData[{
 "A Representation of ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4af25d33-74db-4f32-bb17-2e4b6ece479b"],
 " is a mapping, ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "674dccf8-6eff-451d-be42-a711a5e628c9"],
 ", of the elements of ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "24298b15-d8a1-4d16-95cd-3a50dbd92b44"],
 " onto a set of linear operators with the following properties:"
}], "Text",
 CellChangeTimes->{{3.989585487159997*^9, 3.989585522632942*^9}, {
  3.989587154060012*^9, 
  3.989587161489056*^9}},ExpressionUUID->"0f2046d4-13a1-4d6b-bfb1-\
21081ef4ded4"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"D", 
     RowBox[{"(", "e", ")"}]}], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cad93094-98ef-4967-94a5-902def992f35"],
 ", where ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dbf4b1d6-dd2e-4184-81b4-845c4fe9a068"],
 " is the identity operator in the space on which the linear operators act."
}], "ItemNumbered",
 CellChangeTimes->{{3.989585526389673*^9, 3.989585547862628*^9}, {
  3.989587166380128*^9, 
  3.9895871717868643`*^9}},ExpressionUUID->"331882ae-2fa3-4128-9ead-\
551860faed49"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"D", "(", 
      SubscriptBox["g", "1"], ")"}], 
     RowBox[{"D", "(", 
      SubscriptBox["g", "2"], ")"}]}], "=", 
    RowBox[{"D", "(", 
     RowBox[{
      SubscriptBox["g", "1"], 
      SubscriptBox["g", "2"]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6a5c2ac1-7833-4faa-91c7-46a11e05d136"],
 ", in other words, the group multiplication law is mapped onto the natural \
multiplication in the linear space on which the linear operators act."
}], "ItemNumbered",
 CellChangeTimes->{{3.989585550753202*^9, 
  3.98958561124058*^9}},ExpressionUUID->"e22b7daa-94b3-406f-9c04-\
cfcdff3be6a5"],

