\[VeryThinSpace]\[FilledSquare]\>\"", ",", "StandardRed", ",", "Bold", ",", 
          "18"}], "]"}], "]"}]}], "]"}], ";", "v"}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"proof", "[", "___", "]"}], ":=", 
