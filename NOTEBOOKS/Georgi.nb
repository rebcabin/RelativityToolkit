    RowBox[{"proof", "[", "v_", "]"}], "/;", 
    RowBox[{"BooleanQ", "[", "v", "]"}]}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{"v", ",", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
