  3.988877880722538*^9}},ExpressionUUID->"347e0e8e-c8f3-8b47-aba1-\
ff3521a88028"],

Cell[TextData[{
 StyleBox["A contravariant, rank\[NoBreak]-\[NoBreak]1 tensor is called, \
generically, a ",
  FontSlant->"Italic"],
 StyleBox["vector",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[". Velocity is the canonical example. Vectors (at point ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "c069e4e0-10b9-6443-b1e7-7fcff36f4596"],
 StyleBox[") inhabit the tangent space ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "p"], 
    SubscriptBox["X", "n"]}], TraditionalForm]],ExpressionUUID->
  "3729c79f-039c-b845-bb87-acf8ec95b5e3"],
 StyleBox[". ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9749818623329563`*^9, 3.974981909084622*^9}, {
  3.975257170422391*^9, 3.9752571747436657`*^9}, {3.9752631694568243`*^9, 
  3.9752632018303432`*^9}},ExpressionUUID->"6d17921b-c01d-4b44-b5bb-\
da2dbf3a47a5"],

Cell[TextData[{
 "From Equations ",
 
 CounterBox["DisplayFormulaNumbered", "COORDINATE TRANSFORMATION FUNCTIONS"],
 " and ",
 
 CounterBox["DisplayFormulaNumbered", "COORDINATE TRANSFORMATION DERIVATIVES"],
 ", we get the rates of change of velocity-vector components ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "h"], TraditionalForm]],
  ExpressionUUID->"f2bb086d-029c-9a43-af0a-3307d77e844e"],
 " with respect to changes in the new coordinates ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "_"], "j"], TraditionalForm]],ExpressionUUID->
  "621e4b71-ddf8-854d-b8ea-396dcf0ab352"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9748412726378307`*^9, 3.974841280912826*^9}, {
   3.974931478678451*^9, 3.974931479532049*^9}, {3.974980742155216*^9, 
   3.974980850298066*^9}, {3.988875494625581*^9, 3.988875524126622*^9}, 
   3.988875777073522*^9, {3.9888758263090897`*^9, 3.9888758599404373`*^9}, {
   3.988875907022995*^9, 3.9888759113933783`*^9}, {3.988876252788969*^9, 
   3.988876255212994*^9}},ExpressionUUID->"d26e935c-4e8e-5d41-ad2c-\
0859d9d3e341"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox[
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "_"], "j"]}]],
    Background->RGBColor[0.93, 0.27, 0.27, 0.33]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SuperscriptBox[
         OverscriptBox["x", "_"], "j"]}]], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "h"]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox[
         OverscriptBox["x", "_"], "l"]}]]}], 
     SuperscriptBox[
      OverscriptBox[
       OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "l"]}], "=", 
    StyleBox[
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], 
        SuperscriptBox["x", "h"]}], 
       RowBox[{
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "_"], "j"]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "_"], "l"]}]}]], 
      SuperscriptBox[
       OverscriptBox[
        OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "l"]}],
     Background->RGBColor[0.93, 0.27, 0.27, 0.33]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
  3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
  3.974841309193672*^9}, {3.974841346656712*^9, 3.974841401663694*^9}, {
  3.974841443644813*^9, 3.9748414807015343`*^9}, {3.9748415861433477`*^9, 
  3.974841665865241*^9}, {3.974843340768745*^9, 3.974843340998267*^9}, {
  3.9748435745354023`*^9, 3.97484357885846*^9}, {3.974843855248515*^9, 
  3.97484385562915*^9}, {3.974844027032526*^9, 3.9748440478969316`*^9}, {
  3.974844088721867*^9, 3.9748441468588943`*^9}, {3.97484417957139*^9, 
  3.974844184723298*^9}},ExpressionUUID->"952a9046-f380-e24c-8ecc-\
7d8881b6cdac"],

Cell[TextData[{
 "by renaming the dummy summation index from ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f38dec11-5d43-4942-af3f-77e2f96d34c3"],
 " to ",
 Cell[BoxData[
  FormBox["l", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d60f8218-91e9-486f-9c2c-0339eb848465"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "h"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "_"], "j"]}]], 
     SuperscriptBox[
      OverscriptBox[
       OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"]}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "h"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "_"], "l"]}]], 
     SuperscriptBox[
      OverscriptBox[
       OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "l"]}]}], 
   TraditionalForm]],
  CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
   3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
   3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
   3.974843674026392*^9, 3.974843676763193*^9}},ExpressionUUID->
  "df116df4-3b99-1e4a-80b9-f4c4e63b1cd9"],
 ". "
}], "Text",
 CellChangeTimes->{{3.97493368914498*^9, 3.974933746251972*^9}, {
   3.9749352066495113`*^9, 3.974935209248104*^9}, {3.9749808603103447`*^9, 
   3.9749808614088087`*^9}, 3.974981441013918*^9, {3.9751824643105927`*^9, 
   3.975182466826861*^9}, {3.988875937994697*^9, 
   3.988875942109322*^9}},ExpressionUUID->"b2631949-233a-5348-a37b-\
5912f28149f4"],

Cell["\<\
We can swap the space and time derivatives to reveal the total time \
derivatives of the coordinate transformations as the same second-order \
partial derivatives:\
\>", "Text",
 CellChangeTimes->{{3.9749346126267347`*^9, 3.974934626451116*^9}, {
  3.97498090848949*^9, 3.974980926476329*^9}, {3.975257211491579*^9, 
  3.975257228391905*^9}},ExpressionUUID->"9bf790e8-4467-6446-b751-\
ef5415b00052"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox[
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "_"], "j"]}]],
    Background->RGBColor[0.93, 0.27, 0.27, 0.33]], "=", 
   RowBox[{
    RowBox[{
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "_"], "j"]}]], 
     FractionBox[
      RowBox[{"d", "\[VeryThinSpace]", 
       SuperscriptBox["x", "h"]}], 
      RowBox[{"d", "\[VeryThinSpace]", "t"}]]}], "=", 
    StyleBox[
     RowBox[{
      RowBox[{
       FractionBox["d", 
        RowBox[{"d", "\[VeryThinSpace]", "t"}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", "h"]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "_"], "j"]}]]}], "=", 
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], 
         SuperscriptBox["x", "h"]}], 
        RowBox[{
         RowBox[{"\[PartialD]", 
          SuperscriptBox[
           OverscriptBox["x", "_"], "j"]}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox[
           OverscriptBox["x", "_"], "l"]}]}]], 
       SuperscriptBox[
        OverscriptBox[
         OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "l"]}]}],
     Background->RGBColor[0.93, 0.27, 0.27, 0.33]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
  3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
  3.974841309193672*^9}, {3.974841346656712*^9, 3.974841401663694*^9}, {
  3.974841443644813*^9, 3.9748414807015343`*^9}, {3.9748415861433477`*^9, 
  3.974841665865241*^9}, {3.974843340768745*^9, 3.974843340998267*^9}, {
  3.9748435745354023`*^9, 3.97484357885846*^9}, {3.974843855248515*^9, 
  3.97484385562915*^9}, {3.974844027032526*^9, 3.9748440478969316`*^9}, {
  3.974844088721867*^9, 3.9748441468588943`*^9}, {3.97484417957139*^9, 
  3.974844184723298*^9}, {3.97493481755618*^9, 3.974934937796451*^9}, {
  3.9749351214467373`*^9, 3.974935126812785*^9}},
 CellTags->
  "TOTAL TIME DERIVATIVE OF THE COORDINATE \
TRANSFORMATIONS",ExpressionUUID->"fe0b1e99-4547-194f-b502-a1bd691e82f6"],

Cell[TextData[{
 StyleBox["TODO: justify this swapping via the chain rule, independence of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "6af6658d-a444-8844-88ec-9b5acdd4c575"],
 " ",
 StyleBox["and",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "\[FilledSmallCircle]"], TraditionalForm]],
  ExpressionUUID->"f152b176-a085-e04f-8859-5706cd1043a3"],
 StyleBox[", and ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Clairaut's theorem",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Symmetry_of_second_derivatives"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Symmetry_of_second_derivatives"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[". ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9749355773966084`*^9, 3.974935686931758*^9}, {
  3.974936407061275*^9, 3.974936407381186*^9}, {3.9750770935531607`*^9, 
  3.975077101554475*^9}, {3.975182501048295*^9, 3.975182515724332*^9}, {
  3.975257255333123*^9, 
  3.975257258867209*^9}},ExpressionUUID->"2a10ba4d-f6d5-c74a-b986-\
98c60208a061"],

Cell[TextData[{
 "We also get from Equation ",
 
 CounterBox["DisplayFormulaNumbered", "COORDINATE TRANSFORMATION DERIVATIVES"],
 ", by treating ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox[
     OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"], 
   TraditionalForm]], "DisplayFormulaNumbered",
  CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
   3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
   3.974841309193672*^9}, {3.974841346656712*^9, 3.974841401663694*^9}},
  ExpressionUUID->"ef45c8e1-dc13-49fd-8432-6608c6ffb40c"],
 " as a variable, and by the definition of partial derivative,"
}], "Text",
 CellChangeTimes->{{3.9749352220712233`*^9, 3.9749352262566833`*^9}, {
   3.9749808782714863`*^9, 3.974980879951133*^9}, {3.9752572688266172`*^9, 
   3.9752572851762733`*^9}, {3.988876207957121*^9, 3.9888763456573343`*^9}, 
   3.9888765962769423`*^9},ExpressionUUID->"16ba5191-0739-ec4f-8ce1-\
e72fb586945a"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox[
        OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"]}]], "=", 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "h"]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "_"], "j"]}]]}],
   Background->RGBColor[0.93, 0.27, 0.27, 0.33]], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
  3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
  3.974841309193672*^9}, {3.974841346656712*^9, 
  3.974841401663694*^9}},ExpressionUUID->"440c518e-3b3c-9a41-9d23-\
c89c9ba73d45"],

Cell[TextData[StyleBox["TODO: this feels dicey and glib. Make it rigorous. ",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.9749355773966084`*^9, 3.974935686931758*^9}, {
  3.974936407061275*^9, 3.974936407381186*^9}, {3.9750770935531607`*^9, 
  3.975077101554475*^9}, {3.975182501048295*^9, 3.975182515724332*^9}, {
  3.975257255333123*^9, 3.975257258867209*^9}, {3.98887662431848*^9, 
  3.988876642382065*^9}},ExpressionUUID->"df21eb59-2bfc-4546-b458-\
5bb0c322a325"]
