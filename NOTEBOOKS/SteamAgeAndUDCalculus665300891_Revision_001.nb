  3.975862317210443*^9}},ExpressionUUID->"4915a53c-1a69-9d46-b753-\
c6b2cf56d7f2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox[
    OverscriptBox[
     StyleBox["n",
      FontWeight->"Bold"], "^"],
    FontWeight->"Bold"], "=", 
   FractionBox[
    RowBox[{
     StyleBox["x",
      FontWeight->"Bold"], "-", 
     RowBox[{
      StyleBox["z",
       FontWeight->"Bold"], "(", 
      SubscriptBox["s", "R"], ")"}]}], "R"]}], 
