Cell["This is shorthand for", "Text",
 CellChangeTimes->{{3.974982946765439*^9, 3.974982949582876*^9}, {
  3.974982994713834*^9, 
  3.974982995836152*^9}},ExpressionUUID->"1c4a74f1-d24f-854b-877f-\
c3c2317210dc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["L", "_"], 
    RowBox[{"(", 
     RowBox[{"t", ",", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["x", "_"], "j"], 
       RowBox[{"(", "t", ")"}]}], ",", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox[
         OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"], 
       RowBox[{"(", "t", ")"}]}]}], ")"}]}], "=", 
   RowBox[{"L", 
    RowBox[{"(", 
     RowBox[{"t", ",", 
      RowBox[{
       SuperscriptBox["x", "h"], "(", 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["x", "_"], "j"], "(", "t", ")"}], ")"}], ",", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["x", "\[FilledSmallCircle]"], "h"], "(", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          OverscriptBox["x", "_"], "j"], "(", "t", ")"}], ",", 
        RowBox[{
         SuperscriptBox[
          OverscriptBox[
           OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"], "(", "t", 
         ")"}]}], ")"}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974842016965528*^9, 3.974842077163102*^9}, {
  3.974842108001051*^9, 3.974842131478362*^9}, {3.9748421766836643`*^9, 
  3.974842191314451*^9}, {3.974842462468707*^9, 3.97484246247016*^9}, {
  3.974982961152401*^9, 
  3.974982972522006*^9}},ExpressionUUID->"3e1dfa59-1e17-aa4e-adf1-\
53ca27685170"],

Cell[TextData[{
 "Differentiating with respect to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox[
     OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"], TraditionalForm]],
  CellChangeTimes->{{3.9748425729163017`*^9, 3.974842805500814*^9}, {
   3.974843198836684*^9, 3.974843205607184*^9}, {3.97484328654198*^9, 
   3.9748432868984003`*^9}},ExpressionUUID->
  "d31b1979-f96e-4540-a2b6-0a9c717da603"],
 ", treating it as an independent variable, we get"
}], "Text",
 CellChangeTimes->{{3.974842320104672*^9, 3.974842435895337*^9}, {
  3.9748424868817863`*^9, 3.974842499212853*^9}, {3.9748425439585857`*^9, 
  3.9748425597004766`*^9}, {3.9749809786799*^9, 3.974981001544435*^9}, {
  3.974983019179867*^9, 3.974983020168992*^9}, {3.975085353504136*^9, 
  3.975085354711553*^9}, {3.9751151142563467`*^9, 3.975115114653562*^9}, {
  3.975182643627829*^9, 3.975182644136448*^9}, {3.9752629177940197`*^9, 
  3.975262928556004*^9}},ExpressionUUID->"2313f996-9e2b-0c46-a98f-\
d54ae3300367"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[PartialD]", 
     OverscriptBox["L", "_"]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox[
      OverscriptBox[
       OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"]}]], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", "L"}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox[
         OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"]}]]}], "=", 
    RowBox[{
     StyleBox[
      FractionBox[
       RowBox[{"\[PartialD]", "L"}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox[
         OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}]],
      Background->RGBColor[0.93, 0.27, 0.27, 0.33]], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "h"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "_"], "j"]}]]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9748425729163017`*^9, 3.974842805500814*^9}, {
  3.974843198836684*^9, 3.974843205607184*^9}, {3.97484328654198*^9, 
  3.9748432868984003`*^9}},
 CellTags->
  "COVARIANT CONJUGATE \
MOMENTA",ExpressionUUID->"5f3bc069-c128-4a4d-8719-925675a2fc23"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", "L"}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}]], TraditionalForm]],
  CellChangeTimes->{{3.9748425729163017`*^9, 3.974842805500814*^9}},
  ExpressionUUID->"44708bfd-cee6-734e-b697-6b88241166d0"],
 " are manifestly covariant, with the \[OpenCurlyDoubleQuote]up\
\[CloseCurlyDoubleQuote] index in the \[OpenCurlyDoubleQuote]denominator\
\[CloseCurlyDoubleQuote] of the derivative\[CloseCurlyQuote]s becoming a \
\[OpenCurlyDoubleQuote]down\[CloseCurlyDoubleQuote] index overall. Also \
carefully note ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["L", "_"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9e31014d-941e-4f3c-b02c-9a8c857e1b9c"],
 " on the left and ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "994cb7d4-d0bf-4420-8432-9769c71811ce"],
 " on the right."
}], "Text",
 CellChangeTimes->{{3.974842890222335*^9, 3.9748429972276087`*^9}, {
  3.974933822161551*^9, 3.97493384476901*^9}, {3.974934124804214*^9, 
  3.974934134517414*^9}, {3.975077187822053*^9, 3.97507723304062*^9}, {
  3.975079928860729*^9, 3.975079938832735*^9}, {3.9751151225998707`*^9, 
  3.975115123213621*^9}, {3.98887672973355*^9, 
  3.9888767595866213`*^9}},ExpressionUUID->"a2b7e621-d3a5-3041-9f21-\
6365c8213c20"],

Cell[TextData[{
 StyleBox["Of course, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", "L"}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}]], "\[Congruent]", 
    SubscriptBox["p", "h"]}], TraditionalForm]],
  CellChangeTimes->{{3.9748425729163017`*^9, 3.974842805500814*^9}},
  ExpressionUUID->"4bfa3879-8884-45ae-a9b6-32bca8acd3a8"],
 StyleBox[" are the ",
  FontSlant->"Italic"],
 StyleBox["canonical",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" or ",
  FontSlant->"Italic"],
 StyleBox["conjugate momenta",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" of Hamiltonian theory",
  FontSlant->"Italic"],
 "."
}], "Item",
 CellChangeTimes->{{3.974842890222335*^9, 3.9748429972276087`*^9}, {
  3.974933822161551*^9, 3.974933831799922*^9}, {3.975077240649753*^9, 
  3.975077248879092*^9}, {3.975182657739024*^9, 3.975182672325924*^9}, {
  3.988876773738594*^9, 
  3.988876781586731*^9}},ExpressionUUID->"af3e0ffe-1011-4e47-828b-\
f37323026cc5"],

Cell["We also get", "Text",
 CellChangeTimes->{{3.974843010006728*^9, 
  3.9748430123627663`*^9}},ExpressionUUID->"f08e22ce-13ed-084d-bdf5-\
741ce611bdef"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[PartialD]", 
     OverscriptBox["L", "_"]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox[
      OverscriptBox["x", "_"], "j"]}]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", "L"}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "h"]}]], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "h"]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox[
         OverscriptBox["x", "_"], "j"]}]]}], "+", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", "L"}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox[
         OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}]], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox[
         OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox[
         OverscriptBox["x", "_"], "j"]}]]}]}], "=", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", "L"}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "h"]}]], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "h"]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox[
         OverscriptBox["x", "_"], "j"]}]]}], "+", 
     StyleBox[
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", "L"}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}]], 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], 
         SuperscriptBox["x", "h"]}], 
        RowBox[{
         RowBox[{"\[PartialD]", 
          SuperscriptBox[
           OverscriptBox["x", "_"], "j"]}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox[
           OverscriptBox["x", "_"], "l"]}]}]], 
       SuperscriptBox[
        OverscriptBox[
         OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "l"]}],
      Background->RGBColor[0.93, 0.27, 0.27, 0.33]]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9748425729163017`*^9, 3.974842805500814*^9}, {
  3.9748430438327093`*^9, 3.9748431138031397`*^9}, {3.974843243883049*^9, 
  3.974843269504057*^9}, {3.97484335164567*^9, 3.974843351828271*^9}},
 CellTags->
  "PARTIAL DERIVATIVE OF L wrt \
COORDINATE",ExpressionUUID->"b56a7446-1de5-1746-a9f4-134649115caf"],

Cell[TextData[{
 StyleBox["TODO: this expression looks suspiciously like a ",
  FontSlant->"Italic"],
 StyleBox["covariant derivative",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" with the highlighted term a ",
  FontSlant->"Italic"],
 StyleBox["connection",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" or ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Christoffel symbol",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Christoffel_symbols"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Christoffel_symbols"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[". Is this a deep fact? (hint: yes)",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.974844304773159*^9, 3.974844347182193*^9}, {
  3.97493388553316*^9, 3.974933889531439*^9}, {3.974934305712438*^9, 
  3.974934306692388*^9}, {3.9749810479465027`*^9, 3.9749810789005737`*^9}, {
  3.9750051180302*^9, 3.975005119915678*^9}, {3.975115295169373*^9, 
  3.9751153002130337`*^9}, {3.975182727524274*^9, 3.9751827275250797`*^9}, {
  3.9752574553076763`*^9, 3.975257471420128*^9}, {3.975262974160989*^9, 
  3.97526297703458*^9}},ExpressionUUID->"b7c101b6-a640-6d45-aaae-\
c7bd9f714ccc"],

Cell[TextData[{
 "The components ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     OverscriptBox["L", "_"]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox[
      OverscriptBox["x", "_"], "j"]}]], TraditionalForm]],
  CellChangeTimes->{{3.9748425729163017`*^9, 3.974842805500814*^9}, {
   3.9748430438327093`*^9, 3.9748431138031397`*^9}, {3.974843243883049*^9, 
   3.974843269504057*^9}, {3.97484335164567*^9, 3.974843351828271*^9}},
  ExpressionUUID->"667089cb-db69-0045-a317-2412bcd07331"],
 " are not tensorial. Let\[CloseCurlyQuote]s construct a proper ",
 StyleBox["covariant",
  FontSlant->"Italic"],
 " tensor. We\[CloseCurlyQuote]ll look to eliminate the highlighted term, \
which includes a second partial derivative of the coordinate transformation, \
by finding it in another expression. "
}], "Text",
 CellChangeTimes->{{3.974844304773159*^9, 3.974844347182193*^9}, 
   3.974933878185832*^9, {3.974934160056405*^9, 3.9749341664202557`*^9}, {
   3.974934374945512*^9, 3.974934376025038*^9}, {3.974935929791041*^9, 
   3.974935973400372*^9}, {3.974936217075313*^9, 3.97493622885082*^9}, {
   3.9749364586030617`*^9, 3.974936459104072*^9}, {3.974981117984391*^9, 
   3.974981207772994*^9}, {3.97525748816558*^9, 
   3.975257497152306*^9}},ExpressionUUID->"eb624e33-e176-6643-8ddb-\
cea8c85f2c8e"],

Cell[TextData[{
 "Start with the total time derivative of another ",
 StyleBox["covariant",
  FontSlant->"Italic"],
 " quantity, the conjugate momenta, in the transformed coordinates, by the \
product rule and by substituting the total time derivative of the \
transformation functions from Equation ",
 
 CounterBox["DisplayFormulaNumbered", 
  "TOTAL TIME DERIVATIVE OF THE COORDINATE TRANSFORMATIONS"],
 ":"
}], "Text",
 CellChangeTimes->{{3.974844304773159*^9, 3.974844347182193*^9}, 
   3.974933878185832*^9, {3.974934160056405*^9, 3.9749341664202557`*^9}, {
   3.974934374945512*^9, 3.974934376025038*^9}, {3.974935929791041*^9, 
   3.974935973400372*^9}, {3.974936217075313*^9, 3.97493622885082*^9}, {
   3.9749364586030617`*^9, 3.974936459104072*^9}, {3.974981117984391*^9, 
   3.974981225963562*^9}, {3.97518275977956*^9, 3.97518279146459*^9}, {
   3.975257540871451*^9, 3.975257544237278*^9}, {3.975263022172566*^9, 
   3.975263042130327*^9}, {3.9888771163855047`*^9, 
   3.98887718085002*^9}},ExpressionUUID->"c89e9925-8d14-c447-b854-\
e378fc3e1e9f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["d", 
     RowBox[{"d", "\[VeryThinSpace]", "t"}]], 
    RowBox[{"(", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       OverscriptBox["L", "_"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox[
         OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"]}]], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["d", 
      RowBox[{"d", "\[VeryThinSpace]", "t"}]], 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", "L"}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", "h"]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "_"], "j"]}]]}], ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       FractionBox["d", 
        RowBox[{"d", "\[VeryThinSpace]", "t"}]], 
       RowBox[{"(", 
        FractionBox[
         RowBox[{"\[PartialD]", "L"}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox[
           OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}]], ")"}], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", "h"]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "_"], "j"]}]]}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", "L"}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}]], 
       FractionBox["d", 
        RowBox[{"d", "\[VeryThinSpace]", "t"}]], 
       RowBox[{"(", 
        FractionBox[
         RowBox[{"\[PartialD]", 
          SuperscriptBox["x", "h"]}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox[
           OverscriptBox["x", "_"], "j"]}]], ")"}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       FractionBox["d", 
        RowBox[{"d", "\[VeryThinSpace]", "t"}]], 
       RowBox[{"(", 
        FractionBox[
         RowBox[{"\[PartialD]", "L"}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox[
           OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}]], ")"}], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", "h"]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "_"], "j"]}]]}], "+", 
      StyleBox[
       RowBox[{
        FractionBox[
         RowBox[{"\[PartialD]", "L"}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox[
           OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}]], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], 
          SuperscriptBox["x", "h"]}], 
         RowBox[{
          RowBox[{"\[PartialD]", 
           SuperscriptBox[
            OverscriptBox["x", "_"], "j"]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox[
            OverscriptBox["x", "_"], "l"]}]}]], 
        SuperscriptBox[
         OverscriptBox[
          OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "l"]}],
       Background->RGBColor[0.93, 0.27, 0.27, 0.33]]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974934320014124*^9, 3.974934351292487*^9}, {
  3.9749343957262907`*^9, 3.974934524669129*^9}, {3.9749358956389093`*^9, 
  3.974935913618154*^9}, {3.974936143477944*^9, 
  3.974936199147357*^9}},ExpressionUUID->"144c822e-ff83-0140-8e1b-\
39cb4ff73fd8"],

Cell[TextData[{
 "We can now subtract out the offending second-order partial derivative by \
subtracting the ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     OverscriptBox["L", "_"]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox[
      OverscriptBox["x", "_"], "j"]}]], TraditionalForm]],
  CellChangeTimes->{{3.9748425729163017`*^9, 3.974842805500814*^9}, {
   3.9748430438327093`*^9, 3.9748431138031397`*^9}, {3.974843243883049*^9, 
   3.974843269504057*^9}, {3.97484335164567*^9, 3.974843351828271*^9}},
  ExpressionUUID->"55db4ded-5009-d74d-8a79-fc0b6f77942b"],
 " of Equation ",
 
 CounterBox["DisplayFormulaNumbered", 
  "PARTIAL DERIVATIVE OF L wrt COORDINATE"],
 ":"
}], "Text",
 CellChangeTimes->{{3.974935982027179*^9, 3.9749360292055683`*^9}, {
  3.974936246758247*^9, 3.974936260839426*^9}, {3.974936505703533*^9, 
  3.974936558812674*^9}, {3.974981351565589*^9, 3.9749813683910513`*^9}, {
  3.975182842822452*^9, 
  3.975182858611066*^9}},ExpressionUUID->"d256ef5e-564b-cb4e-a9a5-\
4e8a75752292"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox[
    RowBox[{
     RowBox[{
      FractionBox["d", 
       RowBox[{"d", "\[VeryThinSpace]", "t"}]], 
      RowBox[{"(", 
       FractionBox[
        RowBox[{"\[PartialD]", 
         OverscriptBox["L", "_"]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox[
           OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"]}]], ")"}]}],
      "-", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       OverscriptBox["L", "_"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "_"], "j"]}]]}],
    Background->RGBColor[0.93, 0.27, 0.27, 0.33]], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "h"]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "_"], "j"]}]], 
    RowBox[{"(", " ", 
     StyleBox[
      RowBox[{
       RowBox[{
        FractionBox["d", 
         RowBox[{"d", "\[VeryThinSpace]", "t"}]], 
        RowBox[{"(", 
         FractionBox[
          RowBox[{"\[PartialD]", "L"}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox[
            OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}]], ")"}]}], "-", 
       FractionBox[
        RowBox[{"\[PartialD]", "L"}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", "h"]}]]}],
      Background->RGBColor[0.93, 0.27, 0.27, 0.33]], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974934320014124*^9, 3.974934351292487*^9}, {
   3.9749343957262907`*^9, 3.974934524669129*^9}, {3.9749358956389093`*^9, 
   3.974935913618154*^9}, {3.974936143477944*^9, 3.974936199147357*^9}, {
   3.974936571075364*^9, 3.974936582774364*^9}, {3.974936699665299*^9, 
   3.974936742781473*^9}, {3.974936776714157*^9, 3.974936796700053*^9}, {
   3.988877276365438*^9, 3.988877340456626*^9}, 3.988877372765411*^9},
 CellTags->
  "EULER-LAGRANGE TRANSFORMATION \
LAW",ExpressionUUID->"edbe6278-4ccc-de47-87df-42fedd6c343b"],

Cell[TextData[{
 "The highlighted quantities transform covariantly, i.e., by multiplying \
barred quantities by the ",
 StyleBox[ButtonBox["Jacobian",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Jacobian"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Jacobian"],
  FontVariations->{"Underline"->True}],
 " of the inverse coordinate transformation functions, as can be seen even \
more clearly in the following inversion:"
}], "Text",
 CellChangeTimes->{{3.974937362160873*^9, 3.9749373683918047`*^9}, {
  3.974937646310704*^9, 3.974937729670434*^9}, {3.974937831506731*^9, 
  3.974937855300023*^9}, {3.974981401177621*^9, 3.974981403145523*^9}, {
  3.9751830134500227`*^9, 3.975183013450408*^9}, {3.975257587257826*^9, 
  3.975257589020586*^9}, {3.975263065188828*^9, 
  3.975263066158716*^9}},ExpressionUUID->"b6cb367d-f980-9e4e-a037-\
62eab91e4c6b"],

Cell[BoxData[
 FormBox[
  RowBox[{" ", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["d", 
       RowBox[{"d", "\[VeryThinSpace]", "t"}]], 
      RowBox[{"(", 
       FractionBox[
        RowBox[{"\[PartialD]", "L"}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}]], ")"}]}], "-", 
     FractionBox[
      RowBox[{"\[PartialD]", "L"}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "h"]}]]}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "_"], "j"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "h"]}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["d", 
         RowBox[{"d", "\[VeryThinSpace]", "t"}]], 
        RowBox[{"(", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           OverscriptBox["L", "_"]}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox[
            OverscriptBox[
             OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"]}]], 
         ")"}]}], "-", 
       FractionBox[
        RowBox[{"\[PartialD]", 
         OverscriptBox["L", "_"]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "_"], "j"]}]]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974937382425724*^9, 3.974937445585417*^9}, {
   3.9749376222388687`*^9, 3.974937628195788*^9}, {3.974937737415284*^9, 
   3.974937737417403*^9}, 3.974938066217833*^9, {3.9888773606511374`*^9, 
   3.98887736628228*^9}},
 Background->None,ExpressionUUID->"beaf4d38-c042-3e49-ac3b-c040ccefed43"],

Cell[TextData[StyleBox["The result is beautiful, but this derivation takes a \
bit of squinting, and it\[CloseCurlyQuote]s difficult to imagine how someone \
came up with it. Does coordinate-free presentation make it more concise or \
obvious? (hint: more concise, yes; more obvious, no).",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.974936937504579*^9, 3.974937046964686*^9}, {
  3.975115474395671*^9, 3.97511549637614*^9}, {3.9752576213142653`*^9, 
  3.975257627863606*^9}, {3.975263081473941*^9, 
  3.9752630955789957`*^9}},ExpressionUUID->"b6ebabfe-82a7-c144-8c7c-\
33a89aae31d2"],

Cell[TextData[{
 StyleBox["Covariance",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" of a tensorial object (with \[OpenCurlyDoubleQuote]down\
\[CloseCurlyDoubleQuote] indices) means that the magnitudes of components \
transform along with the coordinate system. For example, Let  ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   OverscriptBox["T", "_"], TraditionalForm]],ExpressionUUID->
  "f73e036f-44db-684f-97a3-351e8477af04"],
 StyleBox[" measure a temperature gradient in degrees per foot and ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["T", TraditionalForm]],
  CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
   3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
   3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
   3.974843674026392*^9, 3.974843676763193*^9}},
  FontSlant->"Plain",ExpressionUUID->"ce493747-f79d-4548-a2ce-218f9420a92f"],
 StyleBox[" measure the same gradient in degrees per inch. ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox[
     RowBox[{"\[PartialD]", "x"}], 
     RowBox[{"\[PartialD]", 
      OverscriptBox["x", "_"]}]],
    FontSlant->"Plain"], TraditionalForm]],
  CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
   3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
   3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
   3.974843674026392*^9, 3.974843676763193*^9}},
  FontSlant->"Italic",ExpressionUUID->"68e1b360-196c-f74c-b32a-45410c5327aa"],
 StyleBox[" will be ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["12", TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"7845cf42-dfd9-f349-87d8-3bf6884597d6"],
 StyleBox[" inches per foot. The magnitude of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   OverscriptBox["T", "_"], TraditionalForm]], "Input",
  CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
   3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
   3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
   3.974843674026392*^9, 3.974843676763193*^9}},
  FontSlant->"Italic",ExpressionUUID->"34d5d20a-df5a-494c-b736-5d5cf52d2364"],
 StyleBox[" in degrees per foot will be ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["12", TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"2b1faf32-8a7a-8345-87dd-360aedda36fb"],
 StyleBox[" times the magnitude of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["T", TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"295d708d-f312-3e43-a8ff-fca0eb084b44"],
 StyleBox[" in degrees per inch, i.e., ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["T", "_"], "(", "dpf", ")"}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", "x"}], 
      RowBox[{"\[PartialD]", 
       OverscriptBox["x", "_"]}]], 
     RowBox[{"(", 
      RowBox[{"12", 
       FractionBox["inch", "foot"]}], ")"}], 
     RowBox[{"T", "(", "dpi", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d3e3521e-c747-435e-89c6-27de3f78685a"],
 ", with unbarred coordinates on top, multiplying the unbarred ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8d5a82fa-65a2-4f26-b5e0-d366e7ea4cf5"],
 StyleBox[". ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9749802641627283`*^9, 3.974980480908794*^9}, {
   3.974980516425631*^9, 3.974980637802083*^9}, {3.9749806866470537`*^9, 
   3.97498072630713*^9}, {3.974981475741794*^9, 3.974981634175864*^9}, {
   3.974981807757737*^9, 3.974981812128272*^9}, {3.975183182110166*^9, 
   3.9751832072313538`*^9}, {3.975257643145872*^9, 3.975257647469051*^9}, {
   3.975257825563754*^9, 3.975257856588356*^9}, {3.9752631192313633`*^9, 
   3.975263144963813*^9}, 3.975263219948332*^9, {3.988877459723509*^9, 
   3.988877586497343*^9}, {3.988877922721349*^9, 
   3.988877967301852*^9}},ExpressionUUID->"c9872222-8619-aa4c-8713-\
5b15b2ab5cbb"],

Cell[TextData[{
 StyleBox["A covariant, rank\[NoBreak]-\[NoBreak]1 tensor is called, \
generically, a ",
  FontSlant->"Italic"],
 StyleBox["covector",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[". A gradient is the canonical example. Covectors (at point ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "9cf47481-eec8-0149-b02c-45328417e065"],
 StyleBox[") ",
  FontSlant->"Italic"],
 StyleBox["inhabit the cotangent space ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["T", "\[Star]"], "p"], 
    SubscriptBox["X", "n"]}], TraditionalForm]],ExpressionUUID->
  "c49cfecc-d5b3-fb4a-a174-429b802effe0"],
 ". "
}], "Item",
 CellChangeTimes->{{3.9749818623329563`*^9, 3.974982076937346*^9}, {
  3.974982284260865*^9, 3.974982307089411*^9}, {3.9751832195424633`*^9, 
  3.975183222159165*^9}, {3.975257668581859*^9, 3.975257773281056*^9}, {
  3.975263223247179*^9, 
  3.975263224488822*^9}},ExpressionUUID->"b06f6bf3-9e86-8d4e-b9ba-\
97a082e8c1b4"],

Cell[TextData[{
 StyleBox["Recall how we construct a directional derivative by ",
  FontSlant->"Italic"],
 StyleBox["contracting",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[", or summing over repeated up-down indices, by contracting the \
components ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["v", "j"], TraditionalForm]],ExpressionUUID->
  "c896629e-0fad-ef47-8278-a0f63d78713c"],
 " ",
 StyleBox["of a contravariant vector ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "95d22847-bff7-ab4c-b98f-2ad61c162178"],
 " ",
 StyleBox["with the covariant basis of partial-derivative operators ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   FractionBox["\[PartialD]", 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "j"]}]], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"6d3ca328-df64-2441-b3d5-f1a36892c250"],
 StyleBox[", which is a gradient operator.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9749818623329563`*^9, 3.974982076937346*^9}, {
  3.974982284260865*^9, 3.974982307089411*^9}, {3.9751832195424633`*^9, 
  3.975183222159165*^9}, {3.975257668581859*^9, 3.975257757630178*^9}, {
  3.975263244174375*^9, 3.975263244230135*^9}, {3.975263293229971*^9, 
  3.97526337536561*^9}},ExpressionUUID->"c0fbc203-20b8-044a-8143-\
30c51a9e7879"],

Cell[CellGroupData[{

Cell["Euler-Lagrange Covector", "Subsection",
 CellChangeTimes->{{3.9749381157735767`*^9, 
  3.9749381223925533`*^9}},ExpressionUUID->"0e3b967a-d94f-d54c-8687-\
a60ef9a56d4f"],

Cell[TextData[{
 "The highlighted quantities in Equation ",
 
 CounterBox["DisplayFormulaNumbered", "EULER-LAGRANGE TRANSFORMATION LAW"],
 " should \[OpenCurlyDoubleQuote]ring a bell\[CloseCurlyDoubleQuote] as the \
terms of the Euler-Lagrange equations of motion. You will usually find these \
as the result of a lengthy derivation in the ",
 StyleBox["calculus of variations",
  FontSlant->"Italic"],
 ". But here, we found them simply by searching for a tensorial version of a \
derivative of ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4cccccf8-aef6-49bf-a96b-a73dea56a35a"],
 "! We didn\[CloseCurlyQuote]t need to introduce the calculus of variations, \
beautiful as it is."
}], "Text",
 CellChangeTimes->{{3.9749379379161377`*^9, 3.974938014261099*^9}, {
  3.974938045455906*^9, 3.9749380487803993`*^9}, {3.974984053789349*^9, 
  3.974984067767496*^9}, {3.9750052061319532`*^9, 3.975005282846052*^9}, {
  3.975183335711084*^9, 3.9751833645988503`*^9}, {3.975257924757956*^9, 
  3.975257928447979*^9}, {3.988878096523456*^9, 3.988878101771036*^9}, {
  3.98887813874312*^9, 3.988878254984521*^9}, {3.988878286444941*^9, 
  3.9888783045814857`*^9}},ExpressionUUID->"7602f8ce-5c47-6243-8cea-\
678af6dcb6db"],

Cell[TextData[{
 "These quantities deserve a name: The ",
 StyleBox["Euler-Lagrange covector",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" ",
  FontSlant->"Italic"],
 "(the \[OpenCurlyDoubleQuote]up\[CloseCurlyDoubleQuote] indices in the \
denominator (lower) position of derivatives become \
\[OpenCurlyDoubleQuote]down\[CloseCurlyDoubleQuote] indices in the result, \
and \[OpenCurlyDoubleQuote]down\[CloseCurlyDoubleQuote] indices are the sigil \
of a covector):"
}], "Text",
 CellChangeTimes->{{3.9749379379161377`*^9, 3.974938014261099*^9}, {
  3.974938045455906*^9, 3.9749380487803993`*^9}, {3.974984053789349*^9, 
  3.974984067767496*^9}, {3.9750052061319532`*^9, 3.975005282846052*^9}, {
  3.975183335711084*^9, 3.9751833645988503`*^9}, {3.975257924757956*^9, 
  3.975257928447979*^9}, {3.988878096523456*^9, 3.988878101771036*^9}, {
  3.98887813874312*^9, 3.988878256422922*^9}, {3.9888783185483713`*^9, 
  3.9888783454310007`*^9}},ExpressionUUID->"e28fa5d2-b849-4d41-952d-\
249575ded3d8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["E", "h"], "(", "L", ")"}], "\[Congruent]", 
   RowBox[{
    RowBox[{
     FractionBox["d", 
      RowBox[{"d", "\[VeryThinSpace]", "t"}]], 
     RowBox[{"(", 
      FractionBox[
       RowBox[{"\[PartialD]", "L"}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox[
         OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}]], ")"}]}], "-", 
    FractionBox[
     RowBox[{"\[PartialD]", "L"}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "h"]}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974937382425724*^9, 3.974937445585417*^9}, {
  3.9749376222388687`*^9, 3.974937628195788*^9}, {3.974937737415284*^9, 
  3.974937737417403*^9}, {3.974938058703334*^9, 3.974938084221417*^9}},
 Background->None,
 CellTags->
  "EULER-LAGRANGE \
COVECTOR",ExpressionUUID->"3eff828f-1124-ca42-9a85-ba4ba0327825"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Summary of Coordinate Invariance", "Subsection",
 CellChangeTimes->{{3.975085066642272*^9, 
  3.975085073637704*^9}},ExpressionUUID->"de7374ef-0357-b145-894e-\
18bf007ddbea"],

Cell[TextData[Cell[BoxData[
 TagBox[GridBox[{
    {"Quantity", "Notation", 
     RowBox[{"Tensorial", " ", "Rank"}], 
     RowBox[{"Transformation", " ", "Type"}]},
    {"Coordinate", 
     SuperscriptBox["x", "h"], 
     RowBox[{"(", 
      RowBox[{"1", ",", "0"}], ")"}], "Contravariant"},
    {"Velocity", 
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], "h"], 
     RowBox[{"(", 
      RowBox[{"1", ",", "0"}], ")"}], "Contravariant"},
    {"Momentum", 
     RowBox[{
      SubscriptBox["p", "h"], "=", 
      FractionBox[
       RowBox[{"\[PartialD]", "L"}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox[
         OverscriptBox["x", "\[FilledSmallCircle]"], "h"]}]]}], 
     RowBox[{"(", 
      RowBox[{"0", ",", "1"}], ")"}], "Covariant"},
    {
     RowBox[{"E", "-", 
      RowBox[{"L", " ", "Covector"}]}], 
     RowBox[{
      SubscriptBox["E", "h"], 
      RowBox[{"(", "L", ")"}]}], 
     RowBox[{"(", 
      RowBox[{"0", ",", "1"}], ")"}], "Covariant"}
   }],
  "Grid"]],ExpressionUUID->"9f493484-77fa-6c49-aade-10137d59dcbb"]], "Text",
 CellChangeTimes->{{3.975085086804266*^9, 3.975085094852961*^9}, {
  3.9750851260336018`*^9, 3.9750853327179317`*^9}, {3.975115538716015*^9, 
  3.975115538716105*^9}},ExpressionUUID->"5251df34-bef3-df44-9b8a-\
04b6328ac163"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Physical Interpretation", "Subsection",
 CellChangeTimes->{{3.975085510179193*^9, 
  3.97508551465662*^9}},ExpressionUUID->"ae9648a3-9adc-6846-a61e-\
4e8f86d1ef76"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["E", "h"], "(", "L", ")"}], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"37f46a03-f5ad-eb44-a6ef-799c7297d8fb"],
 StyleBox[" vanishes for physically realistic motion.",
  FontWeight->"Bold"],
 " With that vanishing, we treat the coordinates and velocities as functions \
of the parameter, and thus get differential equations for the motion. In this \
notebook, we do not solve dynamical problems, and thus don\[CloseCurlyQuote]t \
assume that these quantities vanish. We have only shown that ",
 StyleBox["the ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["E", "h"], "(", "L", ")"}],
    FontWeight->"Plain"], TraditionalForm]],
  CellChangeTimes->{{3.974937382425724*^9, 3.974937445585417*^9}, {
   3.9749376222388687`*^9, 3.974937628195788*^9}, {3.974937737415284*^9, 
   3.974937737417403*^9}, {3.974938058703334*^9, 3.974938084221417*^9}},
  FontWeight->"Bold",
  Background->None,ExpressionUUID->"623acec5-13da-2a47-98f8-39ed1732463a"],
 StyleBox[" transform covariantly when the Lagrangian is invariant with \
respect to coordinate transformations",
  FontWeight->"Bold"],
 ". However, the classical laws of motion described by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["E", "h"], "(", "L", ")"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"4d5f0255-83b9-674a-b2da-eff0477d470b"],
 " are also independent of the coordinate system, given that the coordinates \
are adequate to distinguish points along the curve ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "b90e2fb2-b0e8-d84f-9d18-a2093a2fd454"],
 ". ",
 StyleBox["The laws of motion are also a purely geometric property of the \
curve itself. ",
  FontWeight->"Bold"],
 "The laws of motion follow from finding geodesics (shortest paths) in a \
curved space with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["E", "h"], "(", "L", ")"}], TraditionalForm]],ExpressionUUID->
  "21f5b710-865b-447c-9160-5af4fec7f255"],
 " measuring the deviation of the curve from a geodesic."
}], "Text",
 CellChangeTimes->{{3.974982342521455*^9, 3.97498238935682*^9}, {
  3.974982474033087*^9, 3.974982513477818*^9}, {3.975183373859593*^9, 
  3.975183467154131*^9}, {3.975257902641306*^9, 3.97525791548708*^9}, {
  3.975257988754463*^9, 3.975258002022397*^9}, {3.975258032903846*^9, 
  3.97525803341707*^9}, {3.975263426749692*^9, 3.975263447802662*^9}, {
  3.9752634820208607`*^9, 3.975263518738678*^9}, {3.988878380538382*^9, 
  3.988878404737358*^9}, {3.9888784969639883`*^9, 
  3.988878626473577*^9}},ExpressionUUID->"4ad80826-4337-f14c-afc7-\
8b3ab77a09ce"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Parameter Invariance of the Action", "Section",
 CellChangeTimes->{{3.974982444624201*^9, 3.9749824560917397`*^9}, {
  3.975111013191324*^9, 
  3.975111015096423*^9}},ExpressionUUID->"104d8895-3d6d-f846-9909-\
8cd08f8afa94"],

Cell["\<\
Now that we know that neither the kinematics nor the dynamics depend on how \
we define coordinates on the configuration manifold, let\[CloseCurlyQuote]s \
make the physics not even depend on how we measure dynamical progress\
\[LongDash]on the choice of clock. In the offing, we demote our old Newtonian \
time to be just another coordinate. Relativity will be inevitable.\
\>", "Text",
 CellChangeTimes->{{3.975115631463222*^9, 3.975115717138918*^9}, {
  3.975115909208703*^9, 3.975115912585648*^9}, {3.975183527771371*^9, 
  3.9751835978093233`*^9}, {3.975189941899218*^9, 3.97518995247843*^9}, {
  3.975258087881172*^9, 3.9752581051646547`*^9}, {3.975263538748385*^9, 
  3.97526358814436*^9}, {3.98887864723407*^9, 
  3.988878654355201*^9}},ExpressionUUID->"51f5d3eb-5646-c840-aaa5-\
216a322d5bb6"],

Cell[TextData[{
 "Consider invertible parameter transformations, independent of the \
coordinate transformations of Equation ",
 
 CounterBox["DisplayFormulaNumbered", "COORDINATE TRANSFORMATION FUNCTIONS"],
 ":"
}], "Text",
 CellChangeTimes->{{3.974840188848886*^9, 3.9748401968331203`*^9}, {
  3.9748403231259737`*^9, 3.974840325755455*^9}, {3.974931429245182*^9, 
  3.974931432525257*^9}, {3.974937579875115*^9, 3.974937581722219*^9}, {
  3.974983783062413*^9, 3.97498383050084*^9}, {3.975074605686265*^9, 
  3.9750746255719337`*^9}},ExpressionUUID->"470699bc-a2f9-b74b-9755-\
5fc13e13f5ee"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Tau]", "=", 
    RowBox[{"\[Tau]", "(", "t", ")"}]}], ";", " ", 
   RowBox[{"t", "=", 
    RowBox[{"t", "(", "\[Tau]", ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974840206980134*^9, 3.9748402238978777`*^9}, {
  3.974983800760202*^9, 
  3.974983808830492*^9}},ExpressionUUID->"e9f8268c-fbfa-8948-92ef-\
283201073ff2"],

Cell[TextData[{
 "The action integral (Equation ",
 
 CounterBox["DisplayFormulaNumbered", "LOVELOCK ACTION INTEGRAL"],
 ") is parameter-invariant if and only if"
}], "Text",
 CellChangeTimes->{
  3.9749825943316917`*^9, {3.974982628958707*^9, 3.974982680935472*^9}, {
   3.974982834018137*^9, 3.974982838740634*^9}, {3.9750053610404673`*^9, 
   3.975005380297127*^9}, 3.97501056860058*^9, {3.975116189751198*^9, 
   3.975116194434513*^9}, {3.9752581173730993`*^9, 
   3.975258119642496*^9}},ExpressionUUID->"eb22c511-ccdd-8848-aae5-\
45db8e59fb43"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"  ", 
      SubscriptBox["t", "1"]}], 
     RowBox[{"  ", 
      SubscriptBox["t", "2"]}]], 
    RowBox[{"L", 
     RowBox[{"(", 
      RowBox[{"t", ",", 
       RowBox[{
        SuperscriptBox["x", "j"], "(", "t", ")"}], ",", 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["x", "\[FilledSmallCircle]"], "j"], "(", "t", ")"}]}], 
      ")"}], 
     RowBox[{"\[DifferentialD]", "t"}]}]}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"  ", 
       SubscriptBox["\[Tau]", "1"]}], 
      RowBox[{"  ", 
       SubscriptBox["\[Tau]", "2"]}]], 
     RowBox[{
      RowBox[{"L", "(", 
       RowBox[{
        RowBox[{"t", "(", "\[Tau]", ")"}], ",", 
        RowBox[{
         SuperscriptBox["x", "j"], "(", 
         RowBox[{"t", "(", "\[Tau]", ")"}], ")"}], ",", 
        RowBox[{
         FractionBox[
          RowBox[{"d", "\[VeryThinSpace]", 
           RowBox[{
            SuperscriptBox["x", "j"], "(", 
            RowBox[{"t", "(", "\[Tau]", ")"}], ")"}]}], 
          RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}]], 
         FractionBox[
          RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}], 
          RowBox[{"d", "\[VeryThinSpace]", "t"}]]}]}], ")"}], 
      FractionBox[
       RowBox[{"d", "\[VeryThinSpace]", "t"}], 
       RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}]], 
      RowBox[{"\[DifferentialD]", "\[Tau]"}]}]}], "\[Congruent]", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"  ", 
       SubscriptBox["\[Tau]", "1"]}], 
      RowBox[{"  ", 
       SubscriptBox["\[Tau]", "2"]}]], 
     RowBox[{
      RowBox[{"L", "(", 
       RowBox[{
        RowBox[{"t", "(", "\[Tau]", ")"}], ",", 
        RowBox[{
         SuperscriptBox["x", "j"], "(", 
         RowBox[{"t", "(", "\[Tau]", ")"}], ")"}], ",", 
        RowBox[{
         SuperscriptBox[
          OverscriptBox["x", "'"], "j"], 
         FractionBox[
          RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}], 
          RowBox[{"d", "\[VeryThinSpace]", "t"}]]}]}], ")"}], 
      FractionBox[
       RowBox[{"d", "\[VeryThinSpace]", "t"}], 
       RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}]], 
      RowBox[{"\[DifferentialD]", "\[Tau]"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974982697446888*^9, 3.974982726203451*^9}, {
   3.974982761745578*^9, 3.9749828170469646`*^9}, {3.974982854880005*^9, 
   3.97498285488153*^9}, {3.974983117557521*^9, 3.974983123488514*^9}, {
   3.9749833673711653`*^9, 3.974983370049446*^9}, {3.975009389886354*^9, 
   3.975009408840476*^9}, {3.975009585958843*^9, 3.975009607958991*^9}, {
   3.975009798347847*^9, 3.975009826058215*^9}, {3.975010957600933*^9, 
   3.975010968167408*^9}, {3.975011245285583*^9, 3.9750112678249607`*^9}, {
   3.97501132783296*^9, 3.97501134560811*^9}, {3.975011783610755*^9, 
   3.9750117950860243`*^9}, 3.9750118780691833`*^9, {3.975012259082183*^9, 
   3.975012266715372*^9}, {3.975074649017221*^9, 3.9750746851182833`*^9}, {
   3.9750747188669*^9, 3.975074750516808*^9}, {3.975074896480558*^9, 
   3.975074902753097*^9}, {3.975075356480319*^9, 3.975075365472879*^9}},
 CellTags->
  "PARAMETER INVARIANT ACTION \
INTEGRAL",ExpressionUUID->"8afe42f0-e17f-f346-954d-b2fe801c7d3c"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Tau]", "1"], "=", 
    RowBox[{"\[Tau]", "(", 
     SubscriptBox["t", "1"], ")"}]}], TraditionalForm]],ExpressionUUID->
  "fb5ce2fd-862b-0c48-bf43-73a0e93ec9d1"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Tau]", "2"], "=", 
    RowBox[{"\[Tau]", "(", 
     SubscriptBox["t", "2"], ")"}]}], TraditionalForm]],ExpressionUUID->
  "d5448d80-8479-d64d-82b3-4438a064e3fd"],
 " and introducing the over-tick notation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox["x", "'"], "j"], "\[Congruent]", 
    FractionBox[
     RowBox[{"d", "\[VeryThinSpace]", 
      RowBox[{
       SuperscriptBox["x", "j"], "(", 
       RowBox[{"t", "(", "\[Tau]", ")"}], ")"}]}], 
     RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}]]}], TraditionalForm]],
  CellChangeTimes->{{3.974982697446888*^9, 3.974982726203451*^9}, {
    3.974982761745578*^9, 3.9749828170469646`*^9}, {3.974982854880005*^9, 
    3.97498285488153*^9}, {3.974983117557521*^9, 3.974983123488514*^9}, {
    3.9749833673711653`*^9, 3.974983370049446*^9}, {3.975009389886354*^9, 
    3.975009408840476*^9}, {3.975009585958843*^9, 3.975009607958991*^9}, {
    3.975009798347847*^9, 3.975009826058215*^9}, {3.975010957600933*^9, 
    3.975010968167408*^9}, {3.975011245285583*^9, 3.9750112678249607`*^9}, {
    3.97501132783296*^9, 3.97501134560811*^9}, {3.975011783610755*^9, 
    3.9750117950860243`*^9}, 3.9750118780691833`*^9},ExpressionUUID->
  "4e42435b-6d93-aa44-af25-cf0ec7207ea8"],
 ". This is an exact identity by straight substitution, by the chain rule to \
extract ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "\[VeryThinSpace]", 
    RowBox[{"\[Tau]", "/", "d"}], "\[VeryThinSpace]", "t"}], 
   TraditionalForm]],ExpressionUUID->"81b4998a-f385-2341-9830-7b9ea51095c3"],
 " in the last argument slot of ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "ea47e170-52b5-624a-ba98-36a3f24f913a"],
 ", and by a scaling of the differentials ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DifferentialD]", "t"}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"d", "\[VeryThinSpace]", "t"}], 
      RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}]], 
     RowBox[{"\[DifferentialD]", "\[Tau]"}]}]}], TraditionalForm]],
  ExpressionUUID->"df5b5d8e-6854-5748-97cc-4b946d795034"],
 ". It does not entail a new function ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["L", "_"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6e45c708-1e94-4d75-be53-73dceac3e076"],
 " as we might need with coordinate transformations."
}], "Text",
 CellChangeTimes->{{3.974983136629292*^9, 3.974983148808049*^9}, {
  3.975010298823948*^9, 3.975010337709024*^9}, {3.975010715646377*^9, 
  3.975010749426572*^9}, {3.975010791591577*^9, 3.975010870307247*^9}, {
  3.975010920831223*^9, 3.97501093180509*^9}, {3.9750109826350183`*^9, 
  3.975011004138647*^9}, {3.9750118883067713`*^9, 3.9750119310929327`*^9}, {
  3.975012416134727*^9, 3.975012426108098*^9}, {3.97501248634286*^9, 
  3.975012490347302*^9}, {3.975013981489334*^9, 3.975014105797287*^9}, {
  3.975074771728177*^9, 3.975074819062984*^9}, {3.975075111978035*^9, 
  3.975075155039983*^9}, {3.975263611563704*^9, 3.975263612707206*^9}, {
  3.9888787100946083`*^9, 3.988878744641644*^9}, {3.988878851986857*^9, 
  3.9888788538161697`*^9}},ExpressionUUID->"df3365ee-0012-bc45-814d-\
915c9b2a5253"],

Cell[TextData[{
 StyleBox["Insist that ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"d", "\[VeryThinSpace]", "t"}], 
     RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}]], ">", "0"}], 
   TraditionalForm]],ExpressionUUID->"90410dc4-e5dc-b74d-8125-24186e6f9b42"],
 StyleBox[", so that the inverse derivative ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}], 
    RowBox[{"d", "\[VeryThinSpace]", "t"}]], TraditionalForm]],ExpressionUUID->
  "00d0d64e-95a9-024a-9f06-aeb9696d74d8"],
 StyleBox[" exists and so that both parameters go \
\[OpenCurlyDoubleQuote]forward\[CloseCurlyDoubleQuote] under the \
transformation. This condition lets both ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "3c952bee-76d2-e14e-9c37-b0dccc373fe0"],
 " and ",
 StyleBox["\[Tau] model physical time. The transformation can only stretch or \
compress time, not flip it or stall it.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.974984229123076*^9, 3.9749843127913513`*^9}, {
   3.9750763794304743`*^9, 3.975076432499782*^9}, 3.975085411212023*^9, {
   3.975115949995597*^9, 3.975115955766491*^9}, {3.97518363478587*^9, 
   3.975183694203465*^9}, 3.975258162163669*^9, {3.9752636614099503`*^9, 
   3.9752636785205307`*^9}},ExpressionUUID->"21eb4c9f-c3c7-f44a-929f-\
9b6d19ad5df7"],

Cell[TextData[{
 StyleBox["We usually choose \[Tau]  to be ",
  FontSlant->"Italic"],
 StyleBox["relativistic proper time",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[", defined below.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.974984229123076*^9, 3.9749843127913513`*^9}, {
   3.9750763794304743`*^9, 3.975076432499782*^9}, 3.975085411212023*^9, {
   3.975115949995597*^9, 3.975115955766491*^9}, {3.97518363478587*^9, 
   3.975183694203465*^9}},ExpressionUUID->"d34f4858-7bde-1b4b-bbca-\
509c75f26752"],

Cell["\<\
The next objective is to convert the parameter-invariant action integral into \
an identity that has similar functional forms on both sides, but also \
maintains numerical equality, again necessary and sufficient for the two \
integrals to be equal:\
\>", "Text",
 CellChangeTimes->{{3.975015450015749*^9, 3.9750154931063147`*^9}, {
   3.9750748385380583`*^9, 3.975074841908998*^9}, {3.975074927936466*^9, 
   3.9750749373700666`*^9}, {3.975075169441831*^9, 3.975075180856769*^9}, {
   3.975076459971336*^9, 3.975076475765623*^9}, 3.975115983121356*^9, {
   3.975183707478054*^9, 3.975183730594789*^9}, {3.975258230255673*^9, 
   3.975258251638031*^9}, {3.975263696097535*^9, 
   3.975263696987481*^9}},ExpressionUUID->"b0abd511-e537-574b-83f2-\
60b601d7e273"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"  ", 
      SubscriptBox["t", "1"]}], 
     RowBox[{"  ", 
      SubscriptBox["t", "2"]}]], 
    RowBox[{"L", 
     RowBox[{"(", 
      RowBox[{"t", ",", 
       RowBox[{
        SuperscriptBox["x", "j"], 
        RowBox[{"(", "t", ")"}]}], ",", 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["x", "\[FilledSmallCircle]"], "j"], 
        RowBox[{"(", "t", ")"}]}]}], ")"}], 
     RowBox[{"\[DifferentialD]", "t"}]}]}], "=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"  ", 
      SubscriptBox["\[Tau]", "1"]}], 
     RowBox[{"  ", 
      SubscriptBox["\[Tau]", "2"]}]], 
    RowBox[{
     RowBox[{"L", "(", 
      RowBox[{"\[Tau]", ",", 
       RowBox[{
        SuperscriptBox["x", "j"], 
        RowBox[{"(", "\[Tau]", ")"}]}], ",", 
       SuperscriptBox[
        OverscriptBox["x", "'"], "j"]}], ")"}], 
     RowBox[{"\[DifferentialD]", "\[Tau]"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9750154998033457`*^9, 3.975015556756157*^9}, {
  3.975074850016415*^9, 
  3.9750749465625753`*^9}},ExpressionUUID->"34baec6d-a648-3842-891e-\
2e6fed79ab37"],

Cell[TextData[{
 "Notice again that ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "30d48c3f-e03a-7245-940c-7984406b22b4"],
 " is the same on both sides of this equation. No new ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["L", "_"], TraditionalForm]],ExpressionUUID->
  "2b5aff76-7c5e-d844-a9cf-2cf5482f5def"],
 " function here."
}], "Text",
 CellChangeTimes->{{3.975074968541245*^9, 3.975075021851891*^9}, {
   3.9750753173410387`*^9, 3.975075319394211*^9}, 3.9751159894188347`*^9, 
   3.975183760125413*^9, {3.9752582639177313`*^9, 3.975258273391789*^9}, {
   3.975263813051483*^9, 3.975263847755941*^9}, {3.9888789070466347`*^9, 
   3.988878908046485*^9}},ExpressionUUID->"9972f3e9-8c13-dc4b-9ada-\
2dc460b4283c"],

Cell[TextData[{
 "Turns out this is true if and only if ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "6081c5e6-ea24-9c42-b36e-17075fb2d885"],
 " is ",
 StyleBox["homogeneous of degree 1",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " in the velocity argument, meaning that "
}], "Text",
 CellChangeTimes->{{3.975074968541245*^9, 3.975075021851891*^9}, {
   3.9750753173410387`*^9, 3.975075319394211*^9}, 3.9751159894188347`*^9, 
   3.975183760125413*^9, {3.9752582639177313`*^9, 3.975258273391789*^9}, {
   3.975263813051483*^9, 
   3.975263844293096*^9}},ExpressionUUID->"663dffcb-b09e-334a-80aa-\
1ed8f4129434"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"L", "(", 
    RowBox[{"\[Tau]", ",", 
     RowBox[{
      SuperscriptBox["x", "j"], "(", "\[Tau]", ")"}], ",", 
     RowBox[{
      SuperscriptBox[
       OverscriptBox["x", "'"], "j"], 
      FractionBox[
       RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}], 
       RowBox[{"d", "\[VeryThinSpace]", "t"}]]}]}], ")"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}], 
     RowBox[{"d", "\[VeryThinSpace]", "t"}]], 
    RowBox[{"L", "(", 
     RowBox[{"\[Tau]", ",", 
      RowBox[{
       SuperscriptBox["x", "j"], "(", "\[Tau]", ")"}], ",", 
      SuperscriptBox[
       OverscriptBox["x", "'"], "j"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9750750508498487`*^9, 3.975075076545026*^9}, {
  3.975075193390918*^9, 3.975075231982416*^9}},
 CellTags->
  "HOMOGENEITY OF L",ExpressionUUID->"f8145bb6-a796-3042-8241-bf3c452e6a33"],

Cell["\<\
Cancelling the scaling of the differential, we achieve the objective:\
\>", "Text",
 CellChangeTimes->{{3.975075391051817*^9, 3.975075411157175*^9}, 
   3.975258287664915*^9, {3.9752637074216747`*^9, 
   3.975263720067107*^9}},ExpressionUUID->"8a80cd38-cd3e-5d4c-8680-\
d596ee5239f4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"  ", 
      SubscriptBox["\[Tau]", "1"]}], 
     RowBox[{"  ", 
      SubscriptBox["\[Tau]", "2"]}]], 
    RowBox[{"L", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"t", 
        RowBox[{"(", "\[Tau]", ")"}]}], ",", 
       RowBox[{
        SuperscriptBox["x", "j"], 
        RowBox[{"(", 
         RowBox[{"t", 
          RowBox[{"(", "\[Tau]", ")"}]}], ")"}]}], ",", 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["x", "'"], "j"], 
        FractionBox[
         RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}], 
         RowBox[{"d", "\[VeryThinSpace]", "t"}]]}]}], ")"}], 
     FractionBox[
      RowBox[{"d", "\[VeryThinSpace]", "t"}], 
      RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}]], 
     RowBox[{"\[DifferentialD]", "\[Tau]"}]}]}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"  ", 
       SubscriptBox["\[Tau]", "1"]}], 
      RowBox[{"  ", 
       SubscriptBox["\[Tau]", "2"]}]], 
     RowBox[{"L", 
      RowBox[{"(", 
       RowBox[{"\[Tau]", ",", 
        RowBox[{
         SuperscriptBox["x", "j"], 
         RowBox[{"(", "\[Tau]", ")"}]}], ",", 
        SuperscriptBox[
         OverscriptBox["x", "'"], "j"]}], ")"}], 
      FractionBox[
       RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}], 
       RowBox[{"d", "\[VeryThinSpace]", "t"}]], 
      FractionBox[
       RowBox[{"d", "\[VeryThinSpace]", "t"}], 
       RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}]], 
      RowBox[{"\[DifferentialD]", "\[Tau]"}]}]}], "=", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"  ", 
       SubscriptBox["\[Tau]", "1"]}], 
      RowBox[{"  ", 
       SubscriptBox["\[Tau]", "2"]}]], 
     RowBox[{
      RowBox[{"L", "(", 
       RowBox[{"\[Tau]", ",", 
        RowBox[{
         SuperscriptBox["x", "j"], "(", "\[Tau]", ")"}], ",", 
        SuperscriptBox[
         OverscriptBox["x", "'"], "j"]}], ")"}], 
      RowBox[{"\[DifferentialD]", "\[Tau]"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9750754212216587`*^9, 
  3.975075550159708*^9}},ExpressionUUID->"cfde8296-3b75-3a41-ab1b-\
73839045ceb7"],

Cell[TextData[{
 "We have replaced ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "(", "\[Tau]", ")"}], TraditionalForm]],ExpressionUUID->
  "9596e54d-9d6c-8d4a-bf03-205fefd8178f"],
 " with \[Tau]. The stretching or compressing of the clock parameter is \
canceled out via homogeneity of the Lagrangian function, keeping the action \
integral physically meaningful."
}], "Text",
 CellChangeTimes->{{3.975075579849435*^9, 3.975075627965103*^9}, {
  3.975076152853396*^9, 3.97507633507528*^9}, {3.975086426695497*^9, 
  3.975086431060596*^9}, {3.9751160062131567`*^9, 3.975116068436049*^9}, {
  3.975183774967106*^9, 3.975183788290812*^9}, {3.975258295043212*^9, 
  3.975258324334147*^9}, {3.975263737730069*^9, 3.975263795730297*^9}, {
  3.988878937120858*^9, 
  3.988878978762374*^9}},ExpressionUUID->"ce2c0e1a-a1a8-fc46-a16a-\
8a85f2076515"],

Cell[TextData[{
 StyleBox["This is the big result that unlocks gauge invariance",
  FontWeight->"Bold"],
 ". Just as we can choose the width of a rail line, we can choose how we \
measure time."
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.975075579849435*^9, 3.975075627965103*^9}, {
  3.975076152853396*^9, 3.97507633507528*^9}, {3.975086426695497*^9, 
  3.975086431060596*^9}, {3.9751160062131567`*^9, 3.975116068436049*^9}, {
  3.975183774967106*^9, 3.975183788290812*^9}, {3.975258295043212*^9, 
  3.975258324334147*^9}, {3.975263737730069*^9, 3.975263795730297*^9}, {
  3.988878937120858*^9, 3.98887898059021*^9}},
 Background->None,ExpressionUUID->"be7a3cce-0909-4c6e-a680-5df87f118639"],

Cell[TextData[{
 "Since the action is a property of the path itself, which remains unchanged \
when we reparametrize it, values of this ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "2ee9b081-1c51-1940-910f-4e9114c58f3f"],
 " cannot depend explicitly on the parameter. This first argument of ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "fed6bf0f-de17-1649-b6d9-582cd327c0ab"],
 " is only a label, a placeholder for whichever parameter is chosen, allowing \
both numerical and symbolic, formal equality: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"L", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"t", 
        RowBox[{"(", "\[Tau]", ")"}]}], ",", "\[Ellipsis]"}], ")"}]}], "=", 
    RowBox[{"L", 
     RowBox[{"(", 
      RowBox[{"\[Tau]", ",", "\[Ellipsis]"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"558b05a8-f121-5246-a679-b8ae9c0a04e9"],
 "."
}], "Text",
 CellChangeTimes->{{3.975075579849435*^9, 3.975075627965103*^9}, {
  3.975076152853396*^9, 3.97507633507528*^9}, {3.975086426695497*^9, 
  3.975086431060596*^9}, {3.9751160062131567`*^9, 3.9751160503545723`*^9}, {
  3.975116082775176*^9, 3.975116087269779*^9}, {3.975183810651841*^9, 
  3.9751838274982767`*^9}, {3.975258350292062*^9, 3.975258351504442*^9}, {
  3.9888791746988792`*^9, 
  3.988879176862487*^9}},ExpressionUUID->"4a4d1625-6b65-6d43-a7e6-\
33f66045df6a"],

Cell[CellGroupData[{

Cell["Physical Interpretation", "Subsection",
 CellChangeTimes->{{3.975085510179193*^9, 3.97508551465662*^9}, {
  3.975111021936584*^9, 
  3.975111026960497*^9}},ExpressionUUID->"0fd8e536-a5c4-1141-b1b7-\
bf0af322d362"],

Cell[TextData[{
 "The physics is independent of the choice of parameter along the curve ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "2345ecff-ae32-a34e-b473-ac048250169b"],
 " traced out as the coordinates and velocities dynamically evolve. The \
Lagrangian scales exactly with the stretching or compressing of the parameter."
}], "Text",
 CellChangeTimes->{{3.9750855215096807`*^9, 3.975085646954383*^9}, {
  3.975183839803808*^9, 3.975183840155349*^9}, {3.9752583680547*^9, 
  3.9752583704506683`*^9}, {3.988879195324338*^9, 
  3.988879196444029*^9}},ExpressionUUID->"ce4ccd7e-d658-de40-a1b3-\
8c27415105c0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Decoupling Momenta and Velocities", "Section",
 CellChangeTimes->{{3.9750865022226067`*^9, 3.975086517133119*^9}, {
  3.975089736655596*^9, 3.9750897502561007`*^9}, {3.975089868788577*^9, 
  3.9750898740000467`*^9}, {3.9751029260676317`*^9, 3.9751029262846518`*^9}, {
  3.975111032193046*^9, 
  3.975111032345735*^9}},ExpressionUUID->"ebce52e6-475d-5c4b-93e2-\
b1131fb1a31e"],

Cell[TextData[{
 "Write the homogeneity of ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "286e50a1-6e68-fd4b-9f16-eeded2b2428e"],
 " (Equation ",
 
 CounterBox["DisplayFormulaNumbered", "HOMOGENEITY OF L"],
 ") in the velocity argument more generally, removing unnecessary references \
to the parameter. Homogeneity is independent of choice of parameter; it is an \
intrinsic property of a parameter-invariant Lagrangian:"
}], "Text",
 CellChangeTimes->{{3.97508677374048*^9, 3.975086850174284*^9}, {
  3.975086957065179*^9, 3.975086973933506*^9}, {3.9750878770425863`*^9, 
  3.975087889429669*^9}, {3.975088698376212*^9, 3.975088709476913*^9}, {
  3.9750891829269*^9, 3.975089219234309*^9}, {3.97525839487376*^9, 
  3.975258399571142*^9}},ExpressionUUID->"41d69c8b-fac5-f04d-8785-\
8caf7f7fce04"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"L", "(", 
    RowBox[{
     SuperscriptBox["x", "j"], ",", 
     RowBox[{
      StyleBox["\[Lambda]",
       Background->RGBColor[0.93, 0.27, 0.27, 0.33]], 
      SuperscriptBox[
       OverscriptBox["x", "'"], "j"]}]}], ")"}], "=", 
   RowBox[{
    StyleBox["\[Lambda]",
     Background->RGBColor[0.93, 0.27, 0.27, 0.33]], " ", 
    RowBox[{"L", "(", 
     RowBox[{
      SuperscriptBox["x", "j"], ",", 
      SuperscriptBox[
       OverscriptBox["x", "'"], "j"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.975086852826702*^9, 3.975086882206843*^9}, {
  3.975086978082519*^9, 3.975086990482007*^9}, {3.9750870314567738`*^9, 
  3.975087031458544*^9}},ExpressionUUID->"bfcd5db8-112b-3341-a3d7-\
00fac278b273"],

Cell["Differentiate both sides with respect to \[Lambda] and set \[Lambda] to \
1:", "Text",
 CellChangeTimes->{{3.975086887718452*^9, 3.9750869042706738`*^9}, {
  3.9750871906829767`*^9, 3.9750871929367037`*^9}, {3.975088715914453*^9, 
  3.975088725468787*^9}},ExpressionUUID->"93f9c80b-abeb-bd44-8f35-\
a143dfd05050"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{
     RowBox[{
      SubscriptBox[
       RowBox[{
        FractionBox[
         RowBox[{"\[PartialD]", 
          RowBox[{"L", "(", 
           RowBox[{
            SuperscriptBox["x", "j"], ",", 
            RowBox[{"\[Lambda]", 
             SuperscriptBox[
              OverscriptBox["x", "'"], "j"]}]}], ")"}]}], 
         RowBox[{"\[PartialD]", "\[Lambda]"}]], "\[RightBracketingBar]"}], 
       RowBox[{"\[Lambda]", "=", "1"}]], "=", 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", 
         RowBox[{"L", "(", 
          RowBox[{
           SuperscriptBox["x", "j"], ",", 
           RowBox[{"\[Lambda]", 
            SuperscriptBox[
             OverscriptBox["x", "'"], "j"]}]}], ")"}]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "'"], "k"]}]], 
       SuperscriptBox[
        OverscriptBox["x", "'"], "k"]}]}], "\[RightBracketingBar]"}], 
    RowBox[{"\[Lambda]", "=", "1"}]], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", "L"}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "'"], "k"]}]], 
     SuperscriptBox[
      OverscriptBox["x", "'"], "k"]}], "=", 
    RowBox[{"L", "(", 
     RowBox[{
      SuperscriptBox["x", "j"], ",", 
      SuperscriptBox[
       OverscriptBox["x", "'"], "j"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.975086852826702*^9, 3.975086882206843*^9}, {
   3.975086978082519*^9, 3.975086990482007*^9}, {3.9750870314567738`*^9, 
   3.975087109795497*^9}, {3.975087140009284*^9, 3.975087152833207*^9}, {
   3.9750872000456877`*^9, 3.975087204070037*^9}, {3.975087327792973*^9, 
   3.975087380401813*^9}, {3.975087410782886*^9, 3.975087425149063*^9}, 
   3.975089237977375*^9},ExpressionUUID->"422c9df0-f7c8-284b-b6ee-\
ee40a32ca749"],

Cell[TextData[{
 "dropping the argument notation from ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "7ee9671d-72df-f045-891b-238171c21945"],
 ". Recognizing the conjugate momenta ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "k"], TraditionalForm]],ExpressionUUID->
  "5c1bd058-2d6e-f34b-98ed-d75f1c5f3d4d"],
 ", we get:"
}], "Text",
 CellChangeTimes->{{3.975087956047304*^9, 3.975087956103231*^9}, {
  3.9750881824682007`*^9, 3.975088241606574*^9}, {3.975089241128622*^9, 
  3.975089256356154*^9}},ExpressionUUID->"83a59277-d100-b54f-b874-\
f7f1cd43c544"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["p", "k"], 
    SuperscriptBox[
     OverscriptBox["x", "'"], "k"]}], "=", "L"}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.975086852826702*^9, 3.975086882206843*^9}, {
   3.975086978082519*^9, 3.975086990482007*^9}, {3.9750870314567738`*^9, 
   3.975087109795497*^9}, {3.975087140009284*^9, 3.975087152833207*^9}, {
   3.9750872000456877`*^9, 3.975087204070037*^9}, {3.975087327792973*^9, 
   3.975087380401813*^9}, {3.975087410782886*^9, 3.975087425149063*^9}, {
   3.9750875542762136`*^9, 3.975087561030364*^9}, 3.975088178597602*^9},
 CellTags->
  "EULER'S IDENTITY",ExpressionUUID->"bd53a194-b20b-164e-aa4e-53c7640ba301"],

Cell[TextData[{
 StyleBox["This is the identifying signal of a parameter-independent theory. \
It means that the Lagrangian is its own ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Legendre transform",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Legendre_transformation"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Legendre_transformation"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[", and also that the Hamiltonian vanishes (see below)! Fear not, \
however, if you believe that the Hamiltonian is energy. Energy does not \
vanish, it just becomes the 0\[NoBreak]-\[NoBreak]th component of \
4\[NoBreak]-\[NoBreak]momentum, as we see below. This is the first indication \
that we\[CloseCurlyQuote]re going to get relativity \
\[OpenCurlyDoubleQuote]for free\[CloseCurlyDoubleQuote] as an unavoidable \
consequence of parameter invariance.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.975116388504389*^9, 3.975116490425993*^9}, {
  3.975116533067775*^9, 3.975116536994647*^9}, {3.975183879332247*^9, 
  3.9751839360722513`*^9}, {3.975263920601037*^9, 3.9752639620968*^9}, {
  3.988879258636795*^9, 
  3.9888793456950293`*^9}},ExpressionUUID->"342e58aa-df7d-4741-a334-\
5d4baf39259b"],

Cell[TextData[{
 "Differentiate one more time with respect to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "'"], "j"], TraditionalForm]],
  CellChangeTimes->{{3.975086852826702*^9, 3.975086882206843*^9}, {
   3.975086978082519*^9, 3.975086990482007*^9}, {3.9750870314567738`*^9, 
   3.975087109795497*^9}, {3.975087140009284*^9, 3.975087152833207*^9}, {
   3.9750872000456877`*^9, 3.975087204070037*^9}, {3.975087327792973*^9, 
   3.975087380401813*^9}, {3.975087410782886*^9, 3.975087425149063*^9}},
  ExpressionUUID->"18c40ac5-2f86-db49-89bc-dcb9a242c6d8"],
 ", noting that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "'"], "k"]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "'"], "j"]}]], "=", 
    SuperscriptBox[
     SubscriptBox["\[Delta]", "j"], "k"]}], TraditionalForm]],
  CellChangeTimes->{{3.975086852826702*^9, 3.975086882206843*^9}, {
   3.975086978082519*^9, 3.975086990482007*^9}, {3.9750870314567738`*^9, 
   3.975087109795497*^9}, {3.975087140009284*^9, 3.975087152833207*^9}, {
   3.9750872000456877`*^9, 3.975087204070037*^9}, {3.975087327792973*^9, 
   3.975087380401813*^9}, {3.975087410782886*^9, 3.975087425149063*^9}, {
   3.975087968507455*^9, 3.975088155733224*^9}, {3.9750882074817963`*^9, 
   3.975088219497282*^9}, {3.975088295396545*^9, 3.975088317784683*^9}},
  ExpressionUUID->"86647b91-3f96-2249-a65b-97820ddfc294"],
 ":"
}], "Text",
 CellChangeTimes->{{3.97508790755663*^9, 3.97508794957965*^9}, {
  3.975088796872802*^9, 
  3.975088829930591*^9}},ExpressionUUID->"013f69d1-645a-af48-80f4-\
f186dfceb3af"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[PartialD]", "L"}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox[
      OverscriptBox["x", "'"], "j"]}]], "=", 
   RowBox[{
    RowBox[{
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "'"], "j"]}]], 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", "L"}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "'"], "k"]}]], 
       SuperscriptBox[
        OverscriptBox["x", "'"], "k"]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], "L"}], 
        RowBox[{
         RowBox[{"\[PartialD]", 
          SuperscriptBox[
           OverscriptBox["x", "'"], "j"]}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox[
           OverscriptBox["x", "'"], "k"]}]}]], 
       SuperscriptBox[
        OverscriptBox["x", "'"], "k"]}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", "L"}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "'"], "k"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "'"], "k"]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox[
          OverscriptBox["x", "'"], "j"]}]]}]}], "=", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], "L"}], 
        RowBox[{
         RowBox[{"\[PartialD]", 
          SuperscriptBox[
           OverscriptBox["x", "'"], "j"]}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox[
           OverscriptBox["x", "'"], "k"]}]}]], 
       SuperscriptBox[
        OverscriptBox["x", "'"], "k"]}], "+", 
      FractionBox[
       RowBox[{"\[PartialD]", "L"}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox[
         OverscriptBox["x", "'"], "j"]}]]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.975086852826702*^9, 3.975086882206843*^9}, {
  3.975086978082519*^9, 3.975086990482007*^9}, {3.9750870314567738`*^9, 
  3.975087109795497*^9}, {3.975087140009284*^9, 3.975087152833207*^9}, {
  3.9750872000456877`*^9, 3.975087204070037*^9}, {3.975087327792973*^9, 
  3.975087380401813*^9}, {3.975087410782886*^9, 3.975087425149063*^9}, {
  3.975087968507455*^9, 3.975088155733224*^9}, {3.9750882074817963`*^9, 
  3.975088219497282*^9}, {3.975088295396545*^9, 3.975088317784683*^9}, {
  3.975184003791774*^9, 
  3.9751840428424797`*^9}},ExpressionUUID->"ba62a575-59b6-fd4a-a8f6-\
6a683a54a3b4"],

Cell["Implying", "Text",
 CellChangeTimes->{{3.9750883251784143`*^9, 
  3.9750883267903*^9}},ExpressionUUID->"191a3574-c646-4648-8cd7-64661708a76b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["\[PartialD]", "2"], "L"}], 
     RowBox[{
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "'"], "j"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "'"], "k"]}]}]], 
    SuperscriptBox[
     OverscriptBox["x", "'"], "k"]}], "=", "0"}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.975086852826702*^9, 3.975086882206843*^9}, {
  3.975086978082519*^9, 3.975086990482007*^9}, {3.9750870314567738`*^9, 
  3.975087109795497*^9}, {3.975087140009284*^9, 3.975087152833207*^9}, {
  3.9750872000456877`*^9, 3.975087204070037*^9}, {3.975087327792973*^9, 
  3.975087380401813*^9}, {3.975087410782886*^9, 3.975087425149063*^9}, {
  3.975087968507455*^9, 3.975088155733224*^9}, {3.9750882074817963`*^9, 
  3.975088219497282*^9}, {3.975088295396545*^9, 
  3.975088351201921*^9}},ExpressionUUID->"c76b4f3e-6752-3c4a-930d-\
9af2f652ae0f"],

Cell["or", "Text",
 CellChangeTimes->{{3.9750883567221117`*^9, 
  3.975088356784327*^9}},ExpressionUUID->"e33c69ed-9d7c-2743-8640-\
f67245b308c4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SubscriptBox["p", "k"]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "'"], "j"]}]], 
    SuperscriptBox[
     OverscriptBox["x", "'"], "k"]}], "=", "0"}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.975086852826702*^9, 3.975086882206843*^9}, {
  3.975086978082519*^9, 3.975086990482007*^9}, {3.9750870314567738`*^9, 
  3.975087109795497*^9}, {3.975087140009284*^9, 3.975087152833207*^9}, {
  3.9750872000456877`*^9, 3.975087204070037*^9}, {3.975087327792973*^9, 
  3.975087380401813*^9}, {3.975087410782886*^9, 3.975087425149063*^9}, {
  3.975087968507455*^9, 3.975088155733224*^9}, {3.9750882074817963`*^9, 
  3.975088219497282*^9}, {3.975088295396545*^9, 3.975088351201921*^9}, {
  3.975088420557892*^9, 
  3.975088432390218*^9}},ExpressionUUID->"f4eb8ee8-313b-1b4e-be86-\
00ce16fe05e1"],

Cell[TextData[{
 "That ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], "L"}], 
      RowBox[{
       RowBox[{"\[PartialD]", 
        SuperscriptBox[
         OverscriptBox["x", "'"], "j"]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox[
         OverscriptBox["x", "'"], "k"]}]}]], 
     SuperscriptBox[
      OverscriptBox["x", "'"], "k"]}], "=", "0"}], TraditionalForm]], 
  "DisplayFormulaNumbered",
  CellChangeTimes->{{3.975086852826702*^9, 3.975086882206843*^9}, {
   3.975086978082519*^9, 3.975086990482007*^9}, {3.9750870314567738`*^9, 
   3.975087109795497*^9}, {3.975087140009284*^9, 3.975087152833207*^9}, {
   3.9750872000456877`*^9, 3.975087204070037*^9}, {3.975087327792973*^9, 
   3.975087380401813*^9}, {3.975087410782886*^9, 3.975087425149063*^9}, {
   3.975087968507455*^9, 3.975088155733224*^9}, {3.9750882074817963`*^9, 
   3.975088219497282*^9}, {3.975088295396545*^9, 3.975088351201921*^9}},
  ExpressionUUID->"3b94dbe1-2367-8141-a924-3a77a5f02e8b"],
 " means there is a non-zero vector ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "'"], "k"], TraditionalForm]],
  CellChangeTimes->{{3.975086852826702*^9, 3.975086882206843*^9}, {
   3.975086978082519*^9, 3.975086990482007*^9}, {3.9750870314567738`*^9, 
   3.975087109795497*^9}, {3.975087140009284*^9, 3.975087152833207*^9}, {
   3.9750872000456877`*^9, 3.975087204070037*^9}, {3.975087327792973*^9, 
   3.975087380401813*^9}, {3.975087410782886*^9, 3.975087425149063*^9}, {
   3.975087968507455*^9, 3.975088155733224*^9}, {3.9750882074817963`*^9, 
   3.975088219497282*^9}, {3.975088295396545*^9, 3.975088351201921*^9}},
  ExpressionUUID->"24253e68-d7fe-5f40-9727-61ad65d958df"],
 " in the null space of the Hessian ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], "L"}], 
    RowBox[{
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "'"], "j"]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "'"], "k"]}]}]], TraditionalForm]],
  CellChangeTimes->{{3.975086852826702*^9, 3.975086882206843*^9}, {
   3.975086978082519*^9, 3.975086990482007*^9}, {3.9750870314567738`*^9, 
   3.975087109795497*^9}, {3.975087140009284*^9, 3.975087152833207*^9}, {
   3.9750872000456877`*^9, 3.975087204070037*^9}, {3.975087327792973*^9, 
   3.975087380401813*^9}, {3.975087410782886*^9, 3.975087425149063*^9}, {
   3.975087968507455*^9, 3.975088155733224*^9}, {3.9750882074817963`*^9, 
   3.975088219497282*^9}, {3.975088295396545*^9, 3.975088351201921*^9}},
  ExpressionUUID->"34730e99-fab6-c04e-85cd-723412f86e4f"],
 ", further meaning that the Hessian is singular. By the ",
 StyleBox[ButtonBox["inverse function theorem",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Inverse_function_theorem"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Inverse_function_theorem"],
  FontVariations->{"Underline"->True}],
 ", we cannot solve the algebraic system ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["p", "k"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "'"], "j"]}]], 
     SuperscriptBox[
      OverscriptBox["x", "'"], "k"]}], "=", "0"}], TraditionalForm]],
  CellChangeTimes->{{3.975086852826702*^9, 3.975086882206843*^9}, {
   3.975086978082519*^9, 3.975086990482007*^9}, {3.9750870314567738`*^9, 
   3.975087109795497*^9}, {3.975087140009284*^9, 3.975087152833207*^9}, {
   3.9750872000456877`*^9, 3.975087204070037*^9}, {3.975087327792973*^9, 
   3.975087380401813*^9}, {3.975087410782886*^9, 3.975087425149063*^9}, {
   3.975087968507455*^9, 3.975088155733224*^9}, {3.9750882074817963`*^9, 
   3.975088219497282*^9}, {3.975088295396545*^9, 3.975088351201921*^9}, {
   3.975088420557892*^9, 3.975088432390218*^9}},ExpressionUUID->
  "5f7e9cf8-6cfb-f746-b1f0-6807054c1a17"],
 " for all velocities ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "'"], "j"], TraditionalForm]],ExpressionUUID->
  "17d9930c-8aed-884c-9dd7-0f4b65bb4543"],
 " in terms of the generalized momenta ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "k"], TraditionalForm]],ExpressionUUID->
  "b51a7f34-e51b-5e46-b27b-19ca67b83aa4"],
 "."
}], "Text",
 CellChangeTimes->{{3.975088530182931*^9, 3.9750885884311113`*^9}, 
   3.975089272014996*^9, {3.975089600597219*^9, 3.975089718072019*^9}, {
   3.975116340603706*^9, 3.97511634060462*^9}, {3.975263976815732*^9, 
   3.975263992037407*^9}, {3.975283736153469*^9, 3.9752837854049807`*^9}, 
   3.975283865748666*^9},ExpressionUUID->"ed8fec1e-9156-b44d-a540-\
e4e4a4737c42"],

Cell[TextData[{
 StyleBox["Because the Hessian is singular, the ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   StyleBox["n",
    FontSlant->"Plain"], TraditionalForm]],ExpressionUUID->
  "f8b3b739-a274-bb44-a034-01369f8f678b"],
 StyleBox[" components of momentum are not algebraically independent; they \
are constrained to a surface of dimension ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "1"}], TraditionalForm]],ExpressionUUID->
  "716d8023-eb4a-3240-99cb-541df379b200"],
 StyleBox[" or less. This is why the mass-shell condition ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["p", "2"], "=", 
    SuperscriptBox["m", "2"]}], TraditionalForm]],ExpressionUUID->
  "74704f7c-4d5e-2248-903f-94a7d2ff05f4"],
 ", redefining energy (!),",
 StyleBox[" must exist\[LongDash]it is the defining condition of the narrow \
space into which the momenta have been squashed.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9751165703978987`*^9, 3.9751166494710627`*^9}, {
  3.975116729708312*^9, 3.975116729709704*^9}, {3.975258515535715*^9, 
  3.9752585646138773`*^9}, {3.975263997428884*^9, 
  3.975264023560367*^9}},ExpressionUUID->"aba91c88-2b07-744c-8822-\
596f14013718"],

Cell[TextData[{
 StyleBox["The ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Hessian",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Hessian_matrix"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Hessian_matrix"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[" ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], "L"}], 
    RowBox[{
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "'"], "j"]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox[
       OverscriptBox["x", "'"], "k"]}]}]], TraditionalForm]],
  CellChangeTimes->{{3.975086852826702*^9, 3.975086882206843*^9}, {
   3.975086978082519*^9, 3.975086990482007*^9}, {3.9750870314567738`*^9, 
   3.975087109795497*^9}, {3.975087140009284*^9, 3.975087152833207*^9}, {
   3.9750872000456877`*^9, 3.975087204070037*^9}, {3.975087327792973*^9, 
   3.975087380401813*^9}, {3.975087410782886*^9, 3.975087425149063*^9}, {
   3.975087968507455*^9, 3.975088155733224*^9}, {3.9750882074817963`*^9, 
   3.975088219497282*^9}, {3.975088295396545*^9, 3.975088351201921*^9}},
  ExpressionUUID->"2e69ed0b-624c-cb46-bfb1-e825a8a12bb2"],
 StyleBox["\:200b is simply the Jacobian of the transformation from \
velocity-space to momentum-space, and that\[CloseCurlyQuote]s the algebraic \
link.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9751165703978987`*^9, 3.9751166494710627`*^9}, {
  3.9751167308266287`*^9, 3.9751167540598507`*^9}, {3.97518409074269*^9, 
  3.975184090743319*^9}, {3.975264039969993*^9, 
  3.97526404856779*^9}},ExpressionUUID->"37fe4cbf-8033-d143-9863-\
c5383e083bbe"],

Cell[TextData[StyleBox["This failure is a feature, not a bug: it indicates \
redundant degrees of freedom, leading to gauge. The evolution of the \
unphysical components is arbitrary, corresponding to our freedom to choose a \
gauge.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.975283913281158*^9, 
  3.975283956065467*^9}},ExpressionUUID->"a31e3707-cc95-504a-9a4b-\
091703cfc051"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Mass-Shell Condition and Vanishing Hamiltonian", "Section",
 CellChangeTimes->{{3.975116846375251*^9, 
  3.975116860562355*^9}},ExpressionUUID->"a0a69e89-454f-b945-a7dc-\
619cad988b91"],

Cell[TextData[{
 "Because the mapping from velocity space to momentum space is \
non-invertible, the momenta ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "k"], TraditionalForm]],ExpressionUUID->
  "0fac03ca-e11e-434d-9cf2-faced0d4deca"],
 "\:200b are not algebraically independent of one another. They are \
geometrically squashed onto a lower-dimensional surface within the cotangent \
space. This restriction manifests as an ",
 StyleBox["algebraic constraint",
  FontSlant->"Italic"],
 " called the ",
 StyleBox["Primary Constraint",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9751168820723658`*^9, 3.9751168951665697`*^9}, {
  3.975118562625165*^9, 3.975118562872199*^9}, {3.975184226463357*^9, 
  3.975184228727003*^9}, {3.975258809366528*^9, 3.9752588186081448`*^9}, {
  3.975264064555455*^9, 
  3.975264090994729*^9}},ExpressionUUID->"132ae45a-5a1a-9146-9981-\
87b13f060ba9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Phi]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["p", "k"], "\:200b"}], ",", 
      SuperscriptBox["x", "k"]}], ")"}]}], "=", "0"}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9751169101551847`*^9, 
  3.9751169468740664`*^9}},ExpressionUUID->"e56cc298-7097-904b-8c3c-\
71bfe3df167a"],

Cell[CellGroupData[{

Cell["The Leap to Special Relativity", "Subsection",
 CellChangeTimes->{{3.975118527230133*^9, 
  3.975118535766699*^9}},ExpressionUUID->"962a6140-bf3c-aa40-b049-\
a3525a2d5bc7"],

Cell[TextData[{
 "Consider the Lagrangian for a relativistic free particle of mass ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "448b1c4a-7c71-574f-8f0a-5fde9526381d"],
 ". This is the canonical example of a parameter-invariant \
(homogenous-degree-1) system:"
}], "Text",
 CellChangeTimes->{{3.97511697799452*^9, 3.975116995041943*^9}, {
  3.975258851988741*^9, 
  3.975258865049584*^9}},ExpressionUUID->"164b4ad0-1e62-2342-bb2c-\
13fbe3bd7fcb"],

Cell[BoxData[
 FormBox[
  RowBox[{"L", "=", 
   RowBox[{"m", 
    SqrtBox[
     RowBox[{
      SubscriptBox["\[Eta]", 
       RowBox[{"\[Mu]", "\[Vee]"}]], 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], "\[Mu]"], 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], "\[Nu]"]}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.975117024858026*^9, 3.9751170871817837`*^9}, {
  3.975117555659452*^9, 3.975117582436452*^9}, {3.975185230543975*^9, 
  3.9751852305460663`*^9}},ExpressionUUID->"b9448e19-b1f0-fe4e-80b7-\
2df0a22acdf4"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Eta]", 
     RowBox[{"\[Mu]", "\[Vee]"}]], "=", 
    RowBox[{"diag", "(", 
     RowBox[{"1", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "4b050201-e7ab-4740-bf6f-45e0956d1085"],
 ", the Minkowski metric."
}], "Text",
 CellChangeTimes->{{3.975117345789403*^9, 
  3.975117380609253*^9}},ExpressionUUID->"8d2dcb22-3c21-de4b-acec-\
1964732f9b64"],

Cell[TextData[{
 StyleBox["Up to this point, our discussion of the manifold ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "n"], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"9be54862-38c6-654e-ba6d-9630bd54a8a1"],
 StyleBox["\:200b has been purely topological\[LongDash]we have not described \
how to measure distance or \[OpenCurlyDoubleQuote]length\
\[CloseCurlyDoubleQuote] along a path. A realistic Lagrangian of a free \
particle should depend only on its velocities, just as in Classical \
Mechanics. If we further require parameter-invariance, so that the geometric \
history of the particle doesn\[CloseCurlyQuote]t depend on our choice of \
clock, we must find a Lagrangian that is homogeneous of degree 1 in the \
velocities. The most natural candidate for such a function is the arc-length \
of the curve .",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.975117250238267*^9, 3.9751173113361177`*^9}, {
  3.97511739113669*^9, 3.9751173941349993`*^9}, {3.975117464663682*^9, 
  3.975117524173565*^9}, {3.975117590994615*^9, 3.975117832347253*^9}, {
  3.975117866446406*^9, 3.975117883127335*^9}, {3.975117913704686*^9, 
  3.97511793433703*^9}, {3.9751179793449097`*^9, 3.9751179948704844`*^9}, {
  3.975118594354764*^9, 3.975118718251616*^9}, {3.975184258204239*^9, 
  3.975184392987221*^9}, {3.9751844366302433`*^9, 3.975184486350479*^9}, {
  3.9751845175844727`*^9, 3.975184581786214*^9}, {3.975258890232802*^9, 
  3.975258903502274*^9}, {3.975258940907083*^9, 3.975259001516987*^9}, {
  3.975264123330277*^9, 3.975264169990425*^9}, {3.9752642026150503`*^9, 
  3.975264215015449*^9}},ExpressionUUID->"66dc14e4-17f8-9547-a71e-\
95de122e9342"],

Cell[TextData[StyleBox["Turns out this is also the optimal candidate, by some \
definition of \[OpenCurlyDoubleQuote]optimal.\[CloseCurlyDoubleQuote]",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.975117250238267*^9, 3.9751173113361177`*^9}, {
  3.97511739113669*^9, 3.9751173941349993`*^9}, {3.975117464663682*^9, 
  3.975117524173565*^9}, {3.975117590994615*^9, 3.975117832347253*^9}, {
  3.975117866446406*^9, 3.975117883127335*^9}, {3.975117913704686*^9, 
  3.97511793433703*^9}, {3.9751179793449097`*^9, 3.9751179948704844`*^9}, {
  3.975118594354764*^9, 3.975118718251616*^9}, {3.975184258204239*^9, 
  3.975184392987221*^9}, {3.9751844366302433`*^9, 3.975184486350479*^9}, {
  3.9751845175844727`*^9, 3.975184581786214*^9}, {3.975258890232802*^9, 
  3.975258903502274*^9}, {3.975258940907083*^9, 3.975259001516987*^9}, {
  3.975264123330277*^9, 3.975264169990425*^9}, {3.975264204839388*^9, 
  3.975264209390123*^9}, {3.988880203681984*^9, 
  3.988880206356805*^9}},ExpressionUUID->"3fb823f9-8dd1-0f42-aef6-\
cb4b8045d3bb"],

Cell[TextData[{
 StyleBox["To define \[OpenCurlyDoubleQuote]length\[CloseCurlyDoubleQuote] \
when Newtonian time is demoted to an ordinary coordinate, we introduce a ",
  FontSlant->"Italic"],
 StyleBox["metric tensor",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[". In the flat\[NoBreak] space-time of Special Relativity, that\
\[CloseCurlyQuote]s the Minkowski metric, the \[OpenCurlyDoubleQuote]ruler\
\[CloseCurlyDoubleQuote] for measuring proper distance in the manifold. It \
lets the Lagrangian also be a Lorentz-invariant scalar quantity. By defining \
the Lagrangian as the square root of the squared magnitude of the velocity \
vector\:200b, we satisfy two requirements at once: (1) the action is computed \
from geometrical intervals along the path by the ",
  FontSlant->"Italic"],
 StyleBox["proper time",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[", and (2) square root structure ensures homogeneity of degree 1. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.975117250238267*^9, 3.9751173113361177`*^9}, {
   3.97511739113669*^9, 3.9751173941349993`*^9}, {3.975117464663682*^9, 
   3.975117524173565*^9}, {3.975117590994615*^9, 3.975117832347253*^9}, {
   3.975117866446406*^9, 3.975117883127335*^9}, {3.975117913704686*^9, 
   3.97511793433703*^9}, {3.9751179793449097`*^9, 3.9751179948704844`*^9}, {
   3.975118594354764*^9, 3.975118718251616*^9}, {3.975184258204239*^9, 
   3.975184392987221*^9}, {3.9751844366302433`*^9, 3.975184486350479*^9}, {
   3.9751845175844727`*^9, 3.975184581786214*^9}, {3.975258890232802*^9, 
   3.975258903502274*^9}, {3.975258940907083*^9, 3.975259074270204*^9}, {
   3.9752591098742313`*^9, 3.975259143660277*^9}, {3.975264227956685*^9, 
   3.975264269188141*^9}, 3.9752643024969387`*^9, {3.988880231295864*^9, 
   3.988880241324637*^9}},ExpressionUUID->"ed1e531d-7c36-394c-84b7-\
d23cf3943843"],

Cell[TextData[StyleBox["This leap into Special Relativity doesn\
\[CloseCurlyQuote]t just change formulas. We are choosing the specific \
geometry that allows our parameter-invariant machinery to produce the \
energy-momentum relations of the real world.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.975117250238267*^9, 3.9751173113361177`*^9}, {
  3.97511739113669*^9, 3.9751173941349993`*^9}, {3.975117464663682*^9, 
  3.975117524173565*^9}, {3.975117590994615*^9, 3.975117832347253*^9}, {
  3.975117866446406*^9, 3.975117883127335*^9}, {3.975117913704686*^9, 
  3.97511793433703*^9}, {3.9751179793449097`*^9, 3.9751179948704844`*^9}, {
  3.975118594354764*^9, 3.975118718251616*^9}, {3.975184258204239*^9, 
  3.975184392987221*^9}, {3.9751844366302433`*^9, 3.975184486350479*^9}, {
  3.9751845175844727`*^9, 3.975184581786214*^9}, {3.975258890232802*^9, 
  3.975258903502274*^9}, {3.975258940907083*^9, 3.975259074270204*^9}, {
  3.9752591098742313`*^9, 3.975259143660277*^9}, {3.975264227956685*^9, 
  3.975264269188141*^9}},ExpressionUUID->"910dc462-f7a9-2c40-a0f9-\
6199f244ead6"],

Cell[TextData[{
 "The conjugate momenta, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "\[Mu]"], "=", 
    FractionBox[
     RowBox[{"\[PartialD]", "L"}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Mu]"]}]]}], TraditionalForm]],ExpressionUUID->
  "ff9f07a4-bfa4-554f-bd8f-8adcfc701d02"],
 ", are"
}], "Text",
 CellChangeTimes->{{3.975118025959139*^9, 
  3.9751180696414633`*^9}},ExpressionUUID->"c3d3ef91-75f7-584f-b6c3-\
2c3fd52e5993"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["p", "\[Mu]"], "=", 
   FractionBox[
    RowBox[{"m", " ", 
     SubscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], "\[Mu]"]}], 
    SqrtBox[
     RowBox[{
      SubscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], "\[Alpha]"], 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], "\[Alpha]"]}]]]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.975118075263391*^9, 3.975118110202866*^9}, {
  3.975118264442594*^9, 3.975118297597643*^9}, {3.975118333134039*^9, 
  3.975118333136695*^9}, {3.975259495088297*^9, 3.975259502486175*^9}},
 CellTags->
  "INDEX LOWERING",ExpressionUUID->"390106ef-0f5c-b24d-b29f-99ce4b6a5895"],

Cell[TextData[{
 StyleBox["In Equation ",
  FontSlant->"Italic"],
 StyleBox[
 CounterBox["DisplayFormulaNumbered", "INDEX LOWERING"],
  FontSlant->"Italic"],
 StyleBox[", we transitioned the \[OpenCurlyDoubleQuote]up\
\[CloseCurlyDoubleQuote] indices of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Eta]", 
     RowBox[{"\[Mu]", "\[Vee]"}]], 
    SuperscriptBox[
     OverscriptBox["x", "\[FilledSmallCircle]"], "\[Mu]"], 
    SuperscriptBox[
     OverscriptBox["x", "\[FilledSmallCircle]"], "\[Nu]"]}], TraditionalForm]],
  CellChangeTimes->{{3.975117024858026*^9, 3.9751170871817837`*^9}, {
   3.975117555659452*^9, 3.975117582436452*^9}, {3.975185230543975*^9, 
   3.9751852305460663`*^9}},ExpressionUUID->
  "2aaeefe3-2fe2-504d-bf98-b75aa039cb5c"],
 StyleBox[" to one down and one up, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["x", "\[FilledSmallCircle]"], "\[Alpha]"], 
    SuperscriptBox[
     OverscriptBox["x", "\[FilledSmallCircle]"], "\[Alpha]"]}], 
   TraditionalForm]],
  CellChangeTimes->{{3.975118075263391*^9, 3.975118110202866*^9}, {
   3.975118264442594*^9, 3.975118297597643*^9}, {3.975118333134039*^9, 
   3.975118333136695*^9}},ExpressionUUID->
  "5662f7de-7c00-7843-afe6-e4c368ad27ab"],
 ", absorbing ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Eta]", 
    RowBox[{"\[Mu]", "\[Vee]"}]], TraditionalForm]],
  CellChangeTimes->{{3.975117024858026*^9, 3.9751170871817837`*^9}, {
   3.975117555659452*^9, 3.975117582436452*^9}, {3.975185230543975*^9, 
   3.9751852305460663`*^9}},ExpressionUUID->
  "b4827486-0074-9e4f-b0e8-379d9ea6fdc2"],
 StyleBox[" in the offing, with renaming of the dummy indices. Of course, \
both expressions suffer the summation convention over repeated down-up pairs. \
In tensor calculus, this is not a mere change of notation, but a geometric \
operation: ",
  FontSlant->"Italic"],
 StyleBox["index raising or lowering.",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" Recall that velocity ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "\[Mu]"], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"aa62a3fe-e09d-7e4a-ba9f-a723df25b696"],
 StyleBox[" is a contravariant vector in the tangent space. However, \
conjugate momentum ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "\[Mu]"], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"775a5297-3ed2-6e42-801f-15b8df7204b0"],
 StyleBox["\:200b is a covariant covector in the cotangent space. To relate \
the two, we need a bridge between the tangent space and the cotangent space. \
The metric tensor ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Eta]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "=", 
    RowBox[{"diag", "(", 
     RowBox[{"1", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], ")"}]}], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"26b534b7-9f24-d044-9b1c-60234c359740"],
 StyleBox["\:200b is that bridge. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{
  3.975119831143009*^9, {3.975184662703115*^9, 3.975184815543045*^9}, {
   3.975184911844698*^9, 3.975184955495656*^9}, {3.975185009853169*^9, 
   3.97518508371194*^9}, {3.975185114983563*^9, 3.975185188953657*^9}, {
   3.9751852476235123`*^9, 3.97518525285209*^9}, {3.9751852884919662`*^9, 
   3.9751855791383657`*^9}, {3.9751856162025757`*^9, 
   3.9751856223215637`*^9}, {3.975185664120289*^9, 3.975185731318853*^9}, 
   3.9751892784048862`*^9, {3.975189395431881*^9, 3.975189412163641*^9}, {
   3.97518949733801*^9, 3.975189501046444*^9}, {3.975189786873535*^9, 
   3.9751898178792686`*^9}, {3.975259358767673*^9, 3.975259633754551*^9}, {
   3.975264322136621*^9, 3.975264347071232*^9}, {3.975278741452031*^9, 
   3.975278760802167*^9}},ExpressionUUID->"873b52a8-d93c-3640-ae5e-\
67d548c77c9b"],

Cell[TextData[{
 StyleBox["We define the covariant components of the velocity by contracting \
the contravariant components with the metric: ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["x", "\[FilledSmallCircle]"], "\[Mu]"], "=", 
    RowBox[{
     SubscriptBox["\[Eta]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], 
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], "\[Nu]"]}]}], 
   TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"10c14d68-c6de-da4e-81f8-203b49345fe1"],
 StyleBox[". Physically, this operation uses the local geometry to \
\[OpenCurlyDoubleQuote]measure\[CloseCurlyDoubleQuote] the vector and turn it \
into a linear function of any vector\[LongDash]",
  FontSlant->"Italic"],
 StyleBox["that\[CloseCurlyQuote]s the formal definition of a covector",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[". The sigil of this linear function is the down index, just \
waiting to be contracted against the up index of a vector. Contraction \
performs the linear operation and produces a scalar result. This is just a \
fancy inner product or dot product that works with any kind of coordinate \
system with a metric. The familiar dot product of two Cartesian vectors works \
only in Cartesian spaces, where we don\[CloseCurlyQuote]t distinguish vectors \
and covectors.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{
  3.975119831143009*^9, {3.975184662703115*^9, 3.975184815543045*^9}, {
   3.975184911844698*^9, 3.975184955495656*^9}, {3.975185009853169*^9, 
   3.97518508371194*^9}, {3.975185114983563*^9, 3.975185188953657*^9}, {
   3.9751852476235123`*^9, 3.97518525285209*^9}, {3.9751852884919662`*^9, 
   3.9751855791383657`*^9}, {3.9751856162025757`*^9, 
   3.9751856223215637`*^9}, {3.975185664120289*^9, 3.975185731318853*^9}, 
   3.9751892784048862`*^9, {3.975189395431881*^9, 3.975189412163641*^9}, {
   3.97518949733801*^9, 3.975189501046444*^9}, {3.975189786873535*^9, 
   3.9751898178792686`*^9}, {3.975259358767673*^9, 3.9752596191192017`*^9}, {
   3.97525965768225*^9, 3.9752596908607597`*^9}, {3.975278786437316*^9, 
   3.975279041781431*^9}, {3.988880443621073*^9, 
   3.9888804497254887`*^9}},ExpressionUUID->"5e9b9595-4ce3-9741-b3f7-\
50df7a681d16"],

Cell[TextData[{
 StyleBox["In the relativistic Lagrangian ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"L", "=", 
    RowBox[{
     RowBox[{"m", 
      SqrtBox[
       RowBox[{
        SubscriptBox["\[Eta]", 
         RowBox[{"\[Mu]", "\[Vee]"}]], 
        SuperscriptBox[
         OverscriptBox["x", "\[FilledSmallCircle]"], "\[Mu]"], 
        SuperscriptBox[
         OverscriptBox["x", "\[FilledSmallCircle]"], "\[Nu]"]}]]}], "=", 
     RowBox[{"m", 
      SqrtBox[
       RowBox[{
        SubscriptBox[
         OverscriptBox["x", "\[FilledSmallCircle]"], "\[Nu]"], 
        SuperscriptBox[
         OverscriptBox["x", "\[FilledSmallCircle]"], "\[Nu]"]}]]}]}]}], 
   TraditionalForm]],
  CellChangeTimes->{{3.975117024858026*^9, 3.9751170871817837`*^9}, {
   3.975117555659452*^9, 3.975117582436452*^9}, {3.975185230543975*^9, 
   3.9751852305460663`*^9}},
  FontSlant->"Plain",ExpressionUUID->"e6665d9d-0f9d-eb48-81f8-fa626be148fa"],
 StyleBox[", the metric is baked into the arc-length. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{
  3.975119831143009*^9, {3.975184662703115*^9, 3.975184815543045*^9}, {
   3.975184911844698*^9, 3.975184955495656*^9}, {3.975185009853169*^9, 
   3.97518508371194*^9}, {3.975185114983563*^9, 3.975185188953657*^9}, {
   3.9751852476235123`*^9, 3.97518525285209*^9}, {3.9751852884919662`*^9, 
   3.9751855791383657`*^9}, {3.9751856162025757`*^9, 
   3.9751856223215637`*^9}, {3.975185664120289*^9, 3.975185731318853*^9}, 
   3.9751892784048862`*^9, {3.975189395431881*^9, 3.975189412163641*^9}, {
   3.97518949733801*^9, 3.975189501046444*^9}, {3.975189786873535*^9, 
   3.9751898178792686`*^9}, {3.975259358767673*^9, 3.9752596191192017`*^9}, {
   3.97525965768225*^9, 3.97525966567605*^9}, 3.975259706042659*^9, {
   3.988880691365383*^9, 
   3.988880693244438*^9}},ExpressionUUID->"0f52e680-7a0f-0d47-91c2-\
1f0f6760a7c0"],

Cell[TextData[{
 StyleBox["This \
\[OpenCurlyDoubleQuote]sleight-of-hand\[CloseCurlyDoubleQuote] is the core of \
the Hamiltonian and Lagrangian treatments: the metric lets us swap between \
the \[OpenCurlyDoubleQuote]velocity\[CloseCurlyDoubleQuote] description of a \
path and the \[OpenCurlyDoubleQuote]momentum\[CloseCurlyDoubleQuote] \
description of a state, ensuring that the final constraint ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["p", "\[Mu]"], 
      SuperscriptBox["p", "\[Mu]"]}], "\[Congruent]", 
     SuperscriptBox["p", "2"]}], "=", 
    SuperscriptBox["m", "2"]}], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"afdc5e3c-5921-084c-915e-7c92096b41ad"],
 StyleBox[" is a true scalar invariant, independent of coordinate system. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{
  3.975119831143009*^9, {3.975184662703115*^9, 3.975184815543045*^9}, {
   3.975184911844698*^9, 3.975184955495656*^9}, {3.975185009853169*^9, 
   3.97518508371194*^9}, {3.975185114983563*^9, 3.975185188953657*^9}, {
   3.9751852476235123`*^9, 3.97518525285209*^9}, {3.9751852884919662`*^9, 
   3.9751855791383657`*^9}, {3.9751856162025757`*^9, 
   3.9751856223215637`*^9}, {3.975185664120289*^9, 3.975185731318853*^9}, 
   3.9751892784048862`*^9, {3.975189395431881*^9, 3.975189412163641*^9}, {
   3.97518949733801*^9, 3.975189501046444*^9}, {3.975189786873535*^9, 
   3.9751898178792686`*^9}, {3.975259358767673*^9, 3.9752596191192017`*^9}, {
   3.97525965768225*^9, 3.97525966567605*^9}, {3.975259714056675*^9, 
   3.975259750945059*^9}},ExpressionUUID->"fc3f8d82-4bbc-ee46-84b1-\
c4d0877ebc22"],

Cell[TextData[StyleBox["This tangent-cotangent, vector-covector duality and \
all these formulas carry over to General Relativity.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{
  3.975119831143009*^9, {3.975184662703115*^9, 3.975184815543045*^9}, {
   3.975184911844698*^9, 3.975184955495656*^9}, {3.975185009853169*^9, 
   3.97518508371194*^9}, {3.975185114983563*^9, 3.975185188953657*^9}, {
   3.9751852476235123`*^9, 3.97518525285209*^9}, {3.9751852884919662`*^9, 
   3.9751855791383657`*^9}, {3.9751856162025757`*^9, 
   3.9751856223215637`*^9}, {3.975185664120289*^9, 3.975185731318853*^9}, 
   3.9751892784048862`*^9, {3.975189395431881*^9, 3.975189412163641*^9}, {
   3.97518949733801*^9, 3.975189501046444*^9}, {3.975189786873535*^9, 
   3.9751898178792686`*^9}, {3.975259358767673*^9, 3.9752596191192017`*^9}, {
   3.97525965768225*^9, 3.97525966567605*^9}, {3.975259714056675*^9, 
   3.975259766197609*^9}},ExpressionUUID->"52aff848-1d08-5045-8aaf-\
2562652b8a81"],

Cell[TextData[StyleBox["We can now conflate overdot and overtick because we \
assume parameter-invariance.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.975184837653412*^9, 
  3.975184875850649*^9}},ExpressionUUID->"59e4d42d-3fab-ba49-b0ae-\
72e53830a382"],

Cell["\<\
If we square the momentum, the velocity terms cancel, leaving us with a pure \
identity for the momenta:\
\>", "Text",
 CellChangeTimes->{{3.9751183818107452`*^9, 3.975118408162818*^9}, {
  3.975118768188178*^9, 3.975118775596075*^9}, {3.975184610716647*^9, 
  3.9751846109779377`*^9}, {3.9752790765768623`*^9, 
  3.9752790797617598`*^9}},ExpressionUUID->"7074403a-0dc5-d741-a3d5-\
d6327fdbc359"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["p", "\[Mu]"], 
    SuperscriptBox["p", "\[Mu]"]}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["m", "2"], " ", 
      SubscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], "\[Mu]"], 
      SuperscriptBox[
       OverscriptBox["x", "\[FilledSmallCircle]"], "\[Mu]"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       SqrtBox[
        RowBox[{
         SubscriptBox[
          OverscriptBox["x", "\[FilledSmallCircle]"], "\[Alpha]"], 
         SuperscriptBox[
          OverscriptBox["x", "\[FilledSmallCircle]"], "\[Alpha]"]}]], ")"}], 
      "2"]], "=", 
    SuperscriptBox["m", "2"]}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.975118075263391*^9, 3.975118110202866*^9}, {
  3.975118264442594*^9, 3.975118297597643*^9}, {3.975118333134039*^9, 
  3.975118333136695*^9}, {3.975118815348426*^9, 3.975118850727456*^9}, {
  3.9752598425894833`*^9, 
  3.975259863192429*^9}},ExpressionUUID->"c1404d4d-730c-5746-8c18-\
704fcad40a6b"],

Cell[TextData[{
 "This is often quoted as Einstein\[CloseCurlyQuote]s most famous formula, \
(in natural units, where the speed of light ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "06f80c2c-5d59-484e-a91c-14c52c2ff9b6"],
 "."
}], "Text",
 CellChangeTimes->{{3.9751188624867477`*^9, 3.9751188748625717`*^9}, {
  3.9752846508250103`*^9, 
  3.9752846701419697`*^9}},ExpressionUUID->"d64f703f-77c7-4248-8ca0-\
326ccaa41459"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["E", "2"], "-", 
    "\[DoubleStruckP]\[FilledSmallCircle]\[DoubleStruckP]"}], "=", 
   SuperscriptBox["m", "2"]}], 
  TraditionalForm]],ExpressionUUID->"88e175fe-3e18-0b40-8398-3d570d8d012e"]], \
"Text",
 CellChangeTimes->{{3.9751188789697933`*^9, 3.975118926049567*^9}, {
  3.975119118389827*^9, 
  3.975119118389893*^9}},ExpressionUUID->"0891c20d-6de2-084c-9890-\
a998147f7be3"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", "=", 
    SubscriptBox["p", "0"]}], TraditionalForm]],ExpressionUUID->
  "c08a0ae6-0e93-e64e-b160-da271cf219ac"],
 ", the 0 component of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "03590825-3003-a14a-ae4d-b8f271e9ffc6"],
 ", is the new home for energy, and ",
 Cell[BoxData[
  FormBox["\[DoubleStruckP]", TraditionalForm]],ExpressionUUID->
  "8e53de0b-04bd-b042-8450-cad88b9be3f8"],
 " is the space part of the 4\[NoBreak]-\[NoBreak]momentum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "07dda0df-7589-8845-bf97-324fe7a3d67f"],
 ", our old friends, the conjugate momenta. "
}], "Text",
 CellChangeTimes->{{3.975118938733095*^9, 3.975119043524364*^9}, 
   3.975119178135107*^9, 3.9751846212531157`*^9, {3.975259888243546*^9, 
   3.975259919385845*^9}, {3.97526024202129*^9, 3.975260334778349*^9}, {
   3.975279093256876*^9, 3.975279096806899*^9}, 
   3.988880776176238*^9},ExpressionUUID->"37cd92bd-8f63-3044-9990-\
2b88360e8ab6"],

Cell[TextData[{
 StyleBox["This is also called ",
  FontSlant->"Italic"],
 StyleBox["the mass-shell constraint",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[", with \[OpenCurlyDoubleQuote]shell\[CloseCurlyDoubleQuote] \
meaning \[OpenCurlyDoubleQuote]pertaining to classically realizable motions, \
relativistic but non-quantum.\[CloseCurlyDoubleQuote] In quantum physics, we \
must consider off-shell motions, because a quantum system \
\[OpenCurlyDoubleQuote]considers all paths\[CloseCurlyDoubleQuote] between \
events.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.975118938733095*^9, 3.975119043524364*^9}, 
   3.975119178135107*^9, 3.9751846212531157`*^9, {3.975259888243546*^9, 
   3.975259919385845*^9}, {3.97526024202129*^9, 3.9752603327664623`*^9}, {
   3.975279125038336*^9, 
   3.975279237224881*^9}},ExpressionUUID->"270a2fba-bda6-694e-85fc-\
8f9bb8e55c47"],

Cell["\<\
Einstein\[CloseCurlyQuote]s formula is a necessary consequence of the \
singular Hessian, not a magically discovered postulate.\
\>", "Text",
 CellChangeTimes->{{3.975119182087597*^9, 3.9751192128489923`*^9}, {
  3.975259933480213*^9, 
  3.975259944871517*^9}},ExpressionUUID->"a3702020-cef0-8844-bc86-\
f466276e4621"],

Cell[TextData[{
 StyleBox["The particular choice of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Eta]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "=", 
    RowBox[{"diag", "(", 
     RowBox[{"1", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], ")"}]}], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"233a46ea-acc4-3d4d-9d89-f4a4a37b4144"],
 StyleBox[" forces the minus sign in ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["E", "2"], "-", 
     "\[DoubleStruckP]\[FilledSmallCircle]\[DoubleStruckP]"}], "=", 
    SuperscriptBox["m", "2"]}], TraditionalForm]],ExpressionUUID->
  "f73b6625-f321-ab45-bd29-a96461f1a66c"],
 StyleBox[". Other authors quote  ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Eta]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "=", 
    RowBox[{"diag", "(", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "1", ",", "1", ",", "1"}], ")"}]}], 
   TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"acb35c6e-ddcd-b24a-a9af-43dbb373dfd0"],
 StyleBox[", which generates the same physics",
  FontSlant->"Italic"],
 "."
}], "Item",
 CellChangeTimes->{
  3.975119831143009*^9, {3.975184662703115*^9, 3.975184815543045*^9}, {
   3.975184911844698*^9, 3.975184955495656*^9}, {3.975185009853169*^9, 
   3.97518508371194*^9}, {3.975185114983563*^9, 3.975185188953657*^9}, {
   3.9751852476235123`*^9, 3.97518525285209*^9}, {3.9751852884919662`*^9, 
   3.9751855791383657`*^9}, {3.9751856162025757`*^9, 
   3.9751856223215637`*^9}, {3.975185664120289*^9, 3.975185731318853*^9}, 
   3.9751892784048862`*^9, {3.975189395431881*^9, 3.975189412163641*^9}, {
   3.97518949733801*^9, 3.975189501046444*^9}, 3.975189786873535*^9, {
   3.975189828396678*^9, 
   3.975189908850906*^9}},ExpressionUUID->"5b94c337-f660-4d4f-8f55-\
4f83c2ea3e69"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Vanishing Hamiltonian", "Subsection",
 CellChangeTimes->{{3.975119157784623*^9, 
  3.97511916410819*^9}},ExpressionUUID->"6cfd4dac-61b9-814f-8bb7-\
707844b9c2e3"],

Cell[TextData[{
 "We already noted in Euler\[CloseCurlyQuote]s Identity, Equation ",
 
 CounterBox["DisplayFormulaNumbered", "EULER'S IDENTITY"],
 ", that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["p", "\[Mu]"], 
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], "\[Mu]"]}], "=", "L"}], 
   TraditionalForm]],
  InitializationCell->True,ExpressionUUID->
  "61019a98-8913-904c-8ace-0c41322affcc"],
 ". But the definition of the Hamiltonian is "
}], "Text",
 CellChangeTimes->{{3.975119233939514*^9, 3.9751193824833603`*^9}, {
  3.9751194410249968`*^9, 
  3.975119442716152*^9}},ExpressionUUID->"63c1bf8b-2daf-a849-9230-\
bd2192213a5c"],

Cell[BoxData[
 FormBox[
  RowBox[{"H", "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["p", "\[Mu]"], 
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], "\[Mu]"]}], "-", "L"}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9751194008392344`*^9, 3.9751194088062572`*^9}, {
  3.9751194521754627`*^9, 
  3.975119452177587*^9}},ExpressionUUID->"215d5e3e-9770-cc4d-952b-\
a55f023af967"],

Cell[TextData[{
 "That\[CloseCurlyQuote]s now 0! This means that the classical \
\[OpenCurlyDoubleQuote]energy\[CloseCurlyDoubleQuote] of the system, \
represented by the Hamiltonian, vanishes identically. However, just as ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "f0497581-6ad7-c545-951f-3c2974f6c1f4"],
 " has been ",
 StyleBox["demoted",
  FontSlant->"Italic"],
 " to a mere coordinate, energy has been ",
 StyleBox["promoted",
  FontSlant->"Italic"],
 " to the 0 component of the 4\[NoBreak]-\[NoBreak]momentum. "
}], "Text",
 CellChangeTimes->{{3.9751194200225973`*^9, 3.975119423083335*^9}, {
  3.975119458300589*^9, 3.9751196396870813`*^9}, {3.975184420211425*^9, 
  3.9751844227415257`*^9}, {3.975185745272881*^9, 3.9751858516534452`*^9}, {
  3.9752599856626863`*^9, 3.975260033899831*^9}, {3.975260081425798*^9, 
  3.9752601005177526`*^9}},ExpressionUUID->"e60ff3af-4e68-6e41-b02b-\
39f1052822f4"],

Cell[TextData[{
 "The deeper meaning, though, is that in a gauge-invariant theory, the \
Newtonian time coordinate ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "b746cace-4433-4046-a2df-fdcd9c519b19"],
 " does not generate dynamical evolution. ",
 StyleBox["The entire physics is contained in the constraints!",
  FontWeight->"Bold"],
 " "
}], "Text",
 CellChangeTimes->{{3.9751194200225973`*^9, 3.975119423083335*^9}, {
  3.975119458300589*^9, 3.9751196396870813`*^9}, {3.975184420211425*^9, 
  3.9751844227415257`*^9}, {3.975185745272881*^9, 3.9751858516534452`*^9}, {
  3.9752599856626863`*^9, 3.975260033899831*^9}, {3.9752601036180353`*^9, 
  3.975260115113558*^9}},ExpressionUUID->"c417c371-491c-2946-a1f7-\
2fe970161fd4"],

Cell["\<\
Although this might seem shocking, it is 100% in keeping with the original \
ideas of d\[CloseCurlyQuote]Alembert and Lagrange: \
\[OpenCurlyDoubleQuote]capture physics by capturing constraints.\
\[CloseCurlyDoubleQuote] It\[CloseCurlyQuote]s sobering to realize that \
Special Relativity was hiding in plain sight in the old Lagrangian and \
Hamiltonian, long before Einstein discovered it.\
\>", "Text",
 CellChangeTimes->{{3.9751194200225973`*^9, 3.975119423083335*^9}, {
  3.975119458300589*^9, 3.9751196396870813`*^9}, {3.975184420211425*^9, 
  3.9751844227415257`*^9}, {3.975185745272881*^9, 3.9751858516534452`*^9}, {
  3.9752599856626863`*^9, 3.975260033899831*^9}, {3.9752601036180353`*^9, 
  3.9752601885412073`*^9}, {3.975279314980556*^9, 3.97527935156812*^9}, {
  3.988880873214909*^9, 
  3.988880875032268*^9}},ExpressionUUID->"d8fd6341-3f3c-d54a-a58c-\
41124186d149"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Roadmap to Quantum Fields", "Section",
 CellChangeTimes->{{3.9751196731300087`*^9, 
  3.9751196823030024`*^9}},ExpressionUUID->"852cf812-21b5-3042-9908-\
c10e1122d4ab"],

Cell[TextData[{
 "We have reached the following conclusion: when we insist that physics be \
independent of both the coordinate system and the parameter \
\[OpenCurlyDoubleQuote]clock,\[CloseCurlyDoubleQuote] we are rewarded with \
the mass-shell constraint ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["p", "2"], "=", 
    SuperscriptBox["m", "2"]}], TraditionalForm]],ExpressionUUID->
  "22d1a4eb-1f44-6249-b4b7-e162b4a48109"],
 ". This is the end of our non-quantum road, but the beginning of the road to \
the Standard Model."
}], "Text",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 3.9751859433204603`*^9}, {
   3.9751864567747602`*^9, 3.975186457929995*^9}, {3.975260207301578*^9, 
   3.975260224586253*^9}, {3.975260362526087*^9, 
   3.975260383627803*^9}},ExpressionUUID->"237c86b8-6b91-5447-a7da-\
c6fb65a876d9"],

Cell["\<\
Lots of detail is swept under the rug in the following sketches, but the \
roadmap forward should be clear.\
\>", "Text",
 CellChangeTimes->{{3.97518833728538*^9, 3.975188361528268*^9}, {
  3.975260395582695*^9, 
  3.975260397049803*^9}},ExpressionUUID->"13750aa6-9014-1a47-afff-\
38d58499c289"],

Cell[CellGroupData[{

Cell["Quantization: Constraints as Wave Equations", "Subsection",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 
   3.975185954735461*^9}},ExpressionUUID->"647783be-c380-0146-96fa-\
e1bb3a06f280"],

Cell[TextData[{
 "In the non-quantum Hamiltonian approach, we promote momentum variables to \
operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"p", "->", 
     RowBox[{
      OverscriptBox["p", "^"], "\:200b"}]}]}], TraditionalForm]],
  ExpressionUUID->"4aae640a-2e77-f248-ba28-d2e0521a85b9"],
 ", see ",
 StyleBox[ButtonBox["Goldstein",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.amazon.com/Classical-Mechanics-3rd-Herbert-Goldstein/dp/\
0201657023/ref=sr_1_1?crid=3UCWL1E5GKIIQ&dib=eyJ2IjoiMSJ9.\
p5kPQfqj1poHbtKZsN0UTEYdLBf_9vleD94bKeaOPn64PsNlEAeN5pG-\
Bm2lyK3aMITXYFeelZhqoQIsLV4eny68OTv6o--\
kHUgxHgqlOgdH1KOKiYQcoKK5lEWO04YYw1zqziAzCv4U8lcm7M4o3P1Klf6XYSSzbnenTnXd3-\
iFK4OgkGmUfOfPQvA4Jsx4Ttq8CPcLEERe8AZ2oHxQajN2CefyYlGiJXUs9vpzdzs.\
cmTH4POCuVkgMdw2eUvs6bq-ed-iP2Zkiwx-5yQL6zU&dib_tag=se&keywords=goldstein+\
classical+mechanics&qid=1766271652&sprefix=goldstein+%2Caps%2C193&sr=8-1"], 
    None},
  ButtonNote->
   "https://www.amazon.com/Classical-Mechanics-3rd-Herbert-Goldstein/dp/\
0201657023/ref=sr_1_1?crid=3UCWL1E5GKIIQ&dib=eyJ2IjoiMSJ9.\
p5kPQfqj1poHbtKZsN0UTEYdLBf_9vleD94bKeaOPn64PsNlEAeN5pG-\
Bm2lyK3aMITXYFeelZhqoQIsLV4eny68OTv6o--\
kHUgxHgqlOgdH1KOKiYQcoKK5lEWO04YYw1zqziAzCv4U8lcm7M4o3P1Klf6XYSSzbnenTnXd3-\
iFK4OgkGmUfOfPQvA4Jsx4Ttq8CPcLEERe8AZ2oHxQajN2CefyYlGiJXUs9vpzdzs.\
cmTH4POCuVkgMdw2eUvs6bq-ed-iP2Zkiwx-5yQL6zU&dib_tag=se&keywords=goldstein+\
classical+mechanics&qid=1766271652&sprefix=goldstein+%2Caps%2C193&sr=8-1"],
  FontVariations->{"Underline"->True}],
 "). In a non-singular system, we would plug these into the Hamiltonian to \
find the energy. But our constrained Hamiltonian vanishes!"
}], "Text",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 3.975185960766884*^9}, {
   3.975186335204997*^9, 3.975186377115047*^9}, {3.9751864664228363`*^9, 
   3.975186470794351*^9}, {3.975260413771723*^9, 3.9752604250137587`*^9}, {
   3.9752604876948977`*^9, 
   3.975260487695238*^9}},ExpressionUUID->"2dad234a-35de-1545-9bd6-\
cc59cd0a71d4"],

Cell[TextData[{
 "Our physics is already relativistic, so, to quantize, we just follow the \
Dirac Prescription for constrained systems: the physical quantum states ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"\[Psi]"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1ee4d437-7d98-4d79-aad0-bfe62729703f"],
 "  must be annihilated by the constraint operator:"
}], "Text",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 3.975185960766884*^9}, {
   3.975186335204997*^9, 3.975186378447083*^9}, {3.975186481658581*^9, 
   3.975186523869499*^9}, {3.975186557291993*^9, 3.975186598287777*^9}, {
   3.9751867212544107`*^9, 3.975186779211299*^9}, {3.9751868866664543`*^9, 
   3.975186886856896*^9}, {3.9751871733473463`*^9, 3.975187188231079*^9}, {
   3.9751872795752153`*^9, 3.975187297618009*^9}, {3.978461892173334*^9, 
   3.978461896628028*^9}, {3.978462069486702*^9, 3.9784620717330713`*^9}, {
   3.988880943958712*^9, 
   3.988880956252734*^9}},ExpressionUUID->"2f9c714f-0542-5f40-864a-\
beb58bbdc7cd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["\[Phi]", "^"], 
    TemplateBox[{"\[Psi]"},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"0", "  ", "\[DoubleLongLeftRightArrow]", "  ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["p", "2"], "-", 
        SuperscriptBox["m", "2"]}], ")"}]}], 
     TemplateBox[{"\[Psi]"},
      "Ket"]}], " ", "=", "0"}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.975186932075192*^9, 3.975186952967072*^9}, {
  3.975187315200531*^9, 3.975187363607929*^9}, {3.975187456221529*^9, 
  3.9751874605849237`*^9}, {3.9888809717697163`*^9, 
  3.988880987379469*^9}},ExpressionUUID->"8ff873f4-4a01-0448-8efa-\
81bfe4c9831b"],

Cell[TextData[{
 "By substituting the quantum momentum operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["p", "\[Mu]"], "=", 
     RowBox[{"-", "i\[HBar]"}]}], ",", 
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Mu]"]}]]}], TraditionalForm]],ExpressionUUID->
  "d6e5c916-18a0-734e-b949-eecccf708ae5"],
 ", we get the ",
 StyleBox[ButtonBox["relativistic Klein-Gordon Equation",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Klein%E2%80%93Gordon_equation"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Klein%E2%80%93Gordon_equation"],
  FontVariations->{"Underline"->True}],
 ":"
}], "Text",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 3.975185960766884*^9}, {
   3.975186335204997*^9, 3.975186378447083*^9}, {3.975186481658581*^9, 
   3.975186523869499*^9}, {3.975186557291993*^9, 3.975186598287777*^9}, {
   3.9751867212544107`*^9, 3.9751868361873503`*^9}, {3.9751868702450438`*^9, 
   3.975186918879197*^9}, 3.975187383155944*^9, {3.975187474714205*^9, 
   3.975187559493368*^9}, {3.975187592858079*^9, 3.975187609881146*^9}, {
   3.975187735397853*^9, 3.975187735398375*^9}, {3.975260540548502*^9, 
   3.975260548225272*^9}, {3.975260589844047*^9, 3.975260633380671*^9}, {
   3.9888810021576233`*^9, 
   3.98888100258603*^9}},ExpressionUUID->"0826da03-0a3e-3640-92a9-\
29ea1af93ac9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[EmptySquare]", "+", 
       SuperscriptBox["m", "2"]}], ")"}], 
     TemplateBox[{"\[Psi]"},
      "Ket"]}], "\[Congruent]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        SuperscriptBox["\[PartialD]", "2"], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["t", "2"]}]], 
       RowBox[{"-", 
        SuperscriptBox["\[Del]", "2"]}]}], ")"}], 
     TemplateBox[{"\[Psi]"},
      "Ket"]}]}], "=", "0", " "}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.975187743771097*^9, 3.97518775885868*^9}, {
  3.9751878097237787`*^9, 3.9751878653938427`*^9}, {3.975188383061019*^9, 
  3.975188458325492*^9}, {3.988881009906901*^9, 
  3.9888810256664963`*^9}},ExpressionUUID->"9d5448f5-96e4-0049-96fa-\
2f02d9cdf809"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"c", "=", "1"}], ",", " ", 
    RowBox[{"\[HBar]", "=", "1"}]}], TraditionalForm]],ExpressionUUID->
  "3ef80385-d136-b14f-9c64-92b6a958e5fb"],
 " everywhere. The \[OpenCurlyDoubleQuote]unsolvability\
\[CloseCurlyDoubleQuote] of the non-quantum momenta produces to one of the \
wave equations of relativistic quantum mechanics! "
}], "Text",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 3.975185960766884*^9}, {
   3.975186335204997*^9, 3.975186378447083*^9}, {3.975186481658581*^9, 
   3.975186523869499*^9}, {3.975186557291993*^9, 3.975186598287777*^9}, {
   3.9751867212544107`*^9, 3.9751868361873503`*^9}, {3.9751868702450438`*^9, 
   3.975186918879197*^9}, 3.975187383155944*^9, {3.975187474714205*^9, 
   3.975187559493368*^9}, {3.975187877891349*^9, 3.975187938196312*^9}, {
   3.9751884667044497`*^9, 3.97518848332714*^9}, {3.975189342980682*^9, 
   3.975189346534436*^9}, {3.975279423075459*^9, 3.975279434436639*^9}, {
   3.988881041424623*^9, 
   3.9888810476598377`*^9}},ExpressionUUID->"3c149817-9f0a-7247-a1b6-\
7749ed69ef97"]
}, Open  ]],

Cell[CellGroupData[{

Cell["From Particles to Fields", "Subsection",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 3.975185960766884*^9}, {
   3.975186335204997*^9, 3.975186378447083*^9}, {3.975186481658581*^9, 
   3.975186523869499*^9}, {3.975186557291993*^9, 3.975186598287777*^9}, {
   3.9751867212544107`*^9, 3.9751868361873503`*^9}, {3.9751868702450438`*^9, 
   3.975186918879197*^9}, 3.975187383155944*^9, {3.975187474714205*^9, 
   3.975187559493368*^9}, {3.975187877891349*^9, 
   3.9751879555425*^9}},ExpressionUUID->"4d4d1613-31ad-f747-873f-\
e62a4f20f9e2"],

Cell[TextData[{
 "To reach the Standard Model, we transition from the world-line of a single \
particle to a field-dependent ",
 StyleBox[ButtonBox["Lagrangian Density",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3584475"], None},
  ButtonNote->"https://community.wolfram.com/groups/-/m/t/3584475"],
  FontVariations->{"Underline"->True}],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalL]", "(", 
    RowBox[{"\[Phi]", ",", 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]"}]}], ")"}], 
   TraditionalForm]],ExpressionUUID->"3cca4861-64d6-df45-9d3b-bec23d7ddef3"],
 "."
}], "Text",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 3.975185960766884*^9}, {
   3.975186335204997*^9, 3.975186378447083*^9}, {3.975186481658581*^9, 
   3.975186523869499*^9}, {3.975186557291993*^9, 3.975186598287777*^9}, {
