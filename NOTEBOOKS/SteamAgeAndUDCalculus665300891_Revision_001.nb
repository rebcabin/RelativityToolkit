50214875c591"],

Cell[TextData[{
 "To get the field-strength Faraday tensor, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], 
      SubscriptBox["A", "\[Nu]"]}], "-", 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Nu]"], 
      SubscriptBox["A", "\[Mu]"]}]}]}], TraditionalForm]],ExpressionUUID->
  "b0e153de-0edf-814f-9016-f5cdc978cf3a"],
 ", we\[CloseCurlyQuote]ll need gradients for ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]],ExpressionUUID->
  "cde9ebfd-4e80-3c4a-ad64-2090f4fd34fa"],
 ", ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "2997e1c2-dddf-d64a-bd7c-84e36f94fdf1"],
 ", \[Sigma], and \[Lambda] as we grind through the chain rule applied to ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "562fdf17-1312-0e44-89ec-e09523eab9f4"],
 "."
}], "Text",
 CellChangeTimes->{{3.9759674586758347`*^9, 3.9759676035211353`*^9}, {
  3.97623847385921*^9, 3.976238474753195*^9}, {3.97628381927569*^9, 
