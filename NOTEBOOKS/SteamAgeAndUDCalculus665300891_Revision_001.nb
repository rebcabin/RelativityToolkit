   3.9762853361991787`*^9, 3.976285369162939*^9}, {3.976285401286932*^9, 
   3.976285416206416*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"3267b53f-a5fd-b245-9a51-282de697ce83"],

Cell["This is the one we\[CloseCurlyQuote]ll need", "Text",
 CellChangeTimes->{{3.976266247704712*^9, 
  3.976266254739719*^9}},ExpressionUUID->"9beadfa4-eccd-8445-b65b-\
dbdf00734b1c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"fourGrad", "[", 
   RowBox[{
    RowBox[{"\[Sigma]", "[", 
     RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "]"}], ",", 
    RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}]}], "]"}], "/.", 
  "dpyRules"}]], "Input",
