   SubscriptBox["t", "2"], TraditionalForm]],ExpressionUUID->
  "1920c799-e299-b44e-9668-216334848f13"],
 StyleBox[". Also see ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Bolza's Lemma",
