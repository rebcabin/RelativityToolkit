Cell[CellGroupData[{

Cell["Field Strength Faraday Tensor", "Section",
 CellChangeTimes->{{3.975863768420878*^9, 3.975863821142161*^9}, 
   3.976266859734476*^9, {3.976268370186138*^9, 
