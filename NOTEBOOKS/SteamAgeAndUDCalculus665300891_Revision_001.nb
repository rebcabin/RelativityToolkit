Cell[CellGroupData[{

Cell["Index Notation", "Section",
 CellChangeTimes->{{3.9748324609640636`*^9, 3.9748324708127613`*^9}, 
   3.9751108159611053`*^9, {3.9751108771635637`*^9, 
   3.9751108801347017`*^9}},ExpressionUUID->"91df4a38-f7ef-ab44-8466-\
5c8005cf8e7f"],

Cell[TextData[{
 "This book uses the old-fashioned index notation typified by ",
 StyleBox[ButtonBox["Lovelock and Rund",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://a.co/d/8OvgqjF"], None},
  ButtonNote->"https://a.co/d/8OvgqjF"],
  FontVariations->{"Underline"->True}],
 " (L&R). It is written entirely in terms of transformation rules between \
coordinate systems. This is refreshingly concrete for the physicist concerned \
with calculation. After all, we must have numbers and arrays to do \
calculations. The downside of this ancient notation is that it\
\[CloseCurlyQuote]s no help in understanding contemporary literature. We can\
\[CloseCurlyQuote]t have our cake\[LongDash]coordinate-free notation for \
concise theorizing\[LongDash]and eat it\[LongDash]concrete coordinates for \
practical calculation\[LongDash]too. I\[CloseCurlyQuote]ll occasionally make \
parenthetical remarks about this tension, but the meat of this notebook is in \
L&R\[CloseCurlyQuote]s concrete notation."
}], "Text",
 CellChangeTimes->{{3.974839618834619*^9, 3.974839847057732*^9}, {
   3.9748398832218657`*^9, 3.97483991370277*^9}, {3.9748399448411694`*^9, 
   3.9748400104929323`*^9}, {3.974841227958062*^9, 3.974841240415347*^9}, 
   3.9749040289687757`*^9, {3.97490406481439*^9, 3.974904120890194*^9}, {
   3.9749059539953127`*^9, 3.9749063228927917`*^9}, {3.974906388654292*^9, 
   3.9749064037789392`*^9}, {3.974930653765031*^9, 3.9749308555301523`*^9}, {
   3.97493099093827*^9, 3.9749309911892223`*^9}, {3.9749331114516*^9, 
   3.974933166035701*^9}, {3.9749787830005074`*^9, 3.974978934890757*^9}, {
   3.974979462434782*^9, 3.974979462926145*^9}, {3.974979493095418*^9, 
   3.974979568492087*^9}, {3.975110819308917*^9, 3.975110850306181*^9}, {
   3.975110904328146*^9, 3.975110936527875*^9}, {3.97516809060752*^9, 
   3.975168092675219*^9}, {3.9751901735923157`*^9, 3.9751901766021147`*^9}, {
   3.975255725855509*^9, 3.975255830446087*^9}, {3.975261888607041*^9, 
   3.975261903322728*^9}, {3.975262521448887*^9, 3.975262525240299*^9}, {
   3.9888731633787403`*^9, 
   3.988873175621698*^9}},ExpressionUUID->"cde67ce0-98f8-9c4f-9276-\
3d968bcb68b7"],

Cell[TextData[{
 "We also avoid Cartan\[CloseCurlyQuote]s exterior calculus, typified by the \
Grassmann wedge product, as in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"d", "\[VeryThinSpace]", "x"}], "\[And]", 
    RowBox[{"d", "\[VeryThinSpace]", "y"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "533dd827-d637-43db-a203-e377944b348f"],
 ". While this is a beautiful and powerful formalism, it\[CloseCurlyQuote]s \
not usually taught at an undergraduate level, and we don\[CloseCurlyQuote]t \
want assume it of the reader. We also don\[CloseCurlyQuote]t want to take the \
time and space to develop it. We can do all the physics we want without it, \
for now. "
}], "Text",
 CellChangeTimes->{{3.988873216731378*^9, 
  3.988873463747754*^9}},ExpressionUUID->"e187966a-cd7f-4456-8e8c-\
0faef7c8333b"],

Cell[CellGroupData[{

Cell["Ambiguity Warning", "Subsection",
 CellChangeTimes->{{3.9751901943977947`*^9, 
  3.9751902065494823`*^9}},ExpressionUUID->"1ed86999-d4d2-914e-9384-\
eaabdb8e3fc0"],

Cell[TextData[{
 "When \[Zeta] is a function of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "ef4a8ad1-d3a1-3542-ab21-0379de0eec87"],
 " and ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "9a0df93c-23de-8748-987c-91d96c4bd834"],
 ", physicists and mathematicians sometimes write ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Zeta]", "(", 
    RowBox[{"x", ",", "t"}], ")"}], TraditionalForm]],ExpressionUUID->
  "edc0cb8f-3ed1-5a45-b6fd-d0cba06db6ae"],
 ". This notation is ambiguous because it also means \
\[OpenCurlyDoubleQuote]the value of the function \[Zeta] given specific \
coordinates ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "a236208f-a6ea-4a44-9da3-cdcd65d22709"],
 " and ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "6c57b754-71d8-7d42-9fd8-8e0c97aeecf2"],
 ".\[CloseCurlyDoubleQuote] We must tolerate this ambiguity in prose, and be \
very careful about it in code."
}], "Text",
 CellChangeTimes->{
  3.975190179495459*^9, {3.975190219222417*^9, 3.975190259536665*^9}, {
   3.9752558424369392`*^9, 3.975255855445669*^9}, {3.97526191325861*^9, 
   3.975261932529982*^9}, {3.988873475407647*^9, 
   3.988873479781617*^9}},ExpressionUUID->"07162801-01da-8f4d-81e4-\
5c3b2f8a1531"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Points, Coordinates, States", "Section",
 CellChangeTimes->{{3.974904240322937*^9, 3.974904242415524*^9}, {
  3.974933273551091*^9, 3.974933277081917*^9}, {3.975256179823041*^9, 
  3.975256184895363*^9}},ExpressionUUID->"69222cdf-69c8-3c47-ae99-\
213f3b8f3e12"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "n"], TraditionalForm]],ExpressionUUID->
  "01da82cd-2687-8e48-9237-903bdf7517f9"],
 " be an ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "e74c1231-41ec-6f4b-a3a0-60f7c21655ab"],
 "\[NoBreak]-\[NoBreak]dimensional ",
 StyleBox["differentiable manifold",
  FontSlant->"Italic"],
 ". Informally, it is a space of abstract points ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "bed47b38-240c-c440-8793-793c5fc7b842"],
 " with Euclidean tangent spaces ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "p"], 
    SubscriptBox["X", "n"]}], TraditionalForm]],ExpressionUUID->
  "50c251ae-afb2-c247-b0c9-7f320521db2e"],
 " at each point. Vectors live in the tangent spaces. There are also, at each \
point in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "n"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ec831b34-c637-4367-8175-92e705551eb8"],
 ", corresponding ",
 StyleBox["dual",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" co-tangent",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " spaces, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["T", "p", "\[Star]"], 
    SubscriptBox["X", "n"]}], TraditionalForm]],ExpressionUUID->
  "35610be2-9afa-9c48-9ee2-3c9eee81c887"],
 ", where ",
 StyleBox["covectors",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " live. "
}], "Text",
 CellChangeTimes->{{3.974837542112522*^9, 3.974837669758956*^9}, {
   3.974837717627746*^9, 3.9748378830901957`*^9}, {3.9749036870320168`*^9, 
   3.974903689932686*^9}, {3.974903834988432*^9, 3.974903834988982*^9}, {
   3.9749040271630096`*^9, 3.97490403598552*^9}, {3.9749042655442247`*^9, 
   3.974904267928896*^9}, {3.974904331539605*^9, 3.974904356613131*^9}, {
   3.974905913432619*^9, 3.974905940127597*^9}, {3.974906343240944*^9, 
   3.974906351606468*^9}, {3.974906654652265*^9, 3.974906743718772*^9}, {
   3.974930874422373*^9, 3.974930892713695*^9}, {3.974933184356382*^9, 
   3.974933247052518*^9}, {3.9749791619514847`*^9, 3.97497917937989*^9}, {
   3.974979586615979*^9, 3.974979588528131*^9}, 3.975181810364642*^9, {
   3.9752558724882812`*^9, 3.975255908750761*^9}, {3.9752559918892937`*^9, 
   3.975255994457152*^9}, {3.975256170359642*^9, 3.9752561736079187`*^9}, {
   3.9752619570355787`*^9, 3.975261974135612*^9}, {3.988873499208275*^9, 
   3.988873579357073*^9}},ExpressionUUID->"d769c7e8-9a87-b942-b36a-\
d6b355365917"],

Cell[TextData[StyleBox["We elaborate and motivate the terms \
\[OpenCurlyDoubleQuote]vector\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]covector\[CloseCurlyDoubleQuote] below.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.974980120373328*^9, 3.974980155210205*^9}, {
  3.9750890710111732`*^9, 3.9750890720240993`*^9}, {3.975168447483603*^9, 
  3.975168457711583*^9}, {3.975181773225543*^9, 
  3.975181796360918*^9}},ExpressionUUID->"3cb9f792-0c59-9f4c-b04f-\
a0df0732580b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "p"], 
    SubscriptBox["X", "n"]}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"b06cbdaa-f29c-5c4f-9716-bb3e8a580dc2"],
 StyleBox[", and ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["T", "p", "\[Star]"], 
    SubscriptBox["X", "n"]}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"2b54ebb0-a055-cc42-8253-3a261ecf2fd6"],
 StyleBox[" are indivisible notations, not some kind of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["T", TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"b7ad066e-bf5c-e446-968e-b8b719a1a8ab"],
 StyleBox[" multiplying some kind of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["X", TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"8a88a5ec-a55e-8e42-9353-4d51de817ce8"],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.97490678309162*^9, 3.9749068732510157`*^9}, 
   3.9749309005346937`*^9, {3.974979191975546*^9, 3.974979192968198*^9}, {
   3.975168258403563*^9, 3.975168262143156*^9}, {3.975255925567621*^9, 
   3.975255926764538*^9}, {3.9888735967910013`*^9, 
   3.988873598651342*^9}},ExpressionUUID->"9c5b14c6-7fd5-8f4b-9b2b-\
13b0c0f01953"],

Cell[TextData[{
 StyleBox["My definitions here are just touch points, introducing terms to \
aid the physicist\[CloseCurlyQuote]s visual intuition. Find the mathematical \
rigor behind them in books on modern differential geometry, such as ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Chris Isham\[CloseCurlyQuote]s book",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://a.co/d/htWKAMo"], None},
  ButtonNote->"https://a.co/d/htWKAMo"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.974978990235663*^9, 3.974979143197933*^9}, {
  3.974979202954224*^9, 3.974979223203752*^9}, {3.975086655525642*^9, 
  3.97508665830626*^9}, {3.975181710637474*^9, 3.975181712096734*^9}, {
  3.975255933715261*^9, 3.9752559769232607`*^9}, {3.988873612664839*^9, 
  3.9888736376764*^9}, {3.988873673958579*^9, 
  3.988873863006681*^9}},ExpressionUUID->"9ff3f917-9f15-614d-ba14-\
1e47c91d8977"],

Cell[TextData[{
 "Let the coordinates of points along some parametric curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "3558bae8-0ffe-a943-92f9-fedb36928b11"],
 " in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "n"], TraditionalForm]],ExpressionUUID->
  "27a062c9-66d6-f144-8322-c425a13de7f3"],
 " be values of similarly-named (eponymous) coordinate functions:"
}], "Text",
 CellChangeTimes->{{3.97483790516743*^9, 3.974837972116292*^9}, {
  3.9748380769007483`*^9, 3.974838079861988*^9}, {3.974905673465012*^9, 
  3.974905742305728*^9}, {3.975111200877014*^9, 3.975111207456997*^9}, {
  3.975168284991645*^9, 3.975168302777493*^9}, {3.9751818707705507`*^9, 
  3.975181872816866*^9}},ExpressionUUID->"73872756-5900-2041-b53d-\
bd56deebf10b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "j"], 
     StyleBox["(",
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox[
      RowBox[{"coordinate", " ", "value"}],
      FontSlant->"Italic",
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox[")",
      FontColor->RGBColor[1, 0, 0]]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["x", "j"], "(", "t", ")"}], 
     StyleBox[
      RowBox[{"(", 
       RowBox[{"value", " ", "of", " ", 
        StyleBox["coordinate",
         FontSlant->"Italic"], 
        StyleBox[" ",
         FontSlant->"Italic"], 
        StyleBox["function",
         FontSlant->"Italic"], " ", 
        SuperscriptBox[
         StyleBox["x",
          FontColor->RGBColor[1, 0, 0]], "j"], " ", "at", " ", "t"}], ")"}],
      FontColor->RGBColor[1, 0, 0]]}]}], ",", " ", 
   RowBox[{"j", "\[Element]", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2", ",", " ", "\[Ellipsis]", ",", " ", "n"}], 
     "}"}]}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9748379856087112`*^9, 3.974838037286685*^9}, {
  3.974903895935947*^9, 3.9749039120173063`*^9}, {3.9749796475618887`*^9, 
  3.9749796928674097`*^9}, {3.974979724419239*^9, 3.9749797537665663`*^9}, {
  3.98887388172744*^9, 3.988873902752714*^9}},
 CellTags->
  "COORDINATE \
FUNCTIONS",ExpressionUUID->"870e2816-e4cd-7341-94d3-05c597d3335c"],

Cell[TextData[{
 "with \[OpenCurlyDoubleQuote]up\[CloseCurlyDoubleQuote] indices, and \
parameter ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "8850f961-5cf2-2440-903c-4e37ffd63506"],
 ", initially Newtonian time. This dual meaning of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "661d38fb-cb16-7648-993d-cbc54dec7c06"],
 " is another notational ambiguity we must tolerate in prose and be careful \
with in code."
}], "Text",
 CellChangeTimes->{{3.974838044954418*^9, 3.974838070730803*^9}, {
  3.9748381049329653`*^9, 3.974838108630205*^9}, {3.974838477406354*^9, 
  3.9748385147043333`*^9}, {3.974838915490096*^9, 3.97483894211558*^9}, {
  3.974838995060618*^9, 3.974838998805163*^9}, {3.974933294863845*^9, 
  3.97493330086007*^9}, {3.975111225617313*^9, 3.975111247830489*^9}, {
  3.975181884056244*^9, 3.975181886796801*^9}, {3.975181932105218*^9, 
  3.975181935297277*^9}, {3.9752560175239573`*^9, 3.9752560534305058`*^9}, {
  3.975262031991591*^9, 
  3.975262033495488*^9}},ExpressionUUID->"ceb358b9-daec-7948-9299-\
704e30eb3b15"],

Cell[TextData[{
 "A curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "6164febe-7f28-d644-b118-f196510e9f23"],
 " of points in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "n"], TraditionalForm]],ExpressionUUID->
  "062841a1-0db3-874b-99a5-929d3066a9d0"],
 " represents a ",
 StyleBox["mathematically possible",
  FontSlant->"Italic"],
 " path\[LongDash]a continuous sequence of coordinate values ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "j"], "(", "t", ")"}], TraditionalForm]],
  ExpressionUUID->"bf36173c-8308-a64f-b7c9-2acc2d291dd6"],
 "\[LongDash]taken by a physical system as it evolves in time. A ",
 StyleBox["physically possible",
  FontSlant->"Italic"],
 " path is one such path, often the one with ",
 StyleBox["least action",
  FontSlant->"Italic"],
 ", but this notebook doesn\[CloseCurlyQuote]t go deeply into this fact. "
}], "Text",
 CellChangeTimes->{{3.974904280138928*^9, 3.974904313497868*^9}, {
  3.9749043946351624`*^9, 3.9749043956039457`*^9}, {3.974905778070882*^9, 
  3.974905849287966*^9}, {3.974907599044756*^9, 3.974907708134343*^9}, {
  3.974933310857552*^9, 3.974933346312708*^9}, {3.97497977442906*^9, 
  3.9749798227232*^9}, {3.9751683121239643`*^9, 3.9751683146601*^9}, {
  3.975181946588151*^9, 3.975181973705731*^9}, {3.975256062230299*^9, 
  3.97525609007542*^9}, {3.975256273652524*^9, 3.97525633852918*^9}, {
  3.9752620712739477`*^9, 3.975262184530375*^9}, {3.9888739547504377`*^9, 
  3.988873955614764*^9}},ExpressionUUID->"5e94fb67-104c-984f-8a1f-\
e40e537ba5c1"],

Cell[TextData[{
 "The manifold ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "n"], TraditionalForm]],ExpressionUUID->
  "bc53a32a-d678-f04f-802e-ef76d027a9ca"],
 " represents the physical configuration of the system itself. The particular \
coordinate functions ",
 Cell[BoxData[
  FormBox[Cell[TextData[Cell[BoxData[
    FormBox[
     RowBox[{
      SuperscriptBox["x", "j"], "(", "t", ")"}], TraditionalForm]],
    ExpressionUUID->"57777d6f-059b-674c-b1f4-83e634c1e018"]],ExpressionUUID->
    "e1a38784-c183-5343-9cd7-3f11ad9cd0f4"], TraditionalForm]],ExpressionUUID->
  "f6d92f57-abf9-fa4a-a794-42466117f0d5"],
 " depend on a choice of generalized coordinates in the Lagrangian language. "
}], "Text",
 CellChangeTimes->{{3.974904280138928*^9, 3.974904313497868*^9}, {
  3.9749043946351624`*^9, 3.9749043956039457`*^9}, {3.974905778070882*^9, 
  3.974905849287966*^9}, {3.974907599044756*^9, 3.974907708134343*^9}, {
  3.974933310857552*^9, 3.974933346312708*^9}, {3.97497977442906*^9, 
  3.9749798227232*^9}, {3.9751683121239643`*^9, 3.9751683146601*^9}, {
  3.975181946588151*^9, 3.975181973705731*^9}, {3.975256062230299*^9, 
  3.97525609007542*^9}, {3.975256273652524*^9, 3.97525633852918*^9}, {
  3.9752620712739477`*^9, 
  3.975262165254484*^9}},ExpressionUUID->"acdbd5d6-0432-d74b-803e-\
4c04f44e33b2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Derivatives along a Curve", "Section",
 CellChangeTimes->{{3.974904421799736*^9, 3.974904423973572*^9}, {
  3.974936276678906*^9, 
  3.974936281633833*^9}},ExpressionUUID->"0e6df715-b692-694f-a6d1-\
1509bb3b0816"],

Cell[TextData[{
 "Mathematically possible curves must be twice-differentiable with respect to \
",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "0f564f87-22a9-4548-86b0-1a6081d081c3"],
 ", with first derivatives"
}], "Text",
 CellChangeTimes->{{3.974838112109644*^9, 3.974838139250259*^9}, {
  3.975256214642703*^9, 3.975256219421398*^9}, {3.9888740168918552`*^9, 
  3.988874020907806*^9}},ExpressionUUID->"cbd1b8db-ba63-ab4f-9170-\
dade25687845"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "j"], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"d", "\[VeryThinSpace]", 
      SuperscriptBox["x", "j"]}], 
     RowBox[{"d", "\[VeryThinSpace]", "t"}]], "\[Congruent]", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], "j"], 
     RowBox[{"(", "t", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9748383875167294`*^9, 3.974838465130704*^9}, {
  3.9748385427447767`*^9, 3.974838591191772*^9}},
 CellTags->
  "VELOCITY-VECTOR \
COMPONENTS",ExpressionUUID->"6a958dd0-ea71-6a46-a425-c94cf4d77023"],

Cell[TextData[{
 "These are components of ",
 StyleBox["contravariant velocity vector",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (with \[OpenCurlyDoubleQuote]up\[CloseCurlyDoubleQuote] indices) along the \
curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "ecfab6c3-9d11-b447-b80f-b189efb41678"],
 ". At each point ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", 
    RowBox[{"x", "(", "t", ")"}]}], TraditionalForm]],ExpressionUUID->
  "65da262a-8bac-0b49-8c01-619beb8522ca"],
 " along the curve (",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "09ba1a0c-eea9-3f42-b847-28e087ce5192"],
 " denoting the sequence ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["x", "1"], ",", 
     SuperscriptBox["x", "2"], ",", "\[Ellipsis]", ",", 
     SuperscriptBox["x", "n"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "507741bf-6f0b-a847-b59c-bc2dbb19de32"],
 ") the velocity vector lives in the tangent space ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", 
     RowBox[{"p", "=", 
      RowBox[{"x", "(", "t", ")"}]}]], 
    SubscriptBox["X", "n"]}], TraditionalForm]],ExpressionUUID->
  "7304b9ee-ed80-1847-92b7-84c24910b829"],
 " attached to the point ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "67018c7d-0d42-5843-9976-0e2fe9affb45"],
 "."
}], "Text",
 CellChangeTimes->{{3.9749056500699778`*^9, 3.974905666243074*^9}, {
   3.974905859182604*^9, 3.974905902376247*^9}, {3.9749064463208027`*^9, 
   3.974906458777169*^9}, {3.974908669333376*^9, 3.974908735469482*^9}, {
   3.974931055013707*^9, 3.97493113497935*^9}, 3.974931329574273*^9, {
   3.974933367686323*^9, 3.9749334056441183`*^9}, {3.974937093716061*^9, 
   3.974937148495392*^9}, {3.97497985202355*^9, 
   3.974979877890167*^9}},ExpressionUUID->"f3d0f974-56fd-1b45-958e-\
ebace3d377ad"],

Cell[TextData[{
 StyleBox["In some presentations, velocity vectors are directional-derivative \
operators in a ",
  FontSlant->"Italic"],
 StyleBox["covariant operator basis",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" (with \[OpenCurlyDoubleQuote]down\[CloseCurlyDoubleQuote] \
indices): ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "\[Congruent]", 
    RowBox[{
     SuperscriptBox["v", "j"], 
     SubscriptBox["\[PartialD]", "j"]}], "\[Congruent]", 
    RowBox[{
     SuperscriptBox["v", "j"], 
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "j"]}]]}], "\[Congruent]", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], "j"], 
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "j"]}]]}]}], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"154c5c48-8b31-c241-b202-4bfb83f92b84"],
 StyleBox[" via the ",
  FontSlant->"Italic"],
 StyleBox["summation convention",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" (sum over repeated \[OpenCurlyDoubleQuote]up-down\
\[CloseCurlyDoubleQuote] pairs of indices in product expressions or in \
tensorial expressions). Mentally distinguish the vector, a geometric object \
in the tangent space, from its components in some basis. We are free to \
choose bases however we like, even something as exotic as a derivative \
operator.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.974904469655386*^9, 3.974904491556582*^9}, {
   3.9749055967475224`*^9, 3.974905641833653*^9}, {3.974906467836877*^9, 
   3.9749065969107323`*^9}, {3.974906933349362*^9, 3.9749070252455063`*^9}, {
   3.974907255414914*^9, 3.9749073886843643`*^9}, {3.974907460411456*^9, 
   3.974907562227539*^9}, {3.9749077563759327`*^9, 3.9749078183175077`*^9}, {
   3.974907863298753*^9, 3.974908084130295*^9}, {3.9749081349860687`*^9, 
   3.974908179957054*^9}, {3.974908253977799*^9, 3.9749083702082872`*^9}, {
   3.9749084125539494`*^9, 3.974908490159955*^9}, {3.9749085343402567`*^9, 
   3.974908633607006*^9}, 3.974908758127057*^9, {3.9749303248931713`*^9, 
   3.974930327459682*^9}, {3.9749304329040737`*^9, 3.9749304861911097`*^9}, {
   3.974930529532589*^9, 3.974930543906859*^9}, {3.974933460301779*^9, 
   3.974933518876926*^9}, {3.9749798856491823`*^9, 3.974979899231785*^9}, {
   3.9749799316498613`*^9, 3.974979987731468*^9}, {3.974980075453381*^9, 
   3.974980084868751*^9}, {3.975088997820592*^9, 3.9750890304665337`*^9}, {
   3.975089081352767*^9, 3.975089111569057*^9}, {3.975182084164732*^9, 
   3.975182106356835*^9}, {3.975182158051689*^9, 3.9751821615174427`*^9}, {
   3.975183285253456*^9, 3.9751832852545633`*^9}, {3.9752563908316603`*^9, 
   3.9752563943324013`*^9}, {3.975284171893675*^9, 3.9752842905654907`*^9}, {
   3.9752843257106743`*^9, 
   3.975284360907634*^9}},ExpressionUUID->"d967dbb1-6da1-d44e-a140-\
da024c1c16ac"],

Cell[TextData[StyleBox["We elaborate on the terms \
\[OpenCurlyDoubleQuote]contravariant\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]covariant\[CloseCurlyDoubleQuote] below under the \
coordinate-transformation section.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.974980120373328*^9, 3.974980155210205*^9}, {
  3.9750890710111732`*^9, 3.9750890720240993`*^9}, {3.975168447483603*^9, 
  3.975168457711583*^9}, {3.975262257562949*^9, 
  3.9752622616710043`*^9}},ExpressionUUID->"3561190e-5c7f-4846-8a87-\
fcf3f8a667b9"],

Cell[TextData[{
 StyleBox["The summation convention is also called ",
  FontSlant->"Italic"],
 StyleBox["contraction",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.974904469655386*^9, 3.974904491556582*^9}, {
   3.9749055967475224`*^9, 3.974905641833653*^9}, {3.974906467836877*^9, 
   3.9749065969107323`*^9}, {3.974906933349362*^9, 3.9749070252455063`*^9}, {
   3.974907255414914*^9, 3.9749073886843643`*^9}, {3.974907460411456*^9, 
   3.974907562227539*^9}, {3.9749077563759327`*^9, 3.9749078183175077`*^9}, {
   3.974907863298753*^9, 3.974908084130295*^9}, {3.9749081349860687`*^9, 
   3.974908179957054*^9}, {3.974908253977799*^9, 3.9749083702082872`*^9}, {
   3.9749084125539494`*^9, 3.974908490159955*^9}, {3.9749085343402567`*^9, 
   3.974908633607006*^9}, 3.974908758127057*^9, {3.9749303248931713`*^9, 
   3.974930327459682*^9}, {3.9749304329040737`*^9, 3.9749304861911097`*^9}, {
   3.974930529532589*^9, 3.974930543906859*^9}, {3.974933460301779*^9, 
   3.974933518876926*^9}, {3.9749798856491823`*^9, 3.974979899231785*^9}, {
   3.9749799316498613`*^9, 3.974979987731468*^9}, {3.974980075453381*^9, 
   3.974980084868751*^9}, {3.975088997820592*^9, 3.9750890304665337`*^9}, {
   3.975089081352767*^9, 3.975089111569057*^9}, {3.975182084164732*^9, 
   3.975182106356835*^9}, {3.975182158051689*^9, 3.9751821615174427`*^9}, {
   3.9751832866212606`*^9, 
   3.97518330490269*^9}},ExpressionUUID->"7519fe51-7ab8-7e41-8d2b-\
154829ba9c22"],

Cell[TextData[{
 StyleBox["The components ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox["x", "\[FilledSmallCircle]"], "j"], "(", "t", ")"}], 
   TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"1b736225-c7ed-af49-88c3-cf4b0c4c3678"],
 " ",
 StyleBox["of velocities along the curve ",
  FontSlant->"Italic"],
 StyleBox["are the result of applying such directional derivative operators \
to the coordinate functions: ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["v", "i"], "\[Congruent]", 
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], "i"]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["v", "j"], "(", 
      RowBox[{
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "i"]}], "/", 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "j"]}]}], ")"}], "=", 
     RowBox[{
      SuperscriptBox["v", "j"], 
      SubsuperscriptBox["\[Delta]", "j", "i"]}]}]}], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"72a36fc8-3f66-a942-b760-53c0fc10468e"],
 StyleBox[". In traditional notation, one would write ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["v", "1"], ",", 
       SuperscriptBox["v", "2"], ",", "\[Ellipsis]", ",", 
       SuperscriptBox["v", "n"]}], ")"}], "\[FilledSmallCircle]", 
     "\[Del]"}]}], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"369c471c-f64e-ee45-9c27-45821f930765"],
 StyleBox[", a dot product of numerical components with a gradient operator. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.974904469655386*^9, 3.974904491556582*^9}, {
   3.9749055967475224`*^9, 3.974905641833653*^9}, {3.974906467836877*^9, 
   3.9749065969107323`*^9}, {3.974906933349362*^9, 3.9749070252455063`*^9}, {
   3.974907255414914*^9, 3.9749073886843643`*^9}, {3.974907460411456*^9, 
   3.974907562227539*^9}, {3.9749077563759327`*^9, 3.9749078183175077`*^9}, {
   3.974907863298753*^9, 3.974908084130295*^9}, {3.9749081349860687`*^9, 
   3.974908179957054*^9}, {3.974908253977799*^9, 3.9749083702082872`*^9}, {
   3.9749084125539494`*^9, 3.974908490159955*^9}, {3.9749085343402567`*^9, 
   3.974908633607006*^9}, 3.974908758127057*^9, {3.9749303248931713`*^9, 
   3.974930327459682*^9}, {3.9749304329040737`*^9, 3.9749304861911097`*^9}, {
   3.974930529532589*^9, 3.974930543906859*^9}, {3.974933460301779*^9, 
   3.974933518876926*^9}, {3.9749798856491823`*^9, 3.974979899231785*^9}, {
   3.9749799316498613`*^9, 3.974979987731468*^9}, {3.974980075453381*^9, 
   3.974980084868751*^9}, {3.975088997820592*^9, 3.975089018572508*^9}, {
   3.975182037808364*^9, 3.975182056016852*^9}, {3.975256409643667*^9, 
   3.975256425011092*^9}, {3.9888742135965548`*^9, 3.988874265474118*^9}, 
   3.988874301916966*^9},ExpressionUUID->"db6aa024-3672-c249-b020-\
e40964eb89a5"],

Cell[TextData[StyleBox["These derivative operators should remind you of \
momentum operators in quantum mechanics. ",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.974904469655386*^9, 3.974904491556582*^9}, {
   3.9749055967475224`*^9, 3.974905641833653*^9}, {3.974906467836877*^9, 
   3.9749065969107323`*^9}, {3.974906933349362*^9, 3.9749070252455063`*^9}, {
   3.974907255414914*^9, 3.9749073886843643`*^9}, {3.974907460411456*^9, 
   3.974907562227539*^9}, {3.9749077563759327`*^9, 3.9749078183175077`*^9}, {
   3.974907863298753*^9, 3.974908084130295*^9}, {3.9749081349860687`*^9, 
   3.974908179957054*^9}, {3.974908253977799*^9, 3.9749083702082872`*^9}, {
   3.9749084125539494`*^9, 3.974908490159955*^9}, {3.9749085343402567`*^9, 
   3.974908633607006*^9}, 3.974908758127057*^9, {3.9749303248931713`*^9, 
   3.974930327459682*^9}, {3.9749304329040737`*^9, 3.9749304861911097`*^9}, {
   3.974930529532589*^9, 3.974930543906859*^9}, {3.974933460301779*^9, 
   3.974933518876926*^9}, {3.9749798856491823`*^9, 3.974979899231785*^9}, {
   3.9749799316498613`*^9, 3.974979987731468*^9}, {3.974980075453381*^9, 
   3.974980084868751*^9}, {3.975088997820592*^9, 
   3.975089033387738*^9}},ExpressionUUID->"d1617727-2ec3-304a-9682-\
6890e6d3021e"],

Cell[TextData[{
 StyleBox["In coordinate-free presentations, tangent vectors are ",
  FontSlant->"Italic"],
 StyleBox["equivalence classes of curves",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[". One abstractly defines addition of equivalence classes and \
multiplication of equivalence classes by scalars to make the equivalence \
classes resemble ordinary vectors as tuples of components. \
\[OpenCurlyDoubleQuote]Resemble,\[CloseCurlyDoubleQuote] here, means \
\[OpenCurlyDoubleQuote]satisfy the axioms of a vector space.\
\[CloseCurlyDoubleQuote] Thus, the equivalence classes become vectors in a \
rigorously mathematical sense.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9749305512744093`*^9, 3.9749306198732224`*^9}, {
  3.975256497815508*^9, 3.975256520687096*^9}, {3.975262310280633*^9, 
  3.975262368642785*^9}, {3.988874332446803*^9, 
  3.988874386223311*^9}},ExpressionUUID->"74720fe9-54cd-c244-8439-\
cc51d1183e88"],

Cell[TextData[{
 "While the manifold ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "n"], TraditionalForm]],ExpressionUUID->
  "a0fffbd0-795b-d04a-a43a-66ad5a20b6c4"],
 "\:200b has ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "c523f898-8630-c143-a773-17912cd2d673"],
 " dimensions (",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "aeb5923a-08e5-6540-881c-0608fff0c74f"],
 " equals the number of degrees of freedom of the system), the curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", 
    RowBox[{"(", "t", ")"}]}], TraditionalForm]],ExpressionUUID->
  "3327a5e0-c8bc-ad40-8fbe-a167b4d7f530"],
 " is a 1\[NoBreak]-\[NoBreak]dimensional object. This is why we can describe \
the kinematics and dynamics of a complex system like a steam engine using a \
single parameter ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "62790435-7912-664d-adeb-59f314a0d510"],
 "."
}], "Text",
 CellChangeTimes->{{3.975111452532542*^9, 3.975111519391663*^9}, {
  3.975168512502253*^9, 3.975168524772029*^9}, {3.975256530757962*^9, 
  3.975256548163916*^9}},ExpressionUUID->"bfc6b7ae-6eb5-c84d-be05-\
82d38f58e286"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Lagrangian and Action", "Section",
 CellChangeTimes->{{3.9749086471514673`*^9, 3.974908650110715*^9}, {
  3.974935319109147*^9, 
  3.974935321249093*^9}},ExpressionUUID->"92860e24-887f-2b49-a583-\
6542ae268470"],

Cell[TextData[{
 "Let the Lagrangian ",
 Cell[BoxData[
  FormBox[
   RowBox[{"L", "(", 
    RowBox[{"t", ",", 
     SuperscriptBox["x", "j"], ",", 
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], "j"]}], ")"}], 
   TraditionalForm]],ExpressionUUID->"ecd3148d-b3cc-e644-9b8d-a6f6cae4e5cf"],
 " be a twice-differentiable function of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "n"}], "+", "1"}], TraditionalForm]],ExpressionUUID->
  "b9b99246-51cf-4443-b26f-aaa371b2ff42"],
 " independent variables, noting that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "j"], TraditionalForm]],ExpressionUUID->
  "17a83357-50a0-1e48-8998-8667fac20663"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "j"], TraditionalForm]],
  ExpressionUUID->"7ffb272d-f772-c942-b9b0-10e191e3a46e"],
 " may be treated, at will, as variables or functions. "
}], "Text",
 CellChangeTimes->{{3.974838614721426*^9, 3.974838903258356*^9}, {
   3.974839042206265*^9, 3.97483904797799*^9}, {3.974839175607698*^9, 
   3.9748392162876987`*^9}, {3.974903931664954*^9, 3.974903972320333*^9}, {
   3.974931231191711*^9, 3.974931233403346*^9}, {3.974931264147922*^9, 
   3.9749312755832376`*^9}, {3.974980199921876*^9, 3.974980202639127*^9}, 
   3.974982557055214*^9, {3.975086688520455*^9, 3.975086690459981*^9}, 
   3.9751685460463533`*^9, {3.9752626548958797`*^9, 
   3.9752626556347847`*^9}},ExpressionUUID->"eae7d8d6-993d-704c-87f1-\
ca22bd5a4645"],

Cell[TextData[{
 StyleBox["Treating the arguments of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "a5c00cbc-dadc-514f-b226-f6a34d10fcdd"],
 StyleBox[" as independent variables is justified because, as variables, they \
just describe kinematically (mathematically) possible states of the system. \
Dynamical evolution takes place along one specific curve ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "b224df09-7ea6-4b46-aef9-ebeb813c8436"],
 ", the physically possible curve,",
 StyleBox[" where the arguments are functions of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "9b32fbc2-9878-a547-843a-007731ed4729"],
 "."
}], "Item",
 CellChangeTimes->{{3.975168554684759*^9, 3.9751686089700127`*^9}, {
  3.975182223321261*^9, 3.9751822595833063`*^9}, {3.9751822906257277`*^9, 
  3.975182299677959*^9}, {3.975256573125025*^9, 3.9752566315790977`*^9}, {
  3.9752626119024267`*^9, 3.975262638790897*^9}, {3.988874423679188*^9, 
  3.988874472942317*^9}},ExpressionUUID->"376d3385-19c5-3f46-b1ff-\
02ae4d6fee4f"],

Cell[TextData[{
 "Let the ",
 StyleBox["action integral",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " along some curve ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "d5b4fa99-69ae-9545-8d42-99a6d36f0347"],
 " be "
}], "Text",
 CellChangeTimes->{{3.974838614721426*^9, 3.974838903258356*^9}, {
   3.974839042206265*^9, 3.97483904797799*^9}, {3.974839175607698*^9, 
   3.9748392162876987`*^9}, {3.974903931664954*^9, 3.974903972320333*^9}, {
   3.974931231191711*^9, 3.974931233403346*^9}, {3.974931264147922*^9, 
   3.9749312755832376`*^9}, {3.974980199921876*^9, 3.974980202639127*^9}, 
   3.974982557055214*^9, {3.975086688520455*^9, 3.975086690459981*^9}, {
   3.975262674455658*^9, 
   3.975262680131866*^9}},ExpressionUUID->"51246721-c537-5d4f-9513-\
ff8527e3e4bc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"I", 
    RowBox[{"(", "C", ")"}]}], "=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{" ", 
      RowBox[{"t", "=", 
       SubscriptBox["t", "1"]}]}], 
     RowBox[{" ", 
      RowBox[{"t", "=", 
       SubscriptBox["t", "2"]}]}]], 
    RowBox[{"L", 
     RowBox[{"(", 
      RowBox[{"t", ",", 
       RowBox[{
        SuperscriptBox["x", "j"], "(", "t", ")"}], ",", 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["x", "\[FilledSmallCircle]"], "j"], "(", "t", ")"}]}], 
      ")"}], 
     RowBox[{"\[DifferentialD]", "t"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9748392203107758`*^9, 3.974839287340811*^9}, {
  3.974839331461722*^9, 3.974839345068219*^9}, {3.975168624851574*^9, 
  3.975168627482049*^9}},
 CellTags->
  "LOVELOCK ACTION \
INTEGRAL",ExpressionUUID->"e2ef13fb-558c-8543-9473-c54274b392a9"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "j"], "(", "t", ")"}], TraditionalForm]],
  ExpressionUUID->"4ab8b96f-9cda-a443-ae61-6618a54feba6"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox["x", "\[FilledSmallCircle]"], "j"], "(", "t", ")"}], 
   TraditionalForm]],ExpressionUUID->"012ccd9f-48bd-0344-8338-ab4d7d20b6c6"],
 " here denoting the values of functions ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "j"], TraditionalForm]],ExpressionUUID->
  "94098901-9cf7-1f47-9e0b-5c0de25ac101"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "j"], TraditionalForm]],
  ExpressionUUID->"82df90c3-fba1-0040-8e8a-26a4c1137da0"],
 " at parameter values ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "3f1c7df0-af71-0448-8f52-80325fec026d"],
 " along some curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "d7fb5ffc-2db3-4545-a58a-dedbeb3cf2fd"],
 ".  "
}], "Text",
 CellChangeTimes->{{3.9748393711473637`*^9, 3.974839425463805*^9}, {
   3.974839557997168*^9, 3.974839592896125*^9}, {3.9752566712223787`*^9, 
   3.975256681084755*^9}, 
   3.975262696185817*^9},ExpressionUUID->"5ddd2ab1-30a7-0440-b1db-\
2f25153779ff"],

Cell[TextData[StyleBox["The action is a scalar real number. It has different \
values for different curves.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.975168656917274*^9, 
  3.9751686725439243`*^9}},ExpressionUUID->"63207f6b-7009-9347-8892-\
ee7d930943d8"],

Cell[TextData[{
 StyleBox["The ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "n"}], "+", "1"}], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"fa327933-af25-004a-96d5-42bc8a15b603"],
 StyleBox[" dimensionality will be critical to understanding gauge freedom. \
For now, the ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "n"}], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"b5692d4a-ea94-2543-9172-9cd28e401255"],
 StyleBox[" generalized coordinates and velocities double as dynamical \
variables that double as functions of t, leading to equations of motion, and \
Newtonian time ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "b2b84e9a-708f-4943-b1a6-87701c547490"],
 StyleBox[" is the privileged, universal parameter for tracking dynamical \
evolution of these variables. Later, we demote time ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"c57e00cd-d7c1-d240-924c-fc2d301e4b6a"],
 StyleBox[" to be just another variable, opening the door to relativity, and \
replace its dynamical-tracking role with a freely chosen parameter ",
  FontSlant->"Italic"],
 "\[Tau]",
 StyleBox[" as a gauge.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9751116852869177`*^9, 3.9751117115977287`*^9}, {
  3.975114790214367*^9, 3.975115028697291*^9}, {3.97518233153544*^9, 
  3.975182379678108*^9}, {3.975256703939748*^9, 3.9752567039440603`*^9}, {
  3.975262729502316*^9, 3.9752627355716887`*^9}, {3.9888745595931*^9, 
  3.9888746033710423`*^9}},ExpressionUUID->"65e62fcd-b2c5-b44f-8858-\
f97e8f1560ff"],

Cell[TextData[{
 StyleBox["This notebook is not concerned with solving the dynamical \
equations to find a \[OpenCurlyDoubleQuote]best\[CloseCurlyDoubleQuote] \
curve. Such is the subject of others of my notebooks. For now, just realize \
that the action integral is a function of the whole curve. Give me a curve ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "90d1eba3-e0cc-2d46-a92d-e5a7523e9a70"],
 StyleBox[" and I\[CloseCurlyQuote]ll tell you the action ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"I", "(", "C", ")"}], TraditionalForm]],ExpressionUUID->
  "0cf72f5f-d392-b541-94ca-f5a2e7896be8"],
 " ",
 StyleBox["along that curve.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9751116852869177`*^9, 3.9751117115977287`*^9}, {
  3.975114790214367*^9, 3.975115028697291*^9}, {3.97518233153544*^9, 
  3.975182379678108*^9}, {3.975256705652308*^9, 3.975256814539583*^9}, {
  3.975262771616394*^9, 3.975262774055242*^9}, {3.988874638749378*^9, 
  3.988874639910994*^9}},ExpressionUUID->"4970e57d-d151-824d-a625-\
52e746c91c51"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Coordinate Transformations", "Section",
 CellChangeTimes->{{3.974935271773293*^9, 
  3.974935276659358*^9}},ExpressionUUID->"773f7968-7b11-3149-88da-\
0d528d8b7337"],

Cell[TextData[{
 "To define ",
 StyleBox["coordinate invariance",
  FontSlant->"Italic"],
 " of the Lagrangian, we need results in this section. "
}], "Text",
 CellChangeTimes->{{3.974840023907936*^9, 3.974840031984309*^9}, {
  3.974840261735073*^9, 3.9748402638127747`*^9}, {3.9749313670780163`*^9, 
  3.9749314226373672`*^9}, {3.97493528325721*^9, 3.974935308969586*^9}, {
  3.9749802218468113`*^9, 3.974980226981101*^9}, {3.975089150200727*^9, 
  3.975089151745562*^9}, {3.975256839703393*^9, 3.975256840097171*^9}, {
  3.9888746578658733`*^9, 
  3.988874681746455*^9}},ExpressionUUID->"14acd0cf-7710-5b4a-9b6e-\
7e81e4dc1e3c"],

Cell[TextData[{
 "Consider invertible, continuous, twice-differentiable \
coordinate-transformation functions to and from a new ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "50a6cd4e-2b83-ce4f-9c8e-fb0b7155078b"],
 "\[NoBreak]-\[NoBreak]dimensional coordinate system ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "_"], TraditionalForm]],ExpressionUUID->
  "f891bcab-bfce-3340-ad99-9e65ef6894b2"],
 ", keeping the same parameter ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "766aa944-8c80-7742-acc1-9af79e8d01d8"],
 " (we\[CloseCurlyQuote]ll change ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "ae377e1e-73d4-5340-8eb6-4920f17bfc0d"],
 " later):"
}], "Text",
 CellChangeTimes->{{3.974840023907936*^9, 3.974840031984309*^9}, {
  3.974840261735073*^9, 3.9748402638127747`*^9}, {3.9749313670780163`*^9, 
  3.9749314226373672`*^9}, {3.97493528325721*^9, 3.974935307898299*^9}, {
  3.97493634573111*^9, 3.9749363664984627`*^9}, {3.974983751120579*^9, 
  3.9749837674934053`*^9}, {3.975256859107942*^9, 3.9752568596580877`*^9}, {
  3.988874700027897*^9, 
  3.988874714760098*^9}},ExpressionUUID->"64c8e56b-1b10-2141-8f58-\
c5019c362dae"],

Cell[BoxData[{
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     OverscriptBox["x", "_"], "j"], "=", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox["x", "_"], "j"], "(", 
     SuperscriptBox["x", "h"], ")"}]}], " "}], TraditionalForm], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{
   SuperscriptBox["x", "h"], "=", 
   RowBox[{
    SuperscriptBox["x", "h"], "(", 
    SuperscriptBox[
     OverscriptBox["x", "_"], "j"], ")"}]}], 
  TraditionalForm]}], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974840043733162*^9, 3.974840072941757*^9}, {
  3.9748401034197407`*^9, 3.9748401798953953`*^9}, {3.9748403634010878`*^9, 
  3.974840385959042*^9}, {3.988874725698884*^9, 3.9888747282789793`*^9}},
 CellTags->
  "COORDINATE TRANSFORMATION \
FUNCTIONS",ExpressionUUID->"d1497b44-8f74-1e45-b104-623eb24260aa"],

Cell[TextData[{
 "The derivatives ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "h"], TraditionalForm]],
  ExpressionUUID->"9f49dcfc-c5bf-d744-86f5-c592b1baf599"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox[
     OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"], 
   TraditionalForm]], "DisplayFormulaNumbered",
  CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
   3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
   3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
   3.974843674026392*^9, 3.974843676763193*^9}},ExpressionUUID->
  "dbaf47c3-bc61-474d-bc6c-3ee5d2be251e"],
 " transform ",
 StyleBox["contravariantly",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " by the chain rule from the transformation functions:"
}], "Text",
 CellChangeTimes->{{3.974840491078636*^9, 3.97484056846175*^9}, {
   3.974931469855213*^9, 3.9749314731142273`*^9}, {3.974933595945074*^9, 
   3.974933612962946*^9}, {3.974933649297406*^9, 3.974933672677791*^9}, 
   3.97518242244903*^9, {3.9888757082595663`*^9, 
   3.988875718791053*^9}},ExpressionUUID->"23bd14c3-3a28-514e-a0b3-\
c83cc199a027"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "h"], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "h"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        OverscriptBox["x", "_"], "j"]}]], 
     SuperscriptBox[
      OverscriptBox[
       OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"]}], "\[Congruent]", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox["x", "\[FilledSmallCircle]"], "h"], "(", 
     RowBox[{
      SuperscriptBox[
       OverscriptBox["x", "_"], "j"], ",", 
      SuperscriptBox[
       OverscriptBox[
        OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
  3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
  3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
  3.974843674026392*^9, 3.974843676763193*^9}},
 CellTags->
  "COORDINATE TRANSFORMATION \
DERIVATIVES",ExpressionUUID->"d90f2f8b-e2d2-c549-ad56-6315fd368383"],

Cell[TextData[{
 StyleBox["Contravariance",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" of a tensorial (geometrical) object like the velocity vector with \
components ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "h"], TraditionalForm]],
  ExpressionUUID->"cd7887b4-7892-4992-a0a1-5b5daf6b7db9"],
 StyleBox[" means that the magnitudes of components transform oppositely to \
the coordinate system. For example, Let  ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    OverscriptBox["x", "_"], "\[FilledSmallCircle]"], TraditionalForm]],
  CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
   3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
   3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
   3.974843674026392*^9, 3.974843676763193*^9}},
  FontSlant->"Plain",ExpressionUUID->"e81872ee-bee8-114c-9e90-375e7d79eb4b"],
 StyleBox[" (with the bar) measure a velocity in feet per second and ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "\[FilledSmallCircle]"], TraditionalForm]],
  CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
   3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
   3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
   3.974843674026392*^9, 3.974843676763193*^9}},
  FontSlant->"Plain",ExpressionUUID->"483e7907-bd62-6f41-a91e-ffb4fb9c2da6"],
 StyleBox[" (without the bar) measure the same velocity in inches per second. \
",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox[
     RowBox[{"\[PartialD]", "x"}], 
     RowBox[{"\[PartialD]", 
      OverscriptBox["x", "_"]}]],
    FontSlant->"Plain"], TraditionalForm]],
  CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
   3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
   3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
   3.974843674026392*^9, 3.974843676763193*^9}},
  FontSlant->"Italic",ExpressionUUID->"67600698-e53e-9d43-9138-c1670563ca1b"],
 StyleBox[" will be ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["12", TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"1ea252fe-9ee5-6f4e-ae1d-0ec385f1d54d"],
 StyleBox[" inches per foot, but the magnitude of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    OverscriptBox["x", "_"], "\[FilledSmallCircle]"], TraditionalForm]], 
  "Input",
  CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
   3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
   3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
   3.974843674026392*^9, 3.974843676763193*^9}},
  FontSlant->"Plain",ExpressionUUID->"1aecb9ac-b6e5-7f40-a1db-47827d134c2e"],
 StyleBox[" in feet per second will be ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "12"}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"fe4a595a-5911-d746-ba68-e68cc181b5cb"],
 StyleBox[" the magnitude of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "\[FilledSmallCircle]"], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"19976d43-02b0-f640-95ff-5aba8140db57"],
 StyleBox[" in inches per second: ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["x", "\[FilledSmallCircle]"], "(", "ips", ")"}], "=", 
    RowBox[{
     StyleBox[
      FractionBox[
       RowBox[{"\[PartialD]", "x"}], 
       RowBox[{"\[PartialD]", 
        OverscriptBox["x", "_"]}]],
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["(",
       FontSlant->"Plain"], 
      RowBox[{
       StyleBox["12",
        FontSlant->"Plain"], 
       StyleBox[" ",
        FontSlant->"Plain"], 
       FractionBox[
        StyleBox["inch",
         FontSlant->"Plain"], "foot"]}], ")"}], 
     RowBox[{
      OverscriptBox[
       OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "(", "fps", 
      ")"}]}]}], TraditionalForm]],
  CellChangeTimes->{{3.974840581245096*^9, 3.9748407498648043`*^9}, {
   3.974841129611528*^9, 3.9748411584368134`*^9}, {3.9748413057307673`*^9, 
   3.974841309193672*^9}, {3.974843486191566*^9, 3.974843490454834*^9}, {
   3.974843674026392*^9, 3.974843676763193*^9}},
  FontSlant->"Plain",ExpressionUUID->"d02d2818-ff27-4795-9486-7a2ce6901407"],
 ", with the barred coordinates \[OpenCurlyDoubleQuote]on the bottom\
\[CloseCurlyDoubleQuote] multiplying the barred quantity."
}], "Item",
 CellChangeTimes->{{3.9749802641627283`*^9, 3.974980480908794*^9}, {
  3.974980516425631*^9, 3.974980637802083*^9}, {3.9749806866470537`*^9, 
