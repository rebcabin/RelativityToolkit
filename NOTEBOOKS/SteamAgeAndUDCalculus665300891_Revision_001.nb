Cell[BoxData[{
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[PartialD]", "\[Phi]"}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "\[Rho]"]}]], "[", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Eta]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "(", 
     RowBox[{
      SuperscriptBox["x", "\[Mu]"], "-", 
      RowBox[{
       SuperscriptBox["z", "\[Mu]"], "(", 
       SubscriptBox["s", "R"], ")"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["x", "\[Nu]"], "-", 
      RowBox[{
       SuperscriptBox["z", "\[Nu]"], "(", 
       SubscriptBox["s", "R"], ")"}]}], ")"}]}], "]"}], TraditionalForm], "\[LineSeparator]", 
 FormBox[
  RowBox[{"=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Eta]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "(", 
      RowBox[{
       SuperscriptBox["x", "\[Nu]"], "-", 
       SuperscriptBox[
        RowBox[{"z", "(", "s", ")"}], 
        RowBox[{"\[VeryThinSpace]", "\[Nu]"}]]}], ")"}], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "\[Rho]"]}]]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Eta]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "(", 
      RowBox[{
       SuperscriptBox["x", "\[Mu]"], "-", 
       SuperscriptBox[
        RowBox[{"z", "(", "s", ")"}], 
        RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}], ")"}], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{"\[VeryThinSpace]", "\[Nu]"}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "\[Rho]"]}]]}]}]}], TraditionalForm], "\[LineSeparator]", 
 FormBox[
  RowBox[{"=", 
   RowBox[{"2", 
    RowBox[{
     SubscriptBox["\[Eta]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Rho]"}]], "(", 
     RowBox[{
      SuperscriptBox["x", "\[Mu]"], "-", 
      RowBox[{
       SuperscriptBox["z", "\[Mu]"], "(", "s", ")"}]}], ")"}]}]}], 
  TraditionalForm], "\[LineSeparator]", 
 FormBox[
  RowBox[{"=", 
   RowBox[{"2", 
    SubscriptBox["\[Eta]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Rho]"}]], 
    SuperscriptBox["\[Sigma]", 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}]}], TraditionalForm], "\[LineSeparator]", 
 FormBox[
  RowBox[{"=", 
   RowBox[{"2", 
    SubscriptBox["\[Sigma]", "\[Rho]"]}]}], TraditionalForm], "\[LineSeparator]", 
 FormBox[
  RowBox[{"=", 
   RowBox[{"2", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[Sigma]", "0"], ",", 
      RowBox[{"-", 
       SuperscriptBox["\[Sigma]", "1"]}], ",", 
      RowBox[{"-", 
       SuperscriptBox["\[Sigma]", "2"]}], ",", 
      RowBox[{"-", 
       SuperscriptBox["\[Sigma]", "3"]}]}], ")"}]}]}], 
  TraditionalForm]}], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.97614347647685*^9, 3.976143495921154*^9}, {
  3.976143528743463*^9, 3.976143531526016*^9}, {3.976143579617711*^9, 
