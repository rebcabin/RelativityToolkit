   3.9758654437722883`*^9, 3.975865468563541*^9}, {3.975866043203883*^9, 
   3.975866044997366*^9}, 3.975884525696292*^9, 3.97596189419779*^9, {
   3.975961933607203*^9, 3.97596194008182*^9}, {3.97596199605112*^9, 
   3.975962000958351*^9}, {3.975962038897273*^9, 3.975962066169655*^9}, {
