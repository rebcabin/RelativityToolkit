  3.975884315490757*^9}},ExpressionUUID->"bd8d2b17-3390-a949-ba6a-\
ae0e460f2a2e"],

Cell[BoxData[
 FormBox[
  RowBox[{"R", "\[Congruent]", 
   RowBox[{"\[LeftBracketingBar]", 
    RowBox[{
     StyleBox["x",
      FontWeight->"Bold"], "-", 
     RowBox[{
      StyleBox["z",
       FontWeight->"Bold"], 
      RowBox[{"(", 
       SubscriptBox["s", "R"], ")"}]}]}], "\[RightBracketingBar]"}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9757874598610573`*^9, 3.9757874824688683`*^9}, {
  3.975787520230523*^9, 3.975787528842773*^9}, {3.97578764613335*^9, 
  3.975787646136039*^9}},ExpressionUUID->"7daa8712-a0cb-9a48-ae13-\
cd1a69d09d7d"],

Cell[TextData[{
 "Defining a unit vector pointing from ",
 Cell[BoxData[
  FormBox[
   StyleBox["x",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "f2ca5002-18ed-a14d-8c62-12b536271871"],
 " to the retarded position of the source, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["z",
     FontWeight->"Bold"], "(", 
    SubscriptBox["s", "R"], ")"}], TraditionalForm]],ExpressionUUID->
  "1cf3a6e8-6747-f540-8b25-56ef2301e9c5"]
}], "Text",
