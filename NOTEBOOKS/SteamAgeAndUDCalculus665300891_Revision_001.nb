Cell[CellGroupData[{

Cell["Coordinate Invariance of the Action", "Section",
 CellChangeTimes->{{3.97493524336943*^9, 3.9749352473554373`*^9}, {
  3.9749824155311604`*^9, 
  3.974982418741001*^9}},ExpressionUUID->"122b0c28-b750-3f45-9d87-\
b5c499b8a701"],

Cell[TextData[{
 "For the action integral, Equation ",
 
 CounterBox["DisplayFormulaNumbered", "LOVELOCK ACTION INTEGRAL"],
 ", to be invariant with respect to coordinate transformations, it ",
 StyleBox["suffices",
  FontWeight->"Bold"],
 " to have"
}], "Text",
 CellChangeTimes->{{3.9748418905835953`*^9, 3.974841938844995*^9}, {
  3.974842082768436*^9, 3.974842094690179*^9}, {3.9748422605883503`*^9, 
  3.974842266121037*^9}, {3.974843952964323*^9, 3.974843971029723*^9}, {
  3.974844211743681*^9, 3.974844260924436*^9}, {3.9749809451076193`*^9, 
  3.974980952506074*^9}, {3.975182556376075*^9, 
  3.975182561820051*^9}},ExpressionUUID->"5c6f914f-3d1d-4c49-847d-\
439b3abad543"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["L", "_"], 
    RowBox[{"(", 
     RowBox[{"t", ",", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["x", "_"], "j"], 
       RowBox[{"(", "t", ")"}]}], ",", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox[
         OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"], 
       RowBox[{"(", "t", ")"}]}]}], ")"}]}], "=", 
   RowBox[{"L", 
    RowBox[{"(", 
     RowBox[{"t", ",", 
      RowBox[{
       SuperscriptBox["x", "h"], 
       RowBox[{"(", 
        SuperscriptBox[
         OverscriptBox["x", "_"], "j"], ")"}]}], ",", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["x", "\[FilledSmallCircle]"], "h"], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          OverscriptBox["x", "_"], "j"], ",", 
         SuperscriptBox[
          OverscriptBox[
           OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"]}], 
        ")"}]}]}], ")"}]}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.974842016965528*^9, 3.974842077163102*^9}, {
  3.974842108001051*^9, 3.974842131478362*^9}, {3.9748421766836643`*^9, 
  3.974842191314451*^9}, {3.974842462468707*^9, 3.97484246247016*^9}},
 CellTags->
  "COORDINATE \
INVARIANCE",ExpressionUUID->"e716e605-355f-7742-8b46-d5d4f8684c44"],

Cell[TextData[{
 "with the ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "271f0e1f-29ba-054d-a3d3-5b29e050b98a"],
 " indices varying independently, e.g., ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "\[FilledSmallCircle]"], "h"], TraditionalForm]],
  ExpressionUUID->"c673ff5b-4401-bc42-9247-91f956454227"],
 " depends on all the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["x", "_"], "j"], TraditionalForm]],ExpressionUUID->
  "c62d9e34-5d4c-6649-9f6e-c5f1825b5751"],
 " and on all the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox[
     OverscriptBox["x", "_"], "\[FilledSmallCircle]"], "j"], 
   TraditionalForm]],ExpressionUUID->"c05fc51d-f6c3-bc45-8d7c-2bd996b36a26"],
 ", not just in matched pairs, and where ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["L", "_"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5d2860e7-f2f9-4958-b9fa-a3fae27afcd6"],
 " might be a different ",
 StyleBox["form",
  FontSlant->"Italic"],
 " from ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f2ba41d8-d9c0-4822-bf94-b98304fedab4"],
 ", but the values of the two functions at the specified point (with the two \
different coordinates!) are equal. "
}], "Text",
 CellChangeTimes->{{3.974842320104672*^9, 3.974842435895337*^9}, {
   3.9748424868817863`*^9, 3.974842499212853*^9}, {3.9748425439585857`*^9, 
   3.9748425597004766`*^9}, 3.974933787382159*^9, 3.9749829872514133`*^9, {
   3.975257316206092*^9, 3.975257317057845*^9}, {3.988876439661878*^9, 
   3.988876554380678*^9}},ExpressionUUID->"b700519a-0caa-044c-b8cc-\
b8217a694b27"],

Cell[TextData[{
 StyleBox["TODO: prove ",
  FontSlant->"Italic"],
 StyleBox["necessity",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[". Hint: invariance of the action integral must hold for any curve ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "1b83bdd5-d0de-b249-8189-f78c05046456"],
 StyleBox[" and any endpoints ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "1"], TraditionalForm]],ExpressionUUID->
  "d22e648a-0dac-b440-8cde-fb2501b174bf"],
 StyleBox[" and ",
