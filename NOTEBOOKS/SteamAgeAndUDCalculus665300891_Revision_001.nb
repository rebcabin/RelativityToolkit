Cell[CellGroupData[{

Cell["The Return of the Singularity", "Subsection",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 3.975185960766884*^9}, {
   3.975186335204997*^9, 3.975186378447083*^9}, {3.975186481658581*^9, 
   3.975186523869499*^9}, {3.975186557291993*^9, 3.975186598287777*^9}, {
   3.9751867212544107`*^9, 3.9751868361873503`*^9}, {3.9751868702450438`*^9, 
   3.975186918879197*^9}, 3.975187383155944*^9, {3.975187474714205*^9, 
   3.975187559493368*^9}, {3.975187877891349*^9, 3.975188018394823*^9}, {
   3.975188095613347*^9, 
   3.975188213781353*^9}},ExpressionUUID->"f16b3e36-b975-614e-87b2-\
55d830703508"],

Cell[TextData[{
 "Just as with our relativistic particle, the Lagrangian (densities) for the \
photon (Maxwell), the weak-force bosons ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["W", "\[PlusMinus]"], ",", "Z"}], TraditionalForm]],
  ExpressionUUID->"5bd66cda-3d9d-924a-a86f-6ba29eafac72"],
 " (Weinberg-Salam), and gluons (Yang-Mills) have singular Hessians. They are \
gauge theories precisely because they possess this mathematical redundancy."
}], "Text",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 3.975185960766884*^9}, {
   3.975186335204997*^9, 3.975186378447083*^9}, {3.975186481658581*^9, 
   3.975186523869499*^9}, {3.975186557291993*^9, 3.975186598287777*^9}, {
   3.9751867212544107`*^9, 3.9751868361873503`*^9}, {3.9751868702450438`*^9, 
   3.975186918879197*^9}, 3.975187383155944*^9, {3.975187474714205*^9, 
   3.975187559493368*^9}, {3.975187877891349*^9, 3.975188018394823*^9}, {
   3.975188095613347*^9, 3.975188237850584*^9}, {3.975188286699457*^9, 
   3.975188290432317*^9}, {3.9751885196087027`*^9, 3.9751885216607018`*^9}, {
   3.975279495941197*^9, 3.975279495969466*^9}, {3.975279551714699*^9, 
   3.975279654494047*^9}, {3.975279696560364*^9, 
   3.9752797006389217`*^9}},ExpressionUUID->"f7439562-6982-7443-b0aa-\
f8957da757ca"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Ultimate Objective: The Standard Model", "Subsection",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 3.975185960766884*^9}, {
   3.975186335204997*^9, 3.975186378447083*^9}, {3.975186481658581*^9, 
   3.975186523869499*^9}, {3.975186557291993*^9, 3.975186598287777*^9}, {
   3.9751867212544107`*^9, 3.9751868361873503`*^9}, {3.9751868702450438`*^9, 
   3.975186918879197*^9}, 3.975187383155944*^9, {3.975187474714205*^9, 
   3.975187559493368*^9}, {3.975187877891349*^9, 3.975188018394823*^9}, {
   3.975188095613347*^9, 3.975188237850584*^9}, {3.975188286699457*^9, 
