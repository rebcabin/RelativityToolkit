  3.976265875412549*^9}},ExpressionUUID->"d2d4bcdb-d3cb-d445-921a-\
9a7e0d24cdd9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fourGrad", "[", 
    RowBox[{
     RowBox[{"\[Sigma]", "[", "ud\[Nu]_", "]"}], ",", "ud\[Mu]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Eta]", "[", 
     RowBox[{"ud\[Mu]", ",", "ud\[Nu]"}], "]"}], "-", 
    RowBox[{
     RowBox[{"\[Lambda]", "[", "ud\[Nu]", "]"}], 
     FractionBox[
      RowBox[{"\[Sigma]", "[", "ud\[Mu]", "]"}], "r"]}]}]}], ";"}]], "Input",
