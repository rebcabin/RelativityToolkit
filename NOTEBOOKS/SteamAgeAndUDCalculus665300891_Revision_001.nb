}], "Text",
 CellChangeTimes->{{3.976113721464932*^9, 3.9761137979529047`*^9}, {
   3.9761140459038363`*^9, 3.976114094056716*^9}, {3.976114221289227*^9, 
   3.9761142489188766`*^9}, {3.976114336253667*^9, 3.976114337802025*^9}, {
   3.976115737081987*^9, 3.9761157454649487`*^9}, {3.976121083109178*^9, 
   3.976121144602189*^9}, {3.976137873451281*^9, 3.976137875293004*^9}, 
   3.976141431057016*^9, 3.976145457582529*^9, {3.976192156411159*^9, 
   3.976192162247826*^9}, {3.976192192255924*^9, 3.976192210305716*^9}, 
   3.976192393497826*^9, 
   3.976289827376842*^9},ExpressionUUID->"013fbe51-488f-5b44-b786-\
e9d0e7ba3510"],

Cell[TextData[{
 "Begin with the ",
 StyleBox["separation vector",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Sigma]", 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], "=", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["x", 
       RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], "-", 
      RowBox[{
       SuperscriptBox["z", 
        RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], "(", 
       SubscriptBox["s", "R"], ")"}]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"206025ab-3402-fb42-8b6c-3c323ea6bd6c"],
 " between the emission ",
 StyleBox["event",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " at the retarded 4\[NoBreak]-\[NoBreak]position ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["z", 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], "(", 
    SubscriptBox["s", "R"], ")"}], TraditionalForm]],ExpressionUUID->
  "e8b4d944-7987-bb4d-bc7d-79421db1370f"],
 " and the absorption event at 4\[NoBreak]-\[NoBreak]position ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "5172d427-d20d-c74f-b198-6b177a439a11"],
 ". ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", 
    RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "cf24be3c-635a-1148-8b85-819293835698"],
 " depends on ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "d7b6be86-8156-6048-84ea-4c9ade62c483"],
 " implicitly through ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "R"], TraditionalForm]],ExpressionUUID->
  "82129a73-0a22-3043-b7db-5f575f7ce078"],
 ". So we\[CloseCurlyQuote]ll start with the gradient ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[PartialD]", 
      SubscriptBox["s", "R"]}], "/", 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}]}], "\[Congruent]", 
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], 
     SubscriptBox["s", "R"]}]}], TraditionalForm]],ExpressionUUID->
  "4e069baa-e15f-9d4d-bb97-4739846e942c"],
 ". "
}], "Text",
 CellChangeTimes->{{3.976113721464932*^9, 3.9761137979529047`*^9}, {
   3.9761140459038363`*^9, 3.976114094056716*^9}, {3.976114221289227*^9, 
   3.9761142489188766`*^9}, {3.976114336253667*^9, 3.976114337802025*^9}, {
   3.976115737081987*^9, 3.9761157454649487`*^9}, {3.976121083109178*^9, 
   3.976121144602189*^9}, {3.976137873451281*^9, 3.976137875293004*^9}, 
   3.976141431057016*^9, 3.976145457582529*^9, {3.976192156411159*^9, 
   3.976192162247826*^9}, {3.976192192255924*^9, 3.976192210305716*^9}, 
   3.976192393497826*^9, {3.976289870921504*^9, 
   3.976289880831231*^9}},ExpressionUUID->"83e460ea-becc-4548-95b3-\
f969d50dc759"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Mu]"], 
    SubscriptBox["s", "R"]}], TraditionalForm]],ExpressionUUID->
  "426997de-2def-0240-b905-7b23cc339150"],
 " from the Null Interval"
}], "Subsection",
 CellChangeTimes->{{3.975882476499016*^9, 3.975882477865635*^9}, {
  3.975959048545594*^9, 3.975959054362012*^9}, {3.976137494313684*^9, 
  3.976137495670184*^9}, {3.9762671761122723`*^9, 
  3.976267191234619*^9}},ExpressionUUID->"db2a161d-4bef-8746-91ff-\
5420787b49ca"],

Cell[TextData[{
 "The only leverage we have on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "R"], TraditionalForm]],ExpressionUUID->
  "abcf42c3-8ac5-a043-8987-0e509ec8b800"],
 " is through the length of the separation vector, the ",
 StyleBox["proper time",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Sigma]", "\[Mu]"], 
    SubscriptBox["\[Sigma]", "\[Mu]"]}], TraditionalForm]],ExpressionUUID->
  "1412debd-d792-134e-9371-958909a01987"],
 ". It is zero, a ",
 StyleBox["null interval",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", as with all light-like paths (on the light cone) in a vacuum:"
}], "Text",
 CellChangeTimes->{
  3.9761138442858343`*^9, {3.9761139605239573`*^9, 3.97611396258573*^9}, {
   3.976141496012526*^9, 3.9761415026655827`*^9}, {3.976141540380477*^9, 
   3.976141575705762*^9}, {3.976141612305439*^9, 3.976141645943199*^9}, {
   3.97614571381749*^9, 3.976145730650153*^9}, {3.9761922296242313`*^9, 
   3.976192250140685*^9}, {3.976267199300693*^9, 
   3.976267202145063*^9}},ExpressionUUID->"cdb0577e-82fc-e449-a814-\
3a2844122834"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[Phi]", " ", 
     RowBox[{"(", 
      RowBox[{"x", ",", 
       SubscriptBox["s", "R"]}], ")"}]}], "\[Congruent]", 
    RowBox[{
     SubscriptBox["\[Sigma]", "\[Nu]"], 
     SuperscriptBox["\[Sigma]", "\[Nu]"]}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Eta]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "(", 
      RowBox[{
       SuperscriptBox["x", "\[Mu]"], "-", 
       RowBox[{
        SuperscriptBox["z", "\[Mu]"], "(", 
        SubscriptBox["s", "R"], ")"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "\[Nu]"], "-", 
       RowBox[{
        SuperscriptBox["z", "\[Nu]"], "(", 
        SubscriptBox["s", "R"], ")"}]}], ")"}]}], "=", "0"}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9755236551468763`*^9, 3.975523679673719*^9}, {
  3.975525023977065*^9, 3.9755251110016413`*^9}, {3.975698401414423*^9, 
  3.975698427109535*^9}, {3.9757083564920197`*^9, 3.975708369201294*^9}, {
  3.975784389437314*^9, 3.975784391763239*^9}, {3.97611602264434*^9, 
  3.976116054995854*^9}, {3.9761419566908493`*^9, 3.9761419899044456`*^9}},
 CellTags->
  "THE NULL INTERVAL",ExpressionUUID->"d6ffb75b-036c-2342-bb03-c75cdd1d3445"],

Cell["This is Equation 1.1 in Carlip\[CloseCurlyQuote]s paper. ", "Text",
 CellChangeTimes->{{3.975509314625042*^9, 3.975509332542779*^9}, {
   3.9755093967742367`*^9, 3.975509444097381*^9}, {3.975523761280517*^9, 
   3.9755237631706676`*^9}, {3.9755254750618277`*^9, 3.975525483570767*^9}, 
   3.975525946502899*^9, {3.9757679319632607`*^9, 3.9757679519317303`*^9}, {
   3.975768684401401*^9, 3.9757686973018427`*^9}, {3.975786392004085*^9, 
   3.9757863953004503`*^9}, {3.975882488359703*^9, 3.975882490388026*^9}, {
   3.976105282896591*^9, 3.9761052870104437`*^9}, 
   3.976114008893449*^9},ExpressionUUID->"d56c79d1-3b5c-6f49-9d58-\
0c577bf1d72b"],

Cell[CellGroupData[{

Cell[TextData[{
 "Abbreviate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "R"], TraditionalForm]],ExpressionUUID->
  "d46de2b6-1d22-1449-872f-380760431e70"],
 " to ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "8287976c-e8c9-2146-ae59-28ea08198a4c"]
}], "Subsubsection",
 CellChangeTimes->{{3.9762672522248993`*^9, 
  3.9762672649393578`*^9}},ExpressionUUID->"edc5722c-4306-4343-8433-\
fa67f00bc553"],

Cell[TextData[{
 "For now, write ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "22d6b23b-3527-de44-9171-cb56702004f5"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "R"], TraditionalForm]],ExpressionUUID->
  "f704f894-1290-da46-8b33-9b6f42b21647"],
 " to save space and to avoid confusing subscript ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],ExpressionUUID->
  "220addd7-22ca-6c40-95f7-32de47b1d8ea"],
 " (retarded) with tensorial subscripts. Just remember that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "R"], "->", "s"}], TraditionalForm]],ExpressionUUID->
  "88b95fe2-0201-934a-8a87-32ad107400b1"],
 " is a specific, dynamical variable that depends on ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "677f0f56-47b2-5447-929d-4d5a62cceaec"],
 ". It is also a specific value of ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "fa88713a-710e-284d-86f8-7e18d7e35dbb"],
 " as a generic path parameter of ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "3c0df02d-368f-c149-aedf-b0d2d0b96908"],
 ", but that fact does not concern us."
}], "Text",
 CellChangeTimes->{{3.9761411444917507`*^9, 3.976141260154666*^9}, {
   3.976145756151979*^9, 3.9761458196461554`*^9}, {3.976192273032477*^9, 
   3.976192292939176*^9}, {3.976292661964171*^9, 3.976292715894463*^9}, 
   3.976315357160595*^9},ExpressionUUID->"bf35631b-34bf-fa4c-8de1-\
194b9833f02b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "\[Eta]", ",", "\[Phi]", ",", "\[Sigma]", ",", "\[Lambda]", ",", "r", ",", 
    "e", ",", "x", ",", "z", ",", "s"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.976137894480516*^9, 3.9761379368246393`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"a57f5ef9-dbcd-4444-bece-3d5554fdfa3c"],

Cell[TextData[{
 "Here is a good-looking Wolfram version of Equation ",
 
 CounterBox["DisplayFormulaNumbered", "THE NULL INTERVAL"],
 ":"
}], "Text",
 CellChangeTimes->{{3.976141701054187*^9, 
  3.97614174692379*^9}},ExpressionUUID->"973b4448-f4a2-1e46-99ac-\
698c8a560721"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"\[Phi]", "=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Eta]", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], "-", 
        RowBox[{
         RowBox[{"z", "[", "s", "]"}], "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}], "-", 
        RowBox[{
         RowBox[{"z", "[", "s", "]"}], "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], ")"}]}], 
     ")"}]}], ")"}], "/.", "dpyRules"}]], "Input",
 CellChangeTimes->{{3.976138377879073*^9, 3.976138454027317*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"f4ee4cf4-7076-c043-9467-8ae975222aff"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[Eta]", 
   RowBox[{"\[Mu]", " ", "\[Nu]"}]], " ", 
  RowBox[{"(", 
   RowBox[{
    TemplateBox[{"x", "\[Mu]"},
     "Superscript"], "-", 
    TemplateBox[{
      RowBox[{"z", "[", "s", "]"}], "\[Mu]"},
     "Superscript"]}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    TemplateBox[{"x", "\[Nu]"},
     "Superscript"], "-", 
    TemplateBox[{
      RowBox[{"z", "[", "s", "]"}], "\[Nu]"},
     "Superscript"]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.976138399766129*^9, 3.9761384082198*^9}, {
   3.976138444892358*^9, 3.9761384635739403`*^9}, 3.976192313247375*^9, 
   3.9761926368698893`*^9, 3.976193815553052*^9, 3.9762367075868473`*^9, 
   3.976266912490827*^9, 3.976267238377392*^9, 3.976279508700884*^9, 
   3.976280948945798*^9, 3.9762817846061172`*^9, 3.976282241960114*^9, 
   3.976283019914609*^9, 3.976283658623465*^9, 3.976284929708095*^9, 
   3.9762863097395763`*^9, 3.976289691842094*^9, 3.9762946757746*^9, 
   3.976294759016007*^9, 3.976295684855483*^9, 3.9763062595814457`*^9, 
   3.9888815848284817`*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"b8c17dc4-252b-4737-97fc-a487ad25b1c5"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Mu]"], "s"}], TraditionalForm]],
  ExpressionUUID->"e553d1f4-dfa0-3c41-a6aa-a6b328f91f4a"],
 " Via the ",
 StyleBox[ButtonBox["Implicit Function Theorem",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Implicit_function_theorem"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Implicit_function_theorem"],
  FontVariations->{"Underline"->True}]
}], "Subsection",
 CellChangeTimes->{{3.975769573254442*^9, 3.975769624292678*^9}, {
  3.975778254753354*^9, 3.975778255453699*^9}, {3.975778527419919*^9, 
  3.9757785669345922`*^9}, {3.975836774945438*^9, 3.9758367912887497`*^9}, {
  3.975863522128296*^9, 3.975863523979455*^9}, {3.975960720023304*^9, 
  3.975960727419162*^9}, {3.97626727458678*^9, 
  3.97626727920286*^9}},ExpressionUUID->"9b4f380e-953e-5542-a149-\
df046c0aa937"],

Cell[TextData[{
 "The fact that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Phi]", " ", 
     RowBox[{"(", 
      RowBox[{"x", ",", "s"}], ")"}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"867bc7e6-08db-874d-9410-f4b271a56dce"],
 " means that \[Phi] qualifies for the ",
 StyleBox[ButtonBox["implicit function theorem",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Implicit_function_theorem"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Implicit_function_theorem"],
  FontVariations->{"Underline"->True}],
 ". ",
 "B",
 "y the chain rule, the gradient ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]"}], TraditionalForm]],
  ExpressionUUID->"3acaec1d-e0cf-d04e-8c55-0c8577c47c08"],
 " is"
}], "Text",
 CellChangeTimes->{
  3.9757809205951557`*^9, {3.975781198751487*^9, 3.975781248724637*^9}, {
   3.9757814367399673`*^9, 3.9757814925689993`*^9}, {3.975786819387924*^9, 
   3.975786923221282*^9}, {3.975800679963431*^9, 3.975800683917624*^9}, {
   3.975843940182527*^9, 3.975843988789279*^9}, {3.9758635518668213`*^9, 
   3.975863552065857*^9}, {3.975883897526287*^9, 3.975883905628066*^9}, {
   3.9758850000022173`*^9, 3.9758850869191713`*^9}, {3.9758851188749437`*^9, 
   3.975885170409073*^9}, {3.975960635076383*^9, 3.975960645252549*^9}, {
   3.976020922786242*^9, 3.9760209229687443`*^9}, {3.976114676587956*^9, 
   3.9761147292306347`*^9}, {3.976114761676036*^9, 3.9761148083347816`*^9}, {
   3.976115170200039*^9, 3.976115183585528*^9}, {3.976116037362273*^9, 
   3.976116085859167*^9}, {3.9761417845393353`*^9, 3.976141857051668*^9}, {
   3.976142009253388*^9, 3.976142038191709*^9}, {3.976142157890111*^9, 
   3.976142170132461*^9}, {3.976145844160715*^9, 3.976145856330038*^9}, {
   3.976192321076812*^9, 3.976192321998865*^9}, {3.976192358336368*^9, 
   3.9761923679045763`*^9}, {3.976192402431033*^9, 3.9761924060891457`*^9}, {
   3.9762927401874027`*^9, 
   3.976292753716177*^9}},ExpressionUUID->"0779333f-91a3-1143-a0cf-\
11660cbc2c51"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"d", "\[VeryThinSpace]", "\[Phi]"}], 
      RowBox[{"d", "\[VeryThinSpace]", "s"}]], 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], "s"}]}]}], "=", "0"}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9761420418701763`*^9, 
  3.976142152678258*^9}},ExpressionUUID->"4c0c123f-c6c5-2f48-b526-\
568381f7ec96"],

Cell[TextData[{
 "Thus, the gradient we seek is ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], "s"}], "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]"}]}], "/", 
      FractionBox[
       RowBox[{"d", "\[VeryThinSpace]", "\[Phi]"}], 
       RowBox[{"d", "\[VeryThinSpace]", "s"}]]}]}],
    Background->RGBColor[0.93, 0.27, 0.27, 0.33]], TraditionalForm]],
  ExpressionUUID->"eb60e90c-1dcf-b141-af95-da6f0978965d"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]"}], TraditionalForm]],
  ExpressionUUID->"02ba6bd6-6cb9-9f40-8803-25affc761962"],
 " is a 4\[NoBreak]-\[NoBreak]vector and ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", "\[Phi]"}], 
    RowBox[{"d", "\[VeryThinSpace]", "s"}]], TraditionalForm]],ExpressionUUID->
  "f3025b44-2c31-1442-aea2-8b8a8453dd9b"],
 " is a scalar. Let\[CloseCurlyQuote]s compute the factors ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]"}], TraditionalForm]],
  ExpressionUUID->"8e74c8f1-08fe-964c-86e5-c1c0d2c36b3d"],
 " and ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", "\[Phi]"}], 
    RowBox[{"d", "\[VeryThinSpace]", "s"}]], TraditionalForm]],ExpressionUUID->
  "2ef924d8-5ca8-9e44-ab14-4b1ae3e5994a"],
 " one at a time."
}], "Text",
 CellChangeTimes->{
  3.9757809205951557`*^9, {3.975781198751487*^9, 3.975781248724637*^9}, {
   3.9757814367399673`*^9, 3.9757814925689993`*^9}, {3.975786819387924*^9, 
   3.975786923221282*^9}, {3.975800679963431*^9, 3.975800683917624*^9}, {
   3.975843940182527*^9, 3.975843988789279*^9}, {3.9758635518668213`*^9, 
