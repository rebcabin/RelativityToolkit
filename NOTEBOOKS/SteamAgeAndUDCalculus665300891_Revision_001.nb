Cell[CellGroupData[{

Cell["Gradient of the Velocity \[Lambda]", "Subsubsection",
 CellChangeTimes->{{3.975970736285027*^9, 3.975970739728983*^9}, {
  3.975971428669341*^9, 
  3.9759714310546017`*^9}},ExpressionUUID->"7945a28d-e45f-7242-b002-\
d94e3d43b3d5"],

Cell["Now follows the gradient of \[Lambda]:", "Text",
 CellChangeTimes->{{3.97596421195098*^9, 
  3.975964243108493*^9}},ExpressionUUID->"bdc14d1f-fd58-7146-a3c9-\
6422b8dc01e4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Mu]"], 
    SubscriptBox["\[Lambda]", 
     RowBox[{"\[VeryThinSpace]", "\[Nu]"}]]}], "\[Congruent]", 
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     RowBox[{
      SubscriptBox["\[Lambda]", 
       RowBox[{"\[VeryThinSpace]", "\[Nu]"}]], "(", 
      SubscriptBox["s", "R"], ")"}]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", 
      RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}]]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.975964252402627*^9, 3.975964303586789*^9}, {
  3.975964448035833*^9, 3.975964456376618*^9}, {3.975964516281477*^9, 
  3.9759645341945467`*^9}, {3.976266090313299*^9, 3.976266090525231*^9}, {
  3.976266540952075*^9, 
  3.9762665689221*^9}},ExpressionUUID->"f5a5de5a-fafc-7b4a-9211-7d2ef0249fcb"],

Cell[TextData[{
 "Remembering that \[Lambda] depends only implicitly on ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "d6c528ad-f1b9-4b43-91b5-11958583fd36"],
 ":"
}], "Text",
 CellChangeTimes->{{3.975964329007744*^9, 3.975964385789209*^9}, {
  3.97596442208119*^9, 3.975964503684065*^9}, {3.9759645407894373`*^9, 
  3.975964544910187*^9}, {3.975967710704419*^9, 3.975967715552582*^9}, {
  3.976266100193014*^9, 3.976266107528673*^9}, {3.976266581083249*^9, 
  3.976266585447628*^9}},ExpressionUUID->"1949490c-f8ea-c74d-ae7b-\
3019ff05e553"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     RowBox[{
      SubscriptBox["\[Lambda]", 
       RowBox[{"\[VeryThinSpace]", "\[Nu]"}]], "(", 
      SubscriptBox["s", "R"], ")"}]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", 
      RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}]], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        RowBox[{
         SubscriptBox["\[Lambda]", 
          RowBox[{"\[VeryThinSpace]", "\[Nu]"}]], "(", 
         SubscriptBox["s", "R"], ")"}]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "\[Mu]"]}]], "=", "0"}], ")"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"d", "\[VeryThinSpace]", 
       RowBox[{
        SubscriptBox["\[Lambda]", 
         RowBox[{"\[VeryThinSpace]", "\[Nu]"}]], "(", 
        SubscriptBox["s", "R"], ")"}]}], 
      RowBox[{"d", "\[VeryThinSpace]", 
       SubscriptBox["s", "R"]}]], 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], 
      SubscriptBox["s", "R"]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.975964553616465*^9, 3.975964676698513*^9}, {
  3.975964737197967*^9, 3.975964746871057*^9}, {3.976266596898657*^9, 
  3.976266606172118*^9}},ExpressionUUID->"e8e55fc0-35a2-e546-bbe4-\
3dcc4ca5b741"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s just define the symbol ",
 StyleBox["d\[Lambda]ds", "Input"],
 " for ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     RowBox[{
      SubscriptBox["\[Lambda]", 
       RowBox[{"\[VeryThinSpace]", "\[Nu]"}]], "(", 
      SubscriptBox["s", "R"], ")"}]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SubscriptBox["s", "R"]}]], TraditionalForm]],
  CellChangeTimes->{{3.975964553616465*^9, 3.975964676698513*^9}, {
   3.975964737197967*^9, 3.975964746871057*^9}},ExpressionUUID->
  "a810e7b4-d1eb-f945-a9b0-a025d4f0ba8b"],
 " (we don\[CloseCurlyQuote]t need to decompose or evaluate it to get Carlip\
\[CloseCurlyQuote]s Equation 1.7), and we already know ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], 
     SubscriptBox["s", "R"]}], "=", 
    RowBox[{
     SubscriptBox["\[Sigma]", "\[Mu]"], "/", "r"}]}], TraditionalForm]],
  CellChangeTimes->{{3.975964553616465*^9, 3.975964676698513*^9}, {
   3.975964737197967*^9, 3.975964746871057*^9}},ExpressionUUID->
  "0c4475c0-b8a3-7242-878f-25fd46bddbbd"],
 ":"
}], "Text",
 CellChangeTimes->{{3.975964707370522*^9, 3.975964776067643*^9}, {
  3.9759677320773363`*^9, 3.975967742218504*^9}, {3.975968467734562*^9, 
  3.975968494932282*^9}, {3.975968718867711*^9, 3.975968726772156*^9}, {
  3.976266609731258*^9, 
  3.9762666387501297`*^9}},ExpressionUUID->"783170d1-1c37-0140-8c54-\
34036aaf4ad2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fourGrad", "[", 
    RowBox[{
     RowBox[{"\[Lambda]", "[", "ud\[Nu]_", "]"}], ",", "ud\[Mu]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"d\[Lambda]ds", "[", "ud\[Nu]", "]"}], 
