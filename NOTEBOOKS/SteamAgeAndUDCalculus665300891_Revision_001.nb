Cell[CellGroupData[{

Cell[TextData[{
 "Invariant Retarded Distance ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "e99525ab-a756-734b-b446-63ccdebad64d"]
}], "Subsection",
 CellChangeTimes->{{3.976268296424182*^9, 
  3.976268306940851*^9}},ExpressionUUID->"f1376ca7-e241-274e-9de3-\
1029eaf5ba1d"],

Cell[TextData[{
 "The gradient ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Mu]"], "s"}], TraditionalForm]],
  ExpressionUUID->"e3e733ef-636e-1640-bebc-3d6ef48f4bdd"],
 " is the negative ratio of these two factors: ",
 StyleBox["-d\[Phi]dx/d\[Phi]ds", "Input"],
 ". If we write the ratio, however, Wolfram will cheerfully cancel ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "dc29b85e-ad58-3f42-92cd-1e212234b6ba"],
 ". Wolfram doesn\[CloseCurlyQuote]t \[OpenCurlyDoubleQuote]know\
\[CloseCurlyDoubleQuote] that \[Mu] in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "\[Mu]"], 
    SuperscriptBox["\[Lambda]", "\[Mu]"]}], TraditionalForm]],ExpressionUUID->
  "62dd6d6b-e868-4948-9e22-8beac3045dab"],
 " is a \[OpenCurlyDoubleQuote]dummy\[CloseCurlyDoubleQuote] index and must \
not be allowed to collide with the \[Mu] in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "4530fbe2-73e3-144e-b47c-9820f72af457"],
 " in the numerator. We might replace ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "\[Mu]"], 
    SuperscriptBox["\[Lambda]", "\[Mu]"]}], TraditionalForm]],ExpressionUUID->
  "51552dea-d6b6-784c-98cd-1e2fdb818296"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "\[Rho]"], 
    SuperscriptBox["\[Lambda]", "\[Rho]"]}], TraditionalForm]],ExpressionUUID->
  "60b056be-6482-e44b-807b-2fa118690a8f"],
 " via a new tensor rule that checks for collisions."
}], "Text",
 CellChangeTimes->{{3.975885190182405*^9, 3.9758852087260523`*^9}, {
   3.976235626622655*^9, 3.976235700418603*^9}, {3.976236769159822*^9, 
   3.976236863493165*^9}, {3.976237409256851*^9, 3.976237646953445*^9}, {
   3.976237682679557*^9, 3.976237705477459*^9}, {3.976237740717827*^9, 
   3.976237754939184*^9}, {3.976237928724024*^9, 3.976237948965049*^9}, {
   3.976238144948823*^9, 3.976238149611902*^9}, {3.9762677895233593`*^9, 
   3.976267814853034*^9}, {3.976267928599051*^9, 3.976267946994113*^9}, 
   3.976268116595518*^9, {3.97628085191131*^9, 3.9762808542719107`*^9}, {
   3.976283604473988*^9, 3.976283604944726*^9}, {3.976293204888418*^9, 
   3.9762932072360773`*^9}, {3.976315432034155*^9, 
   3.976315433211364*^9}},ExpressionUUID->"44a35206-bb38-bc4e-8d1e-\
b429313559c1"],

Cell[TextData[{
 StyleBox["TODO: Avoiding name collisions in general is a deep topic in \
term-rewriting, the underlying evaluation theory of Wolfram. Implementing it \
for ",
  FontSlant->"Italic"],
 "\[ScriptCapitalU]\[ScriptCapitalD]",
 StyleBox[" indexing is a potentially interesting topic, taking us deeper \
into compiler territory.  It\[CloseCurlyQuote]s too much, now, for this \
prototype. Likewise for coalescing dummy indices, i.e., detecting that ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Sigma]", "\[Mu]"], 
     SuperscriptBox["\[Lambda]", "\[Mu]"]}], "=", 
    RowBox[{
     SubscriptBox["\[Sigma]", "\[Rho]"], 
     SuperscriptBox["\[Lambda]", "\[Rho]"]}]}], TraditionalForm]],
  ExpressionUUID->"692c1eda-cf1e-ca48-8cfc-9c83b24e30ef"],
 ". "
}], "Item",
 CellChangeTimes->{{3.976267967163578*^9, 3.976268125534005*^9}, {
  3.976283061108465*^9, 3.976283163952908*^9}, {3.976283522680067*^9, 
  3.976283541194817*^9}, {3.976293231081141*^9, 
  3.976293266909484*^9}},ExpressionUUID->"34e88f02-0513-6749-993c-\
52022781632d"],

Cell[TextData[{
 "A better idea is to follow Carlip\[CloseCurlyQuote]s Equations 1.3 and 1.4 \
and simply define ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "\[Mu]"], 
    SuperscriptBox["\[Lambda]", "\[Mu]"]}], TraditionalForm]],ExpressionUUID->
  "1d6a4886-0f94-4947-8aa9-b4c1a51c8751"],
 " as the scalar ",
 StyleBox["invariant retarded distance",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "a3ecde58-c5aa-8740-ac73-d7fd6ee45891"],
 " via some new scalar rules:"
}], "Text",
 CellChangeTimes->{{3.975885190182405*^9, 3.9758852087260523`*^9}, {
  3.976235626622655*^9, 3.976235700418603*^9}, {3.976236769159822*^9, 
  3.976236863493165*^9}, {3.976237409256851*^9, 3.976237646953445*^9}, {
  3.976237682679557*^9, 3.976237705477459*^9}, {3.976237740717827*^9, 
  3.976237754939184*^9}, {3.976237928724024*^9, 3.976237948965049*^9}, {
  3.976238144948823*^9, 3.976238149611902*^9}, {3.9762677895233593`*^9, 
  3.976267814853034*^9}, {3.976267928599051*^9, 3.976267948744606*^9}, {
  3.97626811213932*^9, 3.976268140419382*^9}, {3.9762682480614147`*^9, 
  3.9762682482790947`*^9}},ExpressionUUID->"6d284fe9-ec5d-214b-b2a4-\
0053d8b25816"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Scalar Rules", "Subsection",
 CellChangeTimes->{{3.9762682392394753`*^9, 
  3.976268241553586*^9}},ExpressionUUID->"2044ff97-3bce-514a-99cf-\
83cff735f1fd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "scalarRules", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"scalarRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[Sigma]", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"h1", ":", 
           RowBox[{"\[ScriptCapitalU]", "|", "\[ScriptCapitalD]"}]}], ")"}], "[",
          "ud_", "]"}], "]"}], 
       RowBox[{"\[Lambda]", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"h2", ":", 
           RowBox[{"\[ScriptCapitalU]", "|", "\[ScriptCapitalD]"}]}], ")"}], "[",
          "ud_", "]"}], "]"}]}], "/;", 
      RowBox[{"h1", "=!=", "h2"}]}], ":>", "r"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.976237791446136*^9, 3.976237859097253*^9}, {
   3.976237901887102*^9, 3.976237909988467*^9}, {3.976268148564129*^9, 
   3.976268181339327*^9}, {3.9762797685388536`*^9, 3.976280115197364*^9}, {
   3.976280692374723*^9, 3.976280704440097*^9}, {3.976280750946735*^9, 
   3.976280753448642*^9}, 3.9762821863628893`*^9},
 CellLabel->"In[17]:=",ExpressionUUID->"3845df7b-de8d-074d-b9bf-be9394b8d32d"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["This rule illustrates a complex pattern that matches product \
expressions containing tensors with opposite parities, subject to the \
summation convention. It will match either ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Sigma]", 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], 
    SubscriptBox["\[Lambda]", "\[Mu]"]}], TraditionalForm]],ExpressionUUID->
  "d644f13e-0f2e-3d42-b468-771d8edc3f18"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "\[Mu]"], 
    SuperscriptBox["\[Lambda]", "\[Mu]"]}], TraditionalForm]],ExpressionUUID->
  "754c6119-ddeb-b446-8e3e-6a6a016f4377"],
 ". ",
 StyleBox["It\[CloseCurlyQuote]s debatable whether that pattern is more \
readable than a pair of explicit patterns,",
  FontSlant->"Italic"],
 " ",
 StyleBox["\[Sigma][\[ScriptCapitalU][\[Mu]_]]\[Lambda][\[ScriptCapitalD][\
\[Mu]_]]:>r, \[Sigma][\[ScriptCapitalD][\[Mu]]]\[Lambda][\[ScriptCapitalU][\
\[Mu]]:>r", "Input"],
 StyleBox[", as in ",
  FontSlant->"Italic"],
 StyleBox["tensorRules", "Input"],
 ". ",
 StyleBox["I have illustrated both styles. Which you choose is a matter of \
taste.",
  FontSlant->"Italic"]
}], "Item",
