Cell[TextData[{
 "This is pretty clearly ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "2"}], 
    SubscriptBox["\[Sigma]", "\[Mu]"], 
    SuperscriptBox["\[Lambda]", "\[Mu]"]}], TraditionalForm]],ExpressionUUID->
  "fa27010c-b6c2-2540-9336-edb0f1c1fdca"],
 " because ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[Congruent]", 
    RowBox[{
     RowBox[{"z", "'"}], 
     RowBox[{"(", "s", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "6f6faf23-406e-504f-983b-00c9e7692792"],
 ", but the display is not good enough. Now is the time to introduce ",
 StyleBox["tensor rules",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", a combination of transformations of our special tensors and \
transformations for all tensors:"
}], "Text",
 CellChangeTimes->{{3.976146672437582*^9, 3.97614672685585*^9}, 
   3.97614698988967*^9, {3.976147495716835*^9, 3.9761475035792522`*^9}, {
   3.9761928909122334`*^9, 3.9761929493752937`*^9}, {3.976193946917591*^9, 
   3.976193976911069*^9}, {3.976194058138443*^9, 3.976194073877166*^9}, {
   3.9762346374834433`*^9, 3.9762346374834948`*^9}, {3.976237352355687*^9, 
