   RowBox[{"d\[Phi]dx", "=", 
    RowBox[{"2", 
     RowBox[{"\[Sigma]", "[", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], "]"}]}]}], ")"}], "/.",
   "dpyRules"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"2e156503-7d37-7c4b-8da9-b0392a59f377"],

