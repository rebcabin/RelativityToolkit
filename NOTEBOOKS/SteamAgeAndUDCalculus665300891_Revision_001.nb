Cell[TextData[{
 "The standard derivative operator ",
 StyleBox["Dt", "Input"],
 " is agnostic to valence and cannot apply metrical contractions. Applying ",
 StyleBox["Dt", "Input"],
 " blindly produces chained derivatives of indices and the \[ScriptCapitalU]\
\[ScriptCapitalD] symbols, which don\[CloseCurlyQuote]t make sense. \
Therefore, we just explicitly define d\[Phi]ds"
}], "Text",
 CellChangeTimes->{{3.97629518631599*^9, 3.976295245006637*^9}, {
  3.976295276190984*^9, 3.976295303515438*^9}, {3.976295600533844*^9, 
  3.976295658991227*^9}, {3.976315382868689*^9, 
  3.976315405058545*^9}},ExpressionUUID->"3b846f17-a148-a04b-9162-\
ef8658b52232"],

