Cell[TextData[{
 StyleBox["This is just a beginning. By extending the tensor rules to more \
elaborate examples we could eventually have an embedded compiler for the \
\[ScriptCapitalU]",
  FontSlant->"Italic"],
 "\[ScriptCapitalD] ",
 StyleBox["calculus.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.975965535293372*^9, 3.975965600069407*^9}, {
