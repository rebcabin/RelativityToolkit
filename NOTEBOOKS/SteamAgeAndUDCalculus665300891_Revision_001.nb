b19b5bb02ec3"],

Cell[TextData[StyleBox["The unit-velocity rule follows from the fact that if \
we parametrize a curve by its arc length, its tangent vector is always of \
norm 1. This is true in Minkowski space, too, because",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.975965535293372*^9, 3.975965600069407*^9}, {
   3.975965973983449*^9, 3.975965982064177*^9}, {3.976147044788847*^9, 
   3.9761470753509808`*^9}, {3.976236345429844*^9, 3.976236346631751*^9}, 
   3.976293093470667*^9},ExpressionUUID->"869d58e4-9543-ca4c-a938-\
11c62d46c13b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"d", "\[VeryThinSpace]", 
    SuperscriptBox["s", "2"]}], "=", 
   RowBox[{
    SubscriptBox["\[Eta]", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Vee]"}]}]], "d", "\[VeryThinSpace]", 
    SuperscriptBox["z", 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], "d", "\[VeryThinSpace]", 
    SuperscriptBox["z", 
     RowBox[{"\[VeryThinSpace]", "\[Nu]"}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9759656038551073`*^9, 3.975965677821155*^9}, {
  3.9759658734247704`*^9, 
  3.975965873426387*^9}},ExpressionUUID->"4881cd58-6342-e743-89e0-\
9bcb715c17ff"],

Cell[BoxData[
 FormBox[
  RowBox[{"1", "=", 
   RowBox[{
    SubscriptBox["\[Eta]", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Vee]"}]}]], 
    FractionBox[
     RowBox[{"d", "\[VeryThinSpace]", 
      SuperscriptBox["z", 
       RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}], 
     RowBox[{"d", "\[VeryThinSpace]", "s"}]], 
    FractionBox[
     RowBox[{"d", "\[VeryThinSpace]", 
      SuperscriptBox["z", 
       RowBox[{"\[VeryThinSpace]", "\[Nu]"}]]}], 
     RowBox[{"d", "\[VeryThinSpace]", "s"}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.975965687766432*^9, 3.975965773817504*^9}, {
  3.975965879601993*^9, 
  3.975965904214913*^9}},ExpressionUUID->"dfab85cb-aa53-054d-b8fe-\
642512563605"],

Cell[BoxData[
 FormBox[
  RowBox[{"1", "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Eta]", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], 
     SuperscriptBox["\[Lambda]", "\[Mu]"], 
     SuperscriptBox["\[Lambda]", "\[Nu]"]}], "=", 
    RowBox[{
     SubscriptBox["\[Lambda]", "\[Nu]"], 
     SuperscriptBox["\[Lambda]", "\[Nu]"]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
