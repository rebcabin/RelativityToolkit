    URL["https://mathworld.wolfram.com/FundamentalLemmaofCalculusofVariations.\
html"], None},
  ButtonNote->
   "https://mathworld.wolfram.com/FundamentalLemmaofCalculusofVariations.\
html"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.974842320104672*^9, 3.974842435895337*^9}, {
   3.9748424868817863`*^9, 3.974842499212853*^9}, {3.9748425439585857`*^9, 
