4yB636G/ileBdAbjTxUQ3RNyhfUhkH7HPEEARN+w7RcD0ULRV8H0u9xrsiCa
W/KjIojW4rqy8TeQVngitQlES60MXaqw4K2jn0MbmAYAIBqkoQ==
  "],ExpressionUUID->"40cdb00f-4a24-6441-b148-a42ae9345e21"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Introduction: Aberration", "Section",
 CellChangeTimes->{{3.976137184869422*^9, 3.9761371928012753`*^9}, {
  3.976191388981741*^9, 
  3.9761913912072973`*^9}},ExpressionUUID->"a53e16b1-7208-3943-bc5a-\
f980066ec61b"],

Cell[TextData[{
 "Carlip\[CloseCurlyQuote]s paper resolves a conundrum in gravitation. No \
causal signal can travel faster than ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "60b6b37d-5f02-5b4e-b93b-3c027b8d512a"],
 ", the speed of light in the vacuum, measured in any reference frame. But, \
if you consider, say, the Earth-Sun system, and then you point the force \
vector from the Earth to the ",
 StyleBox["retarded position",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of the Sun, where it was \[OpenCurlyDoubleQuote]eight minutes ago,\
\[CloseCurlyDoubleQuote] when any gravitational signals were emitted, your \
calculation of Earth\[CloseCurlyQuote]s orbit will be wrong by a wide margin. \
This \[OpenCurlyDoubleQuote]miss\[CloseCurlyDoubleQuote] happens both in \
Newtonian and general-relativistic gravitation. You must point the force \
vector roughly at the \[OpenCurlyDoubleQuote]instantaneous,\
\[CloseCurlyDoubleQuote] current position of the Sun, as measured in some \
space-time coordinate system at rest with the Sun. This doesn\
\[CloseCurlyQuote]t sound right! What is going on?"
}], "Text",
 CellChangeTimes->{{3.975431069380898*^9, 3.975431082378233*^9}, {
   3.9754311812153788`*^9, 3.975431220279497*^9}, {3.975431284489908*^9, 
   3.975431659444098*^9}, {3.975431723659075*^9, 3.975431724383791*^9}, {
   3.9755056595726843`*^9, 3.9755056615433826`*^9}, {3.975505693994357*^9, 
   3.975505749899907*^9}, {3.975506183116827*^9, 3.975506223617943*^9}, {
   3.975506255231874*^9, 3.975506262880618*^9}, {3.975522875168449*^9, 
   3.9755229928317423`*^9}, {3.975525185592535*^9, 3.9755251956931543`*^9}, {
   3.975525338609469*^9, 3.97552535193048*^9}, {3.975525387593068*^9, 
   3.975525388888976*^9}, {3.975698115650449*^9, 3.975698139708449*^9}, {
   3.975765745936911*^9, 3.975765746535809*^9}, {3.975765848112914*^9, 
   3.975765905656107*^9}, {3.975765940075666*^9, 3.975765960709784*^9}, {
   3.9757796317525597`*^9, 3.975779729797056*^9}, {3.975783468112935*^9, 
   3.97578356413741*^9}, {3.975786171236968*^9, 3.975786175929826*^9}, {
   3.9757862242702847`*^9, 3.975786246862709*^9}, {3.975842898346703*^9, 
   3.975842905863552*^9}, {3.975864619202055*^9, 3.9758646194279747`*^9}, 
   3.975882200827174*^9, {3.975940702913505*^9, 3.975940714888302*^9}, {
   3.9759407590025463`*^9, 3.975940762841379*^9}, {3.976019881771782*^9, 
   3.976019905282023*^9}, {3.976104832784774*^9, 3.976104851497799*^9}, {
   3.976104909660699*^9, 3.9761049495399933`*^9}, {3.976111077981853*^9, 
   3.9761110883837852`*^9}, {3.9761116926092863`*^9, 
   3.9761117670573797`*^9}, {3.9761366559640827`*^9, 3.97613668146133*^9}, {
   3.976136923314869*^9, 3.976136930140107*^9}, {3.976137219543397*^9, 
   3.976137224855755*^9}, {3.976191408671352*^9, 
   3.9761914466357937`*^9}},ExpressionUUID->"a17175fb-13ec-ce49-81b9-\
a48d4a890c92"],

Cell[TextData[StyleBox["Actually, you must point the force vector roughly at \
the instantaneous center of gravity of the Earth-Sun system, which is almost \
at the center of the Sun. Such is likely a negligible quibble compared to \
aberration, magnetohydrodynamical fluctuations moving mass around, etc.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.975842920401845*^9, 3.9758429962131157`*^9}, {
  3.975864581462569*^9, 3.975864581703348*^9}, {3.975882218996207*^9, 
  3.975882247820291*^9}, {3.975940774997334*^9, 3.9759408000801277`*^9}, {
  3.976019918125359*^9, 3.976019943850604*^9}, {3.97611177721701*^9, 
  3.976111823583715*^9}, {3.976112443389406*^9, 3.976112451998786*^9}, {
  3.976144712308721*^9, 3.97614471577975*^9}, {3.9761914815935783`*^9, 
  3.976191501972741*^9}, {3.976315236087357*^9, 
  3.976315236270697*^9}},ExpressionUUID->"1cbb1d3f-b8f2-3542-98dd-\
47fa25d0a184"],

Cell[TextData[{
 StyleBox["In the gravitational context, this effect is an instance of ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["astronomical aberration",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Aberration_(astronomy)"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Aberration_(astronomy)"],
  FontVariations->{"Underline"->True}],
 StyleBox[". ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.975431069380898*^9, 3.975431082378233*^9}, {
   3.9754311812153788`*^9, 3.975431220279497*^9}, {3.975431284489908*^9, 
   3.975431659444098*^9}, {3.975431723659075*^9, 3.975431724383791*^9}, {
   3.9755056595726843`*^9, 3.9755056615433826`*^9}, {3.975505693994357*^9, 
   3.975505749899907*^9}, {3.975506183116827*^9, 3.975506223617943*^9}, {
   3.975506255231874*^9, 3.975506262880618*^9}, {3.975522875168449*^9, 
   3.9755229928317423`*^9}, {3.975525185592535*^9, 3.9755251956931543`*^9}, {
   3.975525338609469*^9, 3.97552535193048*^9}, {3.975525387593068*^9, 
   3.975525388888976*^9}, {3.975698115650449*^9, 3.975698139708449*^9}, {
   3.975765745936911*^9, 3.975765746535809*^9}, {3.975765848112914*^9, 
   3.975765905656107*^9}, {3.975765940075666*^9, 3.975765960709784*^9}, {
   3.9757796317525597`*^9, 3.975779729797056*^9}, {3.975783468112935*^9, 
   3.97578356413741*^9}, {3.975786171236968*^9, 3.975786175929826*^9}, {
   3.9757862242702847`*^9, 3.975786246862709*^9}, {3.975842898346703*^9, 
   3.975842905863552*^9}, {3.975864619202055*^9, 3.9758646194279747`*^9}, 
   3.975882200827174*^9, {3.975940702913505*^9, 3.975940714888302*^9}, {
   3.9759407590025463`*^9, 3.975940762841379*^9}, {3.976019881771782*^9, 
   3.976019905282023*^9}, {3.976104832784774*^9, 3.976104851497799*^9}, {
   3.976104909660699*^9, 
   3.976104961611268*^9}},ExpressionUUID->"8528bb6b-daae-8141-a995-\
7aebaca9beb0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Electrodynamical Aberration", "Section",
 CellChangeTimes->{{3.975525149447299*^9, 3.97552515851518*^9}, {
  3.975765820283935*^9, 3.975765824014308*^9}, {3.975765975158669*^9, 
  3.975765975236395*^9}, {3.976104823887608*^9, 
  3.97610482535867*^9}},ExpressionUUID->"2775d532-43a0-a343-b304-\
b60801f593e3"],

Cell["\<\
It turns out that the same thing happens in electrodynamics, which has a \
central-force law similar to gravitation\[CloseCurlyQuote]s. The electric \
field does not point to the retarded position of the source! \
\>", "Text",
 CellChangeTimes->{{3.975431702486289*^9, 3.975431705835146*^9}, {
   3.975505763220232*^9, 3.975505912196392*^9}, {3.975505947316283*^9, 
   3.9755061414600554`*^9}, {3.9755063085878887`*^9, 
   3.9755064531871023`*^9}, {3.975506538277*^9, 3.9755065388234463`*^9}, {
   3.9755065922722893`*^9, 3.975506670013321*^9}, 3.975506797689434*^9, {
   3.975507893923176*^9, 3.9755079073417187`*^9}, {3.9755228208628798`*^9, 
   3.975522857090137*^9}, {3.9755232934081182`*^9, 3.9755233759483843`*^9}, {
   3.9755254017502527`*^9, 3.975525421226349*^9}, {3.975698216560763*^9, 
   3.975698244783433*^9}, {3.9756982999461937`*^9, 3.975698325746478*^9}, 
   3.9757658108253307`*^9, {3.9757659927703247`*^9, 3.9757660072774343`*^9}, 
   3.9757660537794933`*^9, {3.97588225906609*^9, 3.9758822844780607`*^9}, {
   3.975882456782557*^9, 3.975882462235374*^9}, {3.976019960148019*^9, 
   3.976019969956998*^9}, {3.976105017283517*^9, 3.976105032966984*^9}, {
   3.9761129724464273`*^9, 3.976112997178891*^9}, {3.976137293586138*^9, 
   3.976137307302717*^9}, 
   3.976144730266452*^9},ExpressionUUID->"a5a3d10d-f361-ef40-a459-\
40e9b3fd9f07"],

Cell["\<\
Electrodynamics is easier to analyze because we don\[CloseCurlyQuote]t need \
Riemann curvature tensors and Christoffel symbols. Flat Minkowski space-time \
suffices for initial demonstration of \[ScriptCapitalU]\[ScriptCapitalD] \
indexing.\
\>", "Text",
 CellChangeTimes->{{3.975431702486289*^9, 3.975431705835146*^9}, {
   3.975505763220232*^9, 3.975505912196392*^9}, {3.975505947316283*^9, 
   3.9755061414600554`*^9}, {3.9755063085878887`*^9, 
   3.9755064531871023`*^9}, {3.975506538277*^9, 3.9755065388234463`*^9}, {
   3.9755065922722893`*^9, 3.975506670013321*^9}, 3.975506797689434*^9, {
   3.975507893923176*^9, 3.9755079073417187`*^9}, {3.9755228208628798`*^9, 
   3.975522857090137*^9}, {3.9755232934081182`*^9, 3.9755233759483843`*^9}, {
   3.9755254017502527`*^9, 3.975525421226349*^9}, {3.975698216560763*^9, 
   3.975698244783433*^9}, {3.9756982999461937`*^9, 3.975698325746478*^9}, 
   3.9757658108253307`*^9, {3.9757659927703247`*^9, 3.9757660072774343`*^9}, 
   3.9757660537794933`*^9, {3.97588225906609*^9, 3.9758822844780607`*^9}, {
   3.975882456782557*^9, 3.975882462235374*^9}, {3.976019960148019*^9, 
   3.976019969956998*^9}, {3.976105017283517*^9, 3.976105032966984*^9}, {
   3.9761129724464273`*^9, 3.976112997178891*^9}, {3.976137293586138*^9, 
   3.976137307302717*^9}, {3.976144736901493*^9, 
   3.976144753125235*^9}},ExpressionUUID->"bc197335-6ece-b047-9527-\
0fcf9e35a3e5"],

Cell[CellGroupData[{

Cell["Problem Statement", "Subsection",
 CellChangeTimes->{{3.9758822983664417`*^9, 
  3.975882301590352*^9}},ExpressionUUID->"df1e49e3-2650-254e-a9d1-\
9eadaf23cdfe"],

Cell[TextData[{
 "Consider a charged source particle, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "(", "s", ")"}], TraditionalForm]],ExpressionUUID->
  "e1e7f00e-ff22-cf4a-be33-7bf409b55365"],
 ", moving along some timelike curve parameterized by ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "19795c45-c806-b44a-828e-8dc1ac315161"],
 ". Now consider a stationary test particle, ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "df344512-2a1c-5244-b70e-7c8f923201ce"],
 ", at some spacelike distance from ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "61d68c48-7dd2-fb40-b166-48e4439bbfa6"],
 " and ask \[OpenCurlyDoubleQuote]what is the 3D direction of the electric \
field at ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "d7952752-dfc1-9f44-9f6e-62686580fae2"],
 "?\[CloseCurlyDoubleQuote] "
}], "Text",
 CellChangeTimes->{{3.975431702486289*^9, 3.975431705835146*^9}, {
   3.975505763220232*^9, 3.975505912196392*^9}, {3.975505947316283*^9, 
   3.9755061414600554`*^9}, {3.9755063085878887`*^9, 
   3.9755064531871023`*^9}, {3.975506538277*^9, 3.9755065388234463`*^9}, {
   3.9755065922722893`*^9, 3.975506670013321*^9}, 3.975506797689434*^9, {
   3.975507893923176*^9, 3.9755079073417187`*^9}, {3.9755228208628798`*^9, 
   3.975522857090137*^9}, {3.9755232934081182`*^9, 3.97552363845313*^9}, {
   3.975525444150489*^9, 3.975525448033066*^9}, 3.97576608060046*^9, {
   3.975779766297194*^9, 3.975779826615996*^9}, {3.975786273707961*^9, 
   3.9757863314541187`*^9}, {3.975798421366775*^9, 3.975798447356764*^9}, {
   3.975798575660987*^9, 3.975798586588585*^9}, {3.975799833427266*^9, 
   3.975799834938875*^9}, {3.975799905588935*^9, 3.975799952525381*^9}, {
   3.975800022697403*^9, 3.9758000672061*^9}, {3.975800098472465*^9, 
   3.975800104625462*^9}, {3.975836821355975*^9, 3.975836894842553*^9}, {
   3.975843030847808*^9, 3.9758430577196283`*^9}, {3.975843088155724*^9, 
   3.97584314600014*^9}, {3.9758823178419237`*^9, 3.975882356716618*^9}, {
   3.9759408448397512`*^9, 3.975940930470541*^9}, 3.975941008104616*^9, {
   3.97595907899689*^9, 3.975959090138352*^9}, {3.976019987960628*^9, 
   3.976020006752743*^9}},ExpressionUUID->"06cbf848-2c9d-bd43-97ec-\
70310ef842c9"],

Cell[TextData[{
 StyleBox["We\[CloseCurlyQuote]ll find that it points (roughly) toward the \
instantaneous position of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "391cde8d-ece2-d047-8bc2-b6259b7fabb5"],
 StyleBox[", that is, where ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[Cell[TextData[Cell[BoxData[
    FormBox["z", TraditionalForm]],ExpressionUUID->
    "cccc3922-b5c4-2641-9ce9-b635c0d7c533"]],
    FontSlant->"Plain",ExpressionUUID->
    "3c19f290-dced-8c4a-965d-59a0a125bf2f"], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"3429cfe9-362f-6048-943b-37eeb4775c2e"],
 StyleBox[" is \[OpenCurlyDoubleQuote]now\[CloseCurlyDoubleQuote] in the lab \
frame, rather than toward its ",
  FontSlant->"Italic"],
 StyleBox["retarded position",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "(", 
    SubscriptBox["s", "R"], ")"}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"e77792ae-2e6f-0d43-b4db-b62467adc3cc"],
 StyleBox[", where ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["z", TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"f38ecdf8-ceb3-9041-9837-0726eab31a61"],
 StyleBox[" was some time ago. \[OpenCurlyDoubleQuote]Roughly\
\[CloseCurlyDoubleQuote] means \[OpenCurlyDoubleQuote]to first order in the \
velocity of the source,\[CloseCurlyDoubleQuote] or, \
\[OpenCurlyDoubleQuote]assuming the source doesn\[CloseCurlyQuote]t \
accelerate.\[CloseCurlyDoubleQuote] ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.975431702486289*^9, 3.975431705835146*^9}, {
   3.975505763220232*^9, 3.975505912196392*^9}, {3.975505947316283*^9, 
   3.9755061414600554`*^9}, {3.9755063085878887`*^9, 
   3.9755064531871023`*^9}, {3.975506538277*^9, 3.9755065388234463`*^9}, {
   3.9755065922722893`*^9, 3.975506670013321*^9}, 3.975506797689434*^9, {
   3.975507893923176*^9, 3.9755079073417187`*^9}, {3.9755228208628798`*^9, 
   3.975522857090137*^9}, {3.9755232934081182`*^9, 3.97552363845313*^9}, {
   3.975525444150489*^9, 3.975525448033066*^9}, 3.97576608060046*^9, {
   3.975779766297194*^9, 3.975779826615996*^9}, {3.975786273707961*^9, 
   3.9757863314541187`*^9}, {3.975798421366775*^9, 3.975798447356764*^9}, {
   3.975798575660987*^9, 3.975798586588585*^9}, {3.975799833427266*^9, 
   3.975799834938875*^9}, {3.975799905588935*^9, 3.975799952525381*^9}, {
   3.975800022697403*^9, 3.9758000672061*^9}, {3.975800098472465*^9, 
   3.975800104625462*^9}, {3.975836821355975*^9, 3.975836894842553*^9}, {
   3.975843030847808*^9, 3.9758430577196283`*^9}, {3.975843088155724*^9, 
   3.97584314600014*^9}, {3.9758823178419237`*^9, 3.975882356716618*^9}, {
   3.9759408448397512`*^9, 3.975940930470541*^9}, 3.975941008104616*^9, {
   3.97595907899689*^9, 3.9759590870908957`*^9}, {3.97610508310485*^9, 
   3.976105250689478*^9}, {3.976110566634776*^9, 3.976110580479348*^9}, 
   3.976112546960676*^9},ExpressionUUID->"809540c2-6b1b-df4b-9f0f-\
c9e984a5b740"],

Cell[TextData[StyleBox["The apparent location of the source amounts to a \
linear extrapolation from the retarded position of the source\[LongDash]where \
it was\[LongDash]forward by the source\[CloseCurlyQuote]s retarded velocity\
\[LongDash]the speed and direction when and where it was. ",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.975431702486289*^9, 3.975431705835146*^9}, {
   3.975505763220232*^9, 3.975505912196392*^9}, {3.975505947316283*^9, 
   3.9755061414600554`*^9}, {3.9755063085878887`*^9, 
   3.9755064531871023`*^9}, {3.975506538277*^9, 3.9755065388234463`*^9}, {
   3.9755065922722893`*^9, 3.975506670013321*^9}, 3.975506797689434*^9, {
   3.975507893923176*^9, 3.9755079073417187`*^9}, {3.9755228208628798`*^9, 
   3.975522857090137*^9}, {3.9755232934081182`*^9, 3.97552363845313*^9}, {
   3.975525444150489*^9, 3.975525448033066*^9}, 3.97576608060046*^9, {
   3.975779766297194*^9, 3.975779826615996*^9}, {3.975786273707961*^9, 
   3.9757863314541187`*^9}, {3.975798421366775*^9, 3.975798447356764*^9}, {
   3.975798575660987*^9, 3.975798586588585*^9}, {3.975799833427266*^9, 
   3.975799834938875*^9}, {3.975799905588935*^9, 3.975799952525381*^9}, {
   3.975800022697403*^9, 3.9758000672061*^9}, {3.975800098472465*^9, 
   3.975800104625462*^9}, {3.975836821355975*^9, 3.975836894842553*^9}, {
   3.975843030847808*^9, 3.9758430577196283`*^9}, {3.975843088155724*^9, 
   3.97584314600014*^9}, {3.9758823178419237`*^9, 3.975882356716618*^9}, {
   3.9759408448397512`*^9, 3.975940930470541*^9}, 3.975941008104616*^9, {
   3.97595907899689*^9, 3.9759590870908957`*^9}, {3.97610508310485*^9, 
   3.976105250689478*^9}, {3.976110566634776*^9, 3.976110740697068*^9}, {
   3.976112565814108*^9, 3.9761126552806273`*^9}, {3.976113044539792*^9, 
   3.976113124184249*^9}, {3.976137447060401*^9, 3.976137454252715*^9}, {
   3.976137808680524*^9, 3.976137814777026*^9}, {3.976144790012003*^9, 
   3.976144840805338*^9}, {3.976191673264497*^9, 
   3.976191674275024*^9}},ExpressionUUID->"3e375197-3c58-1549-94fa-\
5dcb4f0a2f96"],

Cell[TextData[{
 "This \[OpenCurlyDoubleQuote]conspiracy\[CloseCurlyDoubleQuote] might lure \
one into thinking that the signal propagates faster than is possible, faster \
than ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "2da7ec79-c8e2-954f-999d-15035d0d6515"],
 ". However, all the expressions depend only on information at the retarded \
time, so relativity is still safe and true! Carlip explains more deeply in \
his Section 3. We\[CloseCurlyQuote]re just checking his math via the Wolfram \
language and our ",
 StyleBox["\[ScriptCapitalU]\[ScriptCapitalD]",
  FontSlant->"Plain"],
 " calculus.."
}], "Item",
 CellChangeTimes->{{3.975431702486289*^9, 3.975431705835146*^9}, {
   3.975505763220232*^9, 3.975505912196392*^9}, {3.975505947316283*^9, 
   3.9755061414600554`*^9}, {3.9755063085878887`*^9, 
   3.9755064531871023`*^9}, {3.975506538277*^9, 3.9755065388234463`*^9}, {
   3.9755065922722893`*^9, 3.975506670013321*^9}, 3.975506797689434*^9, {
   3.975507893923176*^9, 3.9755079073417187`*^9}, {3.9755228208628798`*^9, 
   3.975522857090137*^9}, {3.9755232934081182`*^9, 3.97552363845313*^9}, {
   3.975525444150489*^9, 3.975525448033066*^9}, 3.97576608060046*^9, {
   3.975779766297194*^9, 3.975779826615996*^9}, {3.975786273707961*^9, 
   3.9757863314541187`*^9}, {3.975798421366775*^9, 3.975798447356764*^9}, {
   3.975798575660987*^9, 3.975798586588585*^9}, {3.975799833427266*^9, 
   3.975799834938875*^9}, {3.975799905588935*^9, 3.975799952525381*^9}, {
   3.975800022697403*^9, 3.9758000672061*^9}, {3.975800098472465*^9, 
   3.975800104625462*^9}, {3.975836821355975*^9, 3.975836894842553*^9}, {
   3.975843030847808*^9, 3.9758430577196283`*^9}, {3.975843088155724*^9, 
   3.97584314600014*^9}, {3.9758823178419237`*^9, 3.975882356716618*^9}, {
   3.9759408448397512`*^9, 3.975940930470541*^9}, 3.975941008104616*^9, {
   3.97595907899689*^9, 3.9759590870908957`*^9}, {3.97610508310485*^9, 
   3.976105250689478*^9}, {3.976110566634776*^9, 3.976110740697068*^9}, {
   3.976112565814108*^9, 3.9761126552806273`*^9}, {3.976113044539792*^9, 
   3.976113124184249*^9}, {3.976137447060401*^9, 3.976137454252715*^9}, {
   3.976137808680524*^9, 3.976137814777026*^9}, {3.976144790012003*^9, 
   3.976144907447522*^9}, {3.976191683609991*^9, 3.976191710779252*^9}, {
   3.976315283661537*^9, 3.976315321739304*^9}},
 FontSlant->"Italic",ExpressionUUID->"5db32b42-2d82-774b-b962-58d2d86c5f2a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Valence and \[ScriptCapitalU]\[ScriptCapitalD] Indexing", "Subsection",
 CellChangeTimes->{{3.976138009037716*^9, 3.976138034432152*^9}, {
  3.976144384400362*^9, 3.9761444142081137`*^9}, {3.9761917246843987`*^9, 
  3.97619172650102*^9}},ExpressionUUID->"cb044b9a-0d73-8b46-bad1-\
e96fe0cafcc5"],

Cell[TextData[{
 "Let the ",
 StyleBox["valence",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of a tensorial expression track the up-ness and down-ness of its indices. ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Lambda]", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "156125a3-f55f-0544-baa2-35d41512240b"],
 " has valence \[ScriptCapitalU], ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "f1544c00-5202-4e43-802d-5ca65bdddbd1"],
 " has valence \[ScriptCapitalD], ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Eta]", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"e7a340f9-a78b-624f-9a5b-5bd1535b8f05"],
 " has valence ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalD]", "2"], TraditionalForm]],ExpressionUUID->
  "14ebe05f-de00-1149-885d-0eb113d39f29"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[Eta]", "\[Nu]"], "\[Mu]"], TraditionalForm]],
  ExpressionUUID->"fe46618f-2f9f-6c4b-b50f-c31fd7d6880c"],
 " has valence \[ScriptCapitalU]\[ScriptCapitalD], and so on. "
}], "Text",
 CellChangeTimes->{{3.9760408400076437`*^9, 3.976041120006769*^9}, {
   3.976041228036335*^9, 3.976041429228366*^9}, {3.976041461171197*^9, 
   3.976041485092805*^9}, {3.976041553904973*^9, 3.976041628223591*^9}, {
   3.976042355791356*^9, 3.976042369148746*^9}, 3.976042945029542*^9, {
   3.9761380490134087`*^9, 3.976138127449543*^9}, {3.976144934833281*^9, 
   3.97614504585001*^9}, 
   3.97619174516155*^9},ExpressionUUID->"19cbc5f0-a97c-ff4f-82f3-\
afc4a5e7c8ca"],

Cell[TextData[{
 "To specify indices precisely in input, write",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Lambda]", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "36c1bbca-6307-8e44-a055-a53692efb357"],
 " as ",
 StyleBox["\[Lambda][\[ScriptCapitalU][\[Mu]]]", "Input"],
 ",  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "49674a46-ad38-6a4c-8fcc-ca92ba2bac3e"],
 " as ",
 StyleBox["\[Sigma][\[ScriptCapitalD][\[Mu]]]", "Input"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Eta]", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"c50ef13b-ab44-2d4d-86e2-67402e527501"],
 " as ",
 StyleBox["\[Eta][\[ScriptCapitalD][\[Mu]],\[ScriptCapitalD][\[Nu]]]", 
  "Input"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[Eta]", "\[Nu]"], "\[Mu]"], TraditionalForm]],
  ExpressionUUID->"3f4e3e33-24f6-9248-ace3-bcb11c408823"],
 " as ",
 StyleBox["\[Eta][\[ScriptCapitalU][\[Nu]],\[ScriptCapitalD][\[Mu]]]", 
  "Input"],
 ", and so on. Display rules (below) serve to show such expressions in a \
human-readable form in output boxes."
}], "Text",
 CellChangeTimes->{{3.9760408400076437`*^9, 3.976041120006769*^9}, {
   3.976041228036335*^9, 3.976041429228366*^9}, {3.976041461171197*^9, 
   3.976041485092805*^9}, {3.976041553904973*^9, 3.976041628223591*^9}, {
   3.976042355791356*^9, 3.976042369148746*^9}, 3.976042945029542*^9, {
   3.9761380490134087`*^9, 3.976138127449543*^9}, {3.976144934833281*^9, 
   3.97614504585001*^9}, {3.976191756100337*^9, 3.9761917699777527`*^9}, {
   3.9888814723484993`*^9, 
   3.9888814867631903`*^9}},ExpressionUUID->"60b7ec6e-bafc-3042-821e-\
6bb95902689e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Summation Convention", "Subsection",
 CellChangeTimes->{{3.976145278846273*^9, 
  3.976145283320044*^9}},ExpressionUUID->"bfe1df8e-6d6c-864c-b02e-\
5829bb41378b"],

Cell[TextData[{
 "Einstein\[CloseCurlyQuote]s summation convention for contraction is over \
repeated up-down index pairs in products like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Lambda]", "\[Mu]"], 
    SubscriptBox["\[Sigma]", "\[Mu]"]}], TraditionalForm]],ExpressionUUID->
  "39de2e26-8f12-d946-a00d-ebd228d49a0b"],
 " and tensorial expressions like ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[Eta]", "\[Mu]"], "\[Mu]"], TraditionalForm]],
  ExpressionUUID->"13885e30-233d-e34f-9010-e7baf14b84fe"],
 ". This convention obtains everywhere in this notebook and will be invoked \
without mention. "
}], "Text",
 CellChangeTimes->{{3.97614509343404*^9, 3.976145256281742*^9}, {
  3.976145314622245*^9, 3.976145358816577*^9}, {3.976191783186233*^9, 
  3.9761918633456593`*^9}},ExpressionUUID->"15b83427-6a96-f149-b696-\
c0be579ac833"],

Cell[TextData[{
 "For this notebook, one example is especially important: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Eta]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], 
     SuperscriptBox["\[Sigma]", "\[Mu]"]}], "=", 
    RowBox[{
     SubscriptBox["\[Sigma]", "\[Nu]"], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Sigma]", "0"], ",", 
        SubscriptBox["\[Sigma]", "1"], ",", 
        SubscriptBox["\[Sigma]", "2"], ",", 
        SubscriptBox["\[Sigma]", "3"]}], ")"}], "=", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[Sigma]", "0"], ",", 
        RowBox[{"-", 
         SuperscriptBox["\[Sigma]", "1"]}], ",", 
        RowBox[{"-", 
         SuperscriptBox["\[Sigma]", "2"]}], ",", 
        RowBox[{"-", 
         SuperscriptBox["\[Sigma]", "3"]}]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"3071866a-71b2-0343-ae23-6f7139d49341"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Eta]", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"aa3f040e-f475-e04b-9916-d3f575d6972d"],
 ", the Minkowski metric, is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"diag", "(", 
    RowBox[{"1", ",", 
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", "1"}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "ed49daeb-456c-e442-8e78-e8922323b7fe"],
 ". ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Eta]", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"f17fe94a-e298-f443-89fe-7e627bc00122"],
 " transforms the contravariant components ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[Sigma]", "0"], ",", 
     SuperscriptBox["\[Sigma]", "1"], ",", 
     SuperscriptBox["\[Sigma]", "2"], ",", 
     SuperscriptBox["\[Sigma]", "3"]}], ")"}], TraditionalForm]],
  ExpressionUUID->"6f37222e-680b-024c-adef-37058d7b4eb6"],
 " into the covariant components ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Sigma]", "0"], ",", 
     SubscriptBox["\[Sigma]", "1"], ",", 
     SubscriptBox["\[Sigma]", "2"], ",", 
     SubscriptBox["\[Sigma]", "3"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "307213b0-c0a8-d545-8c9e-f9c397305010"],
 ", which numerically equal ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[Sigma]", "0"], ",", 
     RowBox[{"-", 
      SuperscriptBox["\[Sigma]", "1"]}], ",", 
     RowBox[{"-", 
      SuperscriptBox["\[Sigma]", "2"]}], ",", 
     RowBox[{"-", 
      SuperscriptBox["\[Sigma]", "3"]}]}], ")"}], TraditionalForm]],
  ExpressionUUID->"cf0be260-735a-0e4e-b0f2-d09a4dd16a24"],
 ". "
}], "Text",
 CellChangeTimes->{{3.97614509343404*^9, 3.976145256281742*^9}, {
   3.976145314622245*^9, 3.976145358816577*^9}, {3.976191783186233*^9, 
   3.9761920659402246`*^9}, 3.976295744437611*^9, {3.97631534464294*^9, 
   3.9763153452965403`*^9}},ExpressionUUID->"9eade31d-af52-2a45-8be8-\
668517580678"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Display Rules", "Subsection",
 CellChangeTimes->{{3.976102488938941*^9, 
  3.9761024911792917`*^9}},ExpressionUUID->"4a398e2c-c671-a047-801a-\
a59024a3c346"],

Cell["\<\
To make results easier for humans to read, apply these rules to final \
results. The output will no longer be recognizable to our tools, so apply \
these rules only as a final step, \[OpenCurlyDoubleQuote]exiting\
\[CloseCurlyDoubleQuote] a calculation. \
\>", "Text",
 CellChangeTimes->{{3.976103162670732*^9, 3.97610322792951*^9}, 
   3.976112679117934*^9, {3.976138151573435*^9, 3.9761381554176407`*^9}, {
   3.976192079557807*^9, 
   3.9761920930394917`*^9}},ExpressionUUID->"7e5b6662-6a2e-dd4d-a078-\
01dbe0f9eea0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "dpyRules", ",", "d", ",", "s", ",", "\[Lambda]", ",", "\[Sigma]", ",", 
    "\[Eta]", ",", "d\[Lambda]ds"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dpyRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Specific", " ", "rules", " ", "ahead", " ", "of", " ", "general", " ", 
      "rules"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"d\[Lambda]ds", "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}], "]"}], ":>", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"FractionBox", "[", 
         RowBox[{
          RowBox[{"d", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\[Lambda]", ",", "\[Nu]"}], "]"}]}], ",", 
          RowBox[{"d", " ", "s"}]}], "]"}], "//", "DisplayForm"}], ")"}]}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"d\[Lambda]ds", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]_", "]"}], "]"}], ":>", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"FractionBox", "[", 
         RowBox[{
          RowBox[{"d", " ", 
           RowBox[{"Superscript", "[", 
            RowBox[{"\[Lambda]", ",", "\[Nu]"}], "]"}]}], ",", 
          RowBox[{"d", " ", "s"}]}], "]"}], "//", "DisplayForm"}], ")"}]}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"General", " ", "Rules"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CurlyEpsilon]_", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "\[Tau]_", "]"}], "]"}], ":>", 
      RowBox[{"Superscript", "[", 
       RowBox[{"\[CurlyEpsilon]", ",", "\[Tau]"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CurlyEpsilon]_", "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Tau]_", "]"}], "]"}], ":>", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\[CurlyEpsilon]", ",", "\[Tau]"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CurlyEpsilon]_", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}]}], "]"}], ":>", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\[CurlyEpsilon]", ",", 
        RowBox[{"(", 
         RowBox[{"\[Mu]", " ", "\[Nu]"}], ")"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CurlyEpsilon]_", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], ",", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]_", "]"}]}], "]"}], ":>", 
      RowBox[{"Superscript", "[", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\[CurlyEpsilon]", ",", "\[Mu]"}], "]"}], ",", "\[Nu]"}], 
       "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CurlyEpsilon]_", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]_", "]"}], ",", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]_", "]"}]}], "]"}], ":>", 
      RowBox[{"Superscript", "[", 
       RowBox[{"\[CurlyEpsilon]", ",", 
        RowBox[{"(", 
         RowBox[{"\[Mu]", " ", "\[Nu]"}], ")"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CurlyEpsilon]_", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]_", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}]}], "]"}], ":>", 
      RowBox[{"Subscript", "[", 
       RowBox[{
        RowBox[{"Superscript", "[", 
         RowBox[{"\[CurlyEpsilon]", ",", "\[Mu]"}], "]"}], ",", "\[Nu]"}], 
       "]"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "echo", "]"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"for", " ", "debugging"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"echo", "[", "\[Tau]_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\[Tau]", "/.", "dpyRules"}], "]"}], ";", 
       RowBox[{"Echo", "[", "\[Tau]", "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"unit", " ", "tests"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"\[Sigma]", "[", 
     RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "]"}], "==", 
    RowBox[{
     RowBox[{"\[Eta]", "[", 
      RowBox[{
       RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], 
     RowBox[{"\[Sigma]", "[", 
      RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}]}], ")"}], "/.",
   "dpyRules"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[Lambda]ds", "[", 
   RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}], "/.", 
