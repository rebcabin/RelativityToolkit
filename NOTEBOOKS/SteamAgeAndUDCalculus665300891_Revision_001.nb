  "SEPARATION VECTOR \
COMPONENTS",ExpressionUUID->"0e581092-b9a1-d749-9ffd-ac44da1214fd"],

Cell[TextData[{
 "Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     SuperscriptBox["\[Sigma]", "0"], ")"}], "=", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       StyleBox["x",
        FontWeight->"Bold"], "-", 
       RowBox[{
        StyleBox["z",
         FontWeight->"Bold"], "(", 
