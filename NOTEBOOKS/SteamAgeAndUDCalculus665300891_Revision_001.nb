96ddd5f06214"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Local Gauge Invariance", "Subsection",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 3.975185960766884*^9}, {
   3.975186335204997*^9, 3.975186378447083*^9}, {3.975186481658581*^9, 
   3.975186523869499*^9}, {3.975186557291993*^9, 3.975186598287777*^9}, {
   3.9751867212544107`*^9, 3.9751868361873503`*^9}, {3.9751868702450438`*^9, 
   3.975186918879197*^9}, 3.975187383155944*^9, {3.975187474714205*^9, 
   3.975187559493368*^9}, {3.975187877891349*^9, 3.975188018394823*^9}, {
   3.975188095613347*^9, 
   3.9751881285446577`*^9}},ExpressionUUID->"e414512c-e7c5-0b4e-8851-\
2fabdaacec39"],

Cell[TextData[{
 "Just as we required invariance under ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "\[RightArrow]", "\[Tau]"}], TraditionalForm]],ExpressionUUID->
  "bebe79a8-678a-3641-9f78-77953779b5fb"],
 " for a particle, we require field theories to be invariant under other \
kinds of gauge transformations, e.g., under local phase shifts ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Phi]", "(", "x", ")"}], "\[RightArrow]", 
    RowBox[{
     SuperscriptBox["e", 
      RowBox[{"i", "\[VeryThinSpace]", 
       RowBox[{"\[Alpha]", "(", "x", ")"}]}]], 
     RowBox[{"\[Phi]", "(", "x", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "6d1319a7-8996-234f-8457-3a25300f904f"],
 ", where ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],ExpressionUUID->
  "64e11686-6d31-de47-939f-50955898a0c9"],
 " varies smoothly with ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "12513de7-a38b-6c4a-9ffe-522820fb5ca5"],
 "."
}], "Text",
 CellChangeTimes->{
  3.975119724717957*^9, {3.975185863334693*^9, 3.975185960766884*^9}, {
   3.975186335204997*^9, 3.975186378447083*^9}, {3.975186481658581*^9, 
   3.975186523869499*^9}, {3.975186557291993*^9, 3.975186598287777*^9}, {
   3.9751867212544107`*^9, 3.9751868361873503`*^9}, {3.9751868702450438`*^9, 
   3.975186918879197*^9}, 3.975187383155944*^9, {3.975187474714205*^9, 
   3.975187559493368*^9}, {3.975187877891349*^9, 3.975188018394823*^9}, {
   3.975188095613347*^9, 3.97518820543748*^9}, {3.975188255105852*^9, 
