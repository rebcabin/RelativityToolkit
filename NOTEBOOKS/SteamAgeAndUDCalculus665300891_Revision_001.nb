Cell[CellGroupData[{

Cell["Basic Rules from Calculus", "Subsubsection",
 CellChangeTimes->{{3.975962050006874*^9, 3.975962057723241*^9}, {
  3.975968415621479*^9, 3.9759684160049*^9}, {3.9759706739573603`*^9, 
  3.975970694635236*^9}},ExpressionUUID->"0a7df98d-30ba-c347-99e2-\
bff7986292c5"],

Cell[TextData[StyleBox["Linearity, Product Rule, Power Rule",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.97604475333066*^9, 
  3.976044762765122*^9}},ExpressionUUID->"bd513cf9-f999-b041-a735-\
a7150c38805c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fourGrad", "[", 
    RowBox[{
     RowBox[{"a_", "+", "b_"}], ",", "ud_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"fourGrad", "[", 
     RowBox[{"a", ",", "ud"}], "]"}], "+", 
    RowBox[{"fourGrad", "[", 
     RowBox[{"b", ",", "ud"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fourGrad", "[", 
    RowBox[{
     RowBox[{"a_", "*", "b_"}], ",", "ud_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"b", " ", 
     RowBox[{"fourGrad", "[", 
      RowBox[{"a", ",", "ud"}], "]"}]}], "+", 
    RowBox[{"a", " ", 
     RowBox[{"fourGrad", "[", 
      RowBox[{"b", ",", "ud"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fourGrad", "[", 
    RowBox[{
     SuperscriptBox["a_", "n_"], ",", "ud_"}], "]"}], ":=", 
   RowBox[{"n", " ", 
    SuperscriptBox["a", 
     RowBox[{"n", "-", "1"}]], 
    RowBox[{"fourGrad", "[", 
     RowBox[{"a", ",", "ud"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9760429624706163`*^9, 3.976042962471779*^9}, {
  3.976043351671191*^9, 3.9760434007259827`*^9}, {3.9760442707275763`*^9, 
  3.976044315740296*^9}, {3.9760447748454323`*^9, 3.9760447797686853`*^9}, {
  3.976102297571516*^9, 3.9761023114890347`*^9}, {3.976283859689364*^9, 
  3.9762838715031853`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"a922a03c-fbd8-8f4c-b2fb-20303f629180"],

