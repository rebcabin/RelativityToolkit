c008411594af"],

Cell[TextData[{
 "defining 3\[NoBreak]-\[NoBreak]vectors ",
 Cell[BoxData[
  FormBox[
   StyleBox["x",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "966d5af4-c421-9f43-bce6-ecc07399cf35"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["z",
