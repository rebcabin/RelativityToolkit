  RowBox[{
   RowBox[{"ROf\[Rho]", "[", "\[Rho]In_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"R", "/.", 
      RowBox[{"Quiet", "@", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"forceEqn", "&&", 
            RowBox[{"\[Rho]", ">", "0"}], "&&", 
            RowBox[{"R", ">", "0"}]}], "/.", 
           RowBox[{"{", 
            RowBox[{"\[Rho]", "->", "\[Rho]In"}], "}"}]}], ")"}], ",", "R", ",",
          "Reals"}], "]"}]}]}], ")"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"os\[Rho]", "=", "22590."}], ",", "\[IndentingNewLine]", 
     RowBox[{"gold\[Rho]", "=", "19300"}], ",", "\[IndentingNewLine]", 
