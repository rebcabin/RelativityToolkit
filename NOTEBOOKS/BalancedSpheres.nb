f5e125a33916"],

Cell[TextData[{
 "Our imaginary white-dwarf and neutron-star spheres are not remotely near \
the Schwarzschild radius for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"125", " ", "mt"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fec24b7e-a002-4d8e-8785-9b2e7333cfc6"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "G", "\[VeryThinSpace]", 
     RowBox[{"m", "/", 
      SuperscriptBox["c", "2"]}]}], "\[TildeTilde]", 
    RowBox[{"2", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "22"}]], "meter"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9968b7f2-b592-425e-b1de-1886cb3d2fcd"],
 ". Our imaginary tiny white dwarves and neutron stars are not remotely close \
to collapsing into black holes."
}], "Text",
 CellChangeTimes->{{3.990738927855229*^9, 3.990738945532425*^9}, {
  3.9907390084217873`*^9, 
  3.990739148886821*^9}},ExpressionUUID->"72c6fc1a-5c39-40a8-b178-\
facdfa8b6341"]
}, Open  ]],

