Cell[CellGroupData[{

Cell["Engineering Challenges for the Electrostatic Experiment", "Subsection",
 CellChangeTimes->{{3.9907423920112658`*^9, 
  3.990742408000513*^9}},ExpressionUUID->"03b9f655-c6a7-424d-884c-\
5a738b2c0e77"],

Cell["\<\
Electrifying massive spheres to achieve gravitational-electrostatic balance \
introduces several severe practical and engineering challenges.\
\>", "Text",
 CellChangeTimes->{{3.990742455409883*^9, 
  3.99074248633952*^9}},ExpressionUUID->"009d19d7-d8cd-4f79-a77e-\
d5d1d8724ba6"],

Cell[CellGroupData[{

Cell["Insulator Load (Material Science)", "Subsubsection",
 CellChangeTimes->{{3.990742455409883*^9, 3.9907425005567923`*^9}, {
  3.99074435913198*^9, 
  3.990744362513081*^9}},ExpressionUUID->"90be7d5d-e0a1-474a-96ef-\
1900593e6fd8"],

Cell["\<\
Each sphere weighs between 560 and 840 metric tonnes. To prevent the electric \
charge from instantly draining into the Earth, the spheres must sit on \
electrically insulating cradles.\
\>", "Text",
 CellChangeTimes->{{3.990742455409883*^9, 
  3.9907425204597054`*^9}},ExpressionUUID->"c564015e-4069-4fc3-94c6-\
3198b2edddee"],

Cell["\<\
Materials that are excellent electrical insulators (like Teflon, glass, or \
alumina ceramics) typically have low fracture toughness or creep under high \
mechanical loads. Designing a support cradle that can withstand hundreds of \
tonnes of shear and compressive stress without cracking while maintaining an \
insulation resistance high enough to block hundreds of kilovolts, is a major \
materials challenge.\
\>", "Text",
 CellChangeTimes->{{3.990742455409883*^9, 3.990742577241982*^9}, {
  3.990742686377236*^9, 
  3.99074268690702*^9}},ExpressionUUID->"b49d10ec-c792-4f35-9d3b-\
6b40a590d4b8"],

Cell[TextData[{
 StyleBox["Charge Redistribution (Mutual Polarization)", "Subsubsection"],
 "\n\nIn basic calculations, we assume the spheres act as point charges. ",
 StyleBox["The gravitational and electrostatic forces would balance for any \
separation (!) because both forces follow inverse-square laws.",
  FontSlant->"Italic",
  FontColor->RGBColor[0.98, 0.56, 0.17]]
}], "Text",
 CellChangeTimes->{{3.990742455409883*^9, 3.9907426471759863`*^9}, {
  3.990742708797142*^9, 3.990742715940887*^9}, {3.9907436762720327`*^9, 
  3.990743752058757*^9}},ExpressionUUID->"74a7a411-3f1b-4963-86cc-\
698403f9f478"],

Cell["\<\
However, because they are made of highly conductive metals (especially Gold \
and Iron), electrons repel each other and migrate to the far sides of the \
spheres. The resulting polarization shifts the effective \
\[OpenCurlyDoubleQuote]center of charge\[CloseCurlyDoubleQuote] outward, away \
from the physical center of mass. \
\>", "Text",
 CellChangeTimes->{{3.990742455409883*^9, 3.9907426471759863`*^9}, {
  3.990742708797142*^9, 3.990742715940887*^9}, {3.990743783967743*^9, 
  3.990743785342044*^9}},ExpressionUUID->"23f7c42d-7982-44fd-934a-\
e34f08a69ac7"],

Cell["\<\
To maintain balance, the exact separation distance will be much, much smaller \
than the original 1 meter. The following code estimates the new required \
separations using the textbook method of images. The resulting table takes a \
few seconds to compute.\
\>", "Text",
 CellChangeTimes->{{3.990742455409883*^9, 3.9907426471759863`*^9}, 
   3.990742708797142*^9, {3.990742815321683*^9, 3.990742842779805*^9}, {
   3.99074377926245*^9, 
   3.990743863718739*^9}},ExpressionUUID->"33af219b-6567-4ee9-b877-\
b9b02d574328"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Method", " ", "of", " ", "Images", " ", "Force", " ", "Calculator"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"CalculateForce", "[", 
     RowBox[{"R_", ",", "d_", ",", "Q0_"}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"maxTerms", "=", "30"}], ",", "b", ",", "q", ",", "S", ",", 
        "force", ",", "i", ",", "j"}], "}"}], ",", 
      RowBox[{
       RowBox[{"b", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0.", ",", 
          RowBox[{"{", "maxTerms", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"q", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0.", ",", 
          RowBox[{"{", "maxTerms", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"b", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", "0."}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"q", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", "1."}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"b", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "=", 
           RowBox[{
            SuperscriptBox["R", "2"], "/", 
            RowBox[{"(", 
             RowBox[{"d", "-", 
              RowBox[{"b", "[", 
               RowBox[{"[", 
                RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"q", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "=", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"q", "[", 
              RowBox[{"[", 
               RowBox[{"k", "-", "1"}], "]"}], "]"}]}], "*", 
            RowBox[{"R", "/", 
             RowBox[{"(", 
              RowBox[{"d", "-", 
               RowBox[{"b", "[", 
                RowBox[{"[", 
                 RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ")"}]}]}]}], ";"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"k", ",", "2", ",", "maxTerms"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"S", "=", 
        RowBox[{"Total", "[", "q", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"force", "=", "0."}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Do", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"force", "+=", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"q", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "*", 
                 RowBox[{"q", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "/", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"d", "-", 
                  RowBox[{"b", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "-", 
                  RowBox[{"b", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "2"]}]}], ";"}], ",",
             "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", "maxTerms"}], "}"}]}], "]"}], ";"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "maxTerms"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ke", "*", 
        SuperscriptBox["Q0", "2"], "*", 
        RowBox[{"force", "/", 
         SuperscriptBox["S", "2"]}]}]}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.990743254670377*^9, 3.990743277999008*^9}, {
  3.990743337343005*^9, 3.9907434175970583`*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"b56a6a4b-18b6-4c3b-a213-cd9a77c32c47"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Compute", " ", "Polarization", " ", "Corrections"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"colsData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rho", "=", 
           RowBox[{"mat", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "R", ",", "rVal", ",", "mass", ",", "charge", ",", "d0", ",", 
             "f0", ",", "pctRed", ",", "dNew", ",", "gNew", ",", "deltaG", ",",
              "qRatio"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"rVal", "=", 
             RowBox[{"R", "/.", " ", 
              RowBox[{"First", "[", 
               RowBox[{"NSolve", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    SqrtBox["G"], "rho", 
                    RowBox[{"(", 
                    FractionBox[
                    RowBox[{"4", "\[Pi]", " ", 
                    SuperscriptBox["R", "3"]}], "3"], ")"}]}], "==", 
                   RowBox[{
                    RowBox[{"2", "*", "R"}], "+", "1"}]}], "&&", 
                  RowBox[{"R", ">", "0"}]}], ",", "R"}], "]"}], "]"}]}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"mass", "=", 
             RowBox[{"rho", "*", 
              RowBox[{"(", 
               FractionBox[
                RowBox[{"4", "\[Pi]", " ", 
                 SuperscriptBox["rVal", "3"]}], "3"], ")"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"charge", "=", 
             RowBox[{"mass", 
              SqrtBox[
               RowBox[{"G", "/", "ke"}]]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"d0", "=", 
             RowBox[{
              RowBox[{"2", "rVal"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
              "Repulsive", " ", "force", " ", "at", " ", "the", " ", 
               "original", " ", "1"}], "-", 
              RowBox[{"meter", " ", "gap"}]}], "*)"}], "\[IndentingNewLine]", 
            
            RowBox[{"f0", "=", 
             RowBox[{"CalculateForce", "[", 
              RowBox[{"rVal", ",", "d0", ",", "charge"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"pctRed", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1.0", "-", "f0"}], ")"}], "*", "100"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
              "Find", " ", "the", " ", "closer", " ", "separation", " ", 
               "dNew", " ", "where", " ", "Force"}], "=", 
              RowBox[{"1", " ", "N"}]}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"dNew", "=", 
             RowBox[{"d", "/.", " ", 
              RowBox[{"First", "[", 
               RowBox[{"FindRoot", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"CalculateForce", "[", 
                   RowBox[{"rVal", ",", "d", ",", "charge"}], "]"}], "==", 
                  "1"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"d", ",", 
                   RowBox[{"d0", "-", "0.05"}]}], "}"}]}], "]"}], "]"}]}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"gNew", "=", 
             RowBox[{"dNew", "-", 
              RowBox[{"2", "rVal"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"deltaG", "=", 
             RowBox[{"1.0", "-", "gNew"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Charge", " ", "multiplier", " ", "needed", " ", "to", " ", 
              "balance", " ", "at", " ", "the", " ", "original", " ", "d0"}], 
             "*)"}], "\[IndentingNewLine]", 
            RowBox[{"qRatio", "=", 
             RowBox[{"1.0", "/", 
              SqrtBox["f0"]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"NumberForm", "[", 
                  RowBox[{"pctRed", ",", 
                   RowBox[{"{", 
                    RowBox[{"3", ",", "2"}], "}"}]}], "]"}], 
                 ",", "\"\<%\>\""}], "}"}], "]"}], ",", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"NumberForm", "[", 
                  RowBox[{"gNew", ",", 
                   RowBox[{"{", 
                    RowBox[{"4", ",", "3"}], "}"}]}], "]"}], 
                 ",", "\"\< m\>\""}], "}"}], "]"}], ",", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"NumberForm", "[", 
                  RowBox[{"deltaG", ",", 
                   RowBox[{"{", 
                    RowBox[{"4", ",", "3"}], "}"}]}], "]"}], 
                 ",", "\"\< m\>\""}], "}"}], "]"}], ",", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"qRatio", "-", "1"}], ")"}], "*", "100"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"3", ",", "2"}], "}"}]}], "]"}], 
                 ",", "\"\<%\>\""}], "}"}], "]"}]}], "}"}]}]}], "]"}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"mat", ",", "materials"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Construct", " ", "Tabular"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"headers", "=", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"materials", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], 
       ",", "\"\<Mutual Polarization Effect\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rowLabels", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<Force Reduction at 1m Gap\>\"", 
       ",", "\"\<New Gap for 1-Newton Repulsion\>\"", 
       ",", "\"\<Gap Decrease Needed\>\"", 
       ",", "\"\<Charge Increase for Balance at 1m\>\""}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"tabularData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
