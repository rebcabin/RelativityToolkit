     RowBox[{"iron\[Rho]", "=", "7874"}], ",", "\[IndentingNewLine]", 
     RowBox[{"wd\[Rho]", "=", "2.93*^10"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ns\[Rho]", "=", "4.00*^17"}]}], "}"}], ",", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"osR", "=", 
      RowBox[{"ROf\[Rho]", "[", "os\[Rho]", "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"goldR", "=", 
      RowBox[{"ROf\[Rho]", "[", "gold\[Rho]", "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"leadR", "=", 
      RowBox[{"ROf\[Rho]", "[", "lead\[Rho]", "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ironR", "=", 
      RowBox[{"ROf\[Rho]", "[", "iron\[Rho]", "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"wdR", "=", 
      RowBox[{"ROf\[Rho]", "[", "wd\[Rho]", "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"nsR", "=", 
      RowBox[{"ROf\[Rho]", "[", "ns\[Rho]", "]"}]}]}], "}"}], ",", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"osM", "=", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{"os\[Rho]", " ", "4", "\[Pi]", " ", 
