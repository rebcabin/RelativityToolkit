Cell[CellGroupData[{

Cell["Initialize the Relativity Toolkit", "Section",
 CellChangeTimes->{{3.9775137220895033`*^9, 3.977513731036991*^9}, {
   3.9775149251253233`*^9, 3.9775149394419107`*^9}, {3.977515019357979*^9, 
   3.9775150305786533`*^9}, {3.977515069824033*^9, 3.977515077560625*^9}, 
   3.9775154960870533`*^9, {3.9775171395382757`*^9, 
   3.9775171504203053`*^9}},ExpressionUUID->"e0792760-7d08-469c-bd15-\
b84ab8afddcb"],

Cell[TextData[{
 "The toolkit is currently implemented as a script rather than as a Package, \
prioritizing development speed and transparency over encapsulation. All \
symbols, including internal variables in Module constructs, are loaded into \
the Global namespace. That makes it difficult to find just the intentional \
exports of the toolkit without reading the ",
 StyleBox[ButtonBox["code",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/rebcabin/RelativityToolkit/blob/main/\
RelativityToolkit.wl"], None},
  ButtonNote->
   "https://github.com/rebcabin/RelativityToolkit/blob/main/RelativityToolkit.\
wl"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 " or the ",
 StyleBox[ButtonBox["reference manual",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/rebcabin/RelativityToolkit/blob/main/\
ReferenceManual.md"], None},
  ButtonNote->
   "https://github.com/rebcabin/RelativityToolkit/blob/main/ReferenceManual.\
md"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 ". This inconvenience will be mitigated in future versions."
}], "Text",
 CellChangeTimes->{{3.978188523075684*^9, 3.978188555596314*^9}, {
  3.978189800818763*^9, 3.9781899399767933`*^9}, {3.979575129134342*^9, 
