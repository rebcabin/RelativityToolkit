 RowBox[{
  TagBox["\<\"\\!\\(\\*SubscriptBox[SuperscriptBox[\\(\[CapitalGamma]\\), \\(\
\[VeryThinSpace]\\(r\\)\\)], \
\\(\[VeryThinSpace]\\(r\[VeryThinSpace]r\\)\\)]\\) =\"\>",
   "EchoLabel"], "  ", 
  FractionBox[
   RowBox[{
    SuperscriptBox["B", "\[Prime]",
     MultilineFunction->None], "[", "r", "]"}], 
   RowBox[{"2", " ", 
