 CellChangeTimes->{{3.978215929928647*^9, 3.978215929929338*^9}, 
   3.978225396824547*^9},
 CellLabel->"In[13]:=",ExpressionUUID->"4ef6ab19-77f8-4f7f-be65-6987cc5d9d07"],

Cell["\<\
Converts (compiles) partial derivatives \[ScriptCapitalU]\[ScriptCapitalD] \
notation into forms that Wolfram can manipulate.\
\>", "ItemParagraph",
 CellChangeTimes->{{3.978224734348538*^9, 3.9782247409653387`*^9}, {
  3.9782248777517977`*^9, 3.9782249062008753`*^9}, {3.9795761103796186`*^9, 
  3.9795761276986017`*^9}},ExpressionUUID->"53d11251-c505-4e4e-81c8-\
a324f93a377b"],

Cell[TextData[StyleBox["MakeIndexer", "Input",
 Background->RGBColor[1, 0.75, 0, 0.33]]], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.978216204084797*^9, 3.978216204086956*^9}, 
   3.978225400429134*^9},
 CellLabel->"In[14]:=",ExpressionUUID->"4ad228ed-2b96-4aa0-90f4-3ad016759d94"],

Cell[TextData[{
 "Makes a function that can index a matrix via symbolic coordinates rather \
than by ",
 StyleBox["Part", "Input"],
 " numbers."
}], "ItemParagraph",
 CellChangeTimes->{{3.978224734348538*^9, 3.9782247409653387`*^9}, {
  3.978224913612956*^9, 3.978224933600033*^9}, {3.979576140072217*^9, 
  3.979576154352113*^9}},ExpressionUUID->"654c7d5c-b728-4987-a493-\
d15718e5e412"],

Cell[TextData[StyleBox["CalculateRiemannComponent", "Input",
 Background->RGBColor[1, 0.75, 0, 0.33]]], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.978216429400505*^9, 3.978216429402155*^9}, 
   3.978225404753154*^9},
 CellLabel->"In[15]:=",ExpressionUUID->"d179a226-76a0-4b91-84ce-d656ee9ed506"],

Cell["\<\
Given Christoffel symbols via an indexer, calculate a component of the \
Riemann curvature tensor, specified via natural coordinate symbols, by \
contracting over the Christoffel symbols.\
\>", "ItemParagraph",
 CellChangeTimes->{{3.978224734348538*^9, 3.9782247409653387`*^9}, {
  3.97822494113592*^9, 3.978224981146879*^9}, {3.9782250156184587`*^9, 
  3.9782250189595823`*^9}, {3.9782250658787117`*^9, 3.978225074052433*^9}, {
  3.9795761631369677`*^9, 3.9795762075122128`*^9}, {3.979576292996318*^9, 
  3.9795762969467287`*^9}},ExpressionUUID->"01494e09-6ce7-438c-8e32-\
6005b52f67e8"],

Cell[TextData[StyleBox["CalculateRicciComponent", "Input",
 Background->RGBColor[1, 0.75, 0, 0.33]]], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.978216490646516*^9, 3.978216490647324*^9}, 
   3.978225408335648*^9},
 CellLabel->"In[16]:=",ExpressionUUID->"fc0a9aea-9ad3-4ff9-9c71-2a99008ffe36"],

Cell["\<\
Given a Riemann tensor via an indexer, calculate a component of the Ricci \
tensor, a particular contraction of the Riemann tensor. Specify the desired \
component via natural coordinate symbols.\
\>", "ItemParagraph",
 CellChangeTimes->{{3.978224734348538*^9, 3.9782247409653387`*^9}, {
   3.978225027528164*^9, 3.978225083756073*^9}, 3.979576217370551*^9, {
   3.97957625323214*^9, 
   3.979576273552032*^9}},ExpressionUUID->"ce0a22b0-3e70-4838-9c27-\
fb0592e300ae"],

