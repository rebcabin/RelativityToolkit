                SuperscriptBox["A", "\[Prime]\[Prime]",
                 MultilineFunction->None], "(", "r", ")"}]}]}], ")"}]}]}], 
          RowBox[{"4", " ", "r", " ", 
           SuperscriptBox[
            RowBox[{"A", "(", "r", ")"}], "2"], " ", 
           RowBox[{"B", "(", "r", ")"}]}]]}], "0", "0"},
       {"0", "0", 
        RowBox[{
         FractionBox[
          RowBox[{
           FractionBox[
            RowBox[{"r", " ", 
             RowBox[{
              SuperscriptBox["A", "\[Prime]",
               MultilineFunction->None], "(", "r", ")"}]}], 
            RowBox[{"2", " ", 
             RowBox[{"A", "(", "r", ")"}]}]], "+", "1"}], 
          RowBox[{"B", "(", "r", ")"}]], "-", 
         FractionBox[
          RowBox[{"r", " ", 
           RowBox[{
            SuperscriptBox["B", "\[Prime]",
             MultilineFunction->None], "(", "r", ")"}]}], 
          RowBox[{"2", " ", 
           SuperscriptBox[
            RowBox[{"B", "(", "r", ")"}], "2"]}]], "-", "1"}], "0"},
       {"0", "0", "0", 
        FractionBox[
         RowBox[{
          RowBox[{
           SuperscriptBox["sin", "2"], "(", "\[Theta]", ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"r", " ", 
             RowBox[{"B", "(", "r", ")"}], " ", 
             RowBox[{
              SuperscriptBox["A", "\[Prime]",
               MultilineFunction->None], "(", "r", ")"}]}], "-", 
            RowBox[{
             RowBox[{"A", "(", "r", ")"}], " ", 
