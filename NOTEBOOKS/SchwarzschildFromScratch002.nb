  3.978223567404305*^9}},ExpressionUUID->"d56323a5-62e4-4109-85ea-\
172757b979d6"],

Cell["Pulling together all results:", "Text",
 CellChangeTimes->{{3.9782237366613483`*^9, 3.978223776463778*^9}, 
   3.979577846714191*^9},ExpressionUUID->"4a7a9aef-7c75-44e8-a008-\
3aad67462d3c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"SchwAnsatz", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"B", "[", "r", "]"}], "->", 
         RowBox[{"1", "/", 
          RowBox[{"A", "[", "r", "]"}]}]}], "}"}]}], "/.", "SchwA"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"1"},
        "C"], "->", 
       RowBox[{
        RowBox[{"-", "2"}], "M"}]}], "}"}]}], 
    ",", "\"\<Schwarzschild Solution via \[ScriptCapitalU]\[ScriptCapitalD] :\
\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.978223570813449*^9, 3.9782236426712847`*^9}, 
   3.978223677242341*^9, {3.978225542333416*^9, 3.9782255824789257`*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"0a5140af-748a-434f-8902-43cec3913877"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Schwarzschild Solution via \[ScriptCapitalU]\[ScriptCapitalD] :\
\"\>",
   "EchoLabel"], "  ", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        FractionBox[
         RowBox[{"2", " ", "M"}], "r"]}], ",", "0", ",", "0", ",", "0"}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox["1", 
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"2", " ", "M"}], "r"]}]], ",", "0", ",", "0"}], "}"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       SuperscriptBox["r", "2"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", 
       RowBox[{
        SuperscriptBox["r", "2"], " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], "}"}]}], "}"}], 
   "}"}]}]], "Echo",
 CellChangeTimes->{
  3.97957784989377*^9},ExpressionUUID->"763ab8cc-8af3-44cd-b659-d06fa782c07c"]
}, Open  ]],

Cell["and comparing against the WFR resource", "Text",
 CellChangeTimes->{{3.978223762999488*^9, 
  3.978223810738841*^9}},ExpressionUUID->"e827ff39-3d0b-42ac-8662-\
1ff8bf052309"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"ResourceFunction", "[", "\"\<MetricTensor\>\"", "]"}], 
      "[", "\"\<Schwarzschild\>\"", "]"}], "[", "\"\<MatrixRepresentation\>\"",
      "]"}], ",", "\"\<Schwarzschild Solution via WFR :\>\""}], "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9782255897681723`*^9, 3.9782256107836103`*^9}, 
   3.978226361277341*^9},
 CellLabel->"In[39]:=",ExpressionUUID->"2d1b3a2d-58d8-4686-b68f-d5a44ba5d9e8"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Schwarzschild Solution via WFR :\"\>",
   "EchoLabel"], "  ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       FractionBox[
        RowBox[{
        "2", " ", "\<\"\[FormalCapitalM]\"\>"}], "\<\"\[FormalR]\"\>"]}], ",",
       "0", ",", "0", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      FractionBox["1", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{
         "2", " ", "\<\"\[FormalCapitalM]\"\>"}], "\<\"\[FormalR]\"\>"]}]], ",",
       "0", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", 
      SuperscriptBox["\<\"\[FormalR]\"\>", "2"], ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", 
      RowBox[{
       SuperscriptBox["\<\"\[FormalR]\"\>", "2"], " ", 
       SuperscriptBox[
        RowBox[{"Sin", "[", "\<\"\[FormalTheta]\"\>", "]"}], "2"]}]}], 
     "}"}]}], "}"}]}]], "Echo",
 CellChangeTimes->{
  3.979577854552101*^9},ExpressionUUID->"db02de8f-a1b8-42e4-9aec-\
9c7842416893"]
}, Open  ]],

Cell["\<\
we see a perfect match, except for WFR\[CloseCurlyQuote]s convention of \
formal symbols (with underdots).\
\>", "Text",
 CellChangeTimes->{{3.9782238230028*^9, 
  3.978223854840865*^9}},ExpressionUUID->"ac2e29e4-338b-4528-9e1f-\
