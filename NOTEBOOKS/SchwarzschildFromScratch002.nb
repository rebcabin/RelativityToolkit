  FormBox[
   SubscriptBox["\[ConstantC]", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e0541f79-3bd1-47ff-909d-1984ba90d62a"],
 " in the next step."
}], "Text",
