Cell[TextData[{
 "Apply flat-space boundary conditions at infinity, meaning ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderscriptBox["lim", 
      RowBox[{"r", "->", "\[Infinity]"}]], 
     RowBox[{"A", "[", "r", "]"}]}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"0eed5f4e-e32f-4c72-9612-d7f7ea7cbde2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderscriptBox["lim", 
      RowBox[{"r", "->", "\[Infinity]"}]], 
     RowBox[{"B", "[", "r", "]"}]}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"1723090a-5e25-42b3-b1ba-94f4f18603cb"],
 " to deduce that this ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ConstantC]", "1"], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"f277f8f7-bfd9-4980-898b-7048ab42396b"],
 ".",
