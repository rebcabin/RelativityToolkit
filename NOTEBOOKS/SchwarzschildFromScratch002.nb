                  SuperscriptBox["A", "\[Prime]",
                   MultilineFunction->None], "(", "r", ")"}]}]}], ")"}]}]}], 
            ")"}]}]}], 
         RowBox[{"4", " ", "r", " ", 
          RowBox[{"A", "(", "r", ")"}], " ", 
          SuperscriptBox[
           RowBox[{"B", "(", "r", ")"}], "2"]}]], "0", "0", "0"},
       {"0", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           RowBox[{
            RowBox[{"A", "(", "r", ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"r", " ", 
               RowBox[{
                SuperscriptBox["A", "\[Prime]",
                 MultilineFunction->None], "(", "r", ")"}]}], "+", 
              RowBox[{"4", " ", 
               RowBox[{"A", "(", "r", ")"}]}]}], ")"}], " ", 
