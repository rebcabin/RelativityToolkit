 RowBox[{
  TagBox["\<\"Schwarzschild Solution :\"\>",
   "EchoLabel"], "  ", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"A", "[", "r", "]"}], "\[Rule]", 
     RowBox[{"1", "+", 
      FractionBox[
       TemplateBox[{"1"},
        "C"], "r"]}]}], "}"}], "}"}]}]], "Echo",
 CellChangeTimes->{
  3.979577730154437*^9},ExpressionUUID->"6b04029f-1d62-402f-ab66-\
effb4828f340"]
}, Open  ]],

Cell[TextData[{
 "We just need to figure out the new integration constant, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ConstantC]", "1"], TraditionalForm]],ExpressionUUID->
  "513ba932-bfa4-46d2-ac7c-a2ce46a1cabd"],
