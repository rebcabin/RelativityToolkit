Cell[CellGroupData[{

Cell["(Optional) Visualization", "Subsubsection",
 CellChangeTimes->{{3.9795526756932573`*^9, 3.979552677908777*^9}, {
  3.979569516085784*^9, 
  3.97956951922976*^9}},ExpressionUUID->"770b8a4a-0f97-4df4-858b-\
9ee9952c46c7"],

Cell[TextData[StyleBox["Please tolerate some imprecision in this section in \
service of brevity. Rigor is not needed here.",
 FontSlant->"Italic"]], "Text",
 CellChangeTimes->{{3.979569040213653*^9, 3.979569073821*^9}, {
  3.979576948401676*^9, 
  3.979576971192129*^9}},ExpressionUUID->"25746817-df6f-4afa-9a04-\
65100314b8ad"],

Cell[TextData[{
 "View ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    RowBox[{
    "a", "\[VeryThinSpace]", "b", "\[VeryThinSpace]", "c", "\[VeryThinSpace]",
      "d"}]], TraditionalForm]],ExpressionUUID->
  "d8b6afe6-459c-4fb6-9112-2297b3075e79"],
 "\:200b as an operator that connects a spacetime ",
 StyleBox["Loop Plane",
  FontSlant->"Italic"],
 " to a ",
 StyleBox["Rotation Plane",
  FontSlant->"Italic"],
 ". Parallel-transport a test vector around a loop in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"c", ",", "d"}], "}"}], TraditionalForm]],ExpressionUUID->
  "ecc37a89-1a94-43a4-a9d5-222fae603296"],
 " l",
 "oop plane",
 ". The test vector does not return to its original direction. Measure the \
angular deficit against the original test vector in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"a", ",", "b"}], "}"}], TraditionalForm]],ExpressionUUID->
  "4bcb2b61-7cc0-4e1c-8053-2149ae7be930"],
 " r",
 "otation plane",
 ". "
}], "Text",
 CellChangeTimes->{{3.9795535307475348`*^9, 3.979553623667347*^9}, {
   3.979568019217429*^9, 3.9795680323233767`*^9}, {3.979568070153126*^9, 
   3.979568140732298*^9}, {3.9795681789402523`*^9, 3.979568191128976*^9}, {
   3.979568943426519*^9, 3.9795690009725246`*^9}, 3.979569038079626*^9, {
   3.9795699633761463`*^9, 3.97957001313269*^9}, {3.9795769875962963`*^9, 
   3.979577060012802*^9}},ExpressionUUID->"7958edbf-8b09-4073-9c9b-\
7e7d9f4e35b1"],

Cell[TextData[{
 "There are 6 orthogonal planes in spacetime ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"t", "\[VeryThinSpace]", "x"}], ",", 
     RowBox[{"t", "\[VeryThinSpace]", "y"}], ",", 
     RowBox[{"t", "\[VeryThinSpace]", "z"}], ",", 
     RowBox[{"x", "\[VeryThinSpace]", "y"}], ",", 
     RowBox[{"x", "\[VeryThinSpace]", "z"}], ",", 
     RowBox[{"y", "\[VeryThinSpace]", "z"}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"1ce5d08b-1e70-41be-9e49-3ad9c30fcc4e"],
 ". The time planes express Lorentz boosts and the pure-space planes express \
ordinary 3D rotations. "
}], "Text",
 CellChangeTimes->{{3.9795535307475348`*^9, 3.979553654069278*^9}, {
  3.9795548351249247`*^9, 3.979555021588521*^9}, {3.9795680418978167`*^9, 
  3.9795680548559933`*^9}, {3.979568670851356*^9, 3.9795687107949467`*^9}, {
  3.979569009865305*^9, 3.979569021752182*^9}, {3.979569091371476*^9, 
  3.9795690954642353`*^9}, {3.9795691388349323`*^9, 3.979569178612823*^9}, {
  3.9795700450594053`*^9, 3.9795700718701363`*^9}, {3.979577071061002*^9, 
  3.979577080219521*^9}},ExpressionUUID->"19ce9a19-bbbe-4a62-ab0f-\
3fb823e76695"],

Cell[TextData[{
 "Map numerical index pairs to a single index ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "=", 
    RowBox[{
    "1", "\[VeryThinSpace]", ".", "\[VeryThinSpace]", ".", "\[VeryThinSpace]",
      "6"}]}], TraditionalForm]],ExpressionUUID->
  "2b60c48f-beca-441c-835b-0360ad6fbd4f"],
 " for a ",
 StyleBox["Petrov Matrix",
  FontSlant->"Italic"],
 ". Measure here the expression complexity for maps from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"c", ",", "d"}], "}"}], TraditionalForm]],ExpressionUUID->
  "41f364d6-3c1d-4b62-9971-3c3b7c15efe4"],
 " loop-plane columns to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"a", ",", "b"}], "}"}], TraditionalForm]],ExpressionUUID->
  "186fa0a4-fd23-45f7-9d31-b7a4a611fe94"],
 " rotation-plane rows."
}], "Text",
 CellChangeTimes->{{3.9795535307475348`*^9, 3.979553654069278*^9}, {
  3.9795548351249247`*^9, 3.979555021588521*^9}, {3.9795680418978167`*^9, 
  3.9795680548559933`*^9}, {3.979568670851356*^9, 3.9795687107949467`*^9}, {
  3.979569009865305*^9, 3.979569021752182*^9}, {3.979569091371476*^9, 
  3.9795690954642353`*^9}, {3.9795691388349323`*^9, 3.979569178612823*^9}, {
  3.9795700450594053`*^9, 3.979570280871728*^9}, {3.979577095142*^9, 
  3.979577184718041*^9}},ExpressionUUID->"ba93efe7-487c-4de9-be75-\
3d65f36d1566"],

Cell[TextData[{
 "Diagonal skyscrapers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["R", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"1", "\[VeryThinSpace]", "1"}]}]]}], TraditionalForm]],
  ExpressionUUID->"1d97da27-e178-4714-9e95-d8a6764aed6b"],
 "\:200b, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"4", "\[VeryThinSpace]", "4"}]}]], TraditionalForm]],
  ExpressionUUID->"f0773abd-45c3-4537-bd1e-19ff08791f47"],
 "\:200b, etc.) represent \[OpenCurlyDoubleQuote]Gaussian curvature.\
\[CloseCurlyDoubleQuote] Walking a test vector in a circle in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"c", ",", "d"}], "}"}], TraditionalForm]],ExpressionUUID->
  "8fbae187-18a3-4887-91c1-f566c86be433"],
 " plane rotates the vector within that same ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"c", ",", "d"}], "}"}], TraditionalForm]],ExpressionUUID->
  "d09f192d-548d-4aaa-9d04-dbaa26b18efd"],
 " plane. This is the simple gravity we understand intuitively. Here is this \
Petrov visualization of our diagonal Schwarzschild ansatz:"
}], "Text",
 CellChangeTimes->{{3.9795535307475348`*^9, 3.979553652160233*^9}, {
   3.979568720361265*^9, 3.9795688163418293`*^9}, {3.979568900397077*^9, 
   3.979568908463399*^9}, {3.9795691085224857`*^9, 3.979569130437944*^9}, 
   3.9795693730715637`*^9, {3.979569416166247*^9, 3.979569448282724*^9}, {
   3.979570290409205*^9, 3.979570309067726*^9}, {3.9795772005545397`*^9, 
   3.97957724402359*^9}},ExpressionUUID->"c07bca48-dd3e-4ead-ad32-\
fef26e61b77e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"petrovRiemannViz", "[", "R_", "]"}], ":=", "\[IndentingNewLine]", 
   
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"bivectorMap", "=", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], "->", "1"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "3"}], "}"}], "->", "2"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "4"}], "}"}], "->", "3"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}], "->", "4"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "4"}], "}"}], "->", "5"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"3", ",", "4"}], "}"}], "->", "6"}]}], "|>"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"petrovMatrix", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "6"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", "expr", ",", "val", ",", "row", ",", "col"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"expr", "=", 
             RowBox[{"R", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "]"}], "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"val", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"PossibleZeroQ", "[", "expr", "]"}], ",", "0", ",", 
               RowBox[{"LeafCount", "[", "expr", "]"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"row", "=", 
             RowBox[{"bivectorMap", "[", 
              RowBox[{"Sort", "[", 
               RowBox[{"{", 
                RowBox[{"i", ",", "j"}], "}"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"col", "=", 
             RowBox[{"bivectorMap", "[", 
              RowBox[{"Sort", "[", 
               RowBox[{"{", 
                RowBox[{"k", ",", "l"}], "}"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"petrovMatrix", "[", 
              RowBox[{"[", 
               RowBox[{"row", ",", "col"}], "]"}], "]"}], "+=", 
             RowBox[{"Abs", "[", "val", "]"}]}], ";"}], ")"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"l", ",", 
            RowBox[{"k", "+", "1"}], ",", "4"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"i", "+", "1"}], ",", "4"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"DiscretePlot3D", "[", 
       RowBox[{
        RowBox[{"petrovMatrix", "[", 
         RowBox[{"[", 
          RowBox[{"row", ",", "col"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"row", ",", "1", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"col", ",", "1", ",", "6"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ExtentSize", "->", "0.8"}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Row (ab)\>\"", ",", "\"\<Col (cd)\>\"", 
           ",", "\"\<Leaf Count\>\""}], "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
        "PlotLabel", "->", "\"\<6x6 Schwarzschild Riemann Structure\>\""}]}], 
       "]"}]}]}], "]"}]}], ";"}], "\n", 
