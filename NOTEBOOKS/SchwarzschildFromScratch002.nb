Cell[BoxData[
 RowBox[{
  TagBox["\<\"\\!\\(\\*SubscriptBox[SuperscriptBox[\\(R\\), \\(\
\[VeryThinSpace]\\(r\\)\\)], \\(\[VeryThinSpace]\\(t\[VeryThinSpace]t\
\[VeryThinSpace]r\\)\\)]\\) =\"\>",
   "EchoLabel"], "  ", 
  FractionBox[
   RowBox[{
    RowBox[{
     RowBox[{"A", "[", "r", "]"}], " ", 
