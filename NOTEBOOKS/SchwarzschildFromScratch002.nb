Cell["\<\
Top-left blocks represent tidal forces (boosts caused by boosts). \
Bottom-right blocks represent spatial curvature. Off-diagonal towers in the \
Kerr metric indicate that the black hole\[CloseCurlyQuote]s rotation entwines \
these two sectors.\
\>", "Text",
 CellChangeTimes->{{3.9795535307475348`*^9, 3.979553647527179*^9}, 
   3.979569534149817*^9, {3.979569567041625*^9, 3.979569639265448*^9}, {
   3.979570408410437*^9, 
   3.9795705206082*^9}},ExpressionUUID->"624ca554-f031-4b37-bc5e-\
6c3a6cd26af3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemann Indexer", "Subsubsection",
 CellChangeTimes->{{3.978195805323048*^9, 
  3.978195809254114*^9}},ExpressionUUID->"2329895a-e718-4ae8-96bb-\
0ddaf72add34"],

Cell["\<\
As with \[CapitalGamma], index Riemann via coordinate symbols. Look at a \
couple of components and check a famous antisymmetry condition:\
\>", "Text",
 CellChangeTimes->{{3.978195814353423*^9, 3.978195893642148*^9}, 
   3.9782164619888687`*^9, {3.978216526474206*^9, 3.978216527130972*^9}, {
   3.9782232288965597`*^9, 3.978223229091755*^9}, 
   3.9795774803080397`*^9},ExpressionUUID->"bf99a8d1-8b31-4258-aa52-\
70af0def6baa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"RGet", "=", 
       RowBox[{"MakeIndexer", "[", 
        RowBox[{"SchwRiemann", ",", "coords"}], "]"}]}], ")"}], "[", 
     RowBox[{"t", ",", "r", ",", "t", ",", "r"}], "]"}], 
    ",", "\"\<\!\(\*SubscriptBox[SuperscriptBox[\(R\), \
\(\[VeryThinSpace]\(t\)\)], \(\[VeryThinSpace]\(r\[VeryThinSpace]t\
\[VeryThinSpace]r\)\)]\) =\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.978044016993494*^9, 3.9780440739657497`*^9}, 
   3.978044106606051*^9, {3.978044303433508*^9, 3.978044377866229*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"6338e65a-d99d-43ae-a67c-2d3a9d9a8e05"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"\\!\\(\\*SubscriptBox[SuperscriptBox[\\(R\\), \\(\
\[VeryThinSpace]\\(t\\)\\)], \\(\[VeryThinSpace]\\(r\[VeryThinSpace]t\
\[VeryThinSpace]r\\)\\)]\\) =\"\>",
   "EchoLabel"], "  ", 
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"A", "[", "r", "]"}], " ", 
      RowBox[{
       SuperscriptBox["A", "\[Prime]",
        MultilineFunction->None], "[", "r", "]"}], " ", 
      RowBox[{
       SuperscriptBox["B", "\[Prime]",
        MultilineFunction->None], "[", "r", "]"}]}], "+", 
     RowBox[{
      RowBox[{"B", "[", "r", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{
          SuperscriptBox["A", "\[Prime]",
           MultilineFunction->None], "[", "r", "]"}], "2"], "-", 
        RowBox[{"2", " ", 
         RowBox[{"A", "[", "r", "]"}], " ", 
         RowBox[{
          SuperscriptBox["A", "\[Prime]\[Prime]",
           MultilineFunction->None], "[", "r", "]"}]}]}], ")"}]}]}], 
    RowBox[{"4", " ", 
     SuperscriptBox[
      RowBox[{"A", "[", "r", "]"}], "2"], " ", 
     RowBox[{"B", "[", "r", "]"}]}]]}]}]], "Echo",
 CellChangeTimes->{
  3.979577496972*^9},ExpressionUUID->"ce3581bf-4733-4614-87cf-10334b4a5f3e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"RGet", "[", 
     RowBox[{"t", ",", "r", ",", "r", ",", "t"}], "]"}], 
    ",", "\"\<\!\(\*SubscriptBox[SuperscriptBox[\(R\), \
