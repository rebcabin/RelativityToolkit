Cell[TextData[{
 "Off-diagonal skyscrapers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["R", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"1", "\[VeryThinSpace]", "4"}]}]]}], TraditionalForm]],
  ExpressionUUID->"47b9a23c-3aca-4f08-9215-38ce460fd1d4"],
 "\:200b, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"R", "\[VeryThinSpace]"}], 
    RowBox[{"\[VeryThinSpace]", "26"}]], TraditionalForm]],ExpressionUUID->
  "d4add2dd-c4a7-4124-b999-9a635e8c9e1a"],
 "\:200b, etc.) represent \[OpenCurlyDoubleQuote]gravitomagnetism\
\[CloseCurlyDoubleQuote] or the frame dragging of Kerr spacetime, covered in ",
 StyleBox[ButtonBox["another notebook",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3636508?p_p_auth=\
HAIPAGn8"], None},
  ButtonNote->
   "https://community.wolfram.com/groups/-/m/t/3636508?p_p_auth=HAIPAGn8"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 ". It says, for example: \[OpenCurlyDoubleQuote]If I walk my vector around \
in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}], TraditionalForm]],ExpressionUUID->
  "344c343d-ec97-4fd5-bdd0-1bdea85d75b3"],
 " plane, it gets twisted into the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"t", ",", "z"}], "}"}], TraditionalForm]],ExpressionUUID->
  "e5e49c93-c59c-4691-9413-0ab40a50e436"],
 " plane.\[CloseCurlyDoubleQuote] Notice the much larger leaf counts. Kerr is \
much more complicated than Schwarzschild."
}], "Text",
 CellChangeTimes->{{3.9795535307475348`*^9, 3.979553649905221*^9}, {
   3.979568808094417*^9, 3.979568821509967*^9}, {3.979568857793172*^9, 
   3.979568920101242*^9}, {3.979569191875393*^9, 3.979569289894388*^9}, 
   3.979569466432396*^9, {3.97957033352197*^9, 3.979570381469529*^9}, {
   3.979577267146639*^9, 3.9795772705602627`*^9}, {3.979577304574679*^9, 
