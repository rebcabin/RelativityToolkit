 CellLabel->"In[11]:=",ExpressionUUID->"90fd7d66-9943-44bd-a5fd-3e5a32e058fd"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Schw Inv rules :\"\>",
   "EchoLabel"], "  ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"gUU", 
      SuperscriptBox["", "t"], 
      SuperscriptBox["", "t"]}], "\[Rule]", 
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"A", "[", "r", "]"}]]}]}], ",", 
    RowBox[{
     RowBox[{"gUU", 
      SuperscriptBox["", "r"], 
      SuperscriptBox["", "r"]}], "\[Rule]", 
     FractionBox["1", 
      RowBox[{"B", "[", "r", "]"}]]}], ",", 
    RowBox[{
