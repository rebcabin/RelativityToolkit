   RowBox[{
    RowBox[{"SchwA", "=", 
     RowBox[{"DSolve", "[", 
      RowBox[{"finalODE", ",", 
       RowBox[{"A", "[", "r", "]"}], ",", "r"}], "]"}]}], 
    ",", "\"\<Schwarzschild Solution :\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.978049490595441*^9, 3.978049733222826*^9}, {
  3.9782202351268806`*^9, 3.9782202408296843`*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"d2d127aa-0816-4550-913a-bf71b2736cb1"],

