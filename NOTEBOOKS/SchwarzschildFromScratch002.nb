Cell[CellGroupData[{

Cell["Abstract", "Section",
 CellChangeTimes->{{3.978187910540496*^9, 
  3.978187912278749*^9}},ExpressionUUID->"33c3f0d0-1171-43a6-90a0-\
b3cbb8c245b9"],

Cell["\<\
The question to answer in this notebook is \[OpenCurlyDoubleQuote]what is the \
vacuum spacetime geometry outside a static, spherically symmetric, \
non-spinning black hole?\[CloseCurlyDoubleQuote]\
\>", "Text",
 CellChangeTimes->{{3.977916263698444*^9, 3.97791628883779*^9}, {
  3.9781909856055193`*^9, 3.978191001693035*^9}, {3.9782179519841223`*^9, 
  3.9782179552245293`*^9}, {3.978222449284503*^9, 3.9782224528302402`*^9}, {
  3.979575469994673*^9, 
  3.9795754727599792`*^9}},ExpressionUUID->"03eedb6c-646f-4c24-bbdb-\
524192631ebb"],

Cell[TextData[{
 "The Schwarzschild metric is the answer. In this notebook, we derive it ",
 StyleBox["ab-initio",
  FontSlant->"Italic"],
 ". The derivation is certainly not novel, but the novel contribution here is \
advancement of the \[ScriptCapitalU]\[ScriptCapitalD] calculus, moving its \
compiler from proof-of-concept to prototype. This metric is demonstrated in \
another notebook, ",
 StyleBox[ButtonBox["Interactive black hole dynamics: Schwarzschild orbits \
via UD calculus",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3632176?p_p_auth=\
HAIPAGn8"], None},
  ButtonNote->
   "https://community.wolfram.com/groups/-/m/t/3632176?p_p_auth=HAIPAGn8"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 "."
}], "Text",
 CellChangeTimes->{
  3.977513712847348*^9, {3.9775178669407883`*^9, 3.977517959906126*^9}, {
   3.977517996418476*^9, 3.977518072452635*^9}, {3.9775181219359083`*^9, 
   3.977518224156801*^9}, {3.9775359524035*^9, 3.977536075585163*^9}, {
   3.97753737910937*^9, 3.977537384309*^9}, {3.97764405920399*^9, 
   3.977644347525126*^9}, {3.977672253563974*^9, 3.977672266570442*^9}, {
   3.977678754525832*^9, 3.977678800149303*^9}, {3.977746420549296*^9, 
   3.977746648340251*^9}, {3.977915629794395*^9, 3.9779156364877872`*^9}, {
   3.977915706330698*^9, 3.977915719172121*^9}, {3.9781876022023067`*^9, 
   3.978187616921665*^9}, {3.978187782697919*^9, 3.978187820554805*^9}, {
   3.9781879304464903`*^9, 3.978187931982128*^9}, {3.978222249151208*^9, 
