      SuperscriptBox["", "\[Phi]"], 
      SuperscriptBox["", "\[Phi]"]}], "\[Rule]", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"], 
      SuperscriptBox["r", "2"]]}]}], "}"}]}]], "Echo",
 CellChangeTimes->{
  3.979576556151441*^9},ExpressionUUID->"6d90a8af-4289-4737-a639-\
03896b9df026"]
