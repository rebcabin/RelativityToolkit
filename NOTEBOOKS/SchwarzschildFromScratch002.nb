Cell[TextData[{
 StyleBox["Note, if you call ",
  FontSlant->"Italic"],
 StyleBox["Quit", "Input"],
 StyleBox[" in a notebook, evaluation may hang. If you want to \
\[OpenCurlyDoubleQuote]Evaluate Notebook,\[CloseCurlyDoubleQuote] mark the \
following two cells \
\[OpenCurlyDoubleQuote]Evaluatable\[CloseCurlyDoubleQuote]  in the Cell",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["->", TraditionalForm]],ExpressionUUID->
  "8e358f70-abee-436b-8076-e0df0a311810"],
 StyleBox["Property menu, call ",
  FontSlant->"Italic"],
 StyleBox["Quit", "Input"],
 StyleBox[" and ",
  FontSlant->"Italic"],
 StyleBox["FrontEndTokenExecute", "Input"],
 StyleBox[" once each, then comment out the cells, or mark them unevaluatable \
again. Alternatively, you can quit the kernel via the Evaluation menu (last \
item). At that point, you can \[OpenCurlyDoubleQuote]Evaluate Notebook\
\[CloseCurlyDoubleQuote] in a clean environment. Otherwise, you can evaluate \
cells in this notebook individually.",
  FontSlant->"Italic"]
}], "Item",
