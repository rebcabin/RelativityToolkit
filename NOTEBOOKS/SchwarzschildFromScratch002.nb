29fd335ad6a1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Ansatz", "Section",
 CellChangeTimes->{{3.977916246773687*^9, 
  3.977916252253207*^9}},ExpressionUUID->"3c8c91ea-e899-49bc-91fa-\
1ad35b9a116b"],

Cell["\<\
Set up a coordinate system in flat spacetime, at a safe distance from the \
central black hole, but with origin at the center of the black hole. Measure \
all events with respect to this coordinate system. Solutions of equations of \
motion with respect to proper time account for spacetime curvature.\
\>", "Text",
 CellChangeTimes->{{3.97819106217358*^9, 3.978191124805711*^9}, {
  3.978191461600265*^9, 3.9781914855396347`*^9}, {3.978192096622428*^9, 
  3.9781921300750027`*^9}, {3.978218105985491*^9, 3.978218146350388*^9}, {
  3.978218239011086*^9, 3.9782182459332542`*^9}, {3.978222611908587*^9, 
  3.978222630425633*^9}, {3.9793368941934834`*^9, 3.97933691634901*^9}, {
  3.979576341931264*^9, 
  3.979576356592394*^9}},ExpressionUUID->"5af30864-89fc-4a2c-94bf-\
b8f03c43dda7"],

Cell[TextData[{
 "Assume as a guess, or ",
 StyleBox["ansatz, ",
  FontSlant->"Italic"],
 "the following form for an element of proper distance along a geodesic:"
}], "Text",
 CellChangeTimes->{{3.977916295785714*^9, 3.9779163100778646`*^9}, {
   3.978099170159231*^9, 3.978099171269863*^9}, {3.978099205230735*^9, 
   3.978099205727705*^9}, {3.978190623316001*^9, 3.978190636959577*^9}, {
   3.9781909384235992`*^9, 3.978190974111395*^9}, 
   3.9781915778900423`*^9},ExpressionUUID->"86cd0607-aad6-4c1c-8716-\
42093dc838bf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"d", "\[VeryThinSpace]", 
    SuperscriptBox["s", 
     RowBox[{" ", "2"}]]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "A"}], 
      RowBox[{"(", "r", ")"}], "d", "\[VeryThinSpace]", 
      SuperscriptBox["t", 
       RowBox[{"\[VeryThinSpace]", "2"}]]}], "+", 
     RowBox[{"B", 
      RowBox[{"(", "r", ")"}], "d", "\[VeryThinSpace]", 
      SuperscriptBox["r", 
       RowBox[{"\[VeryThinSpace]", "2"}]]}], "+", 
     RowBox[{
      SuperscriptBox["r", 
       RowBox[{"\[VeryThinSpace]", "2"}]], "d", "\[VeryThinSpace]", 
      SuperscriptBox["\[Theta]", 
       RowBox[{"\[VeryThinSpace]", "2"}]]}], "+", 
     RowBox[{
      SuperscriptBox["r", 
       RowBox[{"\[VeryThinSpace]", "2"}]], 
      RowBox[{
       SuperscriptBox["sin", "2"], "(", "\[Theta]", ")"}], " ", "d", "\[VeryThinSpace]", 
      SuperscriptBox["\[Phi]", 
       RowBox[{"\[VeryThinSpace]", "2"}]]}]}], "\[Congruent]", 
    "\[LineSeparator]", 
    RowBox[{
     RowBox[{
      SubscriptBox["g", 
       RowBox[{"\[VeryThinSpace]", 
        RowBox[{"t", "\[VeryThinSpace]", "t"}]}]], "d", "\[VeryThinSpace]", 
      SuperscriptBox["t", 
       RowBox[{"\[VeryThinSpace]", "2"}]]}], "+", 
     RowBox[{
      SubscriptBox["g", 
       RowBox[{"\[VeryThinSpace]", 
        RowBox[{"r", "\[VeryThinSpace]", "r"}]}]], "d", "\[VeryThinSpace]", 
      SuperscriptBox["r", 
       RowBox[{"\[VeryThinSpace]", "2"}]]}], "+", 
     RowBox[{
      SubscriptBox["g", 
       RowBox[{"\[VeryThinSpace]", 
        RowBox[{"\[Theta]", "\[VeryThinSpace]", "\[Theta]"}]}]], "d", "\[VeryThinSpace]", 
      SuperscriptBox["\[Theta]", 
       RowBox[{"\[VeryThinSpace]", "2"}]]}], "+", 
     RowBox[{
      SubscriptBox["g", 
       RowBox[{"\[VeryThinSpace]", 
        RowBox[{"\[Phi]", "\[VeryThinSpace]", "\[Phi]"}]}]], "d", "\[VeryThinSpace]", 
      SuperscriptBox["\[Phi]", 
       RowBox[{"\[VeryThinSpace]", "2"}]]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977916323565331*^9, 3.9779164571988707`*^9}, {
  3.977916518780223*^9, 3.977916535636404*^9}, {3.977916610920299*^9, 
  3.9779167496613283`*^9}, {3.978045504706258*^9, 
  3.978045510734001*^9}},ExpressionUUID->"213b58b5-4fde-4928-a243-\
61f6417ebe60"],

Cell[TextData[{
 "with two unknown functions of radius, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "(", "r", ")"}], TraditionalForm]],ExpressionUUID->
  "6dda3693-af88-459b-b0e0-38710f7d18d1"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "(", "r", ")"}], TraditionalForm]],ExpressionUUID->
  "0230c513-e32f-47a7-8217-90fa7ab8f973"],
 ", and with symbolic coordinates, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", ",", " ", "r", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], 
   TraditionalForm]],ExpressionUUID->"d400aad6-d278-40b2-9ec1-d334e6d71595"],
 ", all assumed to be functions of proper time, \[Tau], the time experienced \
by a particle in free-fall on a geodesic. Notice these functions do not \
depend on the angle coordinates \[Theta] and \[Phi]. That is the meaning of \
\[OpenCurlyDoubleQuote]spherically symmetric.\[CloseCurlyDoubleQuote] They \
also do not depend on time, and that is the meaning of \
\[OpenCurlyDoubleQuote]static.\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{3.97819064600136*^9, 3.978190797478819*^9}, {
  3.97819089795123*^9, 3.978190916661297*^9}, {3.9781910117645073`*^9, 
  3.978191012205779*^9}, {3.978191587618043*^9, 3.9781916381208553`*^9}, {
  3.9782181632497*^9, 3.97821817961614*^9}, {3.97822264683989*^9, 
  3.978222669965879*^9}, {3.9793369509523363`*^9, 3.979336962474395*^9}, {
  3.9795763955607643`*^9, 
  3.97957641939778*^9}},ExpressionUUID->"03cfb319-aaea-4aff-9551-\
d4c1a926148c"],

Cell[CellGroupData[{

Cell["Covariant Metric Tensor", "Subsection",
 CellChangeTimes->{{3.978192158090149*^9, 
  3.978192167668303*^9}},ExpressionUUID->"b24d5cce-520f-4a76-8f9c-\
0fef5812a1fe"],

Cell[TextData[{
 "Express the covariant metric tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4fe10651-b64f-4291-8082-14c8aec3781f"],
 " of this ansatz as a diagonal matrix (Wolfram array); save the coordinates \
for later:"
}], "Text",
 CellChangeTimes->{{3.97819064600136*^9, 3.978190797478819*^9}, {
  3.97819089795123*^9, 3.978190916661297*^9}, {3.9781910117645073`*^9, 
  3.978191012205779*^9}, {3.978191587618043*^9, 3.978191631215666*^9}, {
  3.978192171321978*^9, 3.978192189951953*^9}, {3.978217998591794*^9, 
  3.978218002685255*^9}, {3.979576428705325*^9, 
  3.979576433737732*^9}},ExpressionUUID->"9e497488-b137-4ceb-ad63-\
97c163a6aaa7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"SchwAnsatz", "=", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"A", "[", "r", "]"}]}], ",", 
          RowBox[{"B", "[", "r", "]"}], ",", 
          SuperscriptBox["r", "2"], ",", 
          RowBox[{
           SuperscriptBox["r", "2"], 
           SuperscriptBox[
            RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], "}"}], "]"}]}], 
      ")"}], "//", "MatrixForm"}], ",", "\"\<Schw ansatz :\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"coords", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.977916813480853*^9, 3.977916826941023*^9}, {
   3.9779407308444233`*^9, 3.977940773866407*^9}, {3.97794082661156*^9, 
   3.977940939484643*^9}, 3.977941457585986*^9, {3.977941645311081*^9, 
   3.977941652043281*^9}, {3.977942092566986*^9, 3.977942100398808*^9}, {
   3.9779447081151657`*^9, 3.977944709680691*^9}, {3.977945319075341*^9, 
   3.977945326309247*^9}, 3.9779888441130342`*^9, {3.9780076892293797`*^9, 
   3.978007732449287*^9}, {3.9780077800160227`*^9, 3.978007837277759*^9}, {
   3.978007868330056*^9, 3.978007967053761*^9}, 3.9780080432740183`*^9, 
   3.9780081057016373`*^9, {3.978011018685891*^9, 3.97801102024509*^9}, {
   3.9781907845551023`*^9, 3.9781908826070423`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"d6e8e5f3-ff70-48df-8e45-424fe12c3997"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Schw ansatz :\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       RowBox[{"-", 
        RowBox[{"A", "[", "r", "]"}]}], "0", "0", "0"},
      {"0", 
       RowBox[{"B", "[", "r", "]"}], "0", "0"},
      {"0", "0", 
       SuperscriptBox["r", "2"], "0"},
      {"0", "0", "0", 
       RowBox[{
        SuperscriptBox["r", "2"], " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}], "\[NoBreak]", ")"}],
   Function[BoxForm`e$, 
    MatrixForm[BoxForm`e$]]]}]], "Echo",
 CellChangeTimes->{
  3.979576445444278*^9},ExpressionUUID->"7daa52aa-b5a4-42d3-9e06-\
658a6538c833"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Coordinate time, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "75608554-dc66-4d1d-b238-a096ef96c628"],
 StyleBox[", is also a function of proper time, expressing time dilation. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.978191033305602*^9, 3.978191054467911*^9}, {
   3.978191961238701*^9, 3.978191961239932*^9}, {3.978218014424025*^9, 
