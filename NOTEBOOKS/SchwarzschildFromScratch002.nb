 CellLabel->"In[21]:=",ExpressionUUID->"bcbdd95a-3fc3-4478-be08-11b732161364"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"\\!\\(\\*SubscriptBox[SuperscriptBox[\\(R\\), \\(\[Mu]\\)], \\(\
\[Lambda]\[Nu]\[Rho]\\)]\\) =\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{
              RowBox[{
               RowBox[{"A", "[", "r", "]"}], " ", 
               RowBox[{
                SuperscriptBox["A", "\[Prime]",
                 MultilineFunction->None], "[", "r", "]"}], " ", 
               RowBox[{
                SuperscriptBox["B", "\[Prime]",
                 MultilineFunction->None], "[", "r", "]"}]}], "+", 
              RowBox[{
               RowBox[{"B", "[", "r", "]"}], " ", 
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox[
                  RowBox[{
                   SuperscriptBox["A", "\[Prime]",
                    MultilineFunction->None], "[", "r", "]"}], "2"], "-", 
                 RowBox[{"2", " ", 
                  RowBox[{"A", "[", "r", "]"}], " ", 
                  RowBox[{
                   SuperscriptBox["A", "\[Prime]\[Prime]",
                    MultilineFunction->None], "[", "r", "]"}]}]}], ")"}]}]}], 
             
             RowBox[{"4", " ", 
              SuperscriptBox[
               RowBox[{"A", "[", "r", "]"}], "2"], " ", 
              RowBox[{"B", "[", "r", "]"}]}]]}], ",", "0", ",", "0"}], "}"}], 
         ",", 
