Cell[TextData[{
 "The functions developed in an earlier notebook, ",
 StyleBox[ButtonBox["Riemann Curvature in ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3627521?p_p_auth=\
HAIPAGn8"], None},
  ButtonNote->
   "https://community.wolfram.com/groups/-/m/t/3627521?p_p_auth=HAIPAGn8"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[ButtonBox["\[ScriptCapitalU]\[ScriptCapitalD]",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3627521?p_p_auth=\
HAIPAGn8"], None},
  ButtonNote->
   "https://community.wolfram.com/groups/-/m/t/3627521?p_p_auth=HAIPAGn8"],
  FontVariations->{"Underline"->True}],
 StyleBox[ButtonBox[" + Compiler POC",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3627521?p_p_auth=\
HAIPAGn8"], None},
  ButtonNote->
   "https://community.wolfram.com/groups/-/m/t/3627521?p_p_auth=HAIPAGn8"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 ", are captured in a new compiler function, ",
 StyleBox["ChristoffelsFromMetric", "Input",
  Background->RGBColor[1, 0.75, 0, 0.33]],
 ", which computes the required commutator of covariant derivatives. See it \
exposed here as an unevaluated contraction over a bound ",
 StyleBox["Unique", "Input"],
 " index:"
}], "Text",
 CellChangeTimes->{{3.9781925053629427`*^9, 3.978192522971711*^9}, {
   3.978192686763955*^9, 3.9781928505605173`*^9}, {3.978192907871084*^9, 
