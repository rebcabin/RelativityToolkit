Cell[CellGroupData[{

Cell["Solution Strategy", "Section",
 CellChangeTimes->{{3.978216916211404*^9, 
  3.9782169210318336`*^9}},ExpressionUUID->"dc2c306f-1f55-4a32-9e6b-\
641b31a22283"],

Cell[TextData[StyleBox["The story of Karl Schwarzschild\[CloseCurlyQuote]s \
solution of the Einstein field equations, presumably through a strategy \
similar to the following, while he was enlisted in the Prussian Army in WWI, \
almosts immediately after Einstein\[CloseCurlyQuote]s 1915 publication, is \
fascinating. ",
 FontSlant->"Plain"]], "Text",
 CellChangeTimes->{{3.978216932307979*^9, 3.978216949089439*^9}, {
  3.97821782834256*^9, 3.9782178640347652`*^9}, {3.978224264159258*^9, 
  3.978224381748638*^9}, {3.979575521906616*^9, 3.979575574481247*^9}, {
  3.979575611287724*^9, 3.9795756401360903`*^9}},
 FontSlant->"Italic",ExpressionUUID->"f515f095-0be4-43cf-8bba-d4e5d64a5e36"],

Cell[TextData[StyleBox["I was fortunate to have Schwarzschild\
\[CloseCurlyQuote]s son, Martin, as one of my advisors in graduate school.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.978216932307979*^9, 3.978216949089439*^9}, {
  3.97821782834256*^9, 3.9782178640347652`*^9}, {3.978224264159258*^9, 
  3.978224381748638*^9}, {3.979575521906616*^9, 
  3.97957555646141*^9}},ExpressionUUID->"b92ba8f0-f90c-4961-8232-\
207b2e200dfa"],

Cell[TextData[{
 "Guess at the form of the Schwarzschild metric, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  CellChangeTimes->{{3.978217047016574*^9, 3.9782170482571173`*^9}, {
   3.978217135471945*^9, 3.97821718881602*^9}, {3.978217223791347*^9, 
   3.978217251179163*^9}},ExpressionUUID->
  "220418ad-4b17-4a07-b28f-0c9a028f7d56"],
 ": that is, make an ",
 StyleBox["ansatz",
  FontSlant->"Italic"],
 "."
}], "ItemNumbered",
 CellChangeTimes->{{3.978216932307979*^9, 3.978216949089439*^9}, {
  3.97821782834256*^9, 3.9782178640347652`*^9}, {3.978224264159258*^9, 
  3.9782242785073643`*^9}, {3.9795755020455427`*^9, 3.979575506371224*^9}, {
  3.979575781885741*^9, 
  3.979575787903859*^9}},ExpressionUUID->"9d88d21c-9cd5-46cb-8dd7-\
4b371cbe0762"],

Cell[TextData[{
 "Grind this form through new compiler components to generate Christoffel \
symbols, the Riemann curvature tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["R", 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{
     "\[Lambda]", "\[VeryThinSpace]", "\[Nu]", "\[VeryThinSpace]", 
      "\[Rho]"}]}]], TraditionalForm]],ExpressionUUID->
  "44bc32e6-953a-4c95-aede-1978f76d1c87"],
 ", and the Ricci tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  ExpressionUUID->"733b41ab-9745-4d18-b404-92b33aa24ee0"],
 ", a specific contraction of Riemann."
}], "ItemNumbered",
 CellChangeTimes->{{3.978216953111328*^9, 3.978217025574943*^9}, {
  3.978217068290866*^9, 3.978217123789546*^9}, {3.978222480335887*^9, 
  3.978222514625066*^9}, {3.979575801197901*^9, 
  3.9795758013671513`*^9}},ExpressionUUID->"f0cd42ea-21da-4b26-9ccf-\
b3c40c762093"],

Cell["\<\
Consult the Einstein field equations (not derived in this notebook):\
\>", "ItemNumbered",
 CellChangeTimes->{{3.978217032279943*^9, 3.9782170439041643`*^9}, 
   3.978217350522852*^9, {3.978217920784711*^9, 
   3.978217936370317*^9}},ExpressionUUID->"0c31a1cf-ac9b-4d11-93fa-\
006af40fe952"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], "-", 
    RowBox[{
     FractionBox["1", "2"], "R", "\[VeryThinSpace]", 
     SubscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]]}]}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"8", "\[Pi]", "\[VeryThinSpace]", "G"}], 
     SuperscriptBox["c", "4"]], 
    SubscriptBox["T", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.978217047016574*^9, 3.9782170482571173`*^9}, {
  3.978217135471945*^9, 3.97821718881602*^9}, {3.978217223791347*^9, 
  3.978217251179163*^9}},ExpressionUUID->"6514984c-374c-4ee3-8171-\
f5c257377640"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],ExpressionUUID->
  "e949595e-2317-4b3d-8605-59b55da198e6"],
 " is the trace of Ricci, namely ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], 
    SubscriptBox["R", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]]}], TraditionalForm]],
  ExpressionUUID->"de095cbd-85bc-4da8-a9f9-aff483ec9e88"],
 "."
}], "ItemParagraph",
 CellChangeTimes->{{3.978217467257217*^9, 3.978217532074066*^9}, {
  3.978222533227947*^9, 3.978222536233389*^9}, {3.979575811812655*^9, 
  3.979575812664839*^9}},ExpressionUUID->"56de75e2-f220-496e-a04f-\
0f16fdfa6fbc"],

Cell[TextData[{
 "Set the Einstein equations equal to zero for the vacuum (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"f726ce40-a2ef-4ca7-8427-5881d1005776"],
 ", no stress-energy)."
}], "ItemNumbered",
 CellChangeTimes->{{3.978217257890685*^9, 3.9782172713477373`*^9}, {
   3.978217312450982*^9, 3.9782173174056187`*^9}, 3.9782173540879097`*^9, {
   3.9782175457468643`*^9, 
   3.978217579730043*^9}},ExpressionUUID->"aa5ba909-4c72-4211-85ba-\
938b9c329425"],

Cell[TextData[{
 "Contract the Einstein equations against ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  ExpressionUUID->"ee09e382-255b-4419-acc4-d8ce62cac7a0"],
 " to get the Ricci trace, ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b683a6a2-33c1-41e7-b78f-36f803455cf6"],
 ":"
}], "ItemNumbered",
 CellChangeTimes->{{3.978217344844315*^9, 3.978217424199491*^9}, {
   3.978217595295546*^9, 3.978217596201364*^9}, 3.978217917932048*^9, {
   3.978222579818718*^9, 3.9782225809463587`*^9}, {3.97957583047585*^9, 
   3.979575838596477*^9}},ExpressionUUID->"b1b17f04-fad4-4e74-9531-\
fc9a764f7132"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], 
     SubscriptBox["R", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]]}], "-", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"R", "(", 
      RowBox[{
       SuperscriptBox["g", 
        RowBox[{"\[VeryThinSpace]", 
         RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], 
       SubscriptBox["g", 
        RowBox[{"\[VeryThinSpace]", 
         RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]]}], ")"}]}]}], "=", 
   
   RowBox[{
    RowBox[{"R", "-", 
     RowBox[{
      FractionBox["1", "2"], "4", "R"}]}], "=", 
    RowBox[{
     RowBox[{"0", "\[DoubleLongRightArrow]", "R"}], "=", "0"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.978217608396626*^9, 3.978217681211887*^9}, {
  3.97821776157961*^9, 3.978217778163095*^9}, {3.978217882967985*^9, 
  3.978217901006652*^9}},ExpressionUUID->"31fe2ede-258a-41d7-86e4-\
7570bbd2ebb2"],

Cell["\<\
Substitute this back into the Einstein equations to deduce that the all \
components of Ricci vanish in the vacuum:\
\>", "ItemNumbered",
 CellChangeTimes->{{3.978217715324844*^9, 3.9782177452912083`*^9}, 
   3.97821791428238*^9, {3.978222597160797*^9, 3.978222597388047*^9}, {
   3.9793364676832027`*^9, 3.979336467943564*^9}, {3.979575847615958*^9, 
   3.979575864990481*^9}},ExpressionUUID->"5c225423-309d-425d-8e69-\
a038fd235814"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], "-", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", "0", ")"}], "\[VeryThinSpace]", 
     SubscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]]}]}], "=", 
   RowBox[{
    RowBox[{"0", "\[DoubleLongRightArrow]", 
     SubscriptBox["R", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]]}], "=", "0"}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.978217047016574*^9, 3.9782170482571173`*^9}, {
  3.978217135471945*^9, 3.97821718881602*^9}, {3.978217223791347*^9, 
  3.978217251179163*^9}, {3.978217788115917*^9, 
  3.978217814933079*^9}},ExpressionUUID->"bd75cdb9-c9af-4adf-9af6-\
1ef2225b0b2c"],

Cell["\<\
Derive an ODE for terms in the ansatz from vanishing Ricci components.\
\>", "ItemNumbered",
 CellChangeTimes->{{3.978224058856709*^9, 
  3.978224141194763*^9}},ExpressionUUID->"f308eea8-5917-475f-8435-\
938e2d868fd2"],

Cell["\<\
Invoke boundary conditions at infinity to solve the ODE, and invoke a \
Newtonian far-field approximation to evaluate constants of integration.\
\>", "ItemNumbered",
 CellChangeTimes->{{3.978224145175152*^9, 3.978224207059524*^9}, {
  3.9795758877240477`*^9, 
  3.979575896324307*^9}},ExpressionUUID->"a5ef06e5-6c82-4536-84e7-\
3e111b8f9dd4"],

Cell["Compare against Wolfram\[CloseCurlyQuote]s stored resource.", \
"ItemNumbered",
 CellChangeTimes->{{3.978224210060697*^9, 3.9782242503571873`*^9}, {
  3.979575903285584*^9, 
  3.9795759042037086`*^9}},ExpressionUUID->"a33d18e9-e263-4401-8baf-\
87ff78fec0db"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Introducing New Compiler Functions", "Section",
 CellChangeTimes->{{3.978215211558666*^9, 3.978215217736579*^9}, {
  3.978215256463418*^9, 
  3.978215258586466*^9}},ExpressionUUID->"486662a8-cf98-46c0-8e30-\
822a9512c6b0"],

Cell["\<\
We have enhanced \[ScriptCapitalU]\[ScriptCapitalD] with several new \
functions in service of this task. The following sketches their \
functionality, and the rest of the notebook illustrates their use by example. \
These functions are general; they apply to other problems in general \
relativity and differential geometry.\
\>", "Text",
 CellChangeTimes->{{3.978224402203388*^9, 3.9782244940026903`*^9}, {
  3.9793365320301733`*^9, 3.979336532180593*^9}, {3.979575930190751*^9, 
  3.9795759413508797`*^9}},ExpressionUUID->"4d4f9261-8ea9-4027-978b-\
de1868dd1b85"],

Cell[TextData[{
 "In this notebook, \[OpenCurlyDoubleQuote]matrix\[CloseCurlyDoubleQuote] is \
a synonym for a Wolfram 2D array. A ",
 StyleBox["tensor",
  FontSlant->"Italic"],
 " is either a matrix or a collection of symbolic \[ScriptCapitalU]\
\[ScriptCapitalD] expressions that satisfy coordinate-transformation rules."
}], "Text",
 CellChangeTimes->{{3.978225091165732*^9, 3.978225175875058*^9}, {
  3.979575955191423*^9, 
  3.9795759652367077`*^9}},ExpressionUUID->"d27f0b30-b457-46b8-b532-\
aaf66f4bf80e"],

Cell[TextData[StyleBox["MatrixToUDRules", "Input",
 Background->RGBColor[1, 0.75, 0, 0.33]]], "Text",
 CellChangeTimes->{
  3.978215231246804*^9},ExpressionUUID->"ac450311-58f7-42c3-b1d9-\
6aa5d997d9bb"],

Cell[TextData[{
 "Converts the non-zero elements of a matrix of components into rules for \
later application via ",
 StyleBox["Replace", "Input"],
 " and ",
 StyleBox["ReplaceAll", "Input"],
 " to symbolic expressions in \[ScriptCapitalU]\[ScriptCapitalD]."
}], "ItemParagraph",
 CellChangeTimes->{{3.9782245231480007`*^9, 3.978224579524329*^9}, {
  3.978224786093027*^9, 3.978224793128354*^9}, {3.979336557813528*^9, 
  3.979336585336741*^9}, {3.9795759903172483`*^9, 
  3.979575999016447*^9}},ExpressionUUID->"4378eae2-73a0-4a5e-b310-\
c48206ff4231"],

Cell[TextData[StyleBox["ChristoffelsFromMetric", "Input",
 Background->RGBColor[1, 0.75, 0, 0.33]]], "Text",
 CellChangeTimes->{
  3.978215251305468*^9},ExpressionUUID->"cdd73564-122c-42eb-a04d-\
cfe6c7eb433a"],

