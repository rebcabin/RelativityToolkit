Cell[CellGroupData[{

Cell["Optional: Configure Relativity Connection Symbol", "Subsection",
 CellChangeTimes->{{3.9775176800467176`*^9, 3.977517685457151*^9}, {
  3.977644427456564*^9, 3.9776444329596653`*^9}, {3.978190322678969*^9, 
  3.978190326009997*^9}},ExpressionUUID->"fd562242-cb5f-4257-94c4-\
9c3dcffe6af8"],

Cell["\<\
To properly compose covariant derivatives, \[ScriptCapitalU]\[ScriptCapitalD] \
must know the user\[CloseCurlyQuote]s reserved symbols for non-tensorial \
objects like connection coefficients. In gravitational physics, these \
force-producing connections are called \[CapitalGamma] (capital gamma). Other \
theories like electrodynamics and Yang-Mills use other connection symbols. \
\>", "Text",
 CellChangeTimes->{{3.977517690693409*^9, 3.9775178232519913`*^9}, {
   3.97751956997919*^9, 3.9775195720756073`*^9}, {3.9775280931539383`*^9, 
   3.977528124823065*^9}, {3.977535721478539*^9, 3.977535724386561*^9}, {
   3.9776444438816977`*^9, 3.977644712294363*^9}, {3.9777468389285183`*^9, 
   3.977747007351509*^9}, {3.977747054921603*^9, 3.9777470563202457`*^9}, 
   3.977923979142524*^9, {3.9781903456478357`*^9, 3.978190348264758*^9}, {
   3.979575451615543*^9, 
   3.97957545387885*^9}},ExpressionUUID->"860dae44-cbbe-4334-bee0-\
eb8dbe58ad65"],

Cell["\<\
We\[CloseCurlyQuote]re going with \[CapitalGamma] for this \
relativity/gravitation notebook, it\[CloseCurlyQuote]s the default, so the \
following cell is optional.\
\>", "Text",
 CellChangeTimes->{{3.977517690693409*^9, 3.9775178232519913`*^9}, {
  3.97751956997919*^9, 3.9775195720756073`*^9}, {3.9775280931539383`*^9, 
  3.977528124823065*^9}, {3.977535721478539*^9, 3.977535724386561*^9}, {
  3.9776444438816977`*^9, 3.977644762630517*^9}, {3.977747016178646*^9, 
  3.97774702870907*^9}, {3.9782240035291348`*^9, 
  3.97822401998591*^9}},ExpressionUUID->"6412f41d-f02b-4a24-b243-\
19b7651c936f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SetConnection", "[", "\[CapitalGamma]", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9775137220895033`*^9, 3.977513731036991*^9}, {
   3.9775149251253233`*^9, 3.9775149333295393`*^9}, 3.9775150554680758`*^9, 
   3.977517830816463*^9, 3.97791623964545*^9},
 CellLabel->
  "In[211]:=",ExpressionUUID->"2b33fb69-f8c2-48fe-a7a1-6d53867f0567"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Relativity Engine: Connection set to \"\>", "\[InvisibleSpace]",
    "\[CapitalGamma]"}],
  SequenceForm[
  "Relativity Engine: Connection set to ", $CellContext`\[CapitalGamma]],
  Editable->False]], "Print",
 CellChangeTimes->{3.979336696563699*^9, 3.9795526473856077`*^9},
