c01943e728be"],

Cell["\<\
Here are the promised extra rules to zero-out the off-diagonal components:\
\>", "Text",
 CellChangeTimes->{{3.978194095934067*^9, 3.9781941454755077`*^9}, 
   3.9781945042664824`*^9, {3.978218410495751*^9, 3.978218490967349*^9}, {
   3.978218535129129*^9, 3.978218546507245*^9}, {3.97821857750417*^9, 
   3.978218612406003*^9}, {3.9782186861488647`*^9, 3.978218703662657*^9}, {
   3.978218786392024*^9, 3.978218813433014*^9}, {3.978222991496331*^9, 
   3.978223087012775*^9}, {3.978226901095517*^9, 3.978226935451626*^9}, {
   3.979576721365117*^9, 
   3.979576728599872*^9}},ExpressionUUID->"b742c509-f111-43da-9faa-\
3e34a45f8127"],

Cell[BoxData[
 RowBox[{
  RowBox[{"offDiagonalRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"gUU", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalU]", "[", "a_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalU]", "[", "b_", "]"}]}], "]"}], "/;", 
       RowBox[{"a", "=!=", "b"}]}], "->", "0"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"gDD", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "a_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "b_", "]"}]}], "]"}], "/;", 
       RowBox[{"a", "=!=", "b"}]}], "->", "0"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.978011280184704*^9, 3.978011369019741*^9}, {
  3.9780114357258368`*^9, 3.978011544372802*^9}, {3.9781941527910833`*^9, 
  3.978194154440064*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"08f8f69c-57f4-412f-8423-6b485d8a0efe"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Recall that MatrixToUDRules does not currently do \
this, for practical reasons.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.978226950639677*^9, 
  3.978226971084722*^9}},ExpressionUUID->"d16c6144-a24c-435b-a058-\
e9fbc7db3dd5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[CapitalGamma]rttY", "=", "\[CapitalGamma]rttX"}], ")"}], "/.",
      "offDiagonalRules"}], 
    ",", "\"\<\!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalGamma]\), \(\
\[VeryThinSpace]\(r\)\)], \(\[VeryThinSpace]\(t\[VeryThinSpace]t\)\)]\) diag \
only =\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.978194157326106*^9, 3.978194245299264*^9}, {
  3.978194934583906*^9, 3.978194956781788*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"5368b34e-26f5-4887-a60d-c05b174cb02e"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"\\!\\(\\*SubscriptBox[SuperscriptBox[\\(\[CapitalGamma]\\), \\(\
\[VeryThinSpace]\\(r\\)\\)], \
\\(\[VeryThinSpace]\\(t\[VeryThinSpace]t\\)\\)]\\) diag only =\"\>",
   "EchoLabel"], "  ", 
  RowBox[{
   FractionBox[
    SubscriptBox["0", 
     RowBox[{",", "t"}]], 
    RowBox[{"B", "[", "r", "]"}]], "-", 
   FractionBox[
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{"-", 
       RowBox[{"A", "[", "r", "]"}]}], ")"}], 
     RowBox[{",", "r"}]], 
    RowBox[{"2", " ", 
     RowBox[{"B", "[", "r", "]"}]}]]}]}]], "Echo",
 CellChangeTimes->{
  3.979576735761058*^9},ExpressionUUID->"8d5f4ee3-f7e3-433f-8318-\
74a197bc1e7a"]
}, Open  ]]
}, Open  ]],

Cell["\<\
Notice, again, the unevaluated derivatives. \
\[ScriptCapitalU]\[ScriptCapitalD] doesn\[CloseCurlyQuote]t evaluate \
derivatives until you tell it to do so.\
\>", "Text",
 CellChangeTimes->{{3.9781949799309473`*^9, 3.9781950163927*^9}, {
  3.9782157703729143`*^9, 3.978215779964368*^9}, {3.97821588561873*^9, 
  3.9782158866600037`*^9}},ExpressionUUID->"3c711b5f-72d9-4b26-a2a6-\
5a80ebef070b"],

Cell[TextData[{
 StyleBox["Killing the off-diagonal terms is not strictly necessary in this \
step as the next function, ",
  FontSlant->"Italic"],
 StyleBox["EvaluateUDPartials", "Input"],
 StyleBox[", would have zeroed them out anyway. But it\[CloseCurlyQuote]s \
conceptually cleaner this way.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9781945523058147`*^9, 3.978194592792253*^9}, {
  3.978194840675086*^9, 3.9781948428342867`*^9}, {3.978195027330606*^9, 
  3.978195036143456*^9}, {3.978700778374394*^9, 
  3.978700785025764*^9}},ExpressionUUID->"9dc8e4e0-747f-40f0-91d9-\
34ea7c068d29"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Evaluate \[ScriptCapitalU]\[ScriptCapitalD] Partial Derivatives", \
"Subsubsection",
 CellChangeTimes->{{3.9781936553251038`*^9, 
  3.978193684030953*^9}},ExpressionUUID->"e7b7df96-db0b-4a02-ae26-\
f5454b7e7653"],

Cell[TextData[{
 "Another new \[ScriptCapitalU]\[ScriptCapitalD] compiler function, ",
 StyleBox["EvaluateUDPartials", "Input",
  Background->RGBColor[1, 0.75, 0, 0.33]],
 ", produces a factor of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"A", "'"}], "[", "r", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[PartialD]", "A"}], "/", 
      RowBox[{"\[PartialD]", "r"}]}], "=", 
     SubscriptBox[
      RowBox[{"A", "[", "r", "]"}], 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{",", "\[VeryThinSpace]", "r"}]}]]}]}], TraditionalForm]],
  ExpressionUUID->"5ef746f4-9a5f-45a4-a399-a3a7e8b8cad3"],
 ", in terms of the tick notation that Wolfram understands. We\
\[CloseCurlyQuote]ll wrestle this into differential equations for ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "b5357f5f-4d9c-469a-966f-c3caa7e4078c"],
 "."
}], "Text",
 CellChangeTimes->{{3.978193693449215*^9, 3.9781937180995913`*^9}, {
  3.978193835934637*^9, 3.9781938517332163`*^9}, {3.9781946414765387`*^9, 
  3.978194699400816*^9}, {3.9782159633153048`*^9, 3.978216000290008*^9}, {
  3.978218856766899*^9, 3.9782188701911488`*^9}, {3.978223123654377*^9, 
  3.978223134888627*^9}, {3.979576759814979*^9, 
  3.979576816743808*^9}},ExpressionUUID->"fab56d65-3968-4935-8e5d-\
ce3f49c81afc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
