               "\[Nu]"}], "]"}], ",", "coords"}], "]"}], "/.", 
           "\[IndentingNewLine]", "SchwRules"}], "/.", "SchwInvRules"}], "/.",
          "offDiagonalRules"}], "//", "EvaluateUDPartials"}], ",", 
