Cell[CellGroupData[{

Cell["Constant of Integration", "Section",
 CellChangeTimes->{{3.978095699156555*^9, 
  3.978095702863265*^9}},ExpressionUUID->"6b9f39e4-9303-4e5a-b119-\
d57a6c503d4e"],

Cell[TextData[{
 "Demand the ",
 StyleBox["Newtonian limit",
  FontWeight->"Bold"],
 ": that the black hole behave like a normal Newtonian star when we are far \
away from it. "
}], "Text",
 CellChangeTimes->{{3.978095708351858*^9, 3.978095719850621*^9}, {
  3.978220413042335*^9, 3.97822049157543*^9}, {3.9782205768438253`*^9, 
  3.9782205896700697`*^9}, {3.978221645869215*^9, 3.978221647465247*^9}, {
  3.978223487323278*^9, 
  3.978223492684713*^9}},ExpressionUUID->"c680aedf-317a-4c37-8348-\
f8e67a732149"],

Cell[TextData[{
 "In this weak-field, far-field limit, it is a standard result (not derived \
in this notebook) that the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "\[VeryThinSpace]", "t"}], TraditionalForm]],ExpressionUUID->
  "753e2861-3d0a-4394-ab17-8e4209367a41"],
 " component of the metric, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"t", "\[VeryThinSpace]", "t"}]}]], TraditionalForm]],
  ExpressionUUID->"0fa31221-e75e-456b-85a7-30dc5fc7f70e"],
 ", be directly related to the Newtonian gravitational potential \
\[CapitalPhi]:"
}], "Text",
 CellChangeTimes->{{3.978095708351858*^9, 3.978095719850621*^9}, {
  3.978220413042335*^9, 3.978220522498579*^9}, {3.978221081886423*^9, 
  3.978221168216464*^9}, {3.978221223050321*^9, 3.978221224569928*^9}, {
  3.9782222132670918`*^9, 3.978222213354899*^9}, {3.979337751802074*^9, 
  3.979337771749782*^9}, {3.9795778252956667`*^9, 
  3.979577827173828*^9}},ExpressionUUID->"7a39f050-682d-405f-8d0e-\
29ca87e7a531"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"t", "\[VeryThinSpace]", "t"}]}]], "\[TildeTilde]", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"2", "\[CapitalPhi]"}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.978221183141355*^9, 
  3.9782212393804903`*^9}},ExpressionUUID->"b3fb0592-9bc0-4ca9-aed9-\
5f38e1a75f54"],

Cell[TextData[{
 "in geometric units where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", "=", 
    RowBox[{"c", "=", "1"}]}], TraditionalForm]],ExpressionUUID->
  "27ceb3c9-7770-4f01-bb68-e1ac741ae8f1"],
 ". "
}], "Text",
 CellChangeTimes->{{3.978095708351858*^9, 3.978095719850621*^9}, {
   3.978220413042335*^9, 3.978220510319973*^9}, {3.978220542831746*^9, 
   3.9782205494427156`*^9}, {3.978221247370226*^9, 3.978221329599082*^9}, 
   3.978223511523233*^9},ExpressionUUID->"f7731439-d5ae-4527-809a-\
7306e36894e5"],

Cell[TextData[{
 "For a star of mass ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "e01a300e-0970-461c-b388-a17b406a36b5"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "=", 
    RowBox[{
     RowBox[{"-", "M"}], "/", "r"}]}], TraditionalForm]],ExpressionUUID->
  "c60b5840-4e91-4b52-8097-21c486259e31"],
 ", therefore"
}], "Text",
 CellChangeTimes->{{3.978095708351858*^9, 3.978095719850621*^9}, {
  3.978220413042335*^9, 3.978220510319973*^9}, {3.978220542831746*^9, 
  3.9782205494427156`*^9}, {3.978221247370226*^9, 
  3.978221329599082*^9}},ExpressionUUID->"40ff2774-ca8f-4ee6-86b6-\
23b771ebd24d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"t", "\[VeryThinSpace]", "t"}]}]], "\[TildeTilde]", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{"2", "M"}], "r"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.978221183141355*^9, 3.9782212393804903`*^9}, {
  3.978221344512765*^9, 3.978221373324911*^9}, {3.97822148128857*^9, 
  3.978221486135089*^9}},ExpressionUUID->"2bc1fd4c-985f-4027-873f-\
ffa7f014c8a9"],

Cell[TextData[{
 "Substituting our solution for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "[", "r", "]"}], TraditionalForm]],ExpressionUUID->
  "c4a9a058-d3f5-4f0b-bf60-b3942d69f84c"],
 " into the ansatz, we have"
}], "Text",
 CellChangeTimes->{{3.978221396220543*^9, 
  3.9782214581357594`*^9}},ExpressionUUID->"21dbf002-b41b-4f82-99fa-\
ad17192c5d96"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"t", "\[VeryThinSpace]", "t"}]}]], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"A", "[", "r", "]"}]}], "=", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       FractionBox[
        SubscriptBox["\[ConstantC]", "1"], "r"]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.978221183141355*^9, 3.9782212393804903`*^9}, {
  3.978221344512765*^9, 3.978221373324911*^9}, {3.978221469689541*^9, 
  3.97822150437001*^9}, {3.9782215469792128`*^9, 
  3.978221552219207*^9}},ExpressionUUID->"965f3827-7100-4aa3-907c-\
46afb7af56d4"],

Cell[TextData[{
 "Thus ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ConstantC]", "1"], "=", 
    RowBox[{
     RowBox[{"-", "2"}], "M"}]}], TraditionalForm]],ExpressionUUID->
  "dd27c3a0-b250-4a92-a499-052befad85c1"],
 "."
}], "Text",
 CellChangeTimes->{{3.978095708351858*^9, 3.978095719850621*^9}, {
  3.978220413042335*^9, 3.978220510319973*^9}, {3.978220542831746*^9, 
