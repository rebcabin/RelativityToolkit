Cell[CellGroupData[{

Cell["Charged Vector Field Covariance Demo", "Section",
 CellChangeTimes->{{3.9787963383682137`*^9, 3.97879634402703*^9}, {
  3.9788180610060997`*^9, 3.978818067081018*^9}, {3.978825674286153*^9, 
  3.978825699794757*^9}, {3.9788558949345093`*^9, 3.978855894989732*^9}, {
  3.978894667100854*^9, 3.978894674216569*^9}, {3.98079009608917*^9, 
  3.980790097405974*^9}},ExpressionUUID->"8ac3c528-684d-4beb-ab6b-\
4d1874e0ecab"],

Cell[TextData[{
 "In this demo, we differentiate a generic charged contravariant vector field \
",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "66e09a46-0119-4e94-ab54-43ebd6ef4b93"],
 " coupled to the electromagnetic gauge field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "1b840de4-23e6-46d4-b699-c3df38d02ebf"],
 "\:200b by a scalar charge ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]],ExpressionUUID->
  "1b6af533-348c-48f6-bc16-c67338674391"],
 ". "
}], "Text",
 CellChangeTimes->{{3.980790103713993*^9, 3.980790140002733*^9}, 
   3.980803128974782*^9},ExpressionUUID->"9816424a-5ce2-45da-924a-\
3c236946ff2e"],

Cell[TextData[{
 "Because ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "c8214d04-742b-41e6-a76d-b50e4a0a83c6"],
 " is a hybrid mathematical object\[LongDash]possessing both internal phase \
and a geometrical spacetime index\[LongDash]its covariant derivative requires \
two distinct corrections. ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "722d10ff-7c40-46c2-a129-c6d5d3aef133"],
 "\:200b acts as the connection for the internal phase, while the Christoffel \
symbols \[CapitalGamma] act as the connection for the curved spacetime \
geometry."
}], "Text",
 CellChangeTimes->{
  3.980790103713993*^9, {3.980790147112035*^9, 
   3.9807901814173813`*^9}},ExpressionUUID->"13081e29-07c9-46d0-bb62-\
48248dc7ce65"],

Cell[TextData[{
 "We did not need a geometrical correction in the previous electrodynamics \
demo because we were differentiating a scalar matter field \[Psi], which has \
no geometric indices. Here, the vector ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", 
    RowBox[{" ", "\[Alpha]"}]], TraditionalForm]],ExpressionUUID->
  "e886d3c1-6f60-4e0b-95e9-54d15902735f"],
 " suffers both gauge transformation and geometrical coordinate \
transformation."
}], "Text",
 CellChangeTimes->{
  3.980790103713993*^9, {3.980790147112035*^9, 3.980790242196897*^9}, 
   3.9807902740529222`*^9, {3.9808007823289213`*^9, 
   3.980800861252989*^9}},ExpressionUUID->"5f35ccb6-a328-4ea6-b93d-\
d90cf89a62b1"],

Cell[TextData[{
 "Proceed just as above, with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", 
    RowBox[{"\[VeryThinSpace]", "\[Alpha]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1ef5e72e-ef80-4783-8db2-f92c9468edec"],
 " taking the place of \[Psi]\[VeryThinSpace]:"
}], "Text",
 CellChangeTimes->{
  3.980790103713993*^9, {3.980790147112035*^9, 3.980790242196897*^9}, 
   3.980790277799527*^9, {3.991311295196321*^9, 
   3.9913113190586977`*^9}},ExpressionUUID->"16ab20df-a91c-46bb-a31a-\
cd0762ecedd1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"vsd", "=", 
    RowBox[{"CD", "[", 
     RowBox[{
      RowBox[{"V", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]", "]"}], "]"}], ",", 
      RowBox[{"x", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", "q", ",",
       "A"}], "]"}]}], ")"}], "//", "TensorForm"}]], "Input",
 CellChangeTimes->{{3.978646926181177*^9, 3.978646944946294*^9}, {
   3.9786470457728977`*^9, 3.978647062184148*^9}, {3.9788243635656977`*^9, 
   3.978824398969141*^9}, 3.978824990560746*^9, {3.9807903615773573`*^9, 
   3.980790383251832*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"67be8f28-c827-4885-9074-9540eca97413"],

Cell["The mixed gauge transforms are just as above:", "Text",
 CellChangeTimes->{{3.9913113796474237`*^9, 
  3.9913113957867527`*^9}},ExpressionUUID->"72c8e720-2b5a-4abb-97fb-\
0938398da6e4"],

Cell[BoxData[
 RowBox[{"mixedGaugeTransforms", " ", "=", " ", 
  RowBox[{"{", "\n", "    ", 
   RowBox[{
    RowBox[{
     RowBox[{"V", "[", 
      RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]_", "]"}], "]"}], " ", ":>", 
     " ", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
       "\[ImaginaryI]", "\[VeryThinSpace]", "q", " ", "\[CapitalLambda]"}]], " ", 
      RowBox[{"V", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]", "]"}], "]"}]}]}], ",", 
    "\n", "    ", 
    RowBox[{
     RowBox[{"A", "[", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], "]"}], " ", ":>", 
     " ", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], "]"}], " ", "+", " ", 
      RowBox[{"Partials", "[", 
       RowBox[{"\[CapitalLambda]", ",", " ", 
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], 
       "]"}]}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.9788250296307173`*^9, 3.9788251409065733`*^9}, {
   3.97882518727766*^9, 3.978825266663143*^9}, {3.980790521003469*^9, 
   3.98079057031083*^9}, 3.991311340358344*^9},
 CellLabel->"In[66]:=",ExpressionUUID->"87e77b04-886b-4005-9b7f-8bcbdf3df423"],

Cell[BoxData[
 RowBox[{"transformedVsd", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"vsd", "/.", "mixedGaugeTransforms"}], "//.", 
       "differentiationRules"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Partials", "[", 
         RowBox[{"q", ",", " ", "_"}], "]"}], " ", ":>", " ", "0"}], "}"}]}], 
     ")"}], "//", "Expand"}], "//", "TensorForm"}]}]], "Input",
 CellChangeTimes->{{3.978825319599626*^9, 3.978825372620346*^9}, 
   3.9788254079838676`*^9, {3.978825509394045*^9, 3.978825543637789*^9}, {
   3.978825916745536*^9, 3.978825920709778*^9}, {3.980088870225731*^9, 
   3.980088875005691*^9}, {3.980790589615489*^9, 3.9807905971707067`*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"a1d8f2a1-295b-4ac3-9be9-af9abb589110"],

Cell[BoxData[
 RowBox[{"expectedVsd", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"vsd", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
      "\[ImaginaryI]", "\[VeryThinSpace]", "q", " ", "\[CapitalLambda]"}]]}], 
    "//", "Expand"}], "//", "TensorForm"}]}]], "Input",
 CellChangeTimes->{{3.978825436991612*^9, 3.9788254378099117`*^9}, {
   3.978825479842869*^9, 3.978825494110771*^9}, {3.978825553180427*^9, 
   3.9788255611971493`*^9}, {3.9788259259791727`*^9, 3.978825927892708*^9}, {
   3.980790609464918*^9, 3.980790620786001*^9}, 3.991311413157868*^9},
 CellLabel->"In[67]:=",ExpressionUUID->"60d3c2b9-2556-487c-adfe-c71e59d95199"],

Cell[BoxData[
 RowBox[{"transformedVsd", "===", "expectedVsd"}]], "Input",
 CellChangeTimes->{{3.978825566065806*^9, 3.9788255784436274`*^9}, {
  3.9807906707890787`*^9, 3.980790676170329*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"4a9c6c49-52c0-4f57-ac31-6831ea351986"],

Cell["QED\[NonBreakingSpace]\[FilledSquare]", "Text",
 CellChangeTimes->{{3.978823232236299*^9, 3.978823321181185*^9}},
 FontColor->RGBColor[
  0.14, 0.8, 0.14],ExpressionUUID->"d299654d-7a6d-4c80-884c-bbebb9301178"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Geometrical GR Demos", "Section",
 CellChangeTimes->{{3.9786994068137197`*^9, 3.9786994131830473`*^9}, {
  3.978795802230837*^9, 3.9787958048569098`*^9}, {3.978895745408906*^9, 
  3.9788957493236227`*^9}},ExpressionUUID->"e5710a23-61f4-493f-86ed-\
e18bd8ca10ce"],

Cell[CellGroupData[{

Cell["Geometrical Covariant Derivative of a Scalar Function \
\[CapitalLambda]", "Subsection",
 CellChangeTimes->{{3.978893209749408*^9, 3.978893224927899*^9}, {
  3.9788957134832897`*^9, 3.9788957145552473`*^9}, {3.979349737913785*^9, 
  3.9793497399086857`*^9}},ExpressionUUID->"6c60e6b7-8cf1-438e-87ce-\
3b1bf96b643e"],

Cell["\<\
equal to its ordinary partial derivative, rendered in comma notation\
\>", "Text",
 CellChangeTimes->{{3.978895733267252*^9, 3.9788957630844383`*^9}, 
   3.9789952887631893`*^9},ExpressionUUID->"5b56050f-4b40-470e-8084-\
e8d3379a6655"],

Cell[BoxData[
 RowBox[{"CD", "[", 
  RowBox[{"\[CapitalLambda]", ",", 
   RowBox[{"x", "[", 
    RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], "]"}]], "Input",\

 CellChangeTimes->{{3.978893227960505*^9, 3.978893244210726*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"04154f17-bcae-430a-8df6-946f27ca396e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Geometrical Covariant Derivative of a Contravariant Vector ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", 
    RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "cd29982d-4da8-4701-b47c-e4f452998932"]
}], "Subsection",
 CellChangeTimes->{{3.978722966316712*^9, 3.978722999740416*^9}, 
   3.9787231009581213`*^9, {3.978725130360669*^9, 3.978725131663802*^9}, {
   3.978795851140572*^9, 3.978795866832985*^9}, 3.9787959818547487`*^9, {
   3.979349747141242*^9, 
   3.979349747626672*^9}},ExpressionUUID->"fba5a714-f09d-4338-93fc-\
ddbbeef6f9dd"],

Cell["\<\
equal to its partial derivative plus the correction proportional to the \
geometrical connection \[CapitalGamma]\
\>", "Text",
 CellChangeTimes->{{3.97934975624529*^9, 
  3.9793497791821127`*^9}},ExpressionUUID->"7b532589-5e45-4982-bc2f-\
7f35b0b08efc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CD", "[", 
   RowBox[{
    RowBox[{"V", "[", 
     RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", 
    RowBox[{"x", "[", 
     RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], "//", 
  "TensorForm"}]], "Input",
 CellChangeTimes->{{3.978646926181177*^9, 3.9786469794424543`*^9}, {
   3.978699513903988*^9, 3.978699517498158*^9}, 3.9787000545314837`*^9},
 CellLabel->"In[50]:=",ExpressionUUID->"0d0ef4cc-59dc-47c8-833f-846ca49cf214"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Geometrical Covariant Derivative of a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"2", ",", "0"}], ")"}], TraditionalForm]],ExpressionUUID->
  "87935a7a-8769-4d23-b78c-610fa4d7d2d5"],
 " Tensor"
}], "Subsection",
 CellChangeTimes->{{3.978723020029056*^9, 3.978723048257453*^9}, {
   3.9787958329993258`*^9, 3.978795870427258*^9}, 3.978795984887789*^9, 
   3.979349805882736*^9},ExpressionUUID->"86c5371d-10c4-4420-89e3-\
f1271f038bfd"],

Cell["now we get two corrections, one for each index", "Text",
 CellChangeTimes->{{3.9793497876187553`*^9, 
  3.9793497982119703`*^9}},ExpressionUUID->"58d0eca9-7435-4673-af4f-\
840a6933385b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CD", "[", 
   RowBox[{
    RowBox[{"T", "[", 
     RowBox[{
      RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], ",", 
      RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}]}], "]"}], ",", 
    RowBox[{"x", "[", 
     RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]", "]"}], "]"}]}], "]"}], "//", 
  "TensorForm"}]], "Input",
 CellChangeTimes->{{3.978722557434629*^9, 3.978722614510888*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"0f14565c-7c38-416a-b963-cef34cc175a5"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Geometrical Covariant Derivative of a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]],ExpressionUUID->
  "c182bb48-6828-4c54-9765-29069c483871"],
 " Tensor"
}], "Subsection",
 CellChangeTimes->{{3.978723020029056*^9, 3.978723065394462*^9}, {
   3.978795856858921*^9, 3.9787958753289633`*^9}, 3.978795987256597*^9, 
   3.9793498093961153`*^9},ExpressionUUID->"a2ea2732-42a8-4fd1-84c7-\
94c0217819ec"],

Cell["ditto, with a sign change", "Text",
 CellChangeTimes->{{3.979349812588862*^9, 
  3.979349819692924*^9}},ExpressionUUID->"0bfa2ffc-548e-4e48-9a8c-\
83f9bd2e8669"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CD", "[", 
   RowBox[{
    RowBox[{"T", "[", 
     RowBox[{
      RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], ",", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], ",", 
    RowBox[{"x", "[", 
     RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]", "]"}], "]"}]}], "]"}], "//", 
  "TensorForm"}]], "Input",
 CellChangeTimes->{{3.978722557434629*^9, 3.978722614510888*^9}, {
  3.978722815581492*^9, 3.978722817901774*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"e0ff2384-1986-4fe0-b697-b0892cbf2351"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Geometrical Covariant Derivative of the Covariant Metric", "Subsection",
 CellChangeTimes->{{3.978723075447353*^9, 3.978723097320726*^9}, {
   3.978795859359416*^9, 3.9787958830507383`*^9}, 3.978795991209485*^9, 
   3.9793498261165657`*^9},ExpressionUUID->"daa888d7-1f81-4b3d-bcbd-\
1f836fc32d72"],

Cell["Two negative signs, one for each covariant index", "Text",
 CellChangeTimes->{{3.979349831969532*^9, 
  3.9793498464946747`*^9}},ExpressionUUID->"2330fefb-0445-4965-9dc5-\
9798d5e0d280"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"cdg", "=", 
    RowBox[{"CD", "[", 
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], ",", 
      RowBox[{"x", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]", "]"}], "]"}]}], "]"}]}], 
   ")"}], "//", "TensorForm"}]], "Input",
 CellChangeTimes->{{3.9787227535882607`*^9, 3.978722761097104*^9}, {
  3.978722836428891*^9, 3.978722842838008*^9}, {3.978724835549759*^9, 
  3.978724850041938*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"afc099c9-f5c1-42c7-b6c7-26df7bc60634"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Metric Compatibility, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Del]", "g"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5115f227-7c52-40ba-9d69-46a5f8e57aaf"]
}], "Subsection",
 CellChangeTimes->{{3.978724421051444*^9, 3.978724452354293*^9}, {
   3.978724585756415*^9, 3.97872459014424*^9}, {3.9787249870275803`*^9, 
   3.978724987675819*^9}, {3.9787305570246077`*^9, 3.97873066121562*^9}, {
   3.9787307307016373`*^9, 3.978730773596877*^9}, 3.978732898964694*^9, {
   3.978737301095892*^9, 3.978737355871677*^9}, 3.978795900279101*^9, {
   3.9787959783127203`*^9, 
   3.978796006164027*^9}},ExpressionUUID->"36906ab5-5174-4fb2-9cd8-\
7beb95aae06e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Del]", "g"}], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "c3a94c61-159e-453c-9118-0f5a0195d515"],
 " was an axiom in earlier notebooks, and it yielded the Christoffel symbols \
in the ",
 StyleBox["Fundamental Theorem of Riemannian Geometry",
  FontSlant->"Italic"],
 ". Here, we do the opposite, showing that the Christoffel symbols imply \
metric compatibility. Thus, in a torsion-free manifold, metric compatibility \
is both necessary and sufficient for the Christoffel symbols."
}], "Text",
 CellChangeTimes->{{3.978724421051444*^9, 3.978724452354293*^9}, {
   3.978724585756415*^9, 3.97872459014424*^9}, {3.9787249870275803`*^9, 
   3.978724987675819*^9}, {3.9787305570246077`*^9, 3.97873066121562*^9}, {
   3.9787307307016373`*^9, 3.978730773596877*^9}, 3.978732898964694*^9, {
   3.978737301095892*^9, 3.978737355871677*^9}, {3.978795912867682*^9, 
   3.978795961568068*^9}, {3.978796025215447*^9, 3.978796030724938*^9}, {
   3.978995315215734*^9, 3.978995324627754*^9}, {3.9808027619973917`*^9, 
   3.980802769453281*^9}},ExpressionUUID->"105c2b56-4f50-4673-b271-\
481010de5f68"],

Cell[TextData[{
 StyleBox["In abstract geometrical contexts, as opposed to coordinate-basis \
contexts, the Christoffel symbols are called the ",
  FontSlant->"Italic"],
 StyleBox["Levi-Civita Connection",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["., often written ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", GridBox[{
      {"\[Lambda]"},
      {
       RowBox[{"\[Mu]", " ", "\[Nu]"}]}
     }], "}"}], TraditionalForm]],ExpressionUUID->
  "cd8ae890-8104-42ef-bd1b-0e86acb1cbbc"],
