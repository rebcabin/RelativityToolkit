Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CDSU2Spinor", "[", 
    RowBox[{"psi_", ",", "var_", ",", "g_", ",", "W_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gravitationalPart", ",", "gaugeCorrection", ",", "idx"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Base", " ", "geometrical", " ", "derivative"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gravitationalPart", "=", 
       RowBox[{"CD", "[", 
        RowBox[{"psi", ",", "var"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Extract", " ", "spacetime", " ", "index", " ", "from", " ", "the", " ",
         "differentiation", " ", "variable"}], "*)"}], "\[IndentingNewLine]", 
      
      RowBox[{"idx", "=", 
       RowBox[{"var", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"SU", 
        RowBox[{"(", "2", ")"}], " ", "gauge", " ", "correction", " ", "via", 
        " ", "matrix", " ", "multiplication"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"gaugeCorrection", "=", 
       RowBox[{"g", "*", 
        RowBox[{
         RowBox[{"W", "[", "idx", "]"}], ".", "psi"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gravitationalPart", "+", "gaugeCorrection"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.99131757413171*^9, 3.991317627746849*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"95d55a5b-e17a-4c3a-83ae-25f8581f4e82"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"commM", "[", 
    RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"A", ".", "B"}], "-", 
    RowBox[{"B", ".", "A"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991318450248179*^9, 3.991318453231505*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"aefb230b-2ade-41f4-bbce-c2312fcd65bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CDSU2Adjoint", "[", 
    RowBox[{"V_", ",", "var_", ",", "g_", ",", "W_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gravitationalPart", ",", "gaugeCorrection", ",", "idx"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gravitationalPart", "=", 
       RowBox[{"CD", "[", 
        RowBox[{"V", ",", "var"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"idx", "=", 
       RowBox[{"var", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"SU", 
        RowBox[{"(", "2", ")"}], " ", "gauge", " ", "correction", " ", "via", 
        " ", "the", " ", "Lie", " ", "bracket"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"gaugeCorrection", "=", 
       RowBox[{"g", "*", 
        RowBox[{"commM", "[", 
         RowBox[{
          RowBox[{"W", "[", "idx", "]"}], ",", "V"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gravitationalPart", "+", "gaugeCorrection"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9913176641394157`*^9, 3.99131769479385*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"3f20ae89-9027-4acd-bb91-82460af5cea8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Generators", " ", "of", " ", "SU", 
    RowBox[{"(", "2", ")"}], " ", "as", " ", "defined", " ", "in", " ", 
    "CheckingTheBases"}], "*)"}], 
  RowBox[{
   RowBox[{"T", "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["\[ImaginaryI]", "2"]}], 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PauliMatrix", "[", "1", "]"}], ",", 
       RowBox[{"PauliMatrix", "[", "2", "]"}], ",", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}], "}"}]}]}], "\n"}]}]], "Input",\

 CellChangeTimes->{{3.991318440204967*^9, 3.991318440205014*^9}, {
  3.991318470986158*^9, 3.99131851520863*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"889f3e70-77bc-48d2-8f4a-a03d2c37751b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", 
        FractionBox["\[ImaginaryI]", "2"]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["\[ImaginaryI]", "2"]}], ",", "0"}], "}"}]}], "}"}], ",", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", 
        FractionBox["1", "2"]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["1", "2"], ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["\[ImaginaryI]", "2"]}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox["\[ImaginaryI]", "2"]}], "}"}]}], "}"}]}], "}"}]], "Output",\

 CellChangeTimes->{{3.9913184997305737`*^9, 3.9913185160694313`*^9}},
 CellLabel->"Out[18]=",ExpressionUUID->"c40519a4-e729-4c79-968e-3620c9981b68"]
}, Open  ]],

Cell[BoxData["W"], "Input",
 CellChangeTimes->{{3.991318537589404*^9, 
  3.991318560841652*^9}},ExpressionUUID->"c05581a4-4c09-4acb-a649-\
703c643fe948"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Introduction", "Section",
 CellChangeTimes->{{3.9807976826352158`*^9, 
  3.980797684726654*^9}},ExpressionUUID->"cdd3c25d-ecef-442c-b415-\
03ca567e7026"],

Cell["\<\
In physics, choosing a coordinate system or a phase reference is \
\[OpenCurlyDoubleQuote]setting a gauge.\[CloseCurlyDoubleQuote] Changing this \
choice\[LongDash]whether transforming spacetime coordinates or shifting the \
phase of a field\[LongDash]often introduces inhomogeneous terms when taking \
partial derivatives.\
\>", "Text",
 CellChangeTimes->{{3.980797690568597*^9, 3.9807976945653954`*^9}, {
  3.980797742926313*^9, 
  3.980797746128508*^9}},ExpressionUUID->"2c53c7d6-46af-4e52-9122-\
d6f22d5879ba"],

Cell[TextData[{
 "Connection fields arise to maintain covariance of the physics under such \
transformations. In general relativity, the Levi-Civita connection \
(Christoffel symbols) corrects for the curvature of spacetime coordinates. In \
electrodynamics, the vector potential ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Mu]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1d48433e-b726-45a7-b018-7d02d076894f"],
 "\:200b acts as the connection, correcting for local variations in the phase \
reference."
}], "Text",
 CellChangeTimes->{{3.980797690568597*^9, 3.980797734762903*^9}, {
  3.980797770437899*^9, 
  3.980797774531369*^9}},ExpressionUUID->"9341a0c8-846d-45ce-8bbf-\
e1bd4ed166e5"],

Cell["\<\
While apparent forces (like centrifugal and Coriolis) can be eliminated \
globally by choosing a specific inertial gauge, fundamental forces (like \
tidal gravity and electromagnetism) arise from the intrinsic curvature of \
these connections and cannot be globally gauged away.\
\>", "Text",
 CellChangeTimes->{
  3.980797690568597*^9},ExpressionUUID->"48c7fc59-f741-4335-965d-\
e2791c943683"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Covariance and Internal Gauge", "Section",
 CellChangeTimes->{{3.980797840815453*^9, 
  3.9807978479596643`*^9}},ExpressionUUID->"fe66d1d1-6eb8-4dc1-922f-\
48137d0acdf0"],

Cell[TextData[{
 "To see how a connection restores covariance, consider a scalar matter field \
\[Psi] subjected to a local ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "(", "1", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "777189c6-3ba6-4763-9b94-21b937c1dd3a"],
 " phase change ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", "(", 
    SuperscriptBox["x", 
     RowBox[{" ", "\[Mu]"}]], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ec498af3-8afb-4d82-a145-f4abb46592f9"],
 ":"
}], "Text",
 CellChangeTimes->{{3.98079785546911*^9, 
  3.980797966228342*^9}},ExpressionUUID->"cf129f43-cbcf-4f9c-90cc-\
2fb69b048fdc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["\[Psi]", "_"], "=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{" ", 
      RowBox[{"\[ImaginaryI]", " ", "q", " ", "\[CapitalLambda]"}]}]], 
    "\[Psi]"}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.980797970921173*^9, 3.98079802747829*^9}, {
  3.980798058118535*^9, 
  3.980798058120255*^9}},ExpressionUUID->"9be1b03e-ee32-44a6-82b8-\
4842395da3e2"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]],ExpressionUUID->
  "acfedfa2-3b3d-438a-9a75-c875fa0a34d4"],
 " is a constant charge. The ordinary partial derivative produces an \
inhomogeneous term via the product rule and the chain rule:"
}], "Text",
 CellChangeTimes->{{3.9807980840253267`*^9, 3.980798150103746*^9}, {
  3.980798296087822*^9, 3.980798299459553*^9}, {3.991065663944849*^9, 
  3.991065684294799*^9}},ExpressionUUID->"400f1eee-fb4f-424f-abfd-\
06c8f9365a5f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Mu]"], 
    OverscriptBox["\[Psi]", "_"]}], "=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{" ", 
      RowBox[{"\[ImaginaryI]", " ", "q", " ", "\[CapitalLambda]"}]}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Mu]"], "\[Psi]"}], "+", 
      RowBox[{"\[ImaginaryI]", " ", "q", " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[PartialD]", "\[Mu]"], "\[CapitalLambda]"}], ")"}], 
       "\[Psi]"}]}], ")"}]}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9807983376536083`*^9, 
  3.9807985757404013`*^9}},ExpressionUUID->"bfb4ead3-5455-4f28-b015-\
4d8fe3c67ea4"],

Cell[TextData[{
 "The inhomogeneous term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ImaginaryI]", " ", "q", " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], "\[CapitalLambda]"}], ")"}], 
    "\[Psi]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e0aca944-bcfa-476a-aa35-25f3608da4c2"],
 " breaks covariance. To restore it, introduce a gauge covariant derivative. \
As with general relativity, add a correction to the partial derivative"
}], "Text",
 CellChangeTimes->{{3.980798623778428*^9, 3.980798792668687*^9}, {
  3.980798876149948*^9, 3.9807988822291193`*^9}, {3.980798959617259*^9, 
  3.980798979854354*^9}},ExpressionUUID->"945797e0-8291-4ea0-839c-\
9f56b8340c49"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["D", "\[Mu]"], "\[Psi]"}], "\[Congruent]", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], "\[Psi]"}], "-", 
    RowBox[{"\[ImaginaryI]", " ", "q", " ", 
     SubscriptBox["A", "\[Mu]"], "\[Psi]"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.980798884553198*^9, 3.980798955706875*^9}, {
  3.980798987318472*^9, 3.980798998727496*^9}, {3.980799535980069*^9, 
  3.980799535980123*^9}, {3.9807997768941193`*^9, 
  3.980799776896695*^9}},ExpressionUUID->"e936c478-d3db-4874-a4aa-\
647476b176cf"],

Cell["Requiring the connection to transform as ", "Text",
 CellChangeTimes->{{3.9807990933162823`*^9, 
  3.980799103729569*^9}},ExpressionUUID->"b95de9d6-8dc0-4e05-8cd6-\
298737151dec"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["A", "_"], "\[Mu]"], "=", 
   RowBox[{
    SubscriptBox["A", "\[Mu]"], "+", 
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], "\[CapitalLambda]"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9807990165812798`*^9, 3.980799085314687*^9}, {
  3.980799789468281*^9, 
  3.9807997894705343`*^9}},ExpressionUUID->"302016d3-0631-423d-92d9-\
a316221982e2"],

Cell[TextData[{
 "gives us an operator ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", "\[Mu]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "042d6a06-0bd6-4e7d-840f-d8b40632031f"],
 " that transforms covariantly with gauge, just as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Del]", "\[Mu]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d67cf8a6-c4ca-470c-9c33-855d2a2da6b1"],
 " transforms covariantly with coordinates in relativity:"
}], "Text",
 CellChangeTimes->{{3.980799813798215*^9, 
  3.98079989152064*^9}},ExpressionUUID->"8c27c023-005d-404e-95af-\
93898fd6fbb8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox[
    RowBox[{
     SubscriptBox["D", "\[Mu]"], 
     OverscriptBox["\[Psi]", "_"]}],
    FontColor->RGBColor[0.14, 0.8, 0.14]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], 
      OverscriptBox["\[Psi]", "_"]}], "-", 
     RowBox[{"\[ImaginaryI]", " ", "q", " ", 
      OverscriptBox[
       SubscriptBox["A", "\[Mu]"], "_"], 
      OverscriptBox["\[Psi]", "_"]}]}], "=", "\[LineSeparator]", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{" ", 
         RowBox[{"\[ImaginaryI]", " ", "q", " ", "\[CapitalLambda]"}]}]], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", "\[Mu]"], "\[Psi]"}], "+", 
         RowBox[{"\[ImaginaryI]", " ", "q", " ", 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[PartialD]", "\[Mu]"], "\[CapitalLambda]"}], ")"}],
           "\[Psi]"}]}], ")"}]}], "-", 
      RowBox[{"\[ImaginaryI]", " ", "q", " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["A", "\[Mu]"], "+", 
         RowBox[{
          SubscriptBox["\[PartialD]", "\[Mu]"], "\[CapitalLambda]"}]}], ")"}], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{" ", 
         RowBox[{"\[ImaginaryI]", " ", "q", " ", "\[CapitalLambda]"}]}]], 
       "\[Psi]"}]}], "=", "\[LineSeparator]", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{" ", 
         RowBox[{"\[ImaginaryI]", " ", "q", " ", "\[CapitalLambda]"}]}]], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", "\[Mu]"], "\[Psi]"}], "-", 
         RowBox[{"\[ImaginaryI]", " ", "q", " ", 
          SubscriptBox["A", "\[Mu]"], "\[Psi]"}]}], ")"}]}], "=", 
      "\[LineSeparator]", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{" ", 
         RowBox[{"\[ImaginaryI]", " ", "q", " ", "\[CapitalLambda]"}]}]], " ", 
       StyleBox[
        SubscriptBox["D", "\[Mu]"],
        FontColor->RGBColor[0.14, 0.8, 0.14]], 
       StyleBox["\[Psi]",
        FontColor->RGBColor[0.14, 0.8, 0.14]]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.980798884553198*^9, 3.980798955706875*^9}, {
  3.980798987318472*^9, 3.980798998727496*^9}, {3.9807991765359488`*^9, 
  3.980799295612267*^9}, {3.9807994954270887`*^9, 3.980799507869485*^9}, {
  3.980799541602888*^9, 3.980799563467677*^9}, {3.980799602495865*^9, 
  3.98079974403161*^9}, {3.9807997986137*^9, 
  3.980799798616951*^9}},ExpressionUUID->"0008a959-2338-416a-9bfe-\
9de2a52f1f47"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Internal Gauge Spaces in the \[ScriptCapitalU]\[ScriptCapitalD] \
Calculus", "Section",
 CellChangeTimes->{{3.980799955701447*^9, 
  3.980799988085701*^9}},ExpressionUUID->"0805bc51-0d29-4272-b26d-\
d3b0e71efd43"],

Cell["\<\
In general relativity, we take covariant derivatives of tensors inhabiting \
the tangent spaces of a curved manifold. The connection \[CapitalGamma] \
accounts for the twisting of basis vectors.\
\>", "Text",
 CellChangeTimes->{{3.980799993919921*^9, 
  3.980800004055119*^9}},ExpressionUUID->"31bce255-0ce5-4ca7-81ac-\
5b502d288423"],

Cell["\<\
In gauge theories like electrodynamics, the connections operate on internal \
spaces (such as the U(1) phase) attached, extrinsically to the spacetime \
itself, to each point in spacetime. The objective of this notebook is to \
update the \[ScriptCapitalU]\[ScriptCapitalD] calculus to compute derivatives \
for objects that possess both spacetime indices and internal gauge charges \
simultaneously.\
\>", "Text",
 CellChangeTimes->{{3.980799993919921*^9, 
  3.980800064091989*^9}},ExpressionUUID->"73da4bf9-b8e2-48a8-9fb8-\
e480dbf1111b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Covariant Derivatives, Revisited", "Section",
 CellChangeTimes->{{3.978358251530368*^9, 
  3.978358274502495*^9}},ExpressionUUID->"7f6b77f4-b0fc-4a67-b903-\
969955fdadc1"],

Cell[TextData[{
 "In GR, the canonical example is the covariant derivative of an arbitrary \
contravariant vector ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "a18ef1ef-909d-46ca-af3d-a413ac2c6455"],
 " with respect to geometrical coordinates. Here it is in \[ScriptCapitalU]\
\[ScriptCapitalD], with ",
 StyleBox["CD", "Input"],
 " standing for \[OpenCurlyDoubleQuote]covariant derivative:\
\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{3.978645943294868*^9, 3.978645997660583*^9}, {
  3.9787915036557417`*^9, 3.978791531715695*^9}, {3.979348896909027*^9, 
  3.979348928838019*^9}, {3.980087977109717*^9, 3.9800880480484953`*^9}, {
  3.980088078321742*^9, 3.980088104515327*^9}, {3.980637238429069*^9, 
  3.980637238856543*^9}, {3.980800097719336*^9, 3.980800126279673*^9}, {
  3.991310413145749*^9, 
  3.99131046206717*^9}},ExpressionUUID->"4f010f30-76ff-4c9d-9e45-\
977a9562d116"],

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"example", "=", 
      RowBox[{"HoldForm", "[", 
       RowBox[{"CD", "[", 
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], 
       "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"TensorForm", "@@", "example"}], ",", 
      RowBox[{"example", "\"\<\>\""}]}], "]"}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.978358547373548*^9, 3.978358772499927*^9}, {
  3.978359072474093*^9, 3.978359157811211*^9}, {3.9783592724273376`*^9, 
  3.978359272556822*^9}, {3.9783593063094587`*^9, 3.9783593921632147`*^9}, {
  3.978383680431888*^9, 3.978383735895418*^9}, {3.980800170248663*^9, 
  3.980800253393353*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"78497388-807e-47b1-a2f3-54ab4ce22561"],

Cell[TextData[{
 "The connection coefficients \[CapitalGamma] account for twisting and \
turning of basis vectors in the tangent spaces as the vector ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "dd3e6e84-9f68-483f-906e-506409ee1c30"],
 " is parallel-transported geometrically. In GR, this twisting and turning \
causes geodesics to converge or diverge, thus causing tidal forces. Twisting \
and turning also drives single geodesics, giving rise to orbits, \
gravitational lensing, gravitational waves, and so on."
}], "Text",
 CellChangeTimes->{{3.978645943294868*^9, 3.978646017572369*^9}, {
  3.978646073037752*^9, 3.978646096573864*^9}, {3.978791550457979*^9, 
  3.9787915716892157`*^9}, {3.978791607811911*^9, 3.978791645252721*^9}, {
  3.9789947228843813`*^9, 3.9789947833892727`*^9}, {3.979346935639179*^9, 
  3.9793469359737883`*^9}, {3.979348792711174*^9, 3.979348826305972*^9}, {
  3.980088125045064*^9, 
  3.98008817900523*^9}},ExpressionUUID->"37424616-b889-4f35-aa46-\
5f5a9d34df7f"],

Cell[TextData[StyleBox["Emphasis: Geodesic deviation is indistinguishable \
from tidal force. It\[CloseCurlyQuote]s not an apparent force: its numerical \
values may depend on gauge choice, but we can\[CloseCurlyQuote]t get rid of \
it globally by gauge choice.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.978645943294868*^9, 3.978646017572369*^9}, {
  3.978646073037752*^9, 3.978646096573864*^9}, {3.978791550457979*^9, 
  3.9787915716892157`*^9}, {3.978791607811911*^9, 3.9787916688688183`*^9}, {
  3.978893726055107*^9, 3.978893734728683*^9}, {3.978994793962654*^9, 
  3.978994807936285*^9}, {3.979348947568865*^9, 3.979348965248041*^9}, {
  3.980088203867462*^9, 
  3.980088206557819*^9}},ExpressionUUID->"a0d3e19d-b357-44b9-be80-\
c725fc844522"],

Cell[TextData[{
 "The derivative above transforms like a tensor, ensuring physics is ",
 StyleBox["locally Lorentz invariant",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". This invariance invites Noether\[CloseCurlyQuote]s theorem again, \
implying a conserved quantity. In GR, this conserved quantity is ",
 StyleBox["spin current",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", from symmetries of non-coordinate bases or ",
 StyleBox["tetrads",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (see the Appendix). "
}], "Text",
 CellChangeTimes->{{3.978645943294868*^9, 3.97864602352232*^9}, {
   3.97864610862702*^9, 3.9786461676375427`*^9}, {3.978738857168982*^9, 
   3.978738864834247*^9}, {3.9787916844234667`*^9, 3.978791699695005*^9}, {
   3.978893751507414*^9, 3.978893784918326*^9}, {3.978994819214058*^9, 
   3.9789948358117647`*^9}, {3.9793489792813187`*^9, 
   3.9793489931010923`*^9}, {3.980788210194305*^9, 3.980788241301305*^9}, 
   3.98080030687964*^9},ExpressionUUID->"9ad9e61c-cea4-41a0-a521-\
e599c7429130"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A New CD", "Section",
 CellChangeTimes->{{3.978646468171488*^9, 
  3.978646472312533*^9}},ExpressionUUID->"c8c2732a-482b-40dd-ad69-\
34c9e0e28e1c"],

Cell[TextData[{
 "The following new overload of ",
 StyleBox["CD", "Input"],
 " computes covariant derivatives for Abelian (commutative) gauges like \
scalar phase. We\[CloseCurlyQuote]ll get to non-Abelian gauges like ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "b095c076-44b2-4e1c-a2e7-520484aa96ed"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "0bb64d2a-2e5e-49d7-8c98-59d641060033"],
 " in future notebooks."
}], "Text",
 CellChangeTimes->{{3.978795270483778*^9, 3.978795277854451*^9}, {
   3.978795415257291*^9, 3.9787954500045643`*^9}, {3.978821069299505*^9, 
   3.978821143212737*^9}, {3.978821224035911*^9, 3.978821242453227*^9}, {
   3.978893877885006*^9, 3.9788939047268047`*^9}, {3.979349284780232*^9, 
   3.9793493096019793`*^9}, {3.9793493397252274`*^9, 3.979349346486093*^9}, {
   3.980088358906061*^9, 3.980088362877892*^9}, {3.980637365209215*^9, 
   3.9806374027087173`*^9}, 3.980788069578017*^9, {3.9808003479967403`*^9, 
   3.980800427093316*^9}},ExpressionUUID->"9e34077f-ed2e-4587-87ba-\
5f5fa8adeb8f"],

Cell[CellGroupData[{

Cell["Gauge Covariant Derivative", "Subsection",
 CellChangeTimes->{{3.978795468371107*^9, 
  3.978795488321023*^9}},ExpressionUUID->"94acbd51-3b62-4f9c-a4df-\
f9e4ff0aa53d"],

Cell[CellGroupData[{

Cell["Inputs", "Subsubsection",
 CellChangeTimes->{{3.978795503910904*^9, 
  3.9787955045961237`*^9}},ExpressionUUID->"ef67580c-d7d0-4644-b9c2-\
f49bb71314c8"],

Cell[TextData[{
 StyleBox["expr", "Input"],
 ": The field being differentiated, scalar or tensor"
}], "ItemNumbered",
 CellChangeTimes->{{3.978795528199066*^9, 
  3.978795548423512*^9}},ExpressionUUID->"85859702-2d3f-440a-9c1c-\
5c2d0a618c56"],

Cell[TextData[{
 StyleBox["var", "Input"],
 ": the coordinate function, e.g., ",
 StyleBox["x[\[ScriptCapitalU][\[Mu]]]", "Input"],
 "; the differentiation variable"
}], "ItemNumbered",
 CellChangeTimes->{{3.97879555492418*^9, 3.978795614319105*^9}, {
   3.97879576904465*^9, 3.978795773539029*^9}, 
   3.991310889825708*^9},ExpressionUUID->"0ebc50f6-8428-4da3-99aa-\
009f03b3365b"],

Cell[TextData[{
 StyleBox["q", "Input"],
 ": the coupling constant or \[OpenCurlyDoubleQuote]charge\
\[CloseCurlyDoubleQuote]"
}], "ItemNumbered",
 CellChangeTimes->{{3.978795636372712*^9, 
  3.978795645409*^9}},ExpressionUUID->"77fc3235-4095-4d8d-96a1-e8b030336e52"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["A", "Input"],
 ": the gauge-field connection symbol. \[CapitalGamma] is kept implicitly as \
the spacetime connection for all theories."
}], "ItemNumbered",
 CellChangeTimes->{{3.9787956548435926`*^9, 3.9787956871354723`*^9}, {
  3.9789949968930073`*^9, 3.978995008129044*^9}, {3.980800444239386*^9, 
  3.980800453018656*^9}},ExpressionUUID->"04154e59-9bc7-4076-b83d-\
31acad96ae89"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CD", "[", 
    RowBox[{"expr_", ",", "var_", ",", "q_", ",", "A_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gravitationalPart", ",", "gaugeCorrection", ",", "idx"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Get", " ", "coordinate", " ", "covariant", " ", "derivative", " ", 
       "via", " ", "existing", " ", "CD", " ", 
       RowBox[{"overloads", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"\[PartialD]", " ", 
        RowBox[{"+", " ", "Christoffels"}]}], " ", 
       RowBox[{"(", 
        RowBox[{"if", " ", "expr", " ", "is", " ", "a", " ", "tensor"}], 
        ")"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"If", " ", "expr", " ", "is", " ", "a", " ", "scalar"}], ",", 
       " ", 
       RowBox[{"just", " ", "return", " ", 
        RowBox[{"\[PartialD]", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gravitationalPart", "=", 
       RowBox[{"CD", "[", 
        RowBox[{"expr", ",", "var"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Extract", " ", "the", " ", "index", " ", "from", " ", "the", " ", 
        "differentiation", " ", 
        RowBox[{"variable", "."}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"var", " ", "is", " ", "some", " ", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], ";", " ", 
        RowBox[{"we", " ", "need", " ", "\[Mu]"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"idx", "=", 
       RowBox[{"var", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Construct", " ", "the", " ", "gauge", " ", "correction"}], ",",
         " ", 
        RowBox[{"e", ".", "g", "."}], ",", " ", 
        RowBox[{
         RowBox[{"-", "i"}], " ", "q", " ", 
         SubscriptBox["A", "\[Mu]"], " ", "*", " ", "expr"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Note", ":", " ", 
        RowBox[{"This", " ", "A", " ", "has", " ", "a", " ", "DOWN", " ", 
         RowBox[{"(", "Covariant", ")"}], " ", "index", " ", "matching", " ", 
         "the", " ", "derivative"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"gaugeCorrection", "=", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "q", " ", 
        RowBox[{"A", "[", 
         RowBox[{"\[ScriptCapitalD]", "[", "idx", "]"}], "]"}], "*", 
        "expr"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", "Add", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"gravitationalPart", "+", "gaugeCorrection"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.978646744556492*^9, 3.978646885622224*^9}, 
   3.978724934490802*^9, {3.978795290664665*^9, 3.9787954073020678`*^9}, 
   3.9787954931896*^9, {3.9787956971832857`*^9, 3.978795753281424*^9}, {
   3.98080046313244*^9, 3.9808005578038263`*^9}, {3.9913109357638493`*^9, 
   3.991310941078394*^9}},ExpressionUUID->"3de2c0a4-4890-4dcd-8310-\
578ba58e364c"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Electrodynamics Demos", "Section",
 CellChangeTimes->{{3.978700005346057*^9, 3.9787000089781*^9}, {
   3.9787963301955833`*^9, 3.9787963317746277`*^9}, 3.9788004955698223`*^9, 
   3.978821216010556*^9},ExpressionUUID->"2c02b0be-4c78-4b2a-a1b3-\
4a70d6e26bf1"],

Cell[CellGroupData[{

Cell["Covariance of the Covariant Derivative", "Subsection",
 CellChangeTimes->{{3.978823576434066*^9, 3.978823591975399*^9}, {
  3.9788236656529293`*^9, 3.978823667365944*^9}, {3.9788607083047037`*^9, 
  3.978860710361669*^9}},ExpressionUUID->"26cab6eb-fabb-4147-9085-\
2e72df92e4fa"],

Cell["\<\
Above, we subjected \[Psi] to gauge transformation manually. Automate that \
calculation:\
\>", "Text",
 CellChangeTimes->{{3.978820844121111*^9, 3.97882093662414*^9}, {
   3.978821545485203*^9, 3.978821615299986*^9}, {3.978822440304517*^9, 
   3.978822451496654*^9}, {3.97889393859801*^9, 3.9788939593450127`*^9}, {
   3.978995036342866*^9, 3.97899503858642*^9}, {3.9793493785568047`*^9, 
   3.979349410480792*^9}, {3.9808005731367903`*^9, 3.980800630329091*^9}, 
   3.9913109605697412`*^9},ExpressionUUID->"db673d5e-f1b1-4938-a6c8-\
a394f4250e7e"],

Cell[BoxData[
 RowBox[{"(", 
  RowBox[{"cde", "=", 
   RowBox[{"CD", "[", 
    RowBox[{"\[Psi]", ",", 
     RowBox[{"x", "[", 
      RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", "q", ",", 
     "A"}], "]"}]}], ")"}]], "Input",
 CellChangeTimes->{{3.978646926181177*^9, 3.978646943909356*^9}, {
   3.97864698544555*^9, 3.97864700656507*^9}, 3.97880072568736*^9, {
   3.978818102147591*^9, 3.978818102997529*^9}, {3.978820978904854*^9, 
   3.978820983247849*^9}, 3.978821610399053*^9},
 CellLabel->"In[36]:=",ExpressionUUID->"e8d9c61f-9eb0-4945-ad72-568d5242b5c5"],

Cell["Starting with the gauge transformations", "Text",
 CellChangeTimes->{{3.978820911086568*^9, 3.978820944821334*^9}, {
   3.978822642442547*^9, 3.9788226595359287`*^9}, {3.9789950515919724`*^9, 
   3.978995052535986*^9}, 
   3.979349421152651*^9},ExpressionUUID->"bfcbf30b-9a8f-4a6b-b946-\
5c4170da5fd0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["\[Psi]", "_"], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{
       "i", "\[VeryThinSpace]", "q", "\[VeryThinSpace]", 
        "\[CapitalLambda]"}]}]], "\[Psi]", "    ", "and", "    ", 
     SubscriptBox[
      OverscriptBox["A", "_"], 
      RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}], "=", 
    RowBox[{
     SubscriptBox["A", 
      RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], "+", 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], "\[CapitalLambda]", " "}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.978637538672182*^9, 3.97863778411996*^9}, {
   3.9786379712287197`*^9, 3.9786379796646557`*^9}, {3.978821290744693*^9, 
   3.978821330476513*^9}, {3.978822473550243*^9, 3.978822480144888*^9}, {
   3.978822548622191*^9, 3.978822571486229*^9}, 3.978822679099642*^9, {
   3.978822842709276*^9, 3.978822852781521*^9}, {3.979349441948009*^9, 
   3.979349443572904*^9}},ExpressionUUID->"bcfea902-d337-4bda-b9ad-\
532a59a7d4c0"],

Cell[BoxData[
 RowBox[{"gaugeTransforms", "=", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Psi]", "->", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
       "\[ImaginaryI]", "\[VeryThinSpace]", "q", "\[VeryThinSpace]", 
        "\[CapitalLambda]"}]], "\[Psi]"}]}], ",", 
    RowBox[{"(*", " ", 
     RowBox[{"RHS", " ", "=", " ", 
      OverscriptBox["\[Psi]", "_"]}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"A", "[", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], "]"}], ":>", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], "]"}], "+", 
      RowBox[{"Partials", "[", "\[VeryThinSpace]", 
       RowBox[{"\[CapitalLambda]", ",", 
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], 
       "]"}]}]}]}], 
   RowBox[{"(*", " ", 
    RowBox[{"RHS", " ", "=", " ", 
     OverscriptBox["A", "_"]}], " ", "*)"}], "}"}]}]], "Input",
 CellChangeTimes->{{3.978821001702631*^9, 3.978821044361678*^9}, {
   3.978821351660639*^9, 3.9788214177368813`*^9}, {3.978821448541462*^9, 
   3.97882146930516*^9}, {3.978821639276532*^9, 3.978821662429945*^9}, {
   3.978822191621005*^9, 3.9788221929215384`*^9}, 3.978822231151826*^9, {
   3.978823334810932*^9, 3.978823335460462*^9}, 3.978825160269917*^9, {
   3.991311002481147*^9, 3.9913110483350677`*^9}, {3.991311127904272*^9, 
   3.991311133000822*^9}},ExpressionUUID->"727a63da-aa90-45dd-adc5-\
0ffe24da003b"],

Cell["prove that the covariant derivative", "Text",
 CellChangeTimes->{{3.978822728959449*^9, 3.978822748830817*^9}, {
  3.978822863916007*^9, 
  3.978822865933402*^9}},ExpressionUUID->"50c162a4-95b1-4c2d-9f84-\
dcfd4b83f679"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["D", "\[Mu]"], "\[Psi]"}], "\[Congruent]", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], "\[Psi]"}], "-", 
    RowBox[{"i", "\[VeryThinSpace]", "q", "\[VeryThinSpace]", 
     SubscriptBox["A", "\[Mu]"], "\[Psi]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.9786435032056303`*^9, 3.978643606837364*^9}, {
  3.978822966772187*^9, 
  3.97882296838054*^9}},ExpressionUUID->"7eeea367-8db9-4bb8-83e0-\
0b1addaa1107"],

Cell["transforms exactly as does \[Psi]", "Text",
 CellChangeTimes->{{3.978822755950194*^9, 3.9788227570842133`*^9}, {
  3.978822823242772*^9, 3.978822836885271*^9}, {3.980800658140978*^9, 
  3.9808006645445232`*^9}},ExpressionUUID->"73ecf68b-5a23-4059-bef3-\
42897e2d257f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["D", "\[Mu]"], 
    OverscriptBox["\[Psi]", "_"]}], "=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{
      "i", "\[VeryThinSpace]", "q", "\[VeryThinSpace]", 
       "\[CapitalLambda]"}]}]], 
    SubscriptBox["D", "\[Mu]"], "\[Psi]"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.9786436192725773`*^9, 3.9786437727905197`*^9}, {
  3.978643806573044*^9, 3.978643946308076*^9}, {3.978644002327197*^9, 
  3.978644220022155*^9}, {3.978644291740561*^9, 3.9786443538434763`*^9}, {
  3.978644388511799*^9, 3.978644510127365*^9}, {3.978822775213642*^9, 
  3.978822798371068*^9}},ExpressionUUID->"19bf54b0-a557-49f3-bd18-\
9d2c3b9dbd1d"],

Cell[TextData[{
 "Need one rule for the charge constant. Everything else is already in the \
toolkit\[CloseCurlyQuote]s ",
 StyleBox["differentiationRules", "Input"],
 ":"
}], "Text",
 CellChangeTimes->{{3.978822882032498*^9, 3.9788229273306627`*^9}, {
  3.978823009564211*^9, 3.978823010008813*^9}, {3.9793494700351887`*^9, 
  3.979349481993554*^9}, {3.9808006718764544`*^9, 
  3.98080069246719*^9}},ExpressionUUID->"63449289-cd0b-41a0-9449-\
cf2944636b07"],

Cell[BoxData[
 RowBox[{"constantRules", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Partials", "[", 
     RowBox[{"q", ",", 
      RowBox[{"x", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]_", "]"}], "]"}]}], "]"}], " ",
     ":>", " ", "0"}], "}"}]}]], "Input",
 CellChangeTimes->{{3.9788220405709257`*^9, 3.9788220914844437`*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"3f172635-6ee5-4a70-8a61-eb7d220f695e"],

Cell[BoxData[
 RowBox[{"transformedCde", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"cde", " ", "/.", " ", "gaugeTransforms"}], " ", "//.", " ", 
       "differentiationRules"}], "/.", "constantRules"}], ")"}], "//", 
    "Expand"}], "//", "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.978822102593217*^9, 3.978822112777665*^9}, {
   3.9788222776342163`*^9, 3.9788222792555733`*^9}, {3.9788223692243032`*^9, 
   3.97882240547611*^9}, 3.978823022815748*^9, {3.978823148683112*^9, 
   3.97882316041686*^9}, {3.978823349405294*^9, 3.9788233500015306`*^9}, {
   3.978858170112883*^9, 3.97885818491053*^9}, {3.980088454761086*^9, 
   3.9800884587628*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"b0ec1902-d500-41fa-8f61-43ad9f584e95"],

Cell[BoxData[
 RowBox[{"transformedCde", "===", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
    "\[ImaginaryI]", "\[VeryThinSpace]", "q", "\[VeryThinSpace]", 
     "\[CapitalLambda]"}]], "cde"}]}]], "Input",
 CellChangeTimes->{{3.978823164654051*^9, 3.97882321873451*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"799324fc-d50c-48e5-bdb5-66f0d5e3b2d1"],

Cell[TextData[StyleBox["QED\[NonBreakingSpace]\[FilledSquare]",
 FontColor->RGBColor[0.14, 0.8, 0.14]]], "Text",
 CellChangeTimes->{{3.978823232236299*^9, 
  3.978823321181185*^9}},ExpressionUUID->"ad7c97ba-d85c-4acc-97c1-\
ef3e695d61dd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Invariance of the Field-Strength Tensor", "Subsection",
 CellChangeTimes->{{3.978823650174912*^9, 3.9788236824567013`*^9}, {
  3.978823896569426*^9, 
  3.978823898592578*^9}},ExpressionUUID->"13a5b2c2-e39a-477b-935b-\
59de3331ef7e"],

Cell[TextData[{
 "The field-strength tensor, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"9a78e8c4-fc08-4a8e-92f9-ce12438ddaad"],
 ", aka ",
 StyleBox["Faraday", "Input"],
 ", is defined as follows"
}], "Text",
 CellChangeTimes->{{3.978824061078446*^9, 
  3.978824098440377*^9}},ExpressionUUID->"8f3ecd75-5900-473e-ad73-\
516a0e7c21fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"F", "[", 
   RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "=", 
  RowBox[{
   RowBox[{"Partials", "[", 
    RowBox[{
     RowBox[{"A", "[", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "]"}], ",", " ", 
     RowBox[{"x", "[", 
      RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], "]"}], " ", "-",
    " ", 
   RowBox[{"Partials", "[", 
    RowBox[{
     RowBox[{"A", "[", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], "]"}], ",", " ", 
     RowBox[{"x", "[", 
      RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.978823709235116*^9, 3.9788237415322437`*^9}, {
  3.978824044627816*^9, 3.978824051061049*^9}, {3.978824190166666*^9, 
  3.9788241975067244`*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"097fd1ac-3cb5-4783-9706-68f9adb7f946"],

Cell[TextData[{
 "usually presented as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], 
     SubscriptBox["A", 
      RowBox[{"\[VeryThinSpace]", "\[Nu]"}]]}], "-", 
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Nu]"], 
     SubscriptBox["A", 
      RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}]}], TraditionalForm]],
  ExpressionUUID->"e0b7b22c-4b20-45e1-9116-61a69b483886"],
 " to make the indices line up (Wolfram alphabetizes the output, putting the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", ",", "\[Nu]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bb5037ef-cd38-4fba-b18e-10ffe896b75a"],
 " term before the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Nu]", ",", "\[Mu]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f56d9562-c734-4603-9381-5befcb8889ff"],
 " term)."
}], "Text",
 CellChangeTimes->{{3.978824215276784*^9, 3.978824267149712*^9}, {
  3.979349527991433*^9, 3.979349529193584*^9}, {3.980800712383025*^9, 
  3.98080071364931*^9}, {3.991311144239114*^9, 
  3.9913111899021797`*^9}},ExpressionUUID->"686c6855-f4f0-4413-b371-\
5d14d6d91172"],

Cell["Now, subject it to the gauge transform:", "Text",
 CellChangeTimes->{{3.9788242749841127`*^9, 
  3.9788242924403057`*^9}},ExpressionUUID->"bf1fd84a-386a-4f24-b9a9-\
614cbd977b06"],

Cell[BoxData[
 RowBox[{
  RowBox[{"F", "[", 
   RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "/.", " ", 
  "gaugeTransforms"}]], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"41f7d312-8c5c-4141-b7fe-24720dee4831"],

Cell[TextData[{
 "See that it doesn\[CloseCurlyQuote]t change by invoking the toolkit\
\[CloseCurlyQuote]s ",
 StyleBox["ExpandDerivatives", "Input"],
 ":"
}], "Text",
 CellChangeTimes->{{3.978824312009261*^9, 
  3.978824333879499*^9}},ExpressionUUID->"91ab7ee2-27ab-479b-9a7a-\
fcd44e4d6e2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"F", "[", 
     RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "/.", " ", "gaugeTransforms"}], 
   ")"}], " ", "//", " ", "ExpandDerivatives", " "}]], "Input",
 CellChangeTimes->{{3.978823798335211*^9, 3.9788238192571917`*^9}, 
   3.978823885830079*^9, {3.9800885293613997`*^9, 3.9800885334193583`*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"3e9266b1-4af3-4050-81a7-4a26104483a3"],

