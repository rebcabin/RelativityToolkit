Cell[CellGroupData[{

Cell["Appendix: Spin Connection as Gravitational Gauge", "Section",
 CellChangeTimes->{{3.9784634251754417`*^9, 3.978463431650586*^9}, {
  3.978467221274311*^9, 3.978467228737336*^9}, {3.9785311553116007`*^9, 
  3.9785311740560427`*^9}, {3.978531214043825*^9, 3.978531227439899*^9}, {
  3.978531309854751*^9, 3.97853131020317*^9}, {3.98078819672471*^9, 
  3.9807881969255943`*^9}},ExpressionUUID->"8b07ab75-9d83-4f32-9461-\
b8e99837bcf0"],

Cell[TextData[{
 "General relativity is often compared to standard gauge theories, but there \
is a fundamental distinction. In theories like electromagnetism or quantum \
chromodynamics, forces arise from connections on internal or attached spaces, \
i.e., fibre bundles, e.g., ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", 
    RowBox[{"(", "1", ")"}]}], TraditionalForm]],ExpressionUUID->
  "41a1d3a5-723b-4649-8dbf-e6a8acdffcbb"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "c91148c8-1c78-4296-874f-c05abcb2d9bb"],
 ", defined over spacetime. In standard general relativity, gravitational \
forces arise from the Levi-Civita connection, which is inextricably linked to \
the tangent bundle of the spacetime geometry itself."
}], "Text",
 CellChangeTimes->{{3.9808029465579147`*^9, 3.980802991430871*^9}, {
  3.991311888533691*^9, 
  3.991311915502317*^9}},ExpressionUUID->"bee71cfa-ab19-4388-8d9c-\
9cc558065ec8"],

Cell["\<\
To formulate gravitation as a strict gauge theory functionally equivalent to \
the Standard Model forces, one must identify the conserved currents \
corresponding to local gauge symmetries. The definitive literature \
demonstrates how this is achieved:\
\>", "Text",
 CellChangeTimes->{{3.9808029465579147`*^9, 
  3.9808029813411827`*^9}},ExpressionUUID->"b9a92964-4e0a-4e6c-8064-\
86ee61fe2045"],

Cell[CellGroupData[{

Cell[TextData[{
 "Friedrich W. ",
 StyleBox["Hehl",
  IgnoreSpellCheck->True],
 " et al., ",
 StyleBox["General Relativity with Spin and Torsion: Foundations and \
Prospects",
  FontSlant->"Italic"],
 " (Rev. Mod. Phys. 48, 393, 1976)"
}], "Item",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.978466361194891*^9}, {
   3.9784673056989098`*^9, 
   3.978467354942222*^9}},ExpressionUUID->"d42a3ca6-0f7d-47c3-9359-\
6874822f94ed"],

Cell["which shows that:", "ItemParagraph",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.978466361194891*^9}, {
   3.9784673056989098`*^9, 3.978467385382815*^9}, {3.978792446339141*^9, 
   3.978792447172833*^9}, {3.9787926595309887`*^9, 
   3.978792660218268*^9}},ExpressionUUID->"a73a9876-1fbd-482e-9c22-\
bc8c848e8035"],

Cell["\<\
Invariance under general transformations (diffeomorphisms), implies \
conservation of the energy-momentum tensor.\
\>", "Subitem",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.9784663902544317`*^9}, {
   3.978467723999647*^9, 3.978467743088092*^9}, {3.978792495856393*^9, 
   3.978792500167569*^9}},ExpressionUUID->"e27bbfa1-6988-428c-98d9-\
bdafe05f0bdb"],

Cell["\<\
Invariance under local Lorentz transformations implies conservation of the \
spin angular momentum tensor (the spin current).\
\>", "Subitem",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.9784664333289547`*^9}, {
   3.978467424580559*^9, 3.9784674399227*^9}, {3.9784677547756577`*^9, 
   3.9784677558930273`*^9}},ExpressionUUID->"ffef7d33-5cb1-492d-bbdd-\
8d514fcd685e"],

Cell["\<\
Standard Einstein GR with vanishing torsion, which we assumed in this series \
of notebooks, collapses the two symmetries and hides the independent spin \
current.\
\>", "Subitem",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.978466451046755*^9}, {
   3.978467764934806*^9, 3.9784678683187*^9}, {3.978896076146283*^9, 
   3.978896076338889*^9}},ExpressionUUID->"ae825c12-7bee-4d85-8900-\
83a223968980"]
}, Open  ]],

Cell["Some other references are", "Text",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.978463822489818*^9}, 
   3.978463853492107*^9, {3.97879263828334*^9, 
   3.978792643265484*^9}},ExpressionUUID->"bd8117b2-3d13-414f-b8ce-\
6391e381f873"],

Cell[CellGroupData[{

Cell[TextData[{
 " Sean Carroll, ",
 StyleBox["Spacetime and Geometry: An Introduction to General Relativity",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 
   3.978463851463154*^9}},ExpressionUUID->"9c9f3996-4222-4a12-ab63-\
24c6e6811ef6"],

Cell["\<\
Appendix J, Page 486\[VeryThinSpace]ff, under local Lorentz invariance, \
tetrads, and the spin connection:\
\>", "Subitem",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.97846430622845*^9}, {
   3.978466130000834*^9, 3.97846617162918*^9}, {3.978467658624906*^9, 
   3.9784676636610527`*^9}},ExpressionUUID->"47b81c5e-7466-4414-923f-\
9d96f0db6d9a"],

Cell[TextData[{
 "Spin connection ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Omega]", "\[Mu]", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"a", "\[VeryThinSpace]", "b"}]}]], TraditionalForm]],
  ExpressionUUID->"e9336ba3-8ca5-4d1e-90fb-c0c62756493b"],
 ", arising from non-coordinate basis sets, acts as the gauge field for local \
Lorentz transformations. Carroll also explains that in standard GR the \
torsion tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["T", 
     RowBox[{"\[VeryThinSpace]", "\[Lambda]"}]], 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  ExpressionUUID->"a2057e92-422b-4a77-9933-c88cddc68b1b"],
 " is zero, locking the Levi-Civita connection (Christoffel symbols) to the \
metric and forcing the energy-momentum tensor to be symmetric, absorbing spin \
effects via symmetrization."
}], "ItemParagraph",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.978466361194891*^9}, {
   3.9784673056989098`*^9, 3.9784673452325478`*^9}, {3.978467678759273*^9, 
   3.978467692377183*^9}, {3.9785316949711523`*^9, 3.978531709031754*^9}, {
   3.978531983790666*^9, 3.978532035877861*^9}, {3.9785322926375437`*^9, 
   3.97853232201047*^9}, {3.978532946114335*^9, 3.978532986756562*^9}, {
   3.97853325255888*^9, 3.978533302893488*^9}, {3.9787926796343193`*^9, 
   3.9787927361046057`*^9}, {3.978995739017064*^9, 
   3.978995740911697*^9}},ExpressionUUID->"97d54446-4cbf-430e-a1e8-\
cb1b09e4fe1f"],

Cell[TextData[{
 "Also see Hehl above, Equation 3.8 and Sections III.B and III.C. In other \
references, this may be called ",
 StyleBox["Belinfante-Rosenfeld symmetrization",
  FontSlant->"Italic"],
 "."
}], "Subitem",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.978466361194891*^9}, {
   3.9784673056989098`*^9, 3.9784673452325478`*^9}, {3.978467678759273*^9, 
   3.978467692377183*^9}, {3.9785316949711523`*^9, 3.978531709031754*^9}, {
   3.978531983790666*^9, 3.978532035877861*^9}, {3.9785322926375437`*^9, 
   3.97853232201047*^9}, {3.978532946114335*^9, 3.978532986756562*^9}, {
   3.97853325255888*^9, 3.978533275318653*^9}, {3.9785333055095987`*^9, 
   3.978533318221752*^9}, {3.978533571662957*^9, 3.978533581186043*^9}, {
   3.978792752153208*^9, 3.978792764744529*^9}, {3.979350187889584*^9, 
   3.979350189595763*^9}},ExpressionUUID->"5448738e-eb7e-4eb5-b32c-\
7dea5b11e120"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "T. W. B. Kibble, ",
 StyleBox["Lorentz Invariance and the Gravitational Field",
  FontSlant->"Italic"],
 " (J. Math. Phys. 2, 212, 1961)"
}], "Item",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 
   3.978466486720623*^9}},ExpressionUUID->"0a9b9626-464b-4f9c-8d94-\
07d51225c9e0"],

Cell[TextData[StyleBox["Foundational paper deriving gravitation as the gauge \
theory of the Poincar\[EAcute] group, i.e., translations\[NonBreakingSpace]+\
\[NonBreakingSpace]Lorentz",
 FontSlant->"Italic"]], "Subitem",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.978466510390306*^9}, {
   3.9784669609195147`*^9, 3.978467137541203*^9}, {3.978467883335359*^9, 
   3.9784679272681417`*^9}, {3.978468065503084*^9, 3.97846807401269*^9}, {
   3.978792800047453*^9, 3.97879280618641*^9}, {3.980089506577505*^9, 
   3.980089532812252*^9}},ExpressionUUID->"32e2ca27-b4f9-4e82-a0b0-\
78a1f5617ef1"],

Cell[TextData[{
 "Kibble shows that (1) gauging ",
 StyleBox["translations",
  FontSlant->"Italic"],
 " in Poincar\[EAcute] yields the tetrad field, defining the metric and \
conserving energy-momentum, and that (2) gauging the Lorentz ",
 StyleBox["boost+rotation subgroup",
  FontSlant->"Italic"],
 " yields the spin connection, permitting transformation of spinors, \
otherwise impossible."
}], "ItemParagraph",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.978466510390306*^9}, {
   3.9784669609195147`*^9, 3.978467137541203*^9}, {3.978467883335359*^9, 
   3.9784679272681417`*^9}, {3.978468090057158*^9, 3.978468133493339*^9}, 
   3.978533444804373*^9, {3.978535397364641*^9, 3.978535417858979*^9}, {
   3.9785354522594013`*^9, 3.9785354883804207`*^9}, {3.97879282536421*^9, 
   3.978792895879323*^9}, {3.978995787691255*^9, 
   3.9789958268258257`*^9}},ExpressionUUID->"a4c8ac93-e4a4-4b96-873c-\
fa97ec500743"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Conclusion", "Section",
 CellChangeTimes->{{3.9775359255386477`*^9, 
  3.977535927492813*^9}},ExpressionUUID->"8fa93b39-5ef8-4df8-b0c2-\
f43f894f9a34"],

Cell[TextData[{
 "The Relativity Toolkit (v1.11.0) can process hybrid objects, such as the \
charged vector field ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", 
    RowBox[{" ", "\[Alpha]"}]], TraditionalForm]],ExpressionUUID->
  "ecf68386-a186-4640-b6a2-1329e54e7554"],
 ", with simultaneous geometric and internal phase corrections. While this \
notebook focuses on the Abelian ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", 
    RowBox[{"(", "1", ")"}]}], TraditionalForm]],ExpressionUUID->
  "959d95e2-01e1-4a72-ab3d-b221ededf160"],
 " gauge group, the underlying computational logic is a foundation for future \
non-Abelian gauge theories. "
}], "Text",
 CellChangeTimes->{{3.978896777019384*^9, 3.9788968560050497`*^9}, {
  3.979352497814191*^9, 3.979352515481464*^9}, {3.980637979932774*^9, 
  3.980638005592092*^9}, {3.980788162442437*^9, 3.980788175616647*^9}, {
  3.9808009635492773`*^9, 3.980801017181118*^9}, {3.9808010587483597`*^9, 
  3.980801126690868*^9}, {3.980803035443789*^9, 
  3.9808030598734407`*^9}},ExpressionUUID->"30c5ee8b-f390-470c-a89e-\
e3eb961ebed3"]
}, Open  ]],

