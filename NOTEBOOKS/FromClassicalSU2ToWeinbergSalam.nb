  RowBox[{
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[VeryThinSpace]", "\[Lambda]"}]], 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], "=", 
   RowBox[{
    RowBox[{"{", GridBox[{
       {"\[Lambda]"},
       {
        RowBox[{"\[Mu]", " ", "\[Nu]"}]}
      }], "}"}], "+", 
    SubscriptBox[
     SuperscriptBox["K", 
      RowBox[{"\[VeryThinSpace]", "\[Lambda]"}]], 
