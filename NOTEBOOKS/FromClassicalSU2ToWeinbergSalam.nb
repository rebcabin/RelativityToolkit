  3.978860991222589*^9, 3.978861009149042*^9}, {3.978868299654079*^9, 
  3.978868375119767*^9}},ExpressionUUID->"f09d091f-5427-4c81-ad26-\
335b3c997d20"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"term1", " ", "=", " ", 
   RowBox[{"CD", "[", 
    RowBox[{
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", " ", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"x", "[", 
      RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]", "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"term2", " ", "=", " ", 
   RowBox[{"CD", "[", 
    RowBox[{
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", " ", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]", "]"}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"x", "[", 
      RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"comm", " ", "=", " ", 
    RowBox[{"term1", " ", "-", " ", "term2"}]}], ")"}], "//", 
  "TensorForm"}]}], "Input",
 CellChangeTimes->{{3.978860787346716*^9, 3.978860806799048*^9}, {
  3.978860991222589*^9, 3.978861009149042*^9}, {3.978868299654079*^9, 
