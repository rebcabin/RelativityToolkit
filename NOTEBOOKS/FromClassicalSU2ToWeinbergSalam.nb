Cell["\<\
Here is a concise derivation of the Fundamental Theorem of Riemannian \
Geometry, shorter than the derivation in our earlier notebooks\
\>", "Text",
 CellChangeTimes->{{3.978995565032127*^9, 3.9789956024329977`*^9}, {
   3.979350086525177*^9, 3.9793500973619347`*^9}, {3.980789061655262*^9, 
