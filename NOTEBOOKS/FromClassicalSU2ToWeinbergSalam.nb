7b9c5c83d43d"],

Cell[TextData[{
 StyleBox["If we allow torsion, as in Einstein-Cartan theory or as in the \
Appendix, the present tautology is not valid. In such cases, we must \
introduce the ",
  FontSlant->"Italic"],
 StyleBox["contortion tensor",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["K", TraditionalForm]],ExpressionUUID->
  "6158871f-67e4-44e0-9834-338cd6280095"]
}], "Item",
