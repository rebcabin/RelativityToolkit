Cell[BoxData[
 RowBox[{"calculatedRiemann", "=", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"comm", "//", "\[IndentingNewLine]", "ExpandDerivatives"}], "//",
          "\[IndentingNewLine]", "Expand"}], "//", "\[IndentingNewLine]", 
        "CanonicalizeIndices"}], ")"}], "//.", "\[IndentingNewLine]", " ", 
      "torsionRules"}], " ", ")"}], "//", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ExtractCoefficient", "[", 
      RowBox[{"#", ",", "A"}], "]"}], "&"}]}], "//", "\[IndentingNewLine]", 
   "TensorForm"}]}]], "Input",
 CellChangeTimes->{{3.978860787346716*^9, 3.978860821005308*^9}, 
