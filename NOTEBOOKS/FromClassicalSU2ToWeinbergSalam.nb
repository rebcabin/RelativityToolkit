6d5149ea04e7"],

Cell[TextData[{
 StyleBox["Charged Vector Field Covariance",
  FontSlant->"Italic"],
 ": the covariance of a generic charged vector field ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", "\[Alpha]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d3699f9b-d3c6-49d7-ba38-ec02c67beea4"],
 " transforms covariantly under simultaneous spacetime coordinate changes and \
internal ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", 
    RowBox[{"(", "1", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "81f6837a-5dff-4b04-9047-02083c34833e"],
 " phase rotations. "
}], "Item",
 CellChangeTimes->{
