       RowBox[{"!", 
        RowBox[{"OrderedQ", "[", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}], "]"}]}]}], ":>", 
      RowBox[{"g", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalU]", "[", "b", "]"}], ",", 
        RowBox[{"\[ScriptCapitalU]", "[", "a", "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Permissive", " ", "Contraction", " ", 
       RowBox[{"(", 
        RowBox[{"All", " ", "4", " ", "Alignments"}], ")"}]}], "*)"}], 
     "\[IndentingNewLine]", 
