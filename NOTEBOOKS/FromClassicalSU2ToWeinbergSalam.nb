Cell[TextData[{
 "Fetch the Levi-Civita connection via a new ",
 StyleBox["ruleLeviCivita", "Input"],
 ", added to Relativity Toolkit v1.9.0:"
}], "Text",
 CellChangeTimes->{{3.978723120871808*^9, 3.97872312087333*^9}, {
   3.978723165469028*^9, 3.978723207620385*^9}, 3.9787233650029182`*^9, {
