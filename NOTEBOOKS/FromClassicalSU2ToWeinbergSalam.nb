Cell["Abstract ", "Section",
 CellChangeTimes->{{3.97889635012245*^9, 3.978896351879611*^9}, 
   3.979349058650394*^9},ExpressionUUID->"01d70810-8ee9-4c00-848e-\
4511290397ab"],

Cell["\<\
This notebook extends the Relativity Toolkit (v1.11.0) to basic Abelian \
scalar gauge theory. We implement a generalized covariant derivative operator \
that simultaneously processes spacetime geometry and internal phase geometry. \
We demonstrate this implementation through four automated computational \
proofs:\
\>", "Text",
 CellChangeTimes->{{3.980797480290036*^9, 
  3.9807975153188868`*^9}},ExpressionUUID->"ffda4afc-61ff-426e-8851-\
0168342cbfad"],

Cell[TextData[{
 StyleBox["Metric Compatibility",
  FontSlant->"Italic"],
 ": the Levi-Civita connection uniquely nulls the gradient of the metric (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Del]", "g"}], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "4f31d44a-a481-435d-9446-363ac6f292d6"],
 ") "
}], "Item",
