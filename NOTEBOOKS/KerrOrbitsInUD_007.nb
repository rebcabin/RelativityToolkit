Cell["Riemann of the Ansatz", "Subsection",
 CellChangeTimes->{{3.97954730465662*^9, 
  3.979547310198833*^9}},ExpressionUUID->"3a5cb557-54d9-4e90-a5c9-\
d4ee329689db"],

Cell["\<\
Here we see the leaf counts of the 88 non-zero components of the Kerr \
curvature tensor. Symmetries and antisymmetries are immediately visible.\
\>", "Text",
 CellChangeTimes->{{3.979578480393873*^9, 3.9795784870517263`*^9}, {
  3.979578517967389*^9, 
  3.979578552792534*^9}},ExpressionUUID->"ca639284-f0ce-4250-ad0a-\
6ea8496a221c"],

