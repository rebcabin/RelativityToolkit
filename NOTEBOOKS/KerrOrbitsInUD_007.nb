   3.979469275296583*^9, 
   3.979469280868532*^9}},ExpressionUUID->"c0025e1c-429c-4dc8-ae7a-\
bbe673ef14de"],

Cell[TextData[{
 "physical definitions: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    FractionBox["J", 
     RowBox[{"M", "\[VeryThinSpace]", "c"}]]}], TraditionalForm]],
  ExpressionUUID->"6102075c-a782-4649-b9ef-2c7ab53896ae"],
 ", units of length = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{"Joule", "\[CenterDot]", "s"}], 
      RowBox[{"kg", "\[CenterDot]", 
       RowBox[{"m", " ", "/", " ", "s"}]}]], "=", 
     RowBox[{
      FractionBox[
       RowBox[{"kg", "\[CenterDot]", 
        SuperscriptBox["m", "2"], "\[CenterDot]", 
        RowBox[{"s", "/", 
         SuperscriptBox["s", "2"]}]}], 
       RowBox[{"kg", "\[CenterDot]", 
        RowBox[{"m", " ", "/", " ", "s"}]}]], "=", "m"}]}], ")"}], 
   TraditionalForm]],ExpressionUUID->"89309cd4-36c2-4aed-a107-5741cf3123f5"],
 "."
}], "Item",
 CellChangeTimes->{
  3.979381056625122*^9, {3.9793810927988873`*^9, 3.979381127690946*^9}, {
