Cell[BoxData[{
 RowBox[{
  RowBox[{"kerrInverse", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Inverse", "[", "kerrMetric", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrInvRules", " ", "=", " ", 
   RowBox[{"Join", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"MatrixToUDRules", "[", 
      RowBox[{
      "kerrInverse", ",", " ", "gUU", ",", " ", "\[ScriptCapitalU]", ",", " ",
        "coords"}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"gUU", "[", "__", "]"}], " ", "->", " ", "0"}], "}"}]}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9791222556381598`*^9, 3.979122255639599*^9}, {
  3.9791223362049627`*^9, 3.979122370298142*^9}, {3.9791224068024817`*^9, 
  3.979122413092557*^9}, {3.9791674737807207`*^9, 3.979167480258341*^9}},
 CellLabel->
