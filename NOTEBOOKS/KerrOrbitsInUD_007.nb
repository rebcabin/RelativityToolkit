Cell[TextData[{
 "The components of the Ricci tensor are large, unwieldy expressions. Though \
not challenging for Wolfram to write, we did not see how to get Wolfram to \
solve. It\[CloseCurlyQuote]s not instructive to print them out, but it is \
instructive to illustrate how big and unstructured they are, to make the \
point that we should not try to solve them directly, but find another way. We \
won\[CloseCurlyQuote]t be using the ",
 StyleBox["vacuumFieldEquations", "Input"],
 " above in the following sections, which take a different approach. "
}], "Text",
 CellChangeTimes->{{3.979144624214087*^9, 3.979144689387373*^9}, {
   3.979144968002125*^9, 3.979144973926887*^9}, {3.979145275222885*^9, 
   3.979145302557148*^9}, {3.979145336849456*^9, 3.979145370551711*^9}, {
   3.979164978453265*^9, 3.979164988856801*^9}, {3.979166321239839*^9, 
   3.9791663494891033`*^9}, 3.979219254586623*^9, {3.979296547752412*^9, 
   3.9792966013099813`*^9}, {3.979296635012486*^9, 
   3.979296693283353*^9}},ExpressionUUID->"19847788-4026-4a5c-807a-\
807770a39c59"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Exhibit a Component, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"r", "\[VeryThinSpace]", "r"}]}]], TraditionalForm]],
  ExpressionUUID->"158a5634-c7a0-4d14-ae86-34e33d409cf5"]
}], "Subsubsection",
