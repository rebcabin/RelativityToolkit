  3.979167597572651*^9}},ExpressionUUID->"f451e7f3-3f22-4dc1-85b6-\
4861624664eb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kerrRules", " ", "=", " ", 
   RowBox[{"Join", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"MatrixToUDRules", "[", 
      RowBox[{
      "kerrMetric", ",", " ", "gDD", ",", " ", "\[ScriptCapitalD]", ",", " ", 
       "coords"}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"gDD", "[", "__", "]"}], " ", "->", " ", "0"}], "}"}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9791222556381598`*^9, 3.979122255639599*^9}, {
