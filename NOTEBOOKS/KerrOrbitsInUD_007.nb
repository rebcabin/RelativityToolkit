Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"weakMetricInv", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Inverse", "[", "weakMetric", "]"}], "]"}]}], ")"}], "//", 
  "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.979076962136963*^9, 3.9790771243117867`*^9}, {
