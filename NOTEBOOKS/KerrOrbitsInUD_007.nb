Cell[BoxData[{
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"UnitConvert", "[", 
     RowBox[{
      RowBox[{"1000", "*", "timeUnitSun"}], ",", "\"\<Seconds\>\""}], "]"}], 
    ",", "\"\<1000 sim ticks around the Sun in proper time is :\>\""}], "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"UnitConvert", "[", 
     RowBox[{
      RowBox[{"1000", "*", "timeUnitSgr"}], ",", "\"\<Hours\>\""}], "]"}], 
    ",", "\"\<1000 sim ticks around Sag A* in proper time is :\>\""}], "]"}], 
  ";"}]}], "Input",
