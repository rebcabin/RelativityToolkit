Cell[CellGroupData[{

Cell["Time Dilation and the Heads-Up Display ", "Subsection",
 CellChangeTimes->{{3.979404393596136*^9, 3.979404407706079*^9}, {
  3.979433312702861*^9, 3.9794333219453897`*^9}, {3.9794688177236567`*^9, 
  3.979468850884684*^9}},ExpressionUUID->"f95f98e6-2a94-494c-9f59-\
f3d8b94bb1bd"],

Cell[TextData[{
 "The \[OpenCurlyDoubleQuote]Time Dilation Input\[CloseCurlyDoubleQuote] \
slider controls the ratio of time flow to spatial motion. \
It\[CloseCurlyQuote]s a \[OpenCurlyDoubleQuote]mix knob\
\[CloseCurlyDoubleQuote] between \[OpenCurlyDoubleQuote]moving through time\
\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]moving through space.\
\[CloseCurlyDoubleQuote] For most stable orbits, leave this slider at 1.0. \
The physics engine will automatically calculate the true time dilation \
(Physical Energy ",
 Cell[BoxData[
  FormBox["E", TraditionalForm]],ExpressionUUID->
  "614e03d6-0a66-4495-8e27-a3c1a7f43673"],
 ") required to keep the particle normalized ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"u", ".", "u"}], "=", 
     RowBox[{"-", "1"}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "1cafa355-2bda-46a6-bfc0-6fbd9525589f"],
 ". Both ",
 Cell[BoxData[
  FormBox["E", TraditionalForm]],ExpressionUUID->
  "dc8bdd83-ab55-45be-8906-309771d30f9e"],
 " and the calculated norm appear in the Heads-Up Display (HUD) that labels \
the plots. Unphysical norms are possible for some slider settings overall, in \
which case, the HUD turns red. "
}], "Text",
 CellChangeTimes->{{3.979429166495887*^9, 3.9794291664968023`*^9}, {
  3.97943178521777*^9, 3.979431834628726*^9}, {3.979433331541238*^9, 
  3.9794335164986*^9}, {3.979469474804504*^9, 3.979469506720866*^9}, {
  3.979472858148521*^9, 3.9794728664293623`*^9}, {3.97947296309332*^9, 
  3.979472985885055*^9}, {3.97947868353063*^9, 
  3.979478694546898*^9}},ExpressionUUID->"3e4da06c-c7bd-49b4-a7ae-\
a74b9f6fbdef"],

Cell["\<\
This controls the \[OpenCurlyDoubleQuote]Time Component\
\[CloseCurlyDoubleQuote] of the launch vector. It acts as a mix knob between \
\[OpenCurlyDoubleQuote]Moving through Time\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]Moving through Space.\[CloseCurlyDoubleQuote]\
\>", "Text",
 CellChangeTimes->{
  3.979429723771998*^9, {3.97943599280083*^9, 3.9794359982587147`*^9}, {
   3.9794360385245237`*^9, 3.979436055332962*^9}, {3.979455548157971*^9, 
   3.979455595570821*^9}, {3.979455650061631*^9, 3.979455804005352*^9}, 
   3.97945585439855*^9, 
   3.9794561086275806`*^9},ExpressionUUID->"3ae4813c-b588-4afe-bf65-\
6519d6e3750b"],

Cell["1.0 is the standard setting.", "Text",
 CellChangeTimes->{
  3.979429723771998*^9, {3.97943599280083*^9, 3.9794359982587147`*^9}, {
   3.9794360385245237`*^9, 3.979436055332962*^9}, {3.979455548157971*^9, 
   3.979455595570821*^9}, {3.979455650061631*^9, 3.979455804005352*^9}, 
   3.97945585439855*^9, 3.9794561103699636`*^9, {3.979478988574025*^9, 
   3.979479004515567*^9}},ExpressionUUID->"5939e7d0-acc0-464e-8698-\
35c6c95da1bc"],

Cell[TextData[{
 "To slow down (make heavier), increase the slider ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{">", " ", "1.0"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b7402f32-cbed-4cc1-9978-f96295443b42"],
 ". Why? Putting more of the velocity vector into \
\[OpenCurlyDoubleQuote]time,\[CloseCurlyDoubleQuote] the particle moves \
through time faster, but now through space slower because the norm ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["time", "2"]}], "+", 
     SuperscriptBox["space", "2"]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "810bb885-cbe6-45e9-9364-3d3a47227690"],
 " is constant. The particle acts more heavy and sluggish."
}], "Text",
 CellChangeTimes->{
  3.979429723771998*^9, {3.97943599280083*^9, 3.9794359982587147`*^9}, {
   3.9794360385245237`*^9, 3.979436055332962*^9}, {3.979455548157971*^9, 
   3.979455595570821*^9}, {3.979455650061631*^9, 3.979455804005352*^9}, 
   3.97945585439855*^9, 3.979456115586404*^9, {3.979479022512061*^9, 
   3.9794791691890497`*^9}, {3.979479264200844*^9, 
   3.979479305971925*^9}},ExpressionUUID->"815e70c7-c6a3-400b-bf65-\
cdb243294e9b"],

Cell[TextData[{
 "To speed up (make lighter): decrease the slider ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"<", " ", "1.0"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8c32aa28-43d0-4a6f-ae80-212dd6cc7062"],
 ". Why? Reducing the \[OpenCurlyDoubleQuote]time\[CloseCurlyDoubleQuote] \
component. To maintain normalization, the \[OpenCurlyDoubleQuote]space\
\[CloseCurlyDoubleQuote] components must increase. The particle gains kinetic \
energy."
}], "Text",
 CellChangeTimes->{
  3.979429723771998*^9, {3.97943599280083*^9, 3.9794359982587147`*^9}, {
   3.9794360385245237`*^9, 3.979436055332962*^9}, {3.979455548157971*^9, 
   3.979455595570821*^9}, {3.979455650061631*^9, 3.979455804005352*^9}, 
   3.97945585439855*^9, 3.979456115586404*^9, {3.979479022512061*^9, 
   3.979479249852006*^9}, {3.979479309948242*^9, 
   3.979479336050362*^9}},ExpressionUUID->"84a23c6a-bf43-4576-84d0-\
2763ce44ec4c"],

Cell["\<\
Tip: If your particle flies off into space, i.e., becomes unbound, it has too \
much energy. Increase the time dilation to calm it down.\
\>", "Text",
 CellChangeTimes->{
  3.979429723771998*^9, {3.97943599280083*^9, 3.9794359982587147`*^9}, {
   3.9794360385245237`*^9, 3.979436055332962*^9}, {3.979455548157971*^9, 
   3.979455595570821*^9}, {3.979455650061631*^9, 3.979455804005352*^9}, 
   3.97945585439855*^9, {3.979479341900609*^9, 
   3.979479411919003*^9}},ExpressionUUID->"24cbf04f-23c9-4242-a9e7-\
9ee0e730a0ce"],

Cell["\<\
The calculators below let you predict what you should see in the HUD for \
various scenarios. Use them to verify your intuition and the physics of the \
simulation!\
\>", "Text",
 CellChangeTimes->{{3.979429166495887*^9, 3.9794291664968023`*^9}, {
  3.97943178521777*^9, 3.979431834628726*^9}, {3.979433331541238*^9, 
  3.9794335164986*^9}, {3.979469474804504*^9, 
  3.979469527487462*^9}},ExpressionUUID->"7bc46251-36dc-4e4b-a7eb-\
61980b00a263"],

Cell[CellGroupData[{

Cell["CALCULATOR 1: Relativistic Flyby, aka the Lorentz Factor", \
"Subsubsection",
 CellChangeTimes->{{3.979429166495887*^9, 3.9794291664968023`*^9}, {
  3.97943178521777*^9, 3.979431834628726*^9}, {3.979433331541238*^9, 
  3.979433547982234*^9}},ExpressionUUID->"a42e0fa9-e64d-4967-8936-\
4c35e7cfd08d"],

Cell[TextData[{
 "In a high-speed flyby far from the black hole, gravity is weak. The HUD \
Energy ",
 Cell[BoxData[
  FormBox["E", TraditionalForm]],ExpressionUUID->
  "2edf0143-82c3-4758-be1b-aa526bdbc7c5"],
 " should be close to the \[Gamma] of special relativity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SqrtBox[
     RowBox[{"1", "-", 
      SuperscriptBox["v", "2"]}]]}], TraditionalForm]],ExpressionUUID->
  "509a1d6e-c8d2-4544-8c65-a6ee72098ca6"],
 "."
}], "Text",
 CellChangeTimes->{{3.979429166495887*^9, 3.9794291664968023`*^9}, {
  3.97943178521777*^9, 3.979431834628726*^9}, {3.979433331541238*^9, 
  3.979433502257038*^9}, {3.97943355297908*^9, 3.979433616524476*^9}, {
  3.979433729949795*^9, 
  3.9794337378983183`*^9}},ExpressionUUID->"14343f04-9053-48ee-9f9d-\
f98762aecf3a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlybySlider", "[", "velocity_Quantity", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"beta", ",", "gamma"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"beta", "=", 
       RowBox[{"QuantityMagnitude", "[", 
        RowBox[{"velocity", "/", "constC"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gamma", "=", 
       RowBox[{"1", "/", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["beta", "2"]}]]}]}], ";", "\[IndentingNewLine]", 
      "gamma"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.979429166495887*^9, 3.9794291664968023`*^9}, {
  3.97943178521777*^9, 3.979431837228154*^9}, {3.979433623248514*^9, 
  3.979433655395382*^9}},
 CellLabel->"In[56]:=",ExpressionUUID->"6a2a7789-3f8f-446f-93bd-f83d08b9f9fd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
CALCULATOR 2: Stable Circular Orbit, aka Gravitational Time Dilation\
\>", "Subsubsection",
 CellChangeTimes->{{3.979429166495887*^9, 3.9794291664968023`*^9}, {
  3.97943178521777*^9, 3.9794318399109917`*^9}, {3.979433664551463*^9, 
  3.979433690584422*^9}},ExpressionUUID->"b5909265-f6aa-4d70-8239-\
fa5df52d6c2d"],

Cell[TextData[{
 "Deep in the gravity well, time slows down significantly. Even if the Time \
Dilation input slider is 1.0, the HUD will show a much higher Energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SuperscriptBox["u", "t"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b1bc6c63-7f15-41e8-a716-e1373b7229b6"],
 " to balance the intense gravitation."
}], "Text",
 CellChangeTimes->{{3.979429166495887*^9, 3.9794291664968023`*^9}, {
   3.97943178521777*^9, 3.9794318399109917`*^9}, 3.979433664551463*^9, {
   3.979433698741527*^9, 
   3.979433773847888*^9}},ExpressionUUID->"aebfd356-9517-463d-ba1d-\
5a787b7bd816"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CircularOrbitSlider", "[", "radiusM_", "]"}], ":=", 
   RowBox[{"1", "/", 
    SqrtBox[
     RowBox[{"1", "-", 
      RowBox[{"3", "/", "radiusM"}]}]]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.979429166495887*^9, 3.9794291664968023`*^9}, {
  3.97943178521777*^9, 3.9794318413676167`*^9}, {3.979433934036775*^9, 
  3.9794339406597023`*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"c67b8ae1-5daa-4244-8e98-e8deddc586e2"],

