Cell[BoxData[
 RowBox[{
  RowBox[{"geodesicEqs", "=", "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"velLookup", "=", 
        RowBox[{"MakeIndexer", "[", 
         RowBox[{"velocities", ",", "coords"}], "]"}]}], ",", 
       RowBox[{"(*", " ", 
        RowBox[{"toolkit", " ", "function"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"accLookup", "=", 
        RowBox[{"MakeIndexer", "[", 
         RowBox[{"accelerations", ",", "coords"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"accLookup", "[", "\[Mu]", "]"}], "+", "\[IndentingNewLine]", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kerrGamma", "[", 
               RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Lambda]"}], "]"}], "/.", 
              RowBox[{"Thread", "[", 
               RowBox[{"coords", "->", "funcs"}], "]"}]}], ")"}], 
            RowBox[{"velLookup", "[", "\[Nu]", "]"}], 
            RowBox[{"velLookup", "[", "\[Lambda]", "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"\[Nu]", ",", "coords"}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"\[Lambda]", ",", "coords"}], "}"}]}], "]"}]}], "==", 
        "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"\[Mu]", ",", "coords"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.979235674504839*^9, 3.9792356878473263`*^9}, {
   3.9792357191399107`*^9, 3.97923574026608*^9}, {3.9792365920996847`*^9, 
   3.979236855008439*^9}, 3.979237121439125*^9},
 CellLabel->"In[20]:=",ExpressionUUID->"1640aacc-d4ca-47f7-9a77-285e184a4e4a"]
}, Open  ]],

