Cell[CellGroupData[{

Cell["The Wizard\[CloseCurlyQuote]s Roadmap: Linearized Weak-Field Gravity", \
"Section",
 CellChangeTimes->{{3.979076319169792*^9, 3.9790763261896677`*^9}, {
  3.979117611312978*^9, 3.979117622917925*^9}, {3.9791210719884853`*^9, 
  3.9791210773277483`*^9}, {3.979165005054489*^9, 3.9791650062463617`*^9}, {
  3.979296826898971*^9, 3.979296837996434*^9}, {3.979296882687142*^9, 
  3.979296883540558*^9}},ExpressionUUID->"9102726a-2fbe-4989-98ba-\
886b5ed6bccb"],

Cell["\<\
We beat a close escape from the dragon\[CloseCurlyQuote]s fire to study the \
parchment Chandra slipped into our backpack. It is a map of the \
\[OpenCurlyDoubleQuote]Far Lands\[CloseCurlyDoubleQuote]\[LongDash]the \
weak-field limit beyond the dragon, where gravity is gentle and the dragon\
\[CloseCurlyQuote]s roar is but a whisper.\
\>", "Text",
 CellChangeTimes->{{3.979304029500854*^9, 3.97930407369812*^9}, {
  3.979305046129355*^9, 3.979305051680512*^9}, {3.979432366564444*^9, 
  3.979432367835477*^9}},
 FontSlant->"Italic",ExpressionUUID->"ddd086eb-bd90-47ce-8d2e-9a9140f7a4a7"],

Cell[TextData[{
 StyleBox["Chandra\[CloseCurlyQuote]s map suggests a sanity check: if our \
simplified ansatz is correct, then far down the road from the black hole ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"r", "\[RightArrow]", "\[Infinity]"}], ")"}], TraditionalForm]],
  ExpressionUUID->"8e5053d3-6763-42ba-b1cf-25cb0352c055"],
 ", ",
 StyleBox["the terrifying",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "rot"], TraditionalForm]],ExpressionUUID->
  "2a0e8efd-b04a-4711-998d-c903546e4d21"],
 "\:200b ",
 StyleBox["term should dwindle into something recognizable. It should look \
like a \[OpenCurlyDoubleQuote]dipole\[CloseCurlyDoubleQuote]\[LongDash]a \
gravitational magnet.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.979304029500854*^9, 3.9793040987680693`*^9}, {
  3.979305060265649*^9, 3.97930507517021*^9}, {3.979432404960162*^9, 
  3.9794324076935987`*^9}},ExpressionUUID->"2d386376-99d6-4152-894e-\
2aec776a0887"],

Cell["\<\
We linearize our new ansatz metric, stripping away higher-order terms. We are \
left with an easy equation. If we solve it, and it reveals a dipole, we know \
that despite the smoke and fire ahead of us, we are at least confronting the \
right beast blocking the right road.\
\>", "Text",
 CellChangeTimes->{{3.979304029500854*^9, 3.979304162382958*^9}, {
  3.979305081612852*^9, 3.9793051161654387`*^9}, {3.97930589244481*^9, 
  3.979305899983851*^9}, {3.9794324226318893`*^9, 3.979432436362301*^9}},
 FontSlant->"Italic",ExpressionUUID->"da4bb804-1b3c-463c-8fd7-9d431e3083b5"],

Cell[TextData[{
 "Instead of trying to solve for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "rot"], TraditionalForm]],ExpressionUUID->
  "56d05272-8305-4313-833e-557ae4a46ead"],
 " directly, check the ",
 StyleBox["form",
  FontSlant->"Italic"],
 " of the new ansatz metric in the weak-field approximation, far from the \
black hole, assuming only ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "\[LongDash]", "\[Phi]"}], TraditionalForm]],ExpressionUUID->
  "ec604648-6b49-422e-bce6-f9becd465776"],
 " coupling off the diagonal:"
}], "Text",
 CellChangeTimes->{{3.979145444168232*^9, 3.9791454782261333`*^9}, {
  3.979165020822075*^9, 3.97916502170221*^9}, {3.979219337483378*^9, 
  3.979219367770729*^9}, {3.9792194274742947`*^9, 3.97921942899771*^9}, {
  3.9794324455384893`*^9, 
  3.979432486231186*^9}},ExpressionUUID->"1022c3ce-ac76-4483-813a-\
629951e24caa"],

Cell[CellGroupData[{

Cell[" Weak Metric", "Subsection",
 CellChangeTimes->{{3.979118179711732*^9, 3.97911818469475*^9}, 
   3.979165012561338*^9},ExpressionUUID->"b394cdee-e5db-4c61-a84a-\
9835e4c6a375"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", "h", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.979076962136963*^9, 3.9790771243117867`*^9}, {
   3.979077324506407*^9, 3.979077328374013*^9}, 3.97911560507299*^9, 
