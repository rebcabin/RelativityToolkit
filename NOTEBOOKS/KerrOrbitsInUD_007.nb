 FontColor->RGBColor[0.98, 0.56, 0.17]]], "Text",
 CellChangeTimes->{{3.979395923758749*^9, 3.979395923760643*^9}, {
   3.979395991467423*^9, 3.97939604353026*^9}, {3.979396308928831*^9, 
   3.9793963113206387`*^9}, 3.9793964243242083`*^9, 3.979397093570208*^9, {
   3.9793971619815207`*^9, 3.979397259274551*^9}, {3.9793978715676928`*^9, 
   3.97939789150211*^9}, {3.9793979231457872`*^9, 3.9793979600064373`*^9}, {
   3.979400670357472*^9, 3.979400670648835*^9}, {3.9794338069742727`*^9, 
   3.979433813671812*^9}, {3.9794340046764307`*^9, 3.979434007153845*^9}, {
