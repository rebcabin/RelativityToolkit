Cell[TextData[{
 StyleBox["The quest should reveal the meaning of these definitions, but the \
wizard cannot translate them. ",
  FontSlant->"Italic"],
 "For now, take them as granted, as just enough to enable the Visualizer."
}], "Text",
 CellChangeTimes->{{3.979254333748666*^9, 3.9792543906646137`*^9}, {
  3.979288661839445*^9, 3.979288662290839*^9}, {3.979294795612389*^9, 
  3.9792948016861963`*^9}, {3.979312899252708*^9, 3.979312901094001*^9}, {
  3.979431470710493*^9, 3.979431514148428*^9}, {3.979461621808666*^9, 
  3.979461624965382*^9}},ExpressionUUID->"732c2053-324b-4fcd-b437-\
f0f38fd8cb40"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coords", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalSigma]", "=", 
   RowBox[{
    SuperscriptBox["r", "2"], "+", 
    RowBox[{
     SuperscriptBox["a", "2"], 
     SuperscriptBox[
      RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalDelta]", "=", 
   RowBox[{
    SuperscriptBox["r", "2"], "-", 
    RowBox[{"2", "M", " ", "r"}], "+", 
    SuperscriptBox["a", "2"]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrMetric", "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"2", "M", " ", "r"}], "\[CapitalSigma]"]}], ")"}]}], "0", 
       "0", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"2", "M", " ", "a", " ", "r", " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
         "\[CapitalSigma]"]}]},
      {"0", 
       FractionBox["\[CapitalSigma]", "\[CapitalDelta]"], "0", "0"},
      {"0", "0", "\[CapitalSigma]", "0"},
      {
       RowBox[{"-", 
        FractionBox[
         RowBox[{"2", "M", " ", "a", " ", "r", " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
         "\[CapitalSigma]"]}], "0", "0", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["r", "2"], "+", 
          SuperscriptBox["a", "2"], "+", 
          FractionBox[
           RowBox[{"2", "M", " ", 
            SuperscriptBox["a", "2"], "r", " ", 
            SuperscriptBox[
             RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
           "\[CapitalSigma]"]}], ")"}], 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}
     }], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"gDD", ",", "gUU"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrRules", " ", "=", " ", 
   RowBox[{"Join", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"MatrixToUDRules", "[", 
      RowBox[{
      "kerrMetric", ",", " ", "gDD", ",", " ", "\[ScriptCapitalD]", ",", " ", 
       "coords"}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"gDD", "[", "__", "]"}], " ", "->", " ", "0"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrInverse", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Inverse", "[", "kerrMetric", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrInvRules", " ", "=", " ", 
   RowBox[{"Join", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"MatrixToUDRules", "[", 
      RowBox[{
      "kerrInverse", ",", " ", "gUU", ",", " ", "\[ScriptCapitalU]", ",", " ",
        "coords"}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"gUU", "[", "__", "]"}], " ", "->", " ", "0"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kerrGamma", "[", 
    RowBox[{"s_", ",", "m_", ",", "n_"}], "]"}], ":=", "\[IndentingNewLine]", 
   
   RowBox[{"CalculateGammaComponent", "[", 
    RowBox[{
    "s", ",", "m", ",", "n", ",", "gDD", ",", "kerrRules", ",", "gUU", ",", 
     "kerrInvRules", ",", "coords"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.979074333501361*^9, 3.979074333503202*^9}, {
   3.979074382141273*^9, 3.97907438830672*^9}, {3.979074421606793*^9, 
   3.979074590520749*^9}, {3.979074638210091*^9, 3.979074709815413*^9}, {
   3.9790749742263727`*^9, 3.9790751588520517`*^9}, {3.979075195429298*^9, 
   3.979075219218081*^9}, {3.979075258653852*^9, 3.9790752734725657`*^9}, {
   3.979075337625022*^9, 3.979075451712229*^9}, {3.979075843337785*^9, 
   3.979075867526464*^9}, {3.979075901585245*^9, 3.979075915205324*^9}, {
   3.979114269443429*^9, 3.97911427346502*^9}, 3.979114306960217*^9, {
   3.979114622518231*^9, 3.979114631991427*^9}, 3.979294781900386*^9},
 CellLabel->"In[8]:=",ExpressionUUID->"20b05e0c-65e9-4105-a422-b768dba6a8c1"]
}, Open  ]],

