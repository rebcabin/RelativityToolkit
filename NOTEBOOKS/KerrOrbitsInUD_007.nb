      "list"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}]}], " ", 
   "]"}]}], "\n", 
 RowBox[{
