Cell[CellGroupData[{

Cell[TextData[{
 "The Geodesic Equation, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x", "''"}], "+", 
     RowBox[{"\[CapitalGamma]", " ", 
      RowBox[{"x", "'"}], " ", 
      RowBox[{"x", "'"}]}]}], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"6f782691-2eec-410c-a0e7-63585b3465f3"]
}], "Subsection",
 CellChangeTimes->{{3.979070009507512*^9, 3.9790700095088787`*^9}, {
