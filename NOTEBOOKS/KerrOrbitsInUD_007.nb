                 RowBox[{
                  RowBox[{
                   RowBox[{
                    SuperscriptBox["Ak", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"0", ",", "1"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", 
                    RowBox[{"r", ",", "\[Theta]"}], "]"}], " ", 
                   RowBox[{
                    SuperscriptBox["Dk", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"0", ",", "1"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", 
                    RowBox[{"r", ",", "\[Theta]"}], "]"}]}], "+", 
                  RowBox[{"2", " ", 
                   SuperscriptBox[
                    RowBox[{
                    SuperscriptBox["Erot", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"0", ",", "1"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", 
                    RowBox[{"r", ",", "\[Theta]"}], "]"}], "2"]}], "+", 
                  RowBox[{"2", " ", 
                   RowBox[{"Ak", "[", 
                    RowBox[{"r", ",", "\[Theta]"}], "]"}], " ", 
                   RowBox[{
                    SuperscriptBox["Dk", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"0", ",", "2"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", 
                    RowBox[{"r", ",", "\[Theta]"}], "]"}]}]}], ")"}]}]}], 
              ")"}]}]}], ")"}]}], "-", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"\[LeftSkeleton]", "1", "\[RightSkeleton]"}], "2"], " ", 
          RowBox[{"\[LeftSkeleton]", "2", "\[RightSkeleton]"}], " ", 
          RowBox[{"\[LeftSkeleton]", "1", "\[RightSkeleton]"}]}], "+", 
         RowBox[{
          RowBox[{"Bk", "[", 
           RowBox[{"r", ",", "\[Theta]"}], "]"}], " ", 
          RowBox[{"Ck", "[", 
           RowBox[{"r", ",", "\[Theta]"}], "]"}], " ", 
          RowBox[{"(", 
