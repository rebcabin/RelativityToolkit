Cell[CellGroupData[{

Cell["The Visualizer itself", "Subsection",
 CellChangeTimes->{{3.979294830029633*^9, 
  3.979294838847508*^9}},ExpressionUUID->"d5810560-89a3-409e-9ec5-\
adba107355ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"defaultSpinParameter", "=", "0.9"}], ",", "\[IndentingNewLine]", 
     RowBox[{"defaultInitialRadius", "=", "7.0"}], ",", "\[IndentingNewLine]", 
     RowBox[{"defaultAngMomRatio", "=", "0.95"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "1.0", " ", "means", " ", "\"\<100% of Circular Orbit Speed\>\""}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"defaultVerticalKick", "=", "0.02"}], ",", "\[IndentingNewLine]", 
     RowBox[{"defaultEparam", "=", "1.0"}], ",", "\[IndentingNewLine]", 
     RowBox[{"defaultDuration", "=", "500"}], ",", "\[IndentingNewLine]", 
     RowBox[{"defaultPuff", "=", "1.5"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"minSpin", "=", "0.0"}], ",", 
     RowBox[{"maxSpin", "=", "0.99"}], ",", "\[IndentingNewLine]", 
     RowBox[{"minRadius", "=", "1.5"}], ",", 
     RowBox[{"maxRadius", "=", "30.0"}], ",", "\[IndentingNewLine]", 
     RowBox[{"minAngMomRatio", "=", 
      RowBox[{"-", "1.5"}]}], ",", 
     RowBox[{"maxAngMomRatio", "=", "1.5"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Universal", " ", "for", " ", "all", " ", 
       RowBox[{"radii", "!"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"minKick", "=", "0.0"}], ",", 
     RowBox[{"maxKick", "=", "0.20"}], ",", "\[IndentingNewLine]", 
     RowBox[{"minE", "=", "0.5"}], ",", 
     RowBox[{"maxE", "=", "2.0"}], ",", "\[IndentingNewLine]", 
     RowBox[{"minDuration", "=", "10"}], ",", 
     RowBox[{"maxDuration", "=", "10000"}], ",", "\[IndentingNewLine]", 
     RowBox[{"minPuff", "=", "1.5"}], ",", 
     RowBox[{"maxPuff", "=", "30"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"innerLimitRadius", "=", "1.1"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sol", ",", 
         RowBox[{"Mval", "=", "1"}], ",", 
         RowBox[{"Tmax", "=", "duration"}], ",", "rMin", ",", "rawU", ",", 
         "metricAtStart", ",", "\[IndentingNewLine]", "rawNorm", ",", 
         "scaleFactor", ",", "finalU", ",", "physicalE", ",", "physicalL", ",",
          "isPhysical", ",", "\[IndentingNewLine]", "baseOmega", ",", 
         "calculatedInitL"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "BASELINE", " ", "SPEED", " ", "FOR", " ", "CURRENT", " ", "RADIUS"}],
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Keplerian", " ", 
          RowBox[{"approximation", ":", "Omega"}]}], "=", 
         SqrtBox[
          RowBox[{"M", "/", 
           SuperscriptBox["r", "3"]}]]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "scale", " ", "the", " ", "slider", " ", "automatically", " ", "as", " ",
          "Radius", " ", "changes"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"baseOmega", "=", 
         SqrtBox[
          RowBox[{"Mval", "/", 
           SuperscriptBox["initR", "3"]}]]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"APPLY", " ", "USER", " ", "RATIO"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "The", " ", "slider", " ", "angMomRatio", " ", "multiplies", " ", 
          "this", " ", "baseline"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"calculatedInitL", "=", 
         RowBox[{"angMomRatio", "*", "baseOmega"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"SETUP", " ", "METRIC"}], " ", "&"}], " ", "NORMALIZE"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"metricAtStart", "=", 
         RowBox[{"kerrMetric", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"r", "->", "initR"}], ",", 
            RowBox[{"a", "->", "spinParam"}], ",", 
            RowBox[{"\[Theta]", "->", 
             RowBox[{"\[Pi]", "/", "2"}]}], ",", 
            RowBox[{"M", "->", "Mval"}]}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Use", " ", "the", " ", "calculated", " ", "L", " ", "instead", " ", 
          "of", " ", "a", " ", "raw", " ", "input"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"rawU", "=", 
         RowBox[{"{", 
          RowBox[{
          "initEparam", ",", "0", ",", "initVelTheta", ",", 
           "calculatedInitL"}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rawNorm", "=", 
         RowBox[{"rawU", ".", "metricAtStart", ".", "rawU"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"rawNorm", "<", "0"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"isPhysical", "=", "True"}], ";", "\[IndentingNewLine]", 
            RowBox[{"scaleFactor", "=", 
             RowBox[{"1", "/", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"-", "rawNorm"}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"finalU", "=", 
             RowBox[{"rawU", "*", "scaleFactor"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"physicalE", "=", 
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"metricAtStart", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
                 RowBox[{"finalU", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                RowBox[{
                 RowBox[{"metricAtStart", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "4"}], "]"}], "]"}], "*", 
                 RowBox[{"finalU", "[", 
                  RowBox[{"[", "4", "]"}], "]"}]}]}], ")"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"physicalL", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"metricAtStart", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", "1"}], "]"}], "]"}], "*", 
               RowBox[{"finalU", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "+", 
              RowBox[{
               RowBox[{"metricAtStart", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", "4"}], "]"}], "]"}], "*", 
               RowBox[{"finalU", "[", 
                RowBox[{"[", "4", "]"}], "]"}]}]}]}], ";"}], ")"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"isPhysical", "=", "False"}], ";", "\[IndentingNewLine]", 
            
            RowBox[{"finalU", "=", "rawU"}], ";", "\[IndentingNewLine]", 
            RowBox[{"physicalE", "=", "0"}], ";", 
            RowBox[{"physicalL", "=", "0"}], ";"}], ")"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "INTEGRATE", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"initConds", "=", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"t", "[", "0", "]"}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"t", "'"}], "[", "0", "]"}], "==", 
            RowBox[{"finalU", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"r", "[", "0", "]"}], "==", "initR"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"r", "'"}], "[", "0", "]"}], "==", 
            RowBox[{"finalU", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"\[Theta]", "[", "0", "]"}], "==", 
            RowBox[{"\[Pi]", "/", "2"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Theta]", "'"}], "[", "0", "]"}], "==", 
            RowBox[{"finalU", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"\[Phi]", "[", "0", "]"}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Phi]", "'"}], "[", "0", "]"}], "==", 
            RowBox[{"finalU", "[", 
