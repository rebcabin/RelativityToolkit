Cell[TextData[{
 "Here, we see a Petrov map of leaf counts. Off-diagonal skyscrapers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["R", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"1", "\[VeryThinSpace]", "4"}]}]]}], TraditionalForm]],
  ExpressionUUID->"3ba9ca4f-7fdd-491d-aff1-a5938ba02760"],
 "\:200b, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"R", "\[VeryThinSpace]"}], 
    RowBox[{"\[VeryThinSpace]", "26"}]], TraditionalForm]],ExpressionUUID->
  "c85a590e-6ba8-4aaa-a5e2-f36cdd277fc9"],
 "\:200b, etc.) represent \[OpenCurlyDoubleQuote]gravitomagnetism\
\[CloseCurlyDoubleQuote] or frame dragging. It says, for example: \
\[OpenCurlyDoubleQuote]If I walk my vector around in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}], TraditionalForm]],ExpressionUUID->
  "393a3638-7c2a-45b2-8e11-30a2d41a1df5"],
 " plane, it gets twisted into the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"t", ",", "z"}], "}"}], TraditionalForm]],ExpressionUUID->
  "655470f9-203d-41a1-b018-deb4f12fbbe5"],
 " plane.\[CloseCurlyDoubleQuote] "
}], "Text",
 CellChangeTimes->{{3.9795478732736464`*^9, 3.979547891737756*^9}, 
   3.979551492061307*^9, 3.979552622923769*^9, {3.979578568980113*^9, 
   3.979578612344624*^9}},ExpressionUUID->"0633a948-5546-4a50-a94d-\
d81359f4507c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bivectorMap", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "->", "1"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], "->", "2"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "4"}], "}"}], "->", "3"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}], "->", "4"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "4"}], "}"}], "->", "5"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"3", ",", "4"}], "}"}], "->", "6"}]}], "|>"}]}], ";", 
  RowBox[{"petrovMatrix", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "6"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"expr", "=", 
         RowBox[{"ansatzRiemann", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"val", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"PossibleZeroQ", "[", "expr", "]"}], ",", "0", ",", 
           RowBox[{"LeafCount", "[", "expr", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"row", "=", 
         RowBox[{"bivectorMap", "[", 
          RowBox[{"Sort", "[", 
           RowBox[{"{", 
            RowBox[{"i", ",", "j"}], "}"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"col", "=", 
         RowBox[{"bivectorMap", "[", 
          RowBox[{"Sort", "[", 
           RowBox[{"{", 
            RowBox[{"k", ",", "l"}], "}"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"petrovMatrix", "[", 
          RowBox[{"[", 
           RowBox[{"row", ",", "col"}], "]"}], "]"}], "+=", 
         RowBox[{"Abs", "[", "val", "]"}]}], ";"}], ")"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", 
        RowBox[{"k", "+", "1"}], ",", "4"}], "}"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", 
      RowBox[{"i", "+", "1"}], ",", "4"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"DiscretePlot3D", "[", 
  RowBox[{
   RowBox[{"petrovMatrix", "[", 
    RowBox[{"[", 
     RowBox[{"row", ",", "col"}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"row", ",", "1", ",", "6"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"col", ",", "1", ",", "6"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ExtentSize", "->", "0.8"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Row (ab)\>\"", ",", "\"\<Col (cd)\>\"", 
      ",", "\"\<LeafCount\>\""}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "->", "\"\<6x6 Kerr Riemann Structure\>\""}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9795478732736464`*^9, 3.9795479479196577`*^9}, {
