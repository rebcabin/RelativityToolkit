Cell[CellGroupData[{

Cell["Orbital Speed Ratio Slider", "Subsection",
 CellChangeTimes->{{3.979429285847372*^9, 
  3.9794293038457603`*^9}},ExpressionUUID->"c45b55b8-59a5-4564-9131-\
2bffb842b71d"],

Cell["\<\
The \[OpenCurlyDoubleQuote]Orbital Speed Ratio\[CloseCurlyDoubleQuote] slider \
is calibrated to the Keplerian circular orbital speed for the chosen Launch \
Radius. The Visualizer does not accept independent settings for orbital \
radius and for orbital angular momentum, due to unusable sensitivity of such \
controls. Instead, the user specifies desired orbital angular momentum for a \
scenario as a ratio of desired speed to a Keplerian norm. \
\>", "Text",
 CellChangeTimes->{{3.9794293117500057`*^9, 3.979429354465445*^9}, {
  3.979431882870264*^9, 3.9794319124444513`*^9}, {3.979434409920155*^9, 
  3.979434613341112*^9}, {3.979467878350443*^9, 3.97946803182899*^9}, {
  3.97946806943709*^9, 3.979468113041572*^9}, {3.979468929372809*^9, 
  3.979469132065483*^9}},ExpressionUUID->"67178785-8652-499b-94de-\
c5b4022565d7"],

Cell[TextData[StyleBox["Orbital angular momentum is the angular momentum of \
the test particle or star or spaceship orbiting the black hole, and is \
distinct from and independent of the spin parameter, which sets the angular \
momentum of the black hole itself.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.9794293117500057`*^9, 3.979429354465445*^9}, {
  3.979431882870264*^9, 3.9794319124444513`*^9}, {3.979434409920155*^9, 
  3.979434613341112*^9}, {3.979467878350443*^9, 3.97946803182899*^9}, {
  3.97946806943709*^9, 3.979468113041572*^9}, {3.979468929372809*^9, 
  3.979469137634673*^9}, {3.979469225121825*^9, 
  3.979469254657619*^9}},ExpressionUUID->"57b6ae3b-d8ea-4cea-abe8-\
78d0f20ffb03"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"Setting", "=", "1.0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "efabe542-4bd1-4747-b735-291ffcc4bcbb"],
 ": Approximately circular orbit (Keplerian speed)."
}], "Item",
 CellChangeTimes->{{3.9794293117500057`*^9, 3.979429354465445*^9}, {
  3.979431882870264*^9, 3.9794319124444513`*^9}, {3.979434409920155*^9, 
  3.9794346256938972`*^9}},ExpressionUUID->"a19a67de-dfce-40a3-84bc-\
fc2a245fc8a7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"Setting", "<", "1.0"}], TraditionalForm]],ExpressionUUID->
  "506fd826-8f2a-416e-843b-f6b9f57a657b"],
 ": The particle falls inward due to insufficient centrifugal force. It may \
be desirable to visualize "
}], "Item",
 CellChangeTimes->{{3.9794293117500057`*^9, 3.979429354465445*^9}, {
  3.979431882870264*^9, 3.9794319124444513`*^9}, {3.979434409920155*^9, 
  3.9794346218373547`*^9}, {3.979468125656323*^9, 
  3.979468139494794*^9}},ExpressionUUID->"815462e9-2333-4c8c-a6e2-\
75da8d998724"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"Setting", ">", "1.0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7ea7a718-f571-4d17-a0fc-6dc170fb9b95"],
 ": The particle climbs outward due to excess centrifugal force."
}], "Item",
 CellChangeTimes->{{3.9794293117500057`*^9, 3.979429354465445*^9}, {
  3.979431882870264*^9, 3.9794319124444513`*^9}, {3.979434409920155*^9, 
  3.97943460473542*^9}},ExpressionUUID->"d87e7e3f-a84e-434f-99fb-\
2e5979abacc5"],

Cell[TextData[{
 "Below,we calculate ",
 Cell[BoxData[
  FormBox["1.0", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ca75a94e-2360-452f-84e5-02a82f7ec6f4"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"km", "/", "s"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e87064df-6677-478e-bda2-d200ceed38f9"],
 " for various various orbits."
}], "Text",
 CellChangeTimes->{{3.9794293117500057`*^9, 3.979429354465445*^9}, {
  3.979431882870264*^9, 3.9794319124444513`*^9}, {3.979434409920155*^9, 
  3.979434581746008*^9}, {3.979434642899078*^9, 
  3.979434698722225*^9}},ExpressionUUID->"f594d77c-7602-42e8-8ca9-\
651a289dd2b0"],

Cell[CellGroupData[{

Cell[TextData[{
 "CALCULATOR: Keplerian Orbital Velocity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SqrtBox[
     RowBox[{"G", "\[VeryThinSpace]", 
      RowBox[{"M", "/", "r"}]}]], ")"}], TraditionalForm]],ExpressionUUID->
  "1c66d653-415f-4455-b311-fab758937539"]
}], "Subsubsection",
 CellChangeTimes->{{3.9794293117500057`*^9, 3.979429354465445*^9}, {
   3.979431882870264*^9, 3.979431914722666*^9}, {3.979434705643827*^9, 
   3.979434750596821*^9}, 3.9794688118690643`*^9, 
   3.97946885852535*^9},ExpressionUUID->"d422dd51-f0ba-46fc-a807-\
70742f894c05"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"KeplerVelocity", "[", 
    RowBox[{"mass_Quantity", ",", "radius_Quantity"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{
     SqrtBox[
      RowBox[{"constG", "*", 
       RowBox[{"mass", "/", "radius"}]}]], ",", 
     RowBox[{"\"\<Kilometers\>\"", "/", "\"\<Seconds\>\""}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9794293117500057`*^9, 3.979429354465445*^9}, {
   3.979431882870264*^9, 3.979431914722666*^9}, 3.979434705643827*^9, {
   3.97943476040139*^9, 3.9794347758059063`*^9}},
 CellLabel->"In[64]:=",ExpressionUUID->"cde579f7-4097-4101-93b0-b5735c239356"],

Cell[TextData[StyleBox["Example: Earth\[CloseCurlyQuote]s Orbit Around the \
Sun",
 FontWeight->"Bold",
 FontColor->RGBColor[0.98, 0.56, 0.17]]], "Text",
 CellChangeTimes->{{3.979395923758749*^9, 3.979395923760643*^9}, {
   3.979395991467423*^9, 3.97939604353026*^9}, {3.979396308928831*^9, 
