Cell[CellGroupData[{

Cell[TextData[{
 "range: ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],ExpressionUUID->
  "a6e628f0-780f-4188-aef0-febde0ac38a4"],
 " (Schwarzschild) to 1 (Extreme Kerr). "
}], "Item",
 CellChangeTimes->{
  3.979381056625122*^9, {3.9793810927988873`*^9, 3.979381127690946*^9}, {
   3.979381158340921*^9, 3.979381158874599*^9}, 3.979381203276629*^9, {
