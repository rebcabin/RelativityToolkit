Cell["\<\
The coefficient in the moment-of-inertia formula for a centrally condensed \
star like the Sun is about 0.070, much less than the 2/5 for a uniform sphere.\
\>", "Text",
 CellChangeTimes->{{3.979396482604669*^9, 3.9793965313854313`*^9}, {
  3.979398507431158*^9, 
  3.9793985095484133`*^9}},ExpressionUUID->"397b31b8-8af5-454a-b44e-\
179c160ee7d9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"solMICoefficient", "=", "0.070"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solMomentOfInertia", "=", 
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"solMICoefficient", " ", "*", "solM", "*", " ", 
      SuperscriptBox["solR", "2"]}], 
     ",", "\"\<\!\(\*SubscriptBox[\(MI\), \(\[CircleDot]\)]\) :\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sol\[Omega]", "=", 
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"2", 
      RowBox[{"\[Pi]", "/", "solPeriod"}]}], 
     ",", "\"\<\!\(\*SubscriptBox[\(\[Omega]\), \(\[CircleDot]\)]\) =\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"solJ", "=", 
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"UnitConvert", "[", 
      RowBox[{
       RowBox[{"solMomentOfInertia", "*", "sol\[Omega]"}], 
       ",", "\"\<SI\>\""}], "]"}], 
     ",", "\"\<\!\(\*SubscriptBox[\(J\), \(\[CircleDot]\)]\) =\>\""}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solJ", "=", 
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"UnitConvert", "[", 
      RowBox[{
       RowBox[{"solMomentOfInertia", "*", "sol\[Omega]"}], 
       ",", "\"\<SIBase\>\""}], "]"}], 
     ",", "\"\<\!\(\*SubscriptBox[\(J\), \(\[CircleDot]\)]\) =\>\""}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.979396448410285*^9, 3.979396477121739*^9}, {
   3.979396535973435*^9, 3.979396600218379*^9}, 3.979396648365939*^9, {
   3.979396686966848*^9, 3.979396757633931*^9}, {3.9793967956695213`*^9, 
