        RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"], " ", 
       RowBox[{"h", "[", 
        RowBox[{"r", ",", "\[Theta]"}], "]"}]}], 
      SuperscriptBox["r", "2"]]}]}], ",", 
   RowBox[{
    RowBox[{"gUU", 
     SuperscriptBox["", "\[Phi]"], 
     SuperscriptBox["", "\[Phi]"]}], "\[Rule]", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"], 
     SuperscriptBox["r", "2"]]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9793380834444313`*^9, 3.979377446730626*^9, 
  3.979389683433361*^9, 3.979395869375033*^9, 3.9794555131209183`*^9, 
  3.97947963363461*^9, 3.979546275287969*^9, 3.9795787019438763`*^9, 
  3.979582652728551*^9},
 CellLabel->
  "Out[102]=",ExpressionUUID->"f35a8086-8c32-4884-824a-d3aa469bb073"]
}, Open  ]],

Cell["Join with zero rules, as before:", "Text",
 CellChangeTimes->{{3.979076962136963*^9, 3.9790771243117867`*^9}, {
   3.979077324506407*^9, 3.979077328374013*^9}, 3.97911560507299*^9, 
   3.979117600409993*^9, {3.979117645833679*^9, 3.97911788721768*^9}, 
   3.9791181593892517`*^9, {3.979145965429138*^9, 3.979145978100473*^9}, {
   3.9791665098965816`*^9, 
   3.979166511537724*^9}},ExpressionUUID->"6af8a3a4-51a9-47e4-a751-\
c13b88540f38"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"weakRules", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"weakRules", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"gDD", "[", "__", "]"}], "->", "0"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"weakInvRules", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"weakInvRules", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"gUU", "[", "__", "]"}], "->", "0"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.979076962136963*^9, 3.9790771243117867`*^9}, {
   3.979077324506407*^9, 3.979077328374013*^9}, 3.97911560507299*^9, 
   3.979117600409993*^9, {3.979117645833679*^9, 3.97911788721768*^9}, 
   3.9791181593892517`*^9, 3.979145965429138*^9},
 CellLabel->
  "In[103]:=",ExpressionUUID->"cd734ff0-0175-43fa-ae40-6ad80a4621ab"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Linearized Vacuum Field Equation", "Subsection",
 CellChangeTimes->{{3.9791181938884974`*^9, 3.979118203751829*^9}, {
  3.979224298688417*^9, 
  3.979224310563726*^9}},ExpressionUUID->"afa61aa0-a568-40a4-8eaa-\
475e79574402"],

Cell["Proceed as before.", "Text",
 CellChangeTimes->{{3.979146003045739*^9, 3.979146006369416*^9}, {
  3.979166514840516*^9, 
  3.9791665175949087`*^9}},ExpressionUUID->"33d81929-c217-4dc6-8524-\
e85a1cc948d9"],

Cell[TextData[StyleBox["\[CapitalGamma]-Getter",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9791183347092524`*^9, 3.979118338696642*^9}, {
  3.97911869458011*^9, 
  3.9791186991768913`*^9}},ExpressionUUID->"2f75b67d-81f3-4039-b886-\
a047ab52ecb7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"weakGamma", "[", 
    RowBox[{"s_", ",", "m_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"CalculateGammaComponent", "[", 
    RowBox[{
    "s", ",", "m", ",", "n", ",", "gDD", ",", "weakRules", ",", "gUU", ",", 
     "weakInvRules", ",", "coords"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.979225725524351*^9, 3.9792257943846607`*^9}},
 CellLabel->
  "In[105]:=",ExpressionUUID->"d8427df9-cba7-4747-845a-9e23c1056ae3"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"t", "\[VeryThinSpace]", "\[Phi]"}]}]], TraditionalForm]],
  ExpressionUUID->"63373ec5-b66c-461b-b843-f0ef72f26374"],
 " has a differential equation for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", "[", 
    RowBox[{"r", ",", "\[Theta]"}], "]"}], TraditionalForm]],ExpressionUUID->
  "1d00782f-b1eb-4aca-925e-7e2475397685"]
}], "Text",
 CellChangeTimes->{{3.979146033220521*^9, 
  3.979146060257966*^9}},ExpressionUUID->"d0cdddb1-3459-47c0-bcad-\
1be7d19a4d9c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"vacuumWeakEq", "=", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"CalculateRicciComponent", "[", 
    RowBox[{"t", ",", "\[Phi]", ",", "\[IndentingNewLine]", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{"Riemann", " ", "Getter"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"CalculateRiemannComponent", "[", 
        RowBox[{
        "a", ",", "b", ",", "c", ",", "d", ",", "\[IndentingNewLine]", 
         "weakGamma", ",", 
         RowBox[{"(*", 
          RowBox[{"\[CapitalGamma]", "-", "Getter"}], "*)"}], 
         "\[IndentingNewLine]", "coords"}], "]"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "coords"}], "]"}], "==", "0"}]}]], "Input",
 CellChangeTimes->{{3.979076962136963*^9, 3.9790771243117867`*^9}, {
   3.979077324506407*^9, 3.979077328374013*^9}, 3.97911560507299*^9, 
   3.979117600409993*^9, {3.979117645833679*^9, 3.97911788721768*^9}, {
   3.9791181593892517`*^9, 3.979118164226007*^9}, {3.97911822000156*^9, 
   3.9791182977521276`*^9}, {3.979118367586454*^9, 3.979118404991634*^9}, {
   3.9791185320176973`*^9, 3.979118535669962*^9}, {3.979118682485805*^9, 
   3.979118689306713*^9}, {3.979146070681974*^9, 3.9791460788440037`*^9}, {
   3.979146119653841*^9, 3.979146144165312*^9}, {3.979169899764049*^9, 
   3.979169910190054*^9}, {3.979225802531064*^9, 3.979225805630204*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"13707e6b-4371-4658-b3d3-b10afc592fcf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Cot", "[", "\[Theta]", "]"}]}], " ", 
      RowBox[{
       SuperscriptBox["h", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"0", ",", "1"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"r", ",", "\[Theta]"}], "]"}]}], "+", 
     RowBox[{
      SuperscriptBox["h", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"0", ",", "2"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"r", ",", "\[Theta]"}], "]"}], "+", 
     RowBox[{
      SuperscriptBox["r", "2"], " ", 
      RowBox[{
       SuperscriptBox["h", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"2", ",", "0"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"r", ",", "\[Theta]"}], "]"}]}]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["r", "2"]}]]}], "\[Equal]", "0"}]], "Output",
 CellChangeTimes->{3.979338083541397*^9, 3.9793774468142223`*^9, 
  3.979389683519156*^9, 3.979395869450076*^9, 3.9794555132019043`*^9, 
  3.979479633728979*^9, 3.9795462753826303`*^9, 3.979578702031*^9, 
  3.9795826528386374`*^9},
 CellLabel->
  "Out[106]=",ExpressionUUID->"e90b5a6b-0de3-4cf5-abef-9214991a9ddb"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Solution", "Subsection",
 CellChangeTimes->{{3.97911871469841*^9, 
  3.979118716285699*^9}},ExpressionUUID->"b08ade2c-5666-45d3-9ee6-\
848acae3105a"],

Cell[TextData[{
 "This is much more tractable. We can guess then verify that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "[", 
     RowBox[{"r", ",", "\[Theta]"}], "]"}], "=", 
    RowBox[{
     FractionBox["1", "r"], 
     RowBox[{
      SuperscriptBox["sin", "2"], "(", "\[Theta]", ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"508e8dbc-07fe-4cfc-b2dc-ef3fe11ceee2"],
 " solves the vacuum, weak-field equation, in place of the full ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "rot"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bd282fbc-f80c-41e8-96e2-688259eb218f"],
 ":"
}], "Text",
 CellChangeTimes->{{3.979166534886752*^9, 
  3.9791666117068996`*^9}},ExpressionUUID->"604d9d20-4869-4ec8-afa7-\
146015994a83"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"testRule", "=", 
   RowBox[{"h", "->", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", "\[Theta]"}], "}"}], ",", 
      RowBox[{
       FractionBox["1", "r"], 
       SuperscriptBox[
        RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"vacuumWeakEq", "/.", "testRule"}]}], "Input",
 CellChangeTimes->{{3.979076962136963*^9, 3.9790771243117867`*^9}, {
   3.979077324506407*^9, 3.979077328374013*^9}, 3.97911560507299*^9, 
   3.979117600409993*^9, {3.979117645833679*^9, 3.97911788721768*^9}, {
   3.9791181593892517`*^9, 3.979118164226007*^9}, {3.97911822000156*^9, 
   3.979118305285803*^9}, 3.9791188329817457`*^9, {3.979118909275353*^9, 
   3.979118929448155*^9}, {3.979119109471759*^9, 3.979119109986958*^9}, {
   3.979146245930518*^9, 3.979146298767988*^9}},
 CellLabel->
  "In[107]:=",ExpressionUUID->"b26b4721-b520-4705-b103-7f6056231f14"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "r"]}], "+", 
     FractionBox[
      RowBox[{"2", " ", 
       SuperscriptBox[
        RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "r"], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"2", " ", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], "r"]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["r", "2"]}]]}], "\[Equal]", "0"}]], "Output",
 CellChangeTimes->{3.97933808354426*^9, 3.979377446817068*^9, 
  3.9793896835221443`*^9, 3.979395869452585*^9, 3.979455513205051*^9, 
  3.97947963373773*^9, 3.979546275386035*^9, 3.979578702046981*^9, 
  3.979582652843059*^9},
 CellLabel->
  "Out[108]=",ExpressionUUID->"0b51f64b-ce7b-4a4b-a8a5-86a34358f0ce"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"vacuumWeakEq", "/.", "testRule"}], ")"}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.979119650452365*^9, 3.9791196687326*^9}, 
   3.9791463095723457`*^9},
 CellLabel->
  "In[109]:=",ExpressionUUID->"1a8fd76a-cdc4-493c-8a4f-85ec09f4fbea"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.979338083559284*^9, 3.979377446823007*^9, 
  3.979389683528088*^9, 3.979395869459503*^9, 3.9794555132089157`*^9, 
  3.979479633741968*^9, 3.979546275394631*^9, 3.979578702049079*^9, 
  3.979582652860684*^9},
 CellLabel->
  "Out[109]=",ExpressionUUID->"c7df8bfd-1080-4da5-b0a6-016455a47b07"]
}, Open  ]],

Cell["QED\[NoBreak]\[FilledSquare]", "Text",
 CellChangeTimes->{{3.979169482265024*^9, 3.979169488873774*^9}, {
  3.9791695758974543`*^9, 3.9791695898481083`*^9}},
 FontColor->RGBColor[
  0.14, 0.8, 0.14],ExpressionUUID->"2222a3bd-e30a-467e-a5cc-09239166fac8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"h", "\[Tilde]", 
    FractionBox["1", "r"]}], TraditionalForm]],ExpressionUUID->
  "bd1257ad-c6ba-45ca-b1fe-99560e8b16bd"],
 ", the metric term ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"t", "\[VeryThinSpace]", "\[Phi]"}]}]], TraditionalForm]],
  ExpressionUUID->"8932e7d6-f57d-40e6-81ba-0defbc5b48dc"],
 " looks like a Newtonian potential. The additional factor of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["sin", "2"], "(", "\[Theta]", ")"}], TraditionalForm]],
  ExpressionUUID->"5966a2ef-827e-4072-8438-4bbb77d4e524"],
 " causes twist like a dipole out of the Keplerian plane due to angular \
momentum of the black hole. This is the \
\[OpenCurlyDoubleQuote]Gravitomagnetic potential.\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{3.9791463315385723`*^9, 3.979146466858005*^9}, {
  3.979166631627729*^9, 3.979166706194025*^9}, {3.979305871029943*^9, 
  3.979305873864231*^9}},ExpressionUUID->"93197a85-14a0-4560-bef2-\
acf284166922"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Magical Sword: Ernst Equation for Kerr", "Section",
 CellChangeTimes->{{3.9791211030286083`*^9, 3.979121135638118*^9}, {
  3.97930201709098*^9, 
  3.979302021894167*^9}},ExpressionUUID->"fad4135b-92d0-4ae0-8b2c-\
687d565a1a2b"],

Cell["\<\
The map confirms we are on the right road, but the dragon, Ansatz Kerr, still \
blocks our passage. We cannot slay the dragon. There is nothing else to do \
but hack at the thicket. In there, the wizard told us, we will find the \
jewels to slot into the hilt of the Magical Sword, by which to enchant the \
dragon. But we should not hack with ordinary, dull blades. We will use the \
sword itself to hack the thicket!\
\>", "Text",
 CellChangeTimes->{{3.979304197301474*^9, 3.97930434147367*^9}, {
  3.9793051281011066`*^9, 3.979305148800928*^9}, {3.979432507547985*^9, 
  3.979432556372437*^9}, {3.9794626325890617`*^9, 3.979462640545863*^9}, {
  3.9794626730605097`*^9, 3.979462822357073*^9}, {3.979463107223577*^9, 
  3.979463113424664*^9}},
 FontSlant->"Italic",ExpressionUUID->"1e8332cb-43ac-4035-99b1-2cd4d949f6cd"],

Cell[TextData[{
 StyleBox["The Magical Sword was forged in 1968 by Frederick Ernst. He knew \
that the thicket conceals fabulous jewels. Once inserted into the hilt of the \
blade and held in sunlight, will enchant the dragon. The separate metric \
components, the temporal ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "60546717-9095-4452-941e-88599ea04093"],
 StyleBox[", the azimuthal ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["D", TraditionalForm]],ExpressionUUID->
  "885193ee-e927-411e-bc43-c30f501358f5"],
 StyleBox[", and the twisting ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "rot"], TraditionalForm]],ExpressionUUID->
  "c8b57455-f585-42f0-9160-12c4c6c6a659"],
 StyleBox["\:200b are not chaotic fragments, not brambles. They are the \
jewels we seek.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.979304197301474*^9, 3.979304267579692*^9}, {
   3.979305164639131*^9, 3.979305416916522*^9}, {3.9793059294713793`*^9, 
   3.9793060896149893`*^9}, 3.979306665252606*^9, {3.979432569618704*^9, 
   3.9794326346425962`*^9}, {3.9794628324156513`*^9, 
   3.9794628370897818`*^9}, {3.979462881797648*^9, 3.979462904522964*^9}, {
   3.979463136741982*^9, 3.979463169637579*^9}, {3.979463238782374*^9, 
   3.9794632489546957`*^9}},ExpressionUUID->"b8b914e4-746f-4c50-a1ed-\
5c9943f8be5f"],

Cell[TextData[{
 "Ernst defined a potential, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalE]", "=", 
    RowBox[{"\[CurlyPhi]", "+", 
     RowBox[{"\[ImaginaryI]", " ", "\[CapitalPsi]"}]}]}], TraditionalForm]],
  ExpressionUUID->"816a0ed0-0da8-4993-ac0d-ea6df3141aa8"],
 ", that enchants the beast at once. The five angry Einstein vacuum field \
equations collapse into a single, elegant equation: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"Re", "[", "\[ScriptCapitalE]", "]"}], 
     RowBox[{
      SuperscriptBox["\[Del]", "2"], "\[ScriptCapitalE]"}]}], "=", 
    RowBox[{
     RowBox[{"\[Del]", "\[ScriptCapitalE]\[FilledSmallCircle]"}], 
     RowBox[{"\[Del]", "\[ScriptCapitalE]"}]}]}], TraditionalForm]], 
  "DisplayFormulaNumbered",
  CellChangeTimes->{{3.979168618289695*^9, 3.979168653965659*^9}, {
   3.979219735810817*^9, 3.9792197408324757`*^9}},ExpressionUUID->
  "325bed4f-3e6f-45d1-80a1-032ba260c235"],
 ". "
}], "Text",
 CellChangeTimes->{{3.979304197301474*^9, 3.979304267579692*^9}, {
  3.979305164639131*^9, 3.979305416916522*^9}, {3.9793059294713793`*^9, 
  3.979306091000972*^9}, {3.979306678287315*^9, 3.9793066812614527`*^9}, {
  3.9794326455915318`*^9, 3.979432649343657*^9}, {3.9794632799272127`*^9, 
  3.979463282092779*^9}},ExpressionUUID->"8a37a304-7942-4382-85f8-\
67568f7e15aa"],

Cell[TextData[{
 StyleBox["Our faithful squire, the ",
  FontSlant->"Italic"],
 "\[ScriptCapitalU]\[ScriptCapitalD]",
 StyleBox[" Toolkit, fetches the parts: the Blade (the Scalar Laplacian), the \
handguard (the Gradient), and the Hilt (the Gradient Squared) with its empty \
slots. We have only to assemble them and start hacking. If we can strike \
true, the thicket will cough up the jewels.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.979304197301474*^9, 3.979304267579692*^9}, {
  3.979305164639131*^9, 3.979305416916522*^9}, {3.9793059294713793`*^9, 
  3.9793061102238083`*^9}, {3.979306313773941*^9, 3.979306340042981*^9}, {
  3.979313187603497*^9, 3.979313192373479*^9}, {3.979432664608345*^9, 
  3.979432693861198*^9}, {3.979463314032837*^9, 
  3.979463344407597*^9}},ExpressionUUID->"98a0369a-ac31-4621-a8e6-\
428cc8445deb"],

Cell["\<\
We follow Ernst\[CloseCurlyQuote]s assembly papers closely, positing the \
metric, then showing it solves a physically equivalent equation. Space does \
not permit a full recapitulation of his papers, but references are included \
below.\
\>", "Text",
 CellChangeTimes->{{3.9791675552432957`*^9, 3.97916756421659*^9}, {
  3.9791676011281967`*^9, 3.979167622906156*^9}, {3.979168501784423*^9, 
  3.979168526927256*^9}, {3.9792258468236637`*^9, 3.979225849000255*^9}, {
  3.9793063669875097`*^9, 3.97930636875557*^9}, {3.979432704445368*^9, 
  3.979432711185273*^9}},ExpressionUUID->"3203259c-4a3a-4762-b3e9-\
84e3478cae6c"],

Cell[TextData[{
 "The gist of Ernst is to notice that ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "2ee209f4-c5bf-4566-b766-9753773a5e9f"],
 ", ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],ExpressionUUID->
  "6d9a5fc1-fbb1-465b-94b5-35d706dccd3e"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "rot"], TraditionalForm]],ExpressionUUID->
  "7ec97787-b8c6-49d8-93a2-ad08ab88f78c"],
 " behave like a single complex potential, combined into a single complex \
function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalE]", "(", 
    RowBox[{"r", ",", "\[Theta]"}], ")"}], TraditionalForm]],ExpressionUUID->
  "a2d5d725-5023-4092-8978-bcb2f2a54af6"],
 ":"
}], "Text",
 CellChangeTimes->{{3.979168556533834*^9, 3.979168579777112*^9}, {
  3.979219602088043*^9, 3.979219722015834*^9}, {3.979219757451312*^9, 
  3.979219760917156*^9}, {3.9794327281476917`*^9, 
  3.979432731482855*^9}},ExpressionUUID->"b95c86c8-758e-4eb9-aa7f-\
dcfc32295c40"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[ScriptCapitalE]", "=", 
   RowBox[{"1", "-", 
    FractionBox[
     RowBox[{"2", "M"}], 
     RowBox[{"r", "+", 
      RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]", "a", "\[VeryThinSpace]", 
       RowBox[{"cos", "(", "\[Theta]", ")"}]}]}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.979168699581493*^9, 
  3.979168778139208*^9}},ExpressionUUID->"6a708435-645f-48ed-8116-\
d3f8afdae1f1"],

Cell[TextData[{
 "where ",
 StyleBox["a",
  FontSlant->"Italic"],
 " is the ",
 StyleBox["specific angular momentum",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of the black hole: angular momentum ",
 Cell[BoxData[
  FormBox["J", TraditionalForm]],ExpressionUUID->
  "79a33c90-460e-4cbf-9dbd-8798e272da38"],
 " divided by mass ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "e4b6c821-39e1-4305-808e-7f4e227def55"],
 "."
}], "Text",
 CellChangeTimes->{{3.979168792478693*^9, 3.979168798712372*^9}, {
  3.979168998808794*^9, 3.979169083588323*^9}, {3.979307872383726*^9, 
  3.979307872617337*^9}},ExpressionUUID->"133de036-226f-4435-9177-\
9721198e8f3d"],

Cell["\<\
The Einstein equations reduce to a single non-linear equation, as opposed to \
five, coupled, non-linear equations:\
\>", "Text",
 CellChangeTimes->{
  3.979219765449966*^9, {3.979225881156877*^9, 3.9792259027053003`*^9}, {
   3.979432751924656*^9, 
   3.979432763011271*^9}},ExpressionUUID->"00af1388-2706-454d-a789-\
a8e5a0171bf0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"Re", "[", "\[ScriptCapitalE]", "]"}], 
    RowBox[{
     SuperscriptBox["\[Del]", "2"], "\[ScriptCapitalE]"}]}], "=", 
   RowBox[{
    RowBox[{"\[Del]", "\[ScriptCapitalE]\[FilledSmallCircle]"}], 
    RowBox[{"\[Del]", "\[ScriptCapitalE]"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.979168618289695*^9, 3.979168653965659*^9}, {
  3.979219735810817*^9, 
  3.9792197408324757`*^9}},ExpressionUUID->"3a6df812-0555-457b-8b15-\
5c6492586ecf"],

Cell["\<\
We now proceed to show that the Kerr metric satisfies this equation.\
\>", "Text",
 CellChangeTimes->{{3.979219803952827*^9, 
  3.9792198218693237`*^9}},ExpressionUUID->"4dae86a6-3289-440f-b9ae-\
1df8adb5f0b0"],

Cell[CellGroupData[{

Cell["Convenience Forms", "Subsection",
 CellChangeTimes->{{3.979166727172048*^9, 3.979166738990912*^9}, {
  3.979166866419034*^9, 3.979166882798519*^9}, {3.979167543040399*^9, 
  3.979167566411931*^9}},ExpressionUUID->"793d4589-f39c-4008-923f-\
b1c6d4164d4c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalSigma]", "=", 
   RowBox[{
    SuperscriptBox["r", "2"], "+", 
    RowBox[{
     SuperscriptBox["a", "2"], 
     SuperscriptBox[
      RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalDelta]", "=", 
   RowBox[{
    SuperscriptBox["r", "2"], "-", 
    RowBox[{"2", "M", " ", "r"}], "+", 
    SuperscriptBox["a", "2"]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9791222556381598`*^9, 3.979122255639599*^9}, {
  3.9791223362049627`*^9, 3.9791223520341177`*^9}, {3.979166741568997*^9, 
  3.979166827691887*^9}, {3.979168534631221*^9, 3.97916853860428*^9}},
 CellLabel->
  "In[110]:=",ExpressionUUID->"edd13797-6190-453f-8f3c-5c8f4d8b6972"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Metric Proposal", "Subsection",
 CellChangeTimes->{{3.979167582412078*^9, 
  3.979167588595838*^9}},ExpressionUUID->"9f499583-20df-4495-91b6-\
b81abcd62df8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kerrMetric", "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"2", "M", " ", "r"}], "\[CapitalSigma]"]}], ")"}]}], "0", 
       "0", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"2", "M", " ", "a", " ", "r", " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
         "\[CapitalSigma]"]}]},
      {"0", 
       FractionBox["\[CapitalSigma]", "\[CapitalDelta]"], "0", "0"},
      {"0", "0", "\[CapitalSigma]", "0"},
      {
       RowBox[{"-", 
        FractionBox[
         RowBox[{"2", "M", " ", "a", " ", "r", " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
         "\[CapitalSigma]"]}], "0", "0", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["r", "2"], "+", 
          SuperscriptBox["a", "2"], "+", 
          FractionBox[
           RowBox[{"2", "M", " ", 
            SuperscriptBox["a", "2"], "r", " ", 
            SuperscriptBox[
             RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
           "\[CapitalSigma]"]}], ")"}], 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}
     }], ")"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.979166889078566*^9, 3.979167197982193*^9}, {
   3.9791673195790167`*^9, 3.9791673584896593`*^9}, 3.97916738924183*^9},
 CellLabel->
  "In[112]:=",ExpressionUUID->"44543db7-4e77-4ced-b2a3-3db0d256f6ad"]
}, Open  ]],

