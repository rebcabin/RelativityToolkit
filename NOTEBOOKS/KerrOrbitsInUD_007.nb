 ": Inclined Orbit.The particle bobs up and down if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"spin", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "fdd3823e-aafb-4024-b670-63c21fd0bde5"]
