   3.979465127509871*^9},ExpressionUUID->"2ee34bba-3dbc-47f9-8608-\
04b3141ff78c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9d32ef2a-a0cf-4f9f-bd6b-c09fcf46166a"],
 " is bounded above by 1 because the event horizon is at radius ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", 
    SqrtBox[
     RowBox[{"1", "-", 
      SuperscriptBox["a", "2"]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "18d6f8f3-f51c-4d12-b335-97445c0335af"],
 ". ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", ">", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b68bbd7a-9898-479b-8d0c-aeedf66ff852"],
 " yields a pure imaginary radius event horizon, which supposedly drops out \
of existence and exposes a ",
 StyleBox["naked singularity",
  FontSlant->"Italic"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b7676c4b-5fb1-471d-b8cc-e80af432a879"],
 ", frame-dragging reaches the speed of light, and the event horizon is \
supposedly stripped away by centrifugal force."
}], "Subitem",
 CellChangeTimes->{
  3.979381056625122*^9, {3.9793810927988873`*^9, 3.979381127690946*^9}, {
   3.979381158340921*^9, 3.979381158874599*^9}, 3.979381203276629*^9, {
   3.979381961143344*^9, 3.979382009457518*^9}, {3.979382506569479*^9, 
