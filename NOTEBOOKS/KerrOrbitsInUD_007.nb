30c1188edbcd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"solM", "=", 
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"AstronomicalData", "[", 
      RowBox[{"\"\<Sun\>\"", ",", "\"\<Mass\>\""}], "]"}], 
     ",", "\"\<\!\(\*SubscriptBox[\(M\), \(\[CircleDot]\)]\) =\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"solR", "=", 
   RowBox[{"Echo", "[", 
    RowBox[{
