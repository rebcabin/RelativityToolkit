Cell["This is a rough heuristic for the Visualizer\[CloseCurlyQuote]s \
behavior.", "Text",
 CellChangeTimes->{{3.979435424891561*^9, 
  3.9794354372609262`*^9}},ExpressionUUID->"b436a076-c11b-4878-92c9-\
cd43eabb6c83"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InclinationEstimator", "[", 
    RowBox[{"kickInput_", ",", "angMomRatio_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"angle", "=", 
       RowBox[{
        RowBox[{"ArcTan", "[", 
         RowBox[{"kickInput", "/", "angMomRatio"}], "]"}], "*", 
        RowBox[{"180", "/", "\[Pi]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"Quantity", "[", 
      RowBox[{"angle", ",", "\"\<AngularDegrees\>\""}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.979429386415813*^9, 3.9794293864166718`*^9}, {
   3.979431969384656*^9, 3.979431983117207*^9}, 3.979435387985343*^9, {
   3.979435423369176*^9, 3.979435476279235*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"c01833b0-bed1-491a-bd7a-a39a44318a0a"],

