c0653a9656a4"],

Cell[TextData[{
 "The simulation time unit is the light-crossing time of the mass radius ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"M", "/", "c"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "191ad201-2be1-4237-bca3-54cd85c38e08"],
 ". Since our simulation tracks the astronaut\[CloseCurlyQuote]s journey, \
this \[OpenCurlyQuote]Duration\[CloseCurlyQuote] represents Proper Time\
\[LongDash]the time elapsed on the astronaut\[CloseCurlyQuote]s watch."
}], "Text",
 CellChangeTimes->{{3.979395923758749*^9, 3.979395923760643*^9}, {
   3.979395991467423*^9, 3.97939604353026*^9}, {3.979396308928831*^9, 
