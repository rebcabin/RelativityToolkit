Cell[CellGroupData[{

Cell["Vertical Kick Input Slider, aka Inclination", "Subsection",
 CellChangeTimes->{{3.979429378575891*^9, 3.97942938440985*^9}, {
  3.979435186359586*^9, 
  3.979435189908386*^9}},ExpressionUUID->"13a6a13e-2675-4b51-8ca9-\
3274f35d98b3"],

Cell[TextData[{
 "The ",
 StyleBox["Vertical Kick",
  FontSlant->"Italic"],
 " slider imparts an initial velocity in the longitudinal \[Theta] direction, \
perpendicular to the equatorial plane. Physically, this creates ",
 StyleBox["orbital inclination",
  FontSlant->"Italic"],
 " or tilt."
}], "Text",
 CellChangeTimes->{{3.979429386415813*^9, 3.9794293864166718`*^9}, {
  3.979431969384656*^9, 3.97943198093722*^9}, {3.979435176432528*^9, 
