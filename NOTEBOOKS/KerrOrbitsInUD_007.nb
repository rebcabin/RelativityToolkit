 CellLabel->"In[97]:=",ExpressionUUID->"479e20e7-8c60-4cb2-bf91-18c50e46c36d"],

Cell[TextData[{
 "Minkowski in spherical coordinates plus a small, unknown twist, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", "[", 
    RowBox[{"r", ",", "\[Theta]"}], "]"}], TraditionalForm]],ExpressionUUID->
  "ae8e8e88-0b72-4758-a2cb-f20ac8d0e6bd"],
 " in place of the full ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "rot"], TraditionalForm]],ExpressionUUID->
  "b775fe0f-42a8-4cc8-926f-413bd92e3a93"],
 ":"
}], "Text",
 CellChangeTimes->{{3.979145414527667*^9, 3.979145439285385*^9}, {
  3.979145483885357*^9, 3.979145491494554*^9}, {3.979166481438579*^9, 
  3.979166491093602*^9}, {3.979219443097087*^9, 
  3.979219443830163*^9}},ExpressionUUID->"568a9dab-6de4-4783-b5d7-\
086215cc425a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"weakMetric", "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"-", "1"}], "0", "0", 
       RowBox[{"-", 
        RowBox[{"h", "[", 
         RowBox[{"r", ",", "\[Theta]"}], "]"}]}]},
      {"0", "1", "0", "0"},
      {"0", "0", 
       SuperscriptBox["r", "2"], "0"},
      {
       RowBox[{"-", 
        RowBox[{"h", "[", 
         RowBox[{"r", ",", "\[Theta]"}], "]"}]}], "0", "0", 
       RowBox[{
        SuperscriptBox["r", "2"], 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}
     }], ")"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.979076962136963*^9, 3.9790771243117867`*^9}, {
   3.979077324506407*^9, 3.979077328374013*^9}, 3.97911560507299*^9, 
