      RowBox[{"\"\<Sun\>\"", ",", "\"\<Radius\>\""}], "]"}], 
     ",", "\"\<\!\(\*SubscriptBox[\(R\), \(\[CircleDot]\)]\) =\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"solPeriod", "=", 
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"AstronomicalData", "[", 
      RowBox[{"\"\<Sun\>\"", ",", "\"\<RotationPeriod\>\""}], "]"}], 
     ",", "\"\<\!\(\*SubscriptBox[\(P\), \(\[CircleDot]\)]\) =\>\""}], 
    "]"}]}], ";"}]}], "Input",
