41e74ccae31c"],

Cell[TextData[{
 "The Sun is a slow rotator. What if it were a black hole? What value should \
we put on the ",
 StyleBox["Spin",
  FontSlant->"Italic"],
 " slider?"
}], "Text",
 CellChangeTimes->{{3.979396429656612*^9, 3.979396430701688*^9}, {
   3.9793970605674686`*^9, 3.979397077700934*^9}, {3.979397141573207*^9, 
