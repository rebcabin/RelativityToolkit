Cell[CellGroupData[{

Cell["The Quest Achieved: Vacuum Solution for Kerr", "Section",
 CellChangeTimes->{{3.97907619294413*^9, 3.979076204564231*^9}, {
  3.979303779169183*^9, 3.979303802510928*^9}, {3.9793132882697773`*^9, 
  3.979313289251306*^9}},ExpressionUUID->"dae5a100-3501-40da-a114-\
253da39e5cde"],

Cell["\<\
Confronting Ansatz Kerr head-on got us burnt by dragon\[CloseCurlyQuote]s \
fire and scarred by thorns in the thicket. Now, back at home, with the jewels \
inserted into a computer, we receive silent but joyous zeros.\
\>", "Text",
 CellChangeTimes->{{3.979307162194664*^9, 3.979307230821361*^9}, {
  3.979313301137692*^9, 3.979313301625841*^9}, {3.979433079310432*^9, 
  3.979433106452591*^9}, {3.979463606602984*^9, 3.9794636825256653`*^9}},
 FontSlant->"Italic",ExpressionUUID->"be3ecad7-b7bd-483c-b85e-9d6d8438ea53"],

Cell[TextData[{
 "Above, in ",
 StyleBox["Ernst Equation for Kerr",
  FontSlant->"Italic"],
 ", we already define rules for the Kerr metric and its inverse, the \
contravariant form. To review:"
}], "Text",
 CellChangeTimes->{{3.97922602847787*^9, 3.9792260640224657`*^9}, 
   3.979226214916882*^9, 
