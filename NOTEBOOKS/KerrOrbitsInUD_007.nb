Cell["QED\[NoBreak]\[FilledSquare]", "Text",
 CellChangeTimes->{{3.979169482265024*^9, 3.979169488873774*^9}, {
  3.9791695758974543`*^9, 3.9791695898481083`*^9}},
 FontColor->RGBColor[
  0.14, 0.8, 0.14],ExpressionUUID->"60afa338-4bf6-4bb1-aefe-9679835c082f"],

Cell["\<\
We\[CloseCurlyQuote]ve shone sunlight through the jewels. The dragon staggers \
off the road, stunned and dazed.\
\>", "Text",
 CellChangeTimes->{{3.979432801872095*^9, 3.9794328376473923`*^9}, {
  3.979463371497079*^9, 3.979463389139526*^9}},
 FontSlant->"Italic",ExpressionUUID->"5c6c53bd-f48b-4fd8-879c-3ac0a91e5896"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Road Beyond the Dragon: Comparing to the WFR", "Section",
 CellChangeTimes->{{3.979076149677253*^9, 3.979076166384181*^9}, {
  3.979302066457344*^9, 
  3.9793020778827677`*^9}},ExpressionUUID->"8c271e6b-6a11-4e38-8cfb-\
7f3bf0f25be5"],

Cell["\<\
Now that we are past the dragon, the details of the Wizard\[CloseCurlyQuote]s \
Map become clear. We travel to the Great Library (the Wolfram Function \
Repository) to seek our prize. In the library, we shine sunlight through the \
jewels again, onto the pages of the forgotton tomes, and the user\
\[CloseCurlyQuote]s manual and blueprints are fully revealed in language we \
understand.\
\>", "Text",
 CellChangeTimes->{{3.97930641753378*^9, 3.9793064950301027`*^9}, {
   3.9793065706159153`*^9, 3.979306576737336*^9}, {3.979306716338992*^9, 
   3.979306800717072*^9}, 3.979307005574925*^9, {3.979432844826305*^9, 
   3.9794329366562357`*^9}, {3.97946345634568*^9, 3.979463477237567*^9}},
 FontSlant->"Italic",ExpressionUUID->"652caaf7-dce7-4361-8bf4-2b2aba8d4a1a"],

Cell[TextData[{
 StyleBox["We must be careful with dialects. The Wizard Chandra speaks of \
\[OpenCurlyDoubleQuote]specific angular momentum\[CloseCurlyDoubleQuote] ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"a", "=", 
     RowBox[{"J", "/", "M"}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "654b756b-1a14-4844-b4dd-5fe6fd0de18d"],
 StyleBox[", while the Library\[CloseCurlyQuote]s books speak of \
\[OpenCurlyDoubleQuote]total angular momentum\[CloseCurlyDoubleQuote] ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "J", ")"}], TraditionalForm]],ExpressionUUID->
  "74caddee-c75d-45d1-9201-9da48b5bb3d3"],
 ". "
}], "Text",
 CellChangeTimes->{
  3.97930641753378*^9, {3.979306504279571*^9, 3.979306583505916*^9}, {
   3.9793070151211767`*^9, 3.979307058143992*^9}, 3.979313236184844*^9, 
   3.979313969870174*^9, {3.979432949821826*^9, 
   3.979433011012878*^9}},ExpressionUUID->"b7881ae7-04fa-4d65-af3c-\
a6f17c9af728"],

Cell[TextData[{
 "An image of the Magical Sword and its jewels, just as we have in hand, \
appears as well. We compare our sword to the image. It is a perfect match. \
The very jewels that enchanted the ",
 StyleBox["are",
  FontSlant->"Plain"],
 " the secret key to the Wondrous Machine! Our quest is over, and we thought \
we had only begun! The Visualizer is no longer an incomprehensible artifact. \
The Wondrous Machine is a solved and understood instrument, ready for us to \
explore the Ergosphere and beyond."
}], "Text",
 CellChangeTimes->{
  3.97930641753378*^9, {3.979306504279571*^9, 3.979306583505916*^9}, {
   3.9793070151211767`*^9, 3.979307058143992*^9}, 3.979313236184844*^9, 
   3.979313969870174*^9, {3.979432949821826*^9, 3.979433059070374*^9}, {
   3.979463514902845*^9, 3.979463519265152*^9}, {3.9794635665447407`*^9, 
   3.979463582289566*^9}},
 FontSlant->"Italic",ExpressionUUID->"29d7e181-df78-4725-850a-1676a99d319d"],

