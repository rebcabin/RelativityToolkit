Cell[TextData[StyleBox["Linearity, Product Rule, Power Rule",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.97604475333066*^9, 
  3.976044762765122*^9}},ExpressionUUID->"c5de7ce6-7bf0-45b3-a8c3-\
8d6060b55433"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fourGrad", "[", 
    RowBox[{
     RowBox[{"a_", "+", "b_"}], ",", "ud_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"fourGrad", "[", 
     RowBox[{"a", ",", "ud"}], "]"}], "+", 
    RowBox[{"fourGrad", "[", 
     RowBox[{"b", ",", "ud"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fourGrad", "[", 
    RowBox[{
     RowBox[{"a_", "*", "b_"}], ",", "ud_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"b", " ", 
     RowBox[{"fourGrad", "[", 
      RowBox[{"a", ",", "ud"}], "]"}]}], "+", 
    RowBox[{"a", " ", 
     RowBox[{"fourGrad", "[", 
      RowBox[{"b", ",", "ud"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fourGrad", "[", 
    RowBox[{
     SuperscriptBox["a_", "n_"], ",", "ud_"}], "]"}], ":=", 
   RowBox[{"n", " ", 
    SuperscriptBox["a", 
     RowBox[{"n", "-", "1"}]], 
    RowBox[{"fourGrad", "[", 
     RowBox[{"a", ",", "ud"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9760429624706163`*^9, 3.976042962471779*^9}, {
  3.976043351671191*^9, 3.9760434007259827`*^9}, {3.9760442707275763`*^9, 
  3.976044315740296*^9}, {3.9760447748454323`*^9, 3.9760447797686853`*^9}, {
  3.976102297571516*^9, 3.9761023114890347`*^9}, {3.976283859689364*^9, 
  3.9762838715031853`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"4688efa2-82ae-4214-a1d5-e2c062c55d6e"],

