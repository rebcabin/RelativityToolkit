Cell["\<\
The standard derivative operator Dt is agnostic to valence and cannot apply \
metrical contractions. Applying Dt blindly produces chained derivatives of \
indices and the \[ScriptCapitalU]\[ScriptCapitalD] symbols, which don\
\[CloseCurlyQuote]t make sense. Therefore, we just explicitly define d\[Phi]ds\
\>", "Text",
 CellChangeTimes->{{3.97629518631599*^9, 3.976295245006637*^9}, {
  3.976295276190984*^9, 3.976295303515438*^9}, {3.976295600533844*^9, 
  3.976295658991227*^9}, {3.976315382868689*^9, 
  3.976315405058545*^9}},ExpressionUUID->"3fe3c969-eb79-4315-a839-\
9b0b95490500"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"d\[Phi]dx", "=", 
    RowBox[{"2", 
     RowBox[{"\[Sigma]", "[", 
      RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], "]"}]}]}], ")"}], "/.",
   "dpyRules"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"5079c27b-00e2-4e7d-bac0-d2c3a81afe6b"],

Cell[BoxData[
 RowBox[{"2", " ", 
  SubscriptBox["\[Sigma]", "\[Mu]"]}]], "Output",
