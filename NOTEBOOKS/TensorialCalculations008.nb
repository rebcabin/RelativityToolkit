Cell[CellGroupData[{

Cell["Tensor Rules", "Subsection",
 CellChangeTimes->{{3.976268207400592*^9, 
  3.9762682104631987`*^9}},ExpressionUUID->"b59e730a-4207-41bf-840a-\
627248bc187a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "tensorRules", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tensorRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Special", " ", "Rules", " ", "First"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Definition", " ", "of", " ", "\[Sigma]"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x", "[", "ud_", "]"}], "-", 
       RowBox[{
        RowBox[{"z", "[", "s", "]"}], "[", "ud_", "]"}]}], ":>", 
      RowBox[{"\[Sigma]", "[", "ud", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Null", " ", "Interval"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Sigma]", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]_", "]"}], "]"}], 
       RowBox[{"\[Sigma]", "[", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Alpha]_", "]"}], "]"}]}], ":>", 
      "0"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Sigma]", "[", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Alpha]_", "]"}], "]"}], 
       RowBox[{"\[Sigma]", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]_", "]"}], "]"}]}], ":>", 
      "0"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Definition", " ", "of", " ", "\[Lambda]"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"z", "'"}], "[", "s", "]"}], "[", "ud_", "]"}], ":>", 
      RowBox[{"\[Lambda]", "[", "ud", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Unit", " ", "Velocity"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Lambda]", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]_", "]"}], "]"}], 
       RowBox[{"\[Lambda]", "[", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Alpha]_", "]"}], "]"}]}], ":>", 
      "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Lambda]", "[", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Alpha]_", "]"}], "]"}], 
       RowBox[{"\[Lambda]", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]_", "]"}], "]"}]}], ":>", 
      "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Mixed", " ", "Metric", " ", 
       SuperscriptBox[
        SubscriptBox["\[Eta]", "\[Mu]"], "\[Rho]"], " ", "acts", " ", "as", " ", 
       SuperscriptBox[
        SubscriptBox["\[Delta]", "\[Mu]"], "\[Rho]"]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Eta]", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], ",", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]_", "]"}]}], "]"}], ":>", 
      RowBox[{"\[Delta]", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]", "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Metric", " ", "Symmetry"}], ",", " ", 
       RowBox[{
       "avoiding", " ", "unbounded", " ", "recursion", " ", "via", " ", 
        "OrderedQ"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Alpha]_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Beta]_", "]"}]}], "]"}], "/;", 
       RowBox[{"OrderedQ", "[", 
        RowBox[{"{", 
         RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}]}], ":>", 
      RowBox[{"\[Eta]", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", "[", "\[Beta]", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Alpha]", "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"General", " ", "Rules"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Coalesce", " ", "Terms", " ", "into", " ", "Down"}], "-", 
       RowBox[{"Up", " ", "Order"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[Tau]_", "[", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], "]"}], 
        RowBox[{"\[Upsilon]_", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], "/;", 
       RowBox[{"OrderedQ", "[", 
        RowBox[{"{", 
         RowBox[{"\[Tau]", ",", "\[Upsilon]"}], "}"}], "]"}]}], ":>", 
      RowBox[{
       RowBox[{"\[Upsilon]", "[", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], "]"}], 
       RowBox[{"\[Tau]", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Raising", " ", "and", " ", 
        RowBox[{"Lowering", ":", " ", 
         RowBox[{
          RowBox[{"e", ".", "g", ".", " ", 
           SubscriptBox["\[Eta]", "\[Mu]\[Alpha]"]}], 
          SuperscriptBox["\[Lambda]", "\[Alpha]"]}]}]}], "->", 
       SubscriptBox["\[Lambda]", "\[Mu]"]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}]}], "]"}], 
       RowBox[{"\[Tau]_", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]_", "]"}], "]"}]}], ":>", 
      RowBox[{"\[Tau]", "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}]}], "]"}], 
       RowBox[{"\[Tau]_", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]_", "]"}], "]"}]}], ":>", 
      RowBox[{"\[Tau]", "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}]}], "]"}], 
       RowBox[{"(", 
        RowBox[{"\[Tau]_", "+", "\[Upsilon]_"}], ")"}]}], ":>", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Eta]", "[", 
         RowBox[{
          RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
          RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], 
        "\[Tau]"}], "+", 
       RowBox[{
        RowBox[{"\[Eta]", "[", 
         RowBox[{
          RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
          RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], 
        "\[Upsilon]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}]}], "]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Tau]_", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]_", "]"}], "]"}], 
         RowBox[{"\[Upsilon]_", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]_", "]"}], "]"}]}], ")"}]}],
       ":>", 
      RowBox[{
       RowBox[{"\[Tau]", "[", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], "]"}], 
       RowBox[{"\[Upsilon]", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "unraveling", " ", "recursive", " ", 
       "\[ScriptCapitalU]\[ScriptCapitalD]", " ", "indices"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Tau]_", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"h1", ":", 
           RowBox[{"\[ScriptCapitalU]", "|", "\[ScriptCapitalD]"}]}], ")"}], "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"h2", ":", 
            RowBox[{"\[ScriptCapitalU]", "|", "\[ScriptCapitalD]"}]}], ")"}], 
          "[", "ud_", "]"}], "]"}], "]"}], "/;", 
       RowBox[{"h1", "===", "h2"}]}], ":>", 
      RowBox[{"\[Tau]", "[", 
       RowBox[{"h1", "[", "ud", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9760429624706163`*^9, 3.976042962471779*^9}, {
