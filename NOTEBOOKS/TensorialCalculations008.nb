acb25d2affed"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fourGrad", "[", 
    RowBox[{
     RowBox[{"\[Sigma]", "[", "ud\[Nu]_", "]"}], ",", "ud\[Mu]_"}], "]"}], ":=", 
