  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     RowBox[{
      SubscriptBox["\[Lambda]", 
       RowBox[{"\[VeryThinSpace]", "\[Nu]"}]], "(", 
      SubscriptBox["s", "R"], ")"}]}], 
