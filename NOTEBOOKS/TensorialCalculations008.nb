  3.975965904214913*^9}},ExpressionUUID->"23168f12-39f5-4858-abd4-\
19bc2e808143"],

Cell[BoxData[
 FormBox[
  RowBox[{"1", "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Eta]", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], 
     SuperscriptBox["\[Lambda]", "\[Mu]"], 
     SuperscriptBox["\[Lambda]", "\[Nu]"]}], "=", 
    RowBox[{
