 CellChangeTimes->{{3.976113445553879*^9, 3.976113488855928*^9}, {
  3.9761135390826178`*^9, 3.976113571084063*^9}, {3.976113738452137*^9, 
  3.9761137538916807`*^9}, {3.9761139341892023`*^9, 3.976113949106999*^9}, {
  3.976114266295725*^9, 3.976114276572175*^9}, {3.9761143101705103`*^9, 
  3.976114313717289*^9}, {3.976121018924087*^9, 3.976121039009858*^9}, {
  3.9761376170480547`*^9, 3.976137618107229*^9}, {3.976137656079735*^9, 
  3.976137659430328*^9}},ExpressionUUID->"6bae277f-5262-4290-a6e9-\
8dde93ec0a79"],

Cell[TextData[{
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cd95131b-0889-4d66-a9f0-2d78e46d7694"],
 " is the ",
 StyleBox["retarded separation",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " distance in the lab frame (yet to be calculated)"
}], "Item",
 CellChangeTimes->{{3.976113445553879*^9, 3.976113488855928*^9}, {
  3.9761135390826178`*^9, 3.976113571084063*^9}, {3.976113738452137*^9, 
  3.9761137538916807`*^9}, {3.9761139341892023`*^9, 3.976113949106999*^9}, {
  3.976114266295725*^9, 3.976114276572175*^9}, {3.9761143101705103`*^9, 
  3.976114313717289*^9}, {3.976121018924087*^9, 3.976121039009858*^9}, {
  3.9761376170480547`*^9, 
  3.9761376242203093`*^9}},ExpressionUUID->"d529420d-fc4b-4838-9066-\
57ccf3183226"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "\[Nu]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "855394e9-e48d-4287-ba52-89b499b607f8"],
 " is the ",
 StyleBox["retarded velocity",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "\[VeryThinSpace]", 
    RowBox[{
     SubscriptBox[
      RowBox[{"z", "(", 
       SubscriptBox["s", "R"], ")"}], "\[Nu]"], "/", "d"}], "\[VeryThinSpace]",
     "s"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e63f409c-6b7e-4266-a825-15105d83b18a"],
 ", again in covariant form "
}], "Item",
 CellChangeTimes->{{3.976113445553879*^9, 3.976113488855928*^9}, {
  3.9761135390826178`*^9, 3.976113571084063*^9}, {3.976113738452137*^9, 
  3.9761137538916807`*^9}, {3.9761139341892023`*^9, 3.976113949106999*^9}, {
  3.976114266295725*^9, 3.976114276572175*^9}, {3.9761143101705103`*^9, 
  3.976114313717289*^9}, {3.976121018924087*^9, 3.976121039009858*^9}, {
  3.9761376170480547`*^9, 3.976137635707509*^9}, {3.976145494943947*^9, 
  3.976145578990534*^9}, {3.976145660442793*^9, 
  3.976145671797443*^9}},ExpressionUUID->"95233263-c2d1-4d03-a4a3-\
d84a260d9795"],

Cell[TextData[{
 StyleBox["It\[CloseCurlyQuote]s decidedly NOT ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"\[PartialD]", 
      SubscriptBox["z", "\[Nu]"]}], "/", 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "\[Mu]"]}]}],
    FontSlant->"Plain"], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSlant->"Italic",ExpressionUUID->
  "bce0320d-d6cc-4a08-aeb6-7e93b8d07116"],
 StyleBox[", which doesn\[CloseCurlyQuote]t even have the right valence.",
  FontSlant->"Italic"]
}], "Subitem",
 CellChangeTimes->{{3.976113445553879*^9, 3.976113488855928*^9}, {
  3.9761135390826178`*^9, 3.976113571084063*^9}, {3.976113738452137*^9, 
  3.9761137538916807`*^9}, {3.9761139341892023`*^9, 3.976113949106999*^9}, {
  3.976114266295725*^9, 3.976114276572175*^9}, {3.9761143101705103`*^9, 
  3.976114313717289*^9}, {3.976121018924087*^9, 3.976121039009858*^9}, {
  3.9761376170480547`*^9, 3.976137635707509*^9}, {3.976145494943947*^9, 
  3.9761456052703743`*^9}},ExpressionUUID->"af37743e-609e-49bc-99e7-\
10459b3635fe"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Field Strength Faraday Tensor", "Subsection",
 CellChangeTimes->{{3.976267147306286*^9, 3.9762671543472347`*^9}, {
  3.9762683930701027`*^9, 
  3.976268393135895*^9}},ExpressionUUID->"bc53c289-4101-4924-b381-\
6ffc19fba355"],

Cell["The field gradients are ", "Text",
 CellChangeTimes->{{3.976113445553879*^9, 3.976113488855928*^9}, {
  3.9761135390826178`*^9, 3.976113571084063*^9}, {3.976113738452137*^9, 
  3.9761137538916807`*^9}, {3.9761139341892023`*^9, 3.976113949106999*^9}, {
  3.976114266295725*^9, 3.976114276572175*^9}, {3.9761143101705103`*^9, 
  3.976114313717289*^9}, {3.976121018924087*^9, 3.976121039009858*^9}, {
  3.9761376170480547`*^9, 
  3.976137625934195*^9}},ExpressionUUID->"ba1e027c-e5c0-49db-af1a-\
5b7792d23aaa"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["F", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], 
     SubscriptBox["A", "\[Nu]"]}], "-", 
    RowBox[{
     SubscriptBox["\[PartialD]", "n"], 
     SubscriptBox["A", "\[Mu]"]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9761040343864927`*^9, 3.976104066511999*^9}, {
  3.976113504829534*^9, 
  3.976113504831532*^9}},ExpressionUUID->"437f36d0-d4d9-40c9-839d-\
7cdeddf8cb39"],

Cell["a textbook formula. ", "Text",
 CellChangeTimes->{{3.976113721464932*^9, 3.9761137979529047`*^9}, {
   3.9761140459038363`*^9, 3.976114094056716*^9}, {3.976114221289227*^9, 
   3.9761142489188766`*^9}, {3.976114336253667*^9, 3.976114337802025*^9}, {
   3.976115737081987*^9, 3.9761157454649487`*^9}, {3.976121083109178*^9, 
   3.976121144602189*^9}, {3.976137873451281*^9, 3.976137875293004*^9}, 
   3.976141431057016*^9, 3.976145457582529*^9, {3.976192156411159*^9, 
   3.976192170578499*^9}},ExpressionUUID->"2a4da197-f982-420b-a5eb-\
6ab3f1bec514"],

Cell[TextData[{
 "To compute ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"7e9a8925-91c8-45e0-93f4-541e4e3e9c2e"],
 ", we\[CloseCurlyQuote]ll need gradients for ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "447f7734-3536-4a6d-a4fe-3b5911df0ac2"],
 " and ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]],ExpressionUUID->
  "2857107d-01ee-42d0-abd6-dc6ae8f62508"],
 " because of the chain rule. "
}], "Text",
 CellChangeTimes->{{3.976113721464932*^9, 3.9761137979529047`*^9}, {
   3.9761140459038363`*^9, 3.976114094056716*^9}, {3.976114221289227*^9, 
   3.9761142489188766`*^9}, {3.976114336253667*^9, 3.976114337802025*^9}, {
   3.976115737081987*^9, 3.9761157454649487`*^9}, {3.976121083109178*^9, 
   3.976121144602189*^9}, {3.976137873451281*^9, 3.976137875293004*^9}, 
   3.976141431057016*^9, 3.976145457582529*^9, {3.976192156411159*^9, 
   3.976192162247826*^9}, {3.976192192255924*^9, 3.976192210305716*^9}, 
   3.976192393497826*^9, 
   3.976289827376842*^9},ExpressionUUID->"e3085c92-3ae5-45a4-85d5-\
1adbfce52693"],

Cell[TextData[{
 "Begin with the ",
 StyleBox["separation vector",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Sigma]", 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], "=", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["x", 
       RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], "-", 
      RowBox[{
       SuperscriptBox["z", 
        RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], "(", 
       SubscriptBox["s", "R"], ")"}]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"e611ce0a-5e5f-4056-8c67-13eeb647a7bd"],
 " between the emission ",
 StyleBox["event",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " at the retarded 4\[NoBreak]-\[NoBreak]position ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["z", 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], "(", 
    SubscriptBox["s", "R"], ")"}], TraditionalForm]],ExpressionUUID->
  "0530e729-2701-4fea-bce4-143eae6c4459"],
 " and the absorption event at 4\[NoBreak]-\[NoBreak]position ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "074e08cb-bb73-42b4-9ff9-793d4577d039"],
 ". ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", 
    RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "c89aab87-ea41-4662-88e6-368f11e0d0b0"],
 " depends on ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "1582e6e4-0a19-46d1-9d6b-a94b7f5ee18c"],
 " implicitly through ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "R"], TraditionalForm]],ExpressionUUID->
  "48e0b674-c317-4b05-a050-5d1486a2f157"],
 ". So we\[CloseCurlyQuote]ll start with the gradient ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[PartialD]", 
      SubscriptBox["s", "R"]}], "/", 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", 
       RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}]}], "\[Congruent]", 
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], 
     SubscriptBox["s", "R"]}]}], TraditionalForm]],ExpressionUUID->
  "80a86fa8-0277-448f-9afc-d194f437f5f4"],
 ". "
}], "Text",
 CellChangeTimes->{{3.976113721464932*^9, 3.9761137979529047`*^9}, {
   3.9761140459038363`*^9, 3.976114094056716*^9}, {3.976114221289227*^9, 
   3.9761142489188766`*^9}, {3.976114336253667*^9, 3.976114337802025*^9}, {
   3.976115737081987*^9, 3.9761157454649487`*^9}, {3.976121083109178*^9, 
   3.976121144602189*^9}, {3.976137873451281*^9, 3.976137875293004*^9}, 
   3.976141431057016*^9, 3.976145457582529*^9, {3.976192156411159*^9, 
   3.976192162247826*^9}, {3.976192192255924*^9, 3.976192210305716*^9}, 
   3.976192393497826*^9, {3.976289870921504*^9, 
   3.976289880831231*^9}},ExpressionUUID->"b2f7c31f-bb31-427f-8b03-\
7ddf6fa591a7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Mu]"], 
    SubscriptBox["s", "R"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b1e2aafd-b009-4290-ac26-180b4ea09b2e"],
 " from the Null Interval"
}], "Subsection",
 CellChangeTimes->{{3.975882476499016*^9, 3.975882477865635*^9}, {
  3.975959048545594*^9, 3.975959054362012*^9}, {3.976137494313684*^9, 
  3.976137495670184*^9}, {3.9762671761122723`*^9, 
  3.976267191234619*^9}},ExpressionUUID->"fa77bbff-fc8c-4145-94ad-\
e69a25f5cdf5"],

Cell[TextData[{
 "The only leverage we have on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "R"], TraditionalForm]],ExpressionUUID->
  "1151db17-7649-4ae3-841c-a5529293aab3"],
 " is through the length of the separation vector, the ",
 StyleBox["proper time",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Sigma]", "\[Mu]"], 
    SubscriptBox["\[Sigma]", "\[Mu]"]}], TraditionalForm]],ExpressionUUID->
  "50dbb78d-9161-4d87-8f82-ea923554df17"],
 ". It is zero, a ",
 StyleBox["null interval",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", as with all light-like paths (on the light cone) in a vacuum:"
}], "Text",
 CellChangeTimes->{
  3.9761138442858343`*^9, {3.9761139605239573`*^9, 3.97611396258573*^9}, {
   3.976141496012526*^9, 3.9761415026655827`*^9}, {3.976141540380477*^9, 
   3.976141575705762*^9}, {3.976141612305439*^9, 3.976141645943199*^9}, {
   3.97614571381749*^9, 3.976145730650153*^9}, {3.9761922296242313`*^9, 
   3.976192250140685*^9}, {3.976267199300693*^9, 
   3.976267202145063*^9}},ExpressionUUID->"df8dba3f-93ea-4ad5-9f48-\
cdb97e63ac2a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[Phi]", " ", 
     RowBox[{"(", 
      RowBox[{"x", ",", 
       SubscriptBox["s", "R"]}], ")"}]}], "\[Congruent]", 
    RowBox[{
     SubscriptBox["\[Sigma]", "\[Nu]"], 
     SuperscriptBox["\[Sigma]", "\[Nu]"]}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Eta]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "(", 
      RowBox[{
       SuperscriptBox["x", "\[Mu]"], "-", 
       RowBox[{
        SuperscriptBox["z", "\[Mu]"], "(", 
        SubscriptBox["s", "R"], ")"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "\[Nu]"], "-", 
       RowBox[{
        SuperscriptBox["z", "\[Nu]"], "(", 
        SubscriptBox["s", "R"], ")"}]}], ")"}]}], "=", "0"}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9755236551468763`*^9, 3.975523679673719*^9}, {
  3.975525023977065*^9, 3.9755251110016413`*^9}, {3.975698401414423*^9, 
  3.975698427109535*^9}, {3.9757083564920197`*^9, 3.975708369201294*^9}, {
  3.975784389437314*^9, 3.975784391763239*^9}, {3.97611602264434*^9, 
  3.976116054995854*^9}, {3.9761419566908493`*^9, 3.9761419899044456`*^9}},
 CellTags->
  "THE NULL INTERVAL",ExpressionUUID->"075ccbeb-be71-459e-8ff2-7942520a24bf"],

Cell["This is Equation 1.1 in Carlip\[CloseCurlyQuote]s paper. ", "Text",
 CellChangeTimes->{{3.975509314625042*^9, 3.975509332542779*^9}, {
   3.9755093967742367`*^9, 3.975509444097381*^9}, {3.975523761280517*^9, 
   3.9755237631706676`*^9}, {3.9755254750618277`*^9, 3.975525483570767*^9}, 
   3.975525946502899*^9, {3.9757679319632607`*^9, 3.9757679519317303`*^9}, {
   3.975768684401401*^9, 3.9757686973018427`*^9}, {3.975786392004085*^9, 
   3.9757863953004503`*^9}, {3.975882488359703*^9, 3.975882490388026*^9}, {
   3.976105282896591*^9, 3.9761052870104437`*^9}, 
   3.976114008893449*^9},ExpressionUUID->"d9c2f8cc-56e3-4946-9dd8-\
ea99cec0c3a7"],

Cell[CellGroupData[{

Cell[TextData[{
 "Abbreviate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "R"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9ece7353-8c05-45aa-b503-648267575243"],
 " to ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "86f8791a-9434-4be6-a18c-7bd98a6d7beb"]
}], "Subsubsection",
 CellChangeTimes->{{3.9762672522248993`*^9, 
  3.9762672649393578`*^9}},ExpressionUUID->"3f6c9997-42d6-4385-99ff-\
0c933bbd2c6a"],

Cell[TextData[{
 "For now, write ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "aa1261af-3f34-4880-9e7c-fc288e3d744a"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "R"], TraditionalForm]],ExpressionUUID->
  "cff33e36-38d8-49da-8e38-d128445bc283"],
 " to save space and to avoid confusing subscript ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],ExpressionUUID->
  "d8a37af4-1fc3-41bf-b355-746e551bc5fa"],
 " (retarded) with tensorial subscripts. Just remember that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "R"], "->", "s"}], TraditionalForm]],ExpressionUUID->
  "31ae63e1-9ad6-44e1-8b02-c1df0a0eaae6"],
 " is a specific, dynamical variable that depends on ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "c2b20519-6249-4a68-a1b8-8e30f3b815fe"],
 ". It is also a specific value of ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "e9bfe566-2b15-4f4e-9ea8-edbf68fbe12d"],
 " as a generic path parameter of ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "9e7d70dc-0780-4f21-b443-741b56936e23"],
 ", but that fact does not concern us."
}], "Text",
 CellChangeTimes->{{3.9761411444917507`*^9, 3.976141260154666*^9}, {
   3.976145756151979*^9, 3.9761458196461554`*^9}, {3.976192273032477*^9, 
   3.976192292939176*^9}, {3.976292661964171*^9, 3.976292715894463*^9}, 
   3.976315357160595*^9},ExpressionUUID->"3dfd8d1c-9b86-451b-8318-\
c086004ca3e1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "\[Eta]", ",", "\[Phi]", ",", "\[Sigma]", ",", "\[Lambda]", ",", "r", ",", 
    "e", ",", "x", ",", "z", ",", "s"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.976137894480516*^9, 3.9761379368246393`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"f729387e-04fb-4bc5-97cf-b42a97292703"],

Cell[TextData[{
 "Here is a good-looking Wolfram version of Equation ",
 
 CounterBox["DisplayFormulaNumbered", "THE NULL INTERVAL"],
 ":"
}], "Text",
 CellChangeTimes->{{3.976141701054187*^9, 
  3.97614174692379*^9}},ExpressionUUID->"de44ad42-f197-48a4-b8e1-\
d6c83413e172"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"\[Phi]", "=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Eta]", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], "-", 
        RowBox[{
         RowBox[{"z", "[", "s", "]"}], "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}], "-", 
        RowBox[{
         RowBox[{"z", "[", "s", "]"}], "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], ")"}]}], 
     ")"}]}], ")"}], "/.", "dpyRules"}]], "Input",
 CellChangeTimes->{{3.976138377879073*^9, 3.976138454027317*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"8cc1fd5a-5b0c-4049-a181-9dfa37b7ef99"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[Eta]", 
   RowBox[{"\[Mu]", " ", "\[Nu]"}]], " ", 
  RowBox[{"(", 
   RowBox[{
    TemplateBox[{"x", "\[Mu]"},
     "Superscript"], "-", 
    TemplateBox[{
      RowBox[{"z", "[", "s", "]"}], "\[Mu]"},
     "Superscript"]}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    TemplateBox[{"x", "\[Nu]"},
     "Superscript"], "-", 
    TemplateBox[{
