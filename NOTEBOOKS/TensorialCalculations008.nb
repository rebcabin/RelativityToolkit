Cell[CellGroupData[{

Cell["Electrodynamical Aberration", "Section",
 CellChangeTimes->{{3.975525149447299*^9, 3.97552515851518*^9}, {
  3.975765820283935*^9, 3.975765824014308*^9}, {3.975765975158669*^9, 
  3.975765975236395*^9}, {3.976104823887608*^9, 
  3.97610482535867*^9}},ExpressionUUID->"bd5b8d96-5167-4bd8-bace-\
41222a96a2f6"],

Cell["\<\
It turns out that the same thing happens in electrodynamics, which has a \
central-force law similar to gravitation\[CloseCurlyQuote]s. The electric \
field does not point to the retarded position of the source! \
\>", "Text",
 CellChangeTimes->{{3.975431702486289*^9, 3.975431705835146*^9}, {
   3.975505763220232*^9, 3.975505912196392*^9}, {3.975505947316283*^9, 
   3.9755061414600554`*^9}, {3.9755063085878887`*^9, 
   3.9755064531871023`*^9}, {3.975506538277*^9, 3.9755065388234463`*^9}, {
   3.9755065922722893`*^9, 3.975506670013321*^9}, 3.975506797689434*^9, {
   3.975507893923176*^9, 3.9755079073417187`*^9}, {3.9755228208628798`*^9, 
   3.975522857090137*^9}, {3.9755232934081182`*^9, 3.9755233759483843`*^9}, {
   3.9755254017502527`*^9, 3.975525421226349*^9}, {3.975698216560763*^9, 
   3.975698244783433*^9}, {3.9756982999461937`*^9, 3.975698325746478*^9}, 
   3.9757658108253307`*^9, {3.9757659927703247`*^9, 3.9757660072774343`*^9}, 
   3.9757660537794933`*^9, {3.97588225906609*^9, 3.9758822844780607`*^9}, {
   3.975882456782557*^9, 3.975882462235374*^9}, {3.976019960148019*^9, 
   3.976019969956998*^9}, {3.976105017283517*^9, 3.976105032966984*^9}, {
   3.9761129724464273`*^9, 3.976112997178891*^9}, {3.976137293586138*^9, 
   3.976137307302717*^9}, 
   3.976144730266452*^9},ExpressionUUID->"e64c2293-b3cf-468d-8dcb-\
b801851125dc"],

Cell["\<\
Electrodynamics is easier to analyze because we don\[CloseCurlyQuote]t need \
Riemann curvature tensors and Christoffel symbols. Flat Minkowski space-time \
suffices for initial demonstration of \[ScriptCapitalU]\[ScriptCapitalD] \
indexing.\
\>", "Text",
 CellChangeTimes->{{3.975431702486289*^9, 3.975431705835146*^9}, {
   3.975505763220232*^9, 3.975505912196392*^9}, {3.975505947316283*^9, 
   3.9755061414600554`*^9}, {3.9755063085878887`*^9, 
   3.9755064531871023`*^9}, {3.975506538277*^9, 3.9755065388234463`*^9}, {
   3.9755065922722893`*^9, 3.975506670013321*^9}, 3.975506797689434*^9, {
   3.975507893923176*^9, 3.9755079073417187`*^9}, {3.9755228208628798`*^9, 
   3.975522857090137*^9}, {3.9755232934081182`*^9, 3.9755233759483843`*^9}, {
   3.9755254017502527`*^9, 3.975525421226349*^9}, {3.975698216560763*^9, 
