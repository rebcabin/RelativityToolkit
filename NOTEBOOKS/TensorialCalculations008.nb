  3.976142152678258*^9}},ExpressionUUID->"b1f37cca-3524-4637-904b-\
0654f1dda730"],

Cell[TextData[{
 "Thus, the gradient we seek is ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], "s"}], "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]"}]}], "/", 
      FractionBox[
       RowBox[{"d", "\[VeryThinSpace]", "\[Phi]"}], 
       RowBox[{"d", "\[VeryThinSpace]", "s"}]]}]}],
    Background->RGBColor[1, 1, 0]], TraditionalForm]],ExpressionUUID->
  "b90ccc91-bfba-4564-bc5e-f1ddfc01a310"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]"}], TraditionalForm]],
  ExpressionUUID->"c0d54507-2ad3-4abe-9e4a-e4e52be40db3"],
 " is a 4\[NoBreak]-\[NoBreak]vector and ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", "\[Phi]"}], 
    RowBox[{"d", "\[VeryThinSpace]", "s"}]], TraditionalForm]],ExpressionUUID->
  "1b992448-fea4-4ab5-915c-782abfbb2f03"],
 " is a scalar. Let\[CloseCurlyQuote]s compute the factors ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]"}], TraditionalForm]],
  ExpressionUUID->"96d16e0c-860c-447a-b335-9f5ee922e138"],
 " and ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", "\[Phi]"}], 
    RowBox[{"d", "\[VeryThinSpace]", "s"}]], TraditionalForm]],ExpressionUUID->
  "ff0c2324-a193-4302-ad82-47244be3a49d"],
 " one at a time."
}], "Text",
