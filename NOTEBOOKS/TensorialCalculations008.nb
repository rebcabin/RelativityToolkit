   3.9757862242702847`*^9, 3.975786246862709*^9}, {3.975842898346703*^9, 
   3.975842905863552*^9}, {3.975864619202055*^9, 3.9758646194279747`*^9}, 
   3.975882200827174*^9, {3.975940702913505*^9, 3.975940714888302*^9}, {
   3.9759407590025463`*^9, 3.975940762841379*^9}, {3.976019881771782*^9, 
   3.976019905282023*^9}, {3.976104832784774*^9, 3.976104851497799*^9}, {
   3.976104909660699*^9, 3.9761049495399933`*^9}, {3.976111077981853*^9, 
   3.9761110883837852`*^9}, {3.9761116926092863`*^9, 
   3.9761117670573797`*^9}, {3.9761366559640827`*^9, 3.97613668146133*^9}, {
   3.976136923314869*^9, 3.976136930140107*^9}, {3.976137219543397*^9, 
   3.976137224855755*^9}, {3.976191408671352*^9, 
   3.9761914466357937`*^9}},ExpressionUUID->"fc2a7ce0-255f-4b07-a5a1-\
765b6f759780"],

Cell[TextData[StyleBox["Actually, you must point the force vector roughly at \
the instantaneous center of gravity of the Earth-Sun system, which is almost \
at the center of the Sun. Such is likely a negligible quibble compared to \
aberration, magnetohydrodynamical fluctuations moving mass around, etc.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.975842920401845*^9, 3.9758429962131157`*^9}, {
  3.975864581462569*^9, 3.975864581703348*^9}, {3.975882218996207*^9, 
  3.975882247820291*^9}, {3.975940774997334*^9, 3.9759408000801277`*^9}, {
  3.976019918125359*^9, 3.976019943850604*^9}, {3.97611177721701*^9, 
  3.976111823583715*^9}, {3.976112443389406*^9, 3.976112451998786*^9}, {
  3.976144712308721*^9, 3.97614471577975*^9}, {3.9761914815935783`*^9, 
