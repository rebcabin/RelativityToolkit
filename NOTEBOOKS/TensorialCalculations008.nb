Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "dpyRules", ",", "d", ",", "s", ",", "\[Lambda]", ",", "\[Sigma]", ",", 
    "\[Eta]", ",", "d\[Lambda]ds"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dpyRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Specific", " ", "rules", " ", "ahead", " ", "of", " ", "general", " ", 
      "rules"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"d\[Lambda]ds", "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}], "]"}], ":>", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"FractionBox", "[", 
         RowBox[{
          RowBox[{"d", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\[Lambda]", ",", "\[Nu]"}], "]"}]}], ",", 
          RowBox[{"d", " ", "s"}]}], "]"}], "//", "DisplayForm"}], ")"}]}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"d\[Lambda]ds", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]_", "]"}], "]"}], ":>", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"FractionBox", "[", 
         RowBox[{
          RowBox[{"d", " ", 
           RowBox[{"Superscript", "[", 
            RowBox[{"\[Lambda]", ",", "\[Nu]"}], "]"}]}], ",", 
          RowBox[{"d", " ", "s"}]}], "]"}], "//", "DisplayForm"}], ")"}]}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"General", " ", "Rules"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CurlyEpsilon]_", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "\[Tau]_", "]"}], "]"}], ":>", 
      RowBox[{"Superscript", "[", 
       RowBox[{"\[CurlyEpsilon]", ",", "\[Tau]"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CurlyEpsilon]_", "[", 
