Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"d", "\[VeryThinSpace]", 
     RowBox[{
      SubscriptBox["\[Lambda]", 
       RowBox[{"\[VeryThinSpace]", "\[Nu]"}]], "(", 
      SubscriptBox["s", "R"], ")"}]}], 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", 
      RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}]], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        RowBox[{
         SubscriptBox["\[Lambda]", 
          RowBox[{"\[VeryThinSpace]", "\[Nu]"}]], "(", 
         SubscriptBox["s", "R"], ")"}]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "\[Mu]"]}]], "=", "0"}], ")"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"d", "\[VeryThinSpace]", 
       RowBox[{
        SubscriptBox["\[Lambda]", 
         RowBox[{"\[VeryThinSpace]", "\[Nu]"}]], "(", 
        SubscriptBox["s", "R"], ")"}]}], 
      RowBox[{"d", "\[VeryThinSpace]", 
       SubscriptBox["s", "R"]}]], 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], 
      SubscriptBox["s", "R"]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
