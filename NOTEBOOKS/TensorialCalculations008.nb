Cell[CellGroupData[{

Cell["Field Strength Faraday Tensor", "Section",
 CellChangeTimes->{{3.975863768420878*^9, 3.975863821142161*^9}, 
   3.976266859734476*^9, {3.976268370186138*^9, 
   3.976268373786888*^9}},ExpressionUUID->"10232325-ffc7-4a9c-bdd0-\
5f0d28acd63e"],

Cell[TextData[{
 "To get the field-strength Faraday tensor, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], 
      SubscriptBox["A", "\[Nu]"]}], "-", 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Nu]"], 
      SubscriptBox["A", "\[Mu]"]}]}]}], TraditionalForm]],ExpressionUUID->
  "25c4f557-90a3-4853-96da-12f5b1607d44"],
 ", we\[CloseCurlyQuote]ll need gradients for ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]],ExpressionUUID->
  "335674b0-3bfd-4d4c-8041-76ae1773d463"],
 ", ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "0e58d72c-c651-4ac8-9569-6740c61ea084"],
 ", \[Sigma], and \[Lambda] as we grind through the chain rule applied to ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2bf82b63-7e45-496a-a296-7a15b5af681e"],
 "."
}], "Text",
