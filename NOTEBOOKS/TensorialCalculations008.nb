Cell[TextData[{
 ButtonBox["Carlip\[CloseCurlyQuote]s paper, ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/gr-qc/9909087"], None},
  ButtonNote->"https://arxiv.org/abs/gr-qc/9909087"],
 StyleBox[ButtonBox["Aberration and the Speed of Gravity",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/gr-qc/9909087"], None},
  ButtonNote->"https://arxiv.org/abs/gr-qc/9909087"],
  FontVariations->{"Underline"->True}],
 " starts with electrodynamical aberration, then progresses to the \
gravitational case. We formalize and check his math."
}], "Text",
