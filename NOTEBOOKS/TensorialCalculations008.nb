Cell[TextData[{
 "In an ",
 StyleBox[ButtonBox["earlier notebook",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3594810?p_p_auth=\
r0oPFwKY"], None},
  ButtonNote->
   "https://community.wolfram.com/groups/-/m/t/3594810?p_p_auth=r0oPFwKY"],
  FontVariations->{"Underline"->True}],
 ", I showed how tensorial forms from Lagrangians, not only account for \
relativity but ",
 StyleBox["force",
  FontSlant->"Italic"],
 " it. To keep that notebook short, it contained only informal mathematics. I \
saved Wolfram code\[LongDash]formal mathematics\[LongDash]for this companion \
notebook. Here we exhibit  \[ScriptCapitalU]\[ScriptCapitalD] indexing on a \
specific example: ",
 StyleBox["relativistic aberration",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellChangeTimes->{{3.9754309671193943`*^9, 3.975431061601799*^9}, {
