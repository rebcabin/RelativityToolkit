  "GRADIENT OF SR",ExpressionUUID->"56a58c88-23ae-49eb-b359-89b590a9b8dc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"r", 
    RowBox[{"(", "x", ")"}]}], "=", 
   RowBox[{
    SuperscriptBox["\[Lambda]", "\[Mu]"], 
    RowBox[{"(", 
     SubscriptBox["s", "R"], ")"}], 
    SubscriptBox["\[Sigma]", "\[Mu]"]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
