Cell[BoxData[{
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[PartialD]", "\[Phi]"}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "\[Rho]"]}]], "[", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Eta]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "(", 
     RowBox[{
      SuperscriptBox["x", "\[Mu]"], "-", 
      RowBox[{
       SuperscriptBox["z", "\[Mu]"], "(", 
       SubscriptBox["s", "R"], ")"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["x", "\[Nu]"], "-", 
      RowBox[{
       SuperscriptBox["z", "\[Nu]"], "(", 
       SubscriptBox["s", "R"], ")"}]}], ")"}]}], "]"}], TraditionalForm], "\[LineSeparator]", 
 FormBox[
  RowBox[{"=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Eta]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "(", 
      RowBox[{
       SuperscriptBox["x", "\[Nu]"], "-", 
       SuperscriptBox[
        RowBox[{"z", "(", "s", ")"}], 
        RowBox[{"\[VeryThinSpace]", "\[Nu]"}]]}], ")"}], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "\[Rho]"]}]]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Eta]", 
       RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], "(", 
      RowBox[{
       SuperscriptBox["x", "\[Mu]"], "-", 
       SuperscriptBox[
        RowBox[{"z", "(", "s", ")"}], 
        RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}], ")"}], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", 
        RowBox[{"\[VeryThinSpace]", "\[Nu]"}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "\[Rho]"]}]]}]}]}], TraditionalForm], "\[LineSeparator]", 
 FormBox[
  RowBox[{"=", 
   RowBox[{"2", 
    RowBox[{
     SubscriptBox["\[Eta]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Rho]"}]], "(", 
     RowBox[{
      SuperscriptBox["x", "\[Mu]"], "-", 
      RowBox[{
       SuperscriptBox["z", "\[Mu]"], "(", "s", ")"}]}], ")"}]}]}], 
  TraditionalForm], "\[LineSeparator]", 
 FormBox[
  RowBox[{"=", 
