  3.9762665689221*^9}},ExpressionUUID->"b5a628eb-da12-42c6-a28d-1680f393f2fd"],

Cell[TextData[{
 "Remembering that \[Lambda] depends only implicitly on ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "b54484c1-a39d-4452-bd6c-b084fe1ad28e"],
 ":"
}], "Text",
