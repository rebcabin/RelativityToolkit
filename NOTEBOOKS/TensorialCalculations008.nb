Cell[CellGroupData[{

Cell["Gradient of the Separation Vector \[Sigma]", "Subsubsection",
 CellChangeTimes->{{3.9759707060671787`*^9, 3.975970722700325*^9}, {
  3.9759714204814587`*^9, 
  3.975971424670533*^9}},ExpressionUUID->"ad7d52a1-86c4-4ecd-9af9-\
3a57a0f4deff"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll need ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Mu]"], 
    SuperscriptBox["\[Sigma]", 
     RowBox[{"\[VeryThinSpace]", "\[Nu]"}]]}], TraditionalForm]],
  ExpressionUUID->"a4aef905-471c-4357-9021-5ce83409e8de"],
 ": "
}], "Text",
 CellChangeTimes->{{3.9759624328631153`*^9, 3.9759624630369377`*^9}, {
  3.975962524802856*^9, 3.975962698230331*^9}, {3.97596765141302*^9, 
  3.9759676762977943`*^9}},ExpressionUUID->"1d5b50e6-6e89-4f75-9c0a-\
3ce59624fb93"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Mu]"], 
    SuperscriptBox["\[Sigma]", 
     RowBox[{"\[VeryThinSpace]", "\[Nu]"}]]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "\[Nu]"], "-", 
       RowBox[{
        SuperscriptBox["z", 
         RowBox[{"\[VeryThinSpace]", "\[Nu]"}]], "(", 
        SubscriptBox["s", "R"], ")"}]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Mu]"], 
       SuperscriptBox["x", "\[Nu]"]}], "-", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Mu]"], 
       RowBox[{
        SuperscriptBox["z", 
         RowBox[{"\[VeryThinSpace]", "\[Nu]"}]], "(", 
        SubscriptBox["s", "R"], ")"}]}]}], "=", 
     RowBox[{
      StyleBox[
       SubsuperscriptBox["\[Delta]", "\[Mu]", "\[Nu]"],
       Background->RGBColor[0.87, 0.94, 1]], "-", 
      StyleBox[
       RowBox[{
        FractionBox[
         RowBox[{"d", "\[VeryThinSpace]", 
          SuperscriptBox["z", "\[Nu]"]}], 
         RowBox[{"d", "\[VeryThinSpace]", 
          SubscriptBox["s", "R"]}]], 
        RowBox[{
         SubscriptBox["\[PartialD]", "\[Mu]"], 
         SubscriptBox["s", "R"]}]}],
       Background->RGBColor[1, 0.85, 0.85]]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9759624328631153`*^9, 3.9759624630369377`*^9}, {
  3.975962524802856*^9, 3.975962782897677*^9}, {3.9759628165191727`*^9, 
  3.975962827751392*^9}, {3.975963055291944*^9, 3.975963093995925*^9}, {
  3.9762656064733047`*^9, 
  3.976265628469533*^9}},ExpressionUUID->"96e1d33e-2f10-420d-82aa-\
31f2ca5b6123"],

Cell[TextData[{
 "The first term, the ",
 StyleBox["Kronecker delta",
  Background->RGBColor[0.87, 0.94, 1]],
 ", in Lorentz-invariant form, is the Minkowski metric \[Eta]. "
}], "Text",
 CellChangeTimes->{{3.97596309967667*^9, 3.9759631548659697`*^9}, {
  3.9759631876540947`*^9, 3.9759632076856413`*^9}, {3.9759637341621523`*^9, 
  3.975963775910149*^9}, {3.975963964598605*^9, 3.9759640390719223`*^9}, {
  3.975967694046513*^9, 3.975967699278596*^9}, {3.975968436644333*^9, 
  3.975968445066141*^9}, {3.976265653588367*^9, 
  3.976265658338954*^9}},ExpressionUUID->"8b4cd5c7-93f5-424e-9491-\
608eb8e9860b"],

Cell[TextData[{
 "For ",
 StyleBox["the second term",
  Background->RGBColor[1, 0.85, 0.85]],
 ", we\[CloseCurlyQuote]ve already defined ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Lambda]", "\[Nu]"], "\[Congruent]", 
    FractionBox[
     RowBox[{"d", "\[VeryThinSpace]", 
      SuperscriptBox["z", "\[Nu]"]}], 
     RowBox[{"d", "\[VeryThinSpace]", 
      SubscriptBox["s", "R"]}]]}], TraditionalForm]],
  CellChangeTimes->{{3.9759624328631153`*^9, 3.9759624630369377`*^9}, {
   3.975962524802856*^9, 3.975962782897677*^9}, {3.9759628165191727`*^9, 
   3.975962827751392*^9}, {3.975963055291944*^9, 3.975963093995925*^9}},
  ExpressionUUID->"83d5b07a-a90e-4574-bf8f-928969f2f5af"],
 ", and we\[CloseCurlyQuote]ve already calculated ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], 
     SubscriptBox["s", "R"]}], "=", 
    RowBox[{
     SubscriptBox["\[Sigma]", "\[Mu]"], "/", "r"}]}], TraditionalForm]],
  CellChangeTimes->{{3.9759624328631153`*^9, 3.9759624630369377`*^9}, {
   3.975962524802856*^9, 3.975962782897677*^9}, {3.9759628165191727`*^9, 
   3.975962827751392*^9}, {3.975963055291944*^9, 3.975963093995925*^9}},
  ExpressionUUID->"8b2d1a1d-d6ee-440c-a424-6a08f51fc25a"],
 " (Equation ",
 
 CounterBox["DisplayFormulaNumbered", "GRADIENT OF SR"],
 "). "
}], "Text",
 CellChangeTimes->{{3.97596309967667*^9, 3.9759631548659697`*^9}, {
   3.9759631876540947`*^9, 3.9759632076856413`*^9}, {3.9759637341621523`*^9, 
   3.975963775910149*^9}, {3.975963964598605*^9, 3.9759640390719223`*^9}, {
   3.975967694046513*^9, 3.975967699278596*^9}, {3.975968436644333*^9, 
   3.9759684368868227`*^9}, {3.976265712932435*^9, 3.9762657474044933`*^9}, {
   3.976265842748724*^9, 3.976265875412549*^9}, 
   3.976266372643599*^9},ExpressionUUID->"c12f90f1-ac0b-48d9-bc3e-\
b01b3c5f2948"],

Cell["The following works whether \[Mu] is up or down, ditto \[Nu]:", "Text",
 CellChangeTimes->{{3.97596309967667*^9, 3.9759631548659697`*^9}, {
  3.9759631876540947`*^9, 3.9759632076856413`*^9}, {3.9759637341621523`*^9, 
