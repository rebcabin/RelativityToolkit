Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"d", "\[VeryThinSpace]", "\[Phi]"}], 
      RowBox[{"d", "\[VeryThinSpace]", "s"}]], 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], "s"}]}]}], "=", "0"}], 
  TraditionalForm]], "DisplayFormulaNumbered",
