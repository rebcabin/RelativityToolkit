Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], 
     SubscriptBox["s", "R"]}], 
    RowBox[{"(", "x", ")"}]}], "=", 
   FractionBox[
    SubscriptBox["\[Sigma]", "\[Mu]"], 
    RowBox[{"r", "(", "x", ")"}]]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.975963359946073*^9, 3.975963400886695*^9}, {
  3.975963493872781*^9, 3.9759634938743773`*^9}},
