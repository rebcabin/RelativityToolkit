Cell[BoxData[
 RowBox[{
  TagBox["\<\"1. Input \\!\\(\\*SubscriptBox[\\(\[PartialD]\\), \
\\(\[Beta]'\\)]\\)(\\!\\(\\*SuperscriptBox[\\(A\\), \\(\[Alpha]'\\)]\\)) \
\[Congruent] \\!\\(\\*SubscriptBox[SuperscriptBox[\\(A\\), \\(\[Alpha]'\\)], \
\\(, \\(\\\\ \\)\\(\[Beta]'\\)\\)]\\):\"\>",
   "EchoLabel"], "  ", 
  SubscriptBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"A", 
       SuperscriptBox["", "\[Mu]23"]}], ")"}], " ", 
     FractionBox[
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", "ap"]}], 
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       SuperscriptBox["", "\[Mu]23"]}]]}], ")"}], 
   RowBox[{",", "bp"}]]}]], "Echo",
