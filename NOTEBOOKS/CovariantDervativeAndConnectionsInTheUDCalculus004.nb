  3.9776605936105556`*^9}},ExpressionUUID->"620cbe4c-e2ba-4552-9c34-\
9b50a700b51f"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s have \[ScriptCapitalU]\[ScriptCapitalD] do this bit \
of calculus. As stated, the code is maintained as a block of code rather than \
as alternating prose and code cells. But the comments and the Echoes tell the \
whole story as prose. ",
 StyleBox["Read The Code",
  FontWeight->"Bold"],
 " and the results. "
}], "Text",
 CellChangeTimes->{{3.977041334909045*^9, 3.977041357964467*^9}, {
   3.9770413927139*^9, 3.977041393667335*^9}, 3.9770652572467546`*^9, {
   3.977154207926816*^9, 3.977154217613781*^9}, {3.977326764596551*^9, 
   3.9773268080223083`*^9}, 3.977327236988377*^9, {3.977345485094471*^9, 
   3.97734552493747*^9}, {3.977345571806055*^9, 3.977345572042383*^9}, {
   3.977660619678384*^9, 
   3.97766064498179*^9}},ExpressionUUID->"b2d77625-7405-4742-b8f5-\
13c59f7aa6d6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"ap", ",", "bp", ",", "mu"}], "]"}], ";"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "1"}], ":", " ", 
    RowBox[{"Define", " ", "the", " ", "Input"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Partial", " ", "derivative", " ", "of", " ", "the", " ", "Transformed", " ",
     "Vector", " ", 
    RowBox[{"A", "'"}], " ", 
    RowBox[{"w", ".", "r", ".", "t"}], " ", 
    RowBox[{"x", "'"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Input", ":", " ", 
    RowBox[{"via", " ", "Partials"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"inputTerm", "=", 
    RowBox[{"Echo", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Partials", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Expand", " ", 
         SuperscriptBox["A", 
          RowBox[{"\[Alpha]", "'"}]], " ", "into", " ", "Jac", " ", "*", " ", 
         
         SuperscriptBox["A", "\[Mu]"], " ", "immediately", " ", "via", " ", 
         "existing", " ", "rule"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "ap", "]"}], "]"}], "/.", " ", 
         "robustTransformRules"}], ",", 
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "bp", "]"}], "]"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "\"\<1. Input \
\!\(\*SubscriptBox[\(\[PartialD]\), \
\(\[Beta]'\)]\)(\!\(\*SuperscriptBox[\(A\), \(\[Alpha]'\)]\)) \[Congruent] \!\
\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Alpha]'\)], \(, \(\\\ \)\(\[Beta]'\
\)\)]\):\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "2"}], ":", 
    RowBox[{"Mechanical", " ", "Expansion"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Apply", " ", "Leibniz", " ", "and", " ", "Chain", " ", "Rule", " ", 
    "repeatedly", " ", "until", " ", "stable"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"expandedTerm", "=", 
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"ExpandDerivatives", "[", "inputTerm", "]"}], ",", 
      "\[IndentingNewLine]", "\"\<2. Mechanically Expanded Derivative:\>\""}],
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "3"}], ":", "Formatting"}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Map", " ", "internal", " ", "unique", " ", "dummies", " ", "to", " ", 
    "readable", " ", "Greek"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"prettyResult", "=", 
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"expandedTerm", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ap", "->", 
          RowBox[{"\[Alpha]", "'"}]}], ",", 
         RowBox[{"bp", "->", 
          RowBox[{"\[Beta]", "'"}]}], ",", 
         RowBox[{"mu", "->", "\[Mu]"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", "\"\<3. Peek at unique dummy indices\>\""}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"brokenPartial", "=", 
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"TensorForm", "[", "prettyResult", "]"}], ",", 
     "\[IndentingNewLine]", "\"\<4. Expanded \!\(\*SubscriptBox[\(\[PartialD]\
\), \(\[Beta]'\)]\)(\!\(\*SuperscriptBox[\(A\), \(\[Alpha]'\)]\)) in Readable \
Greek\>\""}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.977008741929626*^9, 3.977008820235695*^9}, 
   3.977008885372672*^9, {3.9770094423020697`*^9, 3.9770094577204313`*^9}, {
   3.977009737355989*^9, 3.977009833411221*^9}, {3.9770098725691023`*^9, 
   3.977009904582294*^9}, {3.977009936258263*^9, 3.977009980150612*^9}, {
   3.9770414147097273`*^9, 3.977041424849421*^9}, {3.9770532950091743`*^9, 
   3.977053301338974*^9}, {3.977065288356881*^9, 3.977065415628669*^9}, {
   3.9771542395214577`*^9, 3.977154247109915*^9}, {3.977154624176413*^9, 
   3.977154690844907*^9}, 3.977179168389043*^9, {3.9773268593533373`*^9, 
   3.977326877296373*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"f2ecf498-1b10-4db8-9555-6f43d404622a"],

