Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"Description\"\>",
      StripOnInput->False,
      FontSize->16,
      FontWeight->Bold], 
     StyleBox["\<\"Rendered Output\"\>",
      StripOnInput->False,
      FontSize->16,
      FontWeight->Bold]},
    {
     StyleBox["\<\"Generic Mixed Partial\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], "f"}], 
       RowBox[{
        RowBox[{"\[PartialD]", "x"}], 
        RowBox[{"\[PartialD]", "y"}]}]],
      DisplayForm]},
    {
     StyleBox["\<\"Coordinate Hessian\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      FractionBox[
       RowBox[{
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], "x"}], 
        SuperscriptBox["", 
         SuperscriptBox["\[Alpha]", "\[Prime]",
          MultilineFunction->None]]}], 
       RowBox[{
        RowBox[{"\[PartialD]", "x"}], 
        SuperscriptBox["", "\[Beta]"], 
        RowBox[{"\[PartialD]", "x"}], 
        SuperscriptBox["", "\[Alpha]"]}]],
      DisplayForm]},
    {
     StyleBox["\<\"Atomic Tensor\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      SubscriptBox[
       RowBox[{"A", 
        SuperscriptBox["", "\[Mu]"]}], 
       RowBox[{",", "\[Nu]"}]],
      DisplayForm]},
    {
     StyleBox["\<\"Sealed Product (v.1.6.1 fix)\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      SubscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"A", 
           SuperscriptBox["", "\[Mu]"]}], ")"}], " ", 
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{"\[Sigma]", "\[Lambda]"}], "\[Rho]"]}], ")"}], 
       RowBox[{",", "\[Nu]"}]],
      DisplayForm]},
    {
     StyleBox["\<\"Sealed Sum (Linearity)\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      SubscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"A", 
          SuperscriptBox["", "\[Mu]"]}], "+", 
         RowBox[{"B", 
          SuperscriptBox["", "\[Mu]"]}]}], ")"}], 
       RowBox[{",", "\[Nu]"}]],
      DisplayForm]},
    {
     StyleBox["\<\"Sealed Power (Non-Linear)\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      SubscriptBox[
       RowBox[{"(", 
        SuperscriptBox["\[Phi]", "2"], ")"}], 
       RowBox[{",", "\[Nu]"}]],
      DisplayForm]},
    {
     StyleBox["\<\"Covariant Derivative (Abstract)\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      TagBox[
       SubscriptBox[
        RowBox[{"A", 
         SuperscriptBox["", "\[Mu]"]}], 
        RowBox[{";", "\[Nu]"}]],
       HoldForm],
      DisplayForm]},
    {
     StyleBox["\<\"Covariant Derivative (Expanded)\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     TagBox[
      TagBox[
       RowBox[{
        SubscriptBox[
         RowBox[{"A", 
          SuperscriptBox["", "\[Mu]"]}], 
         RowBox[{",", "\[Nu]"}]], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"A", 
           SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{"\[Nu]", "\[Lambda]"}], "\[Mu]"]}]}],
       HoldForm],
      DisplayForm]}
