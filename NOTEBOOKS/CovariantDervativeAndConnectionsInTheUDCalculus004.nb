     RowBox[{"(", 
      RowBox[{"Left", "-", 
       RowBox[{"Cycle", " ", "Indices"}]}], ")"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"term3", "=", 
