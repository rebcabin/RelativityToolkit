        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], "]"}], "/.",
      " ", "GammaSymmetryRule"}], "/.", " ", "MetricSymmetryRule"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
