Cell[TextData[{
 "Notice, as promised, the connection coefficient exactly subtracts off the \
offending Hessian from the partial derivative of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40a0584b-5385-4bbb-819d-6677e27a0917"],
 "! "
}], "Text",
