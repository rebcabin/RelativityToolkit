to multiply through.\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Find", " ", "the", " ", "metric", " ", "inside", " ", "the", " ",
     "LHS", " ", "term"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"metricFound", "=", 
      RowBox[{"First", "[", 
       RowBox[{"Cases", "[", 
        RowBox[{"lhsRaw", ",", 
         RowBox[{"g", "[", "__", "]"}], ",", "Infinity"}], "]"}], "]"}]}], 
     ",", "\"\<g found\>\""}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "Find", " ", "the", " ", "Gamma", " ", "inside", " ", "the", " ",
     "LHS", " ", "term"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"gammaFound", "=", 
      RowBox[{"First", "[", 
       RowBox[{"Cases", "[", 
        RowBox[{"lhsRaw", ",", 
         RowBox[{"\[CapitalGamma]", "[", "__", "]"}], ",", "Infinity"}], 
        "]"}], "]"}]}], ",", "\"\<\[CapitalGamma] found\>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "Extract", " ", "raw", " ", "symbols", " ", "from", " ", "the", 
    " ", "indices"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"metricIndices", "=", 
     RowBox[{"First", "/@", 
      RowBox[{"(", 
       RowBox[{"List", "@@", "metricFound"}], ")"}]}]}], 
    ",", "\"\<g indices\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"gammaUpIndex", "=", 
      RowBox[{"First", "[", 
       RowBox[{"First", "[", "gammaFound", "]"}], "]"}]}], 
     ",", "\"\<\[CapitalGamma] up index\>\""}], "]"}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"4.", " ", "Identify", " ", "the", " ", "Target", " ", "Index"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "The", " ", "g", " ", "index", " ", "that", " ", "matches", " ", 
     "\[CapitalGamma]", " ", "up"}], "-", 
    RowBox[{"index", " ", "is", " ", "the", " ", 
     RowBox[{"Dummy", ".", " ", "The"}], " ", "other", " ", "is", " ", "the", 
     " ", 
     RowBox[{"Target", "."}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"targetIndex", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"metricIndices", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "===", "gammaUpIndex"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"metricIndices", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"metricIndices", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], 
     ",", "\"\<target index\>\""}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "5.", " ", "Construct", " ", "the", " ", "specific", " ", "Inverse", " ", 
    "needed"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"invMetricFactor", "=", 
     RowBox[{
      RowBox[{"1", "/", "2"}], "*", 
      RowBox[{"g", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalU]", "[", "\[Sigma]", "]"}], ",", 
        RowBox[{"\[ScriptCapitalU]", "[", "targetIndex", "]"}]}], "]"}]}]}], 
    ",", "\"\<\!\(\*FractionBox[\(1\), \(2\)]\)\!\(\*SuperscriptBox[\(g\), \
\(-1\)]\) =\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
