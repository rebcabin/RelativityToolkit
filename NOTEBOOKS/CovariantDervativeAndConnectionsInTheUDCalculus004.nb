Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", \
"\"\<=========================================================================\
\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Christoffel Symbols for Gravitation from Metric via the \
\[ScriptCapitalU]\[ScriptCapitalD] Calculus\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", \
"\"\<=========================================================================\
\>\"", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "g", ",", "GammaSymmetryRule", ",", "MetricSymmetryRule", ",", "term1", ",",
      "term2", ",", "term3", ",", "combination", ",", "targetIndex"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<1. PHYSICAL CONSTRAINTS \
-------------------------------------------------\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<1a. Torsion-free geometry: \
\!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalGamma]\), \(\[Alpha]\)], \(\
\[Beta]\[Gamma]\)]\) == \
\!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalGamma]\), \(\[Alpha]\)], \(\
\[Gamma]\[Beta]\)]\), [MTW] Box 10.2, page 250 \>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GammaSymmetryRule", "=", 
    RowBox[{"Echo", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[CapitalGamma]", "[", 
        RowBox[{"u_", ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "b_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "c_", "]"}]}], "]"}], ":>", 
       "\[IndentingNewLine]", 
       RowBox[{"\[CapitalGamma]", "[", 
        RowBox[{"u", ",", 
         RowBox[{"\[ScriptCapitalD]", "[", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"{", 
             RowBox[{"b", ",", "c"}], "}"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"{", 
             RowBox[{"b", ",", "c"}], "}"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "\"\<\[CapitalGamma] Symmetry: \>\""}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<1b. Metric Symmetry: \!\(\*SubscriptBox[\(g\), \
\(\[Alpha]\[Beta]\)]\) == \!\(\*SubscriptBox[\(g\), \(\[Beta]\[Alpha]\)]\), \
[MTW] Equation 8.24, page 210\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Style", "[", 
    RowBox[{"\"\<(output manipulated as expected by \[ScriptCapitalU]\
\[ScriptCapitalD] display rules)\>\"", ",", "Gray"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MetricSymmetryRule", "=", 
    RowBox[{"Echo", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "a_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "b_", "]"}]}], "]"}], ":>", 
       "\[IndentingNewLine]", 
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "\"\<g Symmetry\>\""}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<1c. Metric Compatibility Postulates \!\(\*SubscriptBox[\
\(\[Del]\), \([\[Lambda]\)]\)\!\(\*SubscriptBox[\(g\), \(\[Mu]\[Nu]\(]\)\)]\) \
= 0 [MTW] Eqn 8.23 & Chapter 14.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Term", " ", "1"}], ":", " ", 
    RowBox[{
     SubscriptBox["\[Del]", "\[Lambda]"], 
     SubscriptBox["g", "\[Mu]\[Nu]"]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"term1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Lambda]", "]"}], "]"}]}], "]"}], 
     "/.", " ", "GammaSymmetryRule"}], "/.", " ", "MetricSymmetryRule"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"TensorForm", "[", "term1", "]"}], 
     ",", "\"\<0 = \!\(\*SubscriptBox[\(\[Del]\), \
\(\[Lambda]\)]\)\!\(\*SubscriptBox[\(g\), \(\[Mu]\[Nu]\)]\) =\>\""}], "]"}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Term", " ", "2"}], ":", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", "\[Mu]"], 
      SubscriptBox["g", "\[Nu]\[Lambda]"]}], " ", 
     RowBox[{"(", 
      RowBox[{"Left", "-", 
       RowBox[{"Cycle", " ", "Indices"}]}], ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"term2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], ",", 
