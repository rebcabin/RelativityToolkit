        SuperscriptBox["", "\[Nu]"]}], 
       ")"}]}], "\<\"Input: A[\[ScriptCapitalD][\[Nu]]]B[\[ScriptCapitalU][\
\[Nu]]]\"\>"},
    {"\<\"2. Definition\"\>", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", 
