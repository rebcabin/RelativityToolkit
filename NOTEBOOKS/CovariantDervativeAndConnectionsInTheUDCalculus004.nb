Cell[BoxData[
 RowBox[{
  TagBox["\<\"target index\"\>",
   "EchoLabel"], "  ", "\[Lambda]"}]], "Echo",
 CellChangeTimes->{
  3.977699284420203*^9},ExpressionUUID->"ef618e7a-8db2-4fba-8c99-\
25d5fd484e0d"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"\\!\\(\\*FractionBox[\\(1\\), \
\\(2\\)]\\)\\!\\(\\*SuperscriptBox[\\(g\\), \\(-1\\)]\\) =\"\>",
   "EchoLabel"], "  ", 
  FractionBox["1", "2"], " ", 
  RowBox[{"(", 
   RowBox[{"g", 
    SuperscriptBox["", "\[Sigma]"], 
    SuperscriptBox["", "\[Lambda]"]}], ")"}]}]], "Echo",
 CellChangeTimes->{
  3.977699284427781*^9},ExpressionUUID->"89d96630-e3be-4e61-8e5c-\
8d6d362903ee"],

Cell[BoxData[
 StyleBox["\<\"(1/2 cancels factor 2 from \[CapitalGamma] part (canonical) \
above)\"\>",
  StripOnInput->False,
  LineColor->GrayLevel[0.5],
  FrontFaceColor->GrayLevel[0.5],
  BackFaceColor->GrayLevel[0.5],
  GraphicsColor->GrayLevel[0.5],
  FontColor->GrayLevel[0.5]]], "Print",
 CellChangeTimes->{3.977699284429525*^9},
 CellLabel->
  "During evaluation of \
In[29]:=",ExpressionUUID->"9f37b698-ed12-4a76-8659-5a5f7be6b459"],

Cell[BoxData["\<\"3c. Multiply and Contract\"\>"], "Print",
 CellChangeTimes->{3.9776992844299583`*^9},
 CellLabel->
  "During evaluation of \
In[29]:=",ExpressionUUID->"6ca5fc98-c9db-4eb8-b72e-7e617156d755"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"\[Delta]-\[CapitalGamma] contraction rule: \"\>",
   "EchoLabel"], "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalGamma]", "[", 
     RowBox[{
      RowBox[{"\[ScriptCapitalU]", "[", "r_", "]"}], ",", "a_", ",", "b_"}], 
     "]"}], " ", 
    SubsuperscriptBox["\[Delta]", "r_", "s_"]}], "\[RuleDelayed]", 
   RowBox[{"\[CapitalGamma]", "[", 
    RowBox[{
     RowBox[{"\[ScriptCapitalU]", "[", "s", "]"}], ",", "a", ",", "b"}], 
    "]"}]}]}]], "Echo",
 CellChangeTimes->{
  3.977699284430653*^9},ExpressionUUID->"4c7ee711-74d7-4802-8e1f-\
9dc6c0ddd331"],

Cell[BoxData[
 StyleBox["\<\"(will be promoted into \[ScriptCapitalU]\[ScriptCapitalD] in \
the future)\"\>",
  StripOnInput->False,
  LineColor->GrayLevel[0.5],
  FrontFaceColor->GrayLevel[0.5],
  BackFaceColor->GrayLevel[0.5],
  GraphicsColor->GrayLevel[0.5],
  FontColor->GrayLevel[0.5]]], "Print",
 CellChangeTimes->{3.977699284437203*^9},
 CellLabel->
  "During evaluation of \
In[29]:=",ExpressionUUID->"a8ae4f3e-69ef-4638-b8b2-a73b05a394a2"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"LHS solved: \"\>",
   "EchoLabel"], "  ", 
  SubsuperscriptBox["\[CapitalGamma]", 
   RowBox[{"\[Mu]", "\[Nu]"}], "\[Sigma]"]}]], "Echo",
 CellChangeTimes->{
  3.977699284437985*^9},ExpressionUUID->"baee6072-6661-48b1-86af-\
3a668da3dbca"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"RHS solved:\"\>",
   "EchoLabel"], "  ", 
  FractionBox["1", "2"], " ", 
  RowBox[{"(", 
   RowBox[{"g", 
    SuperscriptBox["", "\[Sigma]"], 
    SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    SubscriptBox[
     RowBox[{"g", 
      SubscriptBox["", "\[Lambda]"], 
      SubscriptBox["", "\[Mu]"]}], 
     RowBox[{",", "\[Nu]"}]], "+", 
    SubscriptBox[
     RowBox[{"g", 
      SubscriptBox["", "\[Lambda]"], 
      SubscriptBox["", "\[Nu]"]}], 
     RowBox[{",", "\[Mu]"}]], "-", 
    SubscriptBox[
     RowBox[{"g", 
      SubscriptBox["", "\[Mu]"], 
      SubscriptBox["", "\[Nu]"]}], 
     RowBox[{",", "\[Lambda]"}]]}], ")"}]}]], "Echo",
 CellChangeTimes->{
  3.9776992844420223`*^9},ExpressionUUID->"5b32a07f-a303-457e-92fa-\
b35598a0df7f"],

Cell[BoxData["\<\"\\n=== CHRISTOFFEL SYMBOLS FOR GRAVITATION ===\"\>"], \
"Print",
 CellChangeTimes->{3.977699284449102*^9},
 CellLabel->
  "During evaluation of \
In[29]:=",ExpressionUUID->"06607a4c-6c02-4860-9e68-1be024970086"],

Cell[BoxData["\<\"aka The Fundamental Theorem of Riemannian Geometry\"\>"], \
"Print",
 CellChangeTimes->{3.9776992844495296`*^9},
 CellLabel->
  "During evaluation of \
In[29]:=",ExpressionUUID->"1e359fbd-1ff3-497b-838c-72715183589d"]
}, Open  ]],

Cell[BoxData[
 TagBox[
  RowBox[{
   SubsuperscriptBox["\[CapitalGamma]", 
    RowBox[{"\[Mu]", "\[Nu]"}], "\[Sigma]"], "\[Equal]", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"g", 
      SuperscriptBox["", "\[Sigma]"], 
      SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       RowBox[{"g", 
        SubscriptBox["", "\[Lambda]"], 
        SubscriptBox["", "\[Mu]"]}], 
       RowBox[{",", "\[Nu]"}]], "+", 
      SubscriptBox[
       RowBox[{"g", 
        SubscriptBox["", "\[Lambda]"], 
        SubscriptBox["", "\[Nu]"]}], 
       RowBox[{",", "\[Mu]"}]], "-", 
      SubscriptBox[
       RowBox[{"g", 
        SubscriptBox["", "\[Mu]"], 
        SubscriptBox["", "\[Nu]"]}], 
       RowBox[{",", "\[Lambda]"}]]}], ")"}]}]}],
  HoldForm]], "Output",
 CellChangeTimes->{3.9776992844498653`*^9},
 CellLabel->"Out[75]=",ExpressionUUID->"733ae60e-05b5-47c2-9f88-4237e92a5b2b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Conclusion", "Section",
 CellChangeTimes->{{3.977327626538269*^9, 
  3.977327628335918*^9}},ExpressionUUID->"cd7ccaae-8a48-4951-8813-\
25a2f004c76f"],

Cell[TextData[{
 "We began this notebook with a non-tensorial partial derivative of a \
contravariant tensor. However, by adding a correction and ",
 StyleBox["then",
  FontSlant->"Italic"],
 " demanding linearity and tensoriality, we forced a covariant derivative to \
emerge, with the correction proportional to the non-tensorial connection ",
 Cell[BoxData[
  FormBox["\[CapitalGamma]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e7bee12a-fe6b-41d9-832b-4f0655ba195a"],
 "."
}], "Text",
 CellChangeTimes->{{3.977328046772869*^9, 3.9773280628431273`*^9}, {
  3.977342981967009*^9, 3.9773430912152443`*^9}, {3.977663028232991*^9, 
  3.977663092280879*^9}, {3.9776631289607077`*^9, 3.97766317612328*^9}, {
  3.97766324443049*^9, 
  3.977663253310048*^9}},ExpressionUUID->"c00739a0-29e7-4328-8514-\
912f49061aa3"],

Cell[TextData[{
 "Also, not just accepting textbook derivations of the Christoffel symbols \
for gravitation, we derive them ",
 StyleBox["ab-initio",
  FontSlant->"Italic"],
 " in \[ScriptCapitalU]\[ScriptCapitalD]. By insisting that lengths be \
preserved (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Del]", "g"}], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "10316afd-2b5b-4b06-9bfd-2f068367e1e5"],
 ") and twisting be forbidden ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Mu]", " ", "\[Nu]"}]], "=", 
     SubscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Nu]", " ", "\[Mu]"}]]}], ")"}], TraditionalForm]],
  ExpressionUUID->"a32e654e-fb81-49c4-a45d-24f75b7c143c"],
 ", \[ScriptCapitalU]\[ScriptCapitalD] collapses the Koszul sum into the \
standard formula: "
}], "Text",
 CellChangeTimes->{{3.977328046772869*^9, 3.977328210801209*^9}, {
  3.977343100774181*^9, 3.977343151365741*^9}, {3.977663195171287*^9, 
  3.977663232715906*^9}, {3.9776632635040092`*^9, 
  3.977663315367116*^9}},ExpressionUUID->"eb16f1b4-e1af-4b81-adfc-\
344b15856a90"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{" ", "\[Sigma]"}]], 
    RowBox[{"\[Mu]", " ", "\[Nu]"}]], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     SuperscriptBox["g", 
      RowBox[{" ", 
       RowBox[{"\[Sigma]", " ", "\[Lambda]"}]}]], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["g", 
       RowBox[{" ", 
        RowBox[{
         RowBox[{"\[Lambda]", " ", "\[Mu]"}], ",", " ", "\[Nu]"}]}]], "+", 
      SubscriptBox["g", 
       RowBox[{" ", 
        RowBox[{
         RowBox[{"\[Lambda]", " ", "\[Nu]"}], ",", " ", "\[Mu]"}]}]], "-", 
      SubscriptBox["g", 
       RowBox[{" ", 
        RowBox[{
         RowBox[{"\[Mu]", " ", "\[Nu]"}], ",", " ", "\[Lambda]"}]}]]}], 
     ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.9773281838333473`*^9, 
  3.9773281960566483`*^9}},ExpressionUUID->"21e826cf-797d-4630-b140-\
750929317dba"],

Cell["\<\
The form of the Christoffel symbols shows that gravitation, manifested in the \
connection, is solely determined by the metric and its ordinary partial \
derivatives. \
\>", "Text",
 CellChangeTimes->{{3.977328046772869*^9, 3.97732815255791*^9}, {
  3.977328217593349*^9, 3.9773283262560883`*^9}, {3.977331904529643*^9, 
  3.9773319380057592`*^9}, {3.977342897568602*^9, 3.9773429356828938`*^9}, {
  3.977343165287672*^9, 3.977343180758193*^9}, {3.977663331140513*^9, 
  3.977663375674224*^9}},ExpressionUUID->"759ba772-a97b-46b1-b548-\
3f915124bd99"],

Cell["\<\
With a working covariant derivative in \[ScriptCapitalU]\[ScriptCapitalD]\
\[CloseCurlyQuote]s Relativity Toolkit, we are equipped for future \
installments on geodesics, geodesic deviation, tidal forces, accelerated \
observers, Schwarzschild and Kerr metrics, black holes, etc. \
\>", "Text",
 CellChangeTimes->{{3.977328046772869*^9, 3.97732815255791*^9}, {
  3.977328217593349*^9, 3.9773283262560883`*^9}, {3.977331904529643*^9, 
  3.9773319380057592`*^9}, {3.977342897568602*^9, 3.977342963915614*^9}, {
  3.977663385020445*^9, 
  3.977663405699388*^9}},ExpressionUUID->"2b46e7ed-067e-4f36-bab3-\
c9616286175c"]
}, Open  ]],

