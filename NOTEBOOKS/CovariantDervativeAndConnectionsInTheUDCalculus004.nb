  3.977699284267808*^9},ExpressionUUID->"ca26e36f-ba24-4cc4-aa3d-\
38d5a0d54229"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   TagBox["\<\"2. Mechanically Expanded Derivative:\"\>",
    "EchoLabel"], "  ", 
   RowBox[{"(", 
    RowBox[{"A", 
     SuperscriptBox["", "\[Mu]23"]}], ")"}], " ", 
   FractionBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["\[PartialD]", "2"], "x"}], 
     SuperscriptBox["", "ap"]}], 
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "\[Mu]23"], 
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "bp"]}]]}], "+", 
  RowBox[{
   RowBox[{"(", 
    SubscriptBox[
     RowBox[{"A", 
      SuperscriptBox["", "\[Mu]23"]}], 
     RowBox[{",", "bp"}]], ")"}], " ", 
   FractionBox[
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "ap"]}], 
    RowBox[{
     RowBox[{"\[PartialD]", "x"}], 
     SuperscriptBox["", "\[Mu]23"]}]]}]}]], "Echo",
 CellChangeTimes->{
  3.977699284278386*^9},ExpressionUUID->"f4a86e86-dcc0-4e86-ae2d-\
74716367f952"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   TagBox["\<\"3. Peek at unique dummy indices\"\>",
    "EchoLabel"], "  ", 
   RowBox[{"(", 
    RowBox[{"A", 
     SuperscriptBox["", "\[Mu]23"]}], ")"}], " ", 
   FractionBox[
    RowBox[{
     RowBox[{
