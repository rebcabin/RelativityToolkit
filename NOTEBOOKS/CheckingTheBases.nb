             RowBox[{
              RowBox[{"GrayLevel", "[", "0.15", "]"}], ",", 
              RowBox[{"GrayLevel", "[", "0.12", "]"}]}], "}"}]}], "}"}]}], 
         "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"ItemStyle", "->", 
