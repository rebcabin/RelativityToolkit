Cell[CellGroupData[{

Cell["Center Inclusion", "Section",
 CellChangeTimes->{{3.9837106898897533`*^9, 3.98371069214095*^9}, {
  3.983738611300417*^9, 
  3.983738612958049*^9}},ExpressionUUID->"3a7192ec-325a-4fb8-b0c0-\
ec48d27f7f2f"],

Cell[CellGroupData[{

Cell[TextData[{
 "Proof that ",
 Cell[BoxData[
  FormBox["I", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "83cc44ed-f804-42ac-8520-3ac863db8e4c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"-", "I"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "072af0eb-17c5-452d-8179-e89304a93bfd"],
 " commute with generators of both groups."
}], "Subsection",
 CellChangeTimes->{{3.98371220701119*^9, 3.983712241874518*^9}, {
  3.983713639044339*^9, 3.983713644521614*^9}, {3.983781126417631*^9, 
  3.983781133220847*^9}},ExpressionUUID->"6be5c9b8-db8c-4cc9-95a6-\
bdf413d4a3ce"],

Cell[TextData[{
 "The ",
 StyleBox["center",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of a group is the set of all elements that commute with all other \
elements. The following shows that ",
 Cell[BoxData[
  FormBox["I", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2fcc8ea1-7f05-4ef2-ab68-50ad6bf4baa1"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "I"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "425ae5d6-30e7-4c72-86fb-ff84a1e2cfa2"],
 " commute with the generators of both ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "50927ffe-f859-4901-976b-2d39671ebd55"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "50c1ca82-604d-4455-9823-d852eea0fac8"],
 ", so that both ",
 Cell[BoxData[
  FormBox["I", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "89106324-54ad-4646-b63d-77f581bfee4b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "I"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f625158b-198c-4c04-80bb-e77cc91fe517"],
 " are potentially in the centers of both groups. Below, we show that both ",
 Cell[BoxData[
  FormBox["I", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8aa4361a-dbc2-4ba1-8f00-6a59352cccb3"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "I"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0248a989-a58f-4688-ab52-ec93ef234382"],
 " are exactly the center of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5c937290-25af-4f79-95b0-8750e532f7da"],
 ", and that ",
 Cell[BoxData[
  FormBox["I", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "54f91a5f-d2e4-44b9-863e-08327f65cd08"],
 " is exactly the center of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "54680f46-c77d-4dcf-a425-c847789f311d"],
 ". The fact that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "I"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "29b5a7f2-a7db-4399-a063-f2e41352da5b"],
 " commutes with the generators ",
 Cell[BoxData[
  FormBox["J", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1913642d-83c0-4b3e-bb20-657b598d025f"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b14e83f4-1dca-4b27-a03b-da7c82bb9d5b"],
 " is irrelevant because ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "I"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fba07642-660c-4541-8fd9-ba3c789f4866"],
 " is not a group element of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1c8dad87-4f60-40a4-b4dd-b5ab935bc2e8"],
 ". "
}], "Text",
 CellChangeTimes->{{3.9837106996585417`*^9, 3.983710701601058*^9}, {
  3.9837112989780893`*^9, 3.983711432103046*^9}, {3.9837136567908907`*^9, 
  3.9837137939842033`*^9}},ExpressionUUID->"feb9464a-a14b-4087-8bc7-\
c3125503afda"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"commM", ",", "centerCommutesWithGenerators"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    StyleBox["commM",
     FontColor->RGBColor[0.14, 0.8, 0.14]], "[", 
    RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"A", ".", "B"}], "-", 
    RowBox[{"B", ".", "A"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"centerCommutesWithGenerators", "[", 
    RowBox[{"g_", ",", "dim_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"proof", "@", 
    RowBox[{"(", 
     RowBox[{"And", "@@", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"SU2Center", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", "dim", "]"}], ",", 
             RowBox[{"-", 
              RowBox[{"IdentityMatrix", "[", "dim", "]"}]}]}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"zeroMatrix2", "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"dim", ",", "dim"}], "}"}]}], "]"}]}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"commM", "[", 
              RowBox[{"#", ",", 
               RowBox[{"g", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], "]"}], "&"}], "/@", 
            "SU2Center"}], "==", 
           RowBox[{"{", 
            RowBox[{"zeroMatrix2", ",", "zeroMatrix2"}], "}"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"centerCommutesWithGenerators", "[", 
   RowBox[{"T", ",", "2"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"centerCommutesWithGenerators", "[", 
   RowBox[{"J", ",", "3"}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.983710745632462*^9, 3.98371078064881*^9}, {
  3.983710889953363*^9, 3.983711270543285*^9}, {3.983711354477364*^9, 
  3.983711360802436*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"c59177cb-5975-4c1c-b014-35b1c7f062cd"],

