  RowBox[{"ClearAll", "[", 
   RowBox[{
   "X", ",", "Y", ",", "x1", ",", "x2", ",", "x3", ",", "y1", ",", "y2", ",", 
    "y3", ",", "TJisomorphism"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"X", "[", "M_", "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}], "*", "M"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Y", "[", "M_", "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y1", ",", "y2", ",", "y3"}], "}"}], "*", "M"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"TJisomorphism", "[", 
    RowBox[{"TO_", ",", "X_", ",", "Y_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"TO", "[", 
      RowBox[{
       StyleBox["commM",
        FontColor->RGBColor[0.14, 0.8, 0.14]], "[", 
       RowBox[{"X", ",", "Y"}], "]"}], "]"}], "==", 
     RowBox[{
      StyleBox["commM",
       FontColor->RGBColor[0.14, 0.8, 0.14]], "[", 
      RowBox[{
       RowBox[{"TO", "[", "X", "]"}], ",", 
       RowBox[{"TO", "[", "Y", "]"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"proof", "@", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TJisomorphism", "[", 
      RowBox[{
       StyleBox["JtoT",
        FontColor->RGBColor[0.14, 0.8, 0.14]], ",", 
       RowBox[{
        StyleBox["X",
         FontColor->RGBColor[0.14, 0.8, 0.14]], "[", 
        StyleBox["J",
         FontColor->RGBColor[0.14, 0.8, 0.14]], "]"}], ",", 
       RowBox[{
        StyleBox["Y",
         FontColor->RGBColor[0.14, 0.8, 0.14]], "[", 
        StyleBox["J",
         FontColor->RGBColor[0.14, 0.8, 0.14]], "]"}]}], "]"}], "&&", 
     "\[IndentingNewLine]", 
     RowBox[{"TJisomorphism", "[", 
      RowBox[{
       StyleBox["TtoJ",
        FontColor->RGBColor[0.14, 0.8, 0.14]], ",", 
       RowBox[{
        StyleBox["X",
         FontColor->RGBColor[0.14, 0.8, 0.14]], "[", 
        StyleBox["T",
         FontColor->RGBColor[0.14, 0.8, 0.14]], "]"}], ",", 
       RowBox[{
        StyleBox["Y",
         FontColor->RGBColor[0.14, 0.8, 0.14]], "[", 
        StyleBox["T",
         FontColor->RGBColor[0.14, 0.8, 0.14]], "]"}]}], "]"}]}], ")"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.982881074743064*^9, 3.9828810933880577`*^9}, {
  3.982881129425324*^9, 3.982881239034292*^9}, {3.98288127239357*^9, 
