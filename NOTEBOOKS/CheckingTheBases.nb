     RowBox[{
      RowBox[{
       SubscriptBox["T", "i"], "\[ConjugateTranspose]"}], 
      SubscriptBox["T", "j"]}], ")"}], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     SubscriptBox["\[Delta]", 
      RowBox[{"i", "\[VeryThinSpace]", "j"}]]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.982869854167696*^9, 3.982869962582293*^9}, {
