Cell[CellGroupData[{

Cell["Notational Warnings", "Subsection",
 CellChangeTimes->{{3.9838360706473427`*^9, 
  3.983836075064446*^9}},ExpressionUUID->"a54b9580-ae93-49f8-b896-\
a8cd5d200d4c"],

Cell[TextData[{
 "Examine notation meticulously, carefully distinguishing mathematical \
notation from Wolfram expressions. For example, ",
 StyleBox["Tr[A,B]", "Input"],
 ", in Wolfram, is not the trace of the Lie bracket ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"A", ",", "B"}], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3505db1b-a193-4799-831a-a65b090db7a5"],
 ", it\[CloseCurlyQuote]s the \[OpenCurlyDoubleQuote]generalized trace,\
\[CloseCurlyDoubleQuote] a complication we don\[CloseCurlyQuote]t need! \
Instead, ",
 StyleBox["Tr[commM[A,B]]", "Input"],
 " is trace of the Lie bracket."
}], "Item",
 CellChangeTimes->{{3.9838122843767643`*^9, 3.983812340573305*^9}, {
  3.983812448117078*^9, 3.983812573623406*^9}, {3.983812915073126*^9, 
  3.98381302785174*^9}, {3.9838130617642612`*^9, 3.983813099701902*^9}, {
  3.983814780938335*^9, 3.983814918254244*^9}, {3.983834190846383*^9, 
  3.9838342246124763`*^9}, {3.983861463364788*^9, 3.9838614643196898`*^9}, {
  3.983864937288537*^9, 
  3.9838649543436337`*^9}},ExpressionUUID->"5e759254-6e88-40e7-9b95-\
e5a1a7db609c"],

Cell[CellGroupData[{

Cell[TextData[{
 "In a space of complex or real matrices, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Tr", "(", 
    RowBox[{
     RowBox[{"A", "\[ConjugateTranspose]"}], "\[VeryThinSpace]", "B"}], ")"}],
    TraditionalForm]],ExpressionUUID->
  "f4243daf-a202-483c-adce-350a3eb0196f"],
 " is the inner product, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", "\[ConjugateTranspose]"}], "\[VeryThinSpace]", "B"}], 
   TraditionalForm]],ExpressionUUID->"114f5f2e-4b1a-4a4e-a5cf-002421b0f711"],
 " is the ordinary matrix product of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "\[ConjugateTranspose]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c42cf82e-859f-487f-8d9f-ab61d26f0053"],
 " with ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5b020ee1-a781-4fd6-81cf-9d97175676ab"],
 ". In Wolfram, the ordinary matrix product is denoted by a low dot: (",
 StyleBox["A\[ConjugateTranspose].B", "Input"],
 ")."
}], "Item",
 CellChangeTimes->{{3.9838122843767643`*^9, 3.983812340573305*^9}, {
  3.983812448117078*^9, 3.983812573623406*^9}, {3.983812915073126*^9, 
  3.98381302785174*^9}, {3.9838130617642612`*^9, 3.983813099701902*^9}, {
  3.983814780938335*^9, 3.9838148993379507`*^9}, {3.983814995758827*^9, 
  3.983815012059821*^9}, {3.9838339852233267`*^9, 3.983833988554474*^9}, {
  3.9838344263467817`*^9, 3.983834479397238*^9}, {3.983836185204917*^9, 
  3.983836186296152*^9}, {3.9838365364719257`*^9, 3.983836557934637*^9}, {
  3.9838614831472273`*^9, 
  3.9838615582878323`*^9}},ExpressionUUID->"6b4aa589-d3da-48e4-b1e7-\
961129b09efb"],

Cell[TextData[{
 "With real matrices, the conjugate transpose ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "\[ConjugateTranspose]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b44dfef1-4b23-41ad-9c7a-888e5a291b12"],
 " is just transpose ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "\[Transpose]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "55f57745-f93a-4951-808a-8c0d29a58103"],
 ", so the dagger notation suffices for both real and complex matrices."
}], "Subitem",
 CellChangeTimes->{{3.983836198422244*^9, 3.983836226462256*^9}, {
  3.983836574876093*^9, 
  3.983836589426878*^9}},ExpressionUUID->"9b8759c2-5e63-428a-bc73-\
a4128ff7a2a8"]
}, Open  ]],

Cell[TextData[{
 "Wolfram function-call is denoted with with square brackets, ",
 StyleBox["f[A,B]", "Input"],
 ", easy to confuse with Lie brackets ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"A", ",", "B"}], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b863863d-4c91-4804-9bc0-ccc6e366a3e2"],
 " in non-Wolfram, mathematical notation. In Wolfram, we denote Lie bracket \
in a matrix representation via a call of the function ",
 StyleBox["commM", "Input"],
 ", as in ",
 StyleBox["commM[A,B]", "Input"],
 ", which is defined as (",
 StyleBox["A.B-B.A)", "Input"],
 ". "
}], "Item",
 CellChangeTimes->{{3.9838122843767643`*^9, 3.983812340573305*^9}, {
  3.983812448117078*^9, 3.983812573623406*^9}, {3.983812915073126*^9, 
  3.98381302785174*^9}, {3.9838130617642612`*^9, 3.983813099701902*^9}, {
  3.983814780938335*^9, 3.9838148993379507`*^9}, {3.983814995758827*^9, 
  3.983815012059821*^9}, {3.9838339852233267`*^9, 3.983834083389956*^9}, {
  3.983834118628767*^9, 3.983834176009309*^9}, {3.983836250212328*^9, 
  3.983836306174572*^9}, {3.983836605588928*^9, 
  3.98383663096889*^9}},ExpressionUUID->"0a613736-f85a-4279-8022-\
b7fa518db748"]
}, Open  ]],

