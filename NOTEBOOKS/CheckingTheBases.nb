   ColumnForm[{$CellContext`a $CellContext`e + $CellContext`b $CellContext`f + \
$CellContext`c $CellContext`g + $CellContext`d $CellContext`h == 
     0, $CellContext`b $CellContext`e - $CellContext`a $CellContext`f + \
$CellContext`d $CellContext`g - $CellContext`c $CellContext`h == 
     0, $CellContext`a $CellContext`e + $CellContext`b $CellContext`f + \
$CellContext`c $CellContext`g + $CellContext`d $CellContext`h == 
     0, -$CellContext`b $CellContext`e + $CellContext`a $CellContext`f - \
$CellContext`d $CellContext`g + $CellContext`c $CellContext`h == 
     0, -1 - $CellContext`c $CellContext`e + $CellContext`d $CellContext`f + \
$CellContext`a $CellContext`g - $CellContext`b $CellContext`h == 
     0, -$CellContext`d $CellContext`e - $CellContext`c $CellContext`f + \
$CellContext`b $CellContext`g + $CellContext`a $CellContext`h == 0}],
   Editable->False]}]], "Echo",
 CellChangeTimes->{
