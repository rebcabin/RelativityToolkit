Cell["Final Coordinate-Extraction Functions", "Subsection",
 CellChangeTimes->{{3.983818790209302*^9, 
  3.983818800535254*^9}},ExpressionUUID->"0dfa10cb-0ba5-4f6d-8b7e-\
de0a86d897ad"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"getJCoeffs", ",", "getTCoeffs"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    StyleBox["getJCoeffs",
     FontColor->RGBColor[0.14, 0.8, 0.14]], "[", "Jx_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"Jx", "\[Transpose]"}], ".", 
        RowBox[{"J", "[", 
         RowBox[{"[", "k", "]"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    StyleBox["getTCoeffs",
     FontColor->RGBColor[0.14, 0.8, 0.14]], "[", "Tx_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"Tx", "\[ConjugateTranspose]"}], ".", 
         RowBox[{"T", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], "]"}]}], "//", "ComplexExpand"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.982869854167696*^9, 3.982869869137241*^9}, {
  3.982870137639125*^9, 3.9828701825459757`*^9}, {3.982880356537764*^9, 
  3.982880362921871*^9}, {3.982880884844185*^9, 3.9828809004275913`*^9}, {
  3.9830036639242163`*^9, 3.983003719250605*^9}, {3.9838658248722773`*^9, 
  3.9838658681490726`*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"0da453f9-9691-43f2-a68f-d5fc410a9007"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Derivation via the Killing Form", "Subsection",
 CellChangeTimes->{{3.983818807309413*^9, 
  3.9838188141789722`*^9}},ExpressionUUID->"8a48ca64-2c85-4924-ad78-\
5aeaf5fd98ca"],

Cell[TextData[{
 "Every element ",
 Cell[BoxData[
  FormBox[
   RowBox[{"X", "\[Element]", "\[GothicG]"}], TraditionalForm]],
  ExpressionUUID->"1f670d03-194d-46f0-ab15-697b30364ee1"],
 " defines a linear map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["ad", "X"], "(", "Z", ")"}], "=", " ", 
    RowBox[{"[", 
     RowBox[{"X", ",", "Z"}], "]"}]}], TraditionalForm]],ExpressionUUID->
  "308255ec-4887-4b66-82dc-37079d4bb782"],
 " out of \[GothicG]\[CloseCurlyQuote]s definitional Lie bracket. Intrinsic \
geometry of a Lie algebra \[GothicG] comes from its ",
 StyleBox["Killing form",
  FontWeight->"Bold"],
 ", the trace of such maps over two elements ",
 Cell[BoxData[
  FormBox[
   RowBox[{"X", ",", "Y"}], TraditionalForm]],ExpressionUUID->
  "e70053f7-31dc-48cf-803a-8af585af446d"],
 " of \[GothicG]:"
}], "Text",
 CellChangeTimes->{{3.982923720576329*^9, 3.982923852768676*^9}, {
  3.983003557988961*^9, 3.9830035829192657`*^9}, {3.983007056653413*^9, 
  3.9830070662065077`*^9}, {3.98300710055445*^9, 3.98300710067988*^9}, {
  3.983784466946042*^9, 3.9837844930091057`*^9}, {3.98378817361617*^9, 
  3.983788202275711*^9}, {3.9838366621133947`*^9, 
  3.983836678528027*^9}},ExpressionUUID->"c91a6a5c-99b2-4f37-bfed-\
a05d72647a1e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"B", "(", 
    RowBox[{"X", ",", "Y"}], ")"}], "=", 
   RowBox[{"Tr", "(", 
    RowBox[{
     SubscriptBox["ad", "X"], "\[SmallCircle]", 
     SubscriptBox["ad", "Y"]}], ")"}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.982923859043405*^9, 3.982923970519051*^9}, {
   3.983788233309123*^9, 3.9837882524489737`*^9}, {3.983817616407878*^9, 
   3.98381763487789*^9}, {3.983817719458797*^9, 3.983817740595777*^9}, {
   3.983818012162023*^9, 3.983818179899548*^9}, {3.983818357323267*^9, 
   3.983818358286593*^9}, 
   3.983818654452652*^9},ExpressionUUID->"9cef41db-2314-4caf-9d43-\
6b6be0d440cf"],

Cell["The result is a real number. ", "Text",
 CellChangeTimes->{{3.983836372543268*^9, 3.983836405436857*^9}, {
  3.9838367051764917`*^9, 3.983836708738183*^9}, {3.983861646985094*^9, 
  3.983861657417102*^9}},ExpressionUUID->"8f71fcf0-4ee6-42ed-b44a-\
30cadfdce23f"],

Cell[TextData[{
 "While standard, ",
 StyleBox["this is a difficult notation",
  FontSlant->"Italic"],
 ". ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ad", "X"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "71cea708-f06c-4851-9bc4-4ee2a11caffa"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ad", "Y"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6b446820-3a63-43d8-90ba-9d4e62cd7767"],
 " are not operators here, but matrices constructed from expansions of ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "76e62606-4a8f-421e-8387-9a5f9fdab493"],
 " and ",
 Cell[BoxData[
  FormBox["Y", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "929d8e21-5c81-42d1-b9ea-b9326be96b89"],
 " bracketed on a basis of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7827f23c-d062-4b71-afd8-3cfebdfb7a57"],
 ". The following formalizations should clarify."
}], "Subitem",
 CellChangeTimes->{{3.983836372543268*^9, 3.983836405436857*^9}, {
  3.9838367051764917`*^9, 3.983836708738183*^9}, {3.983861646985094*^9, 
  3.983861649851417*^9}, {3.983861784833727*^9, 3.983861885949471*^9}, {
  3.983862593605002*^9, 
  3.983862620502124*^9}},ExpressionUUID->"9681f78c-cb8d-41c0-93b2-\
c657da06c0cd"],

Cell[TextData[{
 "For ",
 StyleBox["simple",
  FontSlant->"Italic"],
 " Lie Algebras, like \[GothicS]\[GothicO](3) and \[GothicS]\[GothicU](2), \
Schur\[CloseCurlyQuote]s Lemma implies that any invariant, symmetric, \
bilinear form is proportional to the Killing form, so the basis trace \
formulas above are proportional to the Killing forms. See Georgi, Humphreys, \
and Fuchs in the References."
}], "Text",
 CellChangeTimes->{{3.982924081465349*^9, 3.982924178250703*^9}, {
   3.983007081626343*^9, 3.983007094745018*^9}, {3.9837884117844267`*^9, 
   3.9837884191640244`*^9}, {3.983836728638802*^9, 3.983836741091357*^9}, 
   3.983836876014032*^9, {3.983861673786829*^9, 3.983861678072013*^9}, {
   3.9838634025631123`*^9, 
   3.983863419776532*^9}},ExpressionUUID->"e8edac9e-e8d4-4d7a-ad37-\
62e017d04cc7"],

Cell[CellGroupData[{

Cell[TextData[{
 "A ",
 StyleBox["simple Lie algebra",
  FontWeight->"Bold"],
 " is a non-Abelian algebra with no non-trivial ",
 StyleBox["ideals",
  FontWeight->"Bold"],
 ", that is, no sub-algebras that \[OpenCurlyDoubleQuote]trap\
\[CloseCurlyDoubleQuote] the Lie bracket. "
}], "Subitem",
 CellChangeTimes->{{3.983836825464397*^9, 
  3.9838369048411627`*^9}},ExpressionUUID->"448f8168-a628-4dea-9267-\
6bdad6e5d6c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"X", ",", "Y", ",", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"arbitrary", " ", "elements", " ", "of", " ", "\[GothicG]"}],
          ",", " ", 
         RowBox[{"X", " ", "and", " ", 
          RowBox[{"Y", ":"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"xVec", "=", 
        RowBox[{"{", 
         RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], ",", 
       RowBox[{"(*", " ", 
        RowBox[{
        "coefficients", " ", "of", " ", "expansion", " ", "in", " ", "basis", 
         " ", "T"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"yVec", "=", 
        RowBox[{"{", 
         RowBox[{"y1", ",", "y2", ",", "y3"}], "}"}]}], ",", 
       "\[IndentingNewLine]", "adX", ",", "adY", ",", 
       RowBox[{"(*", " ", 
        RowBox[{"'", 
         RowBox[{"ad", "'"}], " ", "matrices", " ", 
         RowBox[{"(", 
          RowBox[{"ad", "-", "mats"}], ")"}], " ", "in", " ", 
         "\[GothicS]\[GothicU]", 
         RowBox[{"(", "2", ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       "killingB", ",", "traceForm"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"expansions", " ", "in", " ", "basis", " ", "T"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"X", "=", 
       RowBox[{"xVec", ".", "T"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Y", "=", 
       RowBox[{"yVec", ".", "T"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"ad", "-", 
         RowBox[{"mats", " ", 
          SubscriptBox["ad", "X"]}]}], ",", " ", 
        RowBox[{
         SubscriptBox["ad", "Y"], " ", "in", " ", "basis", " ", "T", " ", 
         "via", " ", "Lie", " ", "bracket", " ", "commM"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         SubscriptBox[
          RowBox[{"(", 
           SubscriptBox["ad", "X"], ")"}], 
          RowBox[{"i", "\[VeryThinSpace]", "j"}]], " ", "is", " ", "the", " ",
          "component", " ", 
         RowBox[{"of", " ", "[", 
          RowBox[{"X", ",", 
           SubscriptBox["T", "j"]}], "]"}], " ", "along", " ", 
         SubscriptBox["T", "i"], " ", "*"}], ",", " ", 
        RowBox[{"ditto", " ", "Y"}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Final", " ", "Traspose", " ", "swaps", " ", "Wolfram", " ", "rows", " ",
         "for", " ", "our", " ", "needed", " ", 
        RowBox[{"columns", "."}]}], " ", "*)"}], "  ", "\[IndentingNewLine]", 
      
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"adX", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"getTCoeffs", "[", 
                RowBox[{"commM", "[", 
                 RowBox[{"X", ",", 
                  RowBox[{"T", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "3"}], "}"}]}], "]"}], "\[Transpose]"}], "//",
             "FullSimplify"}]}], ")"}], "//", "\[IndentingNewLine]", 
         "MatrixForm"}], 
        ",", "\"\<\!\(\*SubscriptBox[\(ad\), \(X\)]\) = \
\[LeftAngleBracket][X,\!\(\*SubscriptBox[\(T\), \(j\)]\)],\!\(\*SubscriptBox[\
\(T\), \(i\)]\)\[RightAngleBracket] :\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"adY", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"getTCoeffs", "[", 
                RowBox[{"commM", "[", 
                 RowBox[{"Y", ",", 
                  RowBox[{"T", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "3"}], "}"}]}], "]"}], "\[Transpose]"}], "//",
             "FullSimplify"}]}], ")"}], "//", "\[IndentingNewLine]", 
         "MatrixForm"}], 
        ",", "\"\<\!\(\*SubscriptBox[\(ad\), \(Y\)]\) = \
\[LeftAngleBracket][Y,\!\(\*SubscriptBox[\(T\), \(j\)]\)],\!\(\*SubscriptBox[\
\(T\), \(i\)]\)\[RightAngleBracket] :\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Killing", " ", "form", " ", "B", 
         RowBox[{"(", 
          RowBox[{"X", ",", "Y"}], ")"}]}], "=", 
        RowBox[{"Tr", "[", 
         RowBox[{
          SubscriptBox["ad", "X"], ".", 
          SubscriptBox["ad", "Y"]}], "]"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"killingB", "=", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{"adX", ".", "adY"}], "]"}], "//", "Expand"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Compute", " ", "the", " ", "Trace", " ", 
        RowBox[{"Form", ":", " ", 
         RowBox[{"k", " ", 
          RowBox[{"Tr", "[", 
           RowBox[{"X", ".", "Y"}], "]"}]}]}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "   ", 
       RowBox[{
        RowBox[{"for", " ", "\[GothicS]\[GothicU]", 
         RowBox[{"(", "2", ")"}], " ", "in", " ", "basis", " ", "T"}], ",", 
        " ", 
        RowBox[{"k", " ", "=", " ", "4"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"traceForm", "=", 
       RowBox[{
        RowBox[{"4", 
         RowBox[{"Tr", "[", 
          RowBox[{"X", ".", "Y"}], "]"}]}], "//", "Expand"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{"killingB", ",", "\"\<Killing form B(X,Y): \>\""}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{"traceForm", ",", "\"\<Trace form 4 Tr(X.Y): \>\""}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "They", " ", "are", " ", "identical", " ", "for", " ", "all", " ", "X",
         " ", "and", " ", "Y"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"proof", "[", 
       RowBox[{"killingB", "===", "traceForm"}], "]"}]}]}], "]"}], ";"}], 
  "\n"}]], "Input",
