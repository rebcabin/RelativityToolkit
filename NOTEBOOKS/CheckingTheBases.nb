Cell[CellGroupData[{

Cell["Explicit Mappings", "Section",
 CellChangeTimes->{{3.9829477778504972`*^9, 3.9829477831456127`*^9}, {
  3.983007690114258*^9, 
  3.983007691656294*^9}},ExpressionUUID->"926ad6be-8931-4b72-9692-\
ce40d64cb688"],

Cell[TextData[{
 "The following diagram addresses the question \[OpenCurlyDoubleQuote]",
 StyleBox["How do I know that exponentiating my generators in \[GothicG] will \
correctly produce physical transformations from my group G on my vectors in V",
  FontSlant->"Italic"],
 "?\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{3.983871940715747*^9, 3.9838719938402643`*^9}, {
  3.983872495077257*^9, 
  3.983872539055929*^9}},ExpressionUUID->"0111f0e0-07f8-4a3b-b47c-\
d3c1e2e3499b"],

Cell[TextData[{
 StyleBox["G",
  FontSlant->"Italic"],
 " is the abstract Lie group (the manifold of symmetries) and \[GothicG] is \
its Lie algebra (tangent space of generators at the identity of ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a6fa39a4-9148-4d1a-827f-52ce1d27277b"],
 ")."
}], "Item",
 CellChangeTimes->{{3.9838720273400097`*^9, 3.9838720337925*^9}, {
   3.983872076392106*^9, 3.9838721460986567`*^9}, {3.983872552226428*^9, 
   3.983872563792678*^9}, {3.983872607866314*^9, 3.9838726295401993`*^9}, 
   3.983872859443668*^9},ExpressionUUID->"24da92b6-8aa2-48b5-abb1-\
a9831b202b2a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"G", "\[VeryThinSpace]", 
    RowBox[{"L", "(", "V", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4e0d5fb7-e52d-4c14-a842-8c871a907679"],
 " (General Linear Group) is the space of all invertible matrices that act on \
a physical vector space ",
 StyleBox["V",
  FontSlant->"Italic"],
 " (e.g., ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "=", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "3"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "20543d87-e93c-4cf0-b9ec-831424f5e12c"],
 " for vectors or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "=", 
    SuperscriptBox["\[DoubleStruckCapitalC]", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d2fc8a04-8d86-47da-ba06-9c79b2140068"],
 " for spinors)."
}], "Item",
 CellChangeTimes->{{3.9838720273400097`*^9, 3.983872035751937*^9}, {
   3.9838721500154877`*^9, 3.98387228397659*^9}, 3.983872366781328*^9, 
   3.983872610687346*^9, 
   3.983872861825049*^9},ExpressionUUID->"45c2ae2a-4344-4d3f-8558-\
6792d4e51de7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicG]\[GothicL]", "(", "V", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3a5b1b7f-1329-4134-bf44-62367308d778"],
 " (General Linear Algebra) is the space of all matrices acting on ",
 StyleBox["V, ",
  FontSlant->"Italic"],
 "the \[OpenCurlyDoubleQuote]matrix home\[CloseCurlyDoubleQuote] for \
generators."
}], "Item",
 CellChangeTimes->{{3.9838720273400097`*^9, 3.983872037257826*^9}, {
   3.9838723426689787`*^9, 3.983872416641872*^9}, 3.9838726139227953`*^9, 
   3.983872863612206*^9},ExpressionUUID->"d88871ee-8c3f-4ec6-b9dc-\
8c42926e32c3"],

Cell[TextData[{
 "\[CapitalPi] (Group Representation) is the map that converts an abstract \
symmetry ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "\[Element]", "G"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "006dfd87-0737-441f-aeb8-edb4a1633d3a"],
 " into a concrete matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "\[Element]", 
    RowBox[{"G", "\[VeryThinSpace]", 
     RowBox[{"L", "(", "V", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3daa9c10-da41-431b-88c4-813f6b8878ee"],
 "."
}], "Item",
 CellChangeTimes->{{3.9838720273400097`*^9, 3.983872039360907*^9}, {
   3.983872428500893*^9, 3.9838724835528393`*^9}, {3.9838725836332912`*^9, 
   3.983872605840301*^9}, {3.9838727425481586`*^9, 3.983872753162404*^9}, 
   3.9838728661037827`*^9},ExpressionUUID->"93a86ab9-380a-4db8-b9ae-\
351e97398cc3"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", "\[TildeTilde]", 
    RowBox[{"d", "\[VeryThinSpace]", "\[CapitalPi]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2424548d-9a06-4b4d-b636-40c2845c985d"],
 " (Algebra Representation) is the map that converts an abstract generator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"X", "\[Element]", "\[GothicG]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "352cf176-e740-4fc0-bede-9503a2e9d40f"],
 " into a matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Pi]", "(", "X", ")"}], "\[Element]", 
    RowBox[{"\[GothicG]\[GothicL]", "(", "V", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "34efc447-68b5-41b1-87e2-f1447028b2b6"],
 ". In physics, we call ",
 Cell[BoxData[
  FormBox["\[Pi]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5a43a9e7-47ae-4bf2-b53c-1e7eaf22fd67"],
 " the \[OpenCurlyDoubleQuote]differential\[CloseCurlyDoubleQuote] or \
infinitesimal\[CloseCurlyDoubleQuote] version of \[CapitalPi]."
}], "Item",
 CellChangeTimes->{{3.9838720273400097`*^9, 3.983872041516295*^9}, 
   3.983872072237216*^9, {3.983872663374159*^9, 
   3.9838728477238607`*^9}},ExpressionUUID->"c288dbba-4814-40fe-bf63-\
d5cb48972080"],

