Cell[CellGroupData[{

Cell["Topological Tearing", "Subsection",
 CellChangeTimes->{{3.9837386221596613`*^9, 
  3.983738627546708*^9}},ExpressionUUID->"2e190369-2b4e-45d2-b98f-\
6fef113d4259"],

Cell[TextData[{
 "Here we can see the \[OpenCurlyDoubleQuote]topological tearing\
\[CloseCurlyDoubleQuote] mentioned in the inventories above. The input to the \
Manipulate is an angle of rotation from 0 to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "\[Pi]", " ", 
    RowBox[{"(", 
     RowBox[{"720", "\[Degree]"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0591d624-1f08-4c21-adf5-51f7c949934e"],
 " about the Z axis. The two columns show representations of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cf9df58c-f398-4580-99e0-5c51cbe8aec5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "72798959-ee62-4a59-8c75-8e819da871ba"],
 " computed straight from the matrix exponentials, plus extractions of the \
angle from the representations and a \[OpenCurlyDoubleQuote]clock-style\
\[CloseCurlyDoubleQuote] visualization of the angle. The demonstration shows \
that one full rotation of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Pi]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6195e01d-56b7-4ff3-92a3-248583356e7b"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c1f00008-ccee-4b85-96c2-43f32799225c"],
 " corresponds to half a rotation in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fcd78d05-9ce8-46c2-89fd-d458b44cc84e"],
 ", furnishing intuition about the double covering. Of course, the double \
covering pertains in exactly the same way to any axis of rotation. Things to \
try include animating the full range of \[Theta] from 0 to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"720", "\[Degree]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e17aa46c-1e15-49cd-abf6-136821a38af1"],
 " and picking various angles to see the relationships in depth."
}], "Text",
 CellChangeTimes->{{3.9837102046378517`*^9, 3.983710263753809*^9}, {
  3.9837103375168743`*^9, 
  3.983710657934471*^9}},ExpressionUUID->"8dae70b6-96a2-4ed4-acc1-\
41772befe0db"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mot", "=", 
        RowBox[{"Chop", "@", 
         RowBox[{"MatrixExp", "[", 
          RowBox[{"\[Theta]", " ", 
           RowBox[{"T", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}]}], ",", 
       RowBox[{"moj", "=", 
        RowBox[{"Chop", "@", 
         RowBox[{"MatrixExp", "[", 
          RowBox[{"\[Theta]", " ", 
           RowBox[{"J", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"deg", "=", 
        RowBox[{"N", "[", "\[Degree]", "]"}]}], ",", 
       RowBox[{"o", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], ",", 
       RowBox[{"box", "=", 
        RowBox[{"{", 
         RowBox[{"200", ",", "100"}], "}"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"angt", "=", 
          RowBox[{"N", "@", 
           RowBox[{"Arg", "[", 
            RowBox[{"mot", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}], "]"}]}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"angj", "=", 
          RowBox[{"N", "@", 
           RowBox[{"ArcTan", "[", 
            RowBox[{
             RowBox[{"moj", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"moj", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "]"}]}]}]}], "}"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"Grid", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"#", ",", "Bold", ",", "18"}], "]"}], "&"}], "/@", 
           RowBox[{"{", 
            RowBox[{"\"\<SU(2)\>\"", ",", "\"\<SO(3)\>\""}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Pane", "[", 
             RowBox[{
              RowBox[{"MatrixForm", "@", "mot"}], ",", "box", ",", 
              RowBox[{"Alignment", "->", "Center"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Pane", "[", 
             RowBox[{
              RowBox[{"MatrixForm", "@", "moj"}], ",", "box", ",", 
              RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"angt", "/", "deg"}], ",", 
            RowBox[{"angj", "/", "deg"}]}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Graphics", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Circle", "[", 
                RowBox[{"o", ",", "1"}], "]"}], ",", 
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{"o", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Cos", "[", "angt", "]"}], ",", 
                    RowBox[{"Sin", "[", "angt", "]"}]}], "}"}]}], "}"}], 
                "]"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Graphics", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Circle", "[", 
                RowBox[{"o", ",", "1"}], "]"}], ",", 
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{"o", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Cos", "[", "angj", "]"}], ",", 
                    RowBox[{"Sin", "[", "angj", "]"}]}], "}"}]}], "}"}], 
                "]"}]}], "}"}], "]"}]}], "}"}]}], "    ", "}"}], "    ", 
        "]"}]}], "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", 
       RowBox[{"0", "\[Degree]"}]}], "}"}], ",", "0", ",", 
     RowBox[{"720", "\[Degree]"}], ",", 
     RowBox[{"10", "\[Degree]"}], ",", 
     RowBox[{"Appearance", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Open\>\"", ",", "\"\<Labeled\>\""}], "}"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.983690245054502*^9, 3.983690395144287*^9}, {
   3.983690426025498*^9, 3.983690427627672*^9}, {3.9836905156124763`*^9, 
   3.983690753300988*^9}, {3.983690796901143*^9, 3.9836908001908417`*^9}, {
   3.9836908729289017`*^9, 3.983690967346644*^9}, 3.9836910278319483`*^9, {
   3.983694107732633*^9, 3.983694184357522*^9}, {3.983694270195924*^9, 
   3.983694361052401*^9}, {3.983694430953627*^9, 3.983694939173459*^9}, {
   3.9836957853670177`*^9, 3.9836958784008827`*^9}, 3.983696099048912*^9, 
   3.983707655454463*^9, {3.983707704112764*^9, 3.98370770453249*^9}, {
   3.983709387119832*^9, 3.983709400871169*^9}, {3.983710161134515*^9, 
   3.983710174660769*^9}, {3.983710269531522*^9, 3.983710282134645*^9}, {
   3.9837103147729673`*^9, 3.9837103233044252`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"e219675d-7f71-41f3-8103-e0958bdb8d92"],

