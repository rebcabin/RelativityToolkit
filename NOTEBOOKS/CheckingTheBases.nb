Cell[CellGroupData[{
Cell["Lie Theory, Featuring 3D Rotations", "Title",
 CellChangeTimes->{{3.983173218765286*^9, 3.98317323883042*^9}, {
  3.9836226072734833`*^9, 3.9836226192528677`*^9}, {3.9837108084731703`*^9, 
  3.983710811635215*^9}},ExpressionUUID->"657fee8b-ea6a-4178-8803-\
59dfb4c6d771"],

Cell["Brian Beckman", "Author",
 CellChangeTimes->{{3.5011898003565187`*^9, 3.5011898164415183`*^9}, {
  3.970503905858189*^9, 3.970503938930399*^9}, {3.9705040303289137`*^9, 
  3.970504033015139*^9}, {3.9821742142252197`*^9, 
  3.982174229504068*^9}},ExpressionUUID->"883e0006-3f27-45b6-a072-\
b18b2de76d67"],

Cell["Mar 2026 ", "Author",
 CellChangeTimes->{{3.970503954212903*^9, 3.97050395891148*^9}, {
   3.972479129640115*^9, 3.9724791301125593`*^9}, {3.973546918457328*^9, 
   3.973546918968728*^9}, {3.9762809550919313`*^9, 3.976280957806756*^9}, {
   3.97889721918757*^9, 3.978897219626444*^9}, {3.980093931170611*^9, 
   3.980093931658099*^9}, 
   3.982102496096343*^9},ExpressionUUID->"9360e31b-0239-4681-bcde-\
7928e4511e3b"],

Cell[TextData[{
 "In this notebook, we formalize the mathematical framework of Lie theory, \
using 3D rotations as a driving example. While we have previously applied Lie \
theory to rotational dynamics, we took many mathematical facts on faith. \
Here, in a structured, cheat-sheet style, we derive everything, proceeding \
from the central concept, the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  ExpressionUUID->"df1ee08f-90ba-43db-8dbc-d06d59a3eb09"],
 " Lie algebra, to the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "65c865d6-c542-4f44-9dc0-2886fff57665"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "c02b9a78-e008-4458-8d9b-ea77c8b73cfa"],
 " rotational Lie groups, which emerge naturally via ",
 StyleBox["representation theory",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellChangeTimes->{{3.983488648450673*^9, 3.983488729801982*^9}, {
   3.983488776906001*^9, 3.9834890035692873`*^9}, {3.983489113107196*^9, 
   3.9834891171971292`*^9}, {3.9834897200949297`*^9, 3.983489738620515*^9}, {
   3.98348978013555*^9, 3.9834897843380632`*^9}, {3.9834898154689903`*^9, 
   3.983489834526807*^9}, {3.983622630647333*^9, 3.983622660902801*^9}, {
   3.9836227036559343`*^9, 3.983622705271737*^9}, {3.983781683338976*^9, 
   3.983781782676099*^9}, 3.983781829732148*^9, {3.983781905053441*^9, 
   3.983782009947253*^9}, {3.983782097807802*^9, 
   3.9837821391080008`*^9}},ExpressionUUID->"63237b43-2266-48ad-8ed6-\
9d7e1a587b45"],

Cell["\<\
In short, this notebook serves as a physics-centric introduction to Lie \
theory, showing techniques that generalize far beyond 3D rotations.\
\>", "Text",
 CellChangeTimes->{{3.983488648450673*^9, 3.983488729801982*^9}, {
  3.983488776906001*^9, 3.9834890035692873`*^9}, {3.983489113107196*^9, 
  3.9834891171971292`*^9}, {3.9834897200949297`*^9, 3.983489738620515*^9}, {
  3.98348978013555*^9, 3.9834897843380632`*^9}, {3.9834898154689903`*^9, 
  3.983489834526807*^9}, {3.983622630647333*^9, 3.983622660902801*^9}, {
  3.9836227036559343`*^9, 3.983622705271737*^9}, {3.983781683338976*^9, 
  3.983781782676099*^9}, {3.983781848433301*^9, 
  3.983781877967465*^9}},ExpressionUUID->"dc754e15-5a68-4a2e-9d06-\
5c2154cf13ab"],

Cell[CellGroupData[{

Cell["Preliminaries", "Section",
 CellChangeTimes->{{3.983142342938731*^9, 
  3.983142345538424*^9}},ExpressionUUID->"93f27e63-35e9-4e83-9ac2-\
a470bcbab09d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "proof", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"proof", "[", "v_", "]"}], "/;", 
    RowBox[{"BooleanQ", "[", "v", "]"}]}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{"v", ",", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<QED\[VeryThinSpace]\[VeryThinSpace]\[VeryThinSpace]\
\[FilledSquare]\>\"", ",", "StandardGreen", ",", "Bold", ",", "18"}], "]"}], 
        "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<FAILED PROOF\[VeryThinSpace]\[VeryThinSpace]\
\[VeryThinSpace]\[FilledSquare]\>\"", ",", "StandardRed", ",", "Bold", ",", 
          "18"}], "]"}], "]"}]}], "]"}], ";", "v"}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"proof", "[", "___", "]"}], ":=", 
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<INVALID INPUT TO PROOF\[VeryThinSpace]\[VeryThinSpace]\
\[VeryThinSpace]\[FilledSquare]\>\"", ",", "StandardYellow", ",", "Bold", ",",
       "18"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.981101493976972*^9, 3.981101532526101*^9}, {
   3.981106452389163*^9, 3.981106463759047*^9}, {3.9815620903868732`*^9, 
   3.9815621486446466`*^9}, {3.981562189710235*^9, 3.9815622872980413`*^9}, 
   3.981622272096715*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"7354b7d2-d247-4de4-af14-1ad59d14ea7a"]
}, Closed]],

Cell[CellGroupData[{

Cell["Lie Ontology", "Section",
 CellChangeTimes->{{3.9831423288589697`*^9, 3.983142331222837*^9}, {
  3.983148854364173*^9, 
  3.983148855241686*^9}},ExpressionUUID->"84066372-721d-4d4b-a992-\
9e9f4b584994"],

Cell[TextData[{
 "One of the most important applications of Lie theory is for 3D rotations. \
In two earlier notebooks, ",
 Cell[BoxData[
  FormBox[
   ButtonBox[
    RowBox[{"S", "\[VeryThinSpace]", "O", 
     RowBox[{"(", "3", ")"}]}],
    BaseStyle->"Hyperlink",
    ButtonData->{
      URL["https://community.wolfram.com/groups/-/m/t/3647724"], None},
    ButtonNote->"https://community.wolfram.com/groups/-/m/t/3647724"], 
   TraditionalForm]],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True},ExpressionUUID->
  "3f556cfb-eee7-42b0-ab8a-f0c2564ed1b6"],
 StyleBox[ButtonBox[" for Classical Mechanics",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3647724"], None},
  ButtonNote->"https://community.wolfram.com/groups/-/m/t/3647724"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 " and ",
 StyleBox[ButtonBox["SU(2) for Classical Mechanics",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3656731"], None},
  ButtonNote->"https://community.wolfram.com/groups/-/m/t/3656731"],
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 ", we showed how to solve dynamical problems via geodesics in the Lie groups \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "79a368c6-c99a-455a-a3ad-28f4dd81c975"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "deb5967e-a1fb-4f9e-a7c1-5a3bb94b69fe"],
 ", with metric tensors composed of kinetic energies. We demonstrated the \
superiority of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "4d9cc589-ee50-4c88-9ddf-76ec345b7ede"],
 " in avoiding the gimbal lock in the Euler-angle parameterization of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "06c67131-7423-4721-ac0b-6adb197d8b6a"],
 ", by honoring the intrinsic, simply connected topology of the configuration \
space of rotations. In those notebooks, we developed just enough of the \
mathematical theory to assure the application, in a \
\[OpenCurlyDoubleQuote]just-in-time\[CloseCurlyDoubleQuote] style. This style \
left us with several pieces of theory \[OpenCurlyDoubleQuote]on the table.\
\[CloseCurlyDoubleQuote] Here, we organize those pieces and fit them together \
in a tidy structure that\[CloseCurlyQuote]s easy to understand, to remember, \
and to be creative with. We first give an inventory of the objects and \
mappings in the theory, and then present a diagram linking them together. In \
the rest of the notebook, we work out the details formally, machine-checked \
by Wolfram."
}], "Text",
 CellChangeTimes->{{3.983173666276601*^9, 3.983173701343951*^9}, {
  3.98317373739504*^9, 3.9831737519498587`*^9}, {3.983174041580144*^9, 
  3.9831741762648563`*^9}, {3.983175455213258*^9, 3.98317589610816*^9}, {
  3.983489141738237*^9, 3.983489186766251*^9}, {3.983489846524362*^9, 
  3.983489872983121*^9}, {3.983489941637554*^9, 3.9834899560130577`*^9}, {
  3.983489990560248*^9, 3.983489991076112*^9}, {3.983622733279353*^9, 
  3.983622748022643*^9}, {3.983622797100171*^9, 3.983622869395183*^9}, {
  3.983644253116694*^9, 
  3.983644335864347*^9}},ExpressionUUID->"ed5dc775-6822-4aaa-a9b4-\
2d88cf044fdf"],

Cell[CellGroupData[{

Cell["Object Inventory", "Subsection",
 CellChangeTimes->{{3.983148079337203*^9, 3.9831480833899918`*^9}, {
  3.98314884972972*^9, 
  3.98314885932474*^9}},ExpressionUUID->"86222c04-8adc-49e9-8a83-\
01df14164817"],

Cell[TextData[{
 "The \[OpenCurlyDoubleQuote]big picture\[CloseCurlyDoubleQuote] for \
rotations is that we can \t",
 StyleBox["represent",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " the abstract Lie algebra \[GothicG] of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "d669e2a2-c643-4d85-a52a-feef90a258bf"],
 " in at least two ways. One of them leads us to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "cd451295-24f5-4a70-8bca-2a0b7482ea45"],
 " and its troubles with gimbal lock (via the non-trivial ",
 StyleBox["fundamental group",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Pi]", "1"], "(", 
     RowBox[{"S", "\[VeryThinSpace]", 
      RowBox[{"O", "(", "3", ")"}]}], ")"}], "=", 
    SubscriptBox["\[DoubleStruckCapitalZ]", "2"]}], TraditionalForm]],
  ExpressionUUID->"cbb92aee-09eb-400e-bd82-7ff3679905c8"],
 "), the other to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "61286555-254a-4b16-9bea-70a396ca062e"],
 " with no such troubles and, thus, a virtuous slippery slope to quantum \
theory. "
}], "Text",
 CellChangeTimes->{{3.983175904738624*^9, 3.983175923406301*^9}, {
   3.983175998909338*^9, 3.98317618484311*^9}, 3.98317631166579*^9, {
   3.983176343566792*^9, 3.983176345668559*^9}, {3.983176551601671*^9, 
   3.983176601489965*^9}, {3.983176637726076*^9, 3.9831766694111347`*^9}, {
   3.983490022831156*^9, 3.9834901017245913`*^9}, {3.983490262444387*^9, 
   3.9834902666533413`*^9}},ExpressionUUID->"f49f0aba-3cc9-4546-92a3-\
9b33f96658e1"],

Cell[TextData[{
 StyleBox["Representation",
  FontSlant->"Italic"],
 " is a formal notion: ",
 StyleBox["mapping the abstraction to matrices",
  FontSlant->"Italic"],
 ". Representation theory itself is an immense topic. Here we need just a \
basic understanding. "
}], "Item",
 CellChangeTimes->{{3.983175904738624*^9, 3.983175923406301*^9}, {
  3.983175998909338*^9, 3.98317618484311*^9}, {3.98362293869496*^9, 
  3.983622966969968*^9}},ExpressionUUID->"420af3ea-ac13-46ef-9702-\
bd415db100b0"],

Cell[TextData[{
 "Abstractly, a Lie algebra is a vector space with a ",
 StyleBox["Lie bracket operation",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"A", ",", "B"}], "]"}], TraditionalForm]],ExpressionUUID->
  "cb918fbe-8a4b-4d7b-8e81-703cda5f832b"],
 ", that satisfies the Jacobi identity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"[", 
      RowBox[{"A", ",", 
       RowBox[{"[", 
        RowBox[{"B", ",", "C"}], "]"}]}], "]"}], "+", 
     RowBox[{"[", 
      RowBox[{"C", ",", 
       RowBox[{"[", 
        RowBox[{"A", ",", "B"}], "]"}]}], "]"}], "+", 
     RowBox[{"[", 
      RowBox[{"B", ",", 
       RowBox[{"[", 
        RowBox[{"C", ",", "A"}], "]"}]}], "]"}]}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"eee9803d-4aae-4641-b7ac-6ca2ca057f08"],
 ". In a matrix representation, the Lie bracket is the matrix commutator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{"A", ",", "B"}], "]"}], "=", 
    RowBox[{
     RowBox[{"A", "\[CenterDot]", "B"}], "-", 
     RowBox[{"B", "\[CenterDot]", "A"}]}]}], TraditionalForm]],ExpressionUUID->
  "680b8fcd-d015-4802-a68b-03a93e507c71"],
 "."
}], "Item",
 CellChangeTimes->{{3.983176355738575*^9, 3.983176539070888*^9}, {
  3.983622975790819*^9, 
  3.9836229988969316`*^9}},ExpressionUUID->"5bd75686-1aeb-4df5-8123-\
c073ee030e34"],

Cell[TextData[{
 "The abstract algebra, \[GothicG], for 3D rotations is characterized by its \
its specific structure constants. In general, the ",
 StyleBox["structure constants ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", 
    RowBox[{"i", "\[VeryThinSpace]", "j", "\[VeryThinSpace]", "k"}]], 
   TraditionalForm]],ExpressionUUID->"ebfc7817-c227-4c6b-91cc-0a5b48e58a08"],
 StyleBox[" ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of any Lie algebra-",
 StyleBox["qua",
  FontSlant->"Italic"],
 "-vector-space are the Lie bracket applied to a choice of basis vectors: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["E", "i"], ",", 
      SubscriptBox["E", "j"]}], "]"}], "=", 
    RowBox[{
     SubscriptBox["f", 
      RowBox[{"i", "\[VeryThinSpace]", "j", "\[VeryThinSpace]", "k"}]], 
     SubscriptBox["E", "k"]}]}], TraditionalForm]],ExpressionUUID->
  "83b1aa5b-2326-4899-8cf0-e8fd9da6b03e"],
 " (sum over ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "3cf43782-8e0c-41a7-8fb5-aa9869822f29"],
 "). The specific structure constants for rotations are ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", 
    RowBox[{"i", "\[VeryThinSpace]", "j", "\[VeryThinSpace]", "k"}]], 
   TraditionalForm]],ExpressionUUID->"3572e6ff-82c6-48e2-8dec-ebfeffc8ee8e"],
 ", the fully antisymmetric Levi-Civita tensor, where ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "332a382a-7c67-4f0c-8040-9bb9aaa6bede"],
 ", ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "14b8fef4-9c5b-4bd5-b189-d334ea83eaf7"],
 ", ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "e4e6b9c1-a493-45ce-a449-e5755a0ab261"],
 " are in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], TraditionalForm]],
  ExpressionUUID->"e3d21b33-6dc6-4b54-a816-da2e5fe330f9"],
 ". These structure constants model the cross product, familiar from \
elementary physics as the primary tool for describing rotation.  In the real \
domain, these structure constants imply the generators ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["J", "k"], TraditionalForm]],ExpressionUUID->
  "b2bd7475-8eea-4824-b0f7-f82a804a7e77"],
 ". In the complex domain, they imply the generators ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "k"], TraditionalForm]],ExpressionUUID->
  "fadbcb63-b841-49a1-b1ad-fd56425ca7ec"],
 ". The corresponding Lie groups follow via the exponential map. "
}], "Text",
 CellChangeTimes->{{3.983175904738624*^9, 3.983175923406301*^9}, {
   3.983175998909338*^9, 3.983176169821064*^9}, {3.983176213178405*^9, 
   3.983176264580551*^9}, {3.983176330522565*^9, 3.983176333482235*^9}, {
   3.9831768839346952`*^9, 3.9831771389381943`*^9}, {3.98317851884638*^9, 
   3.983178531689932*^9}, {3.983178597726184*^9, 3.983178597726465*^9}, {
   3.983178635785633*^9, 3.983178667077442*^9}, {3.983178716784967*^9, 
   3.983178867011853*^9}, {3.983178900134061*^9, 3.98317894056516*^9}, {
   3.983178970825461*^9, 3.9831790754416513`*^9}, {3.983179281311944*^9, 
   3.983179281709462*^9}, {3.9834908589678383`*^9, 3.983490883135253*^9}, {
   3.98353249371529*^9, 3.983532614614408*^9}, 3.98353532767409*^9, {
   3.983623025764051*^9, 3.983623033016018*^9}, {3.983623111737506*^9, 
   3.9836231817972307`*^9}, {3.98362331627273*^9, 3.983623341960215*^9}, {
   3.9836417647142973`*^9, 3.9836417723756742`*^9}, {3.9836427450807333`*^9, 
   3.983642747272279*^9}, {3.9836483496853724`*^9, 3.9836483504866037`*^9}, {
   3.983648930856195*^9, 
   3.98364894829423*^9}},ExpressionUUID->"cdace033-d782-40ed-89cd-\
11d19f146859"],

Cell[CellGroupData[{

Cell["\<\
A Lie group is both a group and a differentiable manifold. As a manifold, it \
enjoys parameterization by coordinate charts that must be differentiable \
where they overlap. As a group, its elements describe linear transformations \
of other objects, spinors and mat-vecs in our running example.\
\>", "Item",
 CellChangeTimes->{{3.983642758466502*^9, 3.983642906677806*^9}, {
  3.983642943192259*^9, 3.983643004968213*^9}, {3.983648974175617*^9, 
  3.983648974648265*^9}},ExpressionUUID->"50e2411c-a2ae-4eae-a107-\
cbb98c2988a8"],

Cell[TextData[{
 "The adjoint action, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "\[CenterDot]", "v", "\[CenterDot]", 
    RowBox[{"Q", "\[ConjugateTranspose]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9aa0dce4-33df-4e57-bc84-8c7b93db52e9"],
 " is linear in ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "abd1b53e-cd9c-4f91-9473-9a8dc1b36e07"],
 ". "
}], "Subitem",
 CellChangeTimes->{{3.983649121616125*^9, 
  3.983649172795649*^9}},ExpressionUUID->"1eb90911-0155-4946-ae98-\
9d228c639c58"]
}, Open  ]],

Cell[TextData[{
 "The double-covering of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "35da0877-d8f3-41d5-bf7a-6f5b6aee8d83"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "ca7209d7-1f97-49b4-ba40-22cd66363bf0"],
 " follows from the topology of their respective manifolds. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d483d480-aa4d-4ed7-b5e5-2142b95984f3"],
 " is diffeomorphic to the real projective space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]P", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fdedf05f-30dd-4a44-bee3-0681a39313aa"],
 ", visualized as the 3\[NoBreak]-\[NoBreak]sphere ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["S", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "99000ca5-60fb-48e2-b6c4-ad195051a89c"],
 ", where every point is identified with its antipode, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"q", "\[Tilde]", 
     RowBox[{"(", 
      RowBox[{"-", "q"}], ")"}]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "729097df-6739-4c1d-9655-afce16a017f9"],
 ". ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]P", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "305e6265-cd85-4d73-9a35-2dbb21516a38"],
 " is not simply connected because any closed loop in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["S", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "14658c0b-9302-4e21-91f7-85796d9962cf"],
 " that includes both ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8269fa80-0d26-4cd6-903d-6a941c9286db"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "q"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "81e605fe-3cc1-4983-81a9-49765d282a9f"],
 ", the same point in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]P", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5e0c1542-c505-48c3-98a8-49d24bd35920"],
 ", is a closed loop in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]P", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7561137d-e8c0-4d36-bb9a-4fb406b71efc"],
 " that cannot be shrunk to zero size without \[OpenCurlyDoubleQuote]tearing\
\[CloseCurlyDoubleQuote]. In contrast, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "95265667-636e-4bf4-81f8-e956b1fdf339"],
 " is diffeomorphic to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["S", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "23732cf1-d630-403c-b60c-13b412b53e63"],
 ". This space is simply connected because any closed path can be shrunk to \
zero size."
}], "Text",
 CellChangeTimes->{{3.983175904738624*^9, 3.983175923406301*^9}, {
   3.983175998909338*^9, 3.983176169821064*^9}, {3.983176213178405*^9, 
   3.983176264580551*^9}, {3.983176330522565*^9, 3.983176333482235*^9}, {
   3.9831768839346952`*^9, 3.9831771389381943`*^9}, {3.98317851884638*^9, 
   3.983178531689932*^9}, {3.983178597726184*^9, 3.983178597726465*^9}, {
   3.983178635785633*^9, 3.983178667077442*^9}, {3.983178716784967*^9, 
   3.983178867011853*^9}, {3.983178900134061*^9, 3.98317894056516*^9}, {
   3.983178970825461*^9, 3.9831790754416513`*^9}, {3.983179281311944*^9, 
   3.983179281709462*^9}, {3.9834908589678383`*^9, 3.983490883135253*^9}, {
   3.98353249371529*^9, 3.983532614614408*^9}, 3.98353532767409*^9, {
   3.983623025764051*^9, 3.983623033016018*^9}, {3.983623111737506*^9, 
   3.9836231817972307`*^9}, {3.98362331627273*^9, 3.983623373725485*^9}, {
   3.983627786123505*^9, 3.983628220422999*^9}, {3.983628360868305*^9, 
   3.983628476151208*^9}, {3.983628562954135*^9, 3.983628796709812*^9}, {
   3.983628826711862*^9, 3.9836288279044247`*^9}, {3.983628860870235*^9, 
   3.9836290038886967`*^9}, {3.983629117352556*^9, 3.983629120570051*^9}, {
   3.983629151397004*^9, 3.9836291875742817`*^9}, {3.983629235421867*^9, 
   3.983629255667695*^9}, {3.9836292879842367`*^9, 3.983629373487009*^9}, {
   3.9836294413424797`*^9, 3.983629442476058*^9}, {3.983629495311038*^9, 
   3.9836295140393343`*^9}, {3.9836295719166*^9, 3.983629599887745*^9}, {
   3.98362963543871*^9, 3.9836296960767927`*^9}, {3.983629980660124*^9, 
   3.983630077856915*^9}, 3.9836315877395267`*^9, {3.9836418432584333`*^9, 
   3.98364189030602*^9}, {3.983641975994205*^9, 3.983642095234682*^9}, {
   3.9836421287657213`*^9, 3.983642171703492*^9}, {3.983642442106676*^9, 
   3.983642444012554*^9}},ExpressionUUID->"4fcee676-3db4-435a-bf9e-\
c7607ac34c35"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SuperscriptBox["S", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6252a064-bcad-466a-990b-e8806ea4559a"],
 " is the set of all points ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "\[Congruent]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["q", "0"], ",", 
      SubscriptBox["q", "1"], ",", 
      SubscriptBox["q", "2"], ",", 
      SubscriptBox["q", "3"]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8e0955af-bccb-4323-84b4-76407a10ef54"],
 " in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]", "4"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f3b7d006-eb6d-4f48-95c2-668a8fbe2d3a"],
 " such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["q", "0", "2"], "+", 
      SubsuperscriptBox["q", "1", "2"], "+", 
      SubsuperscriptBox["q", "2", "2"], "+", 
      SubsuperscriptBox["q", "3", "2"]}], "=", "1"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aedee9c9-1b75-4f46-8023-08266e877677"],
 "."
}], "Item",
 CellChangeTimes->{{3.9836419125879602`*^9, 3.9836419526197443`*^9}, 
   3.983643097523212*^9, {3.983643173289032*^9, 
   3.9836431759209757`*^9}},ExpressionUUID->"1f065071-419a-4236-9c7d-\
8f57bbecb718"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]P", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2bf9a67f-a717-4082-a263-9b9b24070ce8"],
 ", points are actually pairs ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"q", ",", 
     RowBox[{"-", "q"}]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7806bedb-1faa-429b-912a-47ee6e2709ea"],
 " of elements of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]", "4"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0274ac2f-fcd6-42ee-9208-1b8a2d963662"],
 "."
}], "Item",
 CellChangeTimes->{{3.983643103778158*^9, 3.983643154952742*^9}, 
   3.9836431921198263`*^9},ExpressionUUID->"501411b0-a575-4e0b-9414-\
1185edafefcb"],

Cell[TextData[{
 "The elements of each group describe linear transformations of geometric \
objects that are not elements of the group. Concretely, we ",
 StyleBox["represent",
  FontSlant->"Italic"],
 " the linear transformations as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[Times]", "n"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "134e6853-aea6-43e4-b44d-ca3c64cfa459"],
 " matrices that operate on ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b667d4e4-bfaf-4f79-a67e-d01e73b2681d"],
 "\[NoBreak]-\[NoBreak]vectors. We represent ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "14f76825-87b2-4086-831b-9d6502022db4"],
 " by real ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "3"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9557f6a0-481d-4e09-b88f-75190e281f70"],
 " rotation matrices that act on real 3\[NoBreak]-\[NoBreak]vectors. We \
represent ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "23c36fc8-5ca4-4f7e-9ac4-e6e8c9362655"],
 " by complex ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "84fbd2db-dd89-47af-83fa-5438333a8d4d"],
 " matrices, isomorphic to ",
 StyleBox["unit quaternions",
  FontSlant->"Italic"],
 ", that act on spinors in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "spin"], "=", 
    SuperscriptBox["\[DoubleStruckCapitalC]", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "99b9d466-6a7c-4e8a-9f73-eae37410e465"],
 " and on complex, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9fea23fe-0c1d-44fa-8f06-bb7f8141db97"],
 ", traceless, Hermitian matrices (",
 StyleBox["mat-vecs",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[GothicH]", "\[Sigma]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eb2d8d70-fff8-45b4-94b0-fe16bc0a7776"],
 ") that represent real 3\[NoBreak]-\[NoBreak]vectors. "
}], "Text",
 CellChangeTimes->{{3.9836426272126293`*^9, 3.983642642791066*^9}, {
  3.983642684911907*^9, 3.983642702979203*^9}, {3.983643023933194*^9, 
  3.983643070824039*^9}, {3.983643204155518*^9, 3.983643245414044*^9}, {
  3.9836435023602543`*^9, 3.983643574995247*^9}, {3.983643654665309*^9, 
  3.9836437512713137`*^9}, {3.9836438227026978`*^9, 3.983643927460908*^9}, {
  3.983643996197528*^9, 3.983644017101532*^9}, {3.983644196788781*^9, 
  3.983644205207472*^9}, {3.983649192640188*^9, 3.983649204369562*^9}, {
  3.983650280612516*^9, 3.983650281148985*^9}, {3.983651089861697*^9, 
  3.983651090784911*^9}, {3.983651136950433*^9, 
  3.983651137896371*^9}},ExpressionUUID->"63752913-580a-4fb2-932d-\
0cfcb7bfc33a"],

Cell[TextData[{
 "The algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d2ae6dcd-5f93-4883-be32-bf6e7a79f980"],
 " is isomorphic to the pure imaginary quaternions, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", 
     SubscriptBox["q", "1"], ",", 
     SubscriptBox["q", "2"], ",", 
     SubscriptBox["q", "3"]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8cfe88bf-c9e9-44e2-b529-11c8f5e00f0d"],
 "."
}], "Item",
 CellChangeTimes->{{3.9836511482253857`*^9, 3.98365118440187*^9}, {
  3.9836512182648573`*^9, 
  3.983651234131177*^9}},ExpressionUUID->"83fe917e-e3da-440b-aded-\
b5e13c0d4d26"],

Cell[TextData[{
 "Finally, we introduce some notation, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ad", "X"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "760d723a-38c9-4004-ba51-81fc7b3874e7"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Ad", "Q"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "48f15d42-cc45-4df6-ae3f-ac2cc65a87d1"],
 ", for actions in the Lie algebra and the Lie Group respectively, and the \
Killing form for extracting components of members of the Lie groups."
}], "Text",
 CellChangeTimes->{{3.983644388542186*^9, 3.983644552661819*^9}, {
  3.983648104674148*^9, 
  3.983648107768223*^9}},ExpressionUUID->"76cd9e39-d98b-4803-9fc2-\
4466426a7c3f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"data", ",", "header", ",", "row"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"row", "[", 
       RowBox[{"col1_", ",", "col2_", ",", "col3_"}], "]"}], ":=", 
      RowBox[{"{", 
       RowBox[{"col1", ",", "col2", ",", "col3"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"header", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Short Name\>\"", ",", "14", ",", "Bold"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Item Description\>\"", ",", "14", ",", "Bold"}], "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Context / Physical Interpretation\>\"", ",", "14", ",", 
          "Bold"}], "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{"{", 
       RowBox[{"header", ",", "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<\[GothicG]\>\"", 
          ",", "\"\<Abstraction of \[GothicS]\[GothicU](2)\>\"", 
          ",", "\"\<Abstract Lie algebra: [\!\(\*SubscriptBox[\(E\), \
\(i\)]\), \!\(\*SubscriptBox[\(E\), \(j\)]\)] = \!\(\*SubscriptBox[\(\
\[CurlyEpsilon]\), \(i\[VeryThinSpace]j\[VeryThinSpace]k\)]\) \
\!\(\*SubscriptBox[\(E\), \(k\)]\) (no sum)\>\""}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(f\), \(i\[VeryThinSpace]j\
\[VeryThinSpace]k\)]\)\>\"", ",", "\"\<Structure Constants\>\"", 
          ",", "\"\<Numbers \!\(\*SubscriptBox[\(\[CurlyEpsilon]\), \(i\
\[VeryThinSpace]j\[VeryThinSpace]k\)]\) characterizing the bracket\>\""}], 
         "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Sigma]\), \(k\)]\)\>\"", 
          ",", "\"\<Pauli Matrices\>\"", 
          ",", "\"\<Basis {\!\(\*SubscriptBox[\(\[Sigma]\), \(1\)]\), \
\!\(\*SubscriptBox[\(\[Sigma]\), \(2\)]\), \!\(\*SubscriptBox[\(\[Sigma]\), \
\(3\)]\)} for the Pauli Map\>\""}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(T\), \(k\)]\)\>\"", 
          ",", "\"\<Generators of \
\[GothicS]\[GothicU](2\!\(\*SubscriptBox[\()\), SuperscriptBox[\(\
\[DoubleStruckCapitalC]\), \(2\)]]\)\>\"", 
          ",", "\"\<\!\(\*SubscriptBox[\(T\), \(k\)]\) = -\[ImaginaryI] \
\!\(\*SubscriptBox[\(\[Sigma]\), \(k\)]\)/2; [\!\(\*SubscriptBox[\(T\), \
\(i\)]\),\!\(\*SubscriptBox[\(T\), \(j\)]\)] = \!\(\*SubscriptBox[\(T\), \
\(k\)]\) in \!\(\*SuperscriptBox[\(\[DoubleStruckCapitalC]\), \
\(2\)]\)\[Times]\[VeryThinSpace]\[VeryThinSpace]\[VeryThinSpace]\!\(\*\
SuperscriptBox[\(\[DoubleStruckCapitalC]\), \(2\)]\)\>\""}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(J\), \(k\)]\)\>\"", 
          ",", "\"\<Generators of \
\[GothicS]\[GothicU](2\!\(\*SubscriptBox[\()\), SuperscriptBox[\(\
\[DoubleStruckCapitalR]\), \(3\)]]\)\>\"", 
          ",", "\"\<[\!\(\*SubscriptBox[\(J\), \
\(i\)]\),\!\(\*SubscriptBox[\(J\), \(j\)]\)] = \!\(\*SubscriptBox[\(J\), \
\(k\)]\) in \!\(\*SuperscriptBox[\(\[DoubleStruckCapitalR]\), \
\(3\)]\)\[Times]\[VeryThinSpace]\[VeryThinSpace]\[VeryThinSpace]\!\(\*\
SuperscriptBox[\(\[DoubleStruckCapitalR]\), \(3\)]\)\>\""}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<\[GothicS]\[GothicU](2\!\(\*SubscriptBox[\()\), \
SuperscriptBox[\(\[DoubleStruckCapitalC]\), \(2\)]]\)\>\"", 
          ",", "\"\<\[GothicS]\[GothicU](2) 2x2 \[DoubleStruckCapitalC] Rep\>\
\"", ",", "\"\<Complex matrix representation (Generators \
\!\(\*SubscriptBox[\(T\), \(k\)]\))\>\""}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<\[GothicS]\[GothicU](2\!\(\*SubscriptBox[\()\), \
SuperscriptBox[\(\[DoubleStruckCapitalR]\), \(3\)]]\) = \
\[GothicS]\[GothicO](3)\>\"", 
          
          ",", "\"\<\[GothicS]\[GothicO](3) 3x3 \[DoubleStruckCapitalR] Rep\>\
\"", ",", "\"\<Real matrix representation (Generators \
\!\(\*SubscriptBox[\(J\), \(k\)]\))\>\""}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<SU(2)\>\"", ",", "\"\<SU(2) Group\>\"", 
          ",", "\"\<2 \[Times] 2 unitary matrices, det=1\>\""}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<SO(3)\>\"", ",", "\"\<SO(3) Group\>\"", 
          ",", "\"\<3 \[Times] 3 orthogonal matrices, det=1\>\""}], "]"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(V\), \(spin\)]\)\>\"", 
          ",", "\"\<Spinors \
(\!\(\*SuperscriptBox[\(\[DoubleStruckCapitalC]\), \(2\)]\))\>\"", 
          ",", "\"\<Space for Fundamental Action of SU(2)\>\""}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<\!\(\*SuperscriptBox[\(\[DoubleStruckCapitalR]\), \
\(3\)]\)\>\"", 
          ",", "\"\<Real \!\(\*SuperscriptBox[\(\[DoubleStruckCapitalR]\), \
\(3\)]\)\>\"", ",", "\"\<Euclidean space of physical 3-vectors\>\""}], "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(\[GothicH]\), \(\[Sigma]\)]\)\>\"",
           ",", "\"\<Mat-Vecs\>\"", 
          ",", "\"\<Traceless Hermitian 2 \[Times] 2 matrices\>\""}], "]"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<\[ScriptCapitalZ]\>\"", ",", "\"\<Center\>\"", 
          ",", "\"\<The kernel {I, -I} of the SU(2) \[Rule] SO(3) map\>\""}], 
         "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<\!\(\*SuperscriptBox[\(S\), \(3\)]\)\>\"", 
          ",", "\"\<Topology \!\(\*SuperscriptBox[\(S\), \(3\)]\)\>\"", 
          ",", "\"\<Topology of SU(2) (3-sphere)\>\""}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<\!\(\*SuperscriptBox[\(\[DoubleStruckCapitalR]\), \
\(3\)]\)P\>\"", 
          ",", "\"\<Topolog \!\(\*SuperscriptBox[\(\[DoubleStruckCapitalR]\), \
\(3\)]\)P\>\"", ",", "\"\<Topology of SO(3) (Projective space)\>\""}], "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(ad\), \(X\)]\)Y\>\"", 
          ",", "\"\<Infitesimal adjoint\>\"", 
          ",", "\"\<Algebra action [X,Y]\>\""}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(Ad\), \(Q\)]\)Z\>\"", 
          ",", "\"\<Finite Adjoint\>\"", 
          ",", "\"\<Group action Q\[CenterDot]Z\[CenterDot]Q\[Dagger]\>\""}], 
         "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"row", "[", 
         RowBox[{"\"\<B\>\"", ",", "\"\<Killing Form\>\"", 
          ",", "\"\<Trace inner product for coordinate extraction\>\""}], 
         "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Grid", "[", 
      RowBox[{"data", ",", "\[IndentingNewLine]", 
       RowBox[{"Alignment", "->", 
        RowBox[{"{", 
         RowBox[{"Left", ",", "Baseline"}], "}"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Spacings", "->", 
          RowBox[{"{", 
           RowBox[{"2", ",", "1.25"}], "}"}]}], ","}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Dividers", "->", 
        RowBox[{"{", 
         RowBox[{"None", ",", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"1", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{"White", ",", 
               RowBox[{"Thickness", "[", "2", "]"}]}], "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"2", "->", "White"}], ",", "\[IndentingNewLine]", 
            RowBox[{"7", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{"White", ",", 
               RowBox[{"Thickness", "[", "0.5", "]"}], ",", 
               RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"12", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{"White", ",", 
               RowBox[{"Thickness", "[", "0.5", "]"}], ",", 
               RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"17", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{"White", ",", 
               RowBox[{"Thickness", "[", "0.5", "]"}], ",", 
               RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"-", "1"}], "->", "White"}]}], "}"}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Background", "->", 
        RowBox[{"{", 
         RowBox[{"None", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"GrayLevel", "[", "0.2", "]"}], ",", 
