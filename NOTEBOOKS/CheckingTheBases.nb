Cell[CellGroupData[{

Cell["Component Extraction from Trace Inner Product", "Section",
 CellChangeTimes->{{3.982869854167696*^9, 3.9828699153266487`*^9}, 
   3.9828703359432087`*^9, {3.982870407546534*^9, 3.982870408421884*^9}, {
   3.983007026212826*^9, 3.983007039305171*^9}, {3.983861227287599*^9, 
   3.9838612293360653`*^9}},ExpressionUUID->"363c29a6-6447-4f1f-bc72-\
51ac929d5246"],

Cell[TextData[{
 "The objective of this section is first to prove the following ",
 StyleBox["trace formulas",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (traces of matrix products) for extracting the components of vectors in \
(elements of) the Lie algebra \[GothicG] in the ",
 Cell[BoxData[
  FormBox["J", TraditionalForm]],ExpressionUUID->
  "bf81608b-a33c-49a0-b284-5843f9966189"],
 " and ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],ExpressionUUID->
  "cff2ce74-d02a-426d-b4c3-cc6177dea404"],
 " bases:"
}], "Text",
 CellChangeTimes->{{3.983784965701672*^9, 3.98378498256561*^9}, {
  3.983787467154848*^9, 3.983787542718305*^9}, {3.9837883465638933`*^9, 
  3.983788348604806*^9}, {3.9838087063631697`*^9, 3.983808731255926*^9}, {
  3.983812090780382*^9, 3.9838121025370207`*^9}, {3.9838121955209723`*^9, 
  3.98381220097073*^9}, {3.983812280414938*^9, 3.9838122815683203`*^9}, {
  3.983818828493675*^9, 3.983818841742857*^9}, {3.983834233930813*^9, 
  3.983834234918606*^9}, {3.983836149471163*^9, 
  3.983836149939405*^9}},ExpressionUUID->"84820c23-6785-4190-a7ab-\
3a7a71b4c9ba"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", 
     SubscriptBox["J", "k"]], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     RowBox[{"Tr", "(", 
      RowBox[{"V", " ", 
       SubscriptBox["J", "k"]}], ")"}]}]}], "    ", "\[LongDash]", "\[LongDash]",
    " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"k", "\[NoBreak]"}], "th"], " ", "component", " ", "of", " ", 
    "V", " ", "in", " ", "the", " ", "J", " ", "basis"}], ",", " ", 
   RowBox[{
   "trace", " ", "of", " ", "the", " ", "matrix", " ", "product", " ", "V", " ", 
    SubscriptBox["J", "k"]}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.983785073979966*^9, 3.983785109860808*^9}, {
   3.983787135241963*^9, 3.98378727400988*^9}, {3.983787322798706*^9, 
   3.983787453488954*^9}, {3.9837883163419533`*^9, 3.983788335064838*^9}, {
   3.9838002282076883`*^9, 3.9838002329514847`*^9}, {3.983808735098998*^9, 
   3.983808745557692*^9}, {3.983812107844613*^9, 3.9838121215892*^9}, {
   3.983812353354068*^9, 3.983812378815749*^9}, {3.9838131150772963`*^9, 
   3.9838132518214703`*^9}, 3.9838349336144247`*^9},
 Background->None,ExpressionUUID->"d919211e-263d-4695-b75d-dac446748be4"],

Cell[CellGroupData[{

Cell[TextData[{
 "Formally, the inner product of real matrices is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"A", ",", "B"}], "\[RightAngleBracket]"}], "\[Congruent]", 
    RowBox[{"Tr", "(", 
     RowBox[{
      RowBox[{"A", "\[Transpose]"}], "B"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3cb6f93c-ebab-474c-891b-42a91ea105e4"],
 ". In our case, write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox["J", "k"], ",", "V"}], "\[RightAngleBracket]"}], "=", 
    RowBox[{
     RowBox[{"Tr", "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["J", "k"], "\[Transpose]"}], "V"}], ")"}], "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Tr", "(", 
        RowBox[{
         SubscriptBox["J", "k"], "V"}], " ", ")"}]}], "=", 
      RowBox[{"-", 
       RowBox[{"Tr", "(", 
        RowBox[{"V", " ", 
         SubscriptBox["J", "k"]}], ")"}]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b2dedb75-c7aa-4a18-9b53-963ec5de5342"],
 " because the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["J", "k"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cc822a52-2d09-4834-9e3c-c02c92065eef"],
 " are anti-symmetric. Finally, normalize because generators ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["J", "k"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "48ff30c1-b346-40bc-b2ec-07a883d7f359"],
 ", while an orthogonal basis, are not of unit length. The ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0f642a25-22da-49e3-86f0-a3ad8ee6c4f0"],
 "\[NoBreak]-\[NoBreak]th component of ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5917584f-d631-494f-a85c-953e315d9a31"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SubscriptBox["J", "k"], ",", "V"}], "\[RightAngleBracket]"}], " ", "/",
      " ", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SubscriptBox["J", "k"], ",", 
       SubscriptBox["J", "k"]}], "\[RightAngleBracket]"}]}], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     RowBox[{"Tr", "(", 
      RowBox[{"V", " ", 
       SubscriptBox["J", "k"]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "71ceb3ff-f0dd-43a1-ae9d-59b0a50d2402"],
 " because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox["J", "k"], ",", 
      SubscriptBox["J", "k"]}], "\[RightAngleBracket]"}], "=", "2"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0ad58739-a94d-4bfb-a879-465108ef1ac4"],
 ":"
}], "Subitem",
 CellChangeTimes->{{3.983835505721513*^9, 3.9838357836356983`*^9}, {
  3.983835816079864*^9, 3.983835932373859*^9}, {3.9838359801235857`*^9, 
  3.9838359980670557`*^9}, {3.983861251014675*^9, 3.983861251473548*^9}, {
  3.983861290040646*^9, 3.9838613445840387`*^9}, {3.983864013636155*^9, 
  3.9838640619964943`*^9}, {3.9838646100047407`*^9, 3.98386461000488*^9}, {
  3.983864671254406*^9, 3.983864695577671*^9}, {3.983864758133465*^9, 
  3.983864758133606*^9}},ExpressionUUID->"b715462a-dae9-4693-bd97-\
ca79f99654ca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Tr", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"J", "[", 
       RowBox[{"[", "k", "]"}], "]"}], "\[Transpose]"}], ".", 
     RowBox[{"J", "[", 
      RowBox[{"[", "k", "]"}], "]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "3"}], "}"}]}], "]"}]], "Input",
