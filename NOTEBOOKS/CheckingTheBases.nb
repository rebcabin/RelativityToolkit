fffbab5a3571"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"SU2", "=", 
      RowBox[{"(", GridBox[{
         {
          RowBox[{"a", "+", 
           RowBox[{"b", " ", "\[ImaginaryI]", " "}]}], 
          RowBox[{"c", "+", 
           RowBox[{"d", " ", "\[ImaginaryI]"}]}]},
         {
          RowBox[{
           RowBox[{"-", "c"}], "+", 
           RowBox[{"d", " ", "\[ImaginaryI]"}]}], 
          RowBox[{"a", "-", 
           RowBox[{"b", " ", "\[ImaginaryI]"}]}]}
        }], ")"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Echo", "[", 
      RowBox[{
       RowBox[{"Det", "[", "SU2", "]"}], 
       ",", "\"\<determinant of special form of members of SU(2) :\>\""}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"proof", "@", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Det", "[", "SU2", "]"}], "/.", "normRule"}], ")"}], "==", 
         "1"}], ",", "\"\<SU(2) matrices are unit radii in \
\!\(\*SuperscriptBox[\(\[DoubleStruckCapitalR]\), \(4\)]\) :\>\""}], 
       "]"}]}]}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.983738741784175*^9, 3.983738742827991*^9}, {
   3.983738908355976*^9, 3.9837391744159184`*^9}, {3.983739243380753*^9, 
