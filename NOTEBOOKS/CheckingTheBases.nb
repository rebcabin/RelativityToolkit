           MatrixExp[$CellContext`\[Theta]$$ 
            Part[$CellContext`T, 3]]], $CellContext`moj = Chop[
           
           MatrixExp[$CellContext`\[Theta]$$ 
            Part[$CellContext`J, 3]]], $CellContext`deg = 
