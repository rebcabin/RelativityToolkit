Cell[CellGroupData[{

Cell[TextData[{
 "Exclusivity: proof that the only solutions to commutativity are multiples \
of ",
 Cell[BoxData[
  FormBox["I", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bb3ddb1b-a429-4f72-bfad-b7a4e2142836"]
}], "Subsection",
 CellChangeTimes->{{3.983712252264518*^9, 3.983712284731279*^9}, {
  3.983713473797823*^9, 
  3.983713480816625*^9}},ExpressionUUID->"fa78daa2-dd74-4770-9a52-\
a501306af85a"],

Cell[CellGroupData[{

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3f05d713-1595-4532-9c7d-1208c011f9f3"]
}], "Subsubsection",
 CellChangeTimes->{{3.9837122935809813`*^9, 
  3.983712300098976*^9}},ExpressionUUID->"4b698db0-a22d-4e67-bf39-\
33d0df09d111"],

Cell[TextData[{
 "The only solutions to the commutation equations of a a general ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "22c2bd05-da78-465e-b6c7-603f297b7e20"],
 " matrix are multiples of the identity. This fact follows from Schur\
\[CloseCurlyQuote]s lemma (after proof of irreducibility of the \
representation), but it\[CloseCurlyQuote]s also available via the following, \
elementary demonstration. "
}], "Text",
 CellChangeTimes->{{3.983712321226861*^9, 3.983712404882938*^9}, {
  3.9837134868194227`*^9, 
  3.983713548392351*^9}},ExpressionUUID->"0e943267-40ee-4bb5-827b-\
34762c3e9eea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", ",", "vars", ",", "sol", ",", "center"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Echo", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"m", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"c", ",", "d"}], "}"}]}], "}"}]}], ")"}], "//", 
        "MatrixForm"}], ",", "\"\<general 2\[Times]2 matrix :\>\""}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"vars", "=", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "All", " ", "matrices", " ", "that", " ", "commute", " ", "with", " ", 
       "SU", 
       RowBox[{"(", "2", ")"}], " ", "generators", " ", "T"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Echo", "[", 
      RowBox[{
       RowBox[{"sol", "=", 
        RowBox[{"Quiet", "@", 
         RowBox[{
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"commM", "[", 
                RowBox[{"m", ",", 
                 RowBox[{"T", "[", 
                  RowBox[{"[", "k", "]"}], "]"}]}], "]"}], "==", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0", ",", "0"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "3"}], "}"}]}], "]"}], ",", "vars"}], "]"}], 
          "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", "\"\<all matrices that commute with T :\>\""}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "m", " ", "must", " ", "be", " ", "a", " ", "multiple", " ", "of", " ", 
       "the", " ", "identity"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Echo", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"m", "/.", "sol"}], ")"}], "//", "MatrixForm"}], 
       ",", "\"\<general commuting matrix for SU(2) :\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Apply", " ", "group", " ", 
       RowBox[{"constraint", ":", " ", 
        RowBox[{
         RowBox[{"Det", "[", "m", "]"}], "==", 
         RowBox[{
          RowBox[{
          "1", " ", "to", " ", "show", " ", "only", " ", "I", " ", "and"}], 
          " ", "-", 
          RowBox[{"I", " ", "obtain"}]}]}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Echo", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"center", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Det", "[", 
               RowBox[{"m", "/.", "sol"}], "]"}], "==", "1"}], "}"}], ",", 
            RowBox[{"{", "a", "}"}]}], "]"}]}]}], ")"}], 
       ",", "\"\<center of SU(2) :\>\""}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"proof", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "center", "]"}], "==", "2"}], "&&", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"m", "/.", "sol"}], "/.", "center"}], ")"}], "==", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "}"}]}]}], "]"}]}]}], 
   "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.983712321226861*^9, 3.983712331014225*^9}, {
  3.983712415305626*^9, 3.983712486497368*^9}, {3.9837126820219717`*^9, 
  3.983712775072701*^9}, {3.983712811393426*^9, 3.98371289505691*^9}, {
  3.9837129458254833`*^9, 3.983713003927352*^9}, {3.9837130355755568`*^9, 
  3.983713052992898*^9}, {3.9837135721528053`*^9, 3.9837135856803303`*^9}, {
  3.98371388747194*^9, 3.983713921339079*^9}, {3.983713960788618*^9, 
  3.9837139670323267`*^9}, {3.983738039565703*^9, 3.9837380712678137`*^9}, {
  3.983738252074033*^9, 3.983738256980804*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"8c0ba3ed-79e7-4306-94a1-406657371031"],

