  3.983713604428562*^9}},ExpressionUUID->"2c3295dd-7712-455b-8802-\
595ce347b9eb"],

Cell["Using exactly the same technique as above", "Text",
 CellChangeTimes->{{3.983713938031591*^9, 
  3.983713948532826*^9}},ExpressionUUID->"6c8f5e3d-bdbd-4406-8683-\
1574c5fe4b1e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", "vars", ",", "sol", ",", "center", ",", 
       RowBox[{"zero3", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"m", "=", 
       RowBox[{"Array", "[", 
        RowBox[{"x", ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vars", "=", 
       RowBox[{"Flatten", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "All", " ", "matrices", " ", "that", " ", "commute", " ", "with", " ", 
        "SO", 
        RowBox[{"(", "3", ")"}], " ", "generators", " ", "J"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"sol", "=", 
       RowBox[{"Quiet", "@", 
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"commM", "[", 
               RowBox[{"m", ",", 
                RowBox[{"J", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}], "]"}], "==", "zero3"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "3"}], "}"}]}], "]"}], ",", "vars"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "m", " ", "must", " ", "be", " ", "a", " ", "multiple", " ", "of", " ",
         "the", " ", "identity"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"m", "/.", "sol"}], "//", "MatrixForm"}], 
        ",", "\"\<General commuting matrix for SO(3) :\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Apply", " ", "group", " ", 
        RowBox[{"constraint", ":", " ", 
         RowBox[{
          RowBox[{"Det", "[", "m", "]"}], "==", "1"}]}]}], "*)"}], " ", 
      "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"center", "=", 
           RowBox[{"Solve", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Det", "[", 
                RowBox[{"m", "/.", " ", "sol"}], "]"}], "==", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", "[", 
               RowBox[{"1", ",", "1"}], "]"}], "}"}]}], "]"}]}], ")"}], "//", 
         "ColumnForm"}], ",", "\"\<center of SO(3) :\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
         "the", " ", "only", " ", "real", " ", "solution", " ", "is", " ", 
          "c"}], "=", "1"}], ",", " ", 
        RowBox[{"which", " ", "is", " ", 
         RowBox[{
         "center", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}],
        "*)"}], "\[IndentingNewLine]", 
      RowBox[{"proof", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "center", "]"}], "==", "3"}], "&&", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"m", "/.", "sol"}], "/.", 
           RowBox[{"center", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "==", 
         RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "]"}]}]}], "]"}], 
   ";"}], "\n"}]], "Input",
 CellChangeTimes->{{3.983713806957177*^9, 3.983713863594371*^9}, {
  3.9837379412336807`*^9, 3.983738084751793*^9}, {3.983738117088018*^9, 
  3.9837382111040907`*^9}, {3.983738245265226*^9, 3.9837382484063883`*^9}, {
  3.983738338595002*^9, 3.983738548085112*^9}, {3.98378151365559*^9, 
  3.983781516786072*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"76db448e-d3a3-49ab-acbf-f17f72ee7a01"],

