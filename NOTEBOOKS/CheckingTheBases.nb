Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"Short Name\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     StyleBox["\<\"Item Description\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold], 
     StyleBox["\<\"Context / Physical Interpretation\"\>",
      StripOnInput->False,
      FontSize->14,
      FontWeight->Bold]},
    {"\<\"\[GothicG]\"\>", "\<\"Abstraction of \[GothicS]\[GothicU](2)\"\>", \
"\<\"Abstract Lie algebra: [\\!\\(\\*SubscriptBox[\\(E\\), \\(i\\)]\\), \
\\!\\(\\*SubscriptBox[\\(E\\), \\(j\\)]\\)] = \\!\\(\\*SubscriptBox[\\(\
\[CurlyEpsilon]\\), \\(i\[VeryThinSpace]j\[VeryThinSpace]k\\)]\\) \
\\!\\(\\*SubscriptBox[\\(E\\), \\(k\\)]\\) (no sum)\"\>"},
    {"\<\"\\!\\(\\*SubscriptBox[\\(f\\), \
\\(i\[VeryThinSpace]j\[VeryThinSpace]k\\)]\\)\"\>", "\<\"Structure \
Constants\"\>", "\<\"Numbers \\!\\(\\*SubscriptBox[\\(\[CurlyEpsilon]\\), \
\\(i\[VeryThinSpace]j\[VeryThinSpace]k\\)]\\) characterizing the bracket\"\>"},
    {"\<\"\\!\\(\\*SubscriptBox[\\(\[Sigma]\\), \\(k\\)]\\)\"\>", "\<\"Pauli \
Matrices\"\>", "\<\"Basis {\\!\\(\\*SubscriptBox[\\(\[Sigma]\\), \\(1\\)]\\), \
\\!\\(\\*SubscriptBox[\\(\[Sigma]\\), \\(2\\)]\\), \\!\\(\\*SubscriptBox[\\(\
\[Sigma]\\), \\(3\\)]\\)} for the Pauli Map\"\>"},
    {"\<\"\\!\\(\\*SubscriptBox[\\(T\\), \\(k\\)]\\)\"\>", "\<\"Generators of \
\[GothicS]\[GothicU](2\\!\\(\\*SubscriptBox[\\()\\), SuperscriptBox[\\(\
\[DoubleStruckCapitalC]\\), \\(2\\)]]\\)\"\>", \
"\<\"\\!\\(\\*SubscriptBox[\\(T\\), \\(k\\)]\\) = -\[ImaginaryI] \
\\!\\(\\*SubscriptBox[\\(\[Sigma]\\), \\(k\\)]\\)/2; \
[\\!\\(\\*SubscriptBox[\\(T\\), \\(i\\)]\\),\\!\\(\\*SubscriptBox[\\(T\\), \
\\(j\\)]\\)] = \\!\\(\\*SubscriptBox[\\(T\\), \\(k\\)]\\) in \
\\!\\(\\*SuperscriptBox[\\(\[DoubleStruckCapitalC]\\), \\(2\\)]\\)\[Times]\
\[VeryThinSpace]\[VeryThinSpace]\[VeryThinSpace]\\!\\(\\*SuperscriptBox[\\(\
\[DoubleStruckCapitalC]\\), \\(2\\)]\\)\"\>"},
    {"\<\"\\!\\(\\*SubscriptBox[\\(J\\), \\(k\\)]\\)\"\>", "\<\"Generators of \
\[GothicS]\[GothicU](2\\!\\(\\*SubscriptBox[\\()\\), SuperscriptBox[\\(\
\[DoubleStruckCapitalR]\\), \\(3\\)]]\\)\"\>", \
"\<\"[\\!\\(\\*SubscriptBox[\\(J\\), \
\\(i\\)]\\),\\!\\(\\*SubscriptBox[\\(J\\), \\(j\\)]\\)] = \
\\!\\(\\*SubscriptBox[\\(J\\), \\(k\\)]\\) in \\!\\(\\*SuperscriptBox[\\(\
\[DoubleStruckCapitalR]\\), \\(3\\)]\\)\[Times]\[VeryThinSpace]\
\[VeryThinSpace]\[VeryThinSpace]\\!\\(\\*SuperscriptBox[\\(\
\[DoubleStruckCapitalR]\\), \\(3\\)]\\)\"\>"},
    {"\<\"\[GothicS]\[GothicU](2\\!\\(\\*SubscriptBox[\\()\\), \
SuperscriptBox[\\(\[DoubleStruckCapitalC]\\), \\(2\\)]]\\)\"\>", "\<\"\
\[GothicS]\[GothicU](2) 2x2 \[DoubleStruckCapitalC] Rep\"\>", "\<\"Complex \
matrix representation (Generators \\!\\(\\*SubscriptBox[\\(T\\), \\(k\\)]\\))\
\"\>"},
    {"\<\"\[GothicS]\[GothicU](2\\!\\(\\*SubscriptBox[\\()\\), \
SuperscriptBox[\\(\[DoubleStruckCapitalR]\\), \\(3\\)]]\\) = \[GothicS]\
\[GothicO](3)\"\>", "\<\"\[GothicS]\[GothicO](3) 3x3 \[DoubleStruckCapitalR] \
Rep\"\>", "\<\"Real matrix representation (Generators \
\\!\\(\\*SubscriptBox[\\(J\\), \\(k\\)]\\))\"\>"},
    {"\<\"SU(2)\"\>", "\<\"SU(2) Group\"\>", "\<\"2 \[Times] 2 unitary \
matrices, det=1\"\>"},
    {"\<\"SO(3)\"\>", "\<\"SO(3) Group\"\>", "\<\"3 \[Times] 3 orthogonal \
matrices, det=1\"\>"},
    {"\<\"\\!\\(\\*SubscriptBox[\\(V\\), \\(spin\\)]\\)\"\>", "\<\"Spinors \
(\\!\\(\\*SuperscriptBox[\\(\[DoubleStruckCapitalC]\\), \\(2\\)]\\))\"\>", \
"\<\"Space for Fundamental Action of SU(2)\"\>"},
    {"\<\"\\!\\(\\*SuperscriptBox[\\(\[DoubleStruckCapitalR]\\), \
\\(3\\)]\\)\"\>", "\<\"Real \
\\!\\(\\*SuperscriptBox[\\(\[DoubleStruckCapitalR]\\), \\(3\\)]\\)\"\>", \
"\<\"Euclidean space of physical 3-vectors\"\>"},
    {"\<\"\\!\\(\\*SubscriptBox[\\(\[GothicH]\\), \\(\[Sigma]\\)]\\)\"\>", \
"\<\"Mat-Vecs\"\>", "\<\"Traceless Hermitian 2 \[Times] 2 matrices\"\>"},
    {"\<\"\[ScriptCapitalZ]\"\>", "\<\"Center\"\>", "\<\"The kernel {I, -I} \
of the SU(2) \[Rule] SO(3) map\"\>"},
    {"\<\"\\!\\(\\*SuperscriptBox[\\(S\\), \\(3\\)]\\)\"\>", "\<\"Topology \
\\!\\(\\*SuperscriptBox[\\(S\\), \\(3\\)]\\)\"\>", "\<\"Topology of SU(2) \
(3-sphere)\"\>"},
    {"\<\"\\!\\(\\*SuperscriptBox[\\(\[DoubleStruckCapitalR]\\), \\(3\\)]\\)P\
\"\>", "\<\"Topolog \\!\\(\\*SuperscriptBox[\\(\[DoubleStruckCapitalR]\\), \
\\(3\\)]\\)P\"\>", "\<\"Topology of SO(3) (Projective space)\"\>"},
    {"\<\"\\!\\(\\*SubscriptBox[\\(ad\\), \\(X\\)]\\)Y\"\>", "\<\"Infitesimal \
adjoint\"\>", "\<\"Algebra action [X,Y]\"\>"},
    {"\<\"\\!\\(\\*SubscriptBox[\\(Ad\\), \\(Q\\)]\\)Z\"\>", "\<\"Finite \
Adjoint\"\>", "\<\"Group action Q\[CenterDot]Z\[CenterDot]Q\[Dagger]\"\>"},
    {"\<\"B\"\>", "\<\"Killing Form\"\>", "\<\"Trace inner product for \
coordinate extraction\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
