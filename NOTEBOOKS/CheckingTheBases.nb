96adf6fd70e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"su2", "=", 
     RowBox[{"(", GridBox[{
        {
         RowBox[{"a", "+", 
          RowBox[{"b", " ", "\[ImaginaryI]", " "}]}], 
         RowBox[{"c", "+", 
          RowBox[{"d", " ", "\[ImaginaryI]"}]}]},
        {
         RowBox[{
          RowBox[{"-", "c"}], "+", 
          RowBox[{"d", " ", "\[ImaginaryI]"}]}], 
         RowBox[{
          RowBox[{"-", "a"}], "-", 
          RowBox[{"b", " ", "\[ImaginaryI]"}]}]}
       }], ")"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"proof", "[", 
     RowBox[{"Echo", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Tr", "[", "su2", "]"}], "==", "0"}], 
       ",", "\"\<su2 matrices are traceless :\>\""}], "]"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"proof", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", "->", "0"}], "}"}], "==", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"su2", "==", 
             RowBox[{"-", 
              RowBox[{"su2", "\[ConjugateTranspose]"}]}]}], "//", 
            "ComplexExpand"}], ",", 
           RowBox[{"{", "a", "}"}]}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        "\[IndentingNewLine]", "\"\<su2 matrices are anti-Hermitian iff a == \
0 :\>\""}], "]"}]}], "]"}], ";"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.983738741784175*^9, 3.983738742827991*^9}, {
   3.983738908355976*^9, 3.9837391744159184`*^9}, {3.983739243380753*^9, 
