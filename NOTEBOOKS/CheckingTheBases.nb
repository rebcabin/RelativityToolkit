629ba737475b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "250b8813-42a9-499e-89d1-ff4b8a8467d3"]
}], "Subsubsection",
