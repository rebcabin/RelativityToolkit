 RowBox[{"{", 
  RowBox[{"2", ",", "2", ",", "2"}], "}"}]], "Output",
 CellChangeTimes->{{3.983835957493576*^9, 3.9838359717878103`*^9}, 
   3.983864596003327*^9, 3.9838742268582497`*^9, 3.983874291766334*^9},
 CellLabel->"Out[40]=",ExpressionUUID->"c92e13f5-f963-413d-893a-d8ec4b60cafe"]
