Cell[TextData[{
 "The above shows that for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "efd4ff71-fc8e-4d7f-8bff-98a4cfeb4e1e"],
 ", off-diagonals are forced to 0 and the diagonals are forced to be equal, \
leaving only ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "I"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "01935e01-62c6-47f6-ad4f-930e7d2c9974"],
 " once the determinant is constrained ."
}], "Text",
 CellChangeTimes->{{3.983712321226861*^9, 3.983712331014225*^9}, {
  3.983712415305626*^9, 3.983712526891862*^9}, {3.983712631422743*^9, 
  3.9837126449279947`*^9}, {3.983713062362937*^9, 
