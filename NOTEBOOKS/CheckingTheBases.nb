Cell[CellGroupData[{

Cell["Mapping Inventory", "Subsection",
 CellChangeTimes->{{3.9831490116523113`*^9, 
  3.983149014694561*^9}},ExpressionUUID->"88817c84-0d2b-469c-8bf5-\
105c5894bfb4"],

Cell[TextData[{
 "Here we list, non-exhaustively, various mappings amongst the objects above. \
",
 StyleBox["MatrixExp", "Input"],
 " takes us from a representation of an element of a Lie algebra to a \
representation of an element of a Lie Group. This is a surjection in that \
multiple inputs can produce the same output. Not listed is the inverse, ",
 StyleBox["MatrixLog", "Input"],
 ", which goes the other way, because it is multi-valued, but there is an \
example in the body of the notebook of how to choose a branch of that inverse."
}], "Text",
 CellChangeTimes->{{3.983644575032774*^9, 3.983644628534931*^9}, {
  3.983644713318362*^9, 3.9836447695532722`*^9}, {3.9836448027070723`*^9, 
  3.983644838740756*^9}, {3.983644869880777*^9, 
  3.9836449982999363`*^9}},ExpressionUUID->"754a58c1-3378-4647-aa1d-\
bd1069e3cde1"],

Cell[TextData[{
 "Technically, ",
 StyleBox["MatrixExp", "Input"],
 " is always a surjection exactly when the target Lie group is compact and \
connected. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6b8df7b8-85d1-41eb-968a-28a79a9dd7ca"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f4faed95-d5f5-46ba-925a-5115eeaf79bd"],
 " satisfies these criteria. See Hall, Knapp, and Milnor in the References. "
}], "Item",
 CellChangeTimes->{{3.983645460956962*^9, 3.983645467753654*^9}, {
  3.9836457028417597`*^9, 3.9836457198748417`*^9}, {3.9836457831610403`*^9, 
  3.983645811040557*^9}, {3.983646197342019*^9, 3.983646259856647*^9}, {
  3.983646664124071*^9, 3.983646664125876*^9}, {3.983646701906625*^9, 
  3.9836467035362377`*^9}},ExpressionUUID->"c17cb9b6-9607-4f67-884d-\
717fa6d786d9"],

Cell[TextData[{
 "The ",
 StyleBox["center",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " \[ScriptCapitalZ] of a group is the set of all elements that commute with \
every other element of the group . For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0574ca8b-2c5b-46e5-bc47-729e6e95d98e"],
 ", the center consists of only ",
 Cell[BoxData[
  FormBox["I", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ea401773-8aa9-42f7-bead-788f7ae78a0c"],
 ", the identity, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "I"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9b4f30bd-c82a-41a7-be13-3c4336d2e4dc"],
 ", the negative identity. The ",
 StyleBox["inclusion map",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "875a42e3-928e-4ac3-835a-3f904c28de02"],
 " merely states that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "I", ")"}], "=", "I"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "325c60a5-f37c-4132-8ece-2daefdb84ef1"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{"-", "I"}], ")"}], "=", 
    RowBox[{"-", "I"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0b1520a2-9527-48e1-b325-1ed568c7f8e2"],
 ". This inclusion formally ensures that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{
     RowBox[{"U", "(", "2", ")"}], "/", "\[ScriptCapitalZ]"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "66708c2a-5ac4-44b0-852c-e4fd765309d6"],
 " is isomorphic to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3402997f-0b1f-4ba6-ad3c-003095009315"],
 " in that both ",
 Cell[BoxData[
  FormBox["I", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8238fed8-cd58-486a-8776-01d1bf5808b4"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "I"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0667964d-0d2e-4fec-801a-ea7b00590e98"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "981133bc-a4ef-47ee-9412-403b181bbc45"],
 " map to ",
 Cell[BoxData[
  FormBox["I", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8e2f0ae4-a962-49fb-95d6-4a35bb862abf"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c843da12-287d-4363-ae36-086896eefc51"],
 ", expressing the \[OpenCurlyDoubleQuote]double \
cover\[CloseCurlyDoubleQuote] relationship between ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "85337df9-c8e2-4bfe-a4ce-9743fda05041"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4e3a7972-1f6d-4b84-8842-0d2e7463ce75"],
 ". In group-theoretic terms, \[ScriptCapitalZ] is the ",
 StyleBox["kernel",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"S", "\[VeryThinSpace]", 
     RowBox[{"U", "(", "2", ")"}]}], "->", 
    RowBox[{"S", "\[VeryThinSpace]", 
     RowBox[{"O", "(", "3", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "018df6f6-edfa-4b8d-a8cf-c45676539e33"],
 " map, the set of elements in the domain that map to the identity element. "
}], "Text",
 CellChangeTimes->{{3.983645460956962*^9, 3.983645467753654*^9}, {
  3.9836457028417597`*^9, 3.9836457198748417`*^9}, {3.9836457831610403`*^9, 
  3.983645811040557*^9}, {3.983646197342019*^9, 3.983646259856647*^9}, {
  3.983646835006193*^9, 3.983646974901799*^9}, {3.983647462118245*^9, 
  3.9836475434553413`*^9}, {3.98364761336625*^9, 3.983647768151351*^9}, {
  3.983647860867517*^9, 3.9836479557008677`*^9}, {3.983710874375976*^9, 
  3.9837108768925047`*^9}},ExpressionUUID->"d5a6fd82-8b43-4b36-9902-\
cc0dad764f71"],

Cell[TextData[{
 "The ",
 StyleBox["Pauli map",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " takes 3\[NoBreak]-\[NoBreak]vectors to traceless, Hermitian matrices \
(mat-vecs) in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[GothicH]", "\[Sigma]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "14434aa8-4ce9-40b9-8159-46ff7467b300"],
 ". The trace projection takes them back, via a circuitous derivation \
involving the Killing Form, ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b28124d2-6799-428f-89ae-db3d506aaf69"],
 ". Examples are shown in the body of the notebook."
}], "Text",
 CellChangeTimes->{{3.983647973071138*^9, 3.983648122680179*^9}, {
  3.98364824593312*^9, 3.983648256289279*^9}, {3.9836503156277018`*^9, 
  3.9836503159378433`*^9}},ExpressionUUID->"4b4d39e7-271b-4fa5-8af4-\
8f068a31e03e"],

Cell[TextData[{
 "To concretely represent the vectors in the Lie-algebra-",
 StyleBox["qua",
  FontSlant->"Italic"],
 "-vector space, we must choose a basis. Many choices map to the same \
structure constants ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", 
    RowBox[{"i", "\[VeryThinSpace]", "j", "\[VeryThinSpace]", "k"}]], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "18a0ff87-4122-4999-b213-e839e78a6713"],
 ", and that\[CloseCurlyQuote]s why the mapping is only surjective. However, \
once a basis is chosen for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0ee82112-1a8a-451a-8986-672d5cea8f9f"],
 " and the structure constants are materialized as the specific constants ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", 
    RowBox[{"i", "\[VeryThinSpace]", "j", "\[VeryThinSpace]", "k"}]], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9e767ca1-1b80-4e39-a277-5a615b545a43"],
 ", the mapping becomes bijective in that we can recover the basis from the \
particular structure constants ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", 
    RowBox[{"i", "\[VeryThinSpace]", "j", "\[VeryThinSpace]", "k"}]], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "81bc194e-2823-40ca-a3c2-bef582476bbb"],
 ". "
}], "Text",
 CellChangeTimes->{{3.983648481492964*^9, 3.983648521419012*^9}, {
  3.9836485640844507`*^9, 3.9836485652284393`*^9}, {3.983649251866253*^9, 
  3.983649377964795*^9}, {3.983649472055567*^9, 
  3.983649536348051*^9}},ExpressionUUID->"3df585b2-8afb-46b4-94b5-\
01edcf5d7ac0"],

Cell["\<\
The remaining rows of the Mapping Inventory should be self-explanatory given \
the previous explanations. \
\>", "Text",
 CellChangeTimes->{{3.98364955468146*^9, 
  3.983649592464346*^9}},ExpressionUUID->"8ff4311a-7868-4772-8e64-\
953d5a32c6b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"data", ",", "header", ",", "row"}], "}"}], ",", 
   RowBox[{"(*", 
    RowBox[{
    "Helper", " ", "to", " ", "keep", " ", "the", " ", "data", " ", 
     "structure", " ", "clean"}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"row", "[", 
      RowBox[{"src_", ",", "target_", ",", "mech_", ",", "type_"}], "]"}], ":=", 
     RowBox[{"{", 
