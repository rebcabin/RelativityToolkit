Cell[TextData[{
 "Unitary ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ebb98785-ee9c-4f16-ac75-ba32776a8445"],
 " Matrices of Unit Determinant"
}], "Text",
 CellChangeTimes->{{3.983738634081829*^9, 3.983738730376245*^9}, {
  3.9837394732504253`*^9, 3.983739494613901*^9}, {3.98374115203822*^9, 
