   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       RowBox[{"a", "+", 
        RowBox[{"\[ImaginaryI]", " ", "b"}]}], 
       RowBox[{"c", "+", 
        RowBox[{"\[ImaginaryI]", " ", "d"}]}]},
      {
       RowBox[{"-", 
        FractionBox[
         RowBox[{"c", "-", 
          RowBox[{"\[ImaginaryI]", " ", "d"}]}], 
         RowBox[{
          SuperscriptBox["a", "2"], "+", 
          SuperscriptBox["b", "2"], "+", 
          SuperscriptBox["c", "2"], "+", 
          SuperscriptBox["d", "2"]}]]}], 
       FractionBox[
        RowBox[{"a", "-", 
         RowBox[{"\[ImaginaryI]", " ", "b"}]}], 
        RowBox[{
         SuperscriptBox["a", "2"], "+", 
         SuperscriptBox["b", "2"], "+", 
