Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", 
     SubscriptBox["T", "k"]], "=", 
    RowBox[{
     RowBox[{"-", "2"}], 
     RowBox[{"Tr", "(", 
      RowBox[{"V", " ", 
       SubscriptBox["T", "k"]}], ")"}]}]}], "    ", "\[LongDash]", "\[LongDash]",
    " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"k", "\[NoBreak]"}], "th"], " ", "component", " ", "of", " ", 
    "V", " ", "in", " ", "the", " ", "T", " ", "basis"}], ",", " ", 
   RowBox[{
   "trace", " ", "of", " ", "the", " ", "matrix", " ", "product", " ", "V", " ", 
    SubscriptBox["T", "k"]}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.983785073979966*^9, 3.983785109860808*^9}, {
   3.983787135241963*^9, 3.98378727400988*^9}, {3.983787322798706*^9, 
   3.983787453488954*^9}, {3.9837883163419533`*^9, 3.983788335064838*^9}, {
   3.9838002282076883`*^9, 3.9838002329514847`*^9}, {3.983808735098998*^9, 
   3.983808745557692*^9}, {3.983812107844613*^9, 3.9838121215892*^9}, {
   3.983812353354068*^9, 3.983812378815749*^9}, {3.9838131150772963`*^9, 
   3.9838132518214703`*^9}, 
   3.9838349336144247`*^9},ExpressionUUID->"e376b631-8300-4adb-8ca5-\
4d1d1b1b41de"],

Cell[CellGroupData[{

Cell[TextData[{
 "Formally, the inner product of complex matrices is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"A", ",", "B"}], "\[RightAngleBracket]"}], "\[Congruent]", 
    RowBox[{"Tr", "(", 
     RowBox[{
      RowBox[{"A", "\[ConjugateTranspose]"}], "B"}], ")"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "859b27a4-1122-46ee-a402-8bb0b0aef2a7"],
 ". In our case, write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox["T", "k"], ",", "V"}], "\[RightAngleBracket]"}], "=", 
    RowBox[{
     RowBox[{"Tr", "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["T", "k"], "\[ConjugateTranspose]"}], "V"}], ")"}], "=", 
     
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Tr", "(", 
        RowBox[{
         SubscriptBox["T", "k"], "V"}], ")"}]}], "=", 
      RowBox[{"-", 
       RowBox[{"Tr", "(", 
        RowBox[{"V", " ", 
         SubscriptBox["T", "k"]}], ")"}]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "149a269c-dff4-4cc4-a1c0-d777f314cfcf"],
 " because the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "k"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "748ef75c-8e53-4e88-b8d5-d6c84144f280"],
 " are anti-Hermitian. Finally, normalize because generators ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "k"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "323299d5-6102-42bb-9364-03d40bf4942d"],
 ", while an orthogonal basis, are not of unit length. The ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f19c294a-d313-4852-903b-102a01de579b"],
 "\[NoBreak]-\[NoBreak]th component of ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fc94e567-3bd7-4641-b203-3727699dbbd5"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SubscriptBox["T", "k"], ",", "V"}], "\[RightAngleBracket]"}], " ", "/",
      " ", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SubscriptBox["T", "k"], ",", 
       SubscriptBox["T", "k"]}], "\[RightAngleBracket]"}]}], "=", 
    RowBox[{
     RowBox[{"-", "2"}], 
     RowBox[{"Tr", "(", 
      RowBox[{"V", " ", 
       SubscriptBox["T", "k"]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "189dd40b-447c-4958-9368-0769f45a8108"],
 " because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox["T", "k"], ",", 
      SubscriptBox["T", "k"]}], "\[RightAngleBracket]"}], "=", 
    FractionBox["1", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "413ac37c-ab3f-4a00-88f7-a363dd8408da"],
 ":"
}], "Subitem",
 CellChangeTimes->{{3.983834952382002*^9, 3.9838351227587633`*^9}, {
