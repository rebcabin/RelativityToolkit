a17fb1b8d31f"],

Cell[TextData[{
 "Here we show that a 3\[NoBreak]-\[NoBreak]vector rotated by an element of \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b89e445b-266e-4146-85a3-99b640a8170b"],
 " maps to the same vector rotated by an element of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "122d934a-2e94-419f-94df-1a38fe06a680"],
 ". The reverse is twoS\[NoBreak]-\[NoBreak]to\[NoBreak]-\[NoBreak]one, as \
amply demonstrated above. "
}], "Text",
 CellChangeTimes->{{3.983871672241775*^9, 3.983871677676853*^9}, {
  3.9838717145556593`*^9, 
  3.983871893383369*^9}},ExpressionUUID->"37c7ff2c-a7a3-4fd0-b016-\
02b7f08b1d70"],

