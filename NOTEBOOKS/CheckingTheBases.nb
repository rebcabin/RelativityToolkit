Cell[TextData[{
 "We will prove this in two steps. The first step is to show that the unitary \
requirement and the unit-determinant requirement for members of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bc50d066-9471-4cea-807b-90d0f8d78255"],
 " imply that the matrix representation has a specific form, namely"
}], "Text",
 CellChangeTimes->{{3.983779068862792*^9, 3.983779169342498*^9}, {
  3.9837795478284483`*^9, 3.983779549947235*^9}, {3.9837796559340363`*^9, 
  3.983779656523991*^9}},ExpressionUUID->"1682a14e-3101-4de2-a1af-\
f9db8ed8271a"],

Cell[BoxData[
 FormBox[
  RowBox[{"form", "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"a", "+", 
        RowBox[{"b", "\[VeryThinSpace]", "\[ImaginaryI]"}]}], 
       RowBox[{"c", "+", 
        RowBox[{"d", "\[VeryThinSpace]", "\[ImaginaryI]"}]}]},
      {
       RowBox[{
        RowBox[{"-", "c"}], "+", 
        RowBox[{"d", "\[VeryThinSpace]", "\[ImaginaryI]"}]}], 
       RowBox[{"a", "-", 
        RowBox[{"b", "\[VeryThinSpace]", "\[ImaginaryI]"}]}]}
     }], ")"}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.983779174532227*^9, 3.983779253352674*^9}, {
  3.9837797287105303`*^9, 
  3.983779729909783*^9}},ExpressionUUID->"5d0336bd-e32a-41cc-a22b-\
4bea35d617ac"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0a30de7d-79e3-42f9-9014-4a4056d4ad17"],
 " are all real. During the course of that demonstration, we will find (and \
exploit) that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["a", "2"], "+", 
     SuperscriptBox["b", "2"], "+", 
     SuperscriptBox["c", "2"], "+", 
     SuperscriptBox["d", "2"]}], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a0089c83-a7ec-4a24-b7ce-1a6426f962eb"],
 ". "
}], "Text",
 CellChangeTimes->{{3.98377955455389*^9, 3.983779634211597*^9}, {
  3.9837796648318357`*^9, 3.983779689362183*^9}, {3.983779810480834*^9, 
  3.983779821958531*^9}, {3.983780877157215*^9, 
  3.9837808786773376`*^9}},ExpressionUUID->"bdb90386-74b9-4e8d-9d56-\
9ad8234c0f86"],

Cell[TextData[{
 "In the second step, we show that the determinant of the special form is \
exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "2"], "+", 
    SuperscriptBox["b", "2"], "+", 
    SuperscriptBox["c", "2"], "+", 
    SuperscriptBox["d", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "27d24658-6117-4d49-8440-99448097e7dd"],
 ", which we already know is 1. Interpreting this as the expression for the \
radius of a sphere in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]", "4"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "32c38dcc-58bd-4876-812a-5c66509a750d"],
 " with coordinates ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4450e33a-65dd-47b1-963a-40042008c751"],
 ", we have the final result."
}], "Text",
 CellChangeTimes->{{3.983779751210823*^9, 3.983779800820856*^9}, {
  3.983779838604444*^9, 3.983779872806067*^9}, {3.9837799692221537`*^9, 
  3.983780055895605*^9}},ExpressionUUID->"a71f10e2-9a57-4dab-b59c-\
ab25658441f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"arbitrary", " ", "8"}], "-", 
        RowBox[{"parameter", " ", "complex", " ", "matrix"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"M", "=", 
        RowBox[{"(", GridBox[{
           {
            RowBox[{"a", "+", 
             RowBox[{"b", " ", "\[ImaginaryI]"}]}], 
            RowBox[{"c", "+", 
             RowBox[{"d", " ", "\[ImaginaryI]"}]}]},
           {
            RowBox[{"e", "+", 
             RowBox[{"f", " ", "\[ImaginaryI]"}]}], 
            RowBox[{"g", "+", 
             RowBox[{"h", " ", "\[ImaginaryI]"}]}]}
          }], ")"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"vars", "=", 
        RowBox[{"{", 
         RowBox[{
         "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f", ",", "g", ",",
           "h"}], "}"}]}], ",", "\[IndentingNewLine]", "complexEqns", ",", 
       "realEqns", ",", "linearEqns", ",", "soln"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"complex", " ", "equations"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"complexEqns", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{"(*", " ", "unitarity", " ", "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Thread", "[", 
               RowBox[{
                RowBox[{"Flatten", "[", 
                 RowBox[{
                  RowBox[{"M", ".", 
                   RowBox[{"M", "\[ConjugateTranspose]"}]}], "//", 
                  "ComplexExpand"}], "]"}], "==", 
                RowBox[{"Flatten", "[", 
                 RowBox[{"IdentityMatrix", "[", "2", "]"}], "]"}]}], "]"}], ",",
               "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{"det", " ", "=", " ", 
                RowBox[{"1", " ", 
                 RowBox[{"(", 
                  RowBox[{"\"\<special\>\"", " ", "property"}], " "}]}]}], 
               "*)"}], "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Det", "[", "M", "]"}], "==", "1"}]}], "}"}], "]"}]}], 
          ")"}], "//", "ColumnForm"}], ",", "\"\<complex eqns :\>\""}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Split", " ", "into", " ", "real", " ", "equations"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"realEqns", "=", 
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"#", "=!=", "True"}], "&"}], "]"}], "@", " ", 
            RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"ComplexExpand", "[", 
                   RowBox[{"Re", "[", 
                    RowBox[{
                    RowBox[{"eq", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "-", 
                    RowBox[{"eq", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "==", 
                  "0"}], ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"ComplexExpand", "[", 
                   RowBox[{"Im", "[", 
                    RowBox[{
                    RowBox[{"eq", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "-", 
                    RowBox[{"eq", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "==", 
                  "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"eq", ",", "complexEqns"}], "}"}]}], "]"}], "]"}]}]}],
           ")"}], "//", "ColumnForm"}], ",", "\"\<real eqns :\>\""}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"select", " ", "real", " ", "eqns", " ", "linear", " ", "in", " ", 
        RowBox[{"{", 
         RowBox[{"e", ",", "f", ",", "g", ",", "h"}], "}"}]}], " ", "*)"}], 
      " ", "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"linearEqns", "=", 
           RowBox[{"Select", "[", 
            RowBox[{"realEqns", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Total", "@", 
                 RowBox[{"Exponent", "[", 
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"e", ",", "f", ",", "g", ",", "h"}], "}"}]}], 
                  "]"}]}], ")"}], "==", "4"}], "&"}]}], "]"}]}], ")"}], "//", 
         "ColumnForm"}], ",", "\"\<linear eqns :\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{"Length", "[", "linearEqns", "]"}], ",", 
        " ", "\"\<number of linear eqns (some redundant) :\>\""}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Solve", " ", "for", " ", 
        RowBox[{"{", 
         RowBox[{"e", ",", "f", ",", "g", ",", "h"}], "}"}], " ", "in", " ", 
        "terms", " ", "of", " ", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"soln", "=", 
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{"linearEqns", ",", 
          RowBox[{"{", 
           RowBox[{"e", ",", "f", ",", "g", ",", "h"}], "}"}], ",", "Reals"}],
          "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", "Results", " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"M", "/.", "soln"}], "//", "Simplify"}], "//", 
         "MatrixForm"}], ",", "\"\<arb member of SU(2):\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{"normRule", "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"complexEqns", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{"Equal", "->", "Rule"}], "}"}]}], ")"}]}], 
        ",", "\"\<norm rule from first complex eqn :\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{"MatrixForm", "[", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{"M", "/.", "soln"}], "]"}], "/.", "normRule"}], "]"}], 
        ",", "\"\<constrained form for members of SU(2) :\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"proof", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{"M", "/.", "soln"}], "]"}], "/.", "normRule"}], ")"}], "==", 
        RowBox[{"(", GridBox[{
           {
            RowBox[{"a", "+", 
             RowBox[{"b", " ", "\[ImaginaryI]", " "}]}], 
            RowBox[{"c", "+", 
             RowBox[{"d", " ", "\[ImaginaryI]"}]}]},
           {
            RowBox[{
             RowBox[{"-", "c"}], "+", 
             RowBox[{"d", " ", "\[ImaginaryI]"}]}], 
            RowBox[{"a", "-", 
             RowBox[{"b", " ", "\[ImaginaryI]"}]}]}
          }], ")"}]}], "]"}]}]}], "]"}], ";"}], "\n"}]], "Input",
 CellChangeTimes->CompressedData["
