Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Object Name\"\>", "\<\"Wolfram Input\"\>", "\<\"Textbook \
Output\"\>"},
    {"\<\"Contravariant Vector\"\>", "\<\"x[\[ScriptCapitalU][\[Mu]]]\"\>", 
     RowBox[{"x", 
      SuperscriptBox["", "\[Mu]"]}]},
    {"\<\"Covariant Covector\"\>", "\<\"p[\[ScriptCapitalD][\[Nu]]]\"\>", 
     RowBox[{"p", 
      SubscriptBox["", "\[Nu]"]}]},
    {"\<\"Mixed Tensor\"\>", "\<\"T[\[ScriptCapitalU][\[Mu]], \
\[ScriptCapitalD][\[Nu]]]\"\>", 
     RowBox[{"T", 
      SuperscriptBox["", "\[Mu]"], 
      SubscriptBox["", "\[Nu]"]}]},
    {"\<\"The Metric\"\>", "\<\"g[\[ScriptCapitalD][\[Mu]], \
\[ScriptCapitalD][\[Nu]]]\"\>", 
     RowBox[{"g", 
      SubscriptBox["", "\[Mu]"], 
      SubscriptBox["", "\[Nu]"]}]},
    {"\<\"Inverse Metric\"\>", "\<\"g[\[ScriptCapitalU][\[Mu]], \
\[ScriptCapitalU][\[Nu]]]\"\>", 
     RowBox[{"g", 
      SuperscriptBox["", "\[Mu]"], 
      SuperscriptBox["", "\[Nu]"]}]},
