Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Object Name\"\>", "\<\"Wolfram Input\"\>", "\<\"Textbook \
Output\"\>"},
    {"\<\"Contravariant Vector\"\>", "\<\"x[\[ScriptCapitalU][\[Mu]]]\"\>", 
     RowBox[{"x", 
      SuperscriptBox["", "\[Mu]"]}]},
    {"\<\"Covariant Covector\"\>", "\<\"p[\[ScriptCapitalD][\[Nu]]]\"\>", 
     RowBox[{"p", 
      SubscriptBox["", "\[Nu]"]}]},
    {"\<\"Mixed Tensor\"\>", "\<\"T[\[ScriptCapitalU][\[Mu]], \
\[ScriptCapitalD][\[Nu]]]\"\>", 
     RowBox[{"T", 
      SuperscriptBox["", "\[Mu]"], 
      SubscriptBox["", "\[Nu]"]}]},
