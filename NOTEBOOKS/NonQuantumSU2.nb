Cell[TextData[{
 "Begin by treating the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "de7b98f2-ea7c-4107-baf3-c0c6f654ebd1"],
 " group manifold (the 3\[NoBreak]-\[NoBreak]sphere ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["S", "3"], TraditionalForm]],ExpressionUUID->
  "c9a6461e-3992-44c7-b133-8f9094faeb46"],
 ") as a 4D, non-Euclidean space, isomorphic to Hamilton\[CloseCurlyQuote]s \
quaternions as shown in Chapter III."
}], "Text",
 CellChangeTimes->{{3.981754535837626*^9, 3.9817546433605423`*^9}, {
  3.981754963326601*^9, 3.981754967779818*^9}, {3.982067914519125*^9, 
