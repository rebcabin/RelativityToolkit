Cell[TextData[{
 "Lie Group ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "66724147-ec34-4d1e-93af-4bcf823e4e18"]
}], "Subsection",
 CellChangeTimes->{{3.981303193151819*^9, 3.981303197363866*^9}, {
  3.9817283645810413`*^9, 
  3.981728366541459*^9}},ExpressionUUID->"0e870f51-0a43-4406-9b16-\
6b35ca166668"],

Cell[TextData[{
 "DEFINITION: The ",
 StyleBox["Lie Group",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", "U", 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "54904203-5682-4300-a17a-cb4991e90ebf"],
 " is the group of all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],ExpressionUUID->
  "8a4255be-a3ec-4af3-b68d-81746f3cb098"],
 " complex, unitary matrices with unit determinant. "
}], "Text",
 CellChangeTimes->{{3.9813032209087887`*^9, 3.981303246205957*^9}, {
   3.981303556041046*^9, 3.981303739410334*^9}, {3.981303788582028*^9, 
   3.9813038957755327`*^9}, {3.981304483775255*^9, 3.981304495236456*^9}, {
   3.9813054277416067`*^9, 3.9813055061136312`*^9}, 3.981305643113809*^9, {
