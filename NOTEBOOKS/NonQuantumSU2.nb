  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["Q", "\[FilledSmallCircle]"], "(", "t", ")"}], ".", 
    RowBox[{
     RowBox[{"Q", "(", "t", ")"}], "\[ConjugateTranspose]"}]}], 
   TraditionalForm]],ExpressionUUID->"3bfb7cec-ff69-443e-8f00-932ac1e45913"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "f2682b4f-549e-48a4-b514-d7e79270e286"],
 " is a smooth curve in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", "U", 
