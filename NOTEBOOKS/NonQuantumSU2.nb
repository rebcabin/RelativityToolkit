Cell[CellGroupData[{

Cell[TextData[{
 "Quaternions as a Coordinate Chart in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["S", "3"], "\[Subset]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "4"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b995655e-0a21-4679-8b93-95a1ee3ab94c"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "26f90aa4-f909-42bf-a13e-e8ced44a37a4"]
}], "Section",
 CellChangeTimes->{{3.981293416847962*^9, 3.981293422435145*^9}, {
  3.981294089438717*^9, 3.981294105377323*^9}, {3.981641198948497*^9, 
  3.981641218476536*^9}, {3.9816592048040953`*^9, 
  3.981659223386133*^9}},ExpressionUUID->"cc1acf28-f63a-424e-a4d1-\
663d21ec1b17"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "c8568257-fdf4-4078-bd57-c996456c1002"],
 " operators are faithfully represented by polynomials in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     SubscriptBox["\[DoubleStruckCapitalI]", "2"], "}"}], "\[Union]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], 
      OverscriptBox["\[Sigma]", "\[RightVector]"]}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"69fd9485-bd83-4463-90e0-21d27b8bf9ba"],
 ". The four ",
 StyleBox["real-valued coefficients",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["q", "0"], ",", 
     SubscriptBox["q", "1"], ",", 
     SubscriptBox["q", "2"], ",", 
     SubscriptBox["q", "3"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "54b4b77d-c98f-46d2-aec7-cf618e8c0718"],
 " are constrained to unit norm and constitute the components of a ",
 StyleBox["unit quaternion",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", aka a ",
 StyleBox["versor",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ":"
}], "Text",
 CellChangeTimes->{{3.981040819375476*^9, 3.9810409128740177`*^9}, {
   3.981041011477706*^9, 3.981041018432872*^9}, {3.981041401241703*^9, 
   3.9810414074333344`*^9}, {3.98104171546249*^9, 3.981041744206963*^9}, {
   3.9810440807170467`*^9, 3.981044172169879*^9}, {3.981044372758819*^9, 
   3.981044375413375*^9}, {3.981064663617475*^9, 3.981064665264268*^9}, {
   3.9810706748697367`*^9, 3.981070684878982*^9}, {3.981116346187948*^9, 
   3.981116639415704*^9}, {3.9812135475653057`*^9, 3.9812135600094*^9}, {
