Cell[TextData[{
 "Spot the X component, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", " ", "cos\[Theta]"}], "-", 
    RowBox[{"y", " ", "sin\[Theta]"}]}], TraditionalForm]],ExpressionUUID->
  "75a2d008-d549-46a9-ac6e-67c85e7bd24f"],
 ", of the new vector, as the real part of the ",
 StyleBox["\[LeftDoubleBracket]1,2", "Input"],
 "\[RightDoubleBracket] or the ",
 StyleBox["\[LeftDoubleBracket]2,1\[RightDoubleBracket]", "Input"],
 " component. Compare it with the intuited or memorized 2D rotation from \
school math to see that the new vector is, indeed, rotated by \[Theta] \
counterclockwise around the Z axis."
}], "Text",
 CellChangeTimes->{{3.981217681205143*^9, 3.9812177029618263`*^9}, {
  3.9812181378513937`*^9, 3.9812183079327717`*^9}, {3.982088479177367*^9, 
  3.982088535132381*^9}},ExpressionUUID->"214cc03d-b1c3-412e-ab34-\
c539da36bc06"],

Cell[TextData[{
 "Notice that the result of the rotation remains Hermitian and traceless for \
any real-vector state ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e39770f6-4a71-4d69-8551-af008dee3f1a"],
 ", thus a valid representation of the rotated state:"
}], "Text",
 CellChangeTimes->{{3.981710505649634*^9, 3.981710558256586*^9}, {
  3.98208856533153*^9, 
  3.9820885939542017`*^9}},ExpressionUUID->"04a1b2c0-9fc9-448b-b039-\
a3aca60c6f3d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"proof", "@", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Q", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", 
           FractionBox["\[Theta]", "2"], "]"}], "id"}], "-", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"Sin", "[", 
           FractionBox["\[Theta]", "2"], "]"}], 
          RowBox[{"\[Sigma]", "[", "3", "]"}]}]}]}], ",", 
       RowBox[{"r", "=", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], ".", "\[Sigma]Vec"}]}]}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"rPrime", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Q", ".", "r", ".", 
          RowBox[{"Q", "\[ConjugateTranspose]"}]}], "//", "Simplify"}], "//", 
        "ComplexExpand"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       StyleBox["HermitianQ",
        FontColor->RGBColor[0.14, 0.8, 0.14]], "[", "rPrime", "]"}], "&&", 
      RowBox[{
       StyleBox["TracelessQ",
        FontColor->RGBColor[0.14, 0.8, 0.14]], "[", "rPrime", "]"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.981710395573029*^9, 3.981710464145754*^9}, {
  3.981710496484748*^9, 3.981710501310721*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"c471c664-5da3-4318-b5c9-2f88733c8172"],

