Cell[CellGroupData[{

Cell[TextData[{
 "Chapter III: Geodesic Equations of Motion in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "130be8c8-8f97-4e45-b382-e3808e341972"]
}], "Chapter",
 CellChangeTimes->{{3.981726754583912*^9, 3.981726766004616*^9}, {
  3.981733817718306*^9, 3.981733836711075*^9}, {3.982076404116096*^9, 
  3.982076406504784*^9}},ExpressionUUID->"9efac54e-11eb-40b7-976c-\
c93039d9333c"],

Cell[TextData[{
 "Here we solve directly for the geodesics of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "c5098bdb-b96e-4742-8c0f-87a9422cf953"],
 " with kinetic energy as the metric tensor, in a manner mirroring the same \
derivation in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "e8a85c64-a70c-4e0e-a757-27516c9b3492"],
 ". These geodesics represent all trajectories of our baton as an inverted \
spherical pendulum (no spin) and as a symmetrical top (non-zero spin)."
}], "Text",
 CellChangeTimes->{{3.982076391985825*^9, 3.98207649410787*^9}, {
   3.9821554688851748`*^9, 3.982155484251336*^9}, 
   3.982157804436739*^9},ExpressionUUID->"7a0f56fd-5524-4711-9230-\
ef134796d640"],

Cell[CellGroupData[{

Cell["Geometric Approach", "Section",
 CellChangeTimes->{{3.981754376278401*^9, 
  3.981754381403055*^9}},ExpressionUUID->"edab178b-aeaf-4fd7-9606-\
a87865302ed9"],

Cell[TextData[{
 "The thing to appreciate here is the brevity, regularity, and parallelism to \
our previous development in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "0c727311-5185-4203-8df2-a3a53bb288dc"],
 ". We have added some explanatory headlines and prose, plus TODO markers for \
future analysis, but the sketch is the same: "
}], "Text",
 CellChangeTimes->{{3.98175575517973*^9, 3.981755816196704*^9}, {
  3.982027733468192*^9, 3.9820277368949547`*^9}, {3.9820668024612923`*^9, 
  3.982066911496191*^9}, {3.9820678162026663`*^9, 3.9820678415048447`*^9}, {
  3.9820688872226667`*^9, 
  3.9820689042641563`*^9}},ExpressionUUID->"2978cd75-a971-4f7b-b0f9-\
1d276f7a9c97"],

Cell["kinetic energy in the metric \[DoubleLongRightArrow]", "ItemNumbered",
 CellChangeTimes->{{3.98175575517973*^9, 3.981755816196704*^9}, {
  3.982027733468192*^9, 3.9820277368949547`*^9}, {3.9820668024612923`*^9, 
  3.98206693527525*^9}, {3.9820671917052193`*^9, 
  3.982067196200088*^9}},ExpressionUUID->"d8fc5836-9401-480d-84da-\
b95830b0c328"],

Cell["Christoffel symbols and the absolute derivative \
\[DoubleLongRightArrow]", "ItemNumbered",
 CellChangeTimes->{{3.98175575517973*^9, 3.981755816196704*^9}, {
  3.982027733468192*^9, 3.9820277368949547`*^9}, {3.9820668024612923`*^9, 
  3.982066962448138*^9}, {3.9820672062956057`*^9, 
  3.98206721073919*^9}},ExpressionUUID->"1bb5ff97-0f66-4a9b-8a4c-\
b8228215101f"],

Cell["\<\
direct potential energy in contravariant form (outside the metric) \
\[DoubleLongRightArrow]\
\>", "ItemNumbered",
 CellChangeTimes->{{3.98175575517973*^9, 3.981755816196704*^9}, {
  3.982027733468192*^9, 3.9820277368949547`*^9}, {3.9820668024612923`*^9, 
  3.9820669245762033`*^9}, {3.982066965116007*^9, 3.982066974190489*^9}, {
  3.9820672140231657`*^9, 
  3.9820672146200438`*^9}},ExpressionUUID->"fda7e883-debb-42cb-a580-\
824283ca5c77"],

Cell["equations of motion (eqns4) \[DoubleLongRightArrow]", "ItemNumbered",
 CellChangeTimes->{{3.9820670050158787`*^9, 3.982067019569455*^9}, {
  3.982067218171463*^9, 
  3.9820672189269333`*^9}},ExpressionUUID->"37fd9286-ffff-4d7f-a8d7-\
03a8cfe6b900"],

Cell["numerical solutions, manipulable plots and animations.", "ItemNumbered",
 CellChangeTimes->{{3.982067021477985*^9, 3.9820670262831173`*^9}, {
   3.9820672265630617`*^9, 3.9820672341962748`*^9}, 
   3.982155521437337*^9},ExpressionUUID->"9ed67c8f-d3ab-45cf-b1b6-\
f36932f8eacd"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "6fd22bb6-eba8-4c09-9ce1-3275a6489f64"],
 ", the equations and solution were automatically constrained to the curved \
surface of the manifold via trigonometric functions. In ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "b9b2f90c-c567-4baf-954f-db201c243888"],
 ", we must explicitly constrain the equations and solutions to adhere to the \
manifold by insisting that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"Q", "(", "t", ")"}], ".", 
     RowBox[{
      RowBox[{"Q", "(", "t", ")"}], "\[ConjugateTranspose]"}]}], "=", "1"}], 
   TraditionalForm]],ExpressionUUID->"11be1b95-e57c-4471-8b6b-3287698a12ac"],
 ", both algebraically, by static rules, and dynamically, via a Lagrange \
multiplier. This addition to the contravariant force term is the only \
deviation from the sketch of \[OpenCurlyDoubleQuote]pure geodesics on \
manifolds.\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{3.982066984733038*^9, 3.9820669921681423`*^9}, {
  3.982067055112726*^9, 3.982067180530673*^9}, {3.982067243580497*^9, 
  3.982067277444687*^9}, {3.982067872093165*^9, 3.982067899878262*^9}, {
  3.982155544951282*^9, 
