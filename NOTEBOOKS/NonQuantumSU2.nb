Cell[CellGroupData[{

Cell["Absolute Derivative Term", "Subsection",
 CellChangeTimes->{{3.9820292046649027`*^9, 
  3.982029211286502*^9}},ExpressionUUID->"41585aa3-dd9b-43f6-a006-\
fa4ed5d16acc"],

Cell[TextData[{
 "While the connection is symbolic, without explicit time dependence, ",
 StyleBox["AbsoluteDerivativeFromConnectionIndexer", "Input"],
 " implicitly injects such time-dependence; it is needed for numerical work. \
Time injection at this phase is also a feature of our ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "557e257b-f4f6-40a8-ba2d-ef2a57702053"],
 " development:"
}], "Text",
 CellChangeTimes->{{3.9820682508128653`*^9, 3.982068294559722*^9}, {
  3.982068325350655*^9, 3.982068364143227*^9}, {3.982155715728374*^9, 
  3.982155750064876*^9}},ExpressionUUID->"05a0f917-2264-46d4-b9ba-\
99b9930b6c01"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"v4", "  ", "=", " ", 
   RowBox[{"MakeIndexer", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"c", " ", "|->", " ", 
        RowBox[{
         RowBox[{"c", "'"}], "[", "t", "]"}]}], ")"}], " ", "/@", " ", 
      "coords4"}], ",", " ", "coords4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ad4", " ", "=", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"AbsoluteDerivativeFromConnectionIndexer", "[", 
      RowBox[{
      "v4", ",", " ", "\[CapitalGamma]4red", ",", " ", "t", ",", " ", 
       "coords4"}], "]"}], "//", "FullSimplify"}], ")"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.981755043092327*^9, 3.9817550658800898`*^9}, {
   3.981755112394432*^9, 3.9817551486656313`*^9}, 3.981803392919306*^9, 
   3.981805749806326*^9, 3.9818065284612293`*^9, {3.982028426030566*^9, 
