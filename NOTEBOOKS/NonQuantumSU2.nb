Cell[TextData[StyleBox["Therefore, the Pauli matrices, as unitary operators, \
are reflections. Every rotation in 3D is a sequence of two reflections (TODO: \
elaborate)",
 FontSlant->"Italic"]], "Subitem",
 CellChangeTimes->{{3.9816250729641*^9, 3.9816251005049067`*^9}, {
  3.981625246817177*^9, 3.9816252611526737`*^9}, {3.981751602967187*^9, 
