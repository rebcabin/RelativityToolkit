              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"q0", "'"}], "[", "0", "]"}], "==", 
               RowBox[{
                RowBox[{"1", "/", "2"}], " ", 
                RowBox[{"Tr", "[", "dQ0Matrix", "]"}]}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"q1", "'"}], "[", "0", "]"}], "==", 
