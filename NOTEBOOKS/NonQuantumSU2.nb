 CellLabel->"In[82]:=",ExpressionUUID->"868defae-411d-4cb8-87e2-b7d867012af3"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Potential Energy in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "451ceb8b-36fd-4315-985c-5fcdb1b2c0b5"]
}], "Subsection",
