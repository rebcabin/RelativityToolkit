RWAaADqN14I=
  "],ExpressionUUID->"302c2c08-e22f-4511-b81b-2ea89d4544c6"],

Cell[TextData[{
 StyleBox["The unit-norm constraint ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       SubscriptBox["q", "0"], "2"], "+", 
      SuperscriptBox[
       SubscriptBox["q", "1"], "2"], "+", 
      SuperscriptBox[
       SubscriptBox["q", "2"], "2"], "+", 
      SuperscriptBox[
       SubscriptBox["q", "3"], "2"]}], "=", "1"}], ")"}], TraditionalForm]],
  ExpressionUUID->"e5376568-d826-4887-ad48-7ae3b9179ccc"],
 StyleBox[" means that the four coefficients are confined to the 3\[NoBreak]-\
\[NoBreak]sphere,",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["S", "3"], "\[Subset]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "4"]}], TraditionalForm]],
  ExpressionUUID->"10e29f4d-4b64-46c5-81b3-33d6fd30b96d"],
 StyleBox[", just as in 3 dimensions, where the constraint ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["x", "2"], "+", 
      SuperscriptBox["y", "2"], "+", 
      SuperscriptBox["z", "2"]}], "=", "1"}], ")"}], TraditionalForm]],
  ExpressionUUID->"a273ce52-43e8-4fec-8c5b-7b4141bef219"],
 StyleBox[" confines ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"x", ",", "y", ",", "z"}], ")"}], TraditionalForm]],
  ExpressionUUID->"3226261e-3356-4c19-aa71-d6e8ff64cdc2"],
 StyleBox[" to the 2\[NoBreak]-\[NoBreak]sphere, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["S", "2"], "\[Subset]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "3"]}], TraditionalForm]],
  ExpressionUUID->"ad4ac9e2-a487-4c3f-acfe-4ab50dd68c52"],
 "."
}], "Item",
 CellChangeTimes->{{3.981659947989614*^9, 3.981660174205065*^9}, {
  3.981660628338442*^9, 3.981660630524556*^9}, {3.982155140278507*^9, 
  3.982155161219639*^9}},ExpressionUUID->"3429561c-5c16-45c1-92c1-\
907d643a346c"],

Cell[TextData[{
 StyleBox["We identify elements of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "019ae8e7-71ea-4105-8ca2-3f33d63496d2"],
 StyleBox[" with their quaternion coordinate representations, writing Q for \
either.",
  FontSlant->"Italic"],
 " "
}], "Item",
