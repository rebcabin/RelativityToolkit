Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"proof", "@", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Q", ",", "Qdot", ",", "X", ",", "Y"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"arbitrary", " ", "curve", " ", "in", " ", "SU", 
        RowBox[{"(", "2", ")"}]}], ";", " ", 
       RowBox[{"take", " ", "on", " ", "faith", " ", "for", " ", "now"}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Q", "[", "t_", "]"}], ":=", 
       RowBox[{"(", GridBox[{
          {
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], "+", 
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"y", "[", "t", "]"}]}]}], 
           RowBox[{
            RowBox[{"u", "[", "t", "]"}], "+", 
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"v", "[", "t", "]"}]}]}]},
          {
           RowBox[{
            RowBox[{"-", 
             RowBox[{"u", "[", "t", "]"}]}], "+", 
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"v", "[", "t", "]"}]}]}], 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], "-", 
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"y", "[", "t", "]"}]}]}]}
         }], ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Qdot", "[", "t_", "]"}], ":=", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Q", "[", "t", "]"}], ",", "t"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"X", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Q", "[", 
                  RowBox[{"s", "+", "t"}], "]"}], ".", 
                 RowBox[{
                  RowBox[{"Q", "[", "t", "]"}], "\[ConjugateTranspose]"}]}], ",",
                 "s"}], "]"}], "/.", 
              RowBox[{"s", "->", "0"}]}], ")"}], "//", "ComplexExpand"}]}], 
          ")"}], "//", "Short"}], 
        ",", "\"\<\!\(\*SubscriptBox[\(\[PartialD]\), \(s\)]\)(Q(t+s).Q(t)\
\[ConjugateTranspose])\!\(\*SubscriptBox[\(\[RightBracketingBar]\), \(s = \
0\)]\) :\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Y", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Qdot", "[", "t", "]"}], ".", 
              RowBox[{
               RowBox[{"Q", "[", "t", "]"}], "\[ConjugateTranspose]"}]}], 
             ")"}], "//", "ComplexExpand"}]}], ")"}], "//", "Short"}], 
        ",", "\"\<\!\(\*OverscriptBox[\(Q\), \
\(\[FilledSmallCircle]\)]\)(t).Q(t)\[ConjugateTranspose] :\>\""}], "]"}], ";",
       " ", "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{"X", "===", "Y"}], 
        ",", "\"\<\!\(\*SubscriptBox[\(\[PartialD]\), \(s\)]\)(Q(t+s).Q(t)\
\[ConjugateTranspose])\!\(\*SubscriptBox[\(\[RightBracketingBar]\), \(s = \
0\)]\) == \!\(\*OverscriptBox[\(Q\), \(\[FilledSmallCircle]\)]\)(t).Q(t)\
\[ConjugateTranspose] :\>\""}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.981564835411539*^9, 3.981564899778454*^9}, {
