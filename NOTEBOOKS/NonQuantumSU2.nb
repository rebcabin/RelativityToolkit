           RowBox[{"Tr", "[", "X", "]"}], ",", 
           RowBox[{"Assumptions", "->", "Dconstraint"}]}], "]"}]}], 
        ",", "\"\<Tr[X] :\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"tr", "===", "0"}]}]}], "]"}]}], ";"}]], "Input",
