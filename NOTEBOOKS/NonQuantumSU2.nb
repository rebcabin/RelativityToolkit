   3.98208781541322*^9}},ExpressionUUID->"bff7d6b7-9105-4fff-a0f0-\
b8b35587b2e3"],

Cell[TextData[{
 "Pauli matrices are also unitary, meaning that every Pauli matrix satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["\[Sigma]", "i"], "2"], "=", 
    SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], TraditionalForm]],
  ExpressionUUID->"1026ad40-9590-4dea-a852-2f99655f84b8"],
 " and that all eigenvalues have absolute value 1."
}], "Text",
 CellChangeTimes->{{3.9816250729641*^9, 3.9816251005049067`*^9}, {
   3.981625246817177*^9, 3.9816252611526737`*^9}, 3.981625346684925*^9, {
   3.9817325917865047`*^9, 
   3.9817326056137047`*^9}},ExpressionUUID->"d6b630af-a07c-4a56-8602-\
b42ce13668c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"proof", "@", 
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"And", "@@", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["UnitaryQ",
         FontColor->RGBColor[0.14, 0.8, 0.14]], "/@", "\[Sigma]Vec"}], 
       ")"}]}], ",", "\"\<Pauli matrices are Unitary :\>\""}], "]"}]}], 
  ";"}]], "Input",
