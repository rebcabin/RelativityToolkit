Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Take", " ", "the", " ", "2", "nd", " ", "time", " ", "derivative", " ", 
    "of", " ", "the", " ", "constraint"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"constraintEqn2", "=", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"q0", "[", "t", "]"}], "^", "2"}], "+", 
         RowBox[{
          RowBox[{"q1", "[", "t", "]"}], "^", "2"}], "+", 
         RowBox[{
          RowBox[{"q2", "[", "t", "]"}], "^", "2"}], "+", 
         RowBox[{
          RowBox[{"q3", "[", "t", "]"}], "^", "2"}], "-", "1"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "==", "0"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Solve", " ", "for", " ", "the", " ", "highest", " ", "derivatives", " ", 
     "and", " ", "the", " ", "constraint", " ", "force"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"stateVars", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"q0", "''"}], "[", "t", "]"}], ",", 
       RowBox[{
        RowBox[{"q1", "''"}], "[", "t", "]"}], ",", 
       RowBox[{
        RowBox[{"q2", "''"}], "[", "t", "]"}], ",", 
       RowBox[{
        RowBox[{"q3", "''"}], "[", "t", "]"}], ",", 
       RowBox[{"\[Lambda]", "[", "t", "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pureODEsLA", "=", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{"su2Eqns", ",", "constraintEqn2"}], "]"}], ",", 
        "stateVars"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.982076724065658*^9, 3.982076725671481*^9}, {
  3.9820768588721247`*^9, 3.982076864910091*^9}, {3.982076898372882*^9, 
