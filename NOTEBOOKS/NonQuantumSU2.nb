Cell[BoxData[{
 FormBox[
  RowBox[{
   RowBox[{"det", 
    RowBox[{"(", 
     RowBox[{"Q", 
      RowBox[{"(", "t", ")"}]}], ")"}]}], "=", "1"}], TraditionalForm], "\[LineSeparator]", 
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["\[DifferentialD]", 
      RowBox[{"\[DifferentialD]", "t"}]], "det"}], 
    RowBox[{"(", 
     RowBox[{"Q", 
      RowBox[{"(", "t", ")"}]}], ")"}]}], "=", "0"}], TraditionalForm], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["\[DifferentialD]", 
      RowBox[{"\[DifferentialD]", "t"}]], "det"}], 
    RowBox[{"(", 
     RowBox[{"Q", 
      RowBox[{"(", "t", ")"}]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"det", 
        RowBox[{"(", 
         RowBox[{"Q", 
          RowBox[{"(", "t", ")"}]}], ")"}]}], "=", "1"}], ")"}], "\[CenterDot]",
      "Tr"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["Q", 
        RowBox[{" ", 
         RowBox[{"-", "1"}]}]], 
       RowBox[{
        RowBox[{"(", "t", ")"}], ".", 
        OverscriptBox["Q", "\[FilledSmallCircle]"]}], 
       RowBox[{"(", "t", ")"}]}], "=", 
      RowBox[{"Q", 
       RowBox[{
        RowBox[{
         RowBox[{"(", "t", ")"}], "\[ConjugateTranspose]"}], ".", 
        OverscriptBox["Q", "\[FilledSmallCircle]"]}], 
       RowBox[{"(", "t", ")"}]}]}], ")"}]}]}], TraditionalForm], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[DoubleLongRightArrow]", " ", "Tr"}], 
    RowBox[{"(", 
     RowBox[{"Q", 
      RowBox[{
       RowBox[{
        RowBox[{"(", "t", ")"}], "\[ConjugateTranspose]"}], ".", 
       OverscriptBox["Q", "\[FilledSmallCircle]"]}], 
      RowBox[{"(", "t", ")"}]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{"Tr", "(", 
     RowBox[{
      RowBox[{
       OverscriptBox["Q", "\[FilledSmallCircle]"], 
       RowBox[{
        RowBox[{"(", "t", ")"}], ".", "Q"}], 
       RowBox[{
        RowBox[{"(", "t", ")"}], "\[ConjugateTranspose]"}]}], "\[Element]", 
      RowBox[{"\[GothicS]\[GothicU]", 
       RowBox[{"(", "2", ")"}]}]}], ")"}], "=", "0"}]}], 
  TraditionalForm]}], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.981415835386568*^9, 3.981415969587615*^9}, {
  3.981416963796825*^9, 3.981416981055376*^9}, {3.981417034400545*^9, 
