f0626cac1018"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"VSU2", " ", "=", " ", 
    RowBox[{"m", " ", "g", " ", "cz", " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["q0", "2"], " ", "-", " ", 
       SuperscriptBox["q1", "2"], " ", "-", " ", 
       SuperscriptBox["q2", "2"], " ", "+", " ", 
       SuperscriptBox["q3", "2"]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"add", " ", "time"}], "-", 
     RowBox[{"dependent", " ", "normalization", " ", "Q", 
      RowBox[{
       RowBox[{"(", "t", ")"}], ".", "Q"}], 
      RowBox[{
       RowBox[{"(", "t", ")"}], "\[ConjugateTranspose]"}]}]}], " ", "\[Rule]",
     " ", "1"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"pf4", " ", "=", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"PotentialScalarFieldFromMetricIndexer", "[", 
        RowBox[{"VSU2", ",", " ", "ig4", ",", " ", "t", ",", " ", "coords4"}],
         "]"}], " ", "//.", " ", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"q0", "[", "t", "]"}], "2"], "+", 
          SuperscriptBox[
           RowBox[{"q1", "[", "t", "]"}], "2"], "+", 
          SuperscriptBox[
           RowBox[{"q2", "[", "t", "]"}], "2"], "+", 
          SuperscriptBox[
           RowBox[{"q3", "[", "t", "]"}], "2"]}], " ", "->", " ", "1"}], 
        "}"}]}], ")"}], "//", "FullSimplify"}], ")"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.981755043092327*^9, 3.9817550658800898`*^9}, {
   3.981755112394432*^9, 3.981755156005752*^9}, {3.9817554343761873`*^9, 
   3.981755464481791*^9}, {3.981804494136684*^9, 3.981804504645688*^9}, 
