Cell[CellGroupData[{

Cell["Contravariant Constraint Force Vector", "Subsection",
 CellChangeTimes->{{3.9820666590711803`*^9, 
  3.9820666735402*^9}},ExpressionUUID->"c0b0edfd-8626-44b0-8f82-43956241a945"],

Cell[TextData[{
 "Forces are usually covariant. However, we are leaving constraint forces out \
of the metric, just as we did for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "0054de8c-55bc-4d98-b8f2-bad82feebd6c"],
 ", so that we can have Newtonian time. Because the absolute derivative is \
contravariant, and because we convert the potential field gradient into \
contravariant form via the inverse metric, we must do likewise with the \
Lagrangian constraint force. Here is its contravariant form, again without \
analysis for brevity (TODO)."
}], "Text",
 CellChangeTimes->{{3.982066681083681*^9, 3.982066791011066*^9}, {
  3.982068425054426*^9, 3.9820685496582603`*^9}, {3.9821557841937733`*^9, 
  3.982155788490883*^9}, {3.982158089680274*^9, 
  3.982158104571084*^9}},ExpressionUUID->"4bf7488b-bda1-4dbe-b695-\
eb8fb44ae61b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"lagrangeMultiplier", " ", "=", " ", 
    RowBox[{"\[Lambda]", "[", "t", "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "cn4", " ", "is", " ", "the", " ", "contravariant", " ", "constraint", " ",
     "force", " ", "vector"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"cn4", " ", "=", " ", 
   RowBox[{"lagrangeMultiplier", " ", "*", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"q0", "[", "t", "]"}], ",", " ", 
      RowBox[{"q1", "[", "t", "]"}], ",", " ", 
      RowBox[{"q2", "[", "t", "]"}], ",", " ", 
      RowBox[{"q3", "[", "t", "]"}]}], "}"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9820685702354383`*^9, 3.9820686123064413`*^9}},
 CellLabel->"In[86]:=",ExpressionUUID->"2198a4a2-04cc-43d2-aa77-a9865b552b3f"]
}, Open  ]],

