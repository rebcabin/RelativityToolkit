Cell[CellGroupData[{

Cell["Christoffel Connection with Quaternion Normalization", "Subsection",
 CellChangeTimes->{{3.981755043092327*^9, 3.9817550658800898`*^9}, {
  3.981755112394432*^9, 3.981755138189787*^9}, {3.981755649538891*^9, 
