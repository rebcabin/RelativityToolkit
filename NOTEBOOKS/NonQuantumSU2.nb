Cell[TextData[{
 "Any traceless, anti-Hermitian matrix\[LongDash]member of \[GothicS]\
\[GothicU](2)\[LongDash]can be expanded in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    OverscriptBox["\[Sigma]", "\[RightVector]"]}], TraditionalForm]],
  ExpressionUUID->"aaee2063-cfda-44db-bc26-8d211e667351"],
 ":"
}], "Text",
 CellChangeTimes->{{3.981641859166266*^9, 3.981641864632865*^9}, {
   3.981642270691389*^9, 3.98164229835917*^9}, {3.98164296766105*^9, 
   3.9816429886833963`*^9}, 3.981643422478459*^9, {3.981660387220112*^9, 
   3.9816603884292192`*^9}, {3.981752462070138*^9, 3.9817524646168528`*^9}, {
   3.981752689084598*^9, 
   3.981752722345502*^9}},ExpressionUUID->"ea4a315f-dbc1-4447-86fe-\
a569614e5c85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"proof", "@", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"A", ",", "basis", ",", "coeffs"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"arbitrary", " ", "traceless"}], ",", " ", 
       RowBox[{"anti", "-", 
        RowBox[{"Hermitian", " ", "matrix"}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{"A", "=", 
       RowBox[{"(", GridBox[{
          {
           RowBox[{"\[ImaginaryI]", " ", "w"}], 
           RowBox[{"u", "+", 
            RowBox[{"\[ImaginaryI]", " ", "v"}]}]},
          {
           RowBox[{"-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"u", "+", 
               RowBox[{"\[ImaginaryI]", " ", "v"}]}], ")"}], 
             "\[Conjugate]"}]}], 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "w"}]}
         }], ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"basis", "=", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Sigma]Vec"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "solve", " ", "for", " ", "these", " ", "coefficients", " ", "in", " ",
          "the"}], " ", "-", 
        RowBox[{"\[ImaginaryI]", "\[VeryThinSpace]", 
         OverscriptBox["\[Sigma]", "\[RightVector]"], " ", "basis"}]}], " ", 
       "*)"}], " ", "\[IndentingNewLine]", 
      RowBox[{"coeffs", "=", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"coeffs", ".", "basis"}], "==", "A"}], ",", "coeffs", ",", 
          
          RowBox[{"Assumptions", "->", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"u", ",", "v", ",", "w"}], "}"}], "\[Element]", 
            "Reals"}]}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "===", "\[IndentingNewLine]", 
       RowBox[{"Echo", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x", "->", 
            RowBox[{"-", "v"}]}], ",", 
           RowBox[{"y", "->", 
            RowBox[{"-", "u"}]}], ",", 
           RowBox[{"z", "->", 
            RowBox[{"-", "w"}]}]}], "}"}], ",", 
         "\[IndentingNewLine]", "\"\<Coefficients of expansion for any \
traceless, anti-Hermitian matrix :\>\""}], "]"}]}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.98164220298578*^9, 3.981642268444078*^9}, {
  3.981642315391601*^9, 3.981642467710606*^9}, {3.9816425452652273`*^9, 
  3.981642611057103*^9}, {3.981642663299241*^9, 3.981642682700302*^9}, {
  3.9816427193890142`*^9, 3.981642940475355*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"b7d1b6b2-e98e-4cb3-96da-dcf612989d80"],

