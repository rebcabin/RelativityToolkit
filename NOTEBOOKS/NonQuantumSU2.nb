Cell[CellGroupData[{

Cell[TextData[{
 "Side-by-Side Interactive Animation in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "7112ed6f-c420-4f32-80a5-65c82ca1dc7e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "3eb30f57-b112-45da-a771-310ccfca8d04"]
}], "Section",
 CellChangeTimes->{{3.982072477585906*^9, 3.9820725235152073`*^9}, 
   3.9820736195193167`*^9},ExpressionUUID->"d57901c3-9f1c-4719-a542-\
15de2f228d99"],

Cell[TextData[{
 "Aside from negligible differences in energy and angular momentum, the \
solutions appear identical for all settings of the sliders, with one \
exception. ",
 StyleBox["Slide the ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "0"], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"572dd705-3f41-4e46-9599-bcb080c3beb2"],
 StyleBox[" slider all the way to the right\[LongDash]",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Delta]", "0"], "=", 
    RowBox[{"90", "\[Degree]"}]}], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"42dc3102-b981-4e57-afb3-3a6dd8ae42f6"],
 ", and the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "a4355627-b13b-45d4-bb68-c1419249a8c6"],
 " solution fails completely with a ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Sec", "[", "\[Delta]", "]"}], "=", 
    FormBox["ComplexInfinity",
     TraditionalForm]}], TraditionalForm]],ExpressionUUID->
  "1ac52cfa-3ffa-46b9-b9d5-f6eaf60218b3"],
 ", while the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "634805bf-15e5-4757-9752-25fd2ca5a87e"],
 " solution proceeds normally. ",
 StyleBox["This is the main result of this notebook: no poles in ",
  FontWeight->"Bold",
  FontColor->RGBColor[0.98, 0.56, 0.17]],
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FontWeight->"Bold",
  FontColor->RGBColor[0.98, 0.56, 0.17],ExpressionUUID->
  "32df9bc9-cb33-4813-81c3-390ecca70cca"],
 StyleBox["!",
  FontWeight->"Bold",
  FontColor->RGBColor[0.98, 0.56, 0.17]]
}], "Text",
 CellChangeTimes->{{3.982089545285163*^9, 3.98208958053659*^9}, {
  3.9820896105669193`*^9, 3.9820898303675957`*^9}, {3.9821561001435127`*^9, 
  3.982156102892149*^9}},ExpressionUUID->"308363a8-f39f-4721-ae42-\
5530ad89736f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"interactiveSideBySideAnimation", "[", "su2ODEs_", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"epsilon", "=", "0.0001"}], ",", 
       RowBox[{"h", "=", 
        RowBox[{"1", "/", "15."}]}], ",", 
       RowBox[{"w", "=", 
        RowBox[{"1", "/", "4."}]}], ",", 
       RowBox[{"vu", "=", "3."}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ztxt", "=", 
        RowBox[{"-", "1.5"}]}], ",", 
       RowBox[{"xtxt", "=", "0"}], ",", 
       RowBox[{"ytxt", "=", 
        RowBox[{"-", "2"}]}], ",", 
       RowBox[{"znl", "=", "0.3"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"kart", "=", 
        RowBox[{"Cuboid", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "w"}], ",", 
            RowBox[{"-", "w"}], ",", "epsilon"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"w", ",", "w", ",", 
            RowBox[{"epsilon", "+", "h"}]}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"floor", "=", 
        RowBox[{"Polygon", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "vu"}], ",", 
             RowBox[{"-", "vu"}], ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"vu", ",", 
             RowBox[{"-", "vu"}], ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"vu", ",", "vu", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "vu"}], ",", "vu", ",", "0"}], "}"}]}], "}"}], 
         "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"axisLabelStyle", "=", 
        RowBox[{"text", "|->", 
         RowBox[{"Style", "[", 
          RowBox[{"text", ",", "Red", ",", "Bold", ",", "18", ",", 
           RowBox[{"FontFamily", "->", "\"\<Courier New\>\""}]}], "]"}]}]}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"cb", "=", 
        RowBox[{"rig", "[", "\"\<cb\>\"", "]"}]}], ",", 
       RowBox[{"thin", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", ".001"}], "}"}]}], ",", 
       RowBox[{"s", "=", "2"}], ",", 
       RowBox[{"o", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c3", "=", 
        RowBox[{"Cylinder", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"o", ",", "thin"}], "}"}], ",", 
          RowBox[{"s", " ", 
           RowBox[{"cb", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"b3", "=", 
        RowBox[{"Sphere", "[", 
         RowBox[{"o", ",", 
          RowBox[{"s", " ", 
           RowBox[{"cb", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"t3x", "=", 
        RowBox[{"Tube", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "s"}], " ", 
             RowBox[{"cb", "[", 
              RowBox[{"[", "3", "]"}], "]"}], " ", "e2"}], ",", 
            RowBox[{"s", " ", 
             RowBox[{"cb", "[", 
              RowBox[{"[", "3", "]"}], "]"}], " ", "e2"}]}], "}"}], ",", 
          ".01"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"DynamicModule", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"SO", 
            RowBox[{"(", "3", ")"}], " ", "Variables"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
          "ics3", ",", "\[Delta]x", ",", "\[Eta]x", ",", "\[Psi]x", ",", 
           "D\[Delta]x", ",", "D\[Eta]x", ",", "D\[Psi]x", ",", "soln3", ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"SU", 
             RowBox[{"(", "2", ")"}], " ", "Variables"}], "*)"}], 
           "\[IndentingNewLine]", "Q\[Eta]", ",", "Q\[Delta]", ",", 
           "Q0Matrix", ",", "OmegaBody0", ",", "dQ0Matrix", ",", "icsSU2", ",",
            "\[IndentingNewLine]", "q0x", ",", "q1x", ",", "q2x", ",", "q3x", 
           ",", "Dq0x", ",", "Dq1x", ",", "Dq2x", ",", "Dq3x", ",", "solnSU2",
            ",", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Shared", " ", "Variables"}], "*)"}], 
           "\[IndentingNewLine]", "numRules"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"numRules", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"m", "->", "1"}], ",", 
             RowBox[{"cz", "->", "1.2"}], ",", 
             RowBox[{"I1", "->", 
              SuperscriptBox["1.2", "2"]}], ",", 
             RowBox[{"I3", "->", 
              RowBox[{"rI31", "*", 
               SuperscriptBox["1.2", "2"]}]}]}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"Run", " ", "SO", 
            RowBox[{"(", "3", ")"}], " ", "Solver"}], 
           "                         ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"ics3", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Delta]", "[", "0", "]"}], "==", "\[Delta]0"}], ",", 
             RowBox[{
              RowBox[{"\[Eta]", "[", "0", "]"}], "==", "\[Eta]0"}], ",", 
             RowBox[{
              RowBox[{"\[Psi]", "[", "0", "]"}], "==", "0"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Delta]", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Eta]", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Psi]", "'"}], "[", "0", "]"}], "==", "D\[Psi]0"}]}],
             "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"soln3", "=", 
           RowBox[{"NDSolve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Append", "[", 
               RowBox[{"eqns3", ",", "ics3"}], "]"}], "//.", "numRules"}], ",",
              "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"\[Delta]", "[", "t", "]"}], ",", 
               RowBox[{"\[Eta]", "[", "t", "]"}], ",", 
               RowBox[{"\[Psi]", "[", "t", "]"}], ",", 
               RowBox[{
                RowBox[{"\[Delta]", "'"}], "[", "t", "]"}], ",", 
               RowBox[{
                RowBox[{"\[Eta]", "'"}], "[", "t", "]"}], ",", 
               RowBox[{
                RowBox[{"\[Psi]", "'"}], "[", "t", "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "0", ",", "tLim"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"\[Delta]x", "=", 
           RowBox[{"soln3", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
          RowBox[{"D\[Delta]x", "=", 
           RowBox[{"soln3", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "4", ",", "2"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"\[Eta]x", "=", 
           RowBox[{"soln3", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2", ",", "2"}], "]"}], "]"}]}], ";", 
          RowBox[{"D\[Eta]x", "=", 
           RowBox[{"soln3", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "5", ",", "2"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"\[Psi]x", "=", 
           RowBox[{"soln3", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "3", ",", "2"}], "]"}], "]"}]}], ";", 
          RowBox[{"D\[Psi]x", "=", 
           RowBox[{"soln3", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "6", ",", "2"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"Run", " ", "SU", 
            RowBox[{"(", "2", ")"}], " ", "Solver"}], 
           "                         ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Q\[Eta]", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Cos", "[", 
              RowBox[{"\[Eta]0", "/", "2"}], "]"}], " ", "id"}], "-", 
            RowBox[{"I", " ", 
             RowBox[{"Sin", "[", 
              RowBox[{"\[Eta]0", "/", "2"}], "]"}], " ", 
             RowBox[{"\[Sigma]", "[", "1", "]"}]}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Q\[Delta]", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Cos", "[", 
              RowBox[{"\[Delta]0", "/", "2"}], "]"}], " ", "id"}], "-", 
            RowBox[{"I", " ", 
             RowBox[{"Sin", "[", 
              RowBox[{"\[Delta]0", "/", "2"}], "]"}], " ", 
             RowBox[{"\[Sigma]", "[", "2", "]"}]}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Q0Matrix", "=", 
           RowBox[{"Q\[Eta]", ".", "Q\[Delta]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"OmegaBody0", "=", 
           RowBox[{"D\[Psi]0", "*", 
