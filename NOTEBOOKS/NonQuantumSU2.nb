Cell[CellGroupData[{

Cell["Derivation of Angular Velocity in the 4D Basis", "Section",
 CellChangeTimes->{{3.981756037555703*^9, 3.981756049775856*^9}, {
  3.981756662796584*^9, 
  3.9817566765930157`*^9}},ExpressionUUID->"ec9d303b-6b56-40a9-940a-\
53634002338e"],

Cell["\<\
This is a derivation of the particular convention we need for physics: the \
body frame. It justifies the definition of \[Omega] above.\
\>", "Text",
 CellChangeTimes->{{3.982155924134467*^9, 
  3.982155958323225*^9}},ExpressionUUID->"79e77907-5861-4dcb-88dd-\
73431b6e2e0b"],

Cell[TextData[{
 StyleBox["IMPORTANT",
  FontWeight->"Bold",
  FontColor->RGBColor[0.98, 0.56, 0.17]],
 ": In Chapter II, we defined ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0124eae2-0979-40fa-a1e5-473ab566d2ce"],
 " using the space-fixed (spatial) angular velocity, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[Omega]", "\[RightVector]"], "S"], TraditionalForm]],
  ExpressionUUID->"c6b50c8f-be2b-4efe-9bdb-a1f376fa4902"],
 ", corresponding to the right-invariant group transport ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["Q", "\[FilledSmallCircle]"], ".", 
    RowBox[{"Q", "\[ConjugateTranspose]"}]}], TraditionalForm]],
  ExpressionUUID->"c536e2b1-b653-405c-907d-8d5e58e5669b"],
 ". This is the standard starting point for proving that the algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", 
    RowBox[{"(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "1b544d9b-5bd2-4ae2-bd41-3b67eaa21751"],
 " consists of traceless, anti-Hermitian matrices. However, for dynamics of \
the pendulum or top, we must switch to the body-fixed angular velocity, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[Omega]", "\[RightVector]"], "B"], TraditionalForm]],
  ExpressionUUID->"fcffe4cb-fac7-44d9-baac-2874aa88a2cc"],
 ", corresponding to the left-invariant group transport, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Q", "\[ConjugateTranspose]"}], ".", 
    OverscriptBox["Q", "\[FilledSmallCircle]"]}], TraditionalForm]],
  ExpressionUUID->"63d34bc5-c1b1-4a27-9c4e-7465469aa4f9"],
 ", because the moments of inertia ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "1"], TraditionalForm]],ExpressionUUID->
  "c4d85dfb-c35c-42eb-8b60-58e23c04f7c8"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "3"], TraditionalForm]],ExpressionUUID->
  "b8db9a43-732e-4942-8b60-7c4a7aef9970"],
 " are constant only in this co-rotating frame. Only the body frame ensures \
that the metric remains constant and the equations of motion describe pure \
geodesics. "
}], "Text",
 CellChangeTimes->{{3.982105199501075*^9, 3.982105547680347*^9}, {
   3.9821056230683737`*^9, 3.982105645783165*^9}, {3.982105680597932*^9, 
   3.982105726939123*^9}, 3.982106017755918*^9, {3.982155966654173*^9, 
   3.9821560497563753`*^9}},ExpressionUUID->"90a1bb7a-0936-4549-b4da-\
ab42bc7aa1e0"],

Cell[TextData[{
 "Start from the fundamental relationship between the quaternion trajectory \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", 
    RowBox[{"(", "t", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "51792017-7d58-4660-a3b1-5815339480c3"],
 " and the body-fixed angular velocity matrix ",
 Cell[BoxData[
  FormBox["\[CapitalOmega]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "23df13b0-f85b-4885-b492-aac8cc10734e"],
 ":"
}], "Text",
 CellChangeTimes->{{3.982105576339129*^9, 
  3.982105582679718*^9}},ExpressionUUID->"41c86f87-eec6-40a5-9137-\
9e4dfe62785e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalOmega]", "\[Congruent]", 
    RowBox[{
     OverscriptBox["\[Omega]", "\[RightVector]"], ".", 
     OverscriptBox["\[Sigma]", "\[RightVector]"]}]}], "=", 
   RowBox[{"2", "\[ImaginaryI]", " ", 
    RowBox[{
     RowBox[{"Q", "\[ConjugateTranspose]"}], ".", 
     OverscriptBox["Q", "\[FilledSmallCircle]"]}], "    ", 
    RowBox[{"(", 
     RowBox[{"traceless", ",", " ", "Hermitian"}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.981756192518503*^9, 3.981756245255382*^9}, {
  3.981756590442671*^9, 3.981756590445755*^9}, {3.981756689324546*^9, 
  3.9817567052942867`*^9}, {3.9821057450979433`*^9, 
  3.9821057553258944`*^9}},ExpressionUUID->"18eb0788-dbab-437f-9a9f-\
b6ecf0521dcf"],

Cell["which follows from the exponential map", "Text",ExpressionUUID->"221c96aa-9572-4451-9ac5-c920bce006ff"],

Cell[BoxData[{
 FormBox[
  RowBox[{
   RowBox[{"Q", 
    RowBox[{"(", "t", ")"}]}], "=", 
   SuperscriptBox["e", 
    RowBox[{
     RowBox[{"-", "i"}], " ", "t", " ", 
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        OverscriptBox["\[Omega]", "\[RightVector]"], "\[FilledSmallCircle]", 
        OverscriptBox["\[Sigma]", "\[RightVector]"]}], "2"], ")"}]}]]}], 
  TraditionalForm], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["Q", "\[FilledSmallCircle]"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{"Q", "(", "t", ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], 
      FractionBox[
       RowBox[{
        OverscriptBox["\[Omega]", "\[RightVector]"], ".", 
        OverscriptBox["\[Sigma]", "\[RightVector]"]}], "2"]}], ")"}]}]}], 
  TraditionalForm], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"Q", "(", "t", ")"}], "\[ConjugateTranspose]"}], "=", 
   SuperscriptBox["e", 
    RowBox[{"i", " ", "t", " ", 
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        OverscriptBox["\[Omega]", "\[RightVector]"], "\[FilledSmallCircle]", 
        OverscriptBox["\[Sigma]", "\[RightVector]"]}], "2"], ")"}]}]]}], 
  TraditionalForm], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Q", "(", "t", ")"}], "\[ConjugateTranspose]"}], 
    RowBox[{
     OverscriptBox["Q", "\[FilledSmallCircle]"], "(", "t", ")"}]}], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"\[ImaginaryI]", "(", 
      FractionBox[
       RowBox[{
        OverscriptBox["\[Omega]", "\[RightVector]"], ".", 
        OverscriptBox["\[Sigma]", "\[RightVector]"]}], "2"], ")"}]}], "     ", 
    RowBox[{"(", 
     RowBox[{"in", " ", 
      RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}]}], ")"}]}]}], 
  TraditionalForm], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["\[Omega]", "\[RightVector]"], ".", 
    OverscriptBox["\[Sigma]", "\[RightVector]"]}], "=", 
   RowBox[{"2", "\[ImaginaryI]", " ", 
    RowBox[{"Q", "\[ConjugateTranspose]"}], 
    OverscriptBox["Q", "\[FilledSmallCircle]"], "    ", 
    RowBox[{"(", 
     RowBox[{"traceless", ",", " ", "Hermitian"}], ")"}]}]}], 
  TraditionalForm]}], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.981756349589128*^9, 3.98175665113766*^9}, {
  3.9821061549006653`*^9, 3.982106166480707*^9}, {3.9821062255989428`*^9, 
  3.9821062789505463`*^9}, {3.982106324304434*^9, 
  3.982106334588665*^9}},ExpressionUUID->"9e285e78-ff54-4eb0-b921-\
d2f62ef16ddb"],

Cell[TextData[{
 StyleBox["Note that the space-frame form, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["Q", "\[FilledSmallCircle]"], "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], 
       FractionBox[
        RowBox[{
         OverscriptBox["\[Omega]", "\[RightVector]"], ".", 
         OverscriptBox["\[Sigma]", "\[RightVector]"]}], "\[Placeholder]"]}], 
      ")"}], 
     RowBox[{"Q", "(", "t", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "a634c9e4-bf80-4bab-8dc7-02e0542cb5fc"],
 ", ",
 StyleBox[" is also true because",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], 
     FractionBox[
      RowBox[{
       OverscriptBox["\[Omega]", "\[RightVector]"], ".", 
       OverscriptBox["\[Sigma]", "\[RightVector]"]}], "\[Placeholder]"]}], 
    ")"}], TraditionalForm]],ExpressionUUID->
  "1a40d547-61c0-4d39-90a0-ebe166938b5e"],
 StyleBox[" is constant. We choose",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], 
     FractionBox[
      RowBox[{
       OverscriptBox["\[Omega]", "\[RightVector]"], ".", 
       OverscriptBox["\[Sigma]", "\[RightVector]"]}], "\[Placeholder]"]}], 
    ")"}], TraditionalForm]],ExpressionUUID->
  "b6cb3fdd-caf5-454c-b2f2-505125553d70"],
 " ",
 StyleBox["on the right to support derivations in the body frame.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.982107296937374*^9, 3.982107298898922*^9}, {
   3.98210734491649*^9, 3.982107557993535*^9}, 
   3.9821577809866333`*^9},ExpressionUUID->"99d346d8-85e2-4577-9b30-\
dd0ab832acd2"],

Cell[TextData[{
 "Given ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Q", "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["q", "0"], 
      SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], "-", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{
       RowBox[{
        OverscriptBox["q", "\[RightVector]"], "(", "t", ")"}], ".", 
       OverscriptBox["\[Sigma]", "\[RightVector]"]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"3b0bcee2-41a2-48ff-88ee-6275be8b7010"],
 " and its time derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["Q", "\[FilledSmallCircle]"], "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["q", "0"], 
      SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], "-", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{
       RowBox[{
        StyleBox[
         OverscriptBox[
          StyleBox[
           OverscriptBox["q", "\[FilledSmallCircle]"], "Text"], 
          "\[RightVector]"], "Text"], "(", "t", ")"}], ".", 
       OverscriptBox["\[Sigma]", "\[RightVector]"]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"c9e82ebb-7cfa-4b41-b133-c4e945e32aa9"],
 ", via Pauli cyclicity and anti-commutativity"
}], "Text",
 CellChangeTimes->{{3.981756742800867*^9, 
  3.981756966793105*^9}},ExpressionUUID->"2a92a7e7-3a5a-46e8-b1da-\
26a06e1cdb18"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Sigma]", "j"], 
    SubscriptBox["\[Sigma]", "k"]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Delta]", 
      RowBox[{"j", " ", "k"}]], 
     SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], "+", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"l", "=", "1"}], "3"], 
      RowBox[{
       SubscriptBox["\[Epsilon]", 
        RowBox[{"j", " ", "k", " ", "l"}]], 
       SubscriptBox["\[Sigma]", "l"]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.981756980991673*^9, 3.981757054029743*^9}, {
  3.981757171530336*^9, 3.981757171534523*^9}, {3.981757699791016*^9, 
  3.981757718030179*^9}},ExpressionUUID->"15df86c7-c97a-4cd2-97a3-\
4beb7b26ddea"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", 
    RowBox[{"j", " ", "k", " ", "l"}]], TraditionalForm]],ExpressionUUID->
  "e05bd3f1-70c1-4443-8290-d73813335b94"],
 " is the fully anti-symmetric Levi-Civita symbol, equaling 1 when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", " ", "k", " ", "l"}], TraditionalForm]],ExpressionUUID->
  "833a2a81-2e57-4745-8c61-219304f928b1"],
 " is an even permutation of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "2", ",", "3"}], ")"}], TraditionalForm]],
  ExpressionUUID->"8f53b81e-ef1f-4430-9bb3-92bab60c4a04"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]],ExpressionUUID->
  "1c96c3ee-49a9-4771-a1e1-3030083118d3"],
 " when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", " ", "k", " ", "l"}], TraditionalForm]],ExpressionUUID->
  "e54b8253-47d5-48bb-a6b7-cee42b98229b"],
 " is an odd permutation, and 0 otherwise, expand ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[ImaginaryI]", " ", 
    RowBox[{"Q", "\[ConjugateTranspose]"}], 
    OverscriptBox["Q", "\[FilledSmallCircle]"]}], TraditionalForm]],
  ExpressionUUID->"ce72e9b7-6885-462a-a116-5779ceecf70a"],
 "."
}], "Text",
 CellChangeTimes->{{3.981757068878891*^9, 3.9817571857229424`*^9}, {
   3.9817572333049107`*^9, 3.981757281088739*^9}, {3.981757366524328*^9, 
   3.981757367415036*^9}, 3.982075646193351*^9, {3.9821064630554333`*^9, 
   3.982106469288102*^9}},ExpressionUUID->"415dd97a-4f5b-4c1e-b1b3-\
18964139552e"],

Cell[TextData[{
 "By substituting these into the expression for \[CapitalOmega] and \
collecting terms proportional to each ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "k"], TraditionalForm]],ExpressionUUID->
  "7b3bdc21-774b-4e95-a6da-33b2baa052ed"],
 ", find that each component ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "k"], TraditionalForm]],ExpressionUUID->
  "7a6b2b06-ce07-4082-999d-be90551ad04d"],
 " of ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Omega]", "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"9c431f87-9d5c-40b4-9f4a-f047585903f3"],
 " is a linear combination of the coordinate velocities ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["q", "\[FilledSmallCircle]"], "\[Mu]"], TraditionalForm]],
  ExpressionUUID->"6108b6e2-ab20-40e8-9b6a-3418d80c3471"],
 ","
}], "Text",
 CellChangeTimes->{{3.981757373861237*^9, 
  3.9817575125568037`*^9}},ExpressionUUID->"aa875401-b90b-4379-9878-\
fd5278a77a5b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Omega]", "k"], "=", 
   RowBox[{"2", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"\[Mu]", "=", "0"}], "3"], 
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        SubscriptBox["v", "k"], ")"}], "\[Mu]"], 
      SubscriptBox[
       OverscriptBox["q", "\[FilledSmallCircle]"], "\[Mu]"]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.981757516718485*^9, 3.981757570716761*^9}, {
  3.9817576153966722`*^9, 
  3.981757664650423*^9}},ExpressionUUID->"cb79ea8d-e366-451e-a1fa-\
9551878bc7e0"],

Cell[TextData[{
 "where the three ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "k"], TraditionalForm]],ExpressionUUID->
  "5b8566ad-4157-410c-b553-d328a760117b"],
 " are the coefficients we see in the derivations above and below. The choice \
of the body frame (left-invariant) flips the sign of the cross-product term \
in the Levi-Civita expansion, exactly matching the components ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "k"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fad96a9b-74e7-4b10-8bbe-0f57bcf5e7a6"],
 " derived for the equations of motion. "
}], "Text",
 CellChangeTimes->{{3.981757788956088*^9, 3.981757807231037*^9}, {
  3.982089275472011*^9, 3.9820892876233597`*^9}, {3.9821065148875113`*^9, 
  3.982106558154601*^9}, {3.982106590657439*^9, 3.98210661671378*^9}, {
  3.9821103994199667`*^9, 
  3.982110401037879*^9}},ExpressionUUID->"51a6d178-0919-43e0-8d35-\
58d5b50e312d"],

Cell["In Wolfram:", "Text",ExpressionUUID->"6fbb2177-4cff-4744-92ac-e80001c0dbf6"],

Cell[CellGroupData[{

Cell["Setup", "Subsection",ExpressionUUID->"11a3e00e-54a6-44c3-8b01-f62f7584b084"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "q", ",", "qdot", ",", "Q", ",", "Qd", ",", "QDag", ",", "\[CapitalOmega]",
     ",", "\n", "v1", ",", "v2", ",", "v3", ",", "v0", ",", "\n", "q0", ",", 
    "q1", ",", "q2", ",", "q3", ",", "\n", "qd0", ",", "qd1", ",", "qd2", ",",
     "qd3"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9820904964871397`*^9, 3.982090501600924*^9}},
 CellLabel->"In[96]:=",ExpressionUUID->"302ba071-a798-4113-8aa9-02eb162a6ce5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Define Q and its Derivative in Terms of 4D Coordinates", "Subsection",ExpressionUUID->"74348f89-94b4-49e6-a9af-6c4cf090108e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"q", "=", 
   RowBox[{"{", 
    RowBox[{"q0", ",", "q1", ",", "q2", ",", "q3"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qdot", "=", 
   RowBox[{"{", 
    RowBox[{"dq0", ",", "dq1", ",", "dq2", ",", "dq3"}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[97]:=",ExpressionUUID->"424194e3-71a9-45ca-be29-36d5f83dd795"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Q", "=", 
   RowBox[{
    RowBox[{"q0", " ", "id"}], "-", 
    RowBox[{"\[ImaginaryI]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"q", "[", 
        RowBox[{"[", 
         RowBox[{"2", ";;", "4"}], "]"}], "]"}], " ", ".", " ", 
       "\[Sigma]Vec"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Qd", "=", 
   RowBox[{
    RowBox[{"dq0", " ", "id"}], "-", 
    RowBox[{"\[ImaginaryI]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"qdot", "[", 
        RowBox[{"[", 
         RowBox[{"2", ";;", "4"}], "]"}], "]"}], " ", ".", " ", 
       "\[Sigma]Vec"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"QDag", "=", 
   RowBox[{
    RowBox[{"q0", " ", "id"}], "+", 
    RowBox[{"\[ImaginaryI]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"q", "[", 
        RowBox[{"[", 
         RowBox[{"2", ";;", "4"}], "]"}], "]"}], " ", ".", " ", 
       "\[Sigma]Vec"}], ")"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.982091638606696*^9, 3.982091692198863*^9}},
 CellLabel->"In[99]:=",ExpressionUUID->"aea6762c-fae4-4fce-89ab-32c28a1f2029"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Hermitian angular Velocity Matrix", "Subsection",ExpressionUUID->"dd0e2243-55b1-47f4-86e4-c908c78f916f"],

Cell[TextData[{
 "This matrix is in the body frame, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Q", "\[ConjugateTranspose]"}], ".", 
    OverscriptBox["Q", "\[FilledSmallCircle]"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f43e1426-5fba-4281-9ab9-00f23f92a87b"],
 " instead of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["Q", "\[FilledSmallCircle]"], ".", 
    RowBox[{"Q", "\[ConjugateTranspose]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b5439e9c-5457-416f-a27e-12d36480b49e"],
 ". See the next section for explanation. "
}], "Text",
 CellChangeTimes->{{3.9820901321964207`*^9, 3.982090142891354*^9}, {
  3.982090182946618*^9, 
  3.9820902769061823`*^9}},ExpressionUUID->"35f0fbe1-017d-41b5-9e91-\
73f0f7232de7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalOmega]", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"2", " ", "\[ImaginaryI]", " ", 
      RowBox[{"(", 
       RowBox[{"QDag", " ", ".", " ", "Qd"}], ")"}]}], "//", 
     "ComplexExpand"}], "//", "FullSimplify"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.982090115584046*^9, 3.9820901185643473`*^9}, {
  3.98209155199021*^9, 3.9820915722882547`*^9}, {3.982091716024742*^9, 
  3.982091741337645*^9}},
 CellLabel->
  "In[102]:=",ExpressionUUID->"1b56ffc8-83de-4da7-9b54-6c81f67d4462"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\[Omega] Components via Pauli Trace Property", "Subsection",ExpressionUUID->"e02219d1-6bac-4578-8267-13a44c1604fb"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "k"], "=", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", "Tr", " ", 
     RowBox[{"\[CapitalOmega]", " ", ".", " ", 
      SubscriptBox["\[Sigma]", "k"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aedec05a-9a7a-4d21-a5bf-8fc37dd0e63e"],
 " "
}], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.982075699859919*^9, 3.982075776898459*^9}, 
   3.982090349198433*^9, {3.982091556476015*^9, 
   3.982091559559849*^9}},ExpressionUUID->"d97ec32e-09d5-42eb-ac01-\
3b8bb3295e2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Omega]Components", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"Tr", "[", 
        RowBox[{"\[CapitalOmega]", " ", ".", " ", 
         RowBox[{"\[Sigma]Vec", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "3"}], "}"}]}], "]"}], "//", "FullSimplify"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[103]:=",ExpressionUUID->"8727f35f-4e28-4679-ab49-d62d511fe894"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Coefficients Subscript[v, k] from Gradient w.r.t ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["Q", "\[FilledSmallCircle]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d290755f-72bd-432c-bf64-77bc312e3826"]
}], "Subsection",
 CellChangeTimes->{{3.982075825842485*^9, 
  3.982075851721044*^9}},ExpressionUUID->"8290e9f1-4e33-4e94-b76d-\
fbfcb54c904a"],

Cell["Matching the vectors defined in the geometric metric:", "Text",
 CellChangeTimes->{{3.982090995013382*^9, 
  3.982090996262998*^9}},ExpressionUUID->"c63b46a2-22d4-4955-9a07-\
96e27822b497"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"derivedV1", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"\[Omega]Components", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"{", "qdot", "}"}]}], "]"}], "/", "2"}]}], 
     ",", "\"\<derived v1 :\>\""}], "]"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Factor", " ", "of", " ", "2", " ", "for", " ", "normalization"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"derivedV2", "=", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Omega]Components", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"{", "qdot", "}"}]}], "]"}], "/", "2"}]}], 
    ",", "\"\<derived v2 :\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"derivedV3", "=", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Omega]Components", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", 
        RowBox[{"{", "qdot", "}"}]}], "]"}], "/", "2"}]}], 
    ",", "\"\<derived v3 :\>\""}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.982075886307569*^9, 3.9820758884497223`*^9}},
 CellLabel->
  "In[104]:=",ExpressionUUID->"e54a673c-7e5b-4c10-93f2-d791ae14ebd0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  TagBox["\<\"derived v1 :\"\>",
   "EchoLabel"], "  ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"-", "q1"}], ",", "q0", ",", "q3", ",", 
    RowBox[{"-", "q2"}]}], "}"}]}]], "Echo",
 CellChangeTimes->{
  3.982164606255355*^9},ExpressionUUID->"c795b905-3267-4192-a428-\
5544d09d882e"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"derived v2 :\"\>",
   "EchoLabel"], "  ", 
