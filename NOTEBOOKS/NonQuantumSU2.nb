Cell[CellGroupData[{

Cell["Proposition 4", "Subsubsection",
 CellChangeTimes->{{3.981418516920081*^9, 
  3.981418519213834*^9}},ExpressionUUID->"822bd47f-3365-4f81-8e7c-\
c5c3b5105867"],

Cell[TextData[{
 StyleBox["\[FilledDiamond]",
  FontColor->RGBColor[0.14, 0.8, 0.14]],
 " Any traceless, anti-Hermitian matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "a0b11a62-8abd-4e84-8f8c-0567b0eb6219"],
 " has the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["Q", "\[FilledSmallCircle]"], "(", "t", ")"}], ".", 
    RowBox[{
     RowBox[{"Q", "(", "t", ")"}], "\[ConjugateTranspose]"}]}], 
   TraditionalForm]],ExpressionUUID->"ab4ad523-4ccf-4a93-8e9b-f0bc155211c6"],
 " for some curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "43987a8b-1cd3-477d-befe-f8d88c8f6c22"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "eeab76eb-63d7-44d6-a34b-afa7fcd57733"],
 ", and therefore ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "057261b9-8709-4c0f-8564-c5d53d365208"],
 " is in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  ExpressionUUID->"e529c773-8d73-441d-9089-49f4297926c3"],
 "."
}], "Text",
 CellChangeTimes->{{3.9814175714891157`*^9, 3.981417577946908*^9}, {
   3.9814179239511423`*^9, 3.9814181907104*^9}, {3.981418226391685*^9, 
   3.9814183925677013`*^9}, {3.981418487774395*^9, 3.9814185453901978`*^9}, 
   3.981448723075233*^9, {3.98150485691595*^9, 3.981504878341525*^9}, 
   3.981595122848528*^9},ExpressionUUID->"1de23159-dca4-4245-9571-\
960886604b4f"],

Cell[TextData[{
 "PROOF: Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Q", "(", "t", ")"}], "=", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{" ", 
      RowBox[{"A", " ", "t"}]}]]}], TraditionalForm]],ExpressionUUID->
  "35342ed3-4aca-4c7d-a5ca-424e74ad9407"],
 " describe a curve in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "5d7e228d-287c-4296-83c3-03ef0cfa92f5"],
 ". Then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["Q", "\[FilledSmallCircle]"], "(", "t", ")"}], "=", 
    RowBox[{"A", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{" ", 
       RowBox[{"A", " ", "t"}]}]]}]}], TraditionalForm]],ExpressionUUID->
  "867b3f9c-273d-4d4a-b6f0-355e3423fba9"],
 ". Because the Taylor series of the matrix exponential has only real, scalar \
powers of ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "350e5bd2-957e-4584-9f6e-e96b154d814d"],
 ", the conjugate-transpose operation, \[ConjugateTranspose], lifts into the \
exponent: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"Q", "(", "t", ")"}], "\[ConjugateTranspose]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{" ", 
         RowBox[{"A", " ", "t"}]}]], ")"}], "\[ConjugateTranspose]"}], "=", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{" ", 
       RowBox[{
        RowBox[{"A", "\[ConjugateTranspose]"}], " ", "t"}]}]]}]}], 
   TraditionalForm]],ExpressionUUID->"9b8e3098-6928-4e7e-8398-d0dbed1b5d9c"],
 ". Because ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "b7e452a9-4d1a-4a7f-b8ab-3e8fd81cbc73"],
 " is anti-Hermitian, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"Q", "(", "t", ")"}], "\[ConjugateTranspose]"}], "=", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{" ", 
      RowBox[{
       RowBox[{"-", "A"}], " ", "t"}]}]]}], TraditionalForm]],ExpressionUUID->
  "f92f7e81-868d-4ac9-83b2-390d8b6ee488"],
 ". Now, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      OverscriptBox["Q", "\[FilledSmallCircle]"], "(", "t", ")"}], ".", 
     RowBox[{
      RowBox[{"Q", "(", "t", ")"}], "\[ConjugateTranspose]"}]}], "=", 
    RowBox[{
     RowBox[{"A", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{" ", 
        RowBox[{"A", " ", "t"}]}]], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{" ", 
        RowBox[{
         RowBox[{"-", "A"}], " ", "t"}]}]]}], "=", 
     RowBox[{
      RowBox[{"A", " ", 
       SuperscriptBox["\[ExponentialE]", "0"]}], "=", "A"}]}]}], 
   TraditionalForm]],ExpressionUUID->"a3e6a24f-5c33-4ad0-af82-6d55fc771632"],
 " because ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", " ", "t"}], TraditionalForm]],ExpressionUUID->
  "e83fb5ff-13cf-47d8-8c92-b3e37a3b27e2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "A"}], " ", "t"}], TraditionalForm]],ExpressionUUID->
  "bc0ec2f9-de37-4fa4-95d5-ccd2947d99fc"],
 " commute (condition for adding exponents in a matrix exponential). \
Therefore ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "e3a19252-5f27-473c-98ff-8f0a2815a07d"],
 " has the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["Q", "\[FilledSmallCircle]"], ".", 
    RowBox[{"Q", "\[ConjugateTranspose]"}]}], TraditionalForm]],
  ExpressionUUID->"5460cc3e-b408-48d5-be36-9043510a79aa"],
 " and must be in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  ExpressionUUID->"457f3802-9dcd-4cf9-86a9-3ca9679cb114"],
 " by Proposition 1."
}], "Text",
 CellChangeTimes->{{3.9814175714891157`*^9, 3.981417577946908*^9}, {
  3.9814179239511423`*^9, 3.9814181907104*^9}, {3.981418226391685*^9, 
  3.9814183925677013`*^9}, {3.981418487774395*^9, 3.981418522602104*^9}, {
  3.981452276716605*^9, 3.981452353029071*^9}, {3.9815047182924223`*^9, 
  3.981504740451653*^9}, {3.9815048904451923`*^9, 3.9815048990272303`*^9}, {
  3.981586389260036*^9, 3.981586390219548*^9}, {3.98175146452598*^9, 
  3.981751468799769*^9}, {3.981751504367344*^9, 
  3.981751520750535*^9}},ExpressionUUID->"15f0f237-4cd9-4252-b0e5-\
57e9a59c37a6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"proof", "@", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"A", ",", "Q", ",", "Qdot", ",", "X", ",", "Y"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"arbitrary", " ", "traceless"}], ",", " ", 
       RowBox[{"anti", "-", 
        RowBox[{"Hermitian", " ", "matrix"}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"A", "=", 
       RowBox[{"(", GridBox[{
          {
           RowBox[{"\[ImaginaryI]", " ", "y"}], 
           RowBox[{"u", "+", 
            RowBox[{"\[ImaginaryI]", " ", "v"}]}]},
          {
           RowBox[{"-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"u", "+", 
               RowBox[{"\[ImaginaryI]", " ", "v"}]}], ")"}], 
             "\[Conjugate]"}]}], 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "y"}]}
         }], ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          StyleBox["TracelessQ",
           FontColor->RGBColor[0.14, 0.8, 0.14]], "[", "A", "]"}], "&&", 
         RowBox[{
          StyleBox["AntiHermitianQ",
           FontColor->RGBColor[0.14, 0.8, 0.14]], "[", "A", "]"}]}], 
        ",", "\"\<A traceless && anti-Hermitian :\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Q", "[", "t", "]"}], "=", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{"A", " ", "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Qdot", "[", "t", "]"}], "=", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Q", "[", "t", "]"}], ",", "t"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"X", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"MatrixExp", "[", 
          RowBox[{"A", " ", "t"}], "]"}], "\[ConjugateTranspose]"}], "//", 
        "ComplexExpand"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Y", "=", 
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"A", "\[ConjugateTranspose]"}], " ", "t"}], "]"}], "//", 
        "ComplexExpand"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"zero", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], "}"}], ",", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"expIdentity", "=", 
           RowBox[{"Echo", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"X", "-", "Y"}], "==", "0"}], ",", 
               RowBox[{"Assumptions", "->", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"y", ",", "u", ",", "v", ",", "t"}], "}"}], "\[Element]",
                  "Reals"}]}]}], "]"}], ",", 
             "\[IndentingNewLine]", "\"\<(\!\(\*SuperscriptBox[\(\
\[ExponentialE]\), \(A\\\ t\)]\))\[ConjugateTranspose] == \
\!\(\*SuperscriptBox[\(\[ExponentialE]\), \(A\[ConjugateTranspose]  t\)]\) \
:\>\""}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"prop4", "=", 
           RowBox[{"Echo", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"ComplexExpand", "[", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Qdot", "[", "t", "]"}], ".", 
                   RowBox[{
                    RowBox[{"Q", "[", "t", "]"}], "\[ConjugateTranspose]"}]}],
                   "-", "A"}], "==", "zero"}], "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"Assumptions", "->", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"y", ",", "u", ",", "v", ",", "t"}], "}"}], "\[Element]",
                  "Reals"}]}]}], "]"}], ",", "\"\<prop4 :\>\""}], "]"}]}]}], 
         "}"}], ",", "\[IndentingNewLine]", "prop4"}], "]"}]}]}], "]"}]}], 
