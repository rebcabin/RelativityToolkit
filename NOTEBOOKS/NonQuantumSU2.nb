Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "rig", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"l", "=", "1.2"}], ",", 
      RowBox[{"mass", "=", "1.0"}], ",", 
      RowBox[{"d", "=", "2.4"}], ",", 
      RowBox[{"r", "=", "0.02"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"baton", "=", 
       RowBox[{"Cylinder", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", 
             RowBox[{"-", "l"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", 
             RowBox[{"+", "l"}]}], "}"}]}], "}"}], ",", "r"}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"batonCenterBodyFrame", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "l"}], "}"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"rig", "[", "\"\<graphics primitives\>\"", "]"}], "=", 
      "baton"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rig", "[", "\"\<moment of inertia\>\"", "]"}], "=", 
      "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Ib", "=", 
          RowBox[{"mass", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"MomentOfInertia", "[", "baton", "]"}], "/", 
             RowBox[{"Volume", "[", "baton", "]"}]}], ")"}]}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"Ibi", "=", 
          RowBox[{"Inverse", "@", "Ib"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"Ib", ",", "Ibi"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rig", "[", "\"\<cb\>\"", "]"}], ":=", "batonCenterBodyFrame"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rig", "[", "\"\<half length\>\"", "]"}], ":=", "l"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rig", "[", "\"\<mass\>\"", "]"}], ":=", "mass"}], ";"}]}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "jack", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"jack", "[", 
     RowBox[{"0", ",", 
      RowBox[{"opacity_", ":", "0.1"}], ",", 
      RowBox[{"diameter_", ":", "0.01"}]}], "]"}], ":=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Opacity", "[", "opacity", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{
          RowBox[{"Tube", "[", 
           RowBox[{"{", 
            RowBox[{"o", ",", "e1"}], "}"}], "]"}], ",", "diameter"}], 
         "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Darker", "[", "Green", "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{
          RowBox[{"Tube", "[", 
           RowBox[{"{", 
            RowBox[{"o", ",", "e2"}], "}"}], "]"}], ",", "diameter"}], 
         "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Lighter", "[", "Blue", "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{
          RowBox[{"Tube", "[", 
           RowBox[{"{", 
            RowBox[{"o", ",", "e3"}], "}"}], "]"}], ",", "diameter"}], 
         "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Lighter", "[", "Cyan", "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{
          RowBox[{"Tube", "[", 
           RowBox[{"{", 
            RowBox[{"o", ",", 
             RowBox[{"-", "e1"}]}], "}"}], "]"}], ",", "diameter"}], "]"}]}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Magenta", ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{
          RowBox[{"Tube", "[", 
           RowBox[{"{", 
            RowBox[{"o", ",", 
             RowBox[{"-", "e2"}]}], "}"}], "]"}], ",", "diameter"}], "]"}]}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Yellow", ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{
          RowBox[{"Tube", "[", 
           RowBox[{"{", 
            RowBox[{"o", ",", 
             RowBox[{"-", "e3"}]}], "}"}], "]"}], ",", "diameter"}], "]"}]}], 
       "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"nfm", ",", "vfm", ",", "font", ",", "myFont"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"myFont", "[", 
    RowBox[{"color_", ",", 
     RowBox[{"size_", ":", "18"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Style", "[", 
     RowBox[{"#", ",", "color", ",", "Bold", ",", "size", ",", 
      RowBox[{"FontFamily", "->", "\"\<Courier New\>\""}]}], "]"}], "&"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nfm", "[", 
    RowBox[{"num_", ",", 
     RowBox[{"dig_", ":", "10"}], ",", 
     RowBox[{"dec_", ":", "4"}]}], "]"}], ":=", 
   RowBox[{"ToString", "[", 
    RowBox[{"NumberForm", "[", 
     RowBox[{
      RowBox[{"Chop", "@", "num"}], ",", 
      RowBox[{"{", 
       RowBox[{"dig", ",", "dec"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vfm", "[", "vec_", "]"}], ":=", 
   RowBox[{"ToString", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"NumberForm", "[", 
       RowBox[{"#", ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "4"}], "}"}], ",", 
        RowBox[{"NumberSigns", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<-\>\"", ",", "\"\< \>\""}], "}"}]}], ",", 
        RowBox[{"NumberPadding", "->", 
         RowBox[{"{", 
          RowBox[{"\"\< \>\"", ",", "\"\<0\>\""}], "}"}]}]}], "]"}], "&"}], "/@", 
     RowBox[{"Chop", "@", "vec"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"font", "=", 
   RowBox[{"myFont", "[", 
    RowBox[{
     RowBox[{"Lighter", "[", "Blue", "]"}], ",", "12"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9802794676003428`*^9, 3.980279583680739*^9}, {
  3.980755189788206*^9, 3.980755348085676*^9}, {3.9810163121001863`*^9, 
  3.981016313694497*^9}, {3.982080265150552*^9, 3.982080266334465*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"03766d26-712d-4136-b309-084c490239c1"]
