   3.982149978272731*^9, 
   3.982149983530156*^9}},ExpressionUUID->"fc5295be-8e2f-4a92-9769-\
a53e63d6aeb5"],

Cell[CellGroupData[{

Cell[TextData[{
 "Summary: The Lie Group ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "7dec9b8e-e515-4e28-870e-e92ba0e07957"],
 " and its Lie Algebra, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  ExpressionUUID->"308a1a17-553e-4757-99ba-4288f08b4fe7"]
}], "Section",
 CellChangeTimes->{{3.980613962792136*^9, 3.9806139797711887`*^9}, {
  3.981292289570516*^9, 3.9812922905850687`*^9}, {3.981295680091197*^9, 
  3.9812957067939663`*^9}, {3.9816438926480703`*^9, 3.981643895139319*^9}, {
  3.981644313765348*^9, 
  3.981644314957793*^9}},ExpressionUUID->"858b821e-beed-4052-a1f7-\
3d37d8d6415f"],

Cell["\<\
This summary presents the basic facts necessary to understand the building \
blocks of the derivations: the metric tensor, the potential field, the \
objects put to rotation, and the rotation operators themselves. Most of the \
facts have proofs in the remainder of the chapter. The proofs require only \
basic University mathematics. There are many short reminders of even more \
basic facts, intended to ease understanding.\
\>", "Text",
 CellChangeTimes->{{3.981412216666863*^9, 3.981412541021722*^9}, {
   3.981453609466157*^9, 3.9814536801716137`*^9}, {3.9814537378941936`*^9, 
   3.9814537387569304`*^9}, {3.9814537716162367`*^9, 3.981453822717458*^9}, {
   3.981503100644874*^9, 3.981503224303117*^9}, {3.981552804526195*^9, 
   3.9815528071383057`*^9}, {3.981552842103586*^9, 3.9815528446605263`*^9}, {
   3.981623807488196*^9, 3.9816238280885572`*^9}, {3.981623863232586*^9, 
   3.981623942003899*^9}, {3.98162401039598*^9, 3.981624016993409*^9}, {
   3.981644075024417*^9, 3.981644219879541*^9}, {3.981644576089266*^9, 
   3.981644584408701*^9}, {3.981644804057716*^9, 3.981644865529681*^9}, 
   3.981646520503483*^9, {3.9817275286698513`*^9, 3.981727533003087*^9}, {
   3.981733349938581*^9, 3.981733468477932*^9}, {3.981733901465651*^9, 
   3.981733970036092*^9}, {3.981735334312188*^9, 3.9817353375507793`*^9}, {
   3.981735495055558*^9, 3.981735604761775*^9}, {3.981735640297991*^9, 
   3.981735913282864*^9}, {3.981749760430081*^9, 3.9817498406298447`*^9}, 
   3.982079937506956*^9, {3.982149997331917*^9, 3.982149997854929*^9}, {
   3.982150034671483*^9, 
   3.9821500540875597`*^9}},ExpressionUUID->"f5047143-88d1-436b-868e-\
bf70a85f72f9"],

