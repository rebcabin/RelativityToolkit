Cell[CellGroupData[{

Cell["Traceless and Hermitian", "Subsection",
 CellChangeTimes->{{3.981043253724121*^9, 3.981043282915587*^9}, {
   3.98106446501652*^9, 3.981064468033197*^9}, {3.981295728942463*^9, 
   3.981295754781122*^9}, {3.981453546893814*^9, 3.981453556658145*^9}, {
   3.981455810759623*^9, 3.981455816841353*^9}, {3.9814560767068777`*^9, 
   3.981456083629025*^9}, {3.9816253212367773`*^9, 3.981625327051799*^9}, 
   3.9816365264897337`*^9},ExpressionUUID->"d5f3dcd3-bafe-4c56-9d32-\
f51492e301d4"],

Cell["\<\
Pauli matrices are obviously traceless, plus they are Hermitian: each is \
equal to its conjugate transpose. \[OpenCurlyDoubleQuote]Hermitian\
\[CloseCurlyDoubleQuote] is the analogue of \[OpenCurlyDoubleQuote]symmetric\
\[CloseCurlyDoubleQuote] amongst real matrices and implies real eigenvalues.\
\>", "Text",
 CellChangeTimes->{{3.981043993161935*^9, 3.981044040964336*^9}, {
  3.981064479120384*^9, 3.981064481754177*^9}, {3.9810706500504208`*^9, 
  3.9810706580847073`*^9}, {3.981116320775547*^9, 3.981116323739871*^9}, {
  3.981220112540186*^9, 3.9812201237763977`*^9}, {3.9812925289492817`*^9, 
  3.981292554924773*^9}, {3.981455823780518*^9, 3.981455839562722*^9}, {
  3.9815054602052813`*^9, 
  3.981505473598041*^9}},ExpressionUUID->"07d2933f-6f90-4857-8f4b-\
4380756db87d"],

