Cell[TextData[{
 "PROOF: Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "d4a99687-87b9-4f8e-9bcf-6ce683c33748"],
 " be the trajectory of the baton (or of any other system), a smooth curve in \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "091099ef-b01f-41bd-a028-24a1b15e989a"],
 ". At any specific time ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "3acab1e9-c81d-4863-9059-a7d000c3e4ba"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["Q", "\[FilledSmallCircle]"], "(", "t", ")"}], 
   TraditionalForm]],ExpressionUUID->"eb10103d-c015-48cb-a517-b8b7aa5584c9"],
 " is tangent to the curve at the point ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "cc4d8d61-4713-484a-80b9-0e1461c1d958"],
 ", in the tangent space ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", 
     RowBox[{"Q", "(", "t", ")"}]], "S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "fc62fcf7-f8a2-4aef-b39c-b7755111072c"],
 ". Now consider another curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Gamma]", "(", "s", ")"}], "=", 
    RowBox[{
     RowBox[{"Q", "(", 
      RowBox[{"t", "+", "s"}], ")"}], ".", 
     RowBox[{
      RowBox[{"Q", "(", "t", ")"}], "\[ConjugateTranspose]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"14210da7-7c25-4c6f-a20e-6ad93fa1239f"],
 " (no dot on the first ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c9935732-c295-4719-aca1-fe8d380e187d"],
 ", intended to bring ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "(", 
    RowBox[{"t", "+", "s"}], ")"}], TraditionalForm]],ExpressionUUID->
  "47cd96db-6955-4da5-8e1f-c23470f06c87"],
 " to the origin via group multiplication by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Q", "(", "t", ")"}], "\[ConjugateTranspose]"}], 
   TraditionalForm]],ExpressionUUID->"95423838-8d03-40c2-b1bd-7c9c9d309cc9"],
 ")."
}], "Text",
