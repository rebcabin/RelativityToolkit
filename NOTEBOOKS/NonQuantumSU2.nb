10d0fecb140a"],

Cell[TextData[{
 "Unit determinants for elements of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "139ea2c3-a75c-4e53-8c20-6ec6404d1b19"],
 " implies that elements of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  ExpressionUUID->"96395d89-d834-4732-8ccb-14c04170130d"],
 " are traceless."
}], "ItemNumbered",
 CellChangeTimes->{
  3.981448304457039*^9, {3.9816248387978287`*^9, 
   3.981624849161312*^9}},ExpressionUUID->"dc1e3e8d-9d0f-46c1-9caf-\
895990748a8b"],

Cell[TextData[{
 "Any traceless, anti-Hermitian matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "f522781d-7617-4a04-9982-eee1c7daab90"],
 " has the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["Q", "\[FilledSmallCircle]"], "(", "t", ")"}], ".", 
    RowBox[{
     RowBox[{"Q", "(", "t", ")"}], "\[ConjugateTranspose]"}]}], 
   TraditionalForm]],ExpressionUUID->"e371c025-1960-4acd-9c71-b010399d07d6"],
 " for some curve in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7bdbe9be-486b-49fc-a8a7-284f6e4297ea"],
 ", and therefore is in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  ExpressionUUID->"a5e3dc69-d6a0-4986-acff-9bfea90edd19"],
 "."
}], "ItemNumbered",
