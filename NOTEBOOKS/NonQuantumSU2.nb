  3.9820291776936083`*^9}},ExpressionUUID->"224d03d4-9989-4152-b303-\
7faf3ab6014b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"g4", " ", "=", " ", 
   RowBox[{"MakeIndexer", "[", 
    RowBox[{"metric4", ",", " ", "coords4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ig4", " ", "=", " ", 
    RowBox[{"MakeIndexer", "[", 
     RowBox[{"invMetric4", ",", " ", "coords4"}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"manually", " ", "constructed", " ", "indexer"}], ",", " ", 
    RowBox[{"just", " ", "as", " ", "with", " ", "SO", 
     RowBox[{"(", "3", ")"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalGamma]4", "[", 
     RowBox[{"\[Mu]_", ",", " ", "\[Nu]_", ",", " ", "\[Lambda]_"}], "]"}], 
    " ", ":=", " ", 
    RowBox[{"ChristoffelsFromMetricIndexer", "[", 
     RowBox[{
     "g4", ",", " ", "ig4", ",", " ", "\[Mu]", ",", " ", "\[Nu]", ",", " ", 
      "\[Lambda]", ",", " ", "coords4"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"add", " ", "general", " ", "normalization", " ", 
      RowBox[{"Q", ".", 
       RowBox[{"Q", "\[ConjugateTranspose]"}]}]}], " ", "\[Rule]", " ", "1"}],
     ";", " ", 
    RowBox[{"time", " ", "dependence", " ", "injected", " ", "later"}]}], " ",
    "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalGamma]4red", "=", 
   RowBox[{"MakeIndexer", "[", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\[CapitalGamma]4", "[", 
         RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Lambda]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\[Mu]", ",", "coords4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\[Nu]", ",", "coords4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\[Lambda]", ",", "coords4"}], "}"}]}], "]"}], " ", "//.", 
      " ", "\n", "\t    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SuperscriptBox["q0", "2"], " ", "+", " ", 
         SuperscriptBox["q1", "2"], " ", "+", " ", 
         SuperscriptBox["q2", "2"], "+", " ", 
         SuperscriptBox["q3", "2"]}], " ", "->", " ", "1"}], "}"}]}], ",", 
     " ", "coords4"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.981755043092327*^9, 3.9817550658800898`*^9}, {
   3.981755112394432*^9, 3.9817551486656313`*^9}, 3.981803392919306*^9, 
