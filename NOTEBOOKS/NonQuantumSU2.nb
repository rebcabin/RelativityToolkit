Cell[BoxData[{
 FormBox[
  RowBox[{"Q", "\[Congruent]", 
   RowBox[{
    RowBox[{
     SubscriptBox["q", "0"], 
     SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], " ", "-", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["q", "1"], 
        SubscriptBox["\[Sigma]", "1"]}], " ", "+", " ", 
       RowBox[{
        SubscriptBox["q", "2"], 
        SubscriptBox["\[Sigma]", "2"]}], " ", "+", " ", 
       RowBox[{
        SubscriptBox["q", "3"], 
        SubscriptBox["\[Sigma]", "3"]}]}], ")"}]}]}], "  ", "\[Congruent]", 
   "  ", 
   RowBox[{
    RowBox[{
     SubscriptBox["q", "0"], 
     SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], " ", "-", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{
      OverscriptBox["q", "\[RightVector]"], ".", 
      OverscriptBox["\[Sigma]", "\[RightVector]"]}]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{
   RowBox[{"where", "  ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["q", "0"], "2"], "+", 
      SuperscriptBox[
       SubscriptBox["q", "1"], "2"], "+", 
      SuperscriptBox[
       SubscriptBox["q", "2"], "2"], "+", 
      SuperscriptBox[
       SubscriptBox["q", "3"], "2"]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox["q", "0"], "2"], "+", 
     RowBox[{
      OverscriptBox["q", "\[RightVector]"], ".", 
      OverscriptBox["q", "\[RightVector]"]}]}], "=", "1"}]}], 
  TraditionalForm]}], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9812143678991413`*^9, 3.981214452066915*^9}, {
   3.981245144582741*^9, 3.981245153027391*^9}, {3.981245306713119*^9, 
   3.981245383388976*^9}, 3.981298924477916*^9, {3.9816596940634403`*^9, 
   3.9816597895174627`*^9}, {3.981659885671488*^9, 3.98165989050941*^9}, {
   3.9816605640567303`*^9, 3.981660566910369*^9}, {3.981709577937457*^9, 
   3.981709594813787*^9}, {3.9821550781539593`*^9, 
   3.9821550802247334`*^9}},ExpressionUUID->"79ea6e43-6b27-4585-adc4-\
9da169f7e5d6"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "0"], TraditionalForm]],ExpressionUUID->
  "015ab333-8596-4803-8179-aee974029142"],
 " is called the ",
 StyleBox["real part",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ee8bb7a1-8e9d-471a-8b8e-695dc23d65dc"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["q", "1"], 
        SubscriptBox["\[Sigma]", "1"]}], " ", "+", " ", 
       RowBox[{
        SubscriptBox["q", "2"], 
        SubscriptBox["\[Sigma]", "2"]}], " ", "+", " ", 
       RowBox[{
        SubscriptBox["q", "3"], 
        SubscriptBox["\[Sigma]", "3"]}]}], ")"}]}], "\[Congruent]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     RowBox[{
      OverscriptBox["q", "\[RightVector]"], ".", 
      OverscriptBox["\[Sigma]", "\[RightVector]"]}]}]}], TraditionalForm]],
  ExpressionUUID->"76122ab2-548b-416b-b2b9-e36fa2855d97"],
 " is called the ",
 StyleBox["imaginary part",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " or the ",
 StyleBox["vector part",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellChangeTimes->{{3.981298339559561*^9, 3.9812983998452168`*^9}, {
  3.9812988978864517`*^9, 3.9812989094390097`*^9}, {3.981298953900622*^9, 
  3.9812989646257257`*^9}, {3.981457505571434*^9, 3.981457541364118*^9}, {
  3.981641286004259*^9, 3.981641292522833*^9}, {3.981752129469255*^9, 
  3.981752151166341*^9}, {3.9817522973483133`*^9, 3.981752300135744*^9}, {
  3.982155091513102*^9, 
  3.982155093295793*^9}},ExpressionUUID->"2ba4e036-564f-46bd-95aa-\
29b717855e16"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["q", "\[RightVector]"], ".", 
    OverscriptBox["\[Sigma]", "\[RightVector]"]}], TraditionalForm]],
  ExpressionUUID->"dcfe17fd-08e4-43d1-adf2-d20855eeefab"],
 StyleBox[" alone, without ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "\[ImaginaryI]"}], TraditionalForm]],ExpressionUUID->
  "4687663c-ed29-465d-a638-1661fa88b3d4"],
 ",",
 StyleBox[" is a traceless, Hermitian 3\[NoBreak]-\[NoBreak]vector \
representation. This comes up as a way to recover physically measurable \
angular velocity from the quaternion.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.981299008509996*^9, 3.9812990547856197`*^9}, {
   3.981299084944512*^9, 3.98129929791954*^9}, {3.9812998234675617`*^9, 
   3.981299884658512*^9}, {3.981457158279683*^9, 3.9814571691943007`*^9}, {
   3.981457564317506*^9, 3.981457609580576*^9}, {3.9814576509843388`*^9, 
   3.9814577409473667`*^9}, {3.9815008869792233`*^9, 3.981500934230345*^9}, 
   3.981636640635572*^9, {3.9816373722705517`*^9, 3.981637644530064*^9}, {
   3.981639627406654*^9, 3.981639772418112*^9}, {3.981641468105842*^9, 
