Cell[CellGroupData[{

Cell["Example", "Subsubsection",
 CellChangeTimes->{{3.9812144749386377`*^9, 
  3.9812144802657633`*^9}},ExpressionUUID->"4c4baaca-9c94-4f46-8896-\
5f7b04e2c4c2"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[Omega]", "\[RightVector]"], "=", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "\[Theta]"}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"b79744d2-693c-42fe-bd65-1dc546cbcd9c"],
 " be a rotation of angle \[Theta] around the Z axis and let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "0c918005-24b0-4aff-9c36-02dae9819a1a"],
 ". Then the following expression, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", ".", "r", ".", 
    RowBox[{"Q", "\[ConjugateTranspose]"}]}], TraditionalForm]],
  ExpressionUUID->"ba499079-04cb-4981-9f2e-f2036d32acd6"],
 ", rotates the vector ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "bef8356e-c294-42a8-bbee-a17caa945ac6"],
 " counterclockwise"
}], "Text",
 CellChangeTimes->{{3.981214713555958*^9, 3.981214820070723*^9}, {
  3.981217710420248*^9, 3.981217727223301*^9}, {3.98121779556915*^9, 
  3.9812178293984127`*^9}, {3.981218117393579*^9, 
  3.981218128818918*^9}},ExpressionUUID->"61263034-9555-4e22-9b66-\
a9ed264b8a3e"],

Cell[BoxData[
 FormBox[
  RowBox[{"Q", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"cos", 
      RowBox[{"(", 
       FractionBox["\[Theta]", "2"], ")"}], " ", 
      SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], " ", "-", "  ", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"sin", "(", 
       FractionBox["\[Theta]", "2"], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "\[Theta]"], 
        RowBox[{"(", GridBox[{
           {"\[Theta]", "0"},
           {"0", 
            RowBox[{"-", "\[Theta]"}]}
          }], ")"}]}], ")"}]}]}], " ", " ", " ", "=", "  ", 
    RowBox[{
     RowBox[{"cos", 
      RowBox[{"(", 
       FractionBox["\[Theta]", "2"], ")"}], " ", 
      SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], "  ", "-", "  ", 
     RowBox[{"\[ImaginaryI]", " ", "sin", 
      RowBox[{"(", 
       FractionBox["\[Theta]", "2"], ")"}], 
      SubscriptBox["\[Sigma]", "3"], " "}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9812148237963047`*^9, 3.9812148397628813`*^9}, {
  3.981214949053606*^9, 3.9812150072079287`*^9}, {3.981215071868788*^9, 
  3.9812150970569143`*^9}, {3.981217847569337*^9, 
  3.981217926685561*^9}},ExpressionUUID->"69e4890d-d126-4777-8292-\
2adc37a5c518"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Q", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", 
          FractionBox["\[Theta]", "2"], "]"}], "id"}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"Sin", "[", 
          FractionBox["\[Theta]", "2"], "]"}], 
         RowBox[{"\[Sigma]", "[", "3", "]"}]}]}]}], ",", 
      RowBox[{"r", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], ".", "\[Sigma]Vec"}]}]}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Q", ".", "r", ".", 
       RowBox[{"Q", "\[ConjugateTranspose]"}]}], "\[IndentingNewLine]", "//", 
      "Simplify"}], "//", "ComplexExpand"}]}], "]"}], "//", 
  "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.981215017127316*^9, 3.9812150624780273`*^9}, {
  3.981215106192196*^9, 3.981215203986238*^9}, {3.981215238562508*^9, 
  3.981215273580716*^9}, {3.981215307107254*^9, 3.981215393661384*^9}, {
  3.9812158485546207`*^9, 3.981215865003525*^9}, {3.981215900022965*^9, 
  3.981215909398735*^9}, {3.981215942874426*^9, 3.9812159563615294`*^9}, {
  3.981217506492777*^9, 3.9812175297397327`*^9}, {3.981217570254176*^9, 
  3.98121758375626*^9}, {3.9812176301759157`*^9, 3.98121765533689*^9}, {
  3.981217730213787*^9, 3.9812177899852943`*^9}, {3.981218154513459*^9, 
  3.9812181601073427`*^9}, {3.98121831287122*^9, 3.981218313360108*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"e9982d44-6709-4600-8180-73aee605ad77"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"z", 
      RowBox[{
       RowBox[{"x", " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
       RowBox[{"y", " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "+", 
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "y"}], " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
          RowBox[{"x", " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}]}]}]},
     {
      RowBox[{
       RowBox[{"x", " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
       RowBox[{"y", " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "+", 
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"y", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
          RowBox[{"x", " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}]}]}], 
      RowBox[{"-", "z"}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.982154891503409*^9, 3.982156754573749*^9, 
