XPx+HJfQOXmbjoUkEdz6pi+s7RKM4u/VX7Fo6GOM3flZpKOLitxSPJakl+Hu
7tw5+GXxniT8H3iVZ2k=
  "],ExpressionUUID->"caaa38a0-d129-4f72-9139-984b511dcd9b"],

Cell[CellGroupData[{

Cell[TextData[{
 "Exponential Map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], "\[LongRightArrow]", 
     "S"}], "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "81917f92-fe68-4804-b4a7-bb93357a9abd"],
 ", Angle to Quaternion"
}], "Subsection",
 CellChangeTimes->{{3.9812950848699427`*^9, 3.981295118918874*^9}, {
  3.9816649663530493`*^9, 
  3.9816649747365103`*^9}},ExpressionUUID->"a57c1f7a-b594-4b04-a416-\
8750d3709a2f"],

Cell[TextData[{
 "In mechanics, classical or quantum, we usually specify an instantaneous \
angle of rotation by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", " ", 
    OverscriptBox["\[Omega]", "\[RightVector]"]}], TraditionalForm]],
  ExpressionUUID->"ff2f405f-8079-4d19-ba02-66ca74fdd11e"],
 ", a coordinate time ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cc6ee7e6-213a-44c4-92cf-ce75344e6355"],
 " multiplied by an angular velocity 3\[NoBreak]-\[NoBreak]vector ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Omega]", "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"1f830758-45ce-451e-aaf5-5a90ceb14c8e"],
 ". Its representation in \[GothicS]\[GothicU](2) is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", 
    RowBox[{
     OverscriptBox["\[Omega]", "\[RightVector]"], ".", 
     OverscriptBox["\[Sigma]", "\[RightVector]"]}]}], TraditionalForm]],
  ExpressionUUID->"393741b0-0b47-42fd-8efe-3086e9e86b62"],
 ":"
}], "Text",
 CellChangeTimes->{{3.981295606679921*^9, 3.981295657404581*^9}, {
  3.981297764510063*^9, 3.98129776996891*^9}, {3.9816631669162693`*^9, 
  3.9816632977512074`*^9}, {3.981664853353848*^9, 3.9816648584384947`*^9}, {
  3.981664933679138*^9, 3.98166494014616*^9}, {3.981754234858122*^9, 
  3.981754236563236*^9}},ExpressionUUID->"e2f9cc43-6cfd-4675-b299-\
757bb8afc160"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"proof", "@", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Omega]", "=", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["\[Omega]", "1"], ",", 
          SubscriptBox["\[Omega]", "2"], ",", 
          SubscriptBox["\[Omega]", "3"]}], "}"}]}], ",", "\[Theta]Rep"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Theta]Rep", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", 
             RowBox[{"\[Omega]", ".", "\[Sigma]Vec"}]}], "//", 
            "ComplexExpand"}]}], ")"}], "//", "MatrixForm"}], ",", 
        "\[IndentingNewLine]", "\"\<instantaneous angle is in \[GothicS]\
\[GothicU](2) :\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        StyleBox["AntiHermitianQ",
         FontColor->RGBColor[0.14, 0.8, 0.14]], "[", "\[Theta]Rep", "]"}], "&&", 
       RowBox[{
        StyleBox["TracelessQ",
         FontColor->RGBColor[0.14, 0.8, 0.14]], "[", "\[Theta]Rep", 
        "]"}]}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9812146102702627`*^9, 3.9812146789147367`*^9}, {
   3.981247554020776*^9, 3.981247584527129*^9}, {3.98124763730602*^9, 
   3.9812477124888573`*^9}, {3.981662769791704*^9, 3.981663155267765*^9}, {
   3.981663302285198*^9, 3.981663345461397*^9}, {3.9816635440018787`*^9, 
   3.981663601261396*^9}, {3.981664070019437*^9, 3.9816641332465754`*^9}, {
   3.981664815917429*^9, 3.981664836904623*^9}, 3.98171012359409*^9, {
   3.9817542579879847`*^9, 3.981754263523263*^9}},
 CellLabel->"In[66]:=",ExpressionUUID->"0be4de33-8361-43fc-904e-646d7975c08d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  TagBox["\<\"instantaneous angle is in \[GothicS]\[GothicU](2) :\"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", 
        SubscriptBox["\[Omega]", "3"]}], 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", 
         SubscriptBox["\[Omega]", "1"]}], "-", 
        RowBox[{"t", " ", 
         SubscriptBox["\[Omega]", "2"]}]}]},
      {
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", 
         SubscriptBox["\[Omega]", "1"]}], "+", 
        RowBox[{"t", " ", 
         SubscriptBox["\[Omega]", "2"]}]}], 
       RowBox[{"\[ImaginaryI]", " ", "t", " ", 
        SubscriptBox["\[Omega]", "3"]}]}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}], "\[NoBreak]", ")"}],
   Function[BoxForm`e$, 
    MatrixForm[BoxForm`e$]]]}]], "Echo",
 CellChangeTimes->{
  3.982164587199041*^9},ExpressionUUID->"b4f05b61-e8af-4851-9b72-\
42310aba9aa2"],

Cell[BoxData[
 StyleBox["\<\"QED\[VeryThinSpace]\[VeryThinSpace]\[VeryThinSpace]\
\[FilledSquare]\"\>",
  StripOnInput->False,
  LineColor->RGBColor[0.14, 0.8, 0.14],
  FrontFaceColor->RGBColor[0.14, 0.8, 0.14],
  BackFaceColor->RGBColor[0.14, 0.8, 0.14],
  GraphicsColor->RGBColor[0.14, 0.8, 0.14],
  FontSize->18,
  FontWeight->Bold,
  FontColor->RGBColor[0.14, 0.8, 0.14]]], "Print",
 CellChangeTimes->{3.982154891173793*^9, 3.982156754338201*^9, 
  3.982157146239459*^9, 3.982164178464713*^9, 3.982164587202673*^9},
 CellLabel->
  "During evaluation of \
In[66]:=",ExpressionUUID->"1cb52b20-142a-477a-8a8a-2faa9749cb4b"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "We map this angle representation in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  ExpressionUUID->"ec997283-7b55-4da2-a0ef-f8bc2163ceee"],
 " into a normalized orientation quaternion ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "c24e820e-e198-4b47-aecd-53b63a9c2082"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "fdfeb172-8bf1-4325-8080-0972d28f1101"],
 " via a matrix exponential:"
}], "Text",
 CellChangeTimes->{{3.98129780268321*^9, 3.981297854434805*^9}, {
  3.9812979318238993`*^9, 3.981297944447939*^9}, {3.981664879677372*^9, 
  3.98166491931181*^9}, {3.981710152733509*^9, 3.98171015509262*^9}, {
  3.982088420524454*^9, 
  3.982088437746337*^9}},ExpressionUUID->"abb5ffa5-76ae-4b48-97bf-\
df880a199d8d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Q", "(", "t", ")"}], "=", 
     RowBox[{
      SuperscriptBox["e", 
       RowBox[{
        RowBox[{"-", "i"}], " ", 
        FractionBox[
         RowBox[{"\[Omega]", " ", "t"}], "2"], " ", 
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           OverscriptBox["\[Omega]", "\[RightVector]"], 
           "\[FilledSmallCircle]", 
           OverscriptBox["\[Sigma]", "\[RightVector]"]}], "\[Omega]"], 
         ")"}]}]], "=", 
      RowBox[{
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", "i"}], " ", "t", " ", 
         RowBox[{"(", 
          FractionBox[
           RowBox[{
            OverscriptBox["\[Omega]", "\[RightVector]"], 
            "\[FilledSmallCircle]", 
            OverscriptBox["\[Sigma]", "\[RightVector]"]}], "2"], ")"}]}]], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"cos", "(", 
          FractionBox[
           RowBox[{"\[Omega]", " ", "t"}], "2"], ")"}], 
         SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], "  ", "-", "  ", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"sin", "(", 
          FractionBox[
           RowBox[{"\[Omega]", " ", "t"}], "2"], ")"}], 
         RowBox[{"(", 
          FractionBox[
           RowBox[{
            OverscriptBox["\[Omega]", "\[RightVector]"], 
            "\[FilledSmallCircle]", 
            OverscriptBox["\[Sigma]", "\[RightVector]"]}], "\[Omega]"], 
          ")"}]}]}]}]}]}], "\[LineSeparator]", 
    RowBox[{"=", 
     RowBox[{
      RowBox[{
       RowBox[{"cos", "(", 
        FractionBox[
         RowBox[{"\[Omega]", " ", "t"}], "2"], ")"}], 
       SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], "  ", "-", "  ", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"sin", "(", 
        FractionBox[
         RowBox[{"\[Omega]", " ", "t"}], "2"], ")"}], 
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "\[Omega]"], 
         FormBox[
          RowBox[{"(", "\[NoBreak]", GridBox[{
             {
              SubscriptBox["\[Omega]", "3"], 
              RowBox[{
               SubscriptBox["\[Omega]", "1"], "-", 
               RowBox[{"\[ImaginaryI]", " ", 
                SubscriptBox["\[Omega]", "2"]}]}]},
             {
              RowBox[{
               SubscriptBox["\[Omega]", "1"], "+", 
               RowBox[{"\[ImaginaryI]", " ", 
                SubscriptBox["\[Omega]", "2"]}]}], 
              RowBox[{"-", 
               SubscriptBox["\[Omega]", "3"]}]}
            },
            
            GridBoxAlignment->{
             "Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
            GridBoxSpacings->{"Columns" -> {
                Offset[0.27999999999999997`], {
                 Offset[0.7]}, 
                Offset[0.27999999999999997`]}, "Rows" -> {
                Offset[0.2], {
                 Offset[0.4]}, 
                Offset[0.2]}}], "\[NoBreak]"}],
          TraditionalForm]}], ")"}]}]}]}]}], ")"}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.981213580371439*^9, 3.9812139355618353`*^9}, {
  3.981214872101968*^9, 3.981214901200376*^9}, {3.98124523999442*^9, 
  3.981245253924609*^9}, {3.981245411248929*^9, 3.9812454390854073`*^9}, {
  3.981245659948629*^9, 3.981245662030323*^9}, {3.9812469646773643`*^9, 
  3.9812469718609324`*^9}, {3.981664755329146*^9, 3.981664779754422*^9}, {
  3.9817101823314877`*^9, 
  3.981710187624982*^9}},ExpressionUUID->"0c7da215-2653-4d0d-abd2-\
4dc65de0dcea"],

Cell[TextData[{
 "Here is a proof that the ",
 StyleBox["MatrixExp", "Input"],
 " equals the longhand form:"
}], "Text",
 CellChangeTimes->{{3.9812978740026207`*^9, 3.98129790728375*^9}, {
  3.981300942180106*^9, 3.981300942586491*^9}, {3.981300976586059*^9, 
  3.981300999376853*^9}, {3.981664471863002*^9, 
  3.981664493287812*^9}},ExpressionUUID->"6ab07aff-6455-4f7a-9ac5-\
808dfc96abc8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"proof", "@", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Omega]", ",", 
       RowBox[{"\[Omega]Vec", "=", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["\[Omega]", "1"], ",", 
          SubscriptBox["\[Omega]", "2"], ",", 
          SubscriptBox["\[Omega]", "3"]}], "}"}]}], ",", "lieGroupElement", ",",
        "expOfLieAlgebraElement"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"lieGroupElement", "=", "\[IndentingNewLine]", 
       RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", 
           FractionBox[
            RowBox[{"\[Omega]", " ", "t"}], "2"], "]"}], "id"}], "-", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"Sin", "[", 
           FractionBox[
            RowBox[{"\[Omega]", " ", "t"}], "2"], "]"}], 
          RowBox[{"(", 
           FractionBox[
            RowBox[{"\[Omega]Vec", ".", "\[Sigma]Vec"}], "\[Omega]"], 
           ")"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"expOfLieAlgebraElement", "=", "\[IndentingNewLine]", 
       RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"MatrixExp", "[", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", 
           RowBox[{"(", 
            FractionBox[
             RowBox[{"\[Omega]Vec", ".", "\[Sigma]Vec"}], "2"], ")"}]}], 
          "]"}], "//.", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Omega]Vec", ".", "\[Omega]Vec"}], "->", 
           SuperscriptBox["\[Omega]", "2"]}], "}"}]}], "]"}]}], ";", "\n", 
      RowBox[{"lieGroupElement", "===", "expOfLieAlgebraElement"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9812083537260036`*^9, 3.981208376137467*^9}, {
  3.981208413676469*^9, 3.98120845971517*^9}, {3.9812085430518017`*^9, 
  3.981208707326268*^9}, {3.9812089428326063`*^9, 3.981208949568116*^9}, {
  3.981209045573866*^9, 3.9812090862273493`*^9}, {3.981247013016823*^9, 
  3.98124702378316*^9}, {3.981247802452508*^9, 3.981247818313257*^9}, {
  3.9816642464289722`*^9, 3.9816644543239183`*^9}, {3.981664597767519*^9, 
  3.981664624875654*^9}, {3.981664656899098*^9, 3.981664661442689*^9}, {
  3.981710239278109*^9, 3.981710242137293*^9}, {3.981710273968265*^9, 
  3.9817102754200563`*^9}, {3.981710773347929*^9, 3.9817107813495626`*^9}, {
  3.981710845658609*^9, 3.981710867520028*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"ea615c05-75a6-4afc-84f5-d9b54dfc092f"],

