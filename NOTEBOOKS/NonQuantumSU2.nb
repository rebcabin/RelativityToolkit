                RowBox[{"I", "/", "2"}], " ", 
                RowBox[{"Tr", "[", 
                 RowBox[{"Q0Matrix", ".", 
                  RowBox[{"\[Sigma]", "[", "2", "]"}]}], "]"}]}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"q3", "[", "0", "]"}], "==", 
