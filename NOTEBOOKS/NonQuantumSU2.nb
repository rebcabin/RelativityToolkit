  3.982077049940222*^9}},ExpressionUUID->"942d7932-0423-404d-a90b-\
8d9a613ec3ce"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "q0", ",", "q1", ",", "q2", ",", "q3", ",", "qCoords", ",", "qVels", ",", 
    "qIm", ",", "su2Eqns"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qCoords", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"q0", "[", "t", "]"}], ",", 
     RowBox[{"q1", "[", "t", "]"}], ",", 
     RowBox[{"q2", "[", "t", "]"}], ",", 
     RowBox[{"q3", "[", "t", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qVels", "=", 
    RowBox[{"D", "[", 
     RowBox[{"qCoords", ",", "t"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"Q", ",", "qIm", ",", "QDag"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"qIm", "[", "t_", "]"}], " ", ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"q1", "[", "t", "]"}], ",", 
      RowBox[{"q2", "[", "t", "]"}], ",", 
      RowBox[{"q3", "[", "t", "]"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", " ", "\"\<Imaginary part\>\"", " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Q", "[", "t_", "]"}], "   ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"q0", "[", "t", "]"}], " ", "id"}], "  ", "-", "  ", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{
      RowBox[{"qIm", "[", "t", "]"}], " ", ".", " ", "\[Sigma]Vec"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"QDag", "[", "t_", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Q", "[", "t", "]"}], "\[ConjugateTranspose]"}], "//", 
     "ComplexExpand"}], ")"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.982076588690649*^9, 3.9820766110857773`*^9}, {
  3.982076986389456*^9, 3.9820770174947166`*^9}},
 CellLabel->
  "In[114]:=",ExpressionUUID->"c33b72f5-b941-43f2-a958-0c79ef8e3c30"]
}, Open  ]],

