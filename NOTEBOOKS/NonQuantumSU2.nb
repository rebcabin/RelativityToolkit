93d9197b69f2"],

Cell[TextData[{
 StyleBox["\[OpenCurlyDoubleQuote]Faithfully\[CloseCurlyDoubleQuote] means \
that the entire Lie Group",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "79c3faf1-a10f-4e6a-a095-177641050559"],
 " ",
 StyleBox["can be smoothly covered by the unit quaternions as a coordinate \
chart with no singularities.",
  FontSlant->"Italic"],
 " ",
 StyleBox["Any abstract \[OpenCurlyDoubleQuote]point\[CloseCurlyDoubleQuote] \
in the manifold",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "38e96d0e-3040-406d-9584-bd0fc9ecd728"],
 StyleBox[" is uniquely specified by a unit quaternion ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],ExpressionUUID->
  "b9b6a523-ddc2-4af1-906c-70ef6bf6dfc4"],
 StyleBox[" and vice versa. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGCQBGIQ/Yw5Z5r1yreOX75LLwLRcZ7560C02C3f9SCaY4/6
