   RowBox[{
    RowBox[{"-", "q2"}], ",", 
    RowBox[{"-", "q3"}], ",", "q0", ",", "q1"}], "}"}]}]], "Echo",
 CellChangeTimes->{
  3.982164606260934*^9},ExpressionUUID->"7aa13076-9e58-45f2-a4d6-\
479ef89e968a"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"derived v3 :\"\>",
   "EchoLabel"], "  ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"-", "q3"}], ",", "q2", ",", 
    RowBox[{"-", "q1"}], ",", "q0"}], "}"}]}]], "Echo",
 CellChangeTimes->{
  3.9821646062637873`*^9},ExpressionUUID->"85e7934c-845c-49c1-9fdf-\
731982f085a9"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9b4bbcef-c33e-454f-bd2c-efba50ea0ff4"],
 " is the radial direction (gradient of the sphere constraint)."
}], "Text",
 CellChangeTimes->{{3.9820757951850967`*^9, 
  3.982075805171898*^9}},ExpressionUUID->"a352b9b2-985d-4a89-a2a2-\
c225465f9ee8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"derivedV0", "=", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"q", " ", ".", " ", "q"}], ",", 
        RowBox[{"{", "q", "}"}]}], "]"}], "/", "2"}]}], 
