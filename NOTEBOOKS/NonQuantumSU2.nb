Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"interactivePlotsOfODEs", "[", "odes_", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"DynamicModule", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
        "Q\[Eta]", ",", "Q\[Delta]", ",", "Q0Matrix", ",", "OmegaBody0", ",", 
         "dQ0Matrix", ",", "\[IndentingNewLine]", "q0x", ",", "q1x", ",", 
         "q2x", ",", "q3x", ",", "\[IndentingNewLine]", "Dq0x", ",", "Dq1x", ",",
          "Dq2x", ",", "Dq3x", ",", "\[IndentingNewLine]", "flt", ",", "ics", 
         ",", "soln"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Dynamically", " ", "map", " ", "sliders", " ", "to", " ", "SU", 
         RowBox[{"(", "2", ")"}], " ", "initial", " ", "conditions"}], "*)"}],
        " ", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Q\[Eta]", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{
             RowBox[{"-", "\[Eta]0"}], "/", "2"}], "]"}], " ", "id"}], "-", 
          RowBox[{"\[ImaginaryI]", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{
             RowBox[{"-", "\[Eta]0"}], "/", "2"}], "]"}], " ", 
           RowBox[{"\[Sigma]", "[", "1", "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Q\[Delta]", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"\[Delta]0", "/", "2"}], "]"}], " ", "id"}], "-", 
          RowBox[{"\[ImaginaryI]", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Delta]0", "/", "2"}], "]"}], " ", 
           RowBox[{"\[Sigma]", "[", "2", "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Q0Matrix", "=", 
         RowBox[{"Q\[Eta]", " ", ".", " ", "Q\[Delta]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"OmegaBody0", "=", 
         RowBox[{"D\[Psi]0", "*", 
          RowBox[{"\[Sigma]", "[", "3", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dQ0Matrix", "=", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"\[ImaginaryI]", "/", "2"}], ")"}]}], "*", 
          RowBox[{"Q0Matrix", " ", ".", " ", "OmegaBody0"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ics", "=", 
         RowBox[{"ComplexExpand", "[", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"q0", "[", "0", "]"}], "==", 
             RowBox[{
              RowBox[{"1", "/", "2"}], " ", 
              RowBox[{"Tr", "[", "Q0Matrix", "]"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"q1", "[", "0", "]"}], "==", 
             RowBox[{
              RowBox[{"I", "/", "2"}], " ", 
              RowBox[{"Tr", "[", 
               RowBox[{"Q0Matrix", " ", ".", " ", 
                RowBox[{"\[Sigma]", "[", "1", "]"}]}], "]"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"q2", "[", "0", "]"}], "==", 
             RowBox[{
              RowBox[{"I", "/", "2"}], " ", 
              RowBox[{"Tr", "[", 
               RowBox[{"Q0Matrix", " ", ".", " ", 
                RowBox[{"\[Sigma]", "[", "2", "]"}]}], "]"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"q3", "[", "0", "]"}], "==", 
             RowBox[{
              RowBox[{"I", "/", "2"}], " ", 
              RowBox[{"Tr", "[", 
               RowBox[{"Q0Matrix", " ", ".", " ", 
                RowBox[{"\[Sigma]", "[", "3", "]"}]}], "]"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"q0", "'"}], "[", "0", "]"}], "==", 
             RowBox[{
              RowBox[{"1", "/", "2"}], " ", 
              RowBox[{"Tr", "[", "dQ0Matrix", "]"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"q1", "'"}], "[", "0", "]"}], "==", 
             RowBox[{
              RowBox[{"I", "/", "2"}], " ", 
              RowBox[{"Tr", "[", 
               RowBox[{"dQ0Matrix", " ", ".", " ", 
                RowBox[{"\[Sigma]", "[", "1", "]"}]}], "]"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"q2", "'"}], "[", "0", "]"}], "==", 
             RowBox[{
              RowBox[{"I", "/", "2"}], " ", 
              RowBox[{"Tr", "[", 
               RowBox[{"dQ0Matrix", " ", ".", " ", 
                RowBox[{"\[Sigma]", "[", "2", "]"}]}], "]"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"q3", "'"}], "[", "0", "]"}], "==", 
             RowBox[{
              RowBox[{"I", "/", "2"}], " ", 
              RowBox[{"Tr", "[", 
               RowBox[{"dQ0Matrix", " ", ".", " ", 
                RowBox[{"\[Sigma]", "[", "3", "]"}]}], "]"}]}]}]}], "}"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"NDSolve", " ", "the", " ", "ODEs"}], "*)"}], " ", 
        "\[IndentingNewLine]", 
        RowBox[{"soln", "=", 
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"q0", "''"}], "[", "t", "]"}], "==", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"q0", "''"}], "[", "t", "]"}], "/.", " ", "odes"}],
                  ")"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"q1", "''"}], "[", "t", "]"}], "==", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"q1", "''"}], "[", "t", "]"}], "/.", " ", "odes"}],
                  ")"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"q2", "''"}], "[", "t", "]"}], "==", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"q2", "''"}], "[", "t", "]"}], "/.", " ", "odes"}],
                  ")"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"q3", "''"}], "[", "t", "]"}], "==", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"q3", "''"}], "[", "t", "]"}], "/.", " ", "odes"}],
                  ")"}]}], ",", "ics"}], "}"}], "]"}], "/.", " ", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"substitute", " ", "hard"}], "-", 
              RowBox[{
              "coded", " ", "value", " ", "for", " ", "I1", " ", "in", " ", 
               "I3", " ", "so", " ", "that", " ", "Replace", " ", "can", " ", 
               "reduce", " ", "in", " ", "one", " ", "shot"}]}], "*)"}], " ", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"m", "->", "1"}], ",", 
              RowBox[{"cz", "->", "1.2"}], ",", 
              RowBox[{"I1", "->", 
               SuperscriptBox["1.2", "2"]}], ",", 
              RowBox[{"I3", "->", 
               RowBox[{"rI31", "*", 
                SuperscriptBox["1.2", "2"]}]}]}], "}"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"q0", "[", "t", "]"}], ",", 
             RowBox[{"q1", "[", "t", "]"}], ",", 
             RowBox[{"q2", "[", "t", "]"}], ",", 
             RowBox[{"q3", "[", "t", "]"}], ",", 
             RowBox[{
              RowBox[{"q0", "'"}], "[", "t", "]"}], ",", 
             RowBox[{
              RowBox[{"q1", "'"}], "[", "t", "]"}], ",", 
             RowBox[{
              RowBox[{"q2", "'"}], "[", "t", "]"}], ",", 
             RowBox[{
              RowBox[{"q3", "'"}], "[", "t", "]"}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "tLim"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Extract", " ", "the", " ", "8", " ", "interpolating", " ", 
          "functions"}], "*)"}], " ", "\[IndentingNewLine]", 
        RowBox[{"q0x", "=", 
         RowBox[{"soln", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
        RowBox[{"Dq0x", "=", 
         RowBox[{"soln", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "5", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"q1x", "=", 
         RowBox[{"soln", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2", ",", "2"}], "]"}], "]"}]}], ";", 
        RowBox[{"Dq1x", "=", 
         RowBox[{"soln", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "6", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"q2x", "=", 
         RowBox[{"soln", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "3", ",", "2"}], "]"}], "]"}]}], ";", 
        RowBox[{"Dq2x", "=", 
         RowBox[{"soln", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "7", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"q3x", "=", 
         RowBox[{"soln", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "4", ",", "2"}], "]"}], "]"}]}], ";", 
        RowBox[{"Dq3x", "=", 
         RowBox[{"soln", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "8", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"flt", "=", 
         RowBox[{"\"\<(\!\(\*SubscriptBox[\(\[Delta]\), \(0\)]\)) = \>\"", "<>", 
          RowBox[{"ToString", "[", "\[Delta]0", "]"}], 
          "<>", "\"\<\[Degree], (\!\(\*SubscriptBox[\(\[Eta]\), \(0\)]\)) = \
\>\"", "<>", 
          RowBox[{"ToString", "[", "\[Eta]0", "]"}], 
          "<>", "\"\<\[Degree], \!\(\*SubscriptBox[\(\[Psi]\), \(0\)]\)' = \>\
\"", "<>", 
          RowBox[{"ToString", "[", "D\[Psi]0", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"GraphicsGrid", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Plot", "[", 
