  "0b375b6f-e082-48b6-8bc4-065f3253815a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["Q", "\[FilledSmallCircle]"], "(", "t", ")"}], 
