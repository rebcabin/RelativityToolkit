Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"proof", "@", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Q", ",", "X", ",", "Qdot", ",", "Dconstraint", ",", "tr"}], 
      " ", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"arbitrary", " ", "member", " ", "of", " ", "SU", 
        RowBox[{"(", "2", ")"}], " ", "on", " ", "a", " ", "curve"}], ";", 
       " ", 
       RowBox[{"take", " ", "on", " ", "faith", " ", "for", " ", "now"}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Q", "[", "t", "]"}], "=", 
       RowBox[{"(", GridBox[{
          {
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], "+", 
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"y", "[", "t", "]"}]}]}], 
           RowBox[{
            RowBox[{"u", "[", "t", "]"}], "+", 
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"v", "[", "t", "]"}]}]}]},
          {
           RowBox[{
            RowBox[{"-", 
             RowBox[{"u", "[", "t", "]"}]}], "+", 
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"v", "[", "t", "]"}]}]}], 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], "-", 
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"y", "[", "t", "]"}]}]}]}
         }], ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Determinant", " ", "is", " ", "square", " ", "norm", " ", "and", " ", 
        "equal", " ", "to", " ", "1"}], " ", "*)"}], " ", 
      "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{"Det", "[", 
         RowBox[{"Q", "[", "t", "]"}], "]"}], ",", "\"\<Det[Q] :\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Dconstraint", "=", 
       RowBox[{"Echo", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Det", "[", 
             RowBox[{"Q", "[", "t", "]"}], "]"}], ",", "t"}], "]"}], "==", 
          "0"}], ",", "\"\<Dconstraint :\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Qdot", "[", "t", "]"}], "=", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Q", "[", "t", "]"}], ",", "t"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"X", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Qdot", "[", "t", "]"}], ".", 
              RowBox[{
               RowBox[{"Q", "[", "t", "]"}], "\[ConjugateTranspose]"}]}], 
             ")"}], "//", "ComplexExpand"}]}], ")"}], "//", "Short"}], 
        ",", "\"\<X = \!\(\*OverscriptBox[\(Q\), \
\(\[FilledSmallCircle]\)]\)[t].Q[t]\[ConjugateTranspose] \[Element] \
\[GothicS]\[GothicU](2) :\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{"tr", "=", 
