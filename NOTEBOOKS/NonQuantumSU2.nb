iBaJXWMxCUhLLGC3BdFSda6bpwJpgSLDLSBaPer1Y7PVbx3ttQqfg+hl/zt/
RADpNJ/Hv0H0kx+/OCKBtMKBWi4QPX+3pxyInnN5Pph+mfRHAyzulaUJogFm
38xN
  "],ExpressionUUID->"882acad9-a317-442f-8061-3d81dc874304"],

Cell[TextData[{
 "There is a lot of material in this chapter, but the payoff in the next \
chapter is a concise and elegant geometric derivation of the equations of \
motion as geodesics in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "7467b1f6-59f9-4d22-9b82-3c723c3bcd01"],
 ", exactly parallel to the derivation vetted previously for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"O", "(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "59ac9219-750d-4b43-9767-849cdd549593"],
 ". "
}], "Text",
 CellChangeTimes->{{3.981412216666863*^9, 3.981412541021722*^9}, {
   3.981453609466157*^9, 3.9814536801716137`*^9}, {3.9814537378941936`*^9, 
   3.9814537387569304`*^9}, {3.9814537716162367`*^9, 3.981453822717458*^9}, {
   3.981503100644874*^9, 3.981503224303117*^9}, {3.981552804526195*^9, 
   3.9815528071383057`*^9}, {3.981552842103586*^9, 3.9815528446605263`*^9}, {
   3.981623807488196*^9, 3.9816238280885572`*^9}, {3.981623863232586*^9, 
   3.981623942003899*^9}, {3.98162401039598*^9, 3.981624016993409*^9}, {
