Cell[TextData[{
 "As noted in the ",
 StyleBox["Summary",
  FontSlant->"Italic"],
 " above, we will subject a 3\[NoBreak]-\[NoBreak]vector representative \
(traceless, Hermitian) to a rotation by adjoint action, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", ".", "v", ".", 
    RowBox[{"Q", "\[ConjugateTranspose]"}]}], TraditionalForm]],
  ExpressionUUID->"09f96151-bb91-4fb0-802e-1cb2215fb18d"],
 "."
}], "Text",
 CellChangeTimes->{{3.9816439014774437`*^9, 3.981644036117754*^9}, 
   3.981659155343011*^9},ExpressionUUID->"5a56130f-0c7d-4b03-8622-\
916735d53451"]
}, Open  ]],

