  ExpressionUUID->"0d1834a9-9fb5-41ad-a28d-8eaccde5179a"],
 " in the \[CapitalOmega] body-frame; proofs below ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["\[Omega]", "0"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0c6c76cd-a7ce-45f8-b845-b080fd8588ce"],
 " is the radial direction, constrained to the hypersphere ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["S", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b8f4035b-a97d-4021-b7ef-15dc280a2122"],
