Cell[CellGroupData[{

Cell["Pauli Matrices as Hermitian Basis for 3\[NoBreak]-\[NoBreak]Vectors", \
"Section",
 CellChangeTimes->{{3.981041086480864*^9, 3.9810410899001627`*^9}, {
  3.9812923032788143`*^9, 3.981292335107334*^9}, {3.9812933682677917`*^9, 
  3.981293380497038*^9}, {3.981295718534451*^9, 3.981295718963603*^9}, {
  3.98130144857852*^9, 3.981301454623399*^9}, {3.9813015090845757`*^9, 
  3.98130153056994*^9}, {3.981301571677268*^9, 3.981301574745447*^9}, {
  3.981732078497809*^9, 3.981732093302226*^9}, {3.9820877527250566`*^9, 
  3.982087765406342*^9}},ExpressionUUID->"6cbf01d3-6acc-41fa-9550-\
b965e44c7496"],

Cell[TextData[{
 "Any linear combination of the three Pauli matrices ",
 StyleBox["with real coefficients",
  FontSlant->"Italic"],
 " is traceless and Hermitian. Therefore, any real \
3\[NoBreak]-\[NoBreak]vector, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x", ",", "y", ",", "z"}], ")"}], "\[Element]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "3"]}], TraditionalForm]],
  ExpressionUUID->"030da1b5-57d3-4841-9ed6-fb1733963e65"],
 ", can be represented as a 2\[Times]2, traceless, Hermitian matrix, and vice \
versa, as follows:"
}], "Text",
 CellChangeTimes->{{3.981212919712832*^9, 3.981212938345106*^9}, {
   3.981213378090358*^9, 3.981213393668622*^9}, {3.981220128115487*^9, 
   3.9812201763839006`*^9}, {3.9812436233602324`*^9, 3.981243625896122*^9}, {
   3.981244927722176*^9, 3.981244931080924*^9}, {3.981302892834606*^9, 
   3.98130290060119*^9}, {3.9814524280021772`*^9, 3.981452438195334*^9}, {
   3.981453518259068*^9, 3.981453541173064*^9}, 3.981455678612665*^9, {
   3.981455797058235*^9, 3.981455805064909*^9}, 3.981622595564919*^9, {
   3.981624950275565*^9, 3.981624951088456*^9}, {3.981636484540728*^9, 
   3.981636503379808*^9}, {3.9816365561442957`*^9, 3.9816365576531687`*^9}, {
   3.981728548035123*^9, 3.981728588478167*^9}, {3.98172873324759*^9, 
   3.9817287364530983`*^9}, {3.9817321697289667`*^9, 
   3.981732205040503*^9}},ExpressionUUID->"a192bd7e-ad27-47cc-9438-\
0a92fb6b9a98"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"\[Sigma]", ",", "\[Sigma]Vec", ",", "id"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]Vec", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", "3"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"id", "=", 
   RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]Vec", "[", 
    RowBox[{"[", "1", "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{"\[Sigma]", "[", "1", "]"}], "=", 
    RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]Vec", "[", 
    RowBox[{"[", "2", "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{"\[Sigma]", "[", "2", "]"}], "=", 
    RowBox[{"PauliMatrix", "[", "2", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]Vec", "[", 
    RowBox[{"[", "3", "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{"\[Sigma]", "[", "3", "]"}], "=", 
    RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"MatrixForm", "/@", "\[Sigma]Vec"}], 
    ",", "\"\<Pauli matrices :\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
