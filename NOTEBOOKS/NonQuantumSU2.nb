Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"proof", "@", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "Q", ",", "Qdot", ",", "X", ",", "minusXdagger", ",", 
       "unitNormConstraint", ",", "duncdt"}], " ", "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"arbitrary", " ", "member", " ", "of", " ", "SU", 
        RowBox[{"(", "2", ")"}], " ", "on", " ", "a", " ", "curve"}], ";", 
       " ", 
       RowBox[{"take", " ", "on", " ", "faith", " ", "for", " ", "now"}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Q", "[", "t", "]"}], "=", 
       RowBox[{"(", GridBox[{
          {
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], "+", 
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"y", "[", "t", "]"}]}]}], 
           RowBox[{
            RowBox[{"u", "[", "t", "]"}], "+", 
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"v", "[", "t", "]"}]}]}]},
          {
           RowBox[{
            RowBox[{"-", 
             RowBox[{"u", "[", "t", "]"}]}], "+", 
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"v", "[", "t", "]"}]}]}], 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], "-", 
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"y", "[", "t", "]"}]}]}]}
         }], ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Q", "[", "t", "]"}], ".", 
           RowBox[{
            RowBox[{"Q", "[", "t", "]"}], "\[ConjugateTranspose]"}]}], "//", 
          "ComplexExpand"}], "//", "MatrixForm"}], 
        ",", "\"\<Q.Q\[ConjugateTranspose] :\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"unitNormConstraint", "=", 
       RowBox[{"Echo", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Q", "[", "t", "]"}], ".", 
              RowBox[{
               RowBox[{"Q", "[", "t", "]"}], "\[ConjugateTranspose]"}]}], "//",
              "ComplexExpand"}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", "1"}], 
         ",", "\"\<unit norm constraint :\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"duncdt", "=", 
       RowBox[{"Echo", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"unitNormConstraint", ",", "t"}], "]"}], 
         ",", "\"\<\[DifferentialD](unit norm constraint)/\[DifferentialD]t :\
\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Qdot", "[", "t", "]"}], "=", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Q", "[", "t", "]"}], ",", "t"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"X", "=", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Qdot", "[", "t", "]"}], ".", 
              RowBox[{
               RowBox[{"Q", "[", "t", "]"}], "\[ConjugateTranspose]"}]}], "//",
              "ComplexExpand"}], "//", 
            RowBox[{
             RowBox[{"FullSimplify", "[", 
              RowBox[{"#", ",", 
               RowBox[{"Assumptions", "->", "duncdt"}]}], "]"}], "&"}]}]}], 
          ")"}], "//", "Short"}], 
        ",", "\"\<\!\(\*OverscriptBox[\(Q\), \(\[FilledSmallCircle]\)]\).Q\
\[ConjugateTranspose] :\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"minusXdagger", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              RowBox[{"X", "\[ConjugateTranspose]"}]}], "//", 
             "ComplexExpand"}], "//", 
            RowBox[{
             RowBox[{"FullSimplify", "[", 
              RowBox[{"#", ",", 
               RowBox[{"Assumptions", "->", "duncdt"}]}], "]"}], "&"}]}]}], 
          ")"}], "//", "Short"}], 
        ",", "\"\<-(\!\(\*OverscriptBox[\(Q\), \(\[FilledSmallCircle]\)]\).Q\
\[ConjugateTranspose])\[ConjugateTranspose] :\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Echo", "[", 
       RowBox[{
        RowBox[{"X", "===", "minusXdagger"}], 
        ",", "\"\<\!\(\*OverscriptBox[\(Q\), \(\[FilledSmallCircle]\)]\).Q\
\[ConjugateTranspose] == -(\!\(\*OverscriptBox[\(Q\), \
\(\[FilledSmallCircle]\)]\).Q\[ConjugateTranspose])\[ConjugateTranspose] \
:\>\""}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.981562041264147*^9, 3.9815620444682302`*^9}, {
   3.981562321847364*^9, 3.981562386816546*^9}, {3.981562446616963*^9, 
   3.9815626738438787`*^9}, {3.981562854033347*^9, 3.981562883826893*^9}, {
