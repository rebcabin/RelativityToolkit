Cell[CellGroupData[{

Cell["Metric Tensor from Kinetic Energy", "Subsection",
 CellChangeTimes->{{3.981755043092327*^9, 3.9817550658800898`*^9}, {
  3.981755112394432*^9, 3.981755129078362*^9}, {3.981755586822369*^9, 
  3.981755601323822*^9}},ExpressionUUID->"2b619179-bb00-435d-b83c-\
fad610418db7"],

Cell[TextData[{
 "Because we use four real coordinates ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["q", "0"], ",", 
     SubscriptBox["q", "1"], ",", 
     SubscriptBox["q", "2"], ",", 
     SubscriptBox["q", "3"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "00de60ab-4571-4a50-91bf-a337d2f90763"],
 " to describe a real 3D manifold (Euclidean 3\[NoBreak]-\[NoBreak]space), \
the \[OpenCurlyDoubleQuote]natural\[CloseCurlyDoubleQuote] metric from \
kinetic energy is singular, not accounting for radial motion. The toolkit\
\[CloseCurlyQuote]s ",
 StyleBox["Inverse@metric", "Input"],
 " and Christoffel functions require a \[OpenCurlyDoubleQuote]radial \
stabilizer\[CloseCurlyDoubleQuote] term in the metric. This doesn\
\[CloseCurlyQuote]t change the physics on the sphere but makes the geometry \
non-singular."
}], "Text",
 CellChangeTimes->{{3.9817546643270807`*^9, 3.9817547719442663`*^9}, {
  3.9817548101281424`*^9, 3.981754810757135*^9}, {3.981754985058219*^9, 
  3.981754991759151*^9}, {3.9820680268641787`*^9, 3.982068100902328*^9}, {
  3.982155670802907*^9, 
  3.982155671300803*^9}},ExpressionUUID->"832f16bc-396e-4f9f-98af-\
040c3f9262c3"],

Cell[TextData[{
 "Add a 'ghost' inertia ",
 StyleBox["Iref", "Input"],
 " for the radial direction; value determined by trial-and-error (TODO: \
derive by analysis). The metric is both complicated and surprisingly regular. \
Its validity is demonstrated by the final results rather by analysis, here, \
for brevity, though analysis is a worthy TODO."
}], "Text",
 CellChangeTimes->{{3.981755043092327*^9, 3.9817550658800898`*^9}, {
   3.981755112394432*^9, 3.981755129078362*^9}, {3.981755586822369*^9, 
   3.98175562167811*^9}, 3.9818044426674557`*^9, {3.98206621492843*^9, 
   3.9820662259074163`*^9}, {3.982068111933878*^9, 3.982068188946786*^9}, {
   3.982068533431532*^9, 3.982068536853973*^9}, {3.982068832915101*^9, 
   3.9820688659043493`*^9}},ExpressionUUID->"05169974-9721-4fee-8818-\
8f8e83193783"],

