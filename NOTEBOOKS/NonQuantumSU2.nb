Cell[TextData[{
 "Conversely, any linear combination of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    OverscriptBox["\[Sigma]", "\[RightVector]"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1e68d428-8dda-4c05-8683-04de77caabd8"],
 " matrices with real coefficients is traceless and anti-Hermitian, therefore \
in \[GothicS]\[GothicU](2):"
}], "Text",
 CellChangeTimes->{{3.981753240263818*^9, 3.981753314146306*^9}, {
  3.9817533611397343`*^9, 
  3.9817533660658493`*^9}},ExpressionUUID->"4526b296-e5e0-46d0-aff8-\
3e38bb30a78d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q", "=", 
         RowBox[{"{", 
          RowBox[{
           SubscriptBox["q", "1"], ",", 
           SubscriptBox["q", "2"], ",", 
           SubscriptBox["q", "3"]}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "ComplexExpand", " ", "injects", " ", "the", " ", "assumption", " ", 
         "that", " ", "the", " ", "coefficients", " ", "are", " ", "real"}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         RowBox[{"q", ".", "\[Sigma]Vec"}]}], "//", "ComplexExpand"}]}], 
      "]"}], "//", "MatrixForm"}], 
    ",", "\"\<traceless, anti-Hermitian, in \[GothicS]\[GothicU](2) :\>\""}], 
   "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9812146102702627`*^9, 3.9812146789147367`*^9}, {
  3.981292458755094*^9, 3.981292492399829*^9}, {3.98129273224431*^9, 
