Cell[CellGroupData[{

Cell["\[Therefore] Pure Imaginary Quaternions are Isomorphic to \[GothicS]\
\[GothicU](2)", "Subsection",
 CellChangeTimes->{{3.981753866820671*^9, 3.981753929715213*^9}, {
  3.9817540412764997`*^9, 
  3.98175404327211*^9}},ExpressionUUID->"b26e2114-46ae-48ba-acb8-\
3b90eac95cbd"],

Cell["\<\
The significance of the fact that the vector or imaginary part of a \
quaternion is in \[GothicS]\[GothicU](2) is both geometric and physical, with \
two major implications: \
\>", "Text",
 CellChangeTimes->{{3.981660796151881*^9, 3.981660854913232*^9}, {
  3.9816608861751842`*^9, 3.981660931299788*^9}, {3.981660977726182*^9, 
  3.981660983009725*^9}, {3.981661532981963*^9, 3.98166156292278*^9}, {
  3.9816616618081903`*^9, 3.9816616632892733`*^9}, {3.981662306967901*^9, 
  3.981662312801372*^9}, {3.98215528875513*^9, 
  3.9821552940273323`*^9}},ExpressionUUID->"75477009-b873-496a-913a-\
cbd9f9eebb06"],

Cell[TextData[{
 "Geometrical: The Lie Group ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "0bcf878d-780f-46bf-8174-70870206cf3b"],
 " is the 3\[NoBreak]-\[NoBreak]sphere ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["S", "3"], "\[Element]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "4"]}], TraditionalForm]],
  ExpressionUUID->"ae8f07cd-627a-441e-ac51-a40000340fc9"],
 ". The identity element ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[DoubleStruckCapitalI]", "2"], TraditionalForm]],
  ExpressionUUID->"ea2af810-2c7e-4f34-aa7d-f3431b80a03b"],
 " is the point ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], ")"}], 
   TraditionalForm]],ExpressionUUID->"6225f511-11a9-4fe4-bcfc-287cd3dbdc04"],
 "\[LongDash]the \"North Pole\" of that sphere, specifying \
\[OpenCurlyDoubleQuote]no rotation.\[CloseCurlyDoubleQuote] The tangent space \
to the 3\[NoBreak]-\[NoBreak]sphere at the North Pole is the flat, 3D \
hyperplane perpendicular to the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "0"], TraditionalForm]],ExpressionUUID->
  "5f63cddc-8b72-4ecb-ba5d-cbca09e5c0bb"],
 " axis, consisting of  all points ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", 
     SubscriptBox["q", "1"], ",", 
     SubscriptBox["q", "2"], ",", 
     SubscriptBox["q", "3"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "7de8c225-d288-4ffc-a637-64e779c350cd"],
 ". In this hyperplane, the points need not square up to unity. "
}], "ItemNumbered",
 CellChangeTimes->{{3.981660796151881*^9, 3.981660854913232*^9}, {
  3.9816608861751842`*^9, 3.981660920125111*^9}, {3.981660994438501*^9, 
  3.981661040268463*^9}, {3.981661070895602*^9, 3.981661438555208*^9}, {
  3.981661491082468*^9, 3.9816615161339407`*^9}, {3.98166158657086*^9, 
  3.981661613094062*^9}, {3.981662387563683*^9, 3.981662409960794*^9}, {
  3.981709885404554*^9, 3.981709905242024*^9}, {3.982155325486109*^9, 
  3.982155325884371*^9}, {3.982157951718536*^9, 
  3.98215795413933*^9}},ExpressionUUID->"5a51e6bf-b2b5-4a42-b29c-\
548d3c6c0151"],

Cell[TextData[{
 "Physical: In classical mechanics, the rotator of a body is a unit \
quaternion ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],ExpressionUUID->
  "8876c49b-9695-4255-9597-7431f17c2b06"],
 " in the group ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "a7fc6099-0124-4f7e-b2c7-bb997d89124d"],
 ". But the angular velocity of the rotating body \[Omega] is ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "a36717f7-8131-4707-9c4e-00f333ff1679"],
 ", a vector represented in the algebra \[GothicS]\[GothicU](2), whose norm \
is not necessarily 1."
}], "ItemNumbered",
 CellChangeTimes->{{3.981660796151881*^9, 3.981660854913232*^9}, {
   3.9816608861751842`*^9, 3.981660920125111*^9}, {3.981660994438501*^9, 
   3.981661040268463*^9}, {3.981661070895602*^9, 3.98166139512206*^9}, {
   3.981661673409711*^9, 3.981661924233292*^9}, 3.981661986371272*^9, 
   3.98166203038448*^9, {3.981662421326345*^9, 3.981662443386262*^9}, {
   3.981709896541806*^9, 3.981709909862669*^9}, {3.981753984983137*^9, 
   3.9817540159608803`*^9}, {3.982155331545555*^9, 
   3.982155332618273*^9}},ExpressionUUID->"60f5d90f-f92f-40af-9285-\
252ccc384b3d"],

Cell[TextData[{
 "SUMMARY: \[GothicS]\[GothicU](2) is the vector space of pure quaternions. \
While ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[VeryThinSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "424cb1ef-c967-4025-860b-a9a1bcbd80da"],
 " describes the orientation of a system, its Lie algebra, \[GothicS]\
\[GothicU](2), describes the axis and rate of the system\[CloseCurlyQuote]s \
rotation. The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "\[ImaginaryI]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d3892c60-12dd-4ce8-9970-609acfbbdf04"],
 " factor in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    RowBox[{
     OverscriptBox["q", "\[RightVector]"], ".", 
     OverscriptBox["\[Sigma]", "\[RightVector]"]}]}], TraditionalForm]],
  ExpressionUUID->"5549044c-fa8f-4a2c-98f9-9d9b0dc665b2"],
 " ensures that the \[OpenCurlyDoubleQuote]imaginary\[CloseCurlyDoubleQuote] \
units of the matrix representation correctly mirror the anti-commuting units ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
    "\[DoubleStruckI]", ",", "\[DoubleStruckJ]", ",", "\[DoubleStruckK]"}], 
    "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0906d0d1-553c-47a8-b385-f98b86bb2b6b"],
 " of Hamilton\[CloseCurlyQuote]s quaternions."
}], "Text",
 CellChangeTimes->{{3.981660796151881*^9, 3.981660854913232*^9}, {
  3.9816608861751842`*^9, 3.981660920125111*^9}, {3.981660994438501*^9, 
  3.981661040268463*^9}, {3.981661070895602*^9, 3.98166139512206*^9}, {
  3.981661673409711*^9, 3.981661924233292*^9}, {3.981662055603793*^9, 
  3.981662176562964*^9}, {3.981662459591709*^9, 
  3.9816625631546183`*^9}},ExpressionUUID->"37ea4d2e-218e-403b-b506-\
e2432c2cd47a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Generators of Rotations", "Section",
 CellChangeTimes->{{3.981295517550191*^9, 3.981295521061105*^9}, {
  3.9816604766808567`*^9, 3.98166048631677*^9}, {3.981664983326808*^9, 
  3.981664984500078*^9}},ExpressionUUID->"213c9a40-f660-4301-9be2-\
682bb1cf715f"],

Cell[TextData[{
 "The real part, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "0"], TraditionalForm]],ExpressionUUID->
  "5ed04a81-b697-4976-af34-46f3c7884f8d"],
 ", of the quaternion ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],ExpressionUUID->
  "02b77374-ddf8-43d2-b90a-ccdb7c6cd6fa"],
 " multiplies the identity matrix. The imaginary or vector part, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["q", "\[RightVector]"], "\[Congruent]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["q", "1"], ",", 
      SubscriptBox["q", "2"], ",", 
      SubscriptBox["q", "3"]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e2ec4b4e-0146-490e-9478-ae3074f1dfa4"],
 ", which represents angular velocity, is constructed from a real \
3\[NoBreak]-\[NoBreak]vector, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["q", "\[RightVector]"], "=", 
    RowBox[{
     OverscriptBox["\[Omega]", "\[RightVector]"], "\[Congruent]", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Omega]", "1"], ",", 
       SubscriptBox["\[Omega]", "2"], ",", 
       SubscriptBox["\[Omega]", "3"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"101938a3-4260-47aa-be8f-fd91c1b7ef6c"],
 ", that points along the instantaneous \[OpenCurlyDoubleQuote]twist axis.\
\[CloseCurlyDoubleQuote] As we shall see immediately below, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "0"], TraditionalForm]],ExpressionUUID->
  "d9d4c19f-d708-45fa-b650-bca1d8ef49ae"],
 " is the cosine of half the twist ",
 StyleBox["angle",
  FontSlant->"Italic"],
 ", and the imaginary part is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "\[ImaginaryI]"}], TraditionalForm]],ExpressionUUID->
  "b267dc6d-dc9a-4fb0-a67d-f31f004db398"],
 " times the sine of half the twist angle times the normalized ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Omega]", "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"6ff3aba0-8950-4ea9-92e4-f894d48706f0"],
 " expanded in \[GothicS]\[GothicU](2), ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    RowBox[{"\[ImaginaryI]", "(", 
     RowBox[{
      RowBox[{
       OverscriptBox["\[Omega]", "\[RightVector]"], " ", ".", " ", 
       OverscriptBox["\[Sigma]", "\[RightVector]"]}], "/", 
      RowBox[{"\[LeftBracketingBar]", 
       OverscriptBox["\[Omega]", "\[RightVector]"], 
       "\[RightBracketingBar]"}]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "a526901f-a264-4011-aadd-dfe18bc4ff7c"],
 ". Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["cos", "2"], "+", 
     SuperscriptBox["sin", "2"]}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"fd9aa8cb-9c38-4f98-97a6-c1745d6e4246"],
 ", the entire quaternion is of unit magnitude even when ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "2e901586-6ff6-450b-9235-abbda2e91d3b"],
 " is not of unit magnitude. In fact, if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     OverscriptBox["q", "\[RightVector]"], "\[RightBracketingBar]"}], "=", 
    "0"}], TraditionalForm]],ExpressionUUID->
  "2cb77413-cbb6-4a10-8cbf-6e51a90c003f"],
 ", the twist vector vanishes, there is no rotation, and the entire \
quaternion is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["q", "0"], "=", "1"}], ")"}], 
    SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], TraditionalForm]],
  ExpressionUUID->"33e4e7a7-f0f8-41c1-98ca-fe30dace18b2"],
 "."
}], "Text",
 CellChangeTimes->CompressedData["
1:eJwdxXlIk3EcB+DpDmZYRNYLZVQrazbpGgpuy7kZLa0MHVHSVLLDyqO3WWQH
hZTFisUs6HCaE9NkGUUZ7ighjQ6kjGgKjnQ6cIviDUqpQUJ9P78/Hh7FPt58
