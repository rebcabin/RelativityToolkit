Cell["\<\
For numerical work, we add an equation for the Lagrange multiplier \
(constraint force) of the quaternion normalization constraint:\
\>", "Text",
 CellChangeTimes->{{3.982068959463381*^9, 
  3.982069007635412*^9}},ExpressionUUID->"b0311c5a-df3f-443f-904d-\
2e0cd211053a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Solve", " ", "for", " ", "the", " ", "highest", " ", "derivatives", " ", 
    "and", " ", "the", " ", "constraint", " ", "force"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"stateVars", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"q0", "''"}], "[", "t", "]"}], ",", 
       RowBox[{
        RowBox[{"q1", "''"}], "[", "t", "]"}], ",", 
       RowBox[{
        RowBox[{"q2", "''"}], "[", "t", "]"}], ",", 
       RowBox[{
        RowBox[{"q3", "''"}], "[", "t", "]"}], ",", 
       RowBox[{"\[Lambda]", "[", "t", "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"constraintEqn2", "=", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"q0", "[", "t", "]"}], "2"], "+", 
         SuperscriptBox[
          RowBox[{"q1", "[", "t", "]"}], "2"], "+", 
         SuperscriptBox[
          RowBox[{"q2", "[", "t", "]"}], "2"], "+", 
         SuperscriptBox[
          RowBox[{"q3", "[", "t", "]"}], "2"], "-", "1"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "==", "0"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"(", 
     RowBox[{"pureODEsE4", " ", "=", " ", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"Append", "[", 
          RowBox[{"eqns4", ",", " ", "constraintEqn2"}], "]"}], ",", " ", 
         "stateVars"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "//", "ColumnForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"Length", "[", "pureODEsE4", "]"}], 
      ",", "\"\<number of state-space ODEs :\>\""}], "]"}], 
    ";"}]}]}]], "Input",
