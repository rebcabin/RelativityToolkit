Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "TracelessQ", ",", "HermitianQ", ",", "AntiHermitianQ", ",", "UnitaryQ"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TracelessQ", "[", "m_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Tr", "[", "m", "]"}], "===", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HermitianQ", "[", "m_", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"ComplexExpand", "[", 
      RowBox[{"m", "\[ConjugateTranspose]"}], "]"}], "===", 
     RowBox[{"ComplexExpand", "[", "m", "]"}]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AntiHermitianQ", "[", "m_", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"ComplexExpand", "[", 
      RowBox[{"m", "\[ConjugateTranspose]"}], "]"}], "===", 
     RowBox[{"ComplexExpand", "[", 
      RowBox[{"-", "m"}], "]"}]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"UnitaryQ", "[", "m_", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"m", "\[ConjugateTranspose]"}], ".", "m"}], "===", 
     RowBox[{"m", ".", 
      RowBox[{"m", "\[ConjugateTranspose]"}]}], "===", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ")"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9815630050177794`*^9, 3.981563015410185*^9}, {
   3.981586635085292*^9, 3.98158665599544*^9}, 3.981587697348267*^9, {
   3.98159366444825*^9, 3.981593686890127*^9}, {3.981622624977765*^9, 
   3.981622638072921*^9}, {3.981623408043297*^9, 3.981623445044952*^9}, {
   3.981623647364645*^9, 3.981623694923276*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"2d704519-ef84-40ae-99ac-6e8365b09621"]
}, Open  ]]
}, Open  ]],

