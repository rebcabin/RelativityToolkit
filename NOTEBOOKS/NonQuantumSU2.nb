Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "coords3", ",", "vels3", ",", "v3", ",", "\[CapitalGamma]3", ",", "I3", ",",
     "I1", ",", "cz", ",", "m", ",", "t", ",", "V"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords3", "=", 
   RowBox[{"{", 
    RowBox[{"\[Delta]", ",", "\[Eta]", ",", "\[Psi]"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"metric3", "=", 
   RowBox[{"(", GridBox[{
      {"I1", "0", "0"},
      {"0", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"I1", " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Delta]", "]"}], "2"]}], "+", 
         RowBox[{"I3", " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Delta]", "]"}], "2"]}]}], ")"}], 
       RowBox[{"I3", " ", 
        RowBox[{"Sin", "[", "\[Delta]", "]"}]}]},
      {"0", 
       RowBox[{"I3", " ", 
        RowBox[{"Sin", "[", "\[Delta]", "]"}]}], "I3"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g3", "=", 
   RowBox[{"MakeIndexer", "[", 
    RowBox[{"metric3", ",", "coords3"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ig3", "=", 
    RowBox[{"MakeIndexer", "[", 
     RowBox[{
      RowBox[{"Inverse", "@", "metric3"}], ",", "coords3"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vels3", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"c", "|->", 
      RowBox[{
       RowBox[{"c", "'"}], "[", "t", "]"}]}], ")"}], "/@", "coords3"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"v3", "=", 
    RowBox[{"MakeIndexer", "[", 
     RowBox[{"vels3", ",", "coords3"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V", "=", 
    RowBox[{"m", " ", "g", " ", "cz", " ", 
     RowBox[{"Cos", "[", "\[Delta]", "]"}], 
     RowBox[{"Cos", "[", "\[Eta]", "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalGamma]3", "[", 
    RowBox[{"\[Mu]_", ",", "\[Nu]_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{"ChristoffelsFromMetricIndexer", "[", 
    RowBox[{
    "g3", ",", "ig3", ",", "\[Mu]", ",", "\[Nu]", ",", "\[Lambda]", ",", 
     "coords3"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"ad3", "=", 
    RowBox[{
     RowBox[{"AbsoluteDerivativeFromConnectionIndexer", "[", 
      RowBox[{"v3", ",", "\[CapitalGamma]3", ",", "t", ",", "coords3"}], 
      "]"}], "//", "FullSimplify"}]}], ")"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"pf3", "=", 
     RowBox[{
      RowBox[{"PotentialScalarFieldFromMetricIndexer", "[", 
       RowBox[{"V", ",", "ig3", ",", "t", ",", "coords3"}], "]"}], "//", 
      "FullSimplify"}]}], ")"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"eqns3", "=", 
    RowBox[{
     RowBox[{"MapThread", "[", 
      RowBox[{"Equal", ",", 
       RowBox[{"{", 
        RowBox[{"ad3", ",", "pf3"}], "}"}]}], "]"}], "//", "FullSimplify"}]}],
    ")"}], ";"}]}], "Input",
 CellChangeTimes->{{3.980332732537895*^9, 3.980332745377611*^9}, {
   3.980550302707077*^9, 3.9805503549489202`*^9}, {3.9805523334915524`*^9, 
   3.980552360685157*^9}, {3.980552404731217*^9, 3.980552405077479*^9}, {
   3.980886261038479*^9, 3.980886262860896*^9}, {3.9810179923771467`*^9, 
   3.981017993886691*^9}, {3.9810182619601192`*^9, 3.981018298618558*^9}, {
   3.9811010507886257`*^9, 3.9811010585267057`*^9}, {3.981733546126652*^9, 
   3.981733558068005*^9}, 3.981733612107936*^9, {3.981733742025834*^9, 
   3.981733742135271*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"82f02fbe-510d-4320-b37d-f4cfa650bbca"]
