      RowBox[{
       RowBox[{"v", ".", "\[Sigma]Vec"}], "//", "MatrixForm"}], ",", 
      "\[IndentingNewLine]", "\"\<any vector expanded in Pauli basis :\>\""}],
      "]"}]}], "]"}], ";"}]}], "Input",
