Cell[TextData[{
 "The vector components cannot, in general, be complex. For example, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ImaginaryI]", " ", 
    SubscriptBox["\[Sigma]", "1"]}], TraditionalForm]],
  FontSlant->"Plain",ExpressionUUID->"4ad800ba-6611-418b-afff-dbb7467c02e2"],
 " is not Hermitian, i.e., equal to its conjugate transpose:"
}], "Text",
 CellChangeTimes->{{3.981295975126667*^9, 3.981295995358852*^9}, {
  3.981296274508029*^9, 3.981296276242737*^9}, {3.981296956563532*^9, 
