  "],ExpressionUUID->"f4942b9f-4c24-463f-ac5c-742e48c8e650"],

Cell[CellGroupData[{

Cell[TextData[{
 "The Vector Part of a Quaternion is in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  ExpressionUUID->"012e5df5-45b9-4ac3-91c7-5bd0d44af6d8"]
}], "Subsection",
 CellChangeTimes->{{3.981457945311849*^9, 
  3.981457974322116*^9}},ExpressionUUID->"41f301e4-0f10-4b48-8b29-\
04875f3c53bd"],

Cell[TextData[{
 "The vector part, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    RowBox[{
     OverscriptBox["q", "\[RightVector]"], ".", 
     OverscriptBox["\[Sigma]", "\[RightVector]"]}]}], TraditionalForm]],
  ExpressionUUID->"c03413cb-51f4-4c59-a10f-f5959c5926af"],
 ", is a member of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicU]", "(", "2", ")"}], TraditionalForm]],
  ExpressionUUID->"e083033b-f652-48e5-b66b-bd87d06a0476"],
 " because the ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "86537cb6-2291-4614-bebe-bd9d02ad4124"],
 " are real."
}], "Text",
 CellChangeTimes->{{3.98145748336665*^9, 3.981457495132287*^9}, {
   3.981457771925706*^9, 3.9814578041281567`*^9}, {3.9814579849379463`*^9, 
   3.9814579958329487`*^9}, {3.98150095254294*^9, 3.981500963777707*^9}, 
   3.9816603054834337`*^9, 3.9817531681192503`*^9, {3.981753419697795*^9, 
   3.9817534610963373`*^9}, {3.9817535158195868`*^9, 3.981753520566777*^9}, {
   3.982155179675509*^9, 
   3.982155181573534*^9}},ExpressionUUID->"01223c3f-729b-4e61-94f9-\
6ed0baea556d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The basis of \[GothicS]\[GothicU](2) Models Hamilton\[CloseCurlyQuote]s \
Imaginary Units", "Subsection",
 CellChangeTimes->{{3.981752983765498*^9, 3.981753062141595*^9}, {
  3.981753537623455*^9, 
  3.9817535710507317`*^9}},ExpressionUUID->"7d12b8c4-76bb-40c6-83e3-\
9cdc063fe32a"],

Cell[TextData[{
 "The following proofs show that the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     OverscriptBox["\[Sigma]", "\[RightVector]"]}], ")"}], TraditionalForm]],
  ExpressionUUID->"c1581ea5-1d9d-463b-a702-f17992ae0cf3"],
 " model Hamilton\[CloseCurlyQuote]s imaginary quaternion units ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
    "\[DoubleStruckI]", ",", "\[DoubleStruckJ]", ",", "\[DoubleStruckK]"}], 
    "}"}], TraditionalForm]],ExpressionUUID->
  "e0a2dc72-b68f-4c1c-aa0f-1af43516d9a5"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[DoubleStruckI]", "2"], "=", 
     RowBox[{
      SuperscriptBox["\[DoubleStruckJ]", "2"], "=", 
      RowBox[{
       SuperscriptBox["\[DoubleStruckK]", "2"], "=", 
       RowBox[{"-", "1"}]}]}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "4b5ccb42-227d-4dce-a6c2-6d0ddfc34719"],
 " (they are imaginary), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleStruckI]", " ", "\[DoubleStruckJ]"}], "=", 
    "\[DoubleStruckK]"}], TraditionalForm]],ExpressionUUID->
  "09851303-5863-46f3-adf9-fde2bdd9c65d"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleStruckJ]", " ", "\[DoubleStruckK]"}], "=", 
    "\[DoubleStruckI]"}], TraditionalForm]],ExpressionUUID->
  "b2871510-92a4-4fb2-a4fa-bc9ee52183c0"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleStruckK]", " ", "\[DoubleStruckI]"}], "=", 
    "\[DoubleStruckJ]"}], TraditionalForm]],ExpressionUUID->
  "b29408b5-f3d9-4554-8d99-b7a3f5808560"],
 " (cyclic property), and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"\[DoubleStruckI]", " ", "\[DoubleStruckJ]"}], "=", 
     RowBox[{
      RowBox[{"-", "\[DoubleStruckJ]"}], " ", "\[DoubleStruckI]"}]}], ")"}], 
   TraditionalForm]],ExpressionUUID->"b1191011-9b3c-4b10-895e-316026012938"],
 ", etc. (anti-commutativity). "
}], "Text",
 CellChangeTimes->{{3.981638727159748*^9, 3.9816388062809553`*^9}, {
  3.981639263547964*^9, 3.981639268152771*^9}, {3.98163945307794*^9, 
  3.981639465879076*^9}, {3.981640804063472*^9, 3.9816408610678673`*^9}, {
  3.9816413424750834`*^9, 3.981641434829411*^9}, {3.9816589571386766`*^9, 
  3.9816589661454487`*^9}, {3.981753654871498*^9, 3.981753804834119*^9}, {
  3.982155197269376*^9, 
  3.982155241414318*^9}},ExpressionUUID->"c48bdbfc-30bf-4dd7-b0a5-\
9d1610e28bb9"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    OverscriptBox["\[Sigma]", "\[RightVector]"]}], TraditionalForm]],
  ExpressionUUID->"7194cba6-0a5e-442e-a60b-5037d47bf37b"],
 " is Imaginary"
}], "Subsubsection",
 CellChangeTimes->{{3.981637671153265*^9, 3.981637673472602*^9}, {
  3.981638825077207*^9, 3.981638827862832*^9}, {3.981639275869754*^9, 
  3.9816393212765102`*^9}, {3.981639794961607*^9, 3.98163980401682*^9}, {
  3.981640811748452*^9, 3.981640819325206*^9}, {3.981640987067906*^9, 
  3.981640990302387*^9}},ExpressionUUID->"e6ca25e5-ccaf-4c9c-990c-\
29f50067fc26"],

Cell[TextData[{
 "Every ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    SubscriptBox["\[Sigma]", "k"]}], TraditionalForm]],ExpressionUUID->
  "ffa3f44d-d99a-4a37-8593-d9c63c4ded5c"],
 " squares to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["\[DoubleStruckCapitalI]", "2"]}], TraditionalForm]],
  ExpressionUUID->"95e19cd4-a59e-45f3-9f45-2c760cfc8c87"],
 ", modeling Hamilton\[CloseCurlyQuote]s imaginary units."
}], "Text",
 CellChangeTimes->{{3.981639162822219*^9, 3.981639212371848*^9}, {
   3.981641036690322*^9, 3.981641037514524*^9}, {3.9816410933711987`*^9, 
   3.981641110135867*^9}, 
   3.98175185507197*^9},ExpressionUUID->"8c4a9444-6c75-4be8-ae1d-\
b9247ceb94fc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"proof", "@", 
   RowBox[{"Echo", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"And", "@@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", 
            RowBox[{"\[Sigma]", "[", "k", "]"}]}], ")"}], ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", 
            RowBox[{"\[Sigma]", "[", "k", "]"}]}], ")"}]}], "===", 
         RowBox[{"-", "id"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", \
"\"\<-\[ImaginaryI]\[VeryThinSpace]\!\(\*SubscriptBox[\(\[Sigma]\), \(k\)]\) \
squares to -\!\(\*SubscriptBox[\(\[DoubleStruckCapitalI]\), \(2\(\\\ \
\)\(:\)\)]\)\>\""}], "]"}]}], ";"}]], "Input",
