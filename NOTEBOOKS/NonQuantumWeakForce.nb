Cell[CellGroupData[{

Cell["3. Fields and the Covariant Derivative", "Section",ExpressionUUID->"761c3014-8c99-422a-b955-6325ae3182bf"],

Cell[TextData[{
 "We define the doublet field \[Psi] (e.g., representing the lepton doublet \
or Higgs doublet):\n    \[Psi] = {\[Psi]1, \[Psi]2}\n\nThe three ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[InvisibleSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a02f1434-d94b-4c19-ae83-8b26835c384a"],
 " vector boson gauge fields are W_\[Mu]^1, W_\[Mu]^2, and W_\[Mu]^3. We \
collect them into a matrix-valued connection:\n    W_\[Mu] = W_\[Mu]^a * T^a\n\
\nThen the gauge-covariant derivative of the doublet is:\n    D_\[Mu] \[Psi] \
= CD[\[Psi], x_\[Mu]] + g * W_\[Mu] . \[Psi]"
}], "Text",
 CellChangeTimes->{{3.991476997060299*^9, 
  3.991477004349895*^9}},ExpressionUUID->"4f569498-4398-4090-8b53-\
97089cd80b57"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"doublet", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"\[Psi]1", ",", " ", "\[Psi]2"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"WMatrix", "[", "\[Nu]_", "]"}], " ", ":=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"W", "[", "a", "]"}], "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "]"}], " ", "*", " ", 
      RowBox[{"T", "[", "a", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"6e68514c-0710-4055-ac49-58d74e5692ba"],

Cell["\<\
Now compute the covariant derivative using the component-wise list CD:\
\>", "Text",ExpressionUUID->"63a45850-8ba5-411b-be88-486cc74b124d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"cde", " ", "=", " ", 
  RowBox[{
   RowBox[{"CD", "[", 
    RowBox[{"doublet", ",", " ", 
     RowBox[{"x", "[", 
      RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], "]"}], " ", "+",
    " ", 
   RowBox[{"g", " ", "*", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"WMatrix", "[", "\[Mu]", "]"}], " ", ".", " ", "doublet"}], 
     ")"}]}]}]}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"4802198f-3bab-46d0-aa46-d5bf0a0c9928"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SubscriptBox["\[Psi]1", 
     RowBox[{",", "\[Mu]"}]], "+", 
    RowBox[{"g", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Psi]2", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"W", "[", "1", "]"}], 
             SubscriptBox["", "\[Mu]"]}], ")"}]}], "-", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"W", "[", "2", "]"}], 
             SubscriptBox["", "\[Mu]"]}], ")"}]}]}], ")"}]}], "-", 
       RowBox[{
        FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "\[Psi]1", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"W", "[", "3", "]"}], 
          SubscriptBox["", "\[Mu]"]}], ")"}]}]}], ")"}]}]}], ",", 
   RowBox[{
    SubscriptBox["\[Psi]2", 
     RowBox[{",", "\[Mu]"}]], "+", 
    RowBox[{"g", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Psi]1", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"W", "[", "1", "]"}], 
             SubscriptBox["", "\[Mu]"]}], ")"}]}], "+", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"W", "[", "2", "]"}], 
             SubscriptBox["", "\[Mu]"]}], ")"}]}]}], ")"}]}], "+", 
       RowBox[{
        FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "\[Psi]2", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"W", "[", "3", "]"}], 
          SubscriptBox["", "\[Mu]"]}], ")"}]}]}], ")"}]}]}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9913421416786957`*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"d75747c6-657a-47d4-9afb-e3ebb6eed6b7"]
}, Open  ]],

Cell["Display the covariant derivative in TensorForm:", "Text",ExpressionUUID->"463ef747-8649-45ac-a680-ea8a6ca72a46"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"cde", " ", "//", " ", "TensorForm"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"ff2e3d11-cd2c-4a81-bf52-2751cf0f5494"],

Cell[BoxData[
 TagBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Psi]1", 
      RowBox[{",", "\[Mu]"}]], "+", 
     RowBox[{"g", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Psi]2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"W", "[", "1", "]"}], 
              SubscriptBox["", "\[Mu]"]}], ")"}]}], "-", 
           RowBox[{
            FractionBox["1", "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"W", "[", "2", "]"}], 
              SubscriptBox["", "\[Mu]"]}], ")"}]}]}], ")"}]}], "-", 
        RowBox[{
         FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "\[Psi]1", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"W", "[", "3", "]"}], 
           SubscriptBox["", "\[Mu]"]}], ")"}]}]}], ")"}]}]}], ",", 
    RowBox[{
     SubscriptBox["\[Psi]2", 
      RowBox[{",", "\[Mu]"}]], "+", 
     RowBox[{"g", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Psi]1", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"W", "[", "1", "]"}], 
              SubscriptBox["", "\[Mu]"]}], ")"}]}], "+", 
           RowBox[{
            FractionBox["1", "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"W", "[", "2", "]"}], 
              SubscriptBox["", "\[Mu]"]}], ")"}]}]}], ")"}]}], "+", 
        RowBox[{
         FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "\[Psi]2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"W", "[", "3", "]"}], 
           SubscriptBox["", "\[Mu]"]}], ")"}]}]}], ")"}]}]}]}], "}"}],
  HoldForm]], "Output",
 CellChangeTimes->{3.991342141683468*^9},
 CellLabel->"Out[6]=",ExpressionUUID->"35da8b33-d36e-43e8-a3f0-5cef6cf936d0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Local SU(2) Gauge Symmetries and Transformation Rules", "Section",ExpressionUUID->"c1ca71e1-76dc-4109-a47e-1daefee713c1"],

Cell["\<\
Under a local SU(2) transformation parameterized by \[Epsilon]^a(x), the \
doublet field transforms as:
    \[Psi] -> U . \[Psi]   where U = Exp[\[Epsilon]^a * T^a]

For an infinitesimal gauge transformation, U \[Congruent] I_2 + \[Epsilon]^a \
* T^a. The components of the gauge field W_\[Mu]^a transform as:
    W_\[Mu]^a -> W_\[Mu]^a - 1/g * \[PartialD]_\[Mu] \[Epsilon]^a + \
\[Epsilon]^abc * \[Epsilon]^b * W_\[Mu]^c

Let's define these transformation rules in components:\
\>", "Text",ExpressionUUID->"73cc654a-ead6-4171-ae47-f688a4170045"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Epsilon]Matrix", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Epsilon]", "[", "a", "]"}], " ", "*", " ", 
      RowBox[{"T", "[", "a", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gaugeTransforms", " ", "=", " ", 
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"\[Psi]1", " ", "->", " ", 
      RowBox[{"\[Psi]1", " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Epsilon]Matrix", " ", ".", " ", "doublet"}], ")"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ",", "\n", "  ", 
     RowBox[{"\[Psi]2", " ", "->", " ", 
      RowBox[{"\[Psi]2", " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Epsilon]Matrix", " ", ".", " ", "doublet"}], ")"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"W", "[", "a_", "]"}], "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]_", "]"}], "]"}], " ", ":>", 
      " ", 
      RowBox[{
       RowBox[{
        RowBox[{"W", "[", "a", "]"}], "[", 
        RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "]"}], " ", "-", 
       " ", "\n", "    ", 
       RowBox[{
        RowBox[{"Partials", "[", 
         RowBox[{
          RowBox[{"\[Epsilon]", "[", "a", "]"}], ",", " ", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], 
        " ", "/", " ", "g"}], " ", "+", " ", "\n", "    ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Signature", "[", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], "]"}], " ", "*",
           " ", 
          RowBox[{"\[Epsilon]", "[", "b", "]"}], " ", "*", " ", 
          RowBox[{
           RowBox[{"W", "[", "c", "]"}], "[", 
           RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "]"}]}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"b", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}]}]}], "\n", "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"de251bf9-d640-4da1-8839-e6dda8eadb25"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Verification of Gauge Covariance", "Section",ExpressionUUID->"90350d02-4dec-45a5-85db-723ee72daca0"],

Cell["\<\
We verify that the covariant derivative transforms covariantly under local \
SU(2) gauge transformations:
    D'_\[Mu] \[Psi]' = U . (D_\[Mu] \[Psi])

To first order in \[Epsilon], we compute the difference between the \
gauge-transformed covariant derivative and the expected transformation:\
\>", "Text",ExpressionUUID->"1945f7ed-823f-48ee-a743-07d1a108073c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"constantRules", " ", "=", " ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"Partials", "[", 
      RowBox[{"g", ",", " ", "_"}], "]"}], " ", ":>", " ", "0"}], " ", 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"transformedCde", " ", "=", " ", 
   RowBox[{
    RowBox[{"cde", " ", "/.", " ", "gaugeTransforms"}], " ", "//", " ", 
    "ExpandDerivatives"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"transformedCde", " ", "=", " ", 
    RowBox[{
     RowBox[{"transformedCde", " ", "/.", " ", "constantRules"}], " ", "//", 
     " ", "Expand"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Filter", " ", "out", " ", "second"}], "-", 
    RowBox[{"order", " ", "terms", " ", "in", " ", "\[Epsilon]"}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"transformedCdeFirstOrder", " ", "=", " ", 
    RowBox[{"transformedCde", " ", "/.", " ", 
     RowBox[{"{", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[Epsilon]", "[", "a_", "]"}], " ", "*", " ", 
         RowBox[{"\[Epsilon]", "[", "b_", "]"}]}], " ", ":>", " ", "0"}], ",",
        " ", "\n", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Epsilon]", "[", "a_", "]"}], "^", "2"}], " ", ":>", " ", 
        "0"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Epsilon]", "[", "a_", "]"}], " ", "*", " ", 
         RowBox[{"Partials", "[", 
          RowBox[{
           RowBox[{"\[Epsilon]", "[", "b_", "]"}], ",", " ", "_"}], "]"}]}], 
        " ", ":>", " ", "0"}]}], "\n", "}"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"expectedCde", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
       "\[Epsilon]Matrix"}], ")"}], " ", ".", " ", "cde"}], " ", "//", " ", 
    "Expand"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"expectedCdeFirstOrder", " ", "=", " ", 
    RowBox[{"expectedCde", " ", "/.", " ", 
     RowBox[{"{", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[Epsilon]", "[", "a_", "]"}], " ", "*", " ", 
         RowBox[{"\[Epsilon]", "[", "b_", "]"}]}], " ", ":>", " ", "0"}], ",",
        "\n", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Epsilon]", "[", "a_", "]"}], "^", "2"}], " ", ":>", " ", 
        "0"}]}], "\n", "}"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"diff", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
   "transformedCdeFirstOrder", " ", "-", " ", "expectedCdeFirstOrder"}], 
   "]"}]}]}], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"b7bbeae1-b1c0-4fab-bccd-e0724bbb6ab7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.99134214169692*^9},
 CellLabel->"Out[15]=",ExpressionUUID->"95b97ce3-aa4b-4b51-bc45-602bf9ac4270"]
}, Open  ]],

Cell["\<\
The difference is {0, 0}, showing that the covariant derivative is \
local-gauge-covariant. QED!\
\>", "Text",ExpressionUUID->"6f6f867d-8db1-4ef5-9aec-521aee99c1fd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Field Strength Tensor (Yang-Mills) and its Covariance", "Section",ExpressionUUID->"5571a5ec-5b9a-456e-9447-d4f0040cb738"],

Cell["\<\
The Yang-Mills gauge field strength tensor for SU(2) is defined in components \
as:
    G_\[Mu]\[Nu]^a = \[PartialD]_\[Mu] W_\[Nu]^a - \[PartialD]_\[Nu] \
W_\[Mu]^a + g * \[Epsilon]^abc * W_\[Mu]^b * W_\[Nu]^c

Under local gauge transformations, it transforms adjointly:
    G'_\[Mu]\[Nu]^a = G_\[Mu]\[Nu]^a + \[Epsilon]^abc * \[Epsilon]^b * \
G_\[Mu]\[Nu]^c

Let's define G_\[Mu]\[Nu]^a and verify its transformation behavior:\
\>", "Text",ExpressionUUID->"68008d14-48ff-4d4a-be21-62437a69275b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"G", "[", 
    RowBox[{"a_", ",", " ", "\[Eta]_", ",", " ", "\[Nu]_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{
    RowBox[{"Partials", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"W", "[", "a", "]"}], "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "]"}], ",", " ", 
      RowBox[{"x", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "\[Eta]", "]"}], "]"}]}], "]"}], " ",
     "-", " ", "\n", "  ", 
    RowBox[{"Partials", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"W", "[", "a", "]"}], "[", 
       RowBox[{"\[ScriptCapitalD]", "[", "\[Eta]", "]"}], "]"}], ",", " ", 
      RowBox[{"x", "[", 
       RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], " ", 
    "+", " ", "\n", "  ", 
    RowBox[{"g", " ", "*", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Signature", "[", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], "]"}], " ", "*",
         " ", 
        RowBox[{
         RowBox[{"W", "[", "b", "]"}], "[", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Eta]", "]"}], "]"}], " ", "*", 
        " ", 
        RowBox[{
         RowBox[{"W", "[", "c", "]"}], "[", 
         RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}], "]"}]}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"46d681d4-c71e-40c6-a301-a23f533c371c"],

Cell["\<\
Compute the transformation of G^a and subtract the expected transformation:\
\>", "Text",ExpressionUUID->"091709fe-2042-428e-b1f2-1a4746a96c56"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"expectedGTransformed", "[", "a_", "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"G", "[", 
      RowBox[{"a", ",", " ", "\[Eta]", ",", " ", "\[Nu]"}], "]"}], " ", "+", 
     " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Signature", "[", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], "]"}], " ", "*",
         " ", 
        RowBox[{"\[Epsilon]", "[", "b", "]"}], " ", "*", " ", 
        RowBox[{"G", "[", 
         RowBox[{"c", ",", " ", "\[Eta]", ",", " ", "\[Nu]"}], "]"}]}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"transformedG", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"G", "[", 
        RowBox[{"a", ",", " ", "\[Eta]", ",", " ", "\[Nu]"}], "]"}], " ", "/.",
        " ", "gaugeTransforms"}], " ", "//", " ", "ExpandDerivatives"}]}], ";",
     "\n", "  ", 
    RowBox[{"transformedG", " ", "=", " ", 
     RowBox[{
      RowBox[{"transformedG", " ", "/.", " ", "constantRules"}], " ", "//", 
      " ", "Expand"}]}], ";", "\n", "  ", 
    RowBox[{"transformedGFirstOrder", " ", "=", " ", 
     RowBox[{"transformedG", " ", "/.", " ", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[Epsilon]", "[", "x_", "]"}], " ", "*", " ", 
          RowBox[{"\[Epsilon]", "[", "y_", "]"}]}], " ", ":>", " ", "0"}], ",",
         "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Epsilon]", "[", "x_", "]"}], "^", "2"}], " ", ":>", " ", 
         "0"}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Epsilon]", "[", "x_", "]"}], " ", "*", " ", 
          RowBox[{"Partials", "[", 
           RowBox[{
            RowBox[{"\[Epsilon]", "[", "y_", "]"}], ",", " ", "_"}], "]"}]}], 
         " ", ":>", " ", "0"}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"Partials", "[", 
           RowBox[{
            RowBox[{"\[Epsilon]", "[", "x_", "]"}], ",", " ", "_"}], "]"}], 
          " ", "*", " ", 
          RowBox[{"\[Epsilon]", "[", "y_", "]"}]}], " ", ":>", " ", "0"}], ",",
         "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"Partials", "[", 
           RowBox[{
            RowBox[{"\[Epsilon]", "[", "x_", "]"}], ",", " ", "_"}], "]"}], 
          " ", "*", " ", 
          RowBox[{"Partials", "[", 
           RowBox[{
            RowBox[{"\[Epsilon]", "[", "y_", "]"}], ",", " ", "_"}], "]"}]}], 
         " ", ":>", " ", "0"}]}], "\n", "  ", "}"}]}]}], ";", "\n", "  ", 
    RowBox[{"expectedG", " ", "=", " ", 
     RowBox[{
      RowBox[{"expectedGTransformed", "[", "a", "]"}], " ", "//", " ", 
      "Expand"}]}], ";", "\n", "  ", 
    RowBox[{"Simplify", "[", 
     RowBox[{"transformedGFirstOrder", " ", "-", " ", "expectedG"}], "]"}]}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", ",", " ", "3"}], "}"}]}], "\n", "]"}]}], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"c51a3f72-bd11-45fe-b7c0-f867f12cf8d4"],

