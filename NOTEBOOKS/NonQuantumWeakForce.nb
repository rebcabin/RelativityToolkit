Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 "From Classical to Quantum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[InvisibleSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "6235b345-c3a5-4d1e-94a4-818aa9533214"],
 " Gauge Invariance: the Weak Nuclear Force"
}], "Title",ExpressionUUID->"1b914a76-973c-458c-9100-6a088b4958e6"],

Cell["Here, we propose a new slogan:", "Text",
 CellChangeTimes->{{3.9913425013231916`*^9, 
  3.991342515620737*^9}},ExpressionUUID->"3e260f86-9482-48fd-958b-\
7d99eeb90c39"],

Cell[TextData[{
 StyleBox["All you need is D",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" (the Covariant Derivative)",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.991342521524234*^9, 3.991342543599188*^9}, {
  3.9913898511864634`*^9, 
  3.991389854310062*^9}},ExpressionUUID->"f8fb9a6a-49b7-43b4-9276-\
bc7838d82581"],

Cell[TextData[{
 "This slogan reduces the topic of ",
 StyleBox["local gauge invariance",
  FontWeight->"Bold"],
 " to a single concept. Forces arise from connections in the covariant \
derivative, which account for curvatures in gauge manifolds, and trajectories \
arise from geodesics. "
}], "Text",
 CellChangeTimes->{{3.9913426017491703`*^9, 3.9913426396495113`*^9}, {
  3.991342673792016*^9, 3.99134293966853*^9}, {3.991344879823845*^9, 
  3.991344880291708*^9}, {3.9913898764969177`*^9, 
  3.9913900064955997`*^9}},ExpressionUUID->"890e4535-49dd-424e-8f51-\
34da951b4405"],

Cell["In my recent notebooks, we have seen that ", "Text",
 CellChangeTimes->{{3.9913426017491703`*^9, 3.9913426396495113`*^9}, {
  3.991342673792016*^9, 3.99134293966853*^9}, {3.991344879823845*^9, 
  3.991344880291708*^9}, {3.9913898764969177`*^9, 
  3.991390004088233*^9}},ExpressionUUID->"8ea8620b-ea5a-44c9-8c5b-\
42d2736d745e"],

Cell["\<\
[Refs. 10, 11] Classical (non-quantum) trajectories are geodesics in gauge \
manifolds.\
\>", "Item",
 CellChangeTimes->{{3.9913426017491703`*^9, 3.9913426396495113`*^9}, {
   3.991342673792016*^9, 3.991342916287093*^9}, 3.9913429581394663`*^9, {
   3.9913431224252567`*^9, 3.991343127293108*^9}, {3.991345676211466*^9, 
   3.9913456832837887`*^9}, {3.991345737230921*^9, 3.991345737424993*^9}, {
   3.991390012573845*^9, 3.99139003621891*^9}, {3.991390186216076*^9, 
   3.9913902085098267`*^9}, {3.9913903714209423`*^9, 
   3.9913903746601048`*^9}},ExpressionUUID->"fa7af26f-d55e-40ec-9b3d-\
93732aff0549"],

Cell[TextData[{
 "[Ref. 8] Invariance of trajectories and coordinate transforms introduces \
the spacetime connection ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[VeryThinSpace]", "\[Alpha]"}]], 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  ExpressionUUID->"db09d192-1cba-4f43-ba11-1f203e5d50fd"],
 ", necessary and sufficient for gravitation via general relativity. "
}], "Item",
 CellChangeTimes->{{3.9913426017491703`*^9, 3.9913426396495113`*^9}, {
   3.991342673792016*^9, 3.991342916287093*^9}, 3.9913429581394663`*^9, {
   3.9913431224252567`*^9, 3.991343127293108*^9}, {3.991345676211466*^9, 
   3.9913456832837887`*^9}, {3.991345737230921*^9, 3.991345737424993*^9}, {
   3.991390382266479*^9, 
   3.9913903828463163`*^9}},ExpressionUUID->"f919d9a9-a591-4108-aa1e-\
65c43275658b"],

Cell[TextData[{
 "[Ref. 9] Local Abelian ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "(", "1", ")"}], TraditionalForm]],ExpressionUUID->
  "4ff130a0-0f93-4d18-8778-2300212f791f"],
 " phase invariance of a complex scalar field \[Psi] introduces the gauge \
field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", 
    RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], TraditionalForm]],ExpressionUUID->
  "d778895b-98a0-440c-8739-788eb2224bad"],
 " (vector potential) and the connection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], "\[InvisibleSpace]", "q", "\[InvisibleSpace]", 
    SubscriptBox["A", 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}], TraditionalForm]],
  ExpressionUUID->"8079e73e-dbab-4bef-8ef4-8647c0f89e05"],
 ", which generates the electromagnetic forces."
}], "Item",
 CellChangeTimes->{{3.991342964805608*^9, 3.9913431451457777`*^9}, {
   3.991343820278603*^9, 3.991343825180532*^9}, {3.9913457193659897`*^9, 
   3.9913457434226923`*^9}, {3.991346269841557*^9, 3.991346271324285*^9}, 
   3.9913900544567738`*^9, {3.991390418295802*^9, 
   3.991390438348069*^9}},ExpressionUUID->"2d497469-38e1-4062-b711-\
c3b8eaed5bbf"],

Cell[TextData[{
 "[Ref. 9] The same local Abelian ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "(", "1", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d7b88f7b-f902-45fe-adbf-1b61cf0d5246"],
 " phase invariance generates the connection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], "\[InvisibleSpace]", "q", "\[InvisibleSpace]", 
     SubscriptBox["A", 
      RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], 
     SuperscriptBox["V", "\[Alpha]"]}], "+", 
    RowBox[{
     SuperscriptBox["V", "\[Lambda]"], 
     SubscriptBox[
      SuperscriptBox["\[CapitalGamma]", 
       RowBox[{"\[VeryThinSpace]", "\[Alpha]"}]], 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{
       "\[Mu]", "\[VeryThinSpace]\[VeryThinSpace]", "\[Lambda]"}]}]]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "21362586-99b2-4c51-b635-99098830ea0c"],
 ", here concretely multiplied by and contracted with a conceptual \
(non-physical) charged vector field ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", 
    RowBox[{"\[VeryThinSpace]", "\[Alpha]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "115fb7ff-3df6-4415-9f13-1f63e55d150d"],
 "."
}], "Item",
 CellChangeTimes->{{3.991342964805608*^9, 3.9913431451457777`*^9}, {
  3.991343820278603*^9, 3.991343825180532*^9}, {3.9913457193659897`*^9, 
  3.991345754812295*^9}, {3.991345822438031*^9, 3.9913458710327263`*^9}, {
  3.991345901320549*^9, 3.9913459078950987`*^9}, {3.991345975428424*^9, 
  3.9913462458865557`*^9}, {3.9913462767450857`*^9, 3.991346294167018*^9}, {
  3.991390238365026*^9, 
  3.991390248426566*^9}},ExpressionUUID->"825c3174-61c2-4e40-9f56-\
b90bf33e0938"],

Cell[TextData[{
 "In this notebook, we construct the theory of the weak nuclear force with \
vector bosons a-la Weinberg-Salam as a theory of local ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[InvisibleSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fe9f5753-0a6c-4726-a88d-d6e5d206fb7d"],
 " gauge invariance via covariant derivatives, bridging from the non-quantum \
usage in earlier notebooks. "
}], "Text",
 CellChangeTimes->{{3.991390262402223*^9, 3.9913902700941153`*^9}, {
  3.9913903400983686`*^9, 3.991390357495646*^9}, {3.991390481252893*^9, 
  3.9913904911766663`*^9}},ExpressionUUID->"2313369c-d6ca-4595-aeaf-\
b43aa2516760"],

