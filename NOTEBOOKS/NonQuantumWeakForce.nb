Cell[CellGroupData[{

Cell["2. Pauli Matrices and SU(2) Generators", "Section",ExpressionUUID->"dfaa6ef1-2c78-49df-a983-298a146ebb82"],

Cell[TextData[{
 "The Weinberg-Salam model represents the weak interaction using local ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[InvisibleSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "423bfd05-cc1a-422b-a569-1a1377f52fdb"],
 " gauge symmetry. Consistent with CheckingTheBases.nb [1], the complex, \
anti-Hermitian (quaternion) generators of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[InvisibleSpace]", 
    RowBox[{"U", "(", "2", ")"}]}], TraditionalForm]],ExpressionUUID->
  "2b7e77a7-7d11-4ca3-a582-5ac4d1c81252"],
 " are defined with a factor of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "\[ImaginaryI]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "86813d1c-5aaf-400c-bb8b-397578c0d3bf"],
 ":"
}], "Text",
 CellChangeTimes->{{3.991342210193783*^9, 3.991342277776436*^9}, {
   3.9913905277550907`*^9, 3.991390566839973*^9}, {3.991390663058504*^9, 
   3.991390668258257*^9}, 
   3.991390722102447*^9},ExpressionUUID->"34fa6c96-25ef-43fe-a037-\
38ce8a2e4dfb"],

Cell["", "Text",ExpressionUUID->"25554aa7-2fdb-4f05-a6d6-f1c78fe961d9"],

Cell["\<\
    T^a = -i/2 * \[Sigma]^a  (for a = 1, 2, 3)

We use Mathematica's built-in PauliMatrix function to define these generators.\
\>", "Text",
 CellChangeTimes->{{3.991342210193783*^9, 3.991342277776436*^9}, {
  3.9913905277550907`*^9, 3.991390566839973*^9}, {3.991390663058504*^9, 
  3.991390668258257*^9}},ExpressionUUID->"a325ab56-bb8e-4aff-8e19-\
811faf40ff07"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "T", "]"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"MatrixForm", "/@", "\[IndentingNewLine]", 
     RowBox[{"(", 
      RowBox[{"T", "=", 
       RowBox[{
        FractionBox[
         RowBox[{"-", "\[ImaginaryI]"}], "2"], 
        RowBox[{"PauliMatrix", "/@", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "3"}], "}"}]}]}]}], ")"}]}], ",", 
    "\[IndentingNewLine]", "\"\<\[GothicS]\[GothicU](2) T basis :\>\""}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"proof", "[", 
   RowBox[{"And", "@@", 
    RowBox[{
     StyleBox[
      RowBox[{"commTest", "[", "T", "]"}],
      FontColor->RGBColor[0.14, 0.8, 0.14]], "@@@", "triples"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "\[CurlyEpsilon]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CurlyEpsilon]", "=", 
   RowBox[{"LeviCivitaTensor", "[", "3", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "cyclicity", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cyclicity", "[", "M_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"And", "@@", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        StyleBox[
         RowBox[{
          RowBox[{"comm", "[", "M", "]"}], "[", 
          RowBox[{"i", ",", "j"}], "]"}],
         FontColor->RGBColor[0.14, 0.8, 0.14]], 
        StyleBox["==",
         FontColor->RGBColor[0.14, 0.8, 0.14]], 
        StyleBox["\[IndentingNewLine]",
         FontColor->RGBColor[0.14, 0.8, 0.14]], 
        RowBox[{"Sum", 
         StyleBox["[",
          FontColor->RGBColor[0.14, 0.8, 0.14]], 
         RowBox[{
          StyleBox[
           RowBox[{
            RowBox[{"M", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "*", 
            RowBox[{"\[CurlyEpsilon]", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}]}],
           FontColor->RGBColor[0.14, 0.8, 0.14]], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}]}]}], ";", 
  RowBox[{"proof", "@", 
   StyleBox[
    RowBox[{"cyclicity", "[", "T", "]"}],
    FontColor->RGBColor[0.14, 0.8, 0.14]]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9913909328801193`*^9, 3.991390951844474*^9}, {
  3.991390998942685*^9, 3.991391012246128*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"603dce9e-4f0a-49c4-89f5-516b9dd1dc7f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "roundTripLieGroupAndAlgebra", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"roundTripLieGroupAndAlgebra", "[", "M_", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"And", "@@", 
    RowBox[{"Flatten", "@", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", 
          RowBox[{
           StyleBox[
            RowBox[{"MatrixLog", "[", 
             RowBox[{"MatrixExp", "[", 
              RowBox[{"\[Theta]", " ", 
               RowBox[{"M", "[", 
                RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "]"}],
            FontColor->RGBColor[0.14, 0.8, 0.14]], ",", "\[IndentingNewLine]", 
           RowBox[{"Assumptions", "->", 
            RowBox[{
             RowBox[{"-", "\[Pi]"}], "<", "\[Theta]", "<", "\[Pi]"}]}]}], 
          "]"}], "==", 
         RowBox[{"\[Theta]", " ", 
          RowBox[{"M", "[", 
           RowBox[{"[", "#", "]"}], "]"}]}]}], "&"}], "/@", 
       RowBox[{"Range", "[", "3", "]"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"proof", "@", 
   RowBox[{"roundTripLieGroupAndAlgebra", "[", "T", "]"}]}], ";"}]}], "Input",\

 CellChangeTimes->{{3.99139107542869*^9, 3.9913910848839073`*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"98487d60-e060-4936-aab0-a025640123c0"],

Cell[BoxData[
 StyleBox["\<\"QED\[VeryThinSpace]\[VeryThinSpace]\[VeryThinSpace]\
\[FilledSquare]\"\>",
  StripOnInput->False,
  LineColor->RGBColor[0.14, 0.8, 0.14],
  FrontFaceColor->RGBColor[0.14, 0.8, 0.14],
  BackFaceColor->RGBColor[0.14, 0.8, 0.14],
