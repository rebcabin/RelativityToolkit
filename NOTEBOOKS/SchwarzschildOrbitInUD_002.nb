Cell["\<\
A good way to read this notebook is to page to the end, play with the \
demonstration, then read the leading prose explaining the physics.\
\>", "Text",
 CellChangeTimes->{{3.977869549564584*^9, 3.977869552413246*^9}, {
  3.978990705591756*^9, 
  3.978990707232723*^9}},ExpressionUUID->"e0cb9fa0-affd-44b2-bd17-\
faa52b11e3c4"],

Cell[TextData[{
 "The solutions are built on the \[ScriptCapitalU]\[ScriptCapitalD] compiler \
proof-of-concept presented in earlier notebooks. We take advantage of the \
Schwarzschild metric from the Wolfram Function Repository, but compute the \
Christoffel symbols (force-producers), ",
 StyleBox["ab-initio",
  FontSlant->"Italic"],
 ", in \[ScriptCapitalU]\[ScriptCapitalD]. From the Christoffel symbols, we \
posit the standard equations of motion for coordinates of the star in terms \
of proper time \[Tau]:"
}], "Text",
 CellChangeTimes->{
  3.977513712847348*^9, {3.9775178669407883`*^9, 3.977517959906126*^9}, {
   3.977517996418476*^9, 3.977518072452635*^9}, {3.9775181219359083`*^9, 
   3.977518224156801*^9}, {3.9775359524035*^9, 3.977536075585163*^9}, {
   3.97753737910937*^9, 3.977537384309*^9}, {3.97764405920399*^9, 
   3.977644347525126*^9}, {3.977672253563974*^9, 3.977672266570442*^9}, {
   3.977678754525832*^9, 3.977678800149303*^9}, {3.977746420549296*^9, 
