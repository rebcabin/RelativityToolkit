Cell[CellGroupData[{

Cell["Orbits", "Section",
 CellChangeTimes->{{3.9777655343695803`*^9, 
  3.9777655357264643`*^9}},ExpressionUUID->"c0c33b2f-271b-46d7-8136-\
d44d1f29267f"],

Cell[TextData[{
 "Imagine a spherical coordinate system measuring time ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "82a96061-e076-4013-91cb-5d77994338e6"],
 " and spatial locations, ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "9bd0444a-8882-43b7-8daa-6068bd5a1306"],
 ", \[Theta], \[Phi], stretching out from the center of a supermassive black \
hole to a safe distance, where spacetime is almost flat. Launch a star, as a \
test particle of negligible mass, to orbit the black hole. Spacetime is \
highly curved close to the black hole, but relativity gives us the way to \
figure out what our \[OpenCurlyDoubleQuote]flat\[CloseCurlyDoubleQuote] \
coordinates will read as we measure time and locations from our safe \
distance. "
}], "Text",
 CellChangeTimes->{{3.977849169865314*^9, 3.9778494812207537`*^9}, {
  3.977869742249383*^9, 3.977869900343882*^9}, {3.978990808754538*^9, 
  3.978990812476479*^9}},ExpressionUUID->"2de9916b-559f-4a5e-8783-\
f53ae69eca9a"],

Cell[TextData[{
 "Integrate the equations of motion of the star as a function of its proper \
time. The star follows geodesics around the black hole. If the star gets too \
close to the event horizon at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    RowBox[{"2", 
     SubscriptBox["M", 
      RowBox[{"black", " ", "hole"}]]}]}], TraditionalForm]],ExpressionUUID->
  "116989db-4022-471f-967a-8da7591a1e26"],
 " (in natural units, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", "=", 
    RowBox[{"c", "=", "1"}]}], TraditionalForm]],ExpressionUUID->
  "e118b71a-e4e7-41a5-9614-6cd06195c075"],
 "), the star will disappear from the Universe forever, suffering an \
unknowable fate, perhaps at the singularity in the center of the black hole."
}], "Text",
 CellChangeTimes->{{3.977849169865314*^9, 3.9778495493198357`*^9}, {
  3.977850274172675*^9, 3.977850277538231*^9}, {3.977869926178523*^9, 
  3.9778699494406557`*^9}, {3.9789908390898123`*^9, 3.9789908734358053`*^9}, {
  3.9789915860054913`*^9, 
  3.978991587539415*^9}},ExpressionUUID->"9c2f2ebd-c939-44fa-8c26-\
8ad257e07385"],

Cell[CellGroupData[{

Cell["Define Unknown Functions of \[Tau]", "Subsection",
 CellChangeTimes->{{3.9778495587040854`*^9, 
  3.9778495659094667`*^9}},ExpressionUUID->"3524ebbc-0960-45c3-964c-\
d67dc87de8cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coords", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"funcs", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"t", "[", "\[Tau]", "]"}], ",", 
     RowBox[{"r", "[", "\[Tau]", "]"}], ",", 
     RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], ",", 
     RowBox[{"\[Phi]", "[", "\[Tau]", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"velocities", "=", 
   RowBox[{"D", "[", 
    RowBox[{"funcs", ",", " ", "\[Tau]"}], "]"}]}], ";"}]}], "Input",
