Cell[CellGroupData[{

Cell["Build ODEs from the Compiled \[CapitalGamma] Array", "Subsection",
 CellChangeTimes->{{3.977849579176321*^9, 
  3.977849593944412*^9}},ExpressionUUID->"a67d7763-fbed-45fa-b133-\
69e6cc46d9e8"],

Cell["\<\
The following is a straight transcription of the standard equations of motion:\
\>", "Text",
 CellChangeTimes->{{3.977849645455894*^9, 3.977849668548408*^9}, 
   3.97784985185152*^9},ExpressionUUID->"b2fa2814-149b-4e84-9710-\
36147d8f22e0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["d", 
       RowBox[{" ", "2"}]], 
      SuperscriptBox["x", 
       RowBox[{" ", "\[Mu]"}]]}], 
     RowBox[{"d", "\[VeryThinSpace]", 
      SuperscriptBox["\[Tau]", 
       RowBox[{" ", "2"}]]}]], "+", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["\[CapitalGamma]", 
       RowBox[{" ", "\[Mu]"}]], 
      RowBox[{"\[Nu]", " ", "\[Lambda]"}]], 
     FractionBox[
      RowBox[{"d", "\[VeryThinSpace]", 
       SuperscriptBox["x", 
        RowBox[{" ", "\[Nu]"}]]}], 
      RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}]], 
     FractionBox[
      RowBox[{"d", "\[VeryThinSpace]", 
       SuperscriptBox["x", 
        RowBox[{" ", "\[Lambda]"}]]}], 
      RowBox[{"d", "\[VeryThinSpace]", "\[Tau]"}]]}]}], "=", "0"}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977848715664982*^9, 3.9778487490737762`*^9}, {
  3.977848875452468*^9, 3.9778488822049093`*^9}, {3.9778489309728193`*^9, 
  3.9778490047620907`*^9}, {3.977849619015214*^9, 
  3.9778496230887947`*^9}},ExpressionUUID->"743193c5-f35e-47cf-a595-\
5bb86be00cf8"],

Cell[TextData[{
 "via ",
 StyleBox["myGammaArray", "Input"],
 " from the compiler script."
}], "Text",
 CellChangeTimes->{{3.9778504252262583`*^9, 
  3.9778504385496807`*^9}},ExpressionUUID->"545080bd-dc10-4d48-84d6-\
558967f0b85d"],

Cell[TextData[{
 StyleBox["Note the resemblance to Newton\[CloseCurlyQuote]s ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "=", 
    RowBox[{"m", "\[VeryThinSpace]", "a"}]}], TraditionalForm]],
  ExpressionUUID->"9941fc7e-71df-482a-a0ae-d6e1efc31f4f"],
 ",",
 StyleBox[" if we interpret the term with the connection \[CapitalGamma] as \
producing forces. This idea is so pervasive in all of physics that it \
deserves a slogan: ",
  FontSlant->"Italic"],
 StyleBox["Forces Come from Connections",
  FontWeight->"Bold"],
 StyleBox[". We\[CloseCurlyQuote]ll see it again in gauge theory in future \
notebooks, where the connections, instead of describing curvature of \
spacetime, describe curvatures in symmetry groups of gauge fields.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9778496920594807`*^9, 3.9778497260388727`*^9}, {
   3.977849868591382*^9, 3.977850001649106*^9}, 3.977869056150714*^9, {
   3.9789909057582693`*^9, 
   3.978990909673646*^9}},ExpressionUUID->"fda0deee-4918-4881-be9f-\
7b5a9ee108ca"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["TODO: Derive these equations as describing geodesics, ",
  FontSlant->"Italic"],
 "ab-initio",
 StyleBox[", from a variational principle.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9778496920594807`*^9, 3.9778497260388727`*^9}, {
  3.977850050218163*^9, 
  3.977850054674984*^9}},ExpressionUUID->"bedc715c-4f80-4f35-9350-\
8d83387cd90e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"odes", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"funcs", "[", 
             RowBox[{"[", "\[Mu]", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Tau]", ",", "2"}], "}"}]}], "]"}], "+", 
          RowBox[{"Sum", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"myGammaArray", "[", 
              RowBox[{"[", 
               RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Lambda]"}], "]"}], 
              "]"}], "*", "\[IndentingNewLine]", 
             RowBox[{"velocities", "[", 
              RowBox[{"[", "\[Nu]", "]"}], "]"}], "*", 
             RowBox[{"velocities", "[", 
              RowBox[{"[", "\[Lambda]", "]"}], "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
