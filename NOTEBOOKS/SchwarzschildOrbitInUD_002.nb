Cell[CellGroupData[{

Cell["Initial Coordinate Time", "Subsubsection",
 CellChangeTimes->{{3.977782692724741*^9, 3.9777827851331253`*^9}, {
   3.977782998585622*^9, 3.977783003021225*^9}, {3.977783132088633*^9, 
   3.977783194387081*^9}, {3.977789638959697*^9, 3.977789651633833*^9}, {
   3.97778976936383*^9, 3.977789807014819*^9}, 3.977791047930325*^9, {
   3.977791084073159*^9, 3.9777911319537487`*^9}, {3.977791581845107*^9, 
   3.9777915940826*^9}, {3.977850502739078*^9, 3.977850524220481*^9}, 
   3.97785117530906*^9, 3.977851377287567*^9, {3.977851582848502*^9, 
   3.977851595561637*^9}},ExpressionUUID->"5462e4a5-7acb-45fc-9fe3-\
456d4592612c"],

Cell[TextData[{
 "There is heavy time dilation near the black hole. That means that \
coordinate time will be highly non-linear w.r.t. \[Tau] and is subject to \
numerical integration. A good initial value for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "\[VeryThinSpace]", 
    RowBox[{"t", "/", "d"}], "\[VeryThinSpace]", "\[Tau]"}], 
   TraditionalForm]],ExpressionUUID->"68e85231-0c6e-4543-9351-84550961a994"],
 ", given the initial angular velocity ",
 StyleBox["phiVel", "Input"],
 " above, comes from the requirement that the proper velocity, \[Upsilon], \
always have negative unit norm:"
}], "Text",
 CellChangeTimes->{{3.9778516089369698`*^9, 3.97785172785681*^9}, {
  3.977851763375705*^9, 3.97785176895245*^9}, {3.97787024030025*^9, 
  3.977870284513904*^9}, {3.9778709293904676`*^9, 3.9778709870776567`*^9}, {
  3.978991635717573*^9, 
  3.978991685851437*^9}},ExpressionUUID->"7a5c14d7-92d6-4be2-94aa-\
e57b118352e2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"u", ".", "\[Upsilon]"}], "=", 
   RowBox[{
    RowBox[{"-", "1"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["g", 
       RowBox[{"t", "\[VeryThinSpace]", "t"}]], " ", 
      RowBox[{"(", 
       SuperscriptBox[
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{"t", "'"}], ")"}], "0"], "2"], ")"}]}], "+", 
     RowBox[{
      SubscriptBox["g", 
       RowBox[{"\[Phi]", "\[VeryThinSpace]", "\[Phi]"}]], "\[VeryThinSpace]", 
      
      RowBox[{"(", 
       SuperscriptBox[
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Phi]", "'"}], ")"}], "0"], "2"], ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9778517407439632`*^9, 3.977851924805002*^9}, {
  3.977852089546665*^9, 
  3.977852089547907*^9}},ExpressionUUID->"5e2d8133-93a7-4d55-a02c-\
e5f40c28b8a9"],

Cell[TextData[{
 "There are no ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[Theta]", "\[VeryThinSpace]", "\[Theta]"}]], TraditionalForm]],
  ExpressionUUID->"48bab28d-ea60-42a2-b77f-e9faee823bac"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"r", "\[VeryThinSpace]", "r"}]], TraditionalForm]],ExpressionUUID->
  "40ba5c96-3172-46ed-88b2-640dc383880c"],
 " terms because we always start with pure planar motion ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{"\[Theta]", "'"}], ")"}], "0"], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"bad3c845-81d6-4f07-9c4f-78257fff19d2"],
 " and no radial speed ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{"r", "'"}], ")"}], "0"], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"04b364d2-e4c8-49b0-9ac7-05fb547e4bf2"],
 "."
}], "Text",
 CellChangeTimes->{{3.977851936546689*^9, 3.9778520441040154`*^9}, {
  3.977870297886415*^9, 3.977870340754979*^9}, {3.9778710028876543`*^9, 
  3.977871003702533*^9}},ExpressionUUID->"d439f34f-014a-4ba2-a077-\
bd7fba1d5411"],

Cell[TextData[{
 StyleBox["TODO experiment with non-zero initial radial speed in a new ",
  FontSlant->"Italic"],
 StyleBox["Manipulate", "Input"],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977852061202302*^9, 3.9778520763353558`*^9}, {
  3.977871017850564*^9, 
  3.977871023959601*^9}},ExpressionUUID->"e34f99e5-13e9-4d2b-99b5-\
4dd3e623c9be"],

Cell[TextData[{
 "In the Schwarzschild metric, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Upsilon]", ".", "\[Upsilon]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1b0b6f6d-8d7f-4a43-85a7-174f77d3f0be"],
 " becomes"
}], "Text",
