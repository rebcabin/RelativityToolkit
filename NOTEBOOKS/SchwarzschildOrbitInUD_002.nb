Cell[CellGroupData[{

Cell["Interactive Reparameterization ", "Subsection",
 CellChangeTimes->{{3.977867703087903*^9, 
  3.977867713481938*^9}},ExpressionUUID->"623d1d1c-45a2-4dfa-be46-\
92dc18fda3d7"],

Cell[TextData[{
 "Start the animation of the orbit with \[Tau] at its minimum value of 100. \
Click the slow-button 12 times. Move the eccentricity and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]],ExpressionUUID->
  "0f8bf91c-b665-4930-90e7-4ade3ab4a271"],
 " sliders. Watch the shape of the orbit change interactively. Try to make a \
stable circular orbit (my best one was at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["r", "0"], "=", "24"}], ",", 
    RowBox[{"ecc", "=", "1.0690"}]}], TraditionalForm]],ExpressionUUID->
  "f8bf8a57-dfbc-4739-b798-9e559808b7e0"],
 "."
}], "Text",
 CellChangeTimes->{{3.977867734775926*^9, 3.977867746190987*^9}, {
  3.97786778387372*^9, 3.977867824688689*^9}, {3.9778679286921387`*^9, 
