Cell[TextData[{
 "Try animating this one slowly (~12 down-speed clicks) from the initial \
value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "=", "70"}], TraditionalForm]],ExpressionUUID->
  "2ccfcda3-69ea-4159-9e68-8b5f32c1b754"],
 "."
}], "Text",
