       "]}, {Automatic}][$CellContext`\[Tau]]}}, $CellContext`status$$ = 
  "ALIVE", $CellContext`rMin$$ = 5.957876937602407}, 
  TagBox[
   StyleBox[
    DynamicModuleBox[{$CellContext`eccVel$$ = 0.98, $CellContext`r0$$ = 
     14, $CellContext`Tmax$$ = 1500, Typeset`show$$ = True, 
     Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
     Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
     "\"untitled\"", Typeset`specs$$ = {{
       Hold[
        Style["Initial Conditions", Bold, 12]], 
       Manipulate`Dump`ThisIsNotAControl, ControlType -> None}, {{
        Hold[$CellContext`r0$$], 14, 
        "Start Radius (\!\(\*SubscriptBox[\(r\), \(0\)]\))"}, 5, 30, 
       ControlType -> Manipulator}, {{
        Hold[$CellContext`eccVel$$], 0.98, "Eccentricity)"}, 0.6, 1.5, 
       ControlType -> Manipulator}, {
       Hold[
        Style["Simulation", Bold, 12]], Manipulate`Dump`ThisIsNotAControl, 
       ControlType -> None}, {{
        Hold[$CellContext`Tmax$$], 1500, "Duration (\[Tau])"}, 100, 5000, 
       ControlType -> Manipulator}, {
       Hold[
        Button[
        "RESET SIMULATION", {$CellContext`r0$$ = $CellContext`rStart$$, \
$CellContext`eccVel$$ = $CellContext`eccStart$$, $CellContext`Tmax$$ = \
$CellContext`durStart$$}, ImageSize -> Medium, Method -> "Queued"]], 
       Manipulate`Dump`ThisIsNotAControl, ControlType -> None}}, 
     Typeset`size$$ = {400., {204.9867907986111, 210.7187243923611}}, 
     Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
     Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
     DynamicBox[Manipulate`ManipulateBoxes[
      1, StandardForm, 
       "Variables" :> {$CellContext`eccVel$$ = 0.98, $CellContext`r0$$ = 
         14, $CellContext`Tmax$$ = 1500}, "ControllerVariables" :> {}, 
       "OtherVariables" :> {
        Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
         Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
         Typeset`specs$$, Typeset`size$$, Typeset`update$$, 
         Typeset`initDone$$, Typeset`skipInitDone$$, 
         Typeset`keyframeActionsQ$$, Typeset`keyframeList$$}, 
       "Body" :> ($CellContext`phiVel$$ = (
           Sqrt[$CellContext`Mval$$/$CellContext`r0$$] \
$CellContext`eccVel$$)/$CellContext`r0$$; $CellContext`tVelVal$$ = 
         Sqrt[(1 + $CellContext`r0$$^2 $CellContext`phiVel$$^2)/(1 - 
           2 ($CellContext`Mval$$/$CellContext`r0$$))]; $CellContext`inits$$ = \
{$CellContext`t[0] == 0, 
           Derivative[1][$CellContext`t][
            0] == $CellContext`tVelVal$$, $CellContext`r[
            0] == $CellContext`r0$$, Derivative[1][$CellContext`r][0] == 
           0, $CellContext`\[Theta][0] == Pi/2, 
           Derivative[1][$CellContext`\[Theta]][0] == 
           0, $CellContext`\[Phi][0] == 0, 
           Derivative[1][$CellContext`\[Phi]][
            0] == $CellContext`phiVel$$}; $CellContext`soln$$ = Quiet[
           NDSolve[
            
            Join[$CellContext`odes, $CellContext`inits$$], \
$CellContext`funcs, {$CellContext`\[Tau], 0, $CellContext`Tmax$$}, 
            Method -> {
             "EventLocator", 
              "Event" -> $CellContext`r[$CellContext`\[Tau]] - \
$CellContext`crashRad$$, "EventAction" -> "StopIntegration"}, MaxSteps -> 
            100000]]; $CellContext`rMin$$ = Quiet[
           MinValue[{
             Part[
              ReplaceAll[
               $CellContext`r[$CellContext`\[Tau]], $CellContext`soln$$], 1], 
             0 <= $CellContext`\[Tau] <= $CellContext`Tmax$$}, $CellContext`\
\[Tau]]]; $CellContext`status$$ = 
         If[$CellContext`rMin$$ < $CellContext`crashRad$$, "GONE FOREVER", 
           "ALIVE"]; Column[{
           Row[
            Map[Style[#, 
              If[$CellContext`rMin$$ < 2.1, Red, Green], Bold, 
              14]& , {$CellContext`status$$, ", time dila'n: ", 
              DecimalForm[$CellContext`tVelVal$$, {Infinity, 4}], 
              ", \[Omega] vel: ", 
              DecimalForm[$CellContext`phiVel$$, {Infinity, 4}]}]], 
           Show[
            ParametricPlot[
             ReplaceAll[{$CellContext`r[$CellContext`\[Tau]] Cos[
                 $CellContext`\[Phi][$CellContext`\[Tau]]], \
$CellContext`r[$CellContext`\[Tau]] Sin[
                 $CellContext`\[Phi][$CellContext`\[Tau]]]}, \
$CellContext`soln$$], {$CellContext`\[Tau], 0, $CellContext`Tmax$$}, 
             PlotStyle -> {
               
               If[$CellContext`rMin$$ < $CellContext`crashRad$$, Orange, 
                Cyan], 
               Thickness[0.004]}, 
             PlotRange -> {{-$CellContext`rMax$$, $CellContext`rMax$$}, \
{-$CellContext`rMax$$, $CellContext`rMax$$}}, Background -> Black, ImageSize -> 
             400], 
            Graphics[{Black, 
              Disk[{0, 0}, 2], White, 
              Circle[{0, 0}, 2], Red, 
              PointSize[0.02], 
              Point[{0, 0}]}]]}, Alignment -> Center]), "Specifications" :> {
         Style[
         "Initial Conditions", Bold, 
          12], {{$CellContext`r0$$, 14, 
           "Start Radius (\!\(\*SubscriptBox[\(r\), \(0\)]\))"}, 5, 30, 
          Appearance -> 
          "Labeled"}, {{$CellContext`eccVel$$, 0.98, "Eccentricity)"}, 0.6, 
          1.5, Appearance -> "Labeled"}, Delimiter, 
         Style[
         "Simulation", Bold, 
          12], {{$CellContext`Tmax$$, 1500, "Duration (\[Tau])"}, 100, 5000, 
          Appearance -> {"Open"}}, 
         Button[
         "RESET SIMULATION", {$CellContext`r0$$ = $CellContext`rStart$$, \
$CellContext`eccVel$$ = $CellContext`eccStart$$, $CellContext`Tmax$$ = \
$CellContext`durStart$$}, ImageSize -> Medium, Method -> "Queued"]}, 
       "Options" :> {
        ControlPlacement -> Top, 
         TrackedSymbols :> {$CellContext`r0$$, $CellContext`eccVel$$, \
$CellContext`Tmax$$}}, "DefaultOptions" :> {}],
      ImageSizeCache->{449.1, {332.5840521511502, 338.3159857449002}},
      SingleEvaluation->True],
     Deinitialization:>None,
