Cell[CellGroupData[{

Cell["Substitute Unknown Functions for Formals in \[CapitalGamma]", \
"Subsection",
 CellChangeTimes->{{3.977849748089037*^9, 3.977849758971327*^9}, {
  3.977850383186268*^9, 
  3.97785038600386*^9}},ExpressionUUID->"82b2086e-3774-49e5-8870-\
9c31346dcf01"],

Cell["\<\
The \[ScriptCapitalU]\[ScriptCapitalD] proof-of-concept compiler uses formal \
symbols as variables. This artifact is inherited from the Wolfram Function \
Repository, the target \[OpenCurlyDoubleQuote]virtual machine\
\[CloseCurlyDoubleQuote] of the compiler, and \[ScriptCapitalU]\
\[ScriptCapitalD] propagates the formal symbols back up. \
\>", "Text",
 CellChangeTimes->{{3.977849763704136*^9, 3.9778498053250847`*^9}, {
  3.977850089230267*^9, 3.977850146112794*^9}, {3.977850207741153*^9, 
  3.977850364578006*^9}, {3.977850398740284*^9, 3.9778504096486073`*^9}, {
  3.97786998350141*^9, 3.977870090805148*^9}, {3.978991099480242*^9, 
  3.978991105528983*^9}, {3.9789911720799522`*^9, 
  3.978991209673943*^9}},ExpressionUUID->"095b789b-6cc1-4db2-a02a-\
62c0f8e51710"],

Cell[TextData[{
 "Map the formal symbols to our unknown functions for ",
 StyleBox["NDSolve", "Input"],
 "\[CloseCurlyQuote]s sake. Set the black hole\[CloseCurlyQuote]s mass, ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "f892e9f8-4de1-4825-9ac1-71a100e37b49"],
 ", to 1, arbitrarily (the mass will have the same units as ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "76a9c7e6-d351-4077-8c5d-4192a4dab971"],
 ", the radial distance, so about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", 
    SuperscriptBox["10", "5"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2eb67d0d-46d1-4666-b78a-d2482c0b01a1"],
 " solar masses if length is measured in light-seconds). ",
 StyleBox["Solve", "Input"],
 " the equations algebraically into state-space form for inspection, with \
accelerations all to the left of equals signs. "
}], "Text",
 CellChangeTimes->{{3.977849763704136*^9, 3.9778498053250847`*^9}, {
   3.977850089230267*^9, 3.977850146112794*^9}, {3.977850207741153*^9, 
