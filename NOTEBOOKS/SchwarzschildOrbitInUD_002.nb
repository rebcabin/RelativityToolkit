            RowBox[{"{", 
             RowBox[{"\[Nu]", ",", "1", ",", "4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Lambda]", ",", "1", ",", "4"}], "}"}]}], "]"}]}], "==",
          "0"}], ")"}], "//", "FullSimplify"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"\[Mu]", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ")"}], "//", 
  "TableForm"}]], "Input",
