11faadff8c3a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tLim", "=", "3000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"soln", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{"finalSystem", ",", "funcs", ",", 
     RowBox[{"{", 
      RowBox[{"\[Tau]", ",", "0", ",", "tLim"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"r", "[", "\[Tau]", "]"}], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"\[Phi]", "[", "\[Tau]", "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"r", "[", "\[Tau]", "]"}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Phi]", "[", "\[Tau]", "]"}], "]"}]}]}], "}"}], "/.", " ", 
    "soln"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"\[Tau]", ",", "0", ",", "tLim"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", "Red"}], ",", 
   RowBox[{"Background", "->", "Black"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"AspectRatio", "->", "1"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.977782692724741*^9, 3.9777827851331253`*^9}, {
