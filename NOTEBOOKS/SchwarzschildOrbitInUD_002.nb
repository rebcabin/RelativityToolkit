Cell[TextData[{
 StyleBox["TODO: Explain why ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"ecc", "=", "1.0"}], TraditionalForm]],ExpressionUUID->
  "f9ed0966-7fb2-461a-832a-ec496d61a4ad"],
 StyleBox[" does not produce a stable circular orbit.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977868027063498*^9, 
  3.977868060335294*^9}},ExpressionUUID->"3c77283e-2f0f-4d15-a7f8-\
9eeef8027c20"],

Cell[TextData[{
 StyleBox["HINT: The Newtonian velocity ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    SqrtBox[
     FractionBox["M", "r"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bab8963e-ea8a-415c-b27a-ba563a7ceb98"],
 StyleBox[" underestimates the gravity of a black hole. The circular velocity \
in general relativity is greater: ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    SqrtBox[
     FractionBox["M", 
      RowBox[{"r", "-", 
       RowBox[{"2", "M"}]}]]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "98cbf997-7686-4184-9e9e-32c1aec4444e"],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Subitem",
 CellChangeTimes->{{3.977869121890514*^9, 
  3.977869289410163*^9}},ExpressionUUID->"f0e34674-5b8b-4682-a813-\
d27fd09f8783"],

Cell[TextData[{
 StyleBox["FOLLOW-ON QUESTION: At ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "0"], "=", "24"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7d19e6f6-8817-465b-84a9-d2cbd46ea11c"],
 StyleBox[", the ratio of Newtonian to Einsteinian velocities is ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     FractionBox["24", 
      RowBox[{"24", "-", "2"}]]], "\[TildeTilde]", 
    RowBox[{
     FormBox["1.0445",
      TraditionalForm], 
     FormBox["",
      TraditionalForm]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4c1e3065-9eaf-4549-b8cf-ea6f89a59917"],
 StyleBox[". Is the empirical 1.0690 due to time dilation?",
  FontSlant->"Italic"]
}], "Subitem",
 CellChangeTimes->{{3.97786929601676*^9, 3.977869382128793*^9}, {
  3.9778705054529247`*^9, 
  3.9778706642800503`*^9}},ExpressionUUID->"ce2c4982-5cce-41ba-b0c6-\
292656ef870a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Precession Scrub", "Subsection",
 CellChangeTimes->{{3.9778452969108343`*^9, 
  3.9778453040883293`*^9}},ExpressionUUID->"ffe6d8a9-f4a4-49e0-ac79-\
fa0f6a931534"],

Cell["\<\
With the default parameters (press the RESET button), scrub the duration \
forward and backward slowly to watch the precession. Try the animation tools \
in the duration control at various speeds. The animation may be blocky at \
times, but if you pause the animation, the orbit eventually (and quickly) \
smooths out. This is a design feature of the animator: it prioritizes latency \
over fidelity just the same way your browser will sometimes give you a blocky \
image at first and then refine it progressively over time.\
\>", "Text",
 CellChangeTimes->{{3.9778453110969133`*^9, 3.9778455048520317`*^9}, {
   3.9778683384239483`*^9, 3.9778683442133102`*^9}, 
   3.9789919888442163`*^9},ExpressionUUID->"daef6f51-6622-4b2e-a987-\
14eaf585bcdc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Delicate Escape", "Subsection",
 CellChangeTimes->{{3.9778444559272547`*^9, 
  3.977844460037072*^9}},ExpressionUUID->"6cb10ba1-2273-4668-9e55-\
99fd9085e8b5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "0"], "=", "14"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8bc0ef82-071c-4e36-a087-bb91e9f3665a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ecc", "=", "0.95"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b5b7ccd2-f811-4423-a2e4-13eec432afb5"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"duration", "=", 
    RowBox[{"130", "->", "135"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aa473727-4e85-4bc3-a8f8-20959d39ec06"]
}], "Text",
 CellChangeTimes->{{3.9778436469262733`*^9, 3.977843689338994*^9}, {
  3.977843830542454*^9, 3.977843842439754*^9}, {3.97784390667692*^9, 
  3.977843969440406*^9}},ExpressionUUID->"7522a3f8-0cd7-42c0-84a0-\
b7d5c5e79964"],

Cell["\<\
At duration 130, you can see the \[OpenCurlyDoubleQuote]star\
\[CloseCurlyDoubleQuote] spiraling into the black hole. It doesn\
\[CloseCurlyQuote]t have enough \[Omega] to escape. By duration 135, it\
\[CloseCurlyQuote]s gone forever. \
\>", "Text",
 CellChangeTimes->{{3.977843980006319*^9, 3.977844045249407*^9}, {
  3.9778440807181787`*^9, 
  3.977844112255916*^9}},ExpressionUUID->"7972aeb4-705b-4b23-a162-\
685b765ddc63"],

