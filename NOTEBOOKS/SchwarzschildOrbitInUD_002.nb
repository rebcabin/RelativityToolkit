586a0794f34d"],

Cell[TextData[StyleBox["This condition is usually good enough for a stable \
Newtonian orbit, but not good enough for Einstein; you can still crash a star \
into a black hole with this initial condition, as we see later.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.9778708583360662`*^9, 3.977870882555901*^9}, {
  3.9789916060942793`*^9, 
  3.978991612703945*^9}},ExpressionUUID->"59725b46-0cb2-4f83-b5f2-\
001bd780cd78"],

Cell[TextData[{
 "Multiply it by the eccentricity and divide again by ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "43efad77-c76a-40be-8c6d-fa6c259efd18"],
 " to get initial angular velocity ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"\[Phi]", "'"}], ")"}], "0"], TraditionalForm]],ExpressionUUID->
  "2a6e4492-9fc5-4e6f-9638-ede6355e1d29"],
 " of our elliptical orbit:"
}], "Text",
 CellChangeTimes->{{3.977851134852594*^9, 3.977851148532593*^9}, {
