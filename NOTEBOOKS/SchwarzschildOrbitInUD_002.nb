Cell[BoxData[{
 RowBox[{
  RowBox[{"On", "[", "Assert", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Assert", "[", 
  RowBox[{"ValueQ", "[", "odes", "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.977838948921023*^9, 3.9778390091883583`*^9}, {
  3.977839107684422*^9, 3.9778391217389793`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"74507513-4bbf-495e-a5b2-9c870cd4c68e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Mval", "=", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"rMax", "=", "30"}], ",", 
     RowBox[{"(*", " ", 
      RowBox[{"still", " ", "very", " ", 
       RowBox[{"relativistic", "!"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rCrash", "=", "5"}], ",", " ", 
     RowBox[{"(*", " ", "empirical", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rEvent", "=", "2"}], ",", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"from", " ", 
        RowBox[{"1", "/", 
         SubscriptBox["g", "rr"]}]}], " ", "=", " ", 
       RowBox[{
        RowBox[{"1", "-", 
         RowBox[{"2", 
          RowBox[{"m", "/", 
           SubscriptBox["r", "e"]}]}]}], " ", "==", " ", "0"}]}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"rStart", "=", "14"}], ",", "\[IndentingNewLine]", 
     RowBox[{"crashRad", "=", "2.01"}], ",", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"empirical", ":", " ", 
       RowBox[{"for", " ", "the", " ", "integrator"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"eccMin", "=", "0.60"}], ",", 
     RowBox[{"(*", " ", "empirical", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"eccMax", "=", "1.5"}], ",", "\[IndentingNewLine]", 
     RowBox[{"eccStart", "=", "0.98"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"durMin", "=", "100"}], ",", "\[IndentingNewLine]", 
     RowBox[{"durMax", "=", "5000"}], ",", "\[IndentingNewLine]", 
     RowBox[{"durStart", "=", "1500"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "phiVel", ",", "tVelVal", ",", "inits", ",", 
     "\[IndentingNewLine]", "finalSystem", ",", "soln", ",", "status", ",", 
     "rMin"}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"phiVel", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"Mval", "/", "r0"}], "]"}], "*", "eccVel"}], ")"}], "/", 
        "r0"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tVelVal", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{
            RowBox[{"r0", "^", "2"}], "*", 
            RowBox[{"phiVel", "^", "2"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"2", "*", 
            RowBox[{"Mval", "/", "r0"}]}]}], ")"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"inits", "=", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"t", "[", "0", "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"t", "'"}], "[", "0", "]"}], "==", "tVelVal"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"r", "[", "0", "]"}], "==", "r0"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"r", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Theta]", "[", "0", "]"}], "==", 
          RowBox[{"Pi", "/", "2"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Theta]", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "0", "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Phi]", "'"}], "[", "0", "]"}], "==", "phiVel"}]}], 
        "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Solve", " ", "with", " ", "Crash", " ", "Protection"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"soln", "=", 
       RowBox[{"Quiet", "@", 
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"odes", ",", "inits"}], "]"}], ",", "\[IndentingNewLine]", 
          "funcs", ",", 
          RowBox[{"{", 
           RowBox[{"\[Tau]", ",", "0", ",", "Tmax"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Stop", " ", "integration", " ", "if", " ", "we", " ", "hit", " ", 
            "the", " ", "Event", " ", "Horizon", " ", 
            RowBox[{"(", 
             RowBox[{"r", "=", "2"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
          
          RowBox[{"Method", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<EventLocator\>\"", ",", 
             RowBox[{"\"\<Event\>\"", "->", 
              RowBox[{
               RowBox[{"r", "[", "\[Tau]", "]"}], "-", "crashRad"}]}], ",", 
             "\[IndentingNewLine]", 
             
             RowBox[{"\"\<EventAction\>\"", 
              "->", "\"\<StopIntegration\>\""}]}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"MaxSteps", "->", "100000"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Check", " ", "survival"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"rMin", "=", 
       RowBox[{"Quiet", "@", 
        RowBox[{"MinValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"r", "[", "\[Tau]", "]"}], "/.", " ", "soln"}], ")"}], 
             "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"0", "<=", "\[Tau]", "<=", "Tmax"}]}], "}"}], ",", 
          "\[Tau]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"status", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"rMin", "<", "crashRad"}], ",", "\"\<GONE FOREVER\>\"", 
         ",", "\"\<ALIVE\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"#", ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"rMin", "<", "2.1"}], ",", "Red", ",", "Green"}], 
                "]"}], ",", "Bold", ",", "14"}], "]"}], "&"}], "/@", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
             "status", ",", " ", 
              "\[IndentingNewLine]", "\"\<, time dila'n: \>\"", ",", " ", 
              RowBox[{"DecimalForm", "[", 
               RowBox[{"tVelVal", ",", 
                RowBox[{"{", 
                 RowBox[{"Infinity", ",", "4"}], "}"}]}], "]"}], ",", 
              "\[IndentingNewLine]", "\"\<, \[Omega] vel: \>\"", ",", " ", 
              RowBox[{"DecimalForm", "[", 
               RowBox[{"phiVel", ",", 
                RowBox[{"{", 
                 RowBox[{"Infinity", ",", "4"}], "}"}]}], "]"}]}], "}"}]}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Show", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"ParametricPlot", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"r", "[", "\[Tau]", "]"}], " ", 
                  RowBox[{"Cos", "[", 
                   RowBox[{"\[Phi]", "[", "\[Tau]", "]"}], "]"}]}], ",", 
                 RowBox[{
                  RowBox[{"r", "[", "\[Tau]", "]"}], " ", 
                  RowBox[{"Sin", "[", 
                   RowBox[{"\[Phi]", "[", "\[Tau]", "]"}], "]"}]}]}], "}"}], "/.",
                " ", "soln"}], ",", 
              RowBox[{"{", 
               RowBox[{"\[Tau]", ",", "0", ",", "Tmax"}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"PlotStyle", "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"rMin", "<", "crashRad"}], ",", "Orange", ",", 
                   "Cyan"}], "]"}], ",", 
                 RowBox[{"Thickness", "[", "0.004", "]"}]}], "}"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"PlotRange", "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "rMax"}], ",", "rMax"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "rMax"}], ",", "rMax"}], "}"}]}], "}"}]}], ",",
               "\[IndentingNewLine]", 
              RowBox[{"Background", "->", "Black"}], ",", 
              RowBox[{"ImageSize", "->", "400"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Graphics", "[", 
             RowBox[{"{", 
              RowBox[{"Black", ",", 
               RowBox[{"Disk", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0", ",", "0"}], "}"}], ",", "2"}], "]"}], ",", 
               RowBox[{"(*", " ", 
                RowBox[{"Black", " ", "Hole"}], " ", "*)"}], 
               "\[IndentingNewLine]", "White", ",", 
               RowBox[{"Circle", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0", ",", "0"}], "}"}], ",", "2"}], "]"}], ",", 
               RowBox[{"(*", " ", 
                RowBox[{"Event", " ", "Horizon", " ", 
                 RowBox[{"(", 
                  RowBox[{"from", " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"1", " ", "-", " ", 
                    RowBox[{"2", 
                    RowBox[{"M", "/", "rEvent"}]}]}], " ", "==", " ", "0"}], 
                    ")"}]}], " "}]}], "*)"}], "\[IndentingNewLine]", "Red", ",", 
               RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
               RowBox[{"Point", "[", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "0"}], "}"}], "]"}]}], " ", 
              RowBox[{"(*", "Singularity", "*)"}], "}"}], "]"}]}], "]"}]}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<Initial Conditions\>\"", ",", "Bold", ",", "12"}], "]"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "r0", ",", "rStart", 
         ",", "\"\<Start Radius (\!\(\*SubscriptBox[\(r\), \(0\)]\))\>\""}], 
        "}"}], ",", "rCrash", ",", " ", "rMax", ",", 
       RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"eccVel", ",", "eccStart", ",", "\"\<Eccentricity)\>\""}], 
        "}"}], ",", "eccMin", ",", "eccMax", ",", 
       RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
     "\[IndentingNewLine]", "Delimiter", ",", "\[IndentingNewLine]", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<Simulation\>\"", ",", "Bold", ",", "12"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Tmax", ",", "durStart", ",", "\"\<Duration (\[Tau])\>\""}], 
        "}"}], ",", "durMin", ",", "durMax", ",", 
       RowBox[{"Appearance", "->", 
        RowBox[{"{", "\"\<Open\>\"", "}"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Button", "[", 
      RowBox[{"\"\<RESET SIMULATION\>\"", ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"r0", "=", "rStart"}], ",", 
         RowBox[{"eccVel", "=", "eccStart"}], ",", 
         RowBox[{"Tmax", "=", "durStart"}]}], "}"}], ",", 
       RowBox[{"ImageSize", "->", "Medium"}], ",", 
       RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ControlPlacement", "->", "Top"}], ",", "\[IndentingNewLine]", 
     RowBox[{"TrackedSymbols", ":>", 
      RowBox[{"{", 
       RowBox[{"r0", ",", "eccVel", ",", "Tmax"}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
