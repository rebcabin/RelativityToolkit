        FractionBox[
         RowBox[{"2", "M"}], 
         SubscriptBox["r", "0"]]}], ")"}]}], 
     SuperscriptBox[
      SubscriptBox[
       RowBox[{"t", "'"}], "0"], "2"]}], "+", 
