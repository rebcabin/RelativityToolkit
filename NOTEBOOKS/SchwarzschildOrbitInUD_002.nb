  3.977871728396173*^9}},ExpressionUUID->"48e13e7a-15fb-41da-95a7-\
c6b0957eb01c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"r", "[", "\[Tau]", "]"}], " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"\[Phi]", "[", "\[Tau]", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"r", "[", "\[Tau]", "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Phi]", "[", "\[Tau]", "]"}], "]"}]}]}], "}"}], "/.", 
        " ", "soln"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Beginning", " ", "of", " ", 
         RowBox[{"Orbit", ":", " ", "Blue"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"\[Tau]", ",", "0", ",", "\[Tau]1"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Blue", ",", 
          RowBox[{"Thickness", "[", "0.008", "]"}]}], "}"}]}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"r", "[", "\[Tau]", "]"}], " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"\[Phi]", "[", "\[Tau]", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"r", "[", "\[Tau]", "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Phi]", "[", "\[Tau]", "]"}], "]"}]}]}], "}"}], "/.", 
        " ", "soln"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"End", " ", "of", " ", 
         RowBox[{"Orbit", ":", " ", "Red"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"\[Tau]", ",", 
         RowBox[{"tLim", "-", "\[Tau]1"}], ",", "tLim"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Red", ",", 
          RowBox[{"Thickness", "[", "0.004", "]"}]}], "}"}]}]}], " ", "]"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"AspectRatio", "->", "1"}], ",", 
     RowBox[{"Axes", "->", "True"}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Background", "->", "Black"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "15"}], ",", "15"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "15"}], ",", "15"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Precession Visualized (r=14)\\nBlue: Start | Red: End\>\"",
         ",", "14", ",", "Bold"}], "]"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Tau]1", ",", 
       RowBox[{"tLim", "/", "10"}]}], "}"}], ",", "70", ",", 
     RowBox[{"tLim", "/", "2"}], ",", 
     RowBox[{"Appearance", "->", 
      RowBox[{"{", "\"\<Open\>\"", "}"}]}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.977792204409791*^9, 3.977792204411483*^9}, {
