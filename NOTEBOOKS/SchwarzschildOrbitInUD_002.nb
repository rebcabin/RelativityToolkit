Cell[CellGroupData[{

Cell["Nearly Periodic Trifoil Precession", "Subsection",
 CellChangeTimes->{{3.9778445405758457`*^9, 
  3.977844550607996*^9}},ExpressionUUID->"975d76d9-f300-40af-bc26-\
b43f438374ab"],

Cell[TextData[{
 "Set ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "0"], "=", "30"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "de3a006b-e376-489b-8c8d-734d3dc601fe"],
 " (the max), eccentricity to 0.774, and \[OpenCurlyDoubleQuote]scrub\
\[CloseCurlyDoubleQuote] the duration right and left to watch precession \
trace out a three-leaf shape and very nearly repeat, but not quite. "
}], "Text",
 CellChangeTimes->{{3.9778445815902567`*^9, 
  3.977844657547105*^9}},ExpressionUUID->"83cc45a7-ce8b-4ae0-86d0-\
bb507b87d501"],

