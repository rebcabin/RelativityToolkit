Cell[TextData[{
 "Move the duration to max (5000), then slowly decrease the eccentricity \
until the black hole swallows the star at around ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ecc", "=", "0.69"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8257210d-4cc1-4f4f-8d28-5305581d893d"],
 ". The precession pattern makes very interesting shapes along this journey \
to oblivion."
}], "Text",
 CellChangeTimes->{{3.977844715887281*^9, 3.977844742823456*^9}, {
   3.9778448171565104`*^9, 3.977844867009721*^9}, 
