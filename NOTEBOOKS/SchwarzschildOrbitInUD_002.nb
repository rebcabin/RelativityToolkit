Cell[BoxData[{
 RowBox[{
  RowBox[{"inits", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"t", "[", "0", "]"}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"t", "'"}], "[", "0", "]"}], "==", 
      RowBox[{"Echo", "[", 
       RowBox[{"tVel", ",", "\"\<initial time vel\>\""}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"r", "[", "0", "]"}], "==", 
      RowBox[{"Echo", "[", 
       RowBox[{"rStart", ",", "\"\<initial (apo/peri)apsis\>\""}], "]"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"r", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Theta]", "[", "0", "]"}], "==", 
      RowBox[{"\[Pi]", "/", "2"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Theta]", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
     RowBox[{"(*", " ", 
      RowBox[{"STRICTLY", " ", "PLANAR"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Phi]", "[", "0", "]"}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Phi]", "'"}], "[", "0", "]"}], "==", 
      RowBox[{"Echo", "[", 
       RowBox[{"phiVel", ",", "\"\<initial ang vel\>\""}], "]"}]}]}], "}"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"finalSystem", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"odes", ",", "inits"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.977782692724741*^9, 3.9777827851331253`*^9}, {
