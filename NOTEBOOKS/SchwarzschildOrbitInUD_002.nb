Cell[TextData[StyleBox["The 2020 Nobel Prize in Physics was awarded for \
measuring the mass of the supermassive black hole at the center of our Milky \
Way galaxy by tracking the highly elliptical orbit of the star S2. Later, \
measuring the orbit\[CloseCurlyQuote]s precession further verified general \
relativity.",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.97787151892255*^9, 3.9778715723463707`*^9}, {
  3.977871632955909*^9, 3.977871669599144*^9}, {3.978991786330431*^9, 
  3.97899187496487*^9}},ExpressionUUID->"2a2b7f2a-1eaa-458d-8bdb-\
e3c336f1a9d5"]
}, Open  ]],

