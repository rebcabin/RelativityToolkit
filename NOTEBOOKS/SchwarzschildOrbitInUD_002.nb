      RowBox[{
       SuperscriptBox[
        SubscriptBox["r", "0"], 
        RowBox[{" ", "2"}]], "(", 
       RowBox[{"\[Phi]", "'"}], ")"}], "0"], "2"]}], "=", 
   RowBox[{"-", "1"}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.977852133287244*^9, 3.977852229183483*^9}, {
