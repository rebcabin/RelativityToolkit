Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      RowBox[{"a_", " ", "b_"}]}], 
     RowBox[{"\[PartialD]", "var_"}]], "\[RuleDelayed]", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", "a"}], 
       RowBox[{"\[PartialD]", "var"}]], " ", "b"}], "+", 
     RowBox[{"a", " ", 
      FractionBox[
       RowBox[{"\[PartialD]", "b"}], 
       RowBox[{"\[PartialD]", "var"}]]}]}]}], ",", 
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      RowBox[{"a_", "+", "b_"}]}], 
     RowBox[{"\[PartialD]", "var_"}]], "\[RuleDelayed]", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", "a"}], 
      RowBox[{"\[PartialD]", "var"}]], "+", 
     FractionBox[
      RowBox[{"\[PartialD]", "b"}], 
      RowBox[{"\[PartialD]", "var"}]]}]}], ",", 
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["\[ExponentialE]", "arg_"]}], 
     RowBox[{"\[PartialD]", "var_"}]], "\[RuleDelayed]", 
    RowBox[{
     RowBox[{"Exp", "[", "arg", "]"}], " ", 
     FractionBox[
      RowBox[{"\[PartialD]", "arg"}], 
      RowBox[{"\[PartialD]", "var"}]]}]}], ",", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", "n_"}], 
      RowBox[{"\[PartialD]", "_"}]], "/;", 
     RowBox[{"NumericQ", "[", "n", "]"}]}], "\[RuleDelayed]", "0"}], ",", 
   RowBox[{
    RowBox[{
     SubscriptBox["expr_", 
      RowBox[{",", "idx_"}]], "/;", 
     RowBox[{"StringContainsQ", "[", 
      RowBox[{
       RowBox[{"ToString", "[", "idx", "]"}], ",", "\<\"'\"\>"}], "]"}]}], "\[RuleDelayed]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fresh", "=", 
        RowBox[{"Unique", "[", "\<\"\[Sigma]\"\>", "]"}]}], "}"}], ",", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "\[Sigma]40"]}], 
        RowBox[{
         RowBox[{"\[PartialD]", "x"}], 
         SuperscriptBox["", "idx"]}]], " ", 
       SubscriptBox["expr", 
        RowBox[{",", "\[Sigma]40"}]]}]}], "]"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.979731931763022*^9},
 CellLabel->
  "Out[111]=",ExpressionUUID->"33492c0a-54fd-4441-923b-101bba642786"]
