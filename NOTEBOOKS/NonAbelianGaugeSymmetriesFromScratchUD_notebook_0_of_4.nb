Cell[CellGroupData[{

Cell["Derive Equations of Motion", "Subsection",
 CellChangeTimes->{{3.9801078914649754`*^9, 
  3.980107897714526*^9}},ExpressionUUID->"c024d850-d5bb-4fab-b6ea-\
3362eb898a46"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "equations", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"injectTime", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Delta]", "->", 
         RowBox[{"\[Delta]", "[", "t", "]"}]}], ",", 
        RowBox[{"\[Eta]", "->", 
         RowBox[{"\[Eta]", "[", "t", "]"}]}]}], "}"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"accelTerm", ",", "forceTerm"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Geometric", " ", "Acceleration", " ", 
          RowBox[{"(", 
           RowBox[{"Geodesic", " ", "Equation"}], ")"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Echo", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"accelTerm", "=", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"coords", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "[", "t", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "+", 
             "\[IndentingNewLine]", 
             RowBox[{"Sum", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"\[CapitalGamma]Pendulum", "[", 
                   RowBox[{
                    RowBox[{"coords", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{"coords", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", 
                    RowBox[{"coords", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], "]"}], "/.", 
                  "injectTime"}], ")"}], "*", "\[IndentingNewLine]", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"coords", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", "t", "]"}], ",", 
                  "t"}], "]"}], "*", "\[IndentingNewLine]", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"coords", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", "t", "]"}], ",", 
                  "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"j", ",", "1", ",", "2"}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"k", ",", "1", ",", "2"}], "}"}]}], "]"}]}]}], ",", 
           "\[IndentingNewLine]", "\"\<accel :\>\""}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"RHS", ":", 
           RowBox[{"Potential", " ", "Force", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "Grad"}], " ", "V"}], ")"}]}]}], "*)"}], 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Force", "^", "u"}], "=", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"g", "^", "uv"}]}], "*", 
            RowBox[{"dV", "/", 
             RowBox[{"dx", "^", "v"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Echo", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"forceTerm", "=", 
            RowBox[{"-", 
             RowBox[{"Sum", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"gUU", "[", 
                    RowBox[{
                    RowBox[{"\[ScriptCapitalU]", "[", 
                    RowBox[{"coords", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
                    RowBox[{"\[ScriptCapitalU]", "[", 
                    RowBox[{"coords", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "]"}], "/.", " ",
                     "pendulumInverseMetricRules"}], ")"}], "*", 
                  "\[IndentingNewLine]", 
                  RowBox[{"D", "[", 
                   RowBox[{"V", ",", 
                    RowBox[{"coords", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], "]"}]}], ")"}], "/.", 
                "injectTime"}], ",", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"k", ",", "1", ",", "2"}], "}"}]}], "]"}]}]}], 
           ",", "\"\<force :\>\""}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Echo", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"equations", "[", "i", "]"}], "=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"accelTerm", "==", "forceTerm"}], ")"}], "//", 
             "FullSimplify"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<equation[\>\"", "<>", 
            RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<] :\>\""}]}], 
          "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}]}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9800975728042707`*^9, 3.980097572805059*^9}, {
   3.9800976151351023`*^9, 3.9800976711092043`*^9}, 3.98010500138867*^9, {
