3f2fe583151f"],

Cell["Source:\"Perspectives on Energy\",B.Beckman, April 2025", "Text",
 CellChangeTimes->{{3.9800975728042707`*^9, 3.980097572805059*^9}, {
  3.9800976151351023`*^9, 3.9800976711092043`*^9}, {3.98010500138867*^9, 
  3.980105024605034*^9}, {3.980106514595677*^9, 
  3.9801065723766127`*^9}},ExpressionUUID->"f63cbd32-7ed3-44a3-892f-\
