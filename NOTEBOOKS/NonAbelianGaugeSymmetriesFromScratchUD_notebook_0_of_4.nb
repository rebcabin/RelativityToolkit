Cell["Non-Abelian Symmetry From Scratch in \
\[ScriptCapitalU]\[ScriptCapitalD]", "Title",
 CellChangeTimes->{{3.977345737052463*^9, 3.977345752398189*^9}, {
   3.9775136521964283`*^9, 3.977513664408065*^9}, {3.9775381381170673`*^9, 
