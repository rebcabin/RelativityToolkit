  3.980105381484918*^9}},ExpressionUUID->"99be33e9-0642-4924-9cc2-\
bcedb301cd5b"],

Cell["\<\
Objective : Re-derive the equations of motion for the spherical pendulum via \
the Relativity Toolkit's covariant-derivative engine. \
\>", "Text",
 CellChangeTimes->{{3.9800975728042707`*^9, 3.980097572805059*^9}, {
  3.9800976151351023`*^9, 3.9800976711092043`*^9}, {3.98010500138867*^9, 
