Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"g", "=", 
       RowBox[{"m", " ", 
        SuperscriptBox["cz", "2"], 
        RowBox[{"(", GridBox[{
           {"1", "0"},
           {"0", 
            SuperscriptBox[
             RowBox[{"Cos", "[", "\[Delta]", "]"}], "2"]}
          }], ")"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"zDD", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"gDD", "[", 
           RowBox[{
            RowBox[{"\[ScriptCapitalD]", "[", "a_", "]"}], ",", 
            RowBox[{"\[ScriptCapitalD]", "[", "b_", "]"}]}], "]"}], "/;", 
          RowBox[{"(", 
           RowBox[{"a", "=!=", "b"}], ")"}]}], "->", "0"}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"zUU", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"gUU", "[", 
           RowBox[{
            RowBox[{"\[ScriptCapitalU]", "[", "a_", "]"}], ",", 
            RowBox[{"\[ScriptCapitalU]", "[", "b_", "]"}]}], "]"}], "/;", 
          RowBox[{"(", 
           RowBox[{"a", "=!=", "b"}], ")"}]}], "->", "0"}], "}"}]}]}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Echo", "[", 
      RowBox[{
       RowBox[{"pendulumMetricRules", "=", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"MatrixToUDRules", "[", 
          RowBox[{"g", ",", "gDD", ",", "\[ScriptCapitalD]", ",", "coords"}], 
          "]"}], "~", "Join", "~", "zDD"}]}], 
       ",", "\"\<\!\(\*SubscriptBox[\(g\), \(\[VeryThinSpace]\(\[Mu]\
\[VeryThinSpace]\[Nu]\)\)]\) =\>\""}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Echo", "[", 
      RowBox[{
       RowBox[{"pendulumInverseMetricRules", "=", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"MatrixToUDRules", "[", 
          RowBox[{
           RowBox[{"Inverse", "[", "g", "]"}], ",", "gUU", ",", 
           "\[ScriptCapitalU]", ",", "coords"}], "]"}], "~", "Join", "~", 
         "zUU"}]}], 
       ",", "\"\<\!\(\*SuperscriptBox[\(g\), \(\[VeryThinSpace]\(\[Mu]\
\[VeryThinSpace]\[Nu]\)\)]\) :\>\""}], "]"}], ";"}]}], "]"}], ";"}]], "Input",\

 CellChangeTimes->{{3.9801069831521463`*^9, 3.9801070938495693`*^9}, {
