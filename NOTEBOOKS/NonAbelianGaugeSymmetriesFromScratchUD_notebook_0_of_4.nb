Cell[CellGroupData[{

Cell["Calculate Geometric Connection", "Subsection",
 CellChangeTimes->{{3.9801074565042877`*^9, 
  3.980107467496718*^9}},ExpressionUUID->"4b05e5c5-521c-479d-ac20-\
f74b0743b0aa"],

Cell[TextData[{
 "The connection is purely geometric. Masses and lengths have canceled out, a \
consequence of Einstein\[CloseCurlyQuote]s Equivalence Principle. Notice that \
we zero-out off-diagaonal components of the metric tensor late in the game, \
after expanding all the derivatives of the metric internally to ",
 StyleBox["CalculateGammaComponent", "Input"],
 "."
}], "Text",
 CellChangeTimes->{{3.980114255460387*^9, 3.9801143034805527`*^9}, {
  3.9801143396677094`*^9, 
  3.980114378781452*^9}},ExpressionUUID->"3e927ccd-1b73-40e9-938e-\
556e049f1d41"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalGamma]Pendulum", "=", 
   RowBox[{
    RowBox[{"CalculateGammaComponent", "[", "\[IndentingNewLine]", 
     RowBox[{
     "#1", ",", "#2", ",", "#3", ",", "\[IndentingNewLine]", "gDD", ",", 
      "pendulumMetricRules", ",", "\[IndentingNewLine]", "gUU", ",", 
      "pendulumInverseMetricRules", ",", "\[IndentingNewLine]", "coords"}], 
     "]"}], "&"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Table", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalGamma]Pendulum", "[", 
     RowBox[{
     "a", ",", "b", ",", "c", ",", "gDD", ",", "pendulumMetricRules", ",", 
      "gUU", ",", "pendulumInverseMetricRules", ",", "coords"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"a", ",", "coords"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"b", ",", "coords"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"c", ",", "coords"}], "}"}]}], "]"}], "//", 
  "MatrixForm"}]}], "Input",
