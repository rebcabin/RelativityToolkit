   3.978995315215734*^9, 
   3.978995324627754*^9}},ExpressionUUID->"105c2b56-4f50-4673-b271-\
481010de5f68"],

Cell[TextData[{
 StyleBox["In abstract geometrical contexts, as opposed to coordinate-basis \
contexts, the Christoffel symbols are called the ",
  FontSlant->"Italic"],
 StyleBox["Levi-Civita Connection",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["., often written ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", GridBox[{
      {"\[Lambda]"},
      {
       RowBox[{"\[Mu]", " ", "\[Nu]"}]}
     }], "}"}], TraditionalForm]],ExpressionUUID->
  "cd8ae890-8104-42ef-bd1b-0e86acb1cbbc"],
 "."
}], "Item",
 CellChangeTimes->{{3.978723120871808*^9, 3.97872312087333*^9}, {
