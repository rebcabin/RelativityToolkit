Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"cdg", "=", 
    RowBox[{"CD", "[", 
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{
