Cell[BoxData[
 RowBox[{
  RowBox[{"metricDifferentiationRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Metric", " ", "Symmetry"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "a_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "b_", "]"}]}], "]"}], "/;", 
       RowBox[{"!", 
        RowBox[{"OrderedQ", "[", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}], "]"}]}]}], ":>", 
      RowBox[{"g", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", "[", "b", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "a", "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalU]", "[", "a_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalU]", "[", "b_", "]"}]}], "]"}], "/;", 
       RowBox[{"!", 
        RowBox[{"OrderedQ", "[", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}], "]"}]}]}], ":>", 
      RowBox[{"g", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalU]", "[", "b", "]"}], ",", 
        RowBox[{"\[ScriptCapitalU]", "[", "a", "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Permissive", " ", "Contraction", " ", 
       RowBox[{"(", 
        RowBox[{"All", " ", "4", " ", "Alignments"}], ")"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"First", "-", "First"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "s_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "a_", "]"}]}], "]"}], "*", 
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalU]", "[", "s_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalU]", "[", "b_", "]"}]}], "]"}]}], ":>", 
      RowBox[{"\[Delta]", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalU]", "[", "b", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "a", "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Second", "-", "Second"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "a_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "s_", "]"}]}], "]"}], "*", 
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalU]", "[", "b_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalU]", "[", "s_", "]"}]}], "]"}]}], ":>", 
      RowBox[{"\[Delta]", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalU]", "[", "b", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "a", "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"First", "-", 
       RowBox[{"Second", " ", 
        RowBox[{"(", 
         RowBox[{"Redundant", " ", "but", " ", "Safe"}], ")"}]}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "s_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "a_", "]"}]}], "]"}], "*", 
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalU]", "[", "b_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalU]", "[", "s_", "]"}]}], "]"}]}], ":>", 
      RowBox[{"\[Delta]", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalU]", "[", "b", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "a", "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Second", "-", "First"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "a_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "s_", "]"}]}], "]"}], "*", 
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalU]", "[", "s_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalU]", "[", "b_", "]"}]}], "]"}]}], ":>", 
      RowBox[{"\[Delta]", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalU]", "[", "b", "]"}], ",", 
        RowBox[{"\[ScriptCapitalD]", "[", "a", "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Delta", " ", "Contractions"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Delta]", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalU]", "[", "bound_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "free_", "]"}]}], "]"}], "*", 
       RowBox[{"Partials", "[", 
        RowBox[{"expr_", ",", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "bound_", "]"}], "]"}]}], "]"}]}],
       ":>", 
      RowBox[{"Partials", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"x", "[", 
         RowBox[{"\[ScriptCapitalU]", "[", "free", "]"}], "]"}]}], "]"}]}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Delta]", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalU]", "[", "bound_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "free_", "]"}]}], "]"}], "*", 
       RowBox[{"Partials", "[", 
        RowBox[{
         RowBox[{"g", "[", 
          RowBox[{
           RowBox[{"\[ScriptCapitalD]", "[", "bound_", "]"}], ",", 
           RowBox[{"\[ScriptCapitalD]", "[", "other_", "]"}]}], "]"}], ",", 
         "v_"}], "]"}]}], ":>", 
      RowBox[{"Partials", "[", 
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{
          RowBox[{"\[ScriptCapitalD]", "[", "free", "]"}], ",", 
          RowBox[{"\[ScriptCapitalD]", "[", "other", "]"}]}], "]"}], ",", 
        "v"}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Delta]", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalU]", "[", "bound_", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "free_", "]"}]}], "]"}], "*", 
       RowBox[{"Partials", "[", 
        RowBox[{
         RowBox[{"g", "[", 
          RowBox[{
           RowBox[{"\[ScriptCapitalD]", "[", "other_", "]"}], ",", 
           RowBox[{"\[ScriptCapitalD]", "[", "bound_", "]"}]}], "]"}], ",", 
         "v_"}], "]"}]}], ":>", 
      RowBox[{"Partials", "[", 
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{
          RowBox[{"\[ScriptCapitalD]", "[", "other", "]"}], ",", 
          RowBox[{"\[ScriptCapitalD]", "[", "free", "]"}]}], "]"}], ",", 
        "v"}], "]"}]}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.978799451983548*^9, 3.978799553296142*^9}, {
  3.9787996454426327`*^9, 3.978799647843099*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"9bab225a-0f16-466f-aa27-4f17e3f2fef5"]
}, Open  ]],

