Cell[TextData[{
 "metric symmetry: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], "=", 
    SubscriptBox["g", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Nu]", "\[VeryThinSpace]", "\[Mu]"}]}]]}], TraditionalForm]],
  ExpressionUUID->"14cefe90-6ebc-486c-9ed5-cbeeaee1d1fb"],
 ", required by standard general relativity"
}], "Item",
 CellChangeTimes->{{3.978729275710746*^9, 3.97872936944556*^9}, {
   3.9787961972639*^9, 3.97879620526226*^9}, 
   3.979350002342268*^9},ExpressionUUID->"88693217-3b4c-45da-b013-\
583c59e317d0"],

Cell[TextData[{
 "metric contraction to the Kronecker delta: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Lambda]", "\[VeryThinSpace]", "\[Nu]"}]}]], 
     SuperscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Lambda]", "\[VeryThinSpace]", "\[Mu]"}]}]]}], "=", 
    SubsuperscriptBox["\[Delta]", 
     RowBox[{"\[VeryThinSpace]", "\[Nu]"}], 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}], TraditionalForm]],
  ExpressionUUID->"2171b675-1bd9-4c06-92fa-463aaddec177"],
 " (gUpUp is inverse of gDownDown)"
}], "Item",
 CellChangeTimes->{{3.978729394868044*^9, 3.978729442918882*^9}, {
  3.979350007366852*^9, 
  3.979350020373356*^9}},ExpressionUUID->"bd14ede0-061e-4c02-a68f-\
d891fb0004d6"],

Cell[TextData[{
 "contraction of Kronecker delta on derivatives, for the chain rule: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Delta]", 
      RowBox[{"\[VeryThinSpace]", "\[Nu]"}], 
      RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], 
     SubscriptBox["\[PartialD]", "\[Mu]"]}], "=", 
    SubscriptBox["\[PartialD]", "\[Nu]"]}], TraditionalForm]],
