       SubscriptBox[
        RowBox[{"g", 
         SubscriptBox["", "\[Sigma]23"], 
         SubscriptBox["", "b"]}], 
        RowBox[{",", "a"}]], "+", 
       SubscriptBox[
        RowBox[{"g", 
         SubscriptBox["", "\[Sigma]23"], 
         SubscriptBox["", "a"]}], 
        RowBox[{",", "b"}]], "-", 
       SubscriptBox[
        RowBox[{"g", 
         SubscriptBox["", "a"], 
         SubscriptBox["", "b"]}], 
        RowBox[{",", "\[Sigma]23"}]]}], ")"}]}]}], "]"}]}]], "Output",
