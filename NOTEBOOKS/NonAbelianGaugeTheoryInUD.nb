Cell[CellGroupData[{

Cell["Appendix 1: Spin Connection as Gravitational Gauge", "Section",
 CellChangeTimes->{{3.9784634251754417`*^9, 3.978463431650586*^9}, {
  3.978467221274311*^9, 3.978467228737336*^9}, {3.9785311553116007`*^9, 
  3.9785311740560427`*^9}, {3.978531214043825*^9, 3.978531227439899*^9}, {
  3.978531309854751*^9, 
  3.97853131020317*^9}},ExpressionUUID->"8b07ab75-9d83-4f32-9461-\
b8e99837bcf0"],

Cell[TextData[{
 "Gravitation acts ",
 StyleBox["almost",
  FontSlant->"Italic"],
 " like any other gauge theory, but not quite. Gravitational forces arise \
from spacetime connections ",
 StyleBox["in",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" the geometry",
  FontWeight->"Bold"],
 ", while other force theories arise from non-coordinate connections ",
 StyleBox["on",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" the geometry",
  FontWeight->"Bold"],
 ", in \[OpenCurlyDoubleQuote]wallpaper\[CloseCurlyDoubleQuote] spaces like \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "(", "1", ")"}], TraditionalForm]],ExpressionUUID->
  "bd5ad103-5b1d-4a0c-9549-9edce7eed96f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"SU", "(", "3", ")"}], TraditionalForm]],ExpressionUUID->
  "8a6b79a7-efa8-450c-8c02-7d9e936c65c8"],
 ". This partial fit between gravitation and other gauge theories only \
deepens the frustration of unification-seekers."
}], "Text",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637888906593`*^9}, {
   3.978467146885333*^9, 3.9784671744670887`*^9}, {3.978467237695951*^9, 
   3.978467248435212*^9}, {3.978467484630767*^9, 3.978467573417486*^9}, 
   3.978467641682742*^9, {3.9785368916333027`*^9, 3.97853704904286*^9}, {
   3.978636220839507*^9, 3.9786362354029503`*^9}, {3.978791880984424*^9, 
   3.978791972877468*^9}, {3.978792273328435*^9, 3.97879230699052*^9}, {
   3.978895793916624*^9, 3.9788959970090923`*^9}, {3.978896028048177*^9, 
   3.978896043389203*^9}, {3.978995632476274*^9, 3.9789956503540497`*^9}, {
   3.9793501425132713`*^9, 3.979350146946752*^9}, {3.979350269995667*^9, 
   3.979350307164682*^9}, {3.9800891694976683`*^9, 3.980089218361525*^9}, {
   3.980089379584957*^9, 
   3.98008940665073*^9}},ExpressionUUID->"3c19d593-6ddb-49e5-bed9-\
0aa8c7dd4c77"],

Cell["\<\
To make gravitation a full gauge theory, we must find conserved quantities \
arising from local gauge invariance. The definitive review paper is the \
following:\
\>", "Text",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637888906593`*^9}, {
   3.978467146885333*^9, 3.9784671744670887`*^9}, {3.978467237695951*^9, 
