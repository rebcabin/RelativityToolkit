b39e0dad228a"],

Cell[CellGroupData[{

Cell[TextData[{
 "delta contraction inside metric derivatives: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Delta]", "\[Nu]", 
      RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], 
     SubscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{
        RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Lambda]"}], 
        "\[VeryThinSpace]", ",", "\[VeryThinSpace]", "\[Rho]"}]}]]}], "=", 
    SubscriptBox["g", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{
       RowBox[{"\[Nu]", "\[VeryThinSpace]", "\[Lambda]"}], "\[VeryThinSpace]",
        ",", "\[VeryThinSpace]", "\[Rho]"}]}]]}], TraditionalForm]],
  ExpressionUUID->"841697dc-84b0-44da-9072-510edc33650f"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Delta]", "\[Nu]", 
      RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], 
     SubscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{
        RowBox[{"\[Lambda]", "\[VeryThinSpace]", "\[Mu]"}], 
        "\[VeryThinSpace]", ",", "\[VeryThinSpace]", "\[Rho]"}]}]]}], "=", 
    SubscriptBox["g", 
     RowBox[{"\[VeryThinSpace]\[VeryThinSpace]", 
      RowBox[{
       RowBox[{"\[Lambda]", "\[VeryThinSpace]", "\[Nu]"}], "\[VeryThinSpace]",
        ",", "\[VeryThinSpace]", "\[Rho]"}]}]]}], TraditionalForm]],
  ExpressionUUID->"9a0cda09-c666-4c00-ab90-db3714e16247"]
}], "Item",
