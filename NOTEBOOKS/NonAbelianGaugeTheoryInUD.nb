Cell[BoxData[
 RowBox[{
  SubsuperscriptBox["\[CapitalGamma]", 
   RowBox[{"a_", "b_"}], "\[Lambda]_"], "\[RuleDelayed]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Sigma]", "=", 
      RowBox[{"Unique", "[", "\<\"\[Sigma]\"\>", "]"}]}], "}"}], ",", 
