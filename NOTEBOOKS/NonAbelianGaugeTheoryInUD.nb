   3.978792585465941*^9}, {3.978792620049286*^9, 3.9787926303018427`*^9}, {
   3.978896047129113*^9, 3.978896053503016*^9}, {3.978995674044548*^9, 
   3.97899568898982*^9}},ExpressionUUID->"55d526cf-57ce-40e2-a6d6-\
a6f50ee3aa40"],

