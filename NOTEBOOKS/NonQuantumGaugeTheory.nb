Cell[TextData[{
 "metric symmetry: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], "=", 
    SubscriptBox["g", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Nu]", "\[VeryThinSpace]", "\[Mu]"}]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b61af907-8562-428a-a1f9-9c6b9508292a"],
 ", require by standard general relativity"
}], "Item",
 CellChangeTimes->{{3.978729275710746*^9, 3.97872936944556*^9}, {
  3.9787961972639*^9, 
  3.97879620526226*^9}},ExpressionUUID->"88693217-3b4c-45da-b013-\
583c59e317d0"],

Cell[TextData[{
 "metric contraction to the Kronecker delta: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Lambda]", "\[VeryThinSpace]", "\[Nu]"}]}]], 
     SuperscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Lambda]", "\[VeryThinSpace]", "\[Mu]"}]}]]}], "=", 
    SubsuperscriptBox["\[Delta]", 
     RowBox[{"\[VeryThinSpace]", "\[Nu]"}], 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "87c61ac1-5231-462a-b804-86ceb109df78"]
}], "Item",
 CellChangeTimes->{{3.978729394868044*^9, 
  3.978729442918882*^9}},ExpressionUUID->"bd14ede0-061e-4c02-a68f-\
d891fb0004d6"],

Cell[TextData[{
 "contraction of Kronecker delta on derivatives for the chain rule: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Delta]", 
      RowBox[{"\[VeryThinSpace]", "\[Nu]"}], 
      RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], 
     SubscriptBox["\[PartialD]", "\[Mu]"]}], "=", 
    SubscriptBox["\[PartialD]", "\[Nu]"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bc0bc856-d058-4521-ac8b-8974cbcc4c04"]
}], "Item",
