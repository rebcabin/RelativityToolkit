     RowBox[{",", "\[Rho]"}]], ")"}]}], "-", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{"g", 
     SubscriptBox["", "\[FormalLambda]324"], 
     SubscriptBox["", "\[Nu]"]}], ")"}], " ", 
   RowBox[{"(", 
