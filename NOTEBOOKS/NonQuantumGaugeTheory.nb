Cell[CellGroupData[{

Cell["Compiling Derivatives of the Metric", "Subsection",
 CellChangeTimes->{{3.977679946253248*^9, 
  3.977679959029337*^9}},ExpressionUUID->"530219b3-8834-4d96-b1ab-\
152e56e80c02"],

Cell["\<\
Let\[CloseCurlyQuote]s do a two-pass pipeline compilation of derivatives: \
algebrize then differentiate. \
\>", "Text",
 CellChangeTimes->{{3.977673685955389*^9, 3.977673702246863*^9}, {
  3.977674835814443*^9, 3.977674839622085*^9}, {3.977676266466113*^9, 
  3.9776762687864637`*^9}, {3.977678201951828*^9, 3.977678221664751*^9}, {
  3.977679968081114*^9, 3.977679970691435*^9}, {3.9776821878231792`*^9, 
  3.977682189121583*^9}, {3.977748962109561*^9, 
  3.9777489779204693`*^9}},ExpressionUUID->"c5bd6ff5-6c71-4ee8-9139-\
33cc315e2fd6"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Many areas of physics and mathematics employ 0\
\[NoBreak]-\[NoBreak]based indexing, while Wolfram is \
1\[NoBreak]-\[NoBreak]based. We have found by experience that the best way to \
handle this discrepancy is to translate between indexing schemes at the last \
possible time and place: in the deepest Part expressions and in return \
values. Any other approach tends to proliferate the index translations into \
unwanted places.", "Item",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.977682244225511*^9, 3.977682404804381*^9}, {
  3.977749023005251*^9, 
  3.977749054459846*^9}},ExpressionUUID->"dbb2283d-e1f0-48e3-a068-\
1dd3bc424001"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "DifferentiateTheMetric", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DifferentiateTheMetric", "[", 
    RowBox[{"expr_", ",", "gDD_", ",", "gUU_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lowerGeometry", ",", "activateCalculus"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"PASS", " ", "1"}], ":", " ", "Geometry"}], "->", "Algebra"}],
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Correct", " ", "for", " ", "physics", " ", "g_", "00", " ", "to", " ", 
       
       RowBox[{"Wolfram", " ", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], " ", "at", " ", "the", " ", 
       "last", " ", "possible", " ", "moment"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"lowerGeometry", "=", 
       RowBox[{"expr", "//.", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{
             RowBox[{"\[ScriptCapitalD]", "[", "a_", "]"}], ",", 
             RowBox[{"\[ScriptCapitalD]", "[", "b_", "]"}]}], "]"}], ":>", 
           RowBox[{"gDD", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"1", "+", "a"}], ",", 
              RowBox[{"1", "+", "b"}]}], "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{
             RowBox[{"\[ScriptCapitalU]", "[", "a_", "]"}], ",", 
             RowBox[{"\[ScriptCapitalU]", "[", "b_", "]"}]}], "]"}], ":>", 
           RowBox[{"gUU", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"1", "+", "a"}], ",", 
              RowBox[{"1", "+", "b"}]}], "]"}], "]"}]}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"PASS", " ", "2"}], ":", " ", 
        RowBox[{"transpile", " ", "\[ScriptCapitalU]\[ScriptCapitalD]", " ", 
         RowBox[{"Partials", " ", "\[LongRightArrow]", " ", "Wolfram"}], " ", 
         "D"}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"activateCalculus", "=", 
       RowBox[{"lowerGeometry", "//.", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Partials", "[", 
           RowBox[{"content_", ",", 
            RowBox[{"x", "[", 
             RowBox[{"\[ScriptCapitalU]", "[", "dir_", "]"}], "]"}]}], "]"}], 
          ":>", "\[IndentingNewLine]", 
          RowBox[{"D", "[", 
           RowBox[{"content", ",", 
            RowBox[{"workingCoords", "[", 
             RowBox[{"[", 
              RowBox[{"1", "+", "dir"}], "]"}], "]"}]}], "]"}]}], "}"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Simplify", "[", "activateCalculus", "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.977671701961773*^9, 3.9776717019634666`*^9}, 
   3.977672016325259*^9, {3.977672538654307*^9, 3.977672543798789*^9}, {
   3.977672856742405*^9, 3.977672858851077*^9}, {3.977673072432103*^9, 
   3.9776730761291847`*^9}, {3.977673212978238*^9, 3.977673316772957*^9}, {
   3.977673356476471*^9, 3.977673380120572*^9}, {3.977673514296154*^9, 
   3.977673535615026*^9}, {3.977673660579521*^9, 3.977673680788039*^9}, {
   3.9776737151637907`*^9, 3.97767372108921*^9}, {3.977673863794252*^9, 
   3.977673913184236*^9}, {3.977673999699318*^9, 3.9776740209357224`*^9}, {
   3.977674127020874*^9, 3.9776741574938517`*^9}, {3.9776743669071608`*^9, 
   3.9776744090866537`*^9}, {3.977674930278378*^9, 3.977674948763159*^9}, {
   3.97767534906103*^9, 3.977675376205297*^9}, {3.977676384000084*^9, 
   3.9776763975231657`*^9}, {3.977676571073567*^9, 3.9776765780611563`*^9}, {
   3.977676669015551*^9, 3.977676671756233*^9}, {3.977676867831813*^9, 
   3.977676868802656*^9}, {3.977677681834918*^9, 3.977677742375587*^9}, {
   3.9776778025628977`*^9, 3.9776778291338043`*^9}, {3.977677933230266*^9, 
   3.977677997614155*^9}, {3.9776822031611443`*^9, 3.977682234452839*^9}, {
   3.977682410779715*^9, 3.9776824312466288`*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"cab53e83-ab94-47c7-b699-cdc161a0976d"]
}, Open  ]],

