Cell[CellGroupData[{

Cell["Optional: Configure Relativity Connection Symbol", "Subsection",
 CellChangeTimes->{{3.9775176800467176`*^9, 3.977517685457151*^9}, {
  3.977644427456564*^9, 3.9776444329596653`*^9}, {3.978358022660828*^9, 
  3.9783580250320253`*^9}},ExpressionUUID->"fd562242-cb5f-4257-94c4-\
9c3dcffe6af8"],

Cell["\<\
To properly compose covariant derivatives, \[ScriptCapitalU]\[ScriptCapitalD] \
must know the user\[CloseCurlyQuote]s reserved symbols for non-tensorial \
connection coefficients. In gravitational physics, these force-producing \
connections are called \[CapitalGamma] (capital gamma). Other theories like \
electrodynamics and Yang-Mills that can benefit from \[ScriptCapitalU]\
\[ScriptCapitalD] use other connection symbols. \
\>", "Text",
 CellChangeTimes->{{3.977517690693409*^9, 3.9775178232519913`*^9}, {
  3.97751956997919*^9, 3.9775195720756073`*^9}, {3.9775280931539383`*^9, 
  3.977528124823065*^9}, {3.977535721478539*^9, 3.977535724386561*^9}, {
  3.9776444438816977`*^9, 3.977644712294363*^9}, {3.9777468389285183`*^9, 
  3.977747007351509*^9}, {3.977747054921603*^9, 
  3.9777470563202457`*^9}},ExpressionUUID->"860dae44-cbbe-4334-bee0-\
eb8dbe58ad65"],

Cell["\<\
We\[CloseCurlyQuote]re going with \[CapitalGamma] for this \
relativity/gravitation notebook. \
\>", "Text",
 CellChangeTimes->{{3.977517690693409*^9, 3.9775178232519913`*^9}, {
  3.97751956997919*^9, 3.9775195720756073`*^9}, {3.9775280931539383`*^9, 
  3.977528124823065*^9}, {3.977535721478539*^9, 3.977535724386561*^9}, {
  3.9776444438816977`*^9, 3.977644762630517*^9}, {3.977747016178646*^9, 
  3.97774702870907*^9}},ExpressionUUID->"6412f41d-f02b-4a24-b243-\
19b7651c936f"],

Cell[CellGroupData[{

