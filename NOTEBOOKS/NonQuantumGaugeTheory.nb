     SubscriptBox["", "\[FormalLambda]325"]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"g", 
     SuperscriptBox["", "\[FormalLambda]325"], 
     SuperscriptBox["", "\[Sigma]339"]}], ")"}], " ", 
