   3.978992956836452*^9, 
   3.97899298390783*^9}},ExpressionUUID->"42d44efc-8058-4cde-8725-\
4b44091f330b"],

Cell[TextData[{
 StyleBox["Field Strength Invariance",
  FontSlant->"Italic"],
 ": the electromagnetic tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]], TraditionalForm]],
  ExpressionUUID->"14518f12-c9cb-4005-ad09-cc4b6fc219d8"],
 "\:200b is invariant under local gauge transformations"
}], "Item",
 CellChangeTimes->{
  3.977513712847348*^9, {3.9775178669407883`*^9, 3.977517959906126*^9}, {
   3.977517996418476*^9, 3.977518072452635*^9}, {3.9775181219359083`*^9, 
   3.977518224156801*^9}, {3.9775359524035*^9, 3.977536075585163*^9}, {
   3.97753737910937*^9, 3.977537384309*^9}, {3.97764405920399*^9, 
