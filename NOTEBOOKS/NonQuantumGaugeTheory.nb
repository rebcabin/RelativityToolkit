D6IzZY2mgOgQ/sPTQLTV6dh/PUD63JGrYPpbx2KmXiBdp/seTButXLDiIJBO
dWtfDaLtDjgdAtFd+jFXQXRQQtlNEL3CVOwxiDb4wrLpM5A2/L1jG4jWnqp6
H0RfXp/8GkQrtvxfMXvxW0eNgDtbQDQAlgbSDg==
  "],ExpressionUUID->"9910a85e-2bba-45ec-b23f-e7caad461b51"],

Cell[TextData[{
 "With that realization, we can confidently set up ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", 
    RowBox[{"\[Gamma]", "(", 
     RowBox[{
      SubscriptBox["\[Del]", "\[Delta]"], 
      SuperscriptBox["A", "\[Beta]"]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"109b24a4-1bea-4898-911b-cb40201dca7d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "\[Delta]"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", "\[Gamma]"], 
      SuperscriptBox["A", "\[Beta]"]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"d449d9df-942e-4fff-9182-cf04f6a1c99c"],
 " and visually spot the boxed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "\[CapitalGamma]"}], TraditionalForm]],ExpressionUUID->
  "0ec3e058-936d-4ca7-b97e-b27362d41e88"],
 " terms at-a-glance:"
}], "Text",
 CellChangeTimes->{{3.977527325502906*^9, 3.977527421512032*^9}, {
  3.977527457843831*^9, 3.97752752535949*^9}, {3.977527722794066*^9, 
  3.977527724861456*^9}, {3.977528305919705*^9, 3.977528327199279*^9}, {
  3.97752967593775*^9, 3.9775296842284822`*^9}, {3.9775302539774723`*^9, 
  3.977530258128994*^9}, {3.977537581604781*^9, 3.97753758702244*^9}, {
  3.977645879921488*^9, 3.97764597320695*^9}, {3.97764609836301*^9, 
  3.977646100453302*^9}},ExpressionUUID->"3994da14-b995-457b-bd0a-\
61f4dabf8303"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"term1", "=", 
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"CD", "[", 
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]", "]"}], "]"}], ",", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Delta]", "]"}], "]"}]}], "]"}],
        ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Gamma]", "]"}], "]"}]}], "]"}]}],
     ",", "\"\<\[Del]\[Gamma](\!\(\*SubscriptBox[\(\[Del]\), \
\(\[Delta]\)]\)\!\(\*SuperscriptBox[\(A\), \(\[Beta]\)]\)) =\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"term2", "=", 
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"CD", "[", 
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]", "]"}], "]"}], ",", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Gamma]", "]"}], "]"}]}], "]"}],
        ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Delta]", "]"}], "]"}]}], "]"}]}],
     ",", "\"\<\!\(\*SubscriptBox[\(\[Del]\), \
\(\[Delta]\)]\)(\!\(\*SubscriptBox[\(\[Del]\), \
\(\[Gamma]\)]\)\!\(\*SuperscriptBox[\(A\), \(\[Beta]\)]\)) =\>\""}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{
  3.9775274263216267`*^9, {3.9775274904972773`*^9, 3.977527502308569*^9}, {
   3.977527871342442*^9, 3.977527872518971*^9}, {3.97764650581187*^9, 
   3.977646509003475*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"61b2e451-809d-40dd-9cda-52a664fa25f1"],

Cell[TextData[{
 StyleBox["At the risk of overselling, no one should do this kind of \
calculation by hand. Ah, memories of lonely nights in the Physics Library \
with pen and paper! That\[CloseCurlyQuote]s the whole point of ",
  FontSlant->"Italic"],
 "\[ScriptCapitalU]\[ScriptCapitalD]",
 StyleBox[": delegating risky and tedious calculations to Wolfram. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977148448717927*^9, 3.977148601137877*^9}, {
  3.9771487883591347`*^9, 3.977148838436544*^9}, {3.97715053773209*^9, 
  3.977150607874874*^9}, {3.9773249732467318`*^9, 3.977324973635874*^9}, {
  3.977325004140476*^9, 3.977325152474333*^9}, {3.977327554521559*^9, 
  3.9773275834121027`*^9}, {3.97752836844738*^9, 3.977528500060755*^9}, {
  3.9775304467634363`*^9, 3.977530478081773*^9}, {3.97764598900867*^9, 
  3.977646006344201*^9}, {3.97764605480369*^9, 3.977646073198969*^9}, {
  3.9776461725324*^9, 3.9776462685480556`*^9}, {3.977748430519945*^9, 
  3.977748450153935*^9}, {3.978091970702231*^9, 
  3.978091986152519*^9}},ExpressionUUID->"53b7095b-7ffd-4e9a-8a5f-\
49b84ca7f9b7"],

Cell["Look at the RAW commutator, with boxed terms, now:", "Text",
 CellChangeTimes->{{3.977528607677047*^9, 3.977528657973105*^9}, {
  3.977528768337226*^9, 3.9775288310291243`*^9}, {3.977530485701873*^9, 
  3.9775305047845583`*^9}, {3.977537622866194*^9, 3.9775376248576193`*^9}, {
  3.977646127840207*^9, 
  3.9776461305012827`*^9}},ExpressionUUID->"f8c7ce29-06b2-44b1-badd-\
33538fe570b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"rawCommutator", "=", 
     RowBox[{"term1", "-", "term2"}]}], 
    ",", "\"\<\!\(TraditionalForm\`\[Del]\[Gamma] \
\((\*SubscriptBox[\(\[Del]\), \(\[Delta]\)]\*SuperscriptBox[\(A\), \
\(\[Beta]\)])\) - \*SubscriptBox[\(\[Del]\), \
\(\[Delta]\)]\((\*SubscriptBox[\(\[Del]\), \
\(\[Gamma]\)]\*SuperscriptBox[\(A\), \(\[Beta]\)])\)\) =\>\""}], "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{
  3.97752866135876*^9, 3.977528704519404*^9, 3.9775288429168043`*^9, {
   3.977532333408565*^9, 3.977532336308819*^9}, {3.977646499758812*^9, 
   3.97764650154303*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"416ee8b0-9d46-4d73-96fe-18365b1492b8"],

Cell[TextData[{
 StyleBox["Now",
  FontSlant->"Italic"],
 " that all the explosive \[Del] terms are evaluated, it\[CloseCurlyQuote]s \
time to apply the product (Leibniz) rule from ordinary calculus via ",
 StyleBox["ExpandDerivatives", "Input"],
 " and open these terms to ordinary Wolfram algebraic simplification. "
}], "Text",
 CellChangeTimes->{{3.9775287571362247`*^9, 3.977528760456421*^9}, {
  3.977528862869022*^9, 3.9775290150975246`*^9}, {3.9775305134720173`*^9, 
  3.977530641668908*^9}, {3.977534278362068*^9, 3.977534297720924*^9}, {
  3.977646151690436*^9, 3.9776461586907454`*^9}, {3.9777485167713423`*^9, 
  3.977748521971155*^9}},ExpressionUUID->"14bc7c28-8bc4-4033-9912-\
fb595cf98f98"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Applying the Product Rule", "Subsubsection",
 CellChangeTimes->{{3.977534763245243*^9, 
  3.9775347680786953`*^9}},ExpressionUUID->"e7927d72-3e4f-4539-955d-\
420c837f7cee"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"expanded", "=", 
      RowBox[{"ExpandDerivatives", "[", "rawCommutator", "]"}]}], 
     ",", "\"\<expanded commutator :\>\""}], "]"}], ";"}], " "}]], "Input",
 CellChangeTimes->{{3.977530779086885*^9, 3.977530783117169*^9}, 
   3.9775323413963842`*^9, 3.977534306277322*^9},
 CellLabel->"In[13]:=",ExpressionUUID->"dcdd3e97-2533-4519-ad64-822d5eec22d5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Step 2: Canonicalize and Eliminate Torsion", "Subsection",
 CellChangeTimes->{{3.97753435260457*^9, 
  3.977534367089591*^9}},ExpressionUUID->"e5f9acae-9721-4942-ba8a-\
f03cb056abc5"],

Cell[TextData[{
 "Now, canonicalize indices and apply the torsion rules, which express ",
 StyleBox["physical ",
  FontSlant->"Italic"],
 "symmetry of \[CapitalGamma] in general relativity. "
}], "Text",
 CellChangeTimes->{{3.9775341102150784`*^9, 3.9775341648014383`*^9}, {
  3.977534376530195*^9, 3.977534396298911*^9}, {3.977537695887838*^9, 
  3.9775377007598333`*^9}, {3.97764697741973*^9, 3.977646989372484*^9}, {
  3.9777485379283047`*^9, 
  3.977748542717504*^9}},ExpressionUUID->"980d453a-fc5a-49fc-8265-\
52fe77240a63"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Other applications of differential geometry may have \
non-zero torsion, but not gravitation. ",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.9775341102150784`*^9, 3.9775341648014383`*^9}, {
  3.977534376530195*^9, 3.977534396298911*^9}, {3.977537695887838*^9, 
  3.9775377007598333`*^9}, {3.97764697741973*^9, 3.9776469870338783`*^9}, {
  3.977748554324061*^9, 
  3.9777485617546463`*^9}},ExpressionUUID->"17b60920-e10f-410a-a18f-\
1661d9e830f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"simplified", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"CanonicalizeIndices", "[", "expanded", "]"}], "//.", 
        "torsionRules"}], ")"}]}], ",", "\"\<canon - torsion :\>\""}], "]"}], 
   ";"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.977531978388423*^9, 3.977531985718758*^9}, {
   3.97753201853048*^9, 3.97753204092213*^9}, {3.9775320720555067`*^9, 
   3.977532105522291*^9}, 3.9775321380508547`*^9, {3.97753221125675*^9, 
   3.9775322249728537`*^9}, {3.977532259081963*^9, 3.977532261480406*^9}, {
   3.9775341784788437`*^9, 3.977534185724959*^9}, {3.977534330560224*^9, 
   3.977534333566969*^9}, 3.97753479458757*^9, {3.977595258382463*^9, 
   3.977595262114802*^9}, {3.977646587218831*^9, 3.977646587585724*^9}, {
   3.977646654553358*^9, 3.97764667001342*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"8edd2ca6-739b-4c11-9ae9-174527c5c075"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Step 3: Apply Quotient Theorem", "Subsection",
 CellChangeTimes->{{3.977534811694808*^9, 
  3.977534820574092*^9}},ExpressionUUID->"0798bfd9-ec3a-4660-b6fb-\
dceeccdda63a"],

Cell[TextData[{
 "Riemann is peeking out! To recover Riemann alone, quotient-out the tensor, ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "5581d17c-dd0a-4689-870e-3872c7318946"],
 " (it\[CloseCurlyQuote]s arbitrary), and we have a raw Riemann tensor."
}], "Text",
 CellChangeTimes->{{3.9775348672450113`*^9, 3.977534921429079*^9}, {
  3.977647028399776*^9, 3.977647042095449*^9}, {3.977647156088853*^9, 
  3.977647159342825*^9}, {3.9777485883875504`*^9, 
  3.977748599623336*^9}},ExpressionUUID->"c991b992-a225-48cd-9654-\
8be28bed3995"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["To borrow jargon from functional programming, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"Riemann", ".", "A"}], TraditionalForm]],ExpressionUUID->
  "0d28bb70-2a46-4152-9eb2-a18542775415"],
 " ",
 StyleBox["is \[OpenCurlyDoubleQuote]partially evaluated\
\[CloseCurlyDoubleQuote] on ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "35e2f21d-c745-4208-bffb-3cf2395e2905"],
 ". ",
 StyleBox["The quotient theorem undoes the partial evaluation by a kind of \
functional factoring that Haskell Curry formalized.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9775349371788797`*^9, 3.9775350053537703`*^9}, {
  3.9775377236462507`*^9, 3.9775377478652563`*^9}, {3.977748606743505*^9, 
  3.97774863268403*^9}},ExpressionUUID->"23a79924-59ef-441c-becf-\
ddb6297abe9f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"rawRiemann1", "=", 
     RowBox[{"ExtractCoefficient", "[", 
      RowBox[{"simplified", ",", "A"}], "]"}]}], 
    ",", "\"\<raw Riemann :\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{3.9775348259064627`*^9, 3.978340916963431*^9},
 CellLabel->"In[15]:=",ExpressionUUID->"6c115821-aea7-42a4-9aa4-f48247d3eb9d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Step 4: Presentation", "Subsection",
 CellChangeTimes->{{3.977535013718762*^9, 
  3.977535039568735*^9}},ExpressionUUID->"573dd0d0-71e4-4d5f-a62a-\
ea242f12d852"],

Cell[TextData[{
 "Produce readable Greek via \[ScriptCapitalU]\[ScriptCapitalD]\
\[CloseCurlyQuote]s ",
 StyleBox["TensorForm", "Input"],
 ". Bring our ground-truth image nearby for a final look. Except for ordering \
of terms and renaming of indices, (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"my", " ", "\[Lambda]"}], "->", 
    RowBox[{"their", " ", "\[Beta]"}]}], TraditionalForm]],ExpressionUUID->
  "ae985777-f0fa-46ea-b15f-8d12407924e8"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"my", " ", "\[Kappa]"}], "->", 
    RowBox[{"their", " ", "\[Lambda]"}]}], TraditionalForm]],ExpressionUUID->
  "e2a021a6-7aa8-4ca5-85f5-965de5161c20"],
 " in the linear \[CapitalGamma] terms, summation over my \[Lambda] and their \
\[Mu] in the quadratic \[CapitalGamma] terms), they\[CloseCurlyQuote]re \
identical. \[ScriptCapitalU]\[ScriptCapitalD] has removed the hazard of \
getting the signs and indices wrong."
}], "Text",
 CellChangeTimes->{{3.97753507424326*^9, 3.977535201264265*^9}, {
   3.977535329349928*^9, 3.977535395262293*^9}, 3.9775377666937313`*^9, {
   3.977595324258156*^9, 3.977595328968614*^9}, {3.977595385083993*^9, 
   3.9775954151306562`*^9}, {3.977595462316207*^9, 3.9775955112529716`*^9}, {
   3.977647053312406*^9, 3.97764705450622*^9}, {3.977647087432807*^9, 
   3.977647221917602*^9}, {3.977748657028232*^9, 3.9777487318744164`*^9}, {
   3.978341666802154*^9, 
   3.978341749219327*^9}},ExpressionUUID->"66b5264d-f6de-4b91-999d-\
51e020d821a7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"TensorForm", "[", "rawRiemann1", "]"}], ",", 
    " ", "\"\<\!\(\*SubscriptBox[SuperscriptBox[\(R\), \(\[Alpha]\)], \(\
\[Lambda]\[Gamma]\[Delta]\)]\) =\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{3.978340921598579*^9},
 CellLabel->"In[16]:=",ExpressionUUID->"0521e6a5-10f1-4049-9638-f51ab77c825e"],

Cell[BoxData[
 GraphicsBox[
  TagBox[RasterBox[CompressedData["
