   3.978992994285054*^9},ExpressionUUID->"271d4663-6211-435b-b224-\
6d5149ea04e7"],

Cell[TextData[{
 StyleBox["Charged Vector Boson Covariance",
  FontSlant->"Italic"],
 ": In the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", 
    RowBox[{"(", "1"}]}], TraditionalForm]],ExpressionUUID->
  "0a1f298b-d04f-43a4-8511-7fa8b83dd7a2"],
 ") sector of Weinberg-Salam electroweak theory, we show prove covariance for \
a vector field ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["W", 
    RowBox[{"\[VeryThinSpace]", "\[Alpha]"}]], TraditionalForm]],
  ExpressionUUID->"64b8d383-7c29-4e2a-8185-81e6faf8a122"],
 " that enjoys both spacetime and internal phase invariance"
}], "Item",
 CellChangeTimes->{
