Cell[CellGroupData[{

Cell["Recap from GitHub Repo", "Section",
 CellChangeTimes->{{3.977595291939233*^9, 
  3.977595297864235*^9}},ExpressionUUID->"0e9b1b6e-1a30-458a-b8d7-\
450704b5fb26"],

Cell["\<\
You can also run a stored version of this calculation from the GitHub repo. \
The indices and order of terms are different by choice and/or accident. \
Cycling indices shows the results are mathematically identical to the above.\
\>", "Text",
 CellChangeTimes->{{3.97764723864895*^9, 3.977647347442388*^9}, {
  3.9777026284225283`*^9, 3.977702629021467*^9}, {3.9777487478262777`*^9, 
