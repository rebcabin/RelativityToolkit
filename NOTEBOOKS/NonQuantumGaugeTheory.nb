Cell[CellGroupData[{

Cell["Bundles", "Subsection",
 CellChangeTimes->{{3.978534620958468*^9, 
  3.9785346234123287`*^9}},ExpressionUUID->"37f8bfad-b634-498e-b7a2-\
57fc091afecc"],

Cell[TextData[{
 "Spaces attached to each point of a manifold are collected and flattened \
into sets called ",
 StyleBox["bundles",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". They are ",
 StyleBox["fibre bundles",
  FontSlant->"Italic"],
 " of projection functions (detail below). "
}], "Text",
 CellChangeTimes->{{3.9785337697934113`*^9, 3.9785338776311903`*^9}, {
   3.978533953387677*^9, 3.978533953387751*^9}, {3.97853422177457*^9, 
   3.978534225657858*^9}, {3.9785342895116253`*^9, 3.9785343259537077`*^9}, {
   3.978565370253133*^9, 3.978565370940113*^9}, {3.9786091121205378`*^9, 
   3.978609114549533*^9}, 3.97860915340592*^9, {3.978609183476355*^9, 
   3.978609215477162*^9}, 3.978609566699403*^9, 3.978609997222831*^9, {
   3.9786131955327787`*^9, 3.978613197675498*^9}, {3.978616701947626*^9, 
   3.978616708148559*^9}, {3.978617067287068*^9, 3.9786171604525127`*^9}, {
   3.978617255862715*^9, 3.9786172937364187`*^9}, {3.978618124089023*^9, 
   3.97861813063551*^9}, {3.978629948385647*^9, 3.978629992429248*^9}, {
   3.978793053641073*^9, 3.978793068992897*^9}, {3.978793103747045*^9, 
   3.9787931077822247`*^9}},ExpressionUUID->"b11d4781-ab88-434a-b039-\
adfad7eaca64"],

Cell[TextData[{
 "In applications, there are two distinguished bundles: the ",
 StyleBox["principal bundle",
  FontSlant->"Italic"],
 " and the ",
 StyleBox["associated bundle",
  FontSlant->"Italic"],
 ", in a matched pair. Looking ahead, connections on sections of the \
principal bundle are \[OpenCurlyDoubleQuote]sources\[CloseCurlyDoubleQuote] \
of forces, and the associated bundles supply the quantities subject to \
forces, \[OpenCurlyDoubleQuote]victims\[CloseCurlyDoubleQuote] of forces. \
This is clarified below under ",
 StyleBox["sections",
  FontSlant->"Italic"],
 " and ",
 StyleBox["connections",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.9785337697934113`*^9, 3.9785338776311903`*^9}, {
   3.978533953387677*^9, 3.978533953387751*^9}, {3.97853422177457*^9, 
   3.978534225657858*^9}, {3.9785342895116253`*^9, 3.9785343259537077`*^9}, {
   3.978565370253133*^9, 3.978565370940113*^9}, {3.9786091121205378`*^9, 
   3.978609114549533*^9}, 3.97860915340592*^9, {3.978609183476355*^9, 
   3.978609215477162*^9}, 3.978609566699403*^9, 3.978609997222831*^9, {
   3.9786131955327787`*^9, 3.978613197675498*^9}, {3.978616701947626*^9, 
   3.978616708148559*^9}, {3.978617067287068*^9, 3.9786171604525127`*^9}, {
   3.978617255862715*^9, 3.9786172937364187`*^9}, {3.978618124089023*^9, 
   3.97861813063551*^9}, {3.978629948385647*^9, 3.978629992429248*^9}, {
   3.978793053641073*^9, 3.978793068992897*^9}, {3.978793103747045*^9, 
   3.978793117035335*^9}, {3.978794127933522*^9, 3.978794223056271*^9}, {
   3.9787943889545927`*^9, 
   3.978794447860814*^9}},ExpressionUUID->"94c12762-f68a-422a-9e7c-\
928e6bbe4ed0"],

Cell[CellGroupData[{

Cell["Geometry / Gravitation", "Subsubsection",
 CellChangeTimes->{{3.978610020731121*^9, 3.978610036160133*^9}, {
   3.9786105312566423`*^9, 3.978610535109613*^9}, 
   3.978611513175046*^9},ExpressionUUID->"e1e5dc3b-3089-4fb6-b313-\
3b9d87d966c9"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "p"], "M"}], TraditionalForm]],ExpressionUUID->
  "09ef8377-e2a8-43f8-a63b-70e0f1bd1252"],
 " (an indivisible notation) be the set of all tangent vectors at point ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "bfb302d0-d03f-49c8-bab2-e4268c421db3"],
 " of the manifold. Likewise, the cotangent bundle ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["T", 
     RowBox[{" ", "\[Star]"}]], "M"}], TraditionalForm]],ExpressionUUID->
  "ffa2c40d-2896-4e63-888d-02e56ee42aab"],
 " is the set of all points paired with all covectors at each point, and so \
on for each valence (combination of up-down indices) of tensor. "
}], "Text",
 CellChangeTimes->{{3.9785337697934113`*^9, 3.9785338776311903`*^9}, {
   3.978533953387677*^9, 3.978533953387751*^9}, {3.97853422177457*^9, 
   3.978534225657858*^9}, {3.9785342895116253`*^9, 3.9785343259537077`*^9}, {
   3.978565370253133*^9, 3.978565370940113*^9}, {3.9786091121205378`*^9, 
   3.978609114549533*^9}, 3.97860915340592*^9, {3.978609183476355*^9, 
   3.978609215477162*^9}, 3.978609566699403*^9, {3.978610043004067*^9, 
   3.97861004643222*^9}, {3.9786107405140533`*^9, 3.9786107504432783`*^9}, {
   3.978610991507159*^9, 3.978611017712021*^9}, {3.978611074310563*^9, 
   3.9786110764843807`*^9}, {3.978611472518639*^9, 3.978611499313816*^9}, {
   3.978613216330398*^9, 3.978613217949849*^9}, {3.978615058162003*^9, 
   3.9786150601962852`*^9}, {3.978793172042605*^9, 
   3.978793199809843*^9}},ExpressionUUID->"ff2d6922-06d2-413e-8518-\
b0d7f21785d1"],

Cell[TextData[{
 "An ",
 StyleBox["associated bundle",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (victims of forces) of gravitation is the ",
 StyleBox["tangent bundle",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "\[InvisibleSpace]", "M"}], TraditionalForm]],ExpressionUUID->
  "a56b5dfc-9a30-4544-a60f-60e4e22c86ea"],
 ", the ",
 StyleBox["disjoint union",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of all points ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "e15af990-6a8b-424b-b602-dc7b0cf3f3b4"],
 " in the manifold paired with all vectors ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "bbbcf0e8-bea6-4c06-a3cf-e3385c37a7f6"],
 " ripped out of their tangent spaces at ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b017c699-d448-4eb4-8a79-bdd0ec34d198"],
 ", flattened into one big set of pairs:"
}], "Text",
 CellChangeTimes->{{3.9785337697934113`*^9, 3.9785338776311903`*^9}, {
   3.978533953387677*^9, 3.978533953387751*^9}, {3.97853422177457*^9, 
   3.978534225657858*^9}, {3.9785342895116253`*^9, 3.9785343259537077`*^9}, {
   3.978565370253133*^9, 3.978565370940113*^9}, {3.9786091121205378`*^9, 
   3.978609114549533*^9}, 3.97860915340592*^9, {3.978609183476355*^9, 
   3.978609215477162*^9}, 3.978609566699403*^9, {3.978610043004067*^9, 
   3.97861004643222*^9}, {3.9786107405140533`*^9, 3.9786107504432783`*^9}, {
   3.978610991507159*^9, 3.978611017712021*^9}, {3.978611074310563*^9, 
   3.9786110764843807`*^9}, {3.978611472518639*^9, 3.978611499313816*^9}, {
   3.978613216330398*^9, 3.978613234038809*^9}, {3.978630610425107*^9, 
   3.97863061330947*^9}, {3.978793610961524*^9, 3.978793657152853*^9}, {
   3.978793930661029*^9, 3.978793934512459*^9}, {3.978794469813917*^9, 
   3.9787944748681803`*^9}, {3.978794610210526*^9, 
   3.9787946104598637`*^9}},ExpressionUUID->"1c9cf850-9d8f-424e-b10b-\
ce5bbc3c5a0c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"T", "\[InvisibleSpace]", "M"}], "\[Congruent]", 
    RowBox[{
     UnderscriptBox["\[UnionPlus]", 
      RowBox[{"p", "\[Element]", "M"}]], 
     RowBox[{"{", 
      RowBox[{"v", "\[Element]", 
       RowBox[{
        SubscriptBox["T", "p"], "M"}]}], "}"}]}]}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p", ",", "v"}], ")"}], "\[VerticalSeparator]", 
       RowBox[{"p", "\[Element]", "M"}]}], ",", 
      RowBox[{"v", "\[Element]", 
       RowBox[{
        SubscriptBox["T", "p"], "M"}]}]}], "}"}], "        ", 
    RowBox[{"(", 
     RowBox[{
      StyleBox[
       RowBox[{"associated", " ", "bundle"}],
       FontWeight->"Bold"], 
      StyleBox[",",
       FontSlant->"Italic"], 
      StyleBox[" ",
       FontSlant->"Italic"], 
      RowBox[{"victims", " ", "of", " ", "forces"}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.978536252547608*^9, 3.9785363333422127`*^9}, {
  3.978536382006474*^9, 3.978536407733314*^9}, {3.978536441275195*^9, 
  3.978536464451877*^9}, {3.9785366613424397`*^9, 3.978536663412154*^9}, {
  3.978619574703458*^9, 3.9786195950412493`*^9}, {3.978794265269246*^9, 
  3.9787942712635736`*^9}},ExpressionUUID->"92b52b31-d94d-4433-96c4-\
1dedc1cfc25b"],

Cell[TextData[StyleBox["The other geometrical bundles, for tensors of other \
valences, can also be associated bundles (victims of forces).",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.978794495545578*^9, 
  3.978794525778447*^9}},ExpressionUUID->"2623e09b-e333-463c-bce6-\
7eba9d154084"],

Cell[TextData[{
 "The ",
 StyleBox["principal bundle",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (sources of forces) is the ",
 StyleBox["frame bundle",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", which supplies, at each point, all possible bases for frames of \
reference. "
}], "Text",
 CellChangeTimes->{{3.9786167492761297`*^9, 3.978616957293448*^9}, {
   3.978617205439373*^9, 3.978617211355123*^9}, 3.978617248149592*^9, {
   3.978618101991022*^9, 3.978618104903288*^9}, {3.978619421559497*^9, 
   3.978619503622305*^9}, {3.9786206605047703`*^9, 3.9786206609560127`*^9}, {
   3.978793217375163*^9, 3.9787932332339354`*^9}, {3.9787936622485857`*^9, 
   3.978793689930871*^9}, {3.978794370499264*^9, 3.978794375443087*^9}, {
   3.9787945410366592`*^9, 
   3.97879455076523*^9}},ExpressionUUID->"acf65408-5bab-4bba-ad1c-\
a0cf1fe59ea0"],

Cell[TextData[StyleBox["All possible bases include the ordinary coordinate \
bases that conceal spin and the tetrad bases that reveal the spin connection, \
source of spin-coupled forces (Appendix 1).",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.978793709247778*^9, 3.978793733977631*^9}, {
  3.978793949810968*^9, 3.978793996789567*^9}, {3.978794575143347*^9, 
  3.978794589266966*^9}},ExpressionUUID->"572bec55-2502-449d-afc3-\
f4e30a8ca1b4"],

Cell[TextData[{
 "Again, for emphasis, the ",
 StyleBox["associated bundles",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (victims of forces) are the associated tangent, cotangent, etc. bundles, \
which supply all possible tensors at each point."
}], "Text",
 CellChangeTimes->{{3.9786167492761297`*^9, 3.978616957293448*^9}, {
   3.978617205439373*^9, 3.978617211355123*^9}, 3.978617248149592*^9, {
   3.978618101991022*^9, 3.978618104903288*^9}, {3.978619421559497*^9, 
   3.978619503622305*^9}, {3.9786206605047703`*^9, 3.9786206609560127`*^9}, {
   3.978793217375163*^9, 3.9787932332339354`*^9}, {3.9787936622485857`*^9, 
   3.978793675614684*^9}, {3.978794008640341*^9, 3.978794021787203*^9}, {
   3.9787943613213463`*^9, 3.97879436606166*^9}, {3.978794599590845*^9, 
   3.978794599853366*^9}, {3.978794660265607*^9, 
   3.978794690302784*^9}},ExpressionUUID->"e0d98c05-473f-4393-8a1a-\
6f846b3c82f4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Gauge Fields", "Subsubsection",
 CellChangeTimes->{{3.9786105476867523`*^9, 
  3.978610550610092*^9}},ExpressionUUID->"de4c45fc-f01f-42e0-ac95-\
3813a7ebf51e"],

Cell[TextData[{
 "With electrodynamics, imagine a copy of the symmetry group ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "(", "1", ")"}], TraditionalForm]],ExpressionUUID->
  "a2eba104-13d5-467f-8af3-eabb76136429"],
 " (aka ",
 StyleBox["structure group",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ") attached to each point ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "\[Element]", "M"}], TraditionalForm]],ExpressionUUID->
  "766829a6-dd05-42e7-99a1-f61c2b39743f"],
 ". The members of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "(", "1", ")"}], TraditionalForm]],ExpressionUUID->
  "e695197d-9200-4aa4-9494-b5c191978657"],
 " are phase factors, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{" ", 
     RowBox[{"i", "\[VeryThinSpace]", "\[CurlyPhi]"}]}]], TraditionalForm]],
  ExpressionUUID->"73c1430a-e490-457c-9819-6d4d703febbf"],
 " (abbreviated as ",
 Cell[BoxData[
  FormBox["\[CurlyPhi]", TraditionalForm]],ExpressionUUID->
  "d5dbfd52-0858-4ab4-b459-18b06669f779"],
 "), each representing a choice of gauge at that point. The ",
 StyleBox["principal bundle",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (sources of forces) is the disjoint union of all manifold points ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "2dd85722-c8e1-4ff7-ba92-9ae000232cb8"],
 " paired with all possible phase factors at ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "011ae8c3-be4d-475d-8528-07b33be64f8f"],
 ", flattened into one big set of pairs."
}], "Text",
 CellChangeTimes->{{3.978610776827626*^9, 3.978610963334448*^9}, {
   3.978611090717127*^9, 3.978611229408873*^9}, {3.978611323973156*^9, 
   3.978611324792211*^9}, {3.9786113642629833`*^9, 3.978611370554421*^9}, {
   3.9786115287708406`*^9, 3.9786115907361107`*^9}, {3.978611620902936*^9, 
   3.9786116425286093`*^9}, 3.978612284506898*^9, 3.978612486085968*^9, {
   3.978613264102476*^9, 3.978613319122534*^9}, {3.9786152695168657`*^9, 
   3.978615271907991*^9}, {3.978630564093375*^9, 3.978630593801581*^9}, {
   3.978793253197365*^9, 3.978793277612628*^9}, {3.978794706016749*^9, 
   3.978794740627527*^9}},ExpressionUUID->"820d3dfb-82dd-4dc7-8f8f-\
49020f19de11"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"U", "(", "1", ")"}], "\[InvisibleSpace]", "M"}], "\[Congruent]", 
    RowBox[{
     UnderscriptBox["\[UnionPlus]", 
      RowBox[{"p", "\[Element]", "M"}]], 
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{" ", 
         RowBox[{"i", "\[VeryThinSpace]", "\[CurlyPhi]"}]}]], "\[Element]", 
       RowBox[{"U", "(", "1", ")"}]}], "}"}]}]}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p", ",", "\[CurlyPhi]"}], ")"}], "\[VerticalSeparator]", 
       RowBox[{"p", "\[Element]", "M"}]}], ",", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{" ", 
         RowBox[{"i", "\[VeryThinSpace]", "\[CurlyPhi]"}]}]], "\[Element]", 
       RowBox[{"U", "(", "1", ")"}]}]}], "}"}], "        ", 
    RowBox[{"(", 
     RowBox[{
      StyleBox[
       RowBox[{"principal", " ", "bundle"}],
       FontWeight->"Bold"], 
      StyleBox[",",
       FontWeight->"Plain"], 
      StyleBox[" ",
       FontWeight->"Plain"], 
      StyleBox[
       RowBox[{"sources", " ", "of", " ", "forces"}],
       FontWeight->"Plain"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.978536252547608*^9, 3.9785363333422127`*^9}, {
  3.978536382006474*^9, 3.978536407733314*^9}, {3.978536441275195*^9, 
  3.978536464451877*^9}, {3.9785366613424397`*^9, 3.978536663412154*^9}, {
  3.97861125186147*^9, 3.978611346081366*^9}, {3.9786116490321283`*^9, 
  3.9786116719119377`*^9}, {3.978613348650969*^9, 3.978613352677422*^9}, {
  3.978619601950555*^9, 3.978619608472932*^9}, {3.9787942917604313`*^9, 
  3.978794295851322*^9}},ExpressionUUID->"1839a85b-8319-49f4-b2f8-\
831b811d95e7"],

Cell[TextData[StyleBox["We might call it a phase bundle. ",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.978612336676198*^9, 3.97861234931007*^9}, {
   3.978612412886875*^9, 3.978612480210724*^9}, {3.978613362346743*^9, 
   3.978613370805771*^9}, {3.978615289938593*^9, 3.9786152971759653`*^9}, 
   3.978793308231369*^9},ExpressionUUID->"4c878b3e-961b-4f28-a8f4-\
b3ed8f07d15b"],

Cell[TextData[{
 "In classical (non-quantum) electrodynamics, the ",
 StyleBox["associated bundle",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (victims of forces) is the ",
 StyleBox["complex line bundle",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", a collection of pairs of a point and a copy of the entire complex plane \
at that point, accounting for all possible values of a complex-valued ",
 StyleBox["charged matter field",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". This field represents density and internal alignment (physical \
interpretation of phase) of a notional charged fluid. "
}], "Text",
 CellChangeTimes->{{3.978617337613049*^9, 3.97861747132668*^9}, {
  3.978617502789029*^9, 3.978617603261848*^9}, {3.978617638300981*^9, 
  3.978617641170998*^9}, {3.978617698025502*^9, 3.978617700989966*^9}, {
  3.97861773415965*^9, 3.978617737676187*^9}, {3.978617782982095*^9, 
  3.9786178639734097`*^9}, {3.978620635782177*^9, 3.978620636857772*^9}, {
  3.978630646123019*^9, 3.978630742701017*^9}, {3.978793322031499*^9, 
  3.978793360529962*^9}, {3.978794329288187*^9, 
  3.978794333733552*^9}},ExpressionUUID->"340b52d5-8b95-4de6-b42c-\
2bd179af489e"],

Cell[TextData[{
 StyleBox["The copies of the complex plane in the associated bundle is the ",
  FontSlant->"Italic"],
 "entire",
 StyleBox[" complex plane, not just the members of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "(", "1", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fd66afbe-cd76-4e58-a72f-60983b559f60"],
 StyleBox[", which are confined to the unit circle in the complex plane.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.978793386034062*^9, 3.978793468621681*^9}, {
  3.978794780215925*^9, 
  3.97879478136475*^9}},ExpressionUUID->"99b24021-737d-4ea7-b033-\
84a85c9ae100"],

Cell["\<\
In quantum electrodynamics, the associated bundle is a collection of pairs of \
points and all possible Dirac wave functions, each of which is a \
superposition of spinor states. In this notebook, we cover only the classical \
case. The quantum case comes later in this series of notebooks.\
\>", "Text",
 CellChangeTimes->{{3.978617337613049*^9, 3.97861747132668*^9}, {
   3.978617502789029*^9, 3.978617603261848*^9}, {3.978617638300981*^9, 
   3.978617641170998*^9}, {3.978617698025502*^9, 3.978617700989966*^9}, {
   3.97861773415965*^9, 3.978617737676187*^9}, {3.978617782982095*^9, 
   3.9786178639734097`*^9}, {3.978620635782177*^9, 3.978620636857772*^9}, {
   3.978630646123019*^9, 3.978630727077107*^9}, 3.9786307586420317`*^9, {
   3.9787934726658087`*^9, 3.97879351752697*^9}, {3.978794793244575*^9, 
   3.978794799423637*^9}},ExpressionUUID->"6b8abeb0-bb20-4cf3-b88c-\
5d6dc4990110"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Projections", "Subsection",
 CellChangeTimes->{{3.9785346368223343`*^9, 
  3.978534638392181*^9}},ExpressionUUID->"13cda263-d877-4e17-93a8-\
84190ee5f13b"],

Cell[TextData[{
 "Envision a ",
 StyleBox["projection function",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", ",
 Cell[BoxData[
  FormBox["\[Pi]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dd9bb589-d994-4f67-9d1c-011bb4ffdb78"],
 ", that yields ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3274655f-b7fe-4eeb-8638-91f2129ae427"],
 " from any element of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "\[InvisibleSpace]", "M"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "16a0a457-3fa7-415d-bb29-e89c724a0a36"],
 ":"
}], "Text",
 CellChangeTimes->{{3.978534230982245*^9, 3.978534277559758*^9}, {
   3.978534331527849*^9, 3.9785343820634108`*^9}, {3.978534465764699*^9, 
   3.9785344890023537`*^9}, 
   3.97861168830488*^9},ExpressionUUID->"714f13de-82c2-4d5d-901e-\
aa51e9c59d64"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Pi]", ":", 
    RowBox[{"T", "\[InvisibleSpace]", 
     RowBox[{"M", "\[LongRightArrow]", "M"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"p", ",", "v"}], ")"}], "\[Function]", "p"}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.978534494749681*^9, 3.978534574123632*^9}, {
  3.978534670872239*^9, 3.978534687023288*^9}, {3.978609300680241*^9, 
  3.9786093028335953`*^9}, {3.978630812578383*^9, 3.9786308200833073`*^9}, {
  3.9786371512770042`*^9, 
  3.978637153066635*^9}},ExpressionUUID->"d8138ce0-b17b-421d-96a9-\
4b8aabb0b5b8"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]forgetting\[CloseCurlyDoubleQuote] the vector ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4a78abf4-2eae-4a88-9a3d-d612d71624ed"],
 "."
}], "Text",
 CellChangeTimes->{{3.9786093197483664`*^9, 3.978609328169428*^9}, {
  3.978609541698853*^9, 
  3.978609544217308*^9}},ExpressionUUID->"bd2a5172-e61c-4c2b-8185-\
956356253ffe"],

Cell[TextData[{
 "In electromagnetism, the projection function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Pi]", ":", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"U", "(", "1", ")"}], "M"}], ")"}], "\[LongRightArrow]", 
      "M"}]}], ",", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"p", ",", "\[CurlyPhi]"}], ")"}], "\[Function]", "p"}]}], 
   TraditionalForm]],ExpressionUUID->"be54f582-b31b-44af-9226-aff0d9c0435a"],
 " forgets the phase factor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{" ", 
     RowBox[{"i", "\[VeryThinSpace]", "\[CurlyPhi]"}]}]], TraditionalForm]],
  ExpressionUUID->"18d3a2fc-cacf-47ac-ab1b-70a8b7e68c98"],
 " from any given pair in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"U", "(", "1", ")"}], "M"}], TraditionalForm]],ExpressionUUID->
  "fabf7dc3-fb18-4d33-a309-d11ff61ac697"],
 "."
}], "Text",
 CellChangeTimes->{{3.978611712779502*^9, 3.978611813717507*^9}, {
  3.978637184202026*^9, 3.978637252240052*^9}, {3.978794827002458*^9, 
  3.978794827291143*^9}},ExpressionUUID->"a478a0cf-9834-4792-bdb4-\
08521f757a0c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Fibres", "Subsection",
 CellChangeTimes->{{3.978534719410666*^9, 
  3.978534721240078*^9}},ExpressionUUID->"08219a22-ac61-4381-adb5-\
f2734674eeb0"],

Cell[TextData[{
 "In elementary mathematics, the ",
 StyleBox["fibre",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"fib", "(", 
     RowBox[{"f", ",", "p"}], ")"}], "\[Congruent]", 
    RowBox[{
     SuperscriptBox["f", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"-", "1"}]}]], "(", "p", ")"}]}], TraditionalForm]],
  ExpressionUUID->"e4e88076-4165-41dd-bcd9-34df9b0c3724"],
 ", of a function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "de551bb4-db70-4ee7-be8e-e1978c55b430"],
 " at some point ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "4f09fbcb-c915-441e-ad88-e6dc1fc0f758"],
 " is the preimage of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "74e96738-8eac-4f7d-ab98-55e570adf9fb"],
 " at ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "1ed84278-4b93-427f-91a7-9fbbaf2e77c1"],
 ", that is, the subset of the domain of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "b4628e69-2ba1-405c-a12b-120920ebedd8"],
 " that yield ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "5ea807f3-e957-443d-90fd-cd56dfde58cc"],
 ". "
}], "Text",
 CellChangeTimes->{{3.978534732741*^9, 3.978534801948558*^9}, {
   3.978535533932482*^9, 3.978535840151739*^9}, 3.978562464260809*^9, {
   3.978609624599626*^9, 3.978609657317874*^9}, {3.9787948881439857`*^9, 
   3.978794890151215*^9}},ExpressionUUID->"e31aafa7-d004-4219-b07a-\
d7cb5eecee8c"],

Cell[TextData[{
 StyleBox["In this usage,",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["f", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"-", "1"}]}]], TraditionalForm]],ExpressionUUID->
  "d4eb1c47-82d9-44fa-888c-c3bd177241ad"],
 StyleBox[" is not an \[OpenCurlyDoubleQuote]inverse function\
\[CloseCurlyDoubleQuote] that yields points, but a function that yields \
subsets.",
  FontSlant->"Italic"],
 " ",
 StyleBox["A general ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "74bff7fd-462a-4e70-9130-401bf754b1be"],
 StyleBox[" may not be \[OpenCurlyDoubleQuote]invertible\
\[CloseCurlyDoubleQuote] in the usual sense of a point-to-point bijective \
function, but we can always define a fibre: a set containing all points of \
the domain that yield ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "428e7565-516d-4422-ad38-8a20fb2819f4"],
 StyleBox[". Unfortunately, we have the same notation,",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["f", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"-", "1"}]}]], TraditionalForm]],ExpressionUUID->
  "c40cdfa1-07b9-446e-b16d-156da9829b69"],
 StyleBox[", both for an inverse function when",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "e7cd8938-fc22-4cae-9fcd-6ac6125ab36e"],
 StyleBox[" is invertible and for a fibre generally.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.978534732741*^9, 3.978534801948558*^9}, {
   3.978535533932482*^9, 3.9785358322098618`*^9}, 3.978535876519286*^9, {
   3.978562493011778*^9, 3.978562567596758*^9}, {3.9786096640400133`*^9, 
   3.978609667511774*^9}, {3.97860988727013*^9, 3.978609911537752*^9}, {
   3.978611865857236*^9, 3.978611902234301*^9}, {3.97879485542148*^9, 
   3.9787948602285433`*^9}},ExpressionUUID->"5e139343-5f3d-42e9-88c2-\
6f6a785a2308"],

Cell["\<\
The fibres of the bundles\[LongDash]principal or associated\[LongDash]of \
interest to us are those of the projection functions \[Pi]. \
\>", "Text",
 CellChangeTimes->{{3.97853647690399*^9, 3.978536526208434*^9}, {
   3.978536677483802*^9, 3.978536704804984*^9}, {3.978609716275861*^9, 
   3.978609720345071*^9}, {3.9786097519213667`*^9, 3.978609820866146*^9}, {
   3.9786119178608828`*^9, 3.978611921644511*^9}, {3.978611953493753*^9, 
   3.978612018860235*^9}, {3.9786123686061163`*^9, 3.9786123716331253`*^9}, {
   3.978613403898473*^9, 3.978613404337824*^9}, {3.978618169895947*^9, 
   3.978618174684943*^9}, {3.978620554107813*^9, 3.9786205753599358`*^9}, 
   3.978630889305987*^9},ExpressionUUID->"9b84b74c-45c6-469c-b130-\
ec1d1a42a718"],

Cell[TextData[{
 "In geometry, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Pi]", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"-", "1"}]}]], TraditionalForm]],ExpressionUUID->
  "7d17a0aa-d098-4785-a94a-4633ddae4880"],
 " can\[CloseCurlyQuote]t \[OpenCurlyDoubleQuote]remember\
\[CloseCurlyDoubleQuote] the forgotten vector, so it must return the set of \
all vectors attached to ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "afc26d80-6aa5-454e-a723-a611b558d5e8"],
 " (or, more generally, tensors):"
}], "Text",
 CellChangeTimes->{{3.97853647690399*^9, 3.978536526208434*^9}, {
  3.978536677483802*^9, 3.978536704804984*^9}, {3.978609716275861*^9, 
  3.978609720345071*^9}, {3.9786097519213667`*^9, 3.978609820866146*^9}, {
  3.9786119178608828`*^9, 3.978611921644511*^9}, {3.978611953493753*^9, 
  3.978611987276039*^9}, {3.978612022725803*^9, 3.978612025777298*^9}, {
  3.978794912196023*^9, 
  3.978794921646134*^9}},ExpressionUUID->"db395a1e-92ab-425d-bbe4-\
ffb99c96293b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[Pi]", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"-", "1"}]}]], 
    RowBox[{"(", "p", ")"}]}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"v", "\[Element]", 
      RowBox[{
       SubscriptBox["T", "p"], "M"}]}], "}"}], "\[Congruent]", 
    RowBox[{
     SubscriptBox["T", "p"], "M", "    ", 
     RowBox[{"(", 
      RowBox[{"victims", " ", "of", " ", "forces"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.978536541888927*^9, 3.978536594878606*^9}, {
  3.9785368301532087`*^9, 3.9785368407927647`*^9}, {3.978794955961952*^9, 
  3.978794982232902*^9}},ExpressionUUID->"1a37363d-1527-4e05-a415-\
dd4a854a5fdc"],

Cell[TextData[{
 "which is, of course, the entire tangent space at ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "15b7f309-1932-455c-a9b3-45b88e3793a9"],
 "."
}], "Text",
 CellChangeTimes->{{3.978536601569244*^9, 3.978536608667962*^9}, {
   3.978536716905881*^9, 3.9785367421603928`*^9}, 3.978536806359707*^9, {
   3.978536844826271*^9, 3.9785368481557617`*^9}, {3.978564556581566*^9, 
   3.97856459464423*^9}, {3.978609830122525*^9, 
   3.9786098514389553`*^9}},ExpressionUUID->"b7e06054-fee5-4fbc-8a0b-\
f147e32fad7d"],

Cell[TextData[{
 "In electrodynamics, the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Pi]", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "45db5e45-cb86-42bf-b4a5-3cc6084aa9ed"],
 " can\[CloseCurlyQuote]t remember the forgotten phase factor, so it must \
return a complete copy of U(1) at each point:"
}], "Text",
 CellChangeTimes->{{3.9786119323047857`*^9, 3.9786119425955257`*^9}, {
  3.97861203276105*^9, 
  3.978612072123682*^9}},ExpressionUUID->"60a3ad7b-da5c-4761-8b9e-\
b0cf1ebdd17c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[Pi]", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"-", "1"}]}]], "(", "p", ")"}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{" ", 
        RowBox[{"i", "\[VeryThinSpace]", "\[CurlyPhi]"}]}]], "\[Element]", 
      RowBox[{"U", "(", "1", ")"}]}], "}"}], "\[Congruent]", 
    RowBox[{
     RowBox[{"U", "(", "1", ")"}], "    ", 
     RowBox[{"(", 
      RowBox[{"sources", " ", "of", " ", "forces"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.978536541888927*^9, 3.978536594878606*^9}, {
  3.9785368301532087`*^9, 3.9785368407927647`*^9}, {3.978612115118609*^9, 
  3.9786121249115667`*^9}, {3.978794987023965*^9, 
  3.978794991774843*^9}},ExpressionUUID->"b2c1d242-ee5b-4e85-b1b2-\
1944e78293fe"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sections", "Subsection",
 CellChangeTimes->{{3.978609866250651*^9, 3.9786098672186327`*^9}, 
   3.9786181927615213`*^9},ExpressionUUID->"ae2ad0ea-6e14-494c-bd9d-\
340d51807174"],

Cell[CellGroupData[{

Cell["Geometry / Gravitation", "Subsubsection",
 CellChangeTimes->{{3.9786153614096947`*^9, 
  3.9786153684695463`*^9}},ExpressionUUID->"0a84c5db-8861-4a6a-9944-\
8c3f1c990561"],

Cell[TextData[{
 "A ",
 StyleBox["section of the principal bundle",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (sources of forces, the frame bundle) is a particular choice of reference \
frame at each point\[LongDash]a coordinate basis for the Christoffel \
connection or a non-coordinate, tetrad basis for the spin connection. "
}], "Text",
 CellChangeTimes->{{3.978609930319846*^9, 3.9786099831206093`*^9}, {
   3.978612137776319*^9, 3.9786122227561502`*^9}, {3.978613020479918*^9, 
   3.978613027802144*^9}, {3.978613536253792*^9, 3.9786135408663807`*^9}, {
   3.978615326019122*^9, 3.97861535617354*^9}, {3.978618207709373*^9, 
   3.978618322733069*^9}, {3.978618586501148*^9, 3.978618648470048*^9}, {
   3.978619664367496*^9, 3.978619719070904*^9}, {3.978630928677722*^9, 
   3.978630933300482*^9}, 3.9787921570971813`*^9, {3.978795017498665*^9, 
   3.978795053079075*^9}, {3.978795095301181*^9, 
   3.9787950989849663`*^9}},ExpressionUUID->"46d802c8-ee93-474f-8508-\
5316caa4c8e8"],

Cell[TextData[{
 "A ",
 StyleBox["section of the associated bundle",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (victims of forces, the tangent bundle) is a smooth choice of one vector, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["V", 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], "(", "p", ")"}], 
   TraditionalForm]],ExpressionUUID->"39efcac8-8da6-4091-a8d2-3bcce7663ece"],
 ", at each point, amounting to a smoothly varying vector field subject to \
forces. "
}], "Text",
 CellChangeTimes->{{3.978609930319846*^9, 3.9786099831206093`*^9}, {
  3.978612137776319*^9, 3.9786122227561502`*^9}, {3.978613020479918*^9, 
  3.978613027802144*^9}, {3.978613536253792*^9, 3.9786135408663807`*^9}, {
  3.978615326019122*^9, 3.97861535617354*^9}, {3.978618207709373*^9, 
  3.978618322733069*^9}, {3.978618586501148*^9, 3.978618648470048*^9}, {
  3.978619664367496*^9, 3.9786197300296783`*^9}, {3.978630955273563*^9, 
  3.978630960651164*^9}, {3.9787950641718388`*^9, 3.978795067235722*^9}, {
  3.9787951054728737`*^9, 
  3.978795111967174*^9}},ExpressionUUID->"0c7f3c70-ec02-45a0-938d-\
76cb1c6fd6e5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Gauge Fields", "Subsubsection",
 CellChangeTimes->{{3.978615373993559*^9, 
  3.978615377695138*^9}},ExpressionUUID->"fb082247-791a-4506-a80c-\
7f785a31d255"],

Cell[TextData[{
 "In electrodynamics, a ",
 StyleBox["section of the principal bundle",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (sources of forces, the phase bundle) is a smooth choice of phase, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyPhi]", "(", "p", ")"}], TraditionalForm]],ExpressionUUID->
  "78e70e76-0e36-4ced-8672-b3e46edd5eb1"],
 ", at each point, which is a field of complex numbers of unit magnitude. It \
is the gauge-theory analog of a reference frame, a locally varying gauge \
choice. "
}], "Text",
 CellChangeTimes->{{3.978609930319846*^9, 3.9786099831206093`*^9}, {
  3.978612137776319*^9, 3.9786122227561502`*^9}, {3.978613020479918*^9, 
  3.978613027802144*^9}, {3.978613536253792*^9, 3.9786135408663807`*^9}, {
  3.978615326019122*^9, 3.978615329475129*^9}, {3.978618329709124*^9, 
  3.978618418007229*^9}, {3.9786184534335613`*^9, 3.9786185423111563`*^9}, {
  3.978619737423946*^9, 3.978619775844203*^9}, {3.978630978418358*^9, 
  3.978631024430695*^9}, {3.978795116112173*^9, 
  3.978795119390874*^9}},ExpressionUUID->"588e7976-3021-4038-bd00-\
0f4563292133"],

Cell[TextData[{
 "A ",
 StyleBox["section of the associated bundle",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (victims of forces, matter fields) is a smooth choice of complex-valued \
charged matter field at each point (classical), or a smooth choice of Dirac \
wave function at each point (quantum)."
}], "Text",
 CellChangeTimes->{{3.978609930319846*^9, 3.9786099831206093`*^9}, {
  3.978612137776319*^9, 3.9786122227561502`*^9}, {3.978613020479918*^9, 
  3.978613027802144*^9}, {3.978613536253792*^9, 3.9786135408663807`*^9}, {
  3.978615326019122*^9, 3.978615329475129*^9}, {3.978618329709124*^9, 
  3.978618418007229*^9}, {3.9786184534335613`*^9, 3.9786185423111563`*^9}, {
  3.978619760394846*^9, 3.978619795715515*^9}, {3.9787951374619837`*^9, 
  3.978795150181077*^9}},ExpressionUUID->"4625fdde-c175-456c-b06a-\
5b8ecb70976b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Connections", "Subsection",
 CellChangeTimes->{{3.978612528004575*^9, 
  3.9786125294618807`*^9}},ExpressionUUID->"7a26d8c0-d1fc-42f0-bdbd-\
bd2fcb3ee0a4"],

Cell[CellGroupData[{

Cell["Geometry / Gravitation", "Subsubsection",
 CellChangeTimes->{{3.978612549134192*^9, 
  3.978612556863188*^9}},ExpressionUUID->"332fa87d-f0bf-4121-8e9b-\
9a373c67d85d"],

Cell[TextData[{
 "The connection on the gravitational principal bundle (sources of forces) is \
the field of Christoffel Symbols ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[VeryThinSpace]", "\[Lambda]"}]], 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  ExpressionUUID->"e5edbb8b-e362-43dc-9ab0-a5fba9a95510"],
 ", or the field of spin connections. These connections describes how an \
associated section\[LongDash]the vector field ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "868e2873-fbf8-4dbf-93e5-dc207179ac87"],
 "\[LongDash]twists and turns as ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "b9928bfa-5f85-4ad5-906e-795b9d6dff13"],
 " moves. A connection is the coefficient of the correction ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", ".", "\[CapitalGamma]"}], TraditionalForm]],ExpressionUUID->
  "fba629d5-6170-4262-a3f7-c7de072bf397"],
 " that keeps the covariant derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", "V"}], TraditionalForm]],ExpressionUUID->
  "d76d32b3-17b2-403b-8e1f-211b43d817e3"],
 " tensorial. "
}], "Text",
 CellChangeTimes->{{3.978612590392126*^9, 3.978612745241934*^9}, {
   3.978612863210659*^9, 3.978612881739182*^9}, {3.9786135495284367`*^9, 
   3.978613590915903*^9}, 3.978618559958826*^9, {3.9786187024240503`*^9, 
   3.978618772397912*^9}, {3.9786188036222773`*^9, 3.9786188193055563`*^9}, {
   3.978620013253707*^9, 3.9786200496584797`*^9}, {3.978620322053335*^9, 
   3.978620323813134*^9}, {3.9786203670050297`*^9, 3.978620368744391*^9}, {
   3.9786204101244287`*^9, 3.9786204123615093`*^9}, {3.978620468040391*^9, 
   3.978620490729374*^9}, {3.978795165356558*^9, 
   3.978795168833872*^9}},ExpressionUUID->"dc1e6d01-ffc5-4ead-9488-\
7d82d73cc6c0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Gauge Fields", "Subsubsection",
 CellChangeTimes->{{3.978612560631381*^9, 
  3.978612563224308*^9}},ExpressionUUID->"80bdace9-19f7-4987-a4f9-\
ea2e31feaea5"],

Cell[TextData[{
 "The connection on the principal gauge bundle (sources of forces) is the ",
 StyleBox["gauge potential",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "\[Mu]"], "(", "p", ")"}], TraditionalForm]],
  ExpressionUUID->"97b118bb-d322-42f3-8c24-142b480b21e4"],
 ", the field of vector potentials at each point. This field of connections \
describes how the associated section\[LongDash]the charged matter field or \
the Dirac wavefunction field\[LongDash]twists and turns as ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "0a20682e-bebc-4d47-bd78-cf3fe38bca59"],
 " moves. "
}], "Text",
 CellChangeTimes->{{3.9786127863692713`*^9, 3.978612852543968*^9}, {
   3.978612890172607*^9, 3.97861293358811*^9}, {3.978612968107254*^9, 
   3.9786129946318607`*^9}, {3.9786130798902187`*^9, 3.978613125315587*^9}, 
   3.978613631494336*^9, {3.978618837287545*^9, 3.978618930398291*^9}, {
   3.9786190816830177`*^9, 3.978619108298904*^9}, {3.978620075637919*^9, 
   3.978620097748242*^9}, {3.978620509399785*^9, 3.978620511511326*^9}, {
   3.978631098586905*^9, 3.9786310987717857`*^9}, {3.9787951837125387`*^9, 
   3.9787951883010178`*^9}},ExpressionUUID->"193a81ed-758c-4d3e-9c3f-\
a233bd261087"],

Cell[TextData[{
 "Just as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[VeryThinSpace]", "\[Lambda]"}]], 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6ac7ee28-e8c7-4cf1-acc0-5fdd9d71bd4f"],
 "corrects for the twisting and turning of tangent vectors, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "\[Mu]"], "(", "p", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3ca5b841-8644-4309-aafb-e3ffdeb5e745"],
 " corrects for the twisting of the ",
 StyleBox["internal phase",
  FontSlant->"Italic"],
 " of the charged matter field. "
}], "Text",
 CellChangeTimes->{{3.9786127863692713`*^9, 3.978612852543968*^9}, {
   3.978612890172607*^9, 3.97861293358811*^9}, {3.978612968107254*^9, 
   3.9786129946318607`*^9}, {3.9786130798902187`*^9, 3.978613125315587*^9}, 
   3.978613631494336*^9, {3.978618837287545*^9, 3.978618930398291*^9}, {
   3.9786190816830177`*^9, 3.978619108298904*^9}, {3.978620075637919*^9, 
   3.9786201727186728`*^9}, {3.978631138178482*^9, 
   3.978631151432151*^9}},ExpressionUUID->"d0019c91-b30d-45ec-b76e-\
b8d8851ed3a4"],

Cell["\<\
Just as gravitational forces arise from the Christoffel or spin connection, \
electrodynamical forces arise from the gauge potential. We now revise our \
slogan:\
\>", "Text",
 CellChangeTimes->{{3.9786127863692713`*^9, 3.978612852543968*^9}, {
   3.978612890172607*^9, 3.97861293358811*^9}, {3.978612968107254*^9, 
   3.9786129946318607`*^9}, {3.9786130798902187`*^9, 3.978613125315587*^9}, 
   3.978613631494336*^9, {3.978618837287545*^9, 3.978618930398291*^9}, {
   3.9786190816830177`*^9, 3.978619108298904*^9}, {3.978620075637919*^9, 
   3.9786201727186728`*^9}, {3.978631138178482*^9, 3.978631138989943*^9}, {
   3.9787389725638657`*^9, 
   3.978738977393702*^9}},ExpressionUUID->"00bb480f-b07a-407f-a0d8-\
9fb062711532"],

Cell["\<\
Forces arise from connections on sections of principal bundles.\
\>", "Text",
 CellChangeTimes->{{3.978620174806469*^9, 3.978620189097069*^9}},
 FontWeight->"Bold",
 Background->RGBColor[
  1, 0.75, 0, 0.33],ExpressionUUID->"1993736d-f413-450f-a1e6-0ee7785275c4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Invariance", "Subsection",
 CellChangeTimes->{{3.978613637881114*^9, 
  3.978613642832843*^9}},ExpressionUUID->"74685e97-c472-4a8d-864b-\
39729998d333"],

Cell[TextData[{
 "If the Lagrangian density, \[ScriptCapitalL], of gravitation is ",
 "invariant",
 " with respect to smooth frame choice at each point, the physics is ",
 StyleBox["locally Lorentz invariant",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellChangeTimes->{{3.978562229995479*^9, 3.978562241481649*^9}, {
   3.9785623098398027`*^9, 3.978562408798807*^9}, {3.9785626655854053`*^9, 
   3.978562857919837*^9}, {3.978562975910346*^9, 3.9785629876360598`*^9}, {
   3.978563046861105*^9, 3.978563113027549*^9}, {3.978563159083637*^9, 
   3.978563171764503*^9}, {3.978563299932247*^9, 3.978563335347096*^9}, {
   3.9785633759954157`*^9, 3.978563459829295*^9}, {3.978563502899838*^9, 
   3.978563766087055*^9}, {3.978563811579574*^9, 3.978563811579986*^9}, {
   3.978564381012047*^9, 3.978564406134098*^9}, {3.978614081426169*^9, 
   3.978614098877798*^9}, {3.9786189528756237`*^9, 3.978619052625559*^9}, {
   3.978619117699553*^9, 3.978619165599696*^9}, 
   3.978620208049863*^9},ExpressionUUID->"243d465f-1f87-404f-ad2e-\
7adc15c04581"],

Cell[TextData[{
 "If the Lagrangian density, \[ScriptCapitalL], of electrodynamical gauge \
theory is invariant with respect to smooth choice of external unitary phase \
from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "(", "1", ")"}], TraditionalForm]],ExpressionUUID->
  "e5066e22-7320-43ee-a9ff-9ff1c246d8d1"],
 ", the physics is ",
 StyleBox["locally gauge invariant",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellChangeTimes->{{3.978562229995479*^9, 3.978562241481649*^9}, {
  3.9785623098398027`*^9, 3.978562408798807*^9}, {3.9785626655854053`*^9, 
  3.978562857919837*^9}, {3.978562975910346*^9, 3.9785629876360598`*^9}, {
  3.978563046861105*^9, 3.978563113027549*^9}, {3.978563159083637*^9, 
  3.978563171764503*^9}, {3.978563299932247*^9, 3.978563335347096*^9}, {
  3.9785633759954157`*^9, 3.978563459829295*^9}, {3.978563502899838*^9, 
  3.978563766087055*^9}, {3.978563811579574*^9, 3.978563811579986*^9}, {
  3.978564381012047*^9, 3.978564406134098*^9}, {3.978614081426169*^9, 
  3.978614098877798*^9}, {3.9786189528756237`*^9, 3.978619052625559*^9}, {
  3.978619117699553*^9, 3.978619165599696*^9}, {3.97862021136863*^9, 
  3.978620212723073*^9}},ExpressionUUID->"624b0556-b964-441f-ad39-\
83a776424b92"],

Cell[TextData[{
 StyleBox["Invariant",
  FontSlant->"Italic"],
 " here means numerically equal and of the same algebraic form, as explained \
in my earlier notebook, ",
 StyleBox[ButtonBox["From the steam age to quantum fields",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3594810"], None},
  ButtonNote->"https://community.wolfram.com/groups/-/m/t/3594810"],
  FontSlant->"Italic"],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.978562229995479*^9, 3.978562241481649*^9}, {
   3.9785623098398027`*^9, 3.978562408798807*^9}, {3.9785626655854053`*^9, 
   3.978562857919837*^9}, {3.978562975910346*^9, 3.9785629876360598`*^9}, {
