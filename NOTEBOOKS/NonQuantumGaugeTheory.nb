  3.978729280712111*^9}},ExpressionUUID->"40dbd394-2584-40db-bbf7-\
581c6f61fb47"],

Cell[TextData[{
 "metric symmetry: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], "=", 
    SubscriptBox["g", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Nu]", "\[VeryThinSpace]", "\[Mu]"}]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "14cefe90-6ebc-486c-9ed5-cbeeaee1d1fb"],
 ", require by standard general relativity"
}], "Item",
 CellChangeTimes->{{3.978729275710746*^9, 3.97872936944556*^9}, {
  3.9787961972639*^9, 
  3.97879620526226*^9}},ExpressionUUID->"88693217-3b4c-45da-b013-\
583c59e317d0"],

Cell[TextData[{
 "metric contraction to the Kronecker delta: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Lambda]", "\[VeryThinSpace]", "\[Nu]"}]}]], 
     SuperscriptBox["g", 
      RowBox[{"\[VeryThinSpace]", 
       RowBox[{"\[Lambda]", "\[VeryThinSpace]", "\[Mu]"}]}]]}], "=", 
    SubsuperscriptBox["\[Delta]", 
     RowBox[{"\[VeryThinSpace]", "\[Nu]"}], 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2171b675-1bd9-4c06-92fa-463aaddec177"]
}], "Item",
