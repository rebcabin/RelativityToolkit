 StyleBox["q", "Input"],
 ": the coupling constant or \[OpenCurlyDoubleQuote]charge\
\[CloseCurlyDoubleQuote]"
}], "ItemNumbered",
 CellChangeTimes->{{3.978795636372712*^9, 
  3.978795645409*^9}},ExpressionUUID->"77fc3235-4095-4d8d-96a1-e8b030336e52"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["A", "Input"],
 ": the gauge-field connection symbol. \[CapitalGamma] is implicitly kept as \
the spacetime connection for all theories"
}], "ItemNumbered",
 CellChangeTimes->{{3.9787956548435926`*^9, 
  3.9787956871354723`*^9}},ExpressionUUID->"04154e59-9bc7-4076-b83d-\
31acad96ae89"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CD", "[", 
    RowBox[{"expr_", ",", "var_", ",", "q_", ",", "A_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gravitationalPart", ",", "gaugeCorrection", ",", "idx"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Calculate", " ", "the", " ", "coordinate", " ", "Covariant", " ", 
       "Derivative", " ", "via", " ", "existing", " ", "CD", " ", 
       RowBox[{"overloads", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Handle", " ", 
       RowBox[{"\[PartialD]", " ", 
        RowBox[{"+", " ", "Christoffels"}]}], " ", 
       RowBox[{"(", 
        RowBox[{"if", " ", "expr", " ", "is", " ", "a", " ", "tensor"}], 
        ")"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"If", " ", "expr", " ", "is", " ", "a", " ", "scalar"}], ",", 
       " ", 
       RowBox[{"just", " ", "return", " ", 
        RowBox[{"\[PartialD]", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gravitationalPart", "=", 
       RowBox[{"CD", "[", 
        RowBox[{"expr", ",", "var"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Extract", " ", "the", " ", "index", " ", "from", " ", "the", " ", 
        "differentiation", " ", 
        RowBox[{"variable", "."}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"var", " ", "is", " ", "some", " ", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], ";", " ", 
        RowBox[{"we", " ", "need", " ", "\[Mu]"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"idx", "=", 
       RowBox[{"var", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Construct", " ", "the", " ", "Gauge", " ", "Correction"}], ",",
         " ", 
        RowBox[{"e", ".", "g", "."}], ",", " ", 
        RowBox[{
         RowBox[{"-", "i"}], " ", "q", " ", 
         SubscriptBox["A", "\[Mu]"], " ", "*", " ", "expr"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Note", ":", " ", 
        RowBox[{"This", " ", "A", " ", "has", " ", "a", " ", "DOWN", " ", 
         RowBox[{"(", "Covariant", ")"}], " ", "index", " ", "matching", " ", 
         "the", " ", "derivative"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"gaugeCorrection", "=", 
       RowBox[{
        RowBox[{"-", "I"}], "*", "q", "*", 
        RowBox[{"A", "[", 
         RowBox[{"\[ScriptCapitalD]", "[", "idx", "]"}], "]"}], "*", 
        "expr"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", "Combine", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"gravitationalPart", "+", "gaugeCorrection"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.978646744556492*^9, 3.978646885622224*^9}, 
   3.978724934490802*^9, {3.978795290664665*^9, 3.9787954073020678`*^9}, 
   3.9787954931896*^9, {3.9787956971832857`*^9, 3.978795753281424*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"3de2c0a4-4890-4dcd-8310-578ba58e364c"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

