Cell[CellGroupData[{

Cell["The Geometric Definition", "Section",
 CellChangeTimes->{{3.977518830681273*^9, 
  3.9775188392404013`*^9}},ExpressionUUID->"08c20823-40df-4e6b-87cd-\
9e80fcbce2fa"],

Cell[TextData[{
 "Misner, Thorne, & Wheeler [MTW] start in Box 11.5, page 265, with a ",
 StyleBox["commutator of covariant derivatives",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ":  "
}], "Text",
