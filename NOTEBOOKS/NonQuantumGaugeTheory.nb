Cell[TextData[{
 "Let\[CloseCurlyQuote]s differentiate the 64 internal terms of the \
Schwarzschild metric one at a time. Here is the resulting array that we\
\[CloseCurlyQuote]ll compare against the \[OpenCurlyDoubleQuote]ground truth\
\[CloseCurlyDoubleQuote] ",
 StyleBox["ChristoffelSymbol", "Input"],
 " from WFR: "
}], "Text",
 CellChangeTimes->{{3.9776825075459747`*^9, 3.977682519897132*^9}, {
  3.977749272724228*^9, 3.977749292892297*^9}, {3.977749324425728*^9, 
  3.97774938397337*^9}, {3.978092032250435*^9, 
  3.978092050716679*^9}},ExpressionUUID->"0f501e1d-0ff3-4d15-aece-\
24658076cfeb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"myGammaArray", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"DifferentiateTheMetric", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"symbolicGamma", "[", 
         RowBox[{"l", ",", "m", ",", "n"}], "]"}], ",", 
        "g\[ScriptCapitalD]\[ScriptCapitalD]", ",", 
        "g\[ScriptCapitalU]\[ScriptCapitalU]"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"l", ",", "0", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "0", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", "3"}], "}"}]}], "]"}]}], ")"}], "//", 
  "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.977671701961773*^9, 3.9776717019634666`*^9}, 
   3.977672016325259*^9, {3.977672538654307*^9, 3.977672543798789*^9}, {
   3.977672856742405*^9, 3.977672858851077*^9}, {3.977673072432103*^9, 
