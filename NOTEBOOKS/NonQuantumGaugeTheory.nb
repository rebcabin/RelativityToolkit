  3.978341815017009*^9}},ExpressionUUID->"8959856b-d3dd-4b7a-867c-\
109b67689108"],

Cell[BoxData[
 RowBox[{"Get", "[", 
  RowBox[{"RTbase", "<>", "\"\<calculate_riemann.wl\>\""}], "]"}]], "Input",
 CellChangeTimes->{{3.977595232519684*^9, 3.977595239701161*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"0ab210ee-ffda-40f7-87ec-04698e393ca3"],

Cell[CellGroupData[{

Cell["Proof: Notebook Equivalent to Script", "Subsection",
 CellChangeTimes->{{3.978341202663101*^9, 
  3.978341234297476*^9}},ExpressionUUID->"c443c63d-5cf2-4575-b7fa-\
a64d50b46f5f"],

Cell[BoxData[{
 RowBox[{"TensorForm", "[", 
  RowBox[{
   RowBox[{"CanonicalizeIndices", "[", "rawRiemann1", "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", "->", "\[Mu]"}], ",", 
     RowBox[{"\[Delta]", "->", "\[Nu]"}], ",", 
     RowBox[{"\[Gamma]", "->", "\[Rho]"}]}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"TensorForm", "[", 
  RowBox[{"CanonicalizeIndices", "[", "rawRiemann", "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9783408826825438`*^9, 3.978340901798308*^9}, {
  3.978340951406151*^9, 3.9783411382344713`*^9}, {3.978341171190331*^9, 
  3.978341178093062*^9}, {3.978341776186894*^9, 3.978341791626193*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"2ccf8fab-11ce-436f-9fe0-4f9cf52cc451"]
