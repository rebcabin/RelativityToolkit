 RowBox[{
  TagBox["\<\"Schwarzschild Solution via \[ScriptCapitalU]\[ScriptCapitalD] :\
\"\>",
   "EchoLabel"], "  ", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        FractionBox[
         RowBox[{"2", " ", "M"}], "r"]}], ",", "0", ",", "0", ",", "0"}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
