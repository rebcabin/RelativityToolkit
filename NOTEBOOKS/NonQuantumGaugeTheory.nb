Cell[CellGroupData[{

Cell["Construct \[CapitalGamma] Components in \[ScriptCapitalU]\
\[ScriptCapitalD]", "Subsection",
 CellChangeTimes->{{3.977681839049817*^9, 3.9776818695822573`*^9}, {
  3.9777491441095743`*^9, 
  3.977749145986574*^9}},ExpressionUUID->"c6e3470f-5f5c-4578-ae5b-\
7a503f08047a"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s carefully construct components of \[CapitalGamma] in \
terms of components of ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "af5680f1-7d51-4f17-9027-cfdc4ef8e88b"],
 " in \[ScriptCapitalU]\[ScriptCapitalD], again with conventional \
(non-Wolfram) zero-based indexing. Recalling from an earlier notebook of mine:"
}], "Text",
 CellChangeTimes->{{3.977675440178192*^9, 3.977675460262701*^9}, {
  3.9776782323570147`*^9, 3.977678239688795*^9}, {3.9776783096357813`*^9, 
  3.977678324171014*^9}, {3.977679774350609*^9, 3.977679786107482*^9}, {
  3.9777491275397997`*^9, 
  3.977749174795369*^9}},ExpressionUUID->"4c28a5f5-0d55-48d9-85cc-\
064f3fae1e57"],

Cell[TextData[Cell[BoxData[
 TagBox[
  RowBox[{
   SubsuperscriptBox["\[CapitalGamma]", 
    RowBox[{"\[Mu]", "\[Nu]"}], "\[Sigma]"], "\[Equal]", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"g", 
      SuperscriptBox["", "\[Sigma]"], 
      SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       RowBox[{"g", 
        SubscriptBox["", "\[Lambda]"], 
        SubscriptBox["", "\[Mu]"]}], 
       RowBox[{",", "\[Nu]"}]], "+", 
      SubscriptBox[
       RowBox[{"g", 
        SubscriptBox["", "\[Lambda]"], 
        SubscriptBox["", "\[Nu]"]}], 
       RowBox[{",", "\[Mu]"}]], "-", 
      SubscriptBox[
       RowBox[{"g", 
        SubscriptBox["", "\[Mu]"], 
        SubscriptBox["", "\[Nu]"]}], 
       RowBox[{",", "\[Lambda]"}]]}], ")"}]}]}],
  HoldForm]],
 CellChangeTimes->{
  3.977679481650419*^9},ExpressionUUID->"0bbee71c-0782-4fe2-92e4-\
b07df9bff3b2"]], "Text",
 CellChangeTimes->{{3.9776795294448833`*^9, 
  3.97767953360098*^9}},ExpressionUUID->"146618aa-91f2-4e1b-b70b-\
98268d990b3d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"symbolicGamma", "[", 
    RowBox[{"\[Sigma]_", ",", "\[Mu]_", ",", "\[Nu]_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[Lambda]", "}"}], ",", 
     RowBox[{"(*", " ", 
      RowBox[{"dummy", " ", "index"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"g", "[", 
         RowBox[{
          RowBox[{"\[ScriptCapitalU]", "[", "\[Sigma]", "]"}], ",", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Lambda]", "]"}]}], "]"}], "*", 
        "\[IndentingNewLine]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Partials", "[", 
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{
              RowBox[{"\[ScriptCapitalD]", "[", "\[Lambda]", "]"}], ",", 
              RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}]}], "]"}], ",", 
            
            RowBox[{"x", "[", 
             RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}],
           "+", "\[IndentingNewLine]", 
          RowBox[{"Partials", "[", 
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{
              RowBox[{"\[ScriptCapitalD]", "[", "\[Lambda]", "]"}], ",", 
              RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], ",", 
            
            RowBox[{"x", "[", 
             RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}]}], "]"}],
           "-", "\[IndentingNewLine]", 
          RowBox[{"Partials", "[", 
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{
              RowBox[{"\[ScriptCapitalD]", "[", "\[Mu]", "]"}], ",", 
              RowBox[{"\[ScriptCapitalD]", "[", "\[Nu]", "]"}]}], "]"}], ",", 
            
            RowBox[{"x", "[", 
             RowBox[{"\[ScriptCapitalU]", "[", "\[Lambda]", "]"}], "]"}]}], 
           "]"}]}], ")"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]", ",", "0", ",", "3"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.977671701961773*^9, 3.9776717019634666`*^9}, 
   3.977672016325259*^9, {3.977672538654307*^9, 3.977672543798789*^9}, {
