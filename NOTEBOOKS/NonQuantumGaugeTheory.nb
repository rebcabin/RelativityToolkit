   3.978726495051648*^9}, {3.978726725948238*^9, 3.9787267404234657`*^9}, {
   3.978726803673094*^9, 3.978726851311077*^9}, {3.9787270264194717`*^9, 
   3.9787270342541447`*^9}, {3.978728078699913*^9, 3.9787281016729527`*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"36779bb3-2b03-4dd8-958c-cd56c771e644"],

Cell[BoxData[
 RowBox[{
  SubsuperscriptBox["\[CapitalGamma]", 
   RowBox[{"a_", "b_"}], "\[Lambda]_"], "\[RuleDelayed]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Sigma]", "=", 
      RowBox[{"Unique", "[", "\<\"\[Sigma]\"\>", "]"}]}], "}"}], ",", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"g", 
       SuperscriptBox["", "\[Lambda]"], 
       SuperscriptBox["", "\[Sigma]"]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        RowBox[{"g", 
         SubscriptBox["", "\[Sigma]"], 
         SubscriptBox["", "b"]}], 
        RowBox[{",", "a"}]], "+", 
       SubscriptBox[
        RowBox[{"g", 
         SubscriptBox["", "\[Sigma]"], 
         SubscriptBox["", "a"]}], 
        RowBox[{",", "b"}]], "-", 
       SubscriptBox[
        RowBox[{"g", 
         SubscriptBox["", "a"], 
         SubscriptBox["", "b"]}], 
        RowBox[{",", "\[Sigma]"}]]}], ")"}]}]}], "]"}]}]], "Output",
 CellChangeTimes->{3.991310401371697*^9},
 CellLabel->"Out[55]=",ExpressionUUID->"bb0b8c46-a89d-4b44-9458-3f37e06ae381"]
}, Open  ]],

