a23c979ddafa"],

Cell[TextData[{
 "Calculate the commutator: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["\[Del]", "\[Rho]"], ",", 
      SubscriptBox["\[Del]", "\[Nu]"]}], "]"}], 
    SuperscriptBox["A", 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9f6fc495-e7ac-40b6-a9ed-8ac39d074efe"],
 ":"
}], "Text",
 CellChangeTimes->{{3.978860787346716*^9, 3.978860806799048*^9}, {
  3.978860991222589*^9, 3.978861009149042*^9}, {3.978868299654079*^9, 
  3.978868375119767*^9}},ExpressionUUID->"f09d091f-5427-4c81-ad26-\
335b3c997d20"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"term1", " ", "=", " ", 
   RowBox[{"CD", "[", 
    RowBox[{
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", " ", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"x", "[", 
      RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]", "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"term2", " ", "=", " ", 
   RowBox[{"CD", "[", 
    RowBox[{
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", " ", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]", "]"}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"x", "[", 
      RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"comm", " ", "=", " ", 
    RowBox[{"term1", " ", "-", " ", "term2"}]}], ")"}], "//", 
  "TensorForm"}]}], "Input",
 CellChangeTimes->{{3.978860787346716*^9, 3.978860806799048*^9}, {
  3.978860991222589*^9, 3.978861009149042*^9}, {3.978868299654079*^9, 
