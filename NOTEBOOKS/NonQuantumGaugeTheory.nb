Cell[CellGroupData[{

Cell["Optional: Configure Relativity Connection Symbol", "Subsection",
 CellChangeTimes->{{3.9775176800467176`*^9, 3.977517685457151*^9}, {
  3.977644427456564*^9, 3.9776444329596653`*^9}, {3.978358022660828*^9, 
  3.9783580250320253`*^9}},ExpressionUUID->"fd562242-cb5f-4257-94c4-\
9c3dcffe6af8"],

Cell["\<\
To properly compose covariant derivatives, \[ScriptCapitalU]\[ScriptCapitalD] \
must know the user\[CloseCurlyQuote]s reserved symbols for non-tensorial \
connection coefficients. In gravitational physics, these force-producing \
connections are called \[CapitalGamma] (capital gamma). Other theories like \
electrodynamics and Yang-Mills that can benefit from \[ScriptCapitalU]\
\[ScriptCapitalD] use other connection symbols. \
\>", "Text",
 CellChangeTimes->{{3.977517690693409*^9, 3.9775178232519913`*^9}, {
  3.97751956997919*^9, 3.9775195720756073`*^9}, {3.9775280931539383`*^9, 
  3.977528124823065*^9}, {3.977535721478539*^9, 3.977535724386561*^9}, {
  3.9776444438816977`*^9, 3.977644712294363*^9}, {3.9777468389285183`*^9, 
  3.977747007351509*^9}, {3.977747054921603*^9, 
  3.9777470563202457`*^9}},ExpressionUUID->"860dae44-cbbe-4334-bee0-\
eb8dbe58ad65"],

Cell["\<\
We\[CloseCurlyQuote]re going with \[CapitalGamma] for this \
relativity/gravitation notebook. \
\>", "Text",
 CellChangeTimes->{{3.977517690693409*^9, 3.9775178232519913`*^9}, {
  3.97751956997919*^9, 3.9775195720756073`*^9}, {3.9775280931539383`*^9, 
  3.977528124823065*^9}, {3.977535721478539*^9, 3.977535724386561*^9}, {
  3.9776444438816977`*^9, 3.977644762630517*^9}, {3.977747016178646*^9, 
  3.97774702870907*^9}},ExpressionUUID->"6412f41d-f02b-4a24-b243-\
19b7651c936f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SetConnection", "[", "\[CapitalGamma]", "]"}], ";"}], 
  "\n"}]], "Input",
 CellChangeTimes->{{3.9775137220895033`*^9, 3.977513731036991*^9}, {
   3.9775149251253233`*^9, 3.9775149333295393`*^9}, 3.9775150554680758`*^9, 
   3.977517830816463*^9},
 CellLabel->"In[8]:=",ExpressionUUID->"2b33fb69-f8c2-48fe-a7a1-6d53867f0567"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Covariant Derivatives, Revisited", "Section",
 CellChangeTimes->{{3.978358251530368*^9, 
  3.978358274502495*^9}},ExpressionUUID->"7f6b77f4-b0fc-4a67-b903-\
969955fdadc1"],

Cell["\<\
So far, for general relativity, we figured out how to take derivatives of \
vectors and tensors that inhabit the tangent (and cotangent) spaces of curved \
manifolds. The canonical example is the covariant derivative of a \
contravariant vector\
\>", "Text",
 CellChangeTimes->{{3.978358277995886*^9, 
  3.9783584188849707`*^9}},ExpressionUUID->"e00680e2-ffc2-4e2a-8e3d-\
60cc05e325e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"example", "=", 
      RowBox[{"HoldForm", "[", 
       RowBox[{"CD", "[", 
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], 
       "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Echo", "[", 
     RowBox[{
      RowBox[{"TensorForm", "@@", "example"}], ",", 
      RowBox[{"example", " ", "\"\<\>\""}]}], "]"}]}], "]"}], ";"}]], "Input",\

 CellChangeTimes->{{3.978358547373548*^9, 3.978358772499927*^9}, {
  3.978359072474093*^9, 3.978359157811211*^9}, {3.9783592724273376`*^9, 
  3.978359272556822*^9}, {3.9783593063094587`*^9, 3.9783593921632147`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"78497388-807e-47b1-a2f3-54ab4ce22561"],

Cell[BoxData[
 RowBox[{
  TagBox[
   RowBox[{"\<\"\"\>", " ", 
    RowBox[{"(", 
     TagBox[
      SubscriptBox[
       RowBox[{"A", 
        SuperscriptBox["", "\[Mu]"]}], 
       RowBox[{";", "\[Nu]"}]],
      HoldForm], ")"}]}],
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"A", 
      SuperscriptBox["", "\[Mu]"]}], 
     RowBox[{",", "\[Nu]"}]], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"A", 
       SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Nu]", "\[Lambda]"}], "\[Mu]"]}]}],
   HoldForm]}]], "Echo",
 CellChangeTimes->{
  3.978383250037692*^9},ExpressionUUID->"73b095dc-aed8-4473-85b7-\
40749cca7779"]
}, Open  ]],

Cell[TextData[{
 "The connection coefficients ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]], 
    RowBox[{"\[Nu]", "\[VeryThinSpace]", "\[Lambda]"}]], TraditionalForm]],
  ExpressionUUID->"664e81ac-4907-453b-9c7a-4541c1e37f80"],
 " account for the twisting and turning of the basis vectors of the tangent \
spaces as the vector is parallel-transported ",
 StyleBox["back",
  FontSlant->"Italic"],
 " from position ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Alpha]"], "+", 
    RowBox[{"d", "\[VeryThinSpace]", 
     SuperscriptBox["x", "\[Alpha]"]}]}], TraditionalForm]],ExpressionUUID->
  "0ccee190-cc0f-494c-8852-b6daa2d2ec90"],
 " to position ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "1870de2e-2844-4ec9-b04a-4c4570f79e52"],
 ", where we take the limit that produces the derivative. "
}], "Text",
 CellChangeTimes->{{3.978359427011059*^9, 3.978359781833878*^9}, {
  3.9783832904953938`*^9, 
  3.978383292332605*^9}},ExpressionUUID->"404d6c0e-cac6-4e99-867b-\
9cc4b8514e01"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TensorForm", "@", 
  RowBox[{"CD", "[", 
   RowBox[{
    RowBox[{"A", "[", 
     RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", 
    RowBox[{"x", "[", 
     RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.978343391851074*^9, 3.978343420487228*^9}, {
  3.978343460631524*^9, 3.978343488211195*^9}, {3.978358429755495*^9, 
  3.9783584327845087`*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"67cbb9ea-e987-407e-b730-e2e624555585"],

Cell[BoxData[
 TagBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"A", 
     SuperscriptBox["", "\[Mu]"]}], 
    RowBox[{",", "\[Nu]"}]], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"A", 
      SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Nu]", "\[Lambda]"}], "\[Mu]"]}]}],
