Cell[CellGroupData[{

Cell[TextData[{
 "Metric Compatibility, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Del]", "g"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3eb2e12f-0a25-418c-aff1-3bfdaabcee87"]
}], "Subsubsection",
 CellChangeTimes->{{3.978724421051444*^9, 3.978724452354293*^9}, {
   3.978724585756415*^9, 3.97872459014424*^9}, {3.9787249870275803`*^9, 
   3.978724987675819*^9}, {3.9787305570246077`*^9, 3.97873066121562*^9}, {
   3.9787307307016373`*^9, 3.978730773596877*^9}, 3.978732898964694*^9, {
   3.978737301095892*^9, 3.978737355871677*^9}, 3.978795900279101*^9, {
   3.9787959783127203`*^9, 
   3.978796006164027*^9}},ExpressionUUID->"36906ab5-5174-4fb2-9cd8-\
7beb95aae06e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Del]", "g"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2a73f777-631d-4925-9b79-5c71945aa5b0"],
 " was an axiom in earlier notebooks, and it yielded the Christoffel \
symbols",
 " for Riemannian geometry",
 ". Here, we do the opposite, showing that the Christoffel symbols imply \
metric compatibility. Thus, metric compatibility is both necessary and \
sufficient for the Christoffel symbols."
}], "Text",
 CellChangeTimes->{{3.978724421051444*^9, 3.978724452354293*^9}, {
   3.978724585756415*^9, 3.97872459014424*^9}, {3.9787249870275803`*^9, 
   3.978724987675819*^9}, {3.9787305570246077`*^9, 3.97873066121562*^9}, {
   3.9787307307016373`*^9, 3.978730773596877*^9}, 3.978732898964694*^9, {
   3.978737301095892*^9, 3.978737355871677*^9}, {3.978795912867682*^9, 
   3.978795961568068*^9}, {3.978796025215447*^9, 
   3.978796030724938*^9}},ExpressionUUID->"105c2b56-4f50-4673-b271-\
481010de5f68"],

Cell[TextData[{
 StyleBox["In abstract geometric contexts, as opposed to coordinate-basis \
contexts, the Christoffel symbols are called the ",
  FontSlant->"Italic"],
 StyleBox["Levi-Civita Connection",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["., often written ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", GridBox[{
      {"\[Lambda]"},
      {
       RowBox[{"\[Mu]", " ", "\[Nu]"}]}
     }], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a8b9b370-1755-45e3-83fb-e50139492763"],
 "."
}], "Item",
 CellChangeTimes->{{3.978723120871808*^9, 3.97872312087333*^9}, {
   3.978723165469028*^9, 3.978723207620385*^9}, 3.9787233650029182`*^9, {
   3.9787235792374363`*^9, 3.978723603081081*^9}, {3.9787239349292383`*^9, 
   3.978724069870165*^9}, 3.9787242757312603`*^9, {3.9787243954582853`*^9, 
   3.978724398922227*^9}, {3.978724456929924*^9, 3.978724457518743*^9}, {
   3.978724523827444*^9, 3.9787245477064877`*^9}, 3.9787246249191*^9, {
   3.978725638889288*^9, 3.978725677128771*^9}, {3.978727610826126*^9, 
   3.97872761221317*^9}, {3.978727655027277*^9, 3.978727669703785*^9}, {
   3.978727704673315*^9, 3.978727710245927*^9}, {3.978727741834342*^9, 
   3.978727786420486*^9}, {3.9787307808582687`*^9, 3.978730808044546*^9}, {
   3.978731256781562*^9, 3.978731305851647*^9}, {3.978732902083425*^9, 
   3.9787329069000053`*^9}, 3.978737338405304*^9, {3.978737369537401*^9, 
   3.978737378670127*^9}},ExpressionUUID->"7f41e3cb-db30-41e5-8596-\
fcad1fe1e3e1"],

Cell[TextData[{
 StyleBox["Christoffel symbols were derived in ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Covariant Derivatives and Connections in the \
\[ScriptCapitalU]\[ScriptCapitalD] Calculus",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3609079"], None},
  ButtonNote->"https://community.wolfram.com/groups/-/m/t/3609079"],
  FontVariations->{"Underline"->True}],
 StyleBox[", assuming both torsion freedom (symmetry in lower two indices of \
\[CapitalGamma]), and metric compatibility",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.978730709516233*^9, 3.978730720985425*^9}, {
  3.978730817298769*^9, 3.978730819268317*^9}, {3.978796058572641*^9, 
  3.978796059319714*^9}},ExpressionUUID->"7d7c228b-22ed-4a27-aaec-\
7b9c5c83d43d"],

Cell[TextData[{
 StyleBox["If we allow torsion, as in Einstein-Cartan theory or as in \
Appendix 1, the present tautology is not valid. In such cases, we must \
introduce the ",
  FontSlant->"Italic"],
 StyleBox["contortion tensor",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["K", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eeac8ee7-66af-4f5f-bd29-4c758594a83c"]
}], "Item",
 CellChangeTimes->{{3.9787310877075768`*^9, 3.978731131601782*^9}, {
  3.978731165541348*^9, 3.978731191812948*^9}, {3.978732930240844*^9, 
  3.978732932414803*^9}, {3.978737257574294*^9, 3.9787372858020067`*^9}, {
  3.978737400260751*^9, 3.978737439535802*^9}, {3.978796072143055*^9, 
  3.978796073791698*^9}},ExpressionUUID->"7c5421be-db30-4601-a65b-\
ef399811fb4b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[VeryThinSpace]", "\[Lambda]"}]], 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], "=", 
   RowBox[{
    RowBox[{"{", GridBox[{
       {"\[Lambda]"},
       {
        RowBox[{"\[Mu]", " ", "\[Nu]"}]}
      }], "}"}], "+", 
    SubscriptBox[
     SuperscriptBox["K", 
      RowBox[{"\[VeryThinSpace]", "\[Lambda]"}]], 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.978731208824177*^9, 3.978731247795663*^9}, {
  3.978731311075004*^9, 
  3.978731346983602*^9}},ExpressionUUID->"147f6684-e8f8-4693-bff8-\
f251da64a915"],

Cell[TextData[StyleBox["We do not develop this case further in this notebook.",
