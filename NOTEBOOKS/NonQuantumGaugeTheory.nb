6d5149ea04e7"],

Cell[TextData[{
 StyleBox["Charged Vector Field Covariance",
  FontSlant->"Italic"],
 ": the covariance of a generic charged vector field ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", "\[Alpha]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d3699f9b-d3c6-49d7-ba38-ec02c67beea4"],
 " transforms covariantly under simultaneous spacetime coordinate changes and \
internal ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", 
    RowBox[{"(", "1", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "81f6837a-5dff-4b04-9047-02083c34833e"],
 " phase rotations. "
}], "Item",
 CellChangeTimes->{
  3.977513712847348*^9, {3.9775178669407883`*^9, 3.977517959906126*^9}, {
   3.977517996418476*^9, 3.977518072452635*^9}, {3.9775181219359083`*^9, 
   3.977518224156801*^9}, {3.9775359524035*^9, 3.977536075585163*^9}, {
   3.97753737910937*^9, 3.977537384309*^9}, {3.97764405920399*^9, 
   3.977644347525126*^9}, {3.977672253563974*^9, 3.977672266570442*^9}, {
