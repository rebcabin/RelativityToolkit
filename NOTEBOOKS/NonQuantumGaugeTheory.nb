Cell[CellGroupData[{

Cell["Riemann Revisited", "Subsection",
 CellChangeTimes->{{3.9788607638227997`*^9, 
  3.978860769493289*^9}},ExpressionUUID->"569fa0b6-8e86-40bf-99d0-\
f0b84d4904b1"],

Cell["\<\
Here is a concise derivation of the Fundamental Theorem of Riemannian \
Geometry, shorter than the derivation in our earlier notebooks\
\>", "Text",
 CellChangeTimes->{{3.978995565032127*^9, 3.9789956024329977`*^9}, {
   3.979350086525177*^9, 3.9793500973619347`*^9}, {3.980789061655262*^9, 
   3.980789064274653*^9}, 
   3.980789151635949*^9},ExpressionUUID->"96cd61c0-e836-4328-9777-\
a23c979ddafa"],

Cell[TextData[{
 StyleBox["Because we are using the symmetric Levi-Civita connection \
implicitly via ",
  FontSlant->"Italic"],
 StyleBox["torsionRules", "Input"],
 StyleBox[", the commutator reduces to Riemann curvature tensor contracted \
with ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,
  FontSlant->"Italic",ExpressionUUID->
  "ad7d7d08-d0f8-401f-9356-c702f0f954e6"],
 StyleBox[". If we allowed torsion, as discussed in the Appendix, an extra \
term proportional to the torsion tensor would appear here.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.980789068583433*^9, 3.980789133559881*^9}, {
  3.980789184406026*^9, 
  3.980789213732882*^9}},ExpressionUUID->"e7183106-c6c7-4524-8ecb-\
e725cb60e3e2"],

Cell[TextData[{
 "Calculate the commutator: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["\[Del]", "\[Rho]"], ",", 
      SubscriptBox["\[Del]", "\[Nu]"]}], "]"}], 
    SuperscriptBox["A", 
     RowBox[{"\[VeryThinSpace]", "\[Mu]"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9f6fc495-e7ac-40b6-a9ed-8ac39d074efe"],
 ":"
}], "Text",
 CellChangeTimes->{{3.978860787346716*^9, 3.978860806799048*^9}, {
  3.978860991222589*^9, 3.978861009149042*^9}, {3.978868299654079*^9, 
  3.978868375119767*^9}},ExpressionUUID->"f09d091f-5427-4c81-ad26-\
335b3c997d20"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"term1", " ", "=", " ", 
   RowBox[{"CD", "[", 
    RowBox[{
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", " ", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"x", "[", 
      RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]", "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"term2", " ", "=", " ", 
   RowBox[{"CD", "[", 
    RowBox[{
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", " ", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Rho]", "]"}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"x", "[", 
      RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"comm", " ", "=", " ", 
    RowBox[{"term1", " ", "-", " ", "term2"}]}], ")"}], "//", 
  "TensorForm"}]}], "Input",
 CellChangeTimes->{{3.978860787346716*^9, 3.978860806799048*^9}, {
  3.978860991222589*^9, 3.978861009149042*^9}, {3.978868299654079*^9, 
  3.9788683093192377`*^9}},
 CellLabel->"In[59]:=",ExpressionUUID->"908465c8-5888-45eb-bdfd-ffd03d6fb1eb"],

Cell[BoxData[
 TagBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", 
        SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
      SubsuperscriptBox["\[CapitalGamma]", 
       RowBox[{"\[Nu]", "\[Lambda]"}], "\[Mu]"]}], ")"}], 
    RowBox[{",", "\[Rho]"}]], "-", 
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", 
        SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
      SubsuperscriptBox["\[CapitalGamma]", 
       RowBox[{"\[Rho]", "\[Lambda]"}], "\[Mu]"]}], ")"}], 
    RowBox[{",", "\[Nu]"}]], "-", 
   RowBox[{
    RowBox[{"(", 
     SubscriptBox[
      RowBox[{"A", 
       SuperscriptBox["", "\[Mu]"]}], 
      RowBox[{",", "\[Lambda]"}]], ")"}], " ", 
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Nu]", "\[Rho]"}], "\[Lambda]"]}], "+", 
   RowBox[{
    RowBox[{"(", 
     SubscriptBox[
      RowBox[{"A", 
       SuperscriptBox["", "\[Mu]"]}], 
      RowBox[{",", "\[Lambda]"}]], ")"}], " ", 
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Rho]", "\[Nu]"}], "\[Lambda]"]}], "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"A", 
      SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Nu]", "\[Rho]"}], "\[Kappa]"], " ", 
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Kappa]", "\[Lambda]"}], "\[Mu]"]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"A", 
      SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Rho]", "\[Nu]"}], "\[Kappa]"], " ", 
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Kappa]", "\[Lambda]"}], "\[Mu]"]}], "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"A", 
      SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Rho]", "\[Lambda]"}], "\[Kappa]"], " ", 
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Nu]", "\[Kappa]"}], "\[Mu]"]}], "-", 
   RowBox[{
    RowBox[{"(", 
     SubscriptBox[
      RowBox[{"A", 
       SuperscriptBox["", "\[Lambda]"]}], 
      RowBox[{",", "\[Rho]"}]], ")"}], " ", 
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Nu]", "\[Lambda]"}], "\[Mu]"]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"A", 
      SuperscriptBox["", "\[Lambda]"]}], ")"}], " ", 
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Nu]", "\[Lambda]"}], "\[Kappa]"], " ", 
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Rho]", "\[Kappa]"}], "\[Mu]"]}], "+", 
   RowBox[{
    RowBox[{"(", 
     SubscriptBox[
      RowBox[{"A", 
       SuperscriptBox["", "\[Lambda]"]}], 
      RowBox[{",", "\[Nu]"}]], ")"}], " ", 
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Rho]", "\[Lambda]"}], "\[Mu]"]}]}],
  HoldForm]], "Output",
 CellChangeTimes->{3.991310401387567*^9},
 CellLabel->"Out[61]=",ExpressionUUID->"35be46e1-fd43-4a28-a000-015e4f0ab00a"]
}, Open  ]],

Cell["Simplification Pipeline", "Text",
 CellChangeTimes->{{3.978868389762835*^9, 
  3.978868394065692*^9}},ExpressionUUID->"91b2488c-8182-42ac-9144-\
80cc876135ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"calculatedRiemann", "=", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"comm", "//", "\[IndentingNewLine]", "ExpandDerivatives"}], "//",
          "\[IndentingNewLine]", "Expand"}], "//", "\[IndentingNewLine]", 
        "CanonicalizeIndices"}], ")"}], "//.", "\[IndentingNewLine]", " ", 
      "torsionRules"}], " ", ")"}], "//", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ExtractCoefficient", "[", 
      RowBox[{"#", ",", "A"}], "]"}], "&"}]}], "//", "\[IndentingNewLine]", 
   "TensorForm"}]}]], "Input",
 CellChangeTimes->{{3.978860787346716*^9, 3.978860821005308*^9}, 
   3.978861033161792*^9, {3.978861355886228*^9, 3.9788613621417303`*^9}, 
   3.978867075350772*^9, {3.9788671078081007`*^9, 3.978867118241984*^9}, 
