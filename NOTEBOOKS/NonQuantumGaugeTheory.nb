1fb291abaa29"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"U", 
    RowBox[{"(", "1", ")"}]}], TraditionalForm]],ExpressionUUID->
  "5e74591b-b535-4db5-8a34-0ac4448be1b4"],
 StyleBox[" Gauge Covariance",
  FontSlant->"Italic"],
 ": the covariant derivative of a scalar field transforms covariantly under \
local phase rotation."
}], "Item",
