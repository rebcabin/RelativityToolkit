Cell[CellGroupData[{

Cell["The Derivation in Index Notation", "Section",
 CellChangeTimes->{{3.977535433122849*^9, 3.977535440829898*^9}, {
  3.9776826390915833`*^9, 
  3.977682642839716*^9}},ExpressionUUID->"b754f372-2292-4fc4-ade0-\
a54b9d0e2194"],

Cell["\<\
MTW\[CloseCurlyQuote]s geometric forms are too high-level for \
\[ScriptCapitalU]\[ScriptCapitalD]. The index notation is just right. Let\
\[CloseCurlyQuote]s start with the commutator\
\>", "Text",
 CellChangeTimes->{{3.977682654416891*^9, 3.977682688816283*^9}, {
  3.9777470773422537`*^9, 
  3.977747143107772*^9}},ExpressionUUID->"1b7941c3-a500-4611-8c31-\
c43be27985c5"],

Cell[CellGroupData[{

Cell["Step 1: Formulate and Differentiate", "Subsection",
 CellChangeTimes->{{3.9775300923741417`*^9, 
  3.9775301016423473`*^9}},ExpressionUUID->"8462bba6-f4a9-4690-866b-\
b59f1b903665"],

Cell[TextData[{
 "First, remind ourselves of the action of our covariant derivative, CD, \
trusted from earlier notebooks and tests. Apply CD to a concrete \
contravariant vector, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Beta]"], TraditionalForm]],ExpressionUUID->
  "a88182cc-7c2a-49d7-9d40-5fc141333e9a"],
 " in lieu of MTW\[CloseCurlyQuote]s abstract basis forms:"
}], "Text",
 CellChangeTimes->{{3.977527325502906*^9, 3.977527421512032*^9}, {
   3.977527457843831*^9, 3.97752752535949*^9}, 3.977527721936805*^9, {
   3.977527796493059*^9, 3.977527815288126*^9}, 3.977530131143807*^9, {
   3.977530269957465*^9, 3.977530270541044*^9}, {3.97764484054769*^9, 
   3.977644854313637*^9}, {3.977747447254834*^9, 3.977747497215187*^9}, {
   3.977747538186145*^9, 
   3.9777475509100533`*^9}},ExpressionUUID->"8a7b9d61-187b-43cf-a62a-\
a46a1d4aeac3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"TensorForm", "[", 
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], 
     "]"}], ",", "\"\<\!\(\*SubscriptBox[\(\[Del]\), \
\(\[Nu]\)]\)\!\(\*SuperscriptBox[\(A\), \(\[Mu]\)]\) \[Congruent] \
\!\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Mu]\)], \(; \(\[Nu]\)\)]\) \
=\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"TensorForm", "[", 
     RowBox[{"CD", "[", 
      RowBox[{"\[CurlyPhi]", ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], 
     "]"}], ",", "\"\<\!\(\*SubscriptBox[\(\[Del]\), \(\[Nu]\)]\)\
\[VeryThinSpace]\[CurlyPhi] = \!\(\*SubscriptBox[\(\[CurlyPhi]\), \(\
\[VeryThinSpace]\(; \(\[VeryThinSpace]\)\(v\)\)\)]\)= \!\(\*SubscriptBox[\(\
\[CurlyPhi]\), \(\[VeryThinSpace]\(, \(\[VeryThinSpace]\)\(v\)\)\)]\) \
:\>\""}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.977527832511675*^9, 3.9775278685696697`*^9}, 
   3.977527965703364*^9, {3.977644863464674*^9, 3.9776449077642527`*^9}, {
   3.978344330108426*^9, 3.9783443387164917`*^9}, {3.9783445285988617`*^9, 
   3.978344535484336*^9}, {3.97834462086141*^9, 3.9783447160229816`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"86be8190-bc21-484a-8cb0-a5f66e99f01e"],

Cell[TextData[{
 StyleBox["Note the generated summation index. ",
  FontSlant->"Italic"],
 "\[ScriptCapitalU]\[ScriptCapitalD]",
 StyleBox[" keeps track of such and prevents cross-capture with meaningful \
(free) indices in big calculations.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977644923929906*^9, 3.977644940291051*^9}, {
  3.97764529807302*^9, 3.9776453626375637`*^9}, {3.9777475614332333`*^9, 
  3.977747561434353*^9}},ExpressionUUID->"f45b200d-8384-4a34-9359-\
3d651f838650"],

Cell[TextData[{
 StyleBox["TODO: we might add basis abstractions to a future version of ",
  FontSlant->"Italic"],
 "\[ScriptCapitalU]\[ScriptCapitalD]",
 StyleBox[". It\[CloseCurlyQuote]s lower priority, however, as we get the \
same results by application of Quotient Theorems.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977644923929906*^9, 3.977644940291051*^9}, {
  3.97764529807302*^9, 3.9776453626375637`*^9}, {3.977747563165366*^9, 
  3.977747648401968*^9}},ExpressionUUID->"6f033203-8c8d-469d-ae44-\
e5f317a0ad8b"],

Cell[TextData[{
 "The commutator applies another covariant derivative, as in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "\[Gamma]"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", "\[Delta]"], 
      SuperscriptBox["A", "\[Beta]"]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"e7f86d6e-3fc3-47c5-a13e-d10ae6e92644"],
 ", then reverses the order of \[Gamma] and \[Delta] and subtracts: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Gamma]"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", "\[Delta]"], 
       SuperscriptBox["A", "\[Beta]"]}], ")"}]}], "-", 
    RowBox[{
     SubscriptBox["\[Del]", "\[Delta]"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", "\[Gamma]"], 
       SuperscriptBox["A", "\[Beta]"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"7dfc6328-2805-4390-ada1-1f7a74e186d1"],
 ". However, composing covariant derivatives blindly conceals a trap: the \
product rule of CD only pertains to products of tensors, but the inner CD \
produces products like ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "\[CapitalGamma]"}], TraditionalForm]],ExpressionUUID->
  "e4368717-2e5c-460a-8c69-31b7e633ab01"],
 ", a tensor times a non-tensor! The next section introduces the fix:"
}], "Text",
 CellChangeTimes->{{3.9776454477952347`*^9, 3.977645578694457*^9}, {
  3.977747673081131*^9, 
  3.977747849978416*^9}},ExpressionUUID->"b84b147d-de4a-4efb-a732-\
7368ccf9975b"],

Cell[CellGroupData[{

Cell["Boxing Non-Tensorial Terms", "Subsubsection",
 CellChangeTimes->{{3.9775346754473248`*^9, 
  3.977534687937344*^9}},ExpressionUUID->"548e3651-47d0-4e28-86e7-\
42d967663731"],

Cell[TextData[{
 "When we apply the \[OpenCurlyDoubleQuote]outer\[CloseCurlyDoubleQuote] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Del]", "\[Gamma]"], TraditionalForm]],ExpressionUUID->
  "37b001dd-cef0-4f81-939e-0c7572cd6d0e"],
 " to the \[OpenCurlyDoubleQuote]inner\[CloseCurlyDoubleQuote] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "\[Delta]"], 
    SuperscriptBox["A", "\[Beta]"]}], TraditionalForm]],ExpressionUUID->
  "f83f2044-1f31-4e9e-ac15-4c8c5fa58e71"],
 ", CD must treat the \[OpenCurlyDoubleQuote]inner\[CloseCurlyDoubleQuote] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Delta]"], 
     SuperscriptBox["A", "\[Beta]"]}], "=", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["A", "\[Beta]"], 
      RowBox[{",", "\[Delta]"}]], "-", 
     RowBox[{
      SuperscriptBox["A", "\[Lambda]"], 
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", 
        RowBox[{" ", "\[Beta]"}]], 
       RowBox[{"\[Delta]", " ", "\[Lambda]"}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"7777c6a1-ca20-47ee-b86d-17877c4e7ce3"],
 " as a whole tensor. That means CD must not apply the \[Del] product rule to \
the term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Lambda]"], 
    SubscriptBox[
     SuperscriptBox["\[CapitalGamma]", 
      RowBox[{" ", "\[Beta]"}]], 
     RowBox[{"\[Delta]", " ", "\[Lambda]"}]]}], TraditionalForm]],
  ExpressionUUID->"5cf72a1b-fd34-4bb0-847d-dd9d8736afab"],
 ". "
}], "Text",
 CellChangeTimes->{{3.977527982768255*^9, 3.977528071613158*^9}, {
   3.977528147413913*^9, 3.9775282365591288`*^9}, {3.977528285163328*^9, 
   3.977528301478141*^9}, {3.9775285661265507`*^9, 3.977528567874873*^9}, {
   3.977529029017803*^9, 3.977529125584494*^9}, {3.977529159911845*^9, 
   3.9775291604042*^9}, {3.977529192639998*^9, 3.9775291938016863`*^9}, {
   3.9775295849110603`*^9, 3.9775296640149508`*^9}, {3.977529733736466*^9, 
   3.977529755160907*^9}, {3.977529973657468*^9, 3.9775300691855164`*^9}, {
   3.977530144659377*^9, 3.9775301570243053`*^9}, {3.97753020290987*^9, 
   3.9775302396152887`*^9}, {3.9775302766515827`*^9, 3.97753042640129*^9}, {
   3.977534440795034*^9, 3.977534586416469*^9}, {3.97753462556609*^9, 
   3.977534646095621*^9}, {3.977537522931058*^9, 3.977537526680274*^9}, {
   3.977537557110469*^9, 3.9775375594743032`*^9}, {3.9776453810206537`*^9, 
   3.977645404227343*^9}, {3.977645586085967*^9, 3.977645738880803*^9}, {
   3.977645771699258*^9, 3.97764584869405*^9}, {3.977747856154808*^9, 
   3.97774789508272*^9}, {3.9777479529100924`*^9, 3.977748013905995*^9}, {
   3.977748094876708*^9, 3.977748202932303*^9}, 
   3.977748334136074*^9},ExpressionUUID->"5b6f0c25-f46c-434f-a766-\
f1a806f283f1"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", 
    RowBox[{"(", 
     RowBox[{"A", ".", "\[CapitalGamma]"}], ")"}]}], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"d04c92f0-006e-4039-af42-196c5b14cdf2"],
 StyleBox[" does not equal ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Del]", "A"}], ")"}], ".", "\[CapitalGamma]"}], "+", 
    RowBox[{"A", ".", 
     RowBox[{"(", 
      RowBox[{"\[Del]", "\[CapitalGamma]"}], ")"}]}]}], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"e769cb82-7f01-40a3-bc55-bf85dd2bde7f"],
 StyleBox[". ",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.977527982768255*^9, 3.977528071613158*^9}, {
   3.977528147413913*^9, 3.9775282365591288`*^9}, {3.977528285163328*^9, 
   3.977528301478141*^9}, {3.9775285661265507`*^9, 3.977528567874873*^9}, {
   3.977529029017803*^9, 3.977529125584494*^9}, {3.977529159911845*^9, 
   3.9775291604042*^9}, {3.977529192639998*^9, 3.9775291938016863`*^9}, {
   3.9775295849110603`*^9, 3.9775296640149508`*^9}, {3.977529733736466*^9, 
   3.977529755160907*^9}, {3.977529973657468*^9, 3.9775300691855164`*^9}, {
   3.977530144659377*^9, 3.9775301570243053`*^9}, {3.97753020290987*^9, 
   3.9775302396152887`*^9}, {3.9775302766515827`*^9, 3.97753042640129*^9}, {
   3.977534440795034*^9, 3.977534586416469*^9}, {3.97753462556609*^9, 
   3.977534646095621*^9}, {3.977537522931058*^9, 3.977537526680274*^9}, {
   3.977537557110469*^9, 3.9775375594743032`*^9}, {3.9776453810206537`*^9, 
   3.977645404227343*^9}, {3.977645586085967*^9, 3.977645738880803*^9}, {
   3.977645771699258*^9, 3.97764584869405*^9}, {3.977747856154808*^9, 
   3.977747893780663*^9}, {3.977748217174459*^9, 3.9777482680122547`*^9}, 
   3.977748349856803*^9},ExpressionUUID->"6cd75966-ecf9-41f1-befd-\
6dd14bc60305"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", "\[CapitalGamma]"}], TraditionalForm]],ExpressionUUID->
  "3de2a0fc-3467-4d10-96fe-465d356e9983"],
 " is nonsense! \[CapitalGamma] is not a tensor, as we know from my earlier \
notebooks! Reserving \[CapitalGamma], globally, as a non-tensorial symbol for \
CD is the reason for calling ",
 StyleBox["SetConnection", "Input"],
 " above. "
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQB2IQ3TP1RmjHoreO/+Z9TgDRx+xys0B00pOJpSD6j+XS
ahD9zmd9LYjewnNkHoj+9u83mL4xccENEK27ZdMTEH1N9+8LEG36nucliL5b
JfIWRGcttwTTGeqycp1AuqqKQQNEK07cbgCi1dRSjUH0L86tfiD6wPulUSB6
nqRoCoiWOb4gFUSvkI3NBtFFGz7ng+gjN6eUgOi46z7tIPp1gWRtN5DeHuzb
D6IzZY2mgOgQ/sPTQLTV6dh/PUD63JGrYPpbx2KmXiBdp/seTButXLDiIJBO
dWtfDaLtDjgdAtFd+jFXQXRQQtlNEL3CVOwxiDb4wrLpM5A2/L1jG4jWnqp6
H0SnpDQ8BdEmi5gWz1781jEi7OYSEA0AfQTQvQ==
  "],ExpressionUUID->"5377f013-4300-40e8-b13a-633d4c476728"],

Cell[TextData[{
 "While \[CapitalGamma] is not a tensor, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "\[CapitalGamma]"}], TraditionalForm]],ExpressionUUID->
  "bf4294c1-aba4-4c39-b673-e217ef2ad8cd"],
 " is. A new version of CD recognizes the \[OpenCurlyDoubleQuote]poison-pill\
\[CloseCurlyDoubleQuote]\[NoBreak] \[CapitalGamma] in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "\[CapitalGamma]"}], TraditionalForm]],ExpressionUUID->
  "67081aa4-0bdc-46b5-b33f-f2daecb78477"],
 " and bypasses the \[Del] product rule. CD sends ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "\[CapitalGamma]"}], TraditionalForm]],ExpressionUUID->
  "964791dd-616b-4324-a8bc-3ec78ac1260d"],
 " in an inert box down the line to a later ",
 StyleBox["appropriate",
  FontSlant->"Italic"],
 " application of the ordinary product rule from calculus. CD \
\[OpenCurlyDoubleQuote]glues the ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "cd88a1c9-070b-4388-a398-36144d041004"],
 " to the ",
 Cell[BoxData[
  FormBox["\[CapitalGamma]", TraditionalForm]],ExpressionUUID->
  "c91f2b22-ecea-485f-a30e-fadd3e2e04ba"],
 "\[CloseCurlyDoubleQuote] (look for \[OpenCurlyDoubleQuote]gamma glue\
\[CloseCurlyDoubleQuote] in the code: ",
 StyleBox["RelativityToolkit.wl", "Input"],
 ", Rule 0 of CD). "
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQB2IQ3TP1RmjHoreO/+Z9TgDRx+xys0B00pOJpSD6j+XS
ahD9zmd9LYjewnNkHoj+9u83mL4xccENEK27ZdMTEH1N9+8LEG36nucliL5b
JfIWRGcttwTTGeqycp1AuqqKQQNEK07cbgCi1dRSjUH0L86tfiD6wPulUSB6
nqRoCoiWOb4gFUSvkI3NBtFFGz7ng+gjN6eUgOi46z7tIPp1gWRtN5DeHuzb
D6IzZY2mgOgQ/sPTQLTV6dh/PUD63JGrYPpbx2KmXiBdp/seTButXLDiIJBO
dWtfDaLtDjgdAtFd+jFXQXRQQtlNEL3CVOwxiDb4wrLpM5A2/L1jG4jWnqp6
H0RfXp/8GkQrtvxfMXvxW0eNgDtbQDQAlgbSDg==
  "],ExpressionUUID->"be4aa352-8c87-4472-84d6-3c56449f2f07"],

Cell[TextData[{
 "With that realization, we can confidently set up ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", 
    RowBox[{"\[Gamma]", "(", 
     RowBox[{
      SubscriptBox["\[Del]", "\[Delta]"], 
      SuperscriptBox["A", "\[Beta]"]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"3c33902d-6891-4070-80b8-512b1115cb4b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "\[Delta]"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", "\[Gamma]"], 
      SuperscriptBox["A", "\[Beta]"]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"238bd121-98bb-4953-b843-6b0d90a20d2a"],
 ", visually spotting the boxed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "\[CapitalGamma]"}], TraditionalForm]],ExpressionUUID->
  "2dcc9d47-9380-4245-9ebb-18d7204833a3"],
 " terms at-a-glance:"
}], "Text",
 CellChangeTimes->{{3.977527325502906*^9, 3.977527421512032*^9}, {
  3.977527457843831*^9, 3.97752752535949*^9}, {3.977527722794066*^9, 
  3.977527724861456*^9}, {3.977528305919705*^9, 3.977528327199279*^9}, {
  3.97752967593775*^9, 3.9775296842284822`*^9}, {3.9775302539774723`*^9, 
  3.977530258128994*^9}, {3.977537581604781*^9, 3.97753758702244*^9}, {
  3.977645879921488*^9, 3.97764597320695*^9}, {3.97764609836301*^9, 
  3.977646100453302*^9}, {3.978792191157651*^9, 
  3.978792197734529*^9}},ExpressionUUID->"d20a755c-3fbf-4415-8c04-\
a0bf5ddb1119"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"term1", "=", 
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"CD", "[", 
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]", "]"}], "]"}], ",", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Delta]", "]"}], "]"}]}], "]"}],
        ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Gamma]", "]"}], "]"}]}], "]"}]}],
     ",", "\"\<\[Del]\[Gamma](\!\(\*SubscriptBox[\(\[Del]\), \
\(\[Delta]\)]\)\!\(\*SuperscriptBox[\(A\), \(\[Beta]\)]\)) =\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"term2", "=", 
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"CD", "[", 
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Alpha]", "]"}], "]"}], ",", 
         RowBox[{"x", "[", 
          RowBox[{"\[ScriptCapitalU]", "[", "\[Gamma]", "]"}], "]"}]}], "]"}],
        ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Delta]", "]"}], "]"}]}], "]"}]}],
     ",", "\"\<\!\(\*SubscriptBox[\(\[Del]\), \
\(\[Delta]\)]\)(\!\(\*SubscriptBox[\(\[Del]\), \
\(\[Gamma]\)]\)\!\(\*SuperscriptBox[\(A\), \(\[Beta]\)]\)) =\>\""}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{
  3.9775274263216267`*^9, {3.9775274904972773`*^9, 3.977527502308569*^9}, {
   3.977527871342442*^9, 3.977527872518971*^9}, {3.97764650581187*^9, 
   3.977646509003475*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"402f9e90-472f-4358-87ff-6177073326b0"],

Cell[TextData[{
 StyleBox["At the risk of overselling, no one should do this kind of \
calculation by hand. Ah, memories of lonely nights in the Physics Library \
with pen and paper! That\[CloseCurlyQuote]s the whole point of ",
  FontSlant->"Italic"],
 "\[ScriptCapitalU]\[ScriptCapitalD]",
 StyleBox[": delegating risky and tedious calculations to Wolfram. ",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977148448717927*^9, 3.977148601137877*^9}, {
  3.9771487883591347`*^9, 3.977148838436544*^9}, {3.97715053773209*^9, 
  3.977150607874874*^9}, {3.9773249732467318`*^9, 3.977324973635874*^9}, {
  3.977325004140476*^9, 3.977325152474333*^9}, {3.977327554521559*^9, 
  3.9773275834121027`*^9}, {3.97752836844738*^9, 3.977528500060755*^9}, {
  3.9775304467634363`*^9, 3.977530478081773*^9}, {3.97764598900867*^9, 
  3.977646006344201*^9}, {3.97764605480369*^9, 3.977646073198969*^9}, {
  3.9776461725324*^9, 3.9776462685480556`*^9}, {3.977748430519945*^9, 
  3.977748450153935*^9}, {3.978091970702231*^9, 
  3.978091986152519*^9}},ExpressionUUID->"c397c2f6-5421-4288-a2a5-\
a34399ce8244"],

Cell["Look at the RAW commutator, with boxed terms, now:", "Text",
 CellChangeTimes->{{3.977528607677047*^9, 3.977528657973105*^9}, {
  3.977528768337226*^9, 3.9775288310291243`*^9}, {3.977530485701873*^9, 
  3.9775305047845583`*^9}, {3.977537622866194*^9, 3.9775376248576193`*^9}, {
  3.977646127840207*^9, 
  3.9776461305012827`*^9}},ExpressionUUID->"7cad45e6-71e9-4656-8952-\
9e9ed92bcc54"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"rawCommutator", "=", 
     RowBox[{"term1", "-", "term2"}]}], 
    ",", "\"\<\!\(TraditionalForm\`\[Del]\[Gamma] \
\((\*SubscriptBox[\(\[Del]\), \(\[Delta]\)]\*SuperscriptBox[\(A\), \
\(\[Beta]\)])\) - \*SubscriptBox[\(\[Del]\), \
\(\[Delta]\)]\((\*SubscriptBox[\(\[Del]\), \
\(\[Gamma]\)]\*SuperscriptBox[\(A\), \(\[Beta]\)])\)\) =\>\""}], "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{
  3.97752866135876*^9, 3.977528704519404*^9, 3.9775288429168043`*^9, {
   3.977532333408565*^9, 3.977532336308819*^9}, {3.977646499758812*^9, 
   3.97764650154303*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"554c21c6-dc32-45be-9fe1-5a089e21d986"],

Cell[TextData[{
 StyleBox["Now",
  FontSlant->"Italic"],
 " that all the explosive \[Del] terms are evaluated, it\[CloseCurlyQuote]s \
time to apply the product (Leibniz) rule from ordinary calculus via ",
 StyleBox["ExpandDerivatives", "Input"],
 " and open these terms to ordinary Wolfram algebraic simplification. "
}], "Text",
 CellChangeTimes->{{3.9775287571362247`*^9, 3.977528760456421*^9}, {
  3.977528862869022*^9, 3.9775290150975246`*^9}, {3.9775305134720173`*^9, 
  3.977530641668908*^9}, {3.977534278362068*^9, 3.977534297720924*^9}, {
  3.977646151690436*^9, 3.9776461586907454`*^9}, {3.9777485167713423`*^9, 
  3.977748521971155*^9}},ExpressionUUID->"43886744-f9f4-43e5-a5cc-\
59a3299618bc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Applying the Product Rule", "Subsubsection",
 CellChangeTimes->{{3.977534763245243*^9, 
  3.9775347680786953`*^9}},ExpressionUUID->"148e636c-67cb-4c20-81f1-\
e8c9193c8de2"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"expanded", "=", 
      RowBox[{"ExpandDerivatives", "[", "rawCommutator", "]"}]}], 
     ",", "\"\<expanded commutator :\>\""}], "]"}], ";"}], " "}]], "Input",
 CellChangeTimes->{{3.977530779086885*^9, 3.977530783117169*^9}, 
   3.9775323413963842`*^9, 3.977534306277322*^9},
 CellLabel->"In[13]:=",ExpressionUUID->"a4cc2adb-97b6-4d88-ada9-c82e96761e47"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Step 2: Canonicalize and Eliminate Torsion", "Subsection",
 CellChangeTimes->{{3.97753435260457*^9, 
  3.977534367089591*^9}},ExpressionUUID->"bd82ea5c-3740-4bd4-b4ba-\
cd11063c96f4"],

Cell[TextData[{
 "Now, canonicalize indices and apply the torsion rules, which express ",
 StyleBox["physical ",
  FontSlant->"Italic"],
 "symmetry of \[CapitalGamma] in general relativity. "
}], "Text",
 CellChangeTimes->{{3.9775341102150784`*^9, 3.9775341648014383`*^9}, {
  3.977534376530195*^9, 3.977534396298911*^9}, {3.977537695887838*^9, 
  3.9775377007598333`*^9}, {3.97764697741973*^9, 3.977646989372484*^9}, {
  3.9777485379283047`*^9, 
  3.977748542717504*^9}},ExpressionUUID->"15721ed7-cd42-4937-a584-\
6b73d7263b32"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Other applications of differential geometry may have \
non-zero torsion, but not gravitation. ",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.9775341102150784`*^9, 3.9775341648014383`*^9}, {
  3.977534376530195*^9, 3.977534396298911*^9}, {3.977537695887838*^9, 
  3.9775377007598333`*^9}, {3.97764697741973*^9, 3.9776469870338783`*^9}, {
  3.977748554324061*^9, 
  3.9777485617546463`*^9}},ExpressionUUID->"b29317a8-5c8d-4c8c-a223-\
7997c15eb742"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Echo", "[", 
    RowBox[{
     RowBox[{"simplified", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"CanonicalizeIndices", "[", "expanded", "]"}], "//.", 
        "torsionRules"}], ")"}]}], ",", "\"\<canon - torsion :\>\""}], "]"}], 
   ";"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.977531978388423*^9, 3.977531985718758*^9}, {
   3.97753201853048*^9, 3.97753204092213*^9}, {3.9775320720555067`*^9, 
   3.977532105522291*^9}, 3.9775321380508547`*^9, {3.97753221125675*^9, 
   3.9775322249728537`*^9}, {3.977532259081963*^9, 3.977532261480406*^9}, {
   3.9775341784788437`*^9, 3.977534185724959*^9}, {3.977534330560224*^9, 
   3.977534333566969*^9}, 3.97753479458757*^9, {3.977595258382463*^9, 
   3.977595262114802*^9}, {3.977646587218831*^9, 3.977646587585724*^9}, {
   3.977646654553358*^9, 3.97764667001342*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"f00ef19b-75ed-4e8d-b0f5-773a20f38b63"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Step 3: Apply Quotient Theorem", "Subsection",
 CellChangeTimes->{{3.977534811694808*^9, 
  3.977534820574092*^9}},ExpressionUUID->"c0daa4f8-c1b0-41b7-8c65-\
e19b0c1e3e2a"],

Cell[TextData[{
 "Riemann is peeking out! To recover Riemann alone, quotient-out the tensor, ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "2feccfd0-94d0-4e5b-9e19-bac5b92bcefb"],
 " (it\[CloseCurlyQuote]s arbitrary), and we have a raw Riemann tensor."
}], "Text",
 CellChangeTimes->{{3.9775348672450113`*^9, 3.977534921429079*^9}, {
  3.977647028399776*^9, 3.977647042095449*^9}, {3.977647156088853*^9, 
  3.977647159342825*^9}, {3.9777485883875504`*^9, 
  3.977748599623336*^9}},ExpressionUUID->"f6a214ac-28c5-4d2d-a57f-\
0c1532b4e7dd"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["To borrow jargon from functional programming, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"Riemann", ".", "A"}], TraditionalForm]],ExpressionUUID->
  "3cd0650a-fef6-41cd-a422-e12445694b3a"],
 " ",
 StyleBox["is \[OpenCurlyDoubleQuote]partially evaluated\
\[CloseCurlyDoubleQuote] on ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "00740961-e0df-490a-a95c-9d297d3f6193"],
 ". ",
 StyleBox["The quotient theorem undoes the partial evaluation by a kind of \
functional factoring that Haskell Curry formalized.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.9775349371788797`*^9, 3.9775350053537703`*^9}, {
  3.9775377236462507`*^9, 3.9775377478652563`*^9}, {3.977748606743505*^9, 
  3.97774863268403*^9}},ExpressionUUID->"f466f15d-08e5-489c-afb3-\
3bb78928caad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"rawRiemann1", "=", 
     RowBox[{"ExtractCoefficient", "[", 
      RowBox[{"simplified", ",", "A"}], "]"}]}], 
    ",", "\"\<raw Riemann :\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{3.9775348259064627`*^9, 3.978340916963431*^9},
 CellLabel->"In[15]:=",ExpressionUUID->"67d8d45e-6387-48a9-a1bf-d12a7c3ec521"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Step 4: Presentation", "Subsection",
 CellChangeTimes->{{3.977535013718762*^9, 
  3.977535039568735*^9}},ExpressionUUID->"9b7ec2eb-33ce-4f47-b41a-\
0df30cee7910"],

Cell[TextData[{
 "Produce readable Greek via \[ScriptCapitalU]\[ScriptCapitalD]\
\[CloseCurlyQuote]s ",
 StyleBox["TensorForm", "Input"],
 ". Bring our ground-truth image nearby for a final look. Except for ordering \
of terms and renaming of indices, (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"my", " ", "\[Lambda]"}], "->", 
    RowBox[{"their", " ", "\[Beta]"}]}], TraditionalForm]],ExpressionUUID->
  "1b91f362-ec7a-48e6-b662-d7e563cbba48"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"my", " ", "\[Kappa]"}], "->", 
    RowBox[{"their", " ", "\[Lambda]"}]}], TraditionalForm]],ExpressionUUID->
  "818de348-1da1-4baa-b093-c8e7639e4f58"],
 " in the linear \[CapitalGamma] terms, summation over my \[Lambda] and their \
\[Mu] in the quadratic \[CapitalGamma] terms), they\[CloseCurlyQuote]re \
identical. \[ScriptCapitalU]\[ScriptCapitalD] has removed the hazard of \
getting the signs and indices wrong."
}], "Text",
 CellChangeTimes->{{3.97753507424326*^9, 3.977535201264265*^9}, {
   3.977535329349928*^9, 3.977535395262293*^9}, 3.9775377666937313`*^9, {
   3.977595324258156*^9, 3.977595328968614*^9}, {3.977595385083993*^9, 
   3.9775954151306562`*^9}, {3.977595462316207*^9, 3.9775955112529716`*^9}, {
   3.977647053312406*^9, 3.97764705450622*^9}, {3.977647087432807*^9, 
   3.977647221917602*^9}, {3.977748657028232*^9, 3.9777487318744164`*^9}, {
   3.978341666802154*^9, 
   3.978341749219327*^9}},ExpressionUUID->"3cba2824-72f8-462e-9f96-\
3b9f6a7a2d09"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"TensorForm", "[", "rawRiemann1", "]"}], ",", 
    " ", "\"\<\!\(\*SubscriptBox[SuperscriptBox[\(R\), \(\[Alpha]\)], \(\
\[Lambda]\[Gamma]\[Delta]\)]\) =\>\""}], "]"}], ";"}]], "Input",
 CellChangeTimes->{3.978340921598579*^9},
 CellLabel->"In[16]:=",ExpressionUUID->"9a7d939e-1835-478c-9b16-6874f7189bdc"],

