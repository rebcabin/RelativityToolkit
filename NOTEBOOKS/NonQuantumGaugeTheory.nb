   3.977749090941029*^9, 
   3.9777490942918158`*^9}},ExpressionUUID->"9464753a-ea02-4114-a3f7-\
7b9b25777208"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{"2", "\[FormalCapitalM]"}], 
    SuperscriptBox["\[FormalR]", "2"]]}], "===", 
  RowBox[{"DifferentiateTheMetric", "[", 
   RowBox[{
    StyleBox[
     RowBox[{"Partials", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", "0", "]"}], ",", 
         RowBox[{"\[ScriptCapitalD]", "[", "0", "]"}]}], "]"}], ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "1", "]"}], "]"}]}], "]"}],
     Background->RGBColor[1, 0.75, 0, 0.33]], ",", 
    "g\[ScriptCapitalD]\[ScriptCapitalD]", ",", 
    "g\[ScriptCapitalU]\[ScriptCapitalU]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.977671701961773*^9, 3.9776717019634666`*^9}, 
   3.977672016325259*^9, {3.977672538654307*^9, 3.977672543798789*^9}, {
