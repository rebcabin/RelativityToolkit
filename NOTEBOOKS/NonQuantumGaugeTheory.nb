   3.9787270342541447`*^9}, {3.978728078699913*^9, 3.9787281016729527`*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"36779bb3-2b03-4dd8-958c-cd56c771e644"],

Cell[BoxData[
 RowBox[{
  SubsuperscriptBox["\[CapitalGamma]", 
   RowBox[{"a_", "b_"}], "\[Lambda]_"], "\[RuleDelayed]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Sigma]", "=", 
      RowBox[{"Unique", "[", "\<\"\[Sigma]\"\>", "]"}]}], "}"}], ",", 
    RowBox[{
     FractionBox["1", "2"], " ", 
