 CellLabel->"In[62]:=",ExpressionUUID->"06c60744-2b2a-4093-a4b8-f47e0910dfb3"],

Cell[BoxData[
 TagBox[
  RowBox[{
   SubscriptBox[
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Lambda]", "\[Nu]"}], "\[Mu]"], 
    RowBox[{",", "\[Rho]"}]], "-", 
   SubscriptBox[
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Lambda]", "\[Rho]"}], "\[Mu]"], 
    RowBox[{",", "\[Nu]"}]], "-", 
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Lambda]", "\[Rho]"}], "\[Kappa]"], " ", 
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Kappa]", "\[Nu]"}], "\[Mu]"]}], "+", 
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[Lambda]", "\[Nu]"}], "\[Kappa]"], " ", 
