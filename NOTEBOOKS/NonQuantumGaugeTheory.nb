  3.9785335028858633`*^9}},ExpressionUUID->"507fb2f7-0a00-400c-8faf-\
cf77fcdfe459"]
}, Closed]],

Cell[CellGroupData[{

Cell["Appendix 2: Fibre Bundles", "Section",
 CellChangeTimes->{{3.978531317328569*^9, 
  3.978531324242466*^9}},ExpressionUUID->"620d6356-08c3-4bf5-af3b-\
bbeddfce3f01"],

Cell[TextData[{
 "In this appendix, we introduce the standard mathematical language. We \
present ",
 StyleBox["bundles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["projections",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fibres",
  FontSlant->"Italic"],
 ", ",
 StyleBox["sections",
  FontSlant->"Italic"],
 ", ",
 StyleBox["connections, ",
  FontSlant->"Italic"],
 "and ",
 StyleBox["invariance",
  FontSlant->"Italic"],
 ", with each concept applied to both geometry/gravitation and to more \
general gauge fields."
}], "Text",
 CellChangeTimes->{{3.978536750574292*^9, 3.9785367950754232`*^9}, {
  3.978610555963044*^9, 3.978610667580928*^9}, {3.978613173034171*^9, 
  3.978613182741832*^9}, {3.97861365486917*^9, 3.978613660623424*^9}, {
  3.978615429414358*^9, 3.978615456101054*^9}, {3.978629277098583*^9, 
  3.978629283785864*^9}, {3.978792917287898*^9, 
  3.97879293753654*^9}},ExpressionUUID->"bcde8fe1-83b9-4609-9c41-\
68ba8279ff2f"],

Cell[CellGroupData[{

Cell["TL;DR: Dictionary", "Subsection",
 CellChangeTimes->{{3.978616161016801*^9, 3.978616162607299*^9}, {
  3.9786299145199957`*^9, 
  3.978629917177271*^9}},ExpressionUUID->"7099d6ec-d864-4463-9218-\
15e2fe111dae"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["Concept", "Text",
      FontWeight->"Bold",
      FontSlant->"Italic"], 
     StyleBox[
      RowBox[{
       RowBox[{"Gauge", " ", "Theory"}], "\[LineSeparator]", 
       RowBox[{"(", "electrodynamics", ")"}]}], "Text",
      FontWeight->"Bold",
      FontSlant->"Italic"], 
     StyleBox[
      RowBox[{
       RowBox[{"Geometry", "/", "Gravitation"}], "\[IndentingNewLine]", 
       RowBox[{"(", 
        RowBox[{"general", " ", "relativity"}], ")"}]}], "Text",
      FontWeight->"Bold",
