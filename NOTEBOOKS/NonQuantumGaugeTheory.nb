Cell[CellGroupData[{

Cell["Compiler Backend Proof of Concept", "Section",
 CellChangeTimes->{{3.9776664385500717`*^9, 3.977666451075994*^9}, {
  3.977666687966083*^9, 
  3.977666692952118*^9}},ExpressionUUID->"0f0f1edf-ee06-49af-b1a4-\
834f673fb73b"],

Cell["\<\
In this section of the notebook, we develop a single-purpose compiler \
component that lowers \[ScriptCapitalU]\[ScriptCapitalD] expressions of the \
Schwarzschild metric and its Christoffel symbols onto functions in the \
Wolfram Function Repository (WFR). As above, this section is presented in \
alternating prose-and-code style rather than in .wl block style. \
\>", "Text",
 CellChangeTimes->{{3.9776725977128963`*^9, 3.9776726026507998`*^9}, {
  3.977672653601965*^9, 3.977672845339478*^9}, {3.977675012800189*^9, 
  3.977675032789912*^9}, {3.977677054377393*^9, 3.9776770662600718`*^9}, {
  3.977679221198496*^9, 3.977679228093412*^9}, {3.9776820718431873`*^9, 
  3.9776820736872272`*^9}, {3.9776830689589643`*^9, 3.9776830802923822`*^9}, {
  3.977748810317973*^9, 
  3.977748844305373*^9}},ExpressionUUID->"63ed89cc-84bb-4136-a1b5-\
59a1d89512e8"],

Cell[CellGroupData[{

Cell["Pull the Metric", "Subsection",
 CellChangeTimes->{{3.977679252133523*^9, 
  3.977679256543621*^9}},ExpressionUUID->"c44e69bc-a964-443d-ad9d-\
681cfbfdceb3"],

Cell["Pull the covariant Schwarzschild metric from the WFR:", "Text",
 CellChangeTimes->{{3.977677110978932*^9, 3.9776771239531813`*^9}, {
   3.9776773828334208`*^9, 3.977677385285349*^9}, {3.9776774212101307`*^9, 
   3.977677465875588*^9}, 
   3.97774886879532*^9},ExpressionUUID->"24543157-fb9f-4584-9fb6-\
7609a7283272"],

Cell[BoxData[
 RowBox[{"metricObj", "=", 
  RowBox[{
   RowBox[{"ResourceFunction", "[", "\"\<MetricTensor\>\"", "]"}], 
   "[", "\"\<Schwarzschild\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.977671701961773*^9, 3.9776717019634666`*^9}, 
   3.977672016325259*^9, {3.977672538654307*^9, 3.977672543798789*^9}, {
   3.977672856742405*^9, 3.977672858851077*^9}, {3.977673072432103*^9, 
   3.9776730761291847`*^9}, {3.977673212978238*^9, 3.977673283415215*^9}, {
   3.977674676513196*^9, 3.977674677496079*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"a3587c78-6432-47da-be46-71ca0e4494b5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rationalize Symbols", "Subsection",
 CellChangeTimes->{{3.97767926195428*^9, 3.977679265909133*^9}, {
  3.977679300935643*^9, 
  3.9776793101137466`*^9}},ExpressionUUID->"a12d4f2f-64bc-4571-8bdc-\
96579f00e9dd"],

Cell["\<\
Inexplicably, the metric from WFR has strings containing formal symbols, \
which (annoyingly) print just like formal symbols. It took a bit of effort to \
debug this.\
\>", "Text",
 CellChangeTimes->{{3.977677128596992*^9, 3.977677153256401*^9}, {
  3.9776772385919867`*^9, 3.977677248610517*^9}, {3.977677482276292*^9, 
  3.977677500488405*^9}, {3.9776821302640333`*^9, 
  3.977682156255921*^9}},ExpressionUUID->"df9b1369-d985-414c-acda-\
724454984468"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"rawCoords", "=", 
    RowBox[{"metricObj", "[", "\"\<Coordinates\>\"", "]"}]}], ")"}], "//", 
  "FullForm"}]], "Input",
 CellChangeTimes->{{3.977671701961773*^9, 3.9776717019634666`*^9}, 
   3.977672016325259*^9, {3.977672538654307*^9, 3.977672543798789*^9}, {
   3.977672856742405*^9, 3.977672858851077*^9}, {3.977673072432103*^9, 
   3.9776730761291847`*^9}, {3.977673212978238*^9, 3.9776732956882973`*^9}, {
   3.9776770918333673`*^9, 3.977677096377769*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"d53d5e68-4979-46f2-acbf-4efc4194bdcf"],

Cell["\<\
Wolfram can\[CloseCurlyQuote]t take derivatives with respect to strings. Just \
map them to ordinary formal variables, input via Esc\[NoBreak]-\[NoBreak].\
\[NoBreak]t\[NoBreak]-\[NoBreak]Esc, etc.:\
\>", "Text",
 CellChangeTimes->{{3.977675069337454*^9, 3.977675098668919*^9}, {
  3.977677158941681*^9, 3.977677187120345*^9}, {3.9776772606794987`*^9, 
  3.9776772795119667`*^9}, {3.977681903179208*^9, 3.977681940958995*^9}, {
  3.977748903959351*^9, 
  3.977748938816638*^9}},ExpressionUUID->"f88cd015-96df-4ed9-9243-\
7eb96d883bb9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"workingCoords", "=", 
   RowBox[{"{", 
    RowBox[{
    "\[FormalT]", ",", "\[FormalR]", ",", "\[FormalTheta]", ",", 
     "\[FormalPhi]"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simpleMap", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{"rawCoords", "->", "workingCoords"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.977674974791132*^9, 3.977674975689888*^9}, 
   3.977675048888536*^9, {3.977677284490521*^9, 3.97767731601033*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"19efa149-4589-444d-bebb-ab90e8f4703a"],

Cell[CellGroupData[{

Cell[TextData[{
 "Covariant ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[Mu]", " ", "\[Nu]"}]], TraditionalForm]],ExpressionUUID->
  "e165a564-c916-4dab-96c3-638486f49695"]
}], "Subsubsection",
 CellChangeTimes->{{3.977679317663167*^9, 3.977679325995818*^9}, {
  3.97767935673195*^9, 
  3.977679356731984*^9}},ExpressionUUID->"baabfcc2-4278-4385-958b-\
92b9cbb7405f"],

Cell[BoxData[
 RowBox[{"g\[ScriptCapitalD]\[ScriptCapitalD]", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"metricObj", "[", "\"\<MatrixRepresentation\>\"", "]"}], "/.", 
    "simpleMap"}], "/.", 
   RowBox[{"{", 
    RowBox[{"\"\<\[FormalCapitalM]\>\"", "->", "\[FormalCapitalM]"}], 
    "}"}]}]}]], "Input",
 CellChangeTimes->{{3.977671701961773*^9, 3.9776717019634666`*^9}, 
   3.977672016325259*^9, {3.977672538654307*^9, 3.977672543798789*^9}, {
   3.977672856742405*^9, 3.977672858851077*^9}, {3.977673072432103*^9, 
   3.9776730761291847`*^9}, {3.977673212978238*^9, 3.977673316772957*^9}, {
   3.977673356476471*^9, 3.97767340887572*^9}, 3.977673494513699*^9, {
   3.977674276121191*^9, 3.977674279696815*^9}, {3.9776747359635067`*^9, 
   3.9776747546006002`*^9}, {3.9776775391865883`*^9, 3.9776775481516447`*^9}},
 
 CellLabel->"In[25]:=",ExpressionUUID->"a6954295-2e8b-4113-904c-ccf7fb1bb8a8"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Contravariant ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", 
    RowBox[{" ", 
     RowBox[{"\[Mu]", " ", "\[Nu]"}]}]], TraditionalForm]],ExpressionUUID->
  "5a674a0c-4245-4f6d-8993-ebc36c288e75"]
}], "Subsubsection",
 CellChangeTimes->{{3.977679339906918*^9, 
  3.977679350103277*^9}},ExpressionUUID->"1db844a4-5121-4e7c-8650-\
66721277171b"],

Cell["\<\
We\[CloseCurlyQuote]ll need the inverse, i.e., the contravariant metric, \
later for the Christoffel symbols\
\>", "Text",
 CellChangeTimes->{{3.977677360229686*^9, 
  3.97767740860219*^9}},ExpressionUUID->"a60663de-1ee4-46d6-8c65-\
f2cc2ec2d45f"],

Cell[BoxData[
 RowBox[{"g\[ScriptCapitalU]\[ScriptCapitalU]", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"Inverse", "[", "g\[ScriptCapitalD]\[ScriptCapitalD]", "]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.977671701961773*^9, 3.9776717019634666`*^9}, 
   3.977672016325259*^9, {3.977672538654307*^9, 3.977672543798789*^9}, {
   3.977672856742405*^9, 3.977672858851077*^9}, {3.977673072432103*^9, 
   3.9776730761291847`*^9}, {3.977673212978238*^9, 3.977673316772957*^9}, {
   3.977673356476471*^9, 3.977673380120572*^9}, {3.977673514296154*^9, 
   3.977673525546073*^9}, {3.9776735628315487`*^9, 3.977673613939342*^9}, {
   3.977677556031897*^9, 3.97767757789079*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"f2dcf6fc-d5dc-464b-9706-c33afdb2adf9"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compiling Derivatives of the Metric", "Subsection",
 CellChangeTimes->{{3.977679946253248*^9, 
  3.977679959029337*^9}},ExpressionUUID->"173ca9f0-cce3-41f2-9d2d-\
908a4d69fe60"],

Cell["\<\
Let\[CloseCurlyQuote]s do a two-pass pipeline compilation of derivatives: \
algebrize then differentiate. \
\>", "Text",
 CellChangeTimes->{{3.977673685955389*^9, 3.977673702246863*^9}, {
  3.977674835814443*^9, 3.977674839622085*^9}, {3.977676266466113*^9, 
  3.9776762687864637`*^9}, {3.977678201951828*^9, 3.977678221664751*^9}, {
  3.977679968081114*^9, 3.977679970691435*^9}, {3.9776821878231792`*^9, 
  3.977682189121583*^9}, {3.977748962109561*^9, 
  3.9777489779204693`*^9}},ExpressionUUID->"dfc4fb35-1796-4332-b8f1-\
d9be1bc65cf7"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Many areas of physics and mathematics employ 0\
\[NoBreak]-\[NoBreak]based indexing, while Wolfram is \
1\[NoBreak]-\[NoBreak]based. We have found by experience that the best way to \
handle this discrepancy is to translate between indexing schemes at the last \
possible time and place: in the deepest Part expressions and in return \
values. Any other approach tends to proliferate the index translations into \
unwanted places.", "Item",
 FontSlant->"Italic"]], "Item",
 CellChangeTimes->{{3.977682244225511*^9, 3.977682404804381*^9}, {
  3.977749023005251*^9, 
  3.977749054459846*^9}},ExpressionUUID->"977d43c2-ffd4-4e4b-91e1-\
6ac0ce8d879a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "DifferentiateTheMetric", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DifferentiateTheMetric", "[", 
    RowBox[{"expr_", ",", "gDD_", ",", "gUU_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lowerGeometry", ",", "activateCalculus"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"PASS", " ", "1"}], ":", " ", "Geometry"}], "->", "Algebra"}],
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Correct", " ", "for", " ", "physics", " ", "g_", "00", " ", "to", " ", 
       
       RowBox[{"Wolfram", " ", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], " ", "at", " ", "the", " ", 
       "last", " ", "possible", " ", "moment"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"lowerGeometry", "=", 
       RowBox[{"expr", "//.", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{
             RowBox[{"\[ScriptCapitalD]", "[", "a_", "]"}], ",", 
             RowBox[{"\[ScriptCapitalD]", "[", "b_", "]"}]}], "]"}], ":>", 
           RowBox[{"gDD", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"1", "+", "a"}], ",", 
              RowBox[{"1", "+", "b"}]}], "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{
             RowBox[{"\[ScriptCapitalU]", "[", "a_", "]"}], ",", 
             RowBox[{"\[ScriptCapitalU]", "[", "b_", "]"}]}], "]"}], ":>", 
           RowBox[{"gUU", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"1", "+", "a"}], ",", 
              RowBox[{"1", "+", "b"}]}], "]"}], "]"}]}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"PASS", " ", "2"}], ":", " ", 
        RowBox[{"transpile", " ", "\[ScriptCapitalU]\[ScriptCapitalD]", " ", 
         RowBox[{"Partials", " ", "\[LongRightArrow]", " ", "Wolfram"}], " ", 
         "D"}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"activateCalculus", "=", 
       RowBox[{"lowerGeometry", "//.", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Partials", "[", 
           RowBox[{"content_", ",", 
            RowBox[{"x", "[", 
             RowBox[{"\[ScriptCapitalU]", "[", "dir_", "]"}], "]"}]}], "]"}], 
          ":>", "\[IndentingNewLine]", 
          RowBox[{"D", "[", 
           RowBox[{"content", ",", 
            RowBox[{"workingCoords", "[", 
             RowBox[{"[", 
              RowBox[{"1", "+", "dir"}], "]"}], "]"}]}], "]"}]}], "}"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Simplify", "[", "activateCalculus", "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.977671701961773*^9, 3.9776717019634666`*^9}, 
   3.977672016325259*^9, {3.977672538654307*^9, 3.977672543798789*^9}, {
   3.977672856742405*^9, 3.977672858851077*^9}, {3.977673072432103*^9, 
   3.9776730761291847`*^9}, {3.977673212978238*^9, 3.977673316772957*^9}, {
   3.977673356476471*^9, 3.977673380120572*^9}, {3.977673514296154*^9, 
   3.977673535615026*^9}, {3.977673660579521*^9, 3.977673680788039*^9}, {
