Cell[CellGroupData[{

Cell["Appendix 1: Spin Connection as Gravitational Gauge", "Section",
 CellChangeTimes->{{3.9784634251754417`*^9, 3.978463431650586*^9}, {
  3.978467221274311*^9, 3.978467228737336*^9}, {3.9785311553116007`*^9, 
  3.9785311740560427`*^9}, {3.978531214043825*^9, 3.978531227439899*^9}, {
  3.978531309854751*^9, 
  3.97853131020317*^9}},ExpressionUUID->"8b07ab75-9d83-4f32-9461-\
b8e99837bcf0"],

Cell[TextData[{
 "Gravitation has only a partial fit to other gauge theories of physics. \
\[OpenCurlyDoubleQuote]Partial\[CloseCurlyDoubleQuote] qualifies the \
frustration point that gravitation acts ",
 StyleBox["almost",
  FontSlant->"Italic"],
 " like any other gauge theory, but not quite. Gravitational forces arise ",
 StyleBox["from",
  FontSlant->"Italic"],
 " the geometry",
 ", while forces in other gauge theories arise from connections ",
 StyleBox["on",
  FontSlant->"Italic"],
 " the geometry, connections in \[OpenCurlyDoubleQuote]wallpaper\
\[CloseCurlyDoubleQuote] spaces like ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "(", "1", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bd5ad103-5b1d-4a0c-9549-9edce7eed96f"],
 " (phase) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"SU", "(", "3", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8a6b79a7-efa8-450c-8c02-7d9e936c65c8"],
 ". "
}], "Text",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637888906593`*^9}, {
   3.978467146885333*^9, 3.9784671744670887`*^9}, {3.978467237695951*^9, 
   3.978467248435212*^9}, {3.978467484630767*^9, 3.978467573417486*^9}, 
   3.978467641682742*^9, {3.9785368916333027`*^9, 3.97853704904286*^9}, {
   3.978636220839507*^9, 3.9786362354029503`*^9}, {3.978791880984424*^9, 
   3.978791972877468*^9}, {3.978792273328435*^9, 
   3.97879230699052*^9}},ExpressionUUID->"3c19d593-6ddb-49e5-bed9-\
0aa8c7dd4c77"],

Cell["\<\
But, to make gravitation a gauge theory, we have to find conserved quantities \
associated from local gauge invariance. The definitive review paper is the \
following:\
\>", "Text",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637888906593`*^9}, {
   3.978467146885333*^9, 3.9784671744670887`*^9}, {3.978467237695951*^9, 
   3.978467248435212*^9}, {3.978467484630767*^9, 3.978467573417486*^9}, 
   3.978467641682742*^9, {3.9785368916333027`*^9, 3.9785369461055603`*^9}, {
   3.978791980619316*^9, 3.978792021085046*^9}, {3.978792101774398*^9, 
   3.978792101774946*^9}, {3.978792317492405*^9, 3.978792403705505*^9}, {
   3.978792461736486*^9, 3.9787924791441507`*^9}, {3.9787925756541367`*^9, 
   3.978792585465941*^9}, {3.978792620049286*^9, 
   3.9787926303018427`*^9}},ExpressionUUID->"55d526cf-57ce-40e2-a6d6-\
a6f50ee3aa40"],

Cell[CellGroupData[{

Cell[TextData[{
 "Friedrich W. ",
 StyleBox["Hehl",
  IgnoreSpellCheck->True],
 " et al., ",
 StyleBox["General Relativity with Spin and Torsion: Foundations and \
Prospects",
  FontSlant->"Italic"],
 " (Rev. Mod. Phys. 48, 393, 1976)"
}], "Item",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.978466361194891*^9}, {
   3.9784673056989098`*^9, 
   3.978467354942222*^9}},ExpressionUUID->"d42a3ca6-0f7d-47c3-9359-\
6874822f94ed"],

Cell["which shows that:", "ItemParagraph",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.978466361194891*^9}, {
   3.9784673056989098`*^9, 3.978467385382815*^9}, {3.978792446339141*^9, 
   3.978792447172833*^9}, {3.9787926595309887`*^9, 
   3.978792660218268*^9}},ExpressionUUID->"a73a9876-1fbd-482e-9c22-\
bc8c848e8035"],

Cell["\<\
Invariance under general transformations (diffeomorphisms), implies \
conservation of the energy-momentum tensor.\
\>", "Subitem",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.9784663902544317`*^9}, {
   3.978467723999647*^9, 3.978467743088092*^9}, {3.978792495856393*^9, 
   3.978792500167569*^9}},ExpressionUUID->"e27bbfa1-6988-428c-98d9-\
bdafe05f0bdb"],

Cell["\<\
Invariance under local Lorentz transformations implies conservation of the \
spin angular momentum tensor (the spin current).\
\>", "Subitem",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.9784664333289547`*^9}, {
   3.978467424580559*^9, 3.9784674399227*^9}, {3.9784677547756577`*^9, 
   3.9784677558930273`*^9}},ExpressionUUID->"ffef7d33-5cb1-492d-bbdd-\
8d514fcd685e"],

Cell["\<\
Standard Einstein GT with vanishing torsion, which we assumed in this series \
of notebooks, collapses the two symmetries and hides the independent spin \
current.\
\>", "Subitem",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.978466451046755*^9}, {
   3.978467764934806*^9, 
   3.9784678683187*^9}},ExpressionUUID->"ae825c12-7bee-4d85-8900-\
83a223968980"]
}, Open  ]],

Cell["Some other references are", "Text",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.978463822489818*^9}, 
   3.978463853492107*^9, {3.97879263828334*^9, 
   3.978792643265484*^9}},ExpressionUUID->"bd8117b2-3d13-414f-b8ce-\
6391e381f873"],

Cell[CellGroupData[{

Cell[TextData[{
 " Sean Carroll, ",
 StyleBox["Spacetime and Geometry: An Introduction to General Relativity",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 
   3.978463851463154*^9}},ExpressionUUID->"9c9f3996-4222-4a12-ab63-\
24c6e6811ef6"],

Cell["\<\
Appendix J, Page 486\[VeryThinSpace]ff, under local Lorentz invariance, \
tetrads, and the spin connection:\
\>", "Subitem",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.97846430622845*^9}, {
   3.978466130000834*^9, 3.97846617162918*^9}, {3.978467658624906*^9, 
   3.9784676636610527`*^9}},ExpressionUUID->"47b81c5e-7466-4414-923f-\
9d96f0db6d9a"],

Cell[TextData[{
 "detailing how spin connection ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Omega]", "\[Mu]", 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"a", "\[VeryThinSpace]", "b"}]}]], TraditionalForm]],
  ExpressionUUID->"e9336ba3-8ca5-4d1e-90fb-c0c62756493b"],
 ", arising from non-coordinate basis sets, acts as the gauge field for local \
Lorentz transformations. Carroll also explains that in standard GR the \
torsion tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["T", 
     RowBox[{"\[VeryThinSpace]", "\[Lambda]"}]], 
    RowBox[{"\[VeryThinSpace]", 
     RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Nu]"}]}]], TraditionalForm]],
  ExpressionUUID->"a2057e92-422b-4a77-9933-c88cddc68b1b"],
 " is zero, locking the Levi-Civita connection (Christoffel symbols) to the \
metric and forcing the energy-momentum tensor to be symmetric, absorbing spin \
effects via symmetrization."
}], "ItemParagraph",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.978466361194891*^9}, {
   3.9784673056989098`*^9, 3.9784673452325478`*^9}, {3.978467678759273*^9, 
   3.978467692377183*^9}, {3.9785316949711523`*^9, 3.978531709031754*^9}, {
   3.978531983790666*^9, 3.978532035877861*^9}, {3.9785322926375437`*^9, 
   3.97853232201047*^9}, {3.978532946114335*^9, 3.978532986756562*^9}, {
   3.97853325255888*^9, 3.978533302893488*^9}, {3.9787926796343193`*^9, 
   3.9787927361046057`*^9}},ExpressionUUID->"97d54446-4cbf-430e-a1e8-\
cb1b09e4fe1f"],

Cell[TextData[{
 "Also see Hehl, Equation 3.8 and Sections III.B and III.C. In other \
references, this may be called ",
 StyleBox["Belinfante-Rosenfeld symmetrization",
  FontSlant->"Italic"],
 "."
}], "Subitem",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.978466361194891*^9}, {
   3.9784673056989098`*^9, 3.9784673452325478`*^9}, {3.978467678759273*^9, 
   3.978467692377183*^9}, {3.9785316949711523`*^9, 3.978531709031754*^9}, {
   3.978531983790666*^9, 3.978532035877861*^9}, {3.9785322926375437`*^9, 
   3.97853232201047*^9}, {3.978532946114335*^9, 3.978532986756562*^9}, {
   3.97853325255888*^9, 3.978533275318653*^9}, {3.9785333055095987`*^9, 
   3.978533318221752*^9}, {3.978533571662957*^9, 3.978533581186043*^9}, {
   3.978792752153208*^9, 
   3.978792764744529*^9}},ExpressionUUID->"5448738e-eb7e-4eb5-b32c-\
7dea5b11e120"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "T. W. B. Kibble, ",
 StyleBox["Lorentz Invariance and the Gravitational Field",
  FontSlant->"Italic"],
 " (J. Math. Phys. 2, 212, 1961)"
}], "Item",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 
   3.978466486720623*^9}},ExpressionUUID->"0a9b9626-464b-4f9c-8d94-\
07d51225c9e0"],

Cell["\<\
Foundational paper deriving gravitation as the gauge theory of the Poincar\
\[EAcute] group, i.e., Lorentz + translations\
\>", "Subitem",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.978466510390306*^9}, {
   3.9784669609195147`*^9, 3.978467137541203*^9}, {3.978467883335359*^9, 
   3.9784679272681417`*^9}, {3.978468065503084*^9, 3.97846807401269*^9}, {
   3.978792800047453*^9, 
   3.97879280618641*^9}},ExpressionUUID->"32e2ca27-b4f9-4e82-a0b0-\
78a1f5617ef1"],

Cell["\<\
Kibble shows that (1) gauging just translations in Poincar\[EAcute] yields \
the tetrad field, defining the metric and conserving to energy-momentum, and \
that (2) gauging the Lorentz subgroup, boost + rotation, yields the spin \
connection, permitting transformation of spinors, otherwise impossible.\
\>", "ItemParagraph",
 CellChangeTimes->{
  3.978463436519712*^9, {3.978463740077929*^9, 3.9784637811043253`*^9}, {
   3.978463826818162*^9, 3.978463875625635*^9}, {3.978464215143688*^9, 
   3.978464220280664*^9}, {3.978464287441144*^9, 3.9784645043690243`*^9}, {
   3.9784645373883333`*^9, 3.978464573176915*^9}, {3.97846618093814*^9, 
   3.978466218794236*^9}, {3.97846625951333*^9, 3.978466510390306*^9}, {
   3.9784669609195147`*^9, 3.978467137541203*^9}, {3.978467883335359*^9, 
   3.9784679272681417`*^9}, {3.978468090057158*^9, 3.978468133493339*^9}, 
   3.978533444804373*^9, {3.978535397364641*^9, 3.978535417858979*^9}, {
   3.9785354522594013`*^9, 3.9785354883804207`*^9}, {3.97879282536421*^9, 
   3.978792895879323*^9}},ExpressionUUID->"a4c8ac93-e4a4-4b96-873c-\
fa97ec500743"]
}, Open  ]],

Cell[TextData[{
 "Video: Carmeci Academy. ",
 StyleBox["General Relativity | Review and Intro to The Spin Connection",
  FontSlant->"Italic"],
 ", ",
 StyleBox["https://www.youtube.com/watch?v=LjydxyNY7Yg",
  FontVariations->{"Underline"->True}]
}], "Item",
 CellChangeTimes->{{3.97853344940698*^9, 
  3.9785335028858633`*^9}},ExpressionUUID->"507fb2f7-0a00-400c-8faf-\
cf77fcdfe459"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Appendix 2: Fibre Bundles", "Section",
 CellChangeTimes->{{3.978531317328569*^9, 
  3.978531324242466*^9}},ExpressionUUID->"620d6356-08c3-4bf5-af3b-\
bbeddfce3f01"],

Cell[TextData[{
 "In this appendix, we introduce the standard mathematical language. We \
present ",
 StyleBox["bundles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["projections",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fibres",
  FontSlant->"Italic"],
 ", ",
 StyleBox["sections",
  FontSlant->"Italic"],
 ", ",
 StyleBox["connections, ",
  FontSlant->"Italic"],
 "and ",
 StyleBox["invariance",
  FontSlant->"Italic"],
 ", with each concept applied to both geometry/gravitation and to more \
general gauge fields."
}], "Text",
 CellChangeTimes->{{3.978536750574292*^9, 3.9785367950754232`*^9}, {
  3.978610555963044*^9, 3.978610667580928*^9}, {3.978613173034171*^9, 
  3.978613182741832*^9}, {3.97861365486917*^9, 3.978613660623424*^9}, {
  3.978615429414358*^9, 3.978615456101054*^9}, {3.978629277098583*^9, 
  3.978629283785864*^9}, {3.978792917287898*^9, 
  3.97879293753654*^9}},ExpressionUUID->"bcde8fe1-83b9-4609-9c41-\
68ba8279ff2f"],

