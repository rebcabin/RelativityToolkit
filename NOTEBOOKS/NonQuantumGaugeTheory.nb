Cell[CellGroupData[{

Cell["The Derivation in Index Notation", "Section",
 CellChangeTimes->{{3.977535433122849*^9, 3.977535440829898*^9}, {
  3.9776826390915833`*^9, 
  3.977682642839716*^9}},ExpressionUUID->"c39c3893-98eb-4770-8ae9-\
e6023cbe233b"],

Cell["\<\
MTW\[CloseCurlyQuote]s geometric forms are too high-level for \
\[ScriptCapitalU]\[ScriptCapitalD]. The index notation is just right. Let\
\[CloseCurlyQuote]s start with the commutator\
\>", "Text",
 CellChangeTimes->{{3.977682654416891*^9, 3.977682688816283*^9}, {
  3.9777470773422537`*^9, 
  3.977747143107772*^9}},ExpressionUUID->"c1717b71-6757-406a-8ecd-\
8b44a3672bb3"],

Cell[CellGroupData[{

Cell["Step 1: Formulate and Differentiate", "Subsection",
 CellChangeTimes->{{3.9775300923741417`*^9, 
  3.9775301016423473`*^9}},ExpressionUUID->"5d2d52a2-99ca-49f2-924d-\
46316a3e8fa6"],

Cell[TextData[{
 "First, remind ourselves of the action of our covariant derivative, CD, \
trusted from earlier notebooks and tests. Apply CD to a concrete \
contravariant vector, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "\[Beta]"], TraditionalForm]],ExpressionUUID->
  "888ab3fb-391a-4c6b-9976-8ce8c754ad65"],
 " in lieu of MTW\[CloseCurlyQuote]s abstract basis forms:"
}], "Text",
 CellChangeTimes->{{3.977527325502906*^9, 3.977527421512032*^9}, {
   3.977527457843831*^9, 3.97752752535949*^9}, 3.977527721936805*^9, {
   3.977527796493059*^9, 3.977527815288126*^9}, 3.977530131143807*^9, {
   3.977530269957465*^9, 3.977530270541044*^9}, {3.97764484054769*^9, 
   3.977644854313637*^9}, {3.977747447254834*^9, 3.977747497215187*^9}, {
   3.977747538186145*^9, 
   3.9777475509100533`*^9}},ExpressionUUID->"4b077bde-2e12-4f86-9749-\
e5c2a764e725"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"TensorForm", "[", 
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Mu]", "]"}], "]"}], ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], 
     "]"}], ",", "\"\<\!\(\*SubscriptBox[\(\[Del]\), \
\(\[Nu]\)]\)\!\(\*SuperscriptBox[\(A\), \(\[Mu]\)]\) \[Congruent] \
\!\(\*SubscriptBox[SuperscriptBox[\(A\), \(\[Mu]\)], \(; \(\[Nu]\)\)]\) \
=\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Echo", "[", 
   RowBox[{
    RowBox[{"TensorForm", "[", 
     RowBox[{"CD", "[", 
      RowBox[{"\[CurlyPhi]", ",", 
       RowBox[{"x", "[", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Nu]", "]"}], "]"}]}], "]"}], 
     "]"}], ",", "\"\<\!\(\*SubscriptBox[\(\[Del]\), \(\[Nu]\)]\)\
\[VeryThinSpace]\[CurlyPhi] = \!\(\*SubscriptBox[\(\[CurlyPhi]\), \(\
\[VeryThinSpace]\(; \(\[VeryThinSpace]\)\(v\)\)\)]\)= \!\(\*SubscriptBox[\(\
\[CurlyPhi]\), \(\[VeryThinSpace]\(, \(\[VeryThinSpace]\)\(v\)\)\)]\) \
:\>\""}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.977527832511675*^9, 3.9775278685696697`*^9}, 
   3.977527965703364*^9, {3.977644863464674*^9, 3.9776449077642527`*^9}, {
   3.978344330108426*^9, 3.9783443387164917`*^9}, {3.9783445285988617`*^9, 
   3.978344535484336*^9}, {3.97834462086141*^9, 3.9783447160229816`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"8f47eff2-161e-45ac-abe0-994c181b1f22"],

Cell[TextData[{
 StyleBox["Note the generated summation index. ",
  FontSlant->"Italic"],
 "\[ScriptCapitalU]\[ScriptCapitalD]",
 StyleBox[" keeps track of such and prevents cross-capture with meaningful \
(free) indices in big calculations.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977644923929906*^9, 3.977644940291051*^9}, {
  3.97764529807302*^9, 3.9776453626375637`*^9}, {3.9777475614332333`*^9, 
  3.977747561434353*^9}},ExpressionUUID->"4bc96260-a2fb-4718-8b89-\
ff207b4bc3fd"],

Cell[TextData[{
 StyleBox["TODO: we might add basis abstractions to a future version of ",
  FontSlant->"Italic"],
 "\[ScriptCapitalU]\[ScriptCapitalD]",
 StyleBox[". It\[CloseCurlyQuote]s lower priority, however, as we get the \
same results by application of Quotient Theorems.",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.977644923929906*^9, 3.977644940291051*^9}, {
  3.97764529807302*^9, 3.9776453626375637`*^9}, {3.977747563165366*^9, 
  3.977747648401968*^9}},ExpressionUUID->"7971ff42-0706-44ba-8c6a-\
93b164426ae4"],

Cell[TextData[{
 "The commutator applies another covariant derivative, as in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "\[Gamma]"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", "\[Delta]"], 
      SuperscriptBox["A", "\[Beta]"]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"1576b787-3da6-4c99-8e20-a038aec98fdf"],
 ", then reverses the order of \[Gamma] and \[Delta] and subtracts: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Gamma]"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", "\[Delta]"], 
       SuperscriptBox["A", "\[Beta]"]}], ")"}]}], "-", 
    RowBox[{
     SubscriptBox["\[Del]", "\[Delta]"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", "\[Gamma]"], 
       SuperscriptBox["A", "\[Beta]"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"89b93e20-47b6-40e8-974e-2d77e65c274a"],
 ". However, composing covariant derivatives blindly conceals a trap: the \
product rule of CD only pertains to products of tensors, but the inner CD \
produces products like ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "\[CapitalGamma]"}], TraditionalForm]],ExpressionUUID->
  "f94bbd1d-bac2-4916-958c-f3e23b9e7eb0"],
 ", a tensor times a non-tensor! The next section introduces the fix:"
}], "Text",
 CellChangeTimes->{{3.9776454477952347`*^9, 3.977645578694457*^9}, {
  3.977747673081131*^9, 
  3.977747849978416*^9}},ExpressionUUID->"8d9b8faa-3fd9-4ee6-b326-\
a2febb867cc4"],

Cell[CellGroupData[{

Cell["Boxing Non-Tensorial Terms", "Subsubsection",
 CellChangeTimes->{{3.9775346754473248`*^9, 
  3.977534687937344*^9}},ExpressionUUID->"d5479e2c-ddc1-4ccb-8f91-\
89f15076f8f0"],

Cell[TextData[{
 "When we apply the \[OpenCurlyDoubleQuote]outer\[CloseCurlyDoubleQuote] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Del]", "\[Gamma]"], TraditionalForm]],ExpressionUUID->
  "e1fa7b98-8e5b-4af5-9046-7105540ae252"],
 " to the \[OpenCurlyDoubleQuote]inner\[CloseCurlyDoubleQuote] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "\[Delta]"], 
    SuperscriptBox["A", "\[Beta]"]}], TraditionalForm]],ExpressionUUID->
  "6feaa398-4a5d-439d-bd93-2431f5bca9e3"],
 ", CD must treat the \[OpenCurlyDoubleQuote]inner\[CloseCurlyDoubleQuote] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "\[Delta]"], 
     SuperscriptBox["A", "\[Beta]"]}], "=", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["A", "\[Beta]"], 
      RowBox[{",", "\[Delta]"}]], "-", 
     RowBox[{
      SuperscriptBox["A", "\[Lambda]"], 
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", 
        RowBox[{" ", "\[Beta]"}]], 
       RowBox[{"\[Delta]", " ", "\[Lambda]"}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"41a967df-1def-4e93-aab2-4518d8343e22"],
 " as a whole tensor. That means CD must not apply the \[Del] product rule to \
the term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "\[Lambda]"], 
    SubscriptBox[
     SuperscriptBox["\[CapitalGamma]", 
      RowBox[{" ", "\[Beta]"}]], 
     RowBox[{"\[Delta]", " ", "\[Lambda]"}]]}], TraditionalForm]],
  ExpressionUUID->"cc86e0ea-1738-468d-b751-a2012d0c3d84"],
 ". "
}], "Text",
 CellChangeTimes->{{3.977527982768255*^9, 3.977528071613158*^9}, {
   3.977528147413913*^9, 3.9775282365591288`*^9}, {3.977528285163328*^9, 
   3.977528301478141*^9}, {3.9775285661265507`*^9, 3.977528567874873*^9}, {
   3.977529029017803*^9, 3.977529125584494*^9}, {3.977529159911845*^9, 
   3.9775291604042*^9}, {3.977529192639998*^9, 3.9775291938016863`*^9}, {
   3.9775295849110603`*^9, 3.9775296640149508`*^9}, {3.977529733736466*^9, 
   3.977529755160907*^9}, {3.977529973657468*^9, 3.9775300691855164`*^9}, {
   3.977530144659377*^9, 3.9775301570243053`*^9}, {3.97753020290987*^9, 
   3.9775302396152887`*^9}, {3.9775302766515827`*^9, 3.97753042640129*^9}, {
   3.977534440795034*^9, 3.977534586416469*^9}, {3.97753462556609*^9, 
   3.977534646095621*^9}, {3.977537522931058*^9, 3.977537526680274*^9}, {
   3.977537557110469*^9, 3.9775375594743032`*^9}, {3.9776453810206537`*^9, 
   3.977645404227343*^9}, {3.977645586085967*^9, 3.977645738880803*^9}, {
   3.977645771699258*^9, 3.97764584869405*^9}, {3.977747856154808*^9, 
   3.97774789508272*^9}, {3.9777479529100924`*^9, 3.977748013905995*^9}, {
   3.977748094876708*^9, 3.977748202932303*^9}, 
   3.977748334136074*^9},ExpressionUUID->"40806801-03db-41f7-8e74-\
98faca5c388b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", 
    RowBox[{"(", 
     RowBox[{"A", ".", "\[CapitalGamma]"}], ")"}]}], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"1eb1ff6b-2ddb-4292-8b02-2b5b7008e859"],
 StyleBox[" does not equal ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Del]", "A"}], ")"}], ".", "\[CapitalGamma]"}], "+", 
    RowBox[{"A", ".", 
     RowBox[{"(", 
      RowBox[{"\[Del]", "\[CapitalGamma]"}], ")"}]}]}], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"b1877876-01a8-4a07-9e19-e9afa2c36d48"],
 StyleBox[". ",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.977527982768255*^9, 3.977528071613158*^9}, {
   3.977528147413913*^9, 3.9775282365591288`*^9}, {3.977528285163328*^9, 
   3.977528301478141*^9}, {3.9775285661265507`*^9, 3.977528567874873*^9}, {
   3.977529029017803*^9, 3.977529125584494*^9}, {3.977529159911845*^9, 
   3.9775291604042*^9}, {3.977529192639998*^9, 3.9775291938016863`*^9}, {
   3.9775295849110603`*^9, 3.9775296640149508`*^9}, {3.977529733736466*^9, 
   3.977529755160907*^9}, {3.977529973657468*^9, 3.9775300691855164`*^9}, {
   3.977530144659377*^9, 3.9775301570243053`*^9}, {3.97753020290987*^9, 
   3.9775302396152887`*^9}, {3.9775302766515827`*^9, 3.97753042640129*^9}, {
   3.977534440795034*^9, 3.977534586416469*^9}, {3.97753462556609*^9, 
   3.977534646095621*^9}, {3.977537522931058*^9, 3.977537526680274*^9}, {
   3.977537557110469*^9, 3.9775375594743032`*^9}, {3.9776453810206537`*^9, 
   3.977645404227343*^9}, {3.977645586085967*^9, 3.977645738880803*^9}, {
   3.977645771699258*^9, 3.97764584869405*^9}, {3.977747856154808*^9, 
   3.977747893780663*^9}, {3.977748217174459*^9, 3.9777482680122547`*^9}, 
   3.977748349856803*^9},ExpressionUUID->"9513fead-4291-4937-9529-\
3eb31487940e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", "\[CapitalGamma]"}], TraditionalForm]],ExpressionUUID->
  "820d601c-a5f6-472c-b30a-c54eeb434871"],
 " is nonsense! \[CapitalGamma] is not a tensor, as we know from my earlier \
notebooks! Reserving \[CapitalGamma], globally, as a non-tensorial symbol for \
CD is the reason for calling ",
 StyleBox["SetConnection", "Input"],
 " above. "
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQB2IQ3TP1RmjHoreO/+Z9TgDRx+xys0B00pOJpSD6j+XS
ahD9zmd9LYjewnNkHoj+9u83mL4xccENEK27ZdMTEH1N9+8LEG36nucliL5b
JfIWRGcttwTTGeqycp1AuqqKQQNEK07cbgCi1dRSjUH0L86tfiD6wPulUSB6
nqRoCoiWOb4gFUSvkI3NBtFFGz7ng+gjN6eUgOi46z7tIPp1gWRtN5DeHuzb
D6IzZY2mgOgQ/sPTQLTV6dh/PUD63JGrYPpbx2KmXiBdp/seTButXLDiIJBO
dWtfDaLtDjgdAtFd+jFXQXRQQtlNEL3CVOwxiDb4wrLpM5A2/L1jG4jWnqp6
H0SnpDQ8BdEmi5gWz1781jEi7OYSEA0AfQTQvQ==
  "],ExpressionUUID->"0fa57c91-c60f-4610-8e76-4537855e4767"],

Cell[TextData[{
 "While \[CapitalGamma] is not a tensor, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "\[CapitalGamma]"}], TraditionalForm]],ExpressionUUID->
  "1512c950-2f46-4e50-a4d7-ddb5bb4da15a"],
 " is. A new version of CD recognizes the \[OpenCurlyDoubleQuote]poison-pill\
\[CloseCurlyDoubleQuote]\[NoBreak] \[CapitalGamma] in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "\[CapitalGamma]"}], TraditionalForm]],ExpressionUUID->
  "4ea36d5b-b92b-451d-a491-50f7a409b264"],
 " and bypasses the \[Del] product rule. CD sends ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "\[CapitalGamma]"}], TraditionalForm]],ExpressionUUID->
  "e184c496-ff6c-4d97-ba9d-3b5cc6e44576"],
 " in an inert box down the line to a later ",
 StyleBox["appropriate",
  FontSlant->"Italic"],
 " application of the ordinary product rule from calculus. CD \
\[OpenCurlyDoubleQuote]glues the ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "d801dedb-447e-47d0-bff7-e12d1a384f49"],
 " to the ",
 Cell[BoxData[
  FormBox["\[CapitalGamma]", TraditionalForm]],ExpressionUUID->
  "af0bf49a-4997-439e-8dbb-885c25ced51c"],
 "\[CloseCurlyDoubleQuote] (look for \[OpenCurlyDoubleQuote]gamma glue\
\[CloseCurlyDoubleQuote] in the code: ",
 StyleBox["RelativityToolkit.wl", "Input"],
 ", Rule 0 of CD). "
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQB2IQ3TP1RmjHoreO/+Z9TgDRx+xys0B00pOJpSD6j+XS
ahD9zmd9LYjewnNkHoj+9u83mL4xccENEK27ZdMTEH1N9+8LEG36nucliL5b
JfIWRGcttwTTGeqycp1AuqqKQQNEK07cbgCi1dRSjUH0L86tfiD6wPulUSB6
