Cell[CellGroupData[{

Cell["Rationalize Symbols", "Subsection",
 CellChangeTimes->{{3.97767926195428*^9, 3.977679265909133*^9}, {
  3.977679300935643*^9, 
  3.9776793101137466`*^9}},ExpressionUUID->"08c50f54-2524-4e37-b346-\
afc9a365f005"],

Cell["\<\
Inexplicably, the metric from WFR has strings containing formal symbols, \
which (annoyingly) print just like formal symbols. It took a bit of effort to \
debug this.\
\>", "Text",
 CellChangeTimes->{{3.977677128596992*^9, 3.977677153256401*^9}, {
  3.9776772385919867`*^9, 3.977677248610517*^9}, {3.977677482276292*^9, 
  3.977677500488405*^9}, {3.9776821302640333`*^9, 
  3.977682156255921*^9}},ExpressionUUID->"d8dbe726-0350-4871-89c0-\
beac8fe86029"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"rawCoords", "=", 
    RowBox[{"metricObj", "[", "\"\<Coordinates\>\"", "]"}]}], ")"}], "//", 
  "FullForm"}]], "Input",
 CellChangeTimes->{{3.977671701961773*^9, 3.9776717019634666`*^9}, 
   3.977672016325259*^9, {3.977672538654307*^9, 3.977672543798789*^9}, {
   3.977672856742405*^9, 3.977672858851077*^9}, {3.977673072432103*^9, 
   3.9776730761291847`*^9}, {3.977673212978238*^9, 3.9776732956882973`*^9}, {
   3.9776770918333673`*^9, 3.977677096377769*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"8e081acb-90cf-4c95-9a3a-9b38e49030ce"],

Cell["\<\
Wolfram can\[CloseCurlyQuote]t take derivatives with respect to strings. Just \
map them to ordinary formal variables, input via Esc\[NoBreak]-\[NoBreak].\
\[NoBreak]t\[NoBreak]-\[NoBreak]Esc, etc.:\
\>", "Text",
 CellChangeTimes->{{3.977675069337454*^9, 3.977675098668919*^9}, {
  3.977677158941681*^9, 3.977677187120345*^9}, {3.9776772606794987`*^9, 
  3.9776772795119667`*^9}, {3.977681903179208*^9, 3.977681940958995*^9}, {
  3.977748903959351*^9, 
  3.977748938816638*^9}},ExpressionUUID->"d834690e-237f-4619-97be-\
cb3aaa2417d5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"workingCoords", "=", 
   RowBox[{"{", 
    RowBox[{
    "\[FormalT]", ",", "\[FormalR]", ",", "\[FormalTheta]", ",", 
     "\[FormalPhi]"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simpleMap", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{"rawCoords", "->", "workingCoords"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.977674974791132*^9, 3.977674975689888*^9}, 
   3.977675048888536*^9, {3.977677284490521*^9, 3.97767731601033*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"bc901751-e9db-4132-a8b7-3631279d7a54"],

