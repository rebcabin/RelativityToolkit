Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{"\[VeryThinSpace]", "\[Lambda]"}]], 
    RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Rho]"}]], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    SuperscriptBox["g", 
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{"\[Lambda]", "\[VeryThinSpace]", "\[Sigma]"}]}]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["g", 
       RowBox[{"\[VeryThinSpace]", 
        RowBox[{
         RowBox[{"\[Sigma]", "\[VeryThinSpace]", "\[Rho]"}], 
         "\[VeryThinSpace]", ",", "\[VeryThinSpace]", "\[Mu]"}]}]], "+", 
      SubscriptBox["g", 
       RowBox[{"\[VeryThinSpace]", 
        RowBox[{
         RowBox[{"\[Sigma]", "\[VeryThinSpace]\[VeryThinSpace]", "\[Mu]"}], "\[InvisibleComma]", 
         RowBox[{",", "\[VeryThinSpace]", "\[Rho]"}]}]}]], "-", 
      SubscriptBox["g", 
       RowBox[{"\[VeryThinSpace]", 
        RowBox[{
         RowBox[{"\[Mu]", "\[VeryThinSpace]", "\[Rho]"}], "\[InvisibleComma]", 
         RowBox[{",", "\[VeryThinSpace]", "\[Sigma]"}]}]}]]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9787256859222937`*^9, 3.9787258490140142`*^9}, {
  3.9787262341089*^9, 3.9787262443556232`*^9}, {3.978726300816777*^9, 
  3.978726306012745*^9}, {3.978726588629328*^9, 3.978726596321744*^9}, {
  3.9787266997935057`*^9, 
  3.9787266997998*^9}},ExpressionUUID->"0943092d-7233-41c9-bc8f-d42d615c619a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ruleLeviCivita", "=", 
  RowBox[{
   RowBox[{"\[CapitalGamma]", "[", 
    RowBox[{
     RowBox[{"\[ScriptCapitalU]", "[", "\[Lambda]_", "]"}], ",", 
     RowBox[{"\[ScriptCapitalD]", "[", "a_", "]"}], ",", 
     RowBox[{"\[ScriptCapitalD]", "[", "b_", "]"}]}], "]"}], ":>", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Sigma]", "=", 
       RowBox[{"Unique", "[", "\"\<\[Sigma]\>\"", "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"g", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalU]", "[", "\[Lambda]", "]"}], ",", 
        RowBox[{"\[ScriptCapitalU]", "[", "\[Sigma]", "]"}]}], "]"}], "*", 
      "\[IndentingNewLine]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Partials", "[", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{
            RowBox[{"\[ScriptCapitalD]", "[", "\[Sigma]", "]"}], ",", 
            RowBox[{"\[ScriptCapitalD]", "[", "b", "]"}]}], "]"}], ",", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "a", "]"}], "]"}]}], "]"}], "+", 
        "\[IndentingNewLine]", 
        RowBox[{"Partials", "[", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{
            RowBox[{"\[ScriptCapitalD]", "[", "\[Sigma]", "]"}], ",", 
            RowBox[{"\[ScriptCapitalD]", "[", "a", "]"}]}], "]"}], ",", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "b", "]"}], "]"}]}], "]"}], "-", 
        "\[IndentingNewLine]", 
        RowBox[{"Partials", "[", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{
            RowBox[{"\[ScriptCapitalD]", "[", "a", "]"}], ",", 
            RowBox[{"\[ScriptCapitalD]", "[", "b", "]"}]}], "]"}], ",", 
          RowBox[{"x", "[", 
           RowBox[{"\[ScriptCapitalU]", "[", "\[Sigma]", "]"}], "]"}]}], 
         "]"}]}], ")"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.978723120871808*^9, 3.97872312087333*^9}, {
   3.978723165469028*^9, 3.978723207620385*^9}, 3.9787233650029182`*^9, {
   3.9787235792374363`*^9, 3.978723603081081*^9}, {3.9787239349292383`*^9, 
   3.978724069870165*^9}, 3.9787242757312603`*^9, {3.9787243954582853`*^9, 
   3.978724398922227*^9}, {3.978724456929924*^9, 3.978724457518743*^9}, {
   3.978724523827444*^9, 3.9787245477064877`*^9}, {3.9787246249191*^9, 
